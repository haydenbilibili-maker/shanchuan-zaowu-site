# 复制为 .env 或 .env.local（勿提交真实密钥）

# —— 飞书多维表对接（本地 Vite 代理读取；勿加 VITE_、勿进 SPA）
# 线上请在 Cloudflare Pages → Settings → Environment variables 配置同名变量
# 开放平台自建应用 + 「⋯更多 → 添加文档应用」给可编辑
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# 默认采购/库存 Base；人事花名册同步在请求里覆盖为 UOIcbbRBwaX9U1sIR9xcezhenzb，不必改此值
# FEISHU_APP_TOKEN=WCs2bnIHsaty7vsjcnaczu0Wnod

# —— 腾讯云 API 密钥（本地脚本 + /api/cloud-fn 代理；勿写入 VITE_ 前缀、勿提交）
# 获取：https://console.cloud.tencent.com/cam/capi
# 子账号需有云开发 TCB / SCF 调用权限；主账号 SecretKey 仅显示一次，请妥善保存
# 线上：Cloudflare Pages → Settings → Environment variables 配置同名变量后重新部署
# 必配：TCB_SECRET_ID / TCB_SECRET_KEY / ADMIN_OPS_KEY
# 代理白名单含：bindPlatformOrder、manageInvoiceRequests、managerShipOrder、seedCategories 等
# 注意：functions/api/cloud-fn.js 必须进 git 并随 Pages 发布，否则线上 /api/cloud-fn 会 404/405
# TCB_SECRET_ID=
# TCB_SECRET_KEY=
# CLOUDBASE_ENV=cloud1-8gnkty5bfff9f0bf
# CLOUDBASE_REGION=ap-shanghai
# 建集合：cd admin && npm run provision:miniapp-ops
#         cd admin && npm run provision:price-list
#         cd admin && npm run provision:all
# 预览：  cd admin && npm run provision:all:dry

# —— AI 默认通道：DeepSeek（推荐）
# 控制台：https://platform.deepseek.com/
# 本地：复制本文件为 .env 后填写，保存并重启 npm run dev:admin
# 生产：GitHub Secrets 同名变量，由 .github/workflows/deploy-pages.yml 注入构建
VITE_DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# VITE_DEEPSEEK_API_KEYS=sk-key1,sk-key2
# VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
# VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_AI_DEFAULT_PROVIDER=deepseek

# —— 阿里云百炼（可选备用；额度耗尽时可注释）
# 控制台：https://bailian.console.aliyun.com/
# VITE_BAILIAN_API_KEY=
# VITE_BAILIAN_MODEL=qwen-plus
# VITE_BAILIAN_MODEL_PRO=qwen-max
# 多 Key 负载均衡（逗号分隔）：VITE_BAILIAN_API_KEYS=

# —— 管理后台登录口令（可选）：构建时注入；生产环境务必设置强口令并勿提交到仓库
# VITE_ADMIN_PASSWORD=

# —— Admin 运维 ops key（与云函数环境变量 ADMIN_OPS_KEY 保持一致；勿提交真实值）
# 推荐：只配 ADMIN_OPS_KEY（/api/cloud-fn 服务端注入，不进 SPA）
# 兼容：VITE_ADMIN_OPS_KEY（旧版浏览器直调；已改走代理后可不依赖）
# 覆盖：开票台 / 绑单台 / 发货 / 退款 / 运费规则保存 等管理类云函数
# ADMIN_OPS_KEY=
# VITE_ADMIN_OPS_KEY=

# —— 阿里云智能语音交互（可选）：开发/预览时由 Vite 插件读取，用于「马上有」云端 TTS。
# 未配置或鉴权失败时自动使用浏览器 Web Speech。纯离线无法使用云端合成。
# 开通：https://www.aliyun.com/product/nls
ALIYUN_NLS_ACCESS_KEY_ID=
ALIYUN_NLS_ACCESS_KEY_SECRET=
ALIYUN_NLS_APPKEY=
# ALIYUN_NLS_GATEWAY=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts
# ALIYUN_NLS_VOICE=xiaoyun
# ALIYUN_NLS_FORMAT=mp3

# 生产环境：若 Nginx/网关把 /api/aliyun-nls/* 转发到你自建的后端，填写该站点来源（无前缀斜杠，无末尾斜杠）
# VITE_ALIYUN_TTS_API_BASE=https://your-admin.example.com

# 前端可选：覆盖服务端默认发音人/格式（需代理支持透传）
# VITE_ALIYUN_NLS_VOICE=zhiyan
# VITE_ALIYUN_NLS_FORMAT=mp3

# —— 开源 TTS P1（CosyVoice 风格，可选）：开发/预览由 Vite 插件代理 /api/oss-tts/*
# 未启用或上游挂掉时安静降级：阿里云 NLS → Web Speech。详见 admin/docs/OSS_TTS_P1.md
# OSS_TTS_ENABLED=1
# OSS_TTS_UPSTREAM=http://127.0.0.1:50000
# OSS_TTS_MOCK=1
# OSS_TTS_API_STYLE=auto
# OSS_TTS_VOICE=中文女
# OSS_TTS_SFT_PATH=/inference_sft
# OSS_TTS_OPENAI_PATH=/v1/audio/speech
# 生产网关（提供同源 /api/oss-tts/*）：
# VITE_OSS_TTS_API_BASE=https://your-admin.example.com
# VITE_OSS_TTS_VOICE=中文女
# VITE_OSS_TTS_SAMPLE_RATE=22050

# OpenClaw 控制台地址（可选，用于 AI 智能中心「打开控制台」与表单预填）
# 当前团队部署在阿里云轻量应用服务器（华东2·上海），镜像 OpenClaw 2024.2.26。
# 未绑定域名前一般为 http://公网IP（若服务非 80 端口需带 :端口）；请在轻量防火墙放行对应端口。
# VITE_OPENCLAW_CONSOLE_URL=http://139.224.208.69

# —— 爆品概念 · 站内生图（可选）
# 未配置 Key 时主按钮显示「需配置 Key」，仍可使用 Gemini 外链（自动复制视觉描述）
# VITE_IMAGE_GEN_ENABLED=1
# VITE_IMAGE_GEN_PROVIDER=gemini
# gemini | openai | bailian（按优先级自动选第一个有 Key 的 provider）
# VITE_GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
# VITE_OPENAI_IMAGE_MODEL=dall-e-3
# VITE_BAILIAN_IMAGE_MODEL=wanx-v1
# Gemini 生图 App 外链（无法 URL 预填，走剪贴板 + 新窗口）
# VITE_GEMINI_IMAGE_APP_URL=https://gemini.google.com/app/e267ab1bf45eed45?hl=zh

# —— 资本架构沙盘：小程序 TTM 订单/营收（默认关闭，测试 orders 不计入估值锚点）
# 小程序正式上线后设为 true，沙盘 § I.1c 与估值实验室「+ 线上渠道 TTM」将读取 CloudBase orders
# VITE_MINIPROGRAM_SANDBOX_USE_ORDERS=true
