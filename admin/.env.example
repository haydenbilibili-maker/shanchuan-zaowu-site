# 复制为 .env 或 .env.local（勿提交真实密钥）

# —— 阿里云百炼（ERP 全部 AI 功能默认走此通道）
# 控制台：https://bailian.console.aliyun.com/
# VITE_BAILIAN_API_KEY=
# VITE_AI_DEFAULT_PROVIDER=bailian
# VITE_BAILIAN_MODEL=qwen-plus
# VITE_BAILIAN_MODEL_PRO=qwen-max
# 多 Key 负载均衡（逗号分隔）：VITE_BAILIAN_API_KEYS=

# —— 管理后台登录口令（可选）：构建时注入；生产环境务必设置强口令并勿提交到仓库
# VITE_ADMIN_PASSWORD=

# —— 阿里云智能语音交互（可选）：开发/预览时由 Vite 插件读取，用于「马上有」云端 TTS。
# 未配置或鉴权失败时自动使用浏览器 Web Speech。纯离线无法使用云端合成。
# 开通：https://www.aliyun.com/product/nls
ALIYUN_NLS_ACCESS_KEY_ID=
ALIYUN_NLS_ACCESS_KEY_SECRET=
ALIYUN_NLS_APPKEY=
# ALIYUN_NLS_GATEWAY=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts
# ALIYUN_NLS_VOICE=xiaoyun
# ALIYUN_NLS_FORMAT=mp3

# 生产环境：若 Nginx/网关把 /api/aliyun-nls/* 转发到你自建的后端，填写该站点来源（无前缀斜杠，无末尾斜杠）
# VITE_ALIYUN_TTS_API_BASE=https://your-admin.example.com

# 前端可选：覆盖服务端默认发音人/格式（需代理支持透传）
# VITE_ALIYUN_NLS_VOICE=zhiyan
# VITE_ALIYUN_NLS_FORMAT=mp3

# OpenClaw 控制台地址（可选，用于 AI 智能中心「打开控制台」与表单预填）
# 当前团队部署在阿里云轻量应用服务器（华东2·上海），镜像 OpenClaw 2024.2.26。
# 未绑定域名前一般为 http://公网IP（若服务非 80 端口需带 :端口）；请在轻量防火墙放行对应端口。
# VITE_OPENCLAW_CONSOLE_URL=http://139.224.208.69
