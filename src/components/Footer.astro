---
const navColumns = [
  {
    title: '主线',
    items: [
      { href: '/what', label: '我们做什么' },
      { href: '/who', label: '我们是谁' },
      { href: '/why', label: '为什么' },
      { href: '/how', label: '怎么做' },
      { href: '/foundation', label: '价值底座' },
      { href: '/foundation/strategy', label: '战略与愿景' },
    ],
  },
  {
    title: 'How 子页',
    items: [
      { href: '/how/senses', label: '五感' },
      { href: '/how/space', label: '空间哲学' },
      { href: '/how/operations', label: '经营模式' },
      { href: '/how/tech', label: '数字化与硬核科技' },
    ],
  },
  {
    title: '合作入口',
    items: [
      { href: '/for-properties', label: '物业合作' },
      { href: '/for-investors', label: '投资合作' },
      { href: '/for-franchise', label: '加盟咨询' },
    ],
  },
  {
    title: '深度与工具',
    items: [
      { href: '/notes', label: '笔记' },
      { href: '/talent', label: '人才与店长培训' },
      { href: '/benchmarks', label: '对标研究' },
      { href: '/digital-ops', label: '数字化能力' },
      { href: '/admin/', label: '管理后台演示' },
      { href: '/hardcore-tech', label: '硬核科技' },
      { href: '/sound-manual', label: '声学手册' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="mt-section border-t border-brass-mid/15 bg-ink text-cream">
  <div class="max-w-7xl mx-auto px-6 py-section">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-10">
      <div class="col-span-2 md:col-span-1">
        <h3 class="font-serif text-2xl text-cream mb-3 tracking-cn">山海造物</h3>
        <p class="font-serif-en italic text-sm text-brass-mid">Nature&rsquo;s Creations</p>
        <p class="text-xs text-text-soft mt-4 leading-relaxed tracking-cn">
          把山海带回家<br />
          让自然博物美学进入日常生活
        </p>
      </div>

      {navColumns.map((col) => (
        <div>
          <h4 class="font-serif text-sm text-brass-mid mb-4 tracking-cn font-medium">{col.title}</h4>
          <ul class="space-y-2 text-sm">
            {col.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-cream/80 hover:text-brass-light transition-colors duration-200 tracking-cn"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <hr class="border-0 h-px bg-brass-mid/20 my-section" />

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs text-text-dim">
      <p class="tracking-cn">&copy; {year} 山海造物 · NATURE&rsquo;S CREATIONS</p>
      <p class="font-serif-en italic text-brass-mid">SINCE 2024 · CHANGCHUN</p>
    </div>
  </div>
</footer>
