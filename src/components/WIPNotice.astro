---
interface Props {
  /** 备注：本页正在编写的内容主题 */
  topic?: string;
  /** 预期上线版本，例如 v0.3 */
  expectedVersion?: string;
}

const { topic, expectedVersion = 'v0.3' } = Astro.props;
---

<aside class="editorial-section">
  <div class="border border-brass-mid/30 bg-ink-elevated/40 px-8 py-10 text-center">
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-4">
      Work in progress · {expectedVersion}
    </p>
    <p class="font-serif text-cream text-lg mb-3 tracking-cn">
      {topic ?? '本页内容正在编写'}
    </p>
    <p class="text-sm text-text-soft max-w-editorial mx-auto leading-relaxed">
      我们仍在打磨这一页的语言与素材。<br />
      不愿意把没准备好的东西放出来——这本身就是「克制」的一部分。
    </p>
    <a
      href="/"
      class="inline-block mt-8 border-b-2 border-brass-mid pb-1 text-brass-mid hover:text-brass-bright text-sm tracking-cn transition-colors"
    >
      回到首页
    </a>
  </div>
</aside>
