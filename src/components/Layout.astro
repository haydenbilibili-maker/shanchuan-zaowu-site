---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';

/** 全站默认分享图：真实存在于 public/（审计 E5；勿再指占位目录） */
const DEFAULT_OG_IMAGE = '/specimens/hero-specimen.jpg';
const DEFAULT_OG_WIDTH = 1920;
const DEFAULT_OG_HEIGHT = 1081;
const DEFAULT_OG_ALT = '山海造物 · 展陈空间暖光下的标本柜与装框蝴蝶';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** og:image 像素宽（须与真实文件一致；默认标本主图 1920） */
  imageWidth?: number;
  /** og:image 像素高（须与真实文件一致；默认标本主图 1081） */
  imageHeight?: number;
  /** og:image:alt / twitter:image:alt */
  imageAlt?: string;
  /** Open Graph 类型，默认 website */
  ogType?: string;
  /** LCP 图片（如首页 Hero 背景）· 注入 <link rel="preload"> */
  preloadImage?: string;
}

const {
  title,
  description = '把山海带回家——让自然博物美学进入日常生活',
  // 2026-09-17 审计 E5：原默认值 `/images/hero/home-hero.jpg` 是**占位目录里并不存在**的文件，
  // 导致构建页面的 og:image / twitter:image 指向 404。
  // 改指向真实存在、且本来就被首页当分享图的标本主图（207KB，随构建发布）。
  image = DEFAULT_OG_IMAGE,
  imageWidth = DEFAULT_OG_WIDTH,
  imageHeight = DEFAULT_OG_HEIGHT,
  imageAlt = DEFAULT_OG_ALT,
  ogType = 'website',
  preloadImage,
} = Astro.props;

const fullTitle = title === '山海造物'
  ? '山海造物 · 把山海带回家'
  : `${title} · 山海造物`;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : new URL(Astro.url.pathname, Astro.url);
const ogImageURL = Astro.site ? new URL(image, Astro.site) : new URL(image, Astro.url);
const ogImageType = image.toLowerCase().endsWith('.png')
  ? 'image/png'
  : image.toLowerCase().endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';

const siteHref = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd =
  siteHref &&
  JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${siteHref}/#organization`,
        name: '山海造物',
        alternateName: ["Nature's Creations"],
        url: siteHref,
        logo: `${siteHref}/favicon.svg`,
        email: 'hello@shanhaizaowu.com',
        slogan: '把山海带回家',
      },
      {
        '@type': 'WebSite',
        '@id': `${siteHref}/#website`,
        url: siteHref,
        name: '山海造物',
        inLanguage: 'zh-CN',
        publisher: { '@id': `${siteHref}/#organization` },
      },
    ],
  });
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1A1814" id="theme-color-dynamic" />

    {/*
      ===== 主题初始化（is:inline · 必须在所有内容之前）=====
      逻辑：localStorage > 系统偏好 > dark 兜底
      作用：在浏览器解析 HTML 时立即写入 data-theme，避免 FOUC（深色闪一下再切浅色）
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          var root = document.documentElement;
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          var tc = document.getElementById('theme-color-dynamic');
          if (tc) tc.setAttribute('content', theme === 'dark' ? '#1A1814' : '#FAFAF5');
          if (
            typeof window.matchMedia !== 'undefined' &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            root.classList.add('reduce-motion');
          }
        } catch (e) {
          var root2 = document.documentElement;
          root2.dataset.theme = 'dark';
          root2.style.colorScheme = 'dark';
          var tc2 = document.getElementById('theme-color-dynamic');
          if (tc2) tc2.setAttribute('content', '#1A1814');
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang="zh-CN" href={canonicalURL.href} />

    {/* OpenGraph（分享时使用生产域名绝对地址；宽高/alt 让预览卡片稳定出图） */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="山海造物" />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd ? <script is:inline type="application/ld+json" set:html={jsonLd} /> : null}
    {/* 2026-09-17 审计 E6 + 体验债：CSS 已改为「默认可见、js-fade 武装后才隐藏」；
        noscript 仍保留作双保险，并满足 verify:site-dist S4。
        注意：`<style>{`...`}</style>` 在 Astro 里会把花括号/反引号原样吐进产物 → 无效 CSS。 */}
    <noscript>
      <style is:inline>
        .fade-in {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body class="bg-ink text-cream">
    <a href="#main-content" class="skip-to-main">跳到主要内容</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    {/* is:inline：尽早武装，避免 deferred module 晚到时首屏先隐藏再弹出 */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var els = Array.prototype.slice.call(document.querySelectorAll('.fade-in'));
        if (!els.length) return;

        function markVisible(el) {
          el.classList.add('is-visible');
        }

        function inViewport(el) {
          var rect = el.getBoundingClientRect();
          return rect.top < window.innerHeight * 0.92 && rect.bottom > 0;
        }

        /**
         * 带 hash 进入时，浏览器直接滚到锚点，上方区块从未过视口。
         * 对「目标之前 / 包住目标」的 .fade-in 一次性标为已展示。
         */
        function revealFadeInsForHash() {
          var raw = location.hash && location.hash.slice(1);
          if (!raw) return;
          var id;
          try {
            id = decodeURIComponent(raw);
          } catch (e) {
            id = raw;
          }
          var target = document.getElementById(id);
          if (!target) return;
          var FOLLOWING = Node.DOCUMENT_POSITION_FOLLOWING;
          els.forEach(function (el) {
            var same = el === target;
            var wraps = el.contains(target);
            var strictlyBefore =
              !same && !wraps && !!(el.compareDocumentPosition(target) & FOLLOWING);
            if (same || wraps || strictlyBefore) markVisible(el);
          });
        }

        // 减少动效：全部可见，不武装隐藏
        if (root.classList.contains('reduce-motion')) {
          els.forEach(markVisible);
          return;
        }

        // 先标首屏可见块，再加 js-fade —— 避免「默认 opacity:0」造成的空白闪现
        els.forEach(function (el) {
          if (inViewport(el)) markVisible(el);
        });
        revealFadeInsForHash();
        root.classList.add('js-fade');

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                markVisible(entry.target);
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -10% 0px' }
        );
        els.forEach(function (el) {
          if (!el.classList.contains('is-visible')) observer.observe(el);
        });

        requestAnimationFrame(function () {
          requestAnimationFrame(revealFadeInsForHash);
        });
        window.addEventListener('hashchange', revealFadeInsForHash);
      })();
    </script>
  </body>
</html>
