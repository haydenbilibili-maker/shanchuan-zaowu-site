---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** LCP 图片（如首页 Hero 背景）· 注入 <link rel="preload"> */
  preloadImage?: string;
}

const {
  title,
  description = '把山海带回家——让自然博物美学进入日常生活',
  // 2026-09-17 审计 E5：原默认值 `/images/hero/home-hero.jpg` 是**占位目录里并不存在**的文件，
  // 导致 14 个构建页面（未覆写 image 的全部页面）的 og:image / twitter:image 指向 404。
  // 改指向真实存在、且本来就被首页当分享图的标本主图（207KB，站点里已随构建发布）。
  image = '/specimens/hero-specimen.jpg',
  preloadImage,
} = Astro.props;

const fullTitle = title === '山海造物'
  ? '山海造物 · 把山海带回家'
  : `${title} · 山海造物`;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : new URL(Astro.url.pathname, Astro.url);
const ogImageURL = Astro.site ? new URL(image, Astro.site) : new URL(image, Astro.url);

const siteHref = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd =
  siteHref &&
  JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${siteHref}/#organization`,
        name: '山海造物',
        alternateName: ["Nature's Creations"],
        url: siteHref,
        logo: `${siteHref}/favicon.svg`,
        email: 'hello@shanhaizaowu.com',
        slogan: '把山海带回家',
      },
      {
        '@type': 'WebSite',
        '@id': `${siteHref}/#website`,
        url: siteHref,
        name: '山海造物',
        inLanguage: 'zh-CN',
        publisher: { '@id': `${siteHref}/#organization` },
      },
    ],
  });
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1A1814" id="theme-color-dynamic" />

    {/*
      ===== 主题初始化（is:inline · 必须在所有内容之前）=====
      逻辑：localStorage > 系统偏好 > dark 兜底
      作用：在浏览器解析 HTML 时立即写入 data-theme，避免 FOUC（深色闪一下再切浅色）
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          var root = document.documentElement;
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          var tc = document.getElementById('theme-color-dynamic');
          if (tc) tc.setAttribute('content', theme === 'dark' ? '#1A1814' : '#FAFAF5');
          if (
            typeof window.matchMedia !== 'undefined' &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            root.classList.add('reduce-motion');
          }
        } catch (e) {
          var root2 = document.documentElement;
          root2.dataset.theme = 'dark';
          root2.style.colorScheme = 'dark';
          var tc2 = document.getElementById('theme-color-dynamic');
          if (tc2) tc2.setAttribute('content', '#1A1814');
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang="zh-CN" href={canonicalURL.href} />

    {/* OpenGraph（分享时使用生产域名绝对地址） */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:site_name" content="山海造物" />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    {jsonLd ? <script is:inline type="application/ld+json" set:html={jsonLd} /> : null}
    {/* 2026-09-17 审计 E6：`.fade-in` 默认 opacity:0，只靠 JS 揭示 —— JS 失败/被禁用时
        整块内容永久不可见。这里给无 JS 场景一个强制可见的兜底（用 !important 压过
        Tailwind 的 @apply opacity-0，且不依赖样式表顺序）。 */}
    <noscript>
      <style>{`.fade-in{opacity:1 !important;transform:none !important}`}</style>
    </noscript>
  </head>

  <body class="bg-ink text-cream">
    <a href="#main-content" class="skip-to-main">跳到主要内容</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      // 极克制的进入动效（IntersectionObserver）
      // threshold:0 + rootMargin:"0px 0px -10% 0px" → 元素任意像素进视口即触发，
      // 不依赖元素高度（避免超长正文区因 ratio < 0.15 而永久隐形的陷阱）。
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px 0px -10% 0px' }
      );

      const els = document.querySelectorAll('.fade-in');

      /**
       * 带 hash 进入（如 /how/senses#sense-touch）时，浏览器直接滚到锚点，
       * 上方区块从未经过视口 → IO 不会触发 → 会长期保持 opacity:0。
       * 对「目标元素之前」的 .fade-in 以及「包住目标 id」的容器一次性标为已展示。
       */
      function revealFadeInsForHash() {
        const raw = location.hash?.slice(1);
        if (!raw) return;
        let id;
        try {
          id = decodeURIComponent(raw);
        } catch {
          id = raw;
        }
        const target = document.getElementById(id);
        if (!target) return;

        const FOLLOWING = Node.DOCUMENT_POSITION_FOLLOWING;

        els.forEach((el) => {
          const same = el === target;
          const wraps = el.contains(target);
          const strictlyBefore = !same && !wraps && (el.compareDocumentPosition(target) & FOLLOWING);
          if (same || wraps || strictlyBefore) {
            el.classList.add('is-visible');
            observer.unobserve(el);
          }
        });
      }

      els.forEach((el) => observer.observe(el));

      // 锚点滚动往往在布局之后；双 rAF 尽量排在浏览器完成 hash scroll 之后
      requestAnimationFrame(() => {
        requestAnimationFrame(revealFadeInsForHash);
      });

      window.addEventListener('hashchange', revealFadeInsForHash);

      // 兜底：如果 JS 在视口已滚到位之后才执行，或 IO 异常，
      // 100ms 后强制把已经在视口内的 fade-in 标为 visible，
      // 永远不要让用户看到长时间的空白页。
      window.addEventListener('load', () => {
        setTimeout(() => {
          els.forEach((el) => {
            const rect = (el as HTMLElement).getBoundingClientRect();
            const inView = rect.top < window.innerHeight && rect.bottom > 0;
            if (inView) el.classList.add('is-visible');
          });
          revealFadeInsForHash();
        }, 100);
      });
    </script>
  </body>
</html>
