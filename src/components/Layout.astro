---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = '把山海带回家——让自然博物美学进入日常生活',
  image = '/images/hero/home-hero.jpg',
} = Astro.props;

const fullTitle = title === '山海造物'
  ? '山海造物 · 把山海带回家'
  : `${title} · 山海造物`;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : new URL(Astro.url.pathname, Astro.url);
const ogImageURL = Astro.site ? new URL(image, Astro.site) : new URL(image, Astro.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/*
      ===== 主题初始化（is:inline · 必须在所有内容之前）=====
      逻辑：localStorage > 系统偏好 > dark 兜底
      作用：在浏览器解析 HTML 时立即写入 data-theme，避免 FOUC（深色闪一下再切浅色）
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL.href} />

    {/* OpenGraph（分享时使用生产域名绝对地址） */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:type" content="website" />

    {/* 主题色（移动端浏览器 chrome 颜色 · 跟随系统偏好） */}
    <meta name="theme-color" content="#1A1814" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAFAF5" media="(prefers-color-scheme: light)" />
  </head>

  <body class="bg-ink text-cream">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // 极克制的进入动效（IntersectionObserver）
      // threshold:0 + rootMargin:"0px 0px -10% 0px" → 元素任意像素进视口即触发，
      // 不依赖元素高度（避免超长正文区因 ratio < 0.15 而永久隐形的陷阱）。
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px 0px -10% 0px' }
      );

      const els = document.querySelectorAll('.fade-in');

      /**
       * 带 hash 进入（如 /how/senses#sense-touch）时，浏览器直接滚到锚点，
       * 上方区块从未经过视口 → IO 不会触发 → 会长期保持 opacity:0。
       * 对「目标元素之前」的 .fade-in 以及「包住目标 id」的容器一次性标为已展示。
       */
      function revealFadeInsForHash() {
        const raw = location.hash?.slice(1);
        if (!raw) return;
        let id;
        try {
          id = decodeURIComponent(raw);
        } catch {
          id = raw;
        }
        const target = document.getElementById(id);
        if (!target) return;

        const FOLLOWING = Node.DOCUMENT_POSITION_FOLLOWING;

        els.forEach((el) => {
          const same = el === target;
          const wraps = el.contains(target);
          const strictlyBefore = !same && !wraps && (el.compareDocumentPosition(target) & FOLLOWING);
          if (same || wraps || strictlyBefore) {
            el.classList.add('is-visible');
            observer.unobserve(el);
          }
        });
      }

      els.forEach((el) => observer.observe(el));

      // 锚点滚动往往在布局之后；双 rAF 尽量排在浏览器完成 hash scroll 之后
      requestAnimationFrame(() => {
        requestAnimationFrame(revealFadeInsForHash);
      });

      window.addEventListener('hashchange', revealFadeInsForHash);

      // 兜底：如果 JS 在视口已滚到位之后才执行，或 IO 异常，
      // 100ms 后强制把已经在视口内的 fade-in 标为 visible，
      // 永远不要让用户看到长时间的空白页。
      window.addEventListener('load', () => {
        setTimeout(() => {
          els.forEach((el) => {
            const rect = (el as HTMLElement).getBoundingClientRect();
            const inView = rect.top < window.innerHeight && rect.bottom > 0;
            if (inView) el.classList.add('is-visible');
          });
          revealFadeInsForHash();
        }, 100);
      });
    </script>
  </body>
</html>
