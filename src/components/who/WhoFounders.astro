---
const founders = [
  {
    cn: '李贺',
    alt: '李贺 · 「山海造物」联合创始人',
    image: '/images/founders/lihe.jpg',
    width: 1024,
    height: 1023,
    /** 人像偏右，竖幅裁切时锚定面孔 */
    objectPosition: '72% 28%',
    bio: [
      '1992 年生于东北。互联网行业背景——优酷、支付宝、B 站。',
      '在「山海造物」，主导品牌叙事、IP 体系、空间规划、内容输出、资本结构。',
    ],
    voice:
      '他不反感互联网的速度，但他知道那种速度并不适合所有事情。做一家自然博物美学的店，是不适合那种速度的。',
  },
  {
    cn: '廉澍',
    alt: '廉澍 · 「山海造物」联合创始人',
    image: '/images/founders/lianshu.png',
    width: 900,
    height: 1125,
    objectPosition: '50% 30%',
    bio: [
      '生于吉林。标本工艺与工坊运营主导。',
      '在「山海造物」，主导生产体系、品控、本地交付、加盟落地。',
    ],
    voice:
      '我常跟合伙人讲：店里摸到的边框、客人读到的说明卡——背后都得有流程钉死。李贺搭系统架构，我把交付钉在店里和未来的工坊里。',
  },
];
---

<section class="editorial-section py-section fade-in">
  <p class="section-number mb-4">I</p>
  <h2 class="section-title text-cream">创始团队</h2>

  <div class="mt-paragraph grid md:grid-cols-2 gap-10 md:gap-12">
    {founders.map((f) => (
      <article>
        <figure
          class="who-founder-portrait mb-6 border border-brass-mid/25 overflow-hidden bg-ink-elevated aspect-[4/5]"
        >
          <img
            src={f.image}
            alt={f.alt}
            width={f.width}
            height={f.height}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover who-founder-portrait__img transition-transform duration-700 hover:scale-[1.02]"
            style={`object-position: ${f.objectPosition};`}
          />
        </figure>
        <h3 class="font-serif text-2xl text-cream mb-1 tracking-cn">{f.cn}</h3>
        <p class="font-serif-en italic text-brass-mid text-sm mb-4">Co-founder · 联合创始人</p>
        <div class="prose-cn space-y-paragraph">
          {f.bio.map((p) => <p>{p}</p>)}
        </div>
        <blockquote class="mt-6 pl-4 border-l border-brass-mid/50">
          <p class="font-serif italic text-text-soft text-sm leading-relaxed">{f.voice}</p>
        </blockquote>
      </article>
    ))}
  </div>
</section>

<style>
  .who-founder-portrait__img {
    filter: saturate(0.92) contrast(1.02);
  }
</style>
