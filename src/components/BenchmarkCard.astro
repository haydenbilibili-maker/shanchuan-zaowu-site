---
interface Props {
  name: string;
  role: string;
  gen: string;
  learn: string;
  notlearn: string;
  highlight?: 'warning' | 'default';
}

const { name, role, gen, learn, notlearn, highlight = 'default' } = Astro.props;
const isWarning = highlight === 'warning';
---

<article
  class:list={[
    'benchmark-card p-6 rounded-sm border',
    isWarning
      ? 'border-coral-deep/40 bg-ink-deep/40'
      : 'border-brass-mid/25 bg-ink-elevated/40',
  ]}
>
  <header class="mb-4">
    <h3 class:list={['font-serif text-lg tracking-cn', isWarning ? 'text-coral-deep' : 'text-cream']}>
      {name}
    </h3>
    <p class="text-xs text-brass-mid mt-1">{role}</p>
    <p class="text-xs text-text-soft mt-2 font-serif-en italic">{gen}</p>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
    <div>
      <p class="text-xs text-brass-mid uppercase tracking-widest mb-1">学什么</p>
      <p class="text-cream/90 leading-relaxed">{learn}</p>
    </div>
    <div class="sm:border-l sm:border-brass-mid/20 sm:pl-4">
      <p class="text-xs text-text-soft uppercase tracking-widest mb-1">不学什么</p>
      <p class="text-text-soft leading-relaxed">{notlearn}</p>
    </div>
  </div>
</article>
