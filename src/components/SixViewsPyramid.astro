---
/* 六观金字塔 · v0.4 · SVG 680×460 · 颜色随 :root[data-theme] 切换 */
---

<div class="six-views-pyramid-root w-full max-w-3xl mx-auto px-2">
  <svg
    width="100%"
    viewBox="0 0 680 460"
    role="img"
    aria-label="山海造物六观体系金字塔"
    class="six-views-pyramid block"
  >
    <title>山海造物六观金字塔</title>
    <desc>
      从下到上六层：自然观、空间观、内容观、人才观、承诺观、合规观。合规观位于顶端用珊瑚红强调，是品牌的边界，触碰则整体崩溃。
    </desc>

    <g class="layer-compliance">
      <rect
        x="40"
        y="20"
        width="600"
        height="60"
        rx="8"
        fill="var(--pyramid-coral-fill)"
        stroke="var(--pyramid-coral-stroke)"
        stroke-width="1.5"></rect>
      <text x="64" y="44" dominant-baseline="central" fill="var(--pyramid-coral-title)" font-size="14" font-weight="500">合规观</text>
      <text x="64" y="64" dominant-baseline="central" fill="var(--pyramid-coral-sub)" font-size="12">对外硬性边界 · 红线 · 不做的事</text>
      <text x="616" y="50" text-anchor="end" dominant-baseline="central" fill="var(--pyramid-coral-title)" font-size="14" font-weight="500">触碰即崩溃</text>
    </g>

    <g class="layer-tier">
      <rect x="40" y="100" width="600" height="56" rx="8" fill="var(--pyramid-tier-fill)" stroke="var(--pyramid-tier-stroke)" stroke-width="0.5"
      ></rect>
      <text x="64" y="122" dominant-baseline="central" fill="var(--pyramid-tier-title)" font-size="14" font-weight="500">承诺观</text>
      <text x="64" y="140" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">对外硬性承诺 · 额外承担的事</text>
      <text x="616" y="128" text-anchor="end" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">1% · AED · 应急</text>
    </g>

    <g class="layer-tier">
      <rect x="40" y="160" width="600" height="56" rx="8" fill="var(--pyramid-tier-fill)" stroke="var(--pyramid-tier-stroke)" stroke-width="0.5"
      ></rect>
      <text x="64" y="182" dominant-baseline="central" fill="var(--pyramid-tier-title)" font-size="14" font-weight="500">人才观</text>
      <text x="64" y="200" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">对内组织 · 谁来做这件事</text>
      <text x="616" y="188" text-anchor="end" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">青年优先</text>
    </g>

    <g class="layer-tier">
      <rect x="40" y="220" width="600" height="56" rx="8" fill="var(--pyramid-tier-fill)" stroke="var(--pyramid-tier-stroke)" stroke-width="0.5"
      ></rect>
      <text x="64" y="242" dominant-baseline="central" fill="var(--pyramid-tier-title)" font-size="14" font-weight="500">内容观</text>
      <text x="64" y="260" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">对外表达 · 如何说</text>
      <text x="616" y="248" text-anchor="end" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">诚实地走过问题</text>
    </g>

    <g class="layer-tier">
      <rect x="40" y="280" width="600" height="56" rx="8" fill="var(--pyramid-tier-fill)" stroke="var(--pyramid-tier-stroke)" stroke-width="0.5"
      ></rect>
      <text x="64" y="302" dominant-baseline="central" fill="var(--pyramid-tier-title)" font-size="14" font-weight="500">空间观</text>
      <text x="64" y="320" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">对内体验 · 店即博物馆</text>
      <text x="616" y="308" text-anchor="end" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">让人停下来</text>
    </g>

    <g class="layer-tier">
      <rect x="40" y="340" width="600" height="56" rx="8" fill="var(--pyramid-tier-fill)" stroke="var(--pyramid-tier-stroke)" stroke-width="0.5"
      ></rect>
      <text x="64" y="362" dominant-baseline="central" fill="var(--pyramid-tier-title)" font-size="14" font-weight="500">自然观</text>
      <text x="64" y="380" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">根本立场 · 一切从这里出发</text>
      <text x="616" y="368" text-anchor="end" dominant-baseline="central" fill="var(--pyramid-tier-sub)" font-size="12">向自然学习</text>
    </g>

    <text
      x="340"
      y="425"
      text-anchor="middle"
      fill="var(--pyramid-footnote)"
      font-size="12"
      font-style="italic"
      class="font-serif-en">合规观位于顶端 · 它是边界 · 触碰红线则其他五观全部失效</text>
  </svg>
</div>

<style>
  .six-views-pyramid-root {
    --pyramid-coral-fill: #4a1b0c;
    --pyramid-coral-stroke: #f0997b;
    --pyramid-coral-title: #faece7;
    --pyramid-coral-sub: #f0997b;
    --pyramid-tier-fill: #412402;
    --pyramid-tier-stroke: #ef9f27;
    --pyramid-tier-title: #faeeda;
    --pyramid-tier-sub: #ef9f27;
    --pyramid-footnote: #998b73;
  }

  :global(:root[data-theme='light']) .six-views-pyramid-root {
    --pyramid-coral-fill: #faece7;
    --pyramid-coral-stroke: #993c1d;
    --pyramid-coral-title: #712b13;
    --pyramid-coral-sub: #993c1d;
    --pyramid-tier-fill: #faeeda;
    --pyramid-tier-stroke: #854f0b;
    --pyramid-tier-title: #633806;
    --pyramid-tier-sub: #854f0b;
    --pyramid-footnote: #6b5f4f;
  }
</style>
