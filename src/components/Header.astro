---
const navItems = [
  { href: '/', label: '首页' },
  { href: '/products', label: '我们做什么' },
  { href: '/about', label: '我们是谁' },
  { href: '/senses', label: '五感' },
  { href: '/space', label: '空间' },
  { href: '/values', label: '价值观' },
  { href: '/commitment', label: '承诺' },
  { href: '/notes', label: '笔记' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-ink/85 backdrop-blur-md border-b border-brass-mid/15">
  <nav class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="group flex items-baseline gap-3">
      <span class="font-serif text-xl text-cream tracking-cn">山川造物</span>
      <span class="font-serif-en text-sm text-brass-mid italic hidden sm:inline">
        Nature&rsquo;s Creations
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-7 text-sm">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'text-text-soft hover:text-brass-mid transition-colors duration-200',
              currentPath === item.href && 'text-brass-mid',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-cream"
      aria-label="打开菜单"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="4" y1="8" x2="20" y2="8" />
        <line x1="4" y1="16" x2="20" y2="16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-brass-mid/15 bg-ink-elevated">
    <ul class="px-6 py-4 space-y-3">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block py-2 text-text-soft',
              currentPath === item.href && 'text-brass-mid',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
