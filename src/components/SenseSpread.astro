---
interface Props {
  /** 中文感官名（如"视"） */
  sense: string;
  /** 英文感官名（如"Sight"） */
  senseEn: string;
  /** 中文标题 */
  title: string;
  /** 段落正文（支持 HTML） */
  bodyHtml: string;
  /** 图片路径（可选；未提供时显示黄铜色占位块）*/
  image?: string;
  /** 图片说明 */
  imageAlt: string;
  /** 布局方向：left = 图左文右；right = 图右文左 */
  align?: 'left' | 'right';
  /** 可选音频文件（仅"听"使用） */
  audio?: string;
  /** 章节序号（罗马数字 / 中文一二三）*/
  number?: string;
}

const { sense, senseEn, title, bodyHtml, image, imageAlt, align = 'left', audio, number } = Astro.props;
---

<section class="editorial-section-wide fade-in">
  <div class:list={[
    'grid md:grid-cols-2 gap-10 md:gap-16 items-center',
    align === 'right' && 'md:[&>*:first-child]:order-2',
  ]}>
    <!-- Image / Placeholder · 深底家族渐变 -->
    <figure class="relative aspect-[4/5] bg-gradient-to-br from-brass-deep/25 to-brass-mid/10 border border-brass-mid/30 flex items-center justify-center overflow-hidden">
      {image ? (
        <img
          src={image}
          alt={imageAlt}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      ) : (
        <span class="font-serif-en text-brass-mid/50 italic text-2xl">{senseEn}</span>
      )}
      {/* 图片左上角的章节编号（向外溢出，桌面端可见） */}
      {number && (
        <span class="absolute -left-4 -top-4 section-number opacity-50 hidden md:block">
          {number}
        </span>
      )}
    </figure>

    <!-- Text -->
    <div>
      <!-- 感官标签（深底上用 brass-bright 更跳跃） -->
      <div class="flex items-baseline gap-3 mb-6">
        <span class="font-serif text-display text-brass-bright">{sense}</span>
        <span class="font-serif-en italic text-text-soft text-lg">· {senseEn}</span>
      </div>

      <!-- 标题 -->
      <h2 class="section-title text-cream mb-paragraph">{title}</h2>

      <!-- 正文 -->
      <div class="prose-cn" set:html={bodyHtml}></div>

      <!-- 音频（仅"听"段落使用；反色让原生播放器在深底上不刺眼） -->
      {audio && (
        <div class="mt-paragraph border-l-2 border-brass-mid pl-5 py-2">
          <p class="text-xs text-text-soft mb-2 tracking-cn">
            一段 30 秒的店内环境音
          </p>
          <audio
            controls
            preload="metadata"
            class="w-full max-w-sm"
            style="filter: invert(1) hue-rotate(180deg);"
          >
            <source src={audio} type="audio/mpeg" />
            您的浏览器不支持音频播放
          </audio>
        </div>
      )}
    </div>
  </div>
</section>
