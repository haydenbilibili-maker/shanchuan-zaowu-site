---
interface Props {
  /** 卡片标题 · 中文（如"物业招商"）*/
  title: string;
  /** 副题 · 镜像受众心理（如"你想把铺位给一个长期主义的品牌"）*/
  subtitle: string;
  /** 正文 · 60 字以内 */
  body: string;
  /** CTA 文字 */
  cta: string;
  /** 跳转目标（支持站内路径与 mailto:）*/
  href: string;
  /** 卡片角标编号（罗马数字 / 中文）*/
  number?: string;
}

const { title, subtitle, body, cta, href, number } = Astro.props;
---

<a
  href={href}
  class="group block relative p-8 md:p-10
         bg-ink-elevated/60 hover:bg-ink-elevated
         border border-brass-mid/15 hover:border-brass-mid/40
         transition-all duration-300"
>
  {number && (
    <span class="absolute top-6 right-6 font-serif-en italic text-brass-mid/30 text-2xl">
      {number}
    </span>
  )}

  <div class="flex flex-col h-full">
    <h3 class="font-serif text-2xl text-cream mb-2 tracking-cn">
      {title}
    </h3>
    <p class="font-serif text-sm text-brass-mid mb-6 tracking-cn leading-relaxed">
      {subtitle}
    </p>
    <p class="text-text-soft text-sm leading-[1.85] tracking-cn flex-1 mb-6">
      {body}
    </p>

    <span class="inline-flex items-center gap-2 text-sm text-cream
                 group-hover:text-brass-mid transition-colors duration-200">
      {cta}
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
           class="group-hover:translate-x-1 transition-transform duration-200">
        <line x1="3" y1="8" x2="13" y2="8" />
        <polyline points="9,4 13,8 9,12" />
      </svg>
    </span>
  </div>
</a>
