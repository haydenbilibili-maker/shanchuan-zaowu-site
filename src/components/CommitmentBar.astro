---
const commitments = [
  '门店即博物馆',
  '门店即城市公共客厅',
  '1% 营收用于自然保护',
  '妈妈的饺子 A 套餐',
];

const values = [
  { label: '自然观', href: '/foundation#nature' },
  { label: '空间观', href: '/foundation#view-space' },
  { label: '内容观', href: '/foundation#content' },
  { label: '人才观', href: '/foundation#talent' },
  { label: '承诺观', href: '/foundation#pledge-view' },
  { label: '合规观', href: '/foundation#view-compliance' },
  { label: '科技观', href: '/how/tech' },
];
---

<section class="border-y border-brass-mid/15 bg-ink-deep/40 my-section">
  <div class="max-w-7xl mx-auto px-6 py-12">
    {/* 第一行 · 承诺 */}
    <div class="mb-8 text-center">
      <p class="font-serif-en italic text-xs text-brass-mid tracking-widest uppercase mb-3">
        Our Commitments · 我们的承诺
      </p>
      <p class="font-serif text-lg md:text-xl text-cream tracking-cn mb-4 max-w-editorial mx-auto leading-relaxed">
        山海造物的店不只是商业空间，<span class="text-brass-bright">是城市公共生活的一部分</span>。
      </p>
      <p class="font-serif text-sm md:text-base text-cream/80 tracking-cn mb-3">
        {commitments.join(' · ')}
      </p>
      <a
        href="/foundation#one-percent"
        class="inline-block text-xs text-brass-mid hover:text-brass-bright transition-colors font-serif-en italic tracking-widest uppercase"
      >
        了解 1% 承诺 →
      </a>
    </div>

    {/* 黄铜分隔（缩短上下间距）*/}
    <hr class="brass-divider !my-6" />

    {/* 第二行 · 六观 + 科技 */}
    <div class="text-center">
      <p class="font-serif-en italic text-xs text-brass-mid tracking-widest uppercase mb-3">
        Six Views · 六观
      </p>
      <ul class="flex flex-wrap justify-center gap-x-2 gap-y-2 text-sm">
        {values.map((v, i) => (
          <li class="flex items-center">
            <a href={v.href} class="text-text-soft hover:text-brass-mid transition-colors duration-200 font-serif tracking-cn">
              {v.label}
            </a>
            {i < values.length - 1 && <span class="text-brass-mid/30 mx-2">·</span>}
          </li>
        ))}
      </ul>
      <a href="/foundation" class="inline-block mt-4 text-xs text-brass-mid hover:text-brass-bright transition-colors">
        完整体系 →
      </a>
    </div>
  </div>
</section>
