---
interface Props {
  /** 块标题 */
  title: string;
  /** 英文 eyebrow */
  subtitle?: string;
  /** 条目列表 */
  items: { name: string; detail: string }[];
  /** 正变体（捐给）/ 负变体（不捐给）*/
  variant?: 'positive' | 'negative';
}

const { title, subtitle, items, variant = 'positive' } = Astro.props;
const isNeg = variant === 'negative';
---

<div class:list={[
  'p-6 md:p-8',
  isNeg
    ? 'border border-brass-deep/40 bg-ink-deep/30'
    : 'border border-brass-mid/20 bg-ink-elevated/40',
]}>
  <h3 class:list={[
    'font-serif text-xl mb-2 tracking-cn',
    isNeg ? 'text-brass-deep' : 'text-brass-bright',
  ]}>
    {title}
  </h3>
  {subtitle && (
    <p class="font-serif-en italic text-text-soft text-xs mb-4 tracking-widest uppercase">
      {subtitle}
    </p>
  )}

  <ul class="space-y-4">
    {items.map((item) => (
      <li>
        <p class="text-cream font-serif tracking-cn mb-1">
          {isNeg && <span class="text-brass-deep mr-2">×</span>}
          {item.name}
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn pl-0">
          {item.detail}
        </p>
      </li>
    ))}
  </ul>
</div>
