---
// 山海造物 · Nature's Creations · 主页 v0.3
// 实施说明见仓库内 IMPLEMENTATION 对话与 public/specimens/README.md
import Layout from '../components/Layout.astro';
---

<Layout
  title="山海造物"
  description="做自然博物美学的标本与衍生品 · 开「让人留得比必要的久」的店 · 山海造物 Nature's Creations · 自 2024。"
  image="/specimens/hero-specimen.svg"
>
  <div class="home">
    {/* 节拍 1 · Hero · 右图左字 */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-text">
          <p class="caps-tag">NATURE'S CREATIONS &nbsp;·&nbsp; SINCE 2024</p>
          <h1 id="hero-title" class="hero-title">
            让自然博物美学<br />进入日常生活
          </h1>
          <p class="hero-tagline-en">Bring Nature Home.</p>
          <p class="hero-blurb">
            做自然博物美学的标本与衍生品 · 开「让人留得比必要的久」的店。
          </p>
        </div>
        <figure class="hero-figure">
          <img
            src="/specimens/hero-specimen.svg"
            alt="一只蝴蝶标本特写 · 山海造物收藏（占位图）"
            class="hero-specimen"
            loading="eager"
            width="540"
            height="540"
          />
          <figcaption class="plate-caption">Plate&nbsp;I &nbsp;·&nbsp; specimen</figcaption>
        </figure>
      </div>
      <div class="scroll-indicator" aria-hidden="true">
        <p class="caps-tag-mini">SCROLL</p>
        <span class="scroll-arrow">↓</span>
      </div>
    </section>

    {/* 节拍 2 · What · Who · Why · How */}
    <section class="entry-grid" aria-labelledby="entry-title">
      <h2 id="entry-title" class="section-major-title">
        What <span class="dot">·</span> Who <span class="dot">·</span> Why <span class="dot">·</span> How
      </h2>

      <div class="entry-cards">
        <a href="/what" class="entry-card">
          <p class="card-tag-en"><em>What</em></p>
          <h3 class="card-title">我们做什么</h3>
          <p class="card-subtitle">产品 · 展陈与「不做」清单</p>
          <p class="card-body">
            自然小匣主推 · 蝴蝶与贝壳 · 化石矿石与门店主题标本（约 20%）——以及我们拒绝成为的那种店。
          </p>
          <p class="card-cta">阅读 What &nbsp;→</p>
        </a>

        <a href="/who" class="entry-card">
          <p class="card-tag-en"><em>Who</em></p>
          <h3 class="card-title">我们是谁</h3>
          <p class="card-subtitle">团队 · 起源与长期坐标</p>
          <p class="card-body">
            从长春出发的品牌与一群人——把博物学当作日常方法 · 而不是营销皮肤。
          </p>
          <p class="card-cta">阅读 Who &nbsp;→</p>
        </a>

        <a href="/why" class="entry-card">
          <p class="card-tag-en"><em>Why</em></p>
          <h3 class="card-title">为什么</h3>
          <p class="card-subtitle">三个判断与坐标</p>
          <p class="card-body">
            若这些判断在你看来不成立 · 我们大概率不是同路人——省彼此时间。
          </p>
          <p class="card-cta">阅读 Why &nbsp;→</p>
        </a>

        <a href="/how" class="entry-card">
          <p class="card-tag-en"><em>How</em></p>
          <h3 class="card-title">怎么做</h3>
          <p class="card-subtitle">五感 · 空间 · 运营 · 科技</p>
          <p class="card-body">
            理念落在可被感受的日常里——四个支点彼此咬合。
          </p>
          <p class="card-cta">进入 How &nbsp;→</p>
        </a>
      </div>
    </section>

    {/* 节拍 3 · 价值底座 */}
    <section class="foundation" aria-labelledby="foundation-title">
      <p class="caps-tag-deep">FOUNDATION</p>
      <h2 id="foundation-title" class="foundation-title">价值底座</h2>
      <p class="foundation-subtitle">一切的底色</p>
      <div class="hr-thin" aria-hidden="true"></div>
      <p class="foundation-body">
        六观裁定 · 1% 营收承诺<br />——同一条底线上的两面
      </p>
      <a href="/foundation" class="cta-button">
        进入价值底座 &nbsp;→
      </a>
    </section>

    {/* 节拍 4 · 我们的承诺 · 2x2 */}
    <section class="commitments" aria-labelledby="commitments-title">
      <p class="caps-tag">OUR COMMITMENTS &nbsp;·&nbsp; 我们的承诺</p>
      <h2 id="commitments-title" class="section-title">
        山海造物的店不只是商业空间<br />是城市公共生活的一部分。
      </h2>

      <div class="commitment-grid">
        <article class="commitment-card">
          <p class="commitment-number"><em>01</em></p>
          <h3 class="commitment-title">门店即博物馆</h3>
          <p class="commitment-body">
            每家店都按博物馆标准做展陈与导览——而不是套件商品店。
          </p>
        </article>
        <article class="commitment-card">
          <p class="commitment-number"><em>02</em></p>
          <h3 class="commitment-title">门店即城市公共客厅</h3>
          <p class="commitment-body">
            即便不消费 · 也可以坐下 · 阅读 · 看标本——为城市留一处沉静处。
          </p>
        </article>
        <article class="commitment-card">
          <p class="commitment-number"><em>03</em></p>
          <h3 class="commitment-title">1% 营收用于自然保护</h3>
          <p class="commitment-body">
            不是利润 · 是营收——开店第一天起 · 每一笔交易就在做这件事。
          </p>
        </article>
        <article class="commitment-card">
          <p class="commitment-number"><em>04</em></p>
          <h3 class="commitment-title">妈妈的饺子 A 套餐</h3>
          <p class="commitment-body">
            一份家常餐食 · 价格公道 · 对外开放——给每一位走进来的人。
          </p>
        </article>
      </div>

      <div class="commitment-cta">
        <a href="/foundation#one-percent">了解 1% 承诺 &nbsp;→</a>
      </div>
    </section>

    {/* 节拍 5 · 你为何而来 · inline（路由对齐站内 /for-*） */}
    <section class="for-whom-compact" aria-labelledby="for-whom-title">
      <p class="caps-tag-quiet">FOR WHOM &nbsp;·&nbsp; 写给特定的你</p>
      <h2 id="for-whom-title" class="for-whom-title">你为何而来</h2>
      <p class="for-whom-body">
        若你属于这 4 类访客 · 我们准备好了独立的入口
      </p>
      <div class="for-whom-links">
        <a href="/for-properties">物业招商 &nbsp;→</a>
        <a href="/for-investors">投资合作 &nbsp;→</a>
        <a href="/for-franchise">加盟咨询 &nbsp;→</a>
        <a href={'mailto:hello@shanhaizaowu.com?subject=' + encodeURIComponent('品牌合作意向')}>品牌合作 &nbsp;→</a>
      </div>
    </section>

    {/* 节拍 6 · 最新笔记 */}
    <section class="latest-note" aria-labelledby="note-title">
      <p class="caps-tag-quiet">LATEST NOTE &nbsp;·&nbsp; 最近一封</p>
      <h3 id="note-title" class="note-title">「写在工作室开门之前」</h3>
      <p class="note-excerpt">
        这周我们把工作室开起来——写一封信 · 回答自己为什么做这件事 · 也回答那些一路看到这里的人。
      </p>
      <a href="/notes/founders-letter" class="note-link">阅读 &nbsp;→</a>
    </section>

    {/* 节拍 7 · 收束 */}
    <section class="closer">
      <h2 class="closer-cn">把山海带回家。</h2>
      <p class="closer-en">Bring Nature Home.</p>
      <p class="closer-meta">——山海造物 &nbsp;·&nbsp; 自 2024</p>
    </section>
  </div>
</Layout>

<style>
  .home {
    --ink: #0e0e0e;
    --ink-deep: #1a140b;
    --cream-100: #f5f0e1;
    --text-primary: #f5f0e1;
    --text-secondary: #a89f87;
    --text-tertiary: #6b6353;
    --brass-mid: #b89867;
    --brass-light: #c9a876;
    --border-quiet: rgba(184, 152, 103, 0.15);
    --border-mid: rgba(184, 152, 103, 0.3);

    --font-cn-serif: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', '宋体', serif;
    --font-en-serif: 'Cormorant Garamond', 'Lyon Text', Georgia, serif;

    background: var(--ink);
    color: var(--text-primary);
    font-family: var(--font-cn-serif);
  }

  .caps-tag,
  .caps-tag-deep,
  .caps-tag-quiet,
  .caps-tag-mini {
    font-family: var(--font-en-serif);
    text-transform: uppercase;
    font-weight: 400;
    margin: 0;
  }
  .caps-tag {
    font-size: 12px;
    letter-spacing: 0.25em;
    color: var(--brass-mid);
  }
  .caps-tag-deep {
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--brass-mid);
  }
  .caps-tag-quiet {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--text-tertiary);
  }
  .caps-tag-mini {
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--text-tertiary);
  }

  .hero {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 6vw 40px;
    max-width: 1320px;
    margin: 0 auto;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 60px;
    align-items: center;
    flex: 1;
  }
  .hero-text {
    max-width: 540px;
  }
  .hero-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: 0.04em;
    margin: 28px 0 18px;
    color: var(--cream-100);
  }
  .hero-tagline-en {
    font-family: var(--font-en-serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 26px);
    color: var(--brass-mid);
    margin: 0 0 28px;
    font-weight: 400;
  }
  .hero-blurb {
    font-family: var(--font-cn-serif);
    font-size: 14px;
    line-height: 1.85;
    color: var(--text-secondary);
    max-width: 320px;
    margin: 0;
  }
  .hero-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
  }
  .hero-specimen {
    width: 100%;
    max-width: 480px;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: brightness(0.94) contrast(1.02);
  }
  .plate-caption {
    font-family: var(--font-en-serif);
    font-style: italic;
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--text-tertiary);
    margin: 18px 0 0;
  }
  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 56px;
    color: var(--text-tertiary);
  }
  .scroll-arrow {
    font-size: 16px;
    animation: home-scroll-pulse 2.4s ease-in-out infinite;
  }
  @keyframes home-scroll-pulse {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(4px);
      opacity: 1;
    }
  }

  .entry-grid {
    padding: 120px 6vw;
    max-width: 1320px;
    margin: 0 auto;
  }
  .section-major-title {
    font-family: var(--font-en-serif);
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 400;
    color: var(--cream-100);
    text-align: center;
    letter-spacing: 0.02em;
    margin: 0 0 80px;
    line-height: 1.2;
  }
  .section-major-title .dot {
    color: var(--brass-mid);
    margin: 0 0.3em;
    font-style: italic;
  }
  .entry-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 0.5px solid var(--border-quiet);
    border-left: 0.5px solid var(--border-quiet);
  }
  .entry-card {
    display: block;
    padding: 48px 40px;
    border-right: 0.5px solid var(--border-quiet);
    border-bottom: 0.5px solid var(--border-quiet);
    text-decoration: none;
    color: inherit;
    transition: background 0.5s ease;
    position: relative;
    min-height: 240px;
  }
  .entry-card:hover {
    background: rgba(184, 152, 103, 0.04);
  }
  .card-tag-en {
    position: absolute;
    top: 32px;
    right: 36px;
    font-family: var(--font-en-serif);
    font-size: 22px;
    color: var(--brass-mid);
    margin: 0;
  }
  .card-title {
    font-family: var(--font-cn-serif);
    font-size: 28px;
    font-weight: 400;
    color: var(--cream-100);
    margin: 0 0 8px;
    letter-spacing: 0.05em;
  }
  .card-subtitle {
    font-family: var(--font-cn-serif);
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0 0 20px;
  }
  .card-body {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    line-height: 1.85;
    color: var(--text-secondary);
    margin: 0 0 28px;
    max-width: 360px;
  }
  .card-cta {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    color: var(--brass-mid);
    margin: 0;
    letter-spacing: 0.05em;
    transition: transform 0.4s ease;
  }
  .entry-card:hover .card-cta {
    transform: translateX(4px);
  }

  .foundation {
    background: var(--ink-deep);
    padding: 140px 6vw;
    text-align: center;
    border-top: 0.5px solid var(--border-quiet);
    border-bottom: 0.5px solid var(--border-quiet);
  }
  .foundation-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(56px, 8vw, 96px);
    font-weight: 400;
    color: var(--cream-100);
    letter-spacing: 0.06em;
    margin: 28px 0 8px;
    line-height: 1.2;
  }
  .foundation-subtitle {
    font-family: var(--font-cn-serif);
    font-size: clamp(20px, 2.4vw, 28px);
    color: var(--brass-mid);
    margin: 0 0 32px;
    letter-spacing: 0.1em;
  }
  .hr-thin {
    width: 40px;
    height: 0.5px;
    background: var(--brass-mid);
    margin: 0 auto 32px;
  }
  .foundation-body {
    font-family: var(--font-cn-serif);
    font-size: 15px;
    line-height: 1.95;
    color: var(--text-secondary);
    margin: 0 0 40px;
  }
  .cta-button {
    display: inline-block;
    padding: 14px 32px;
    border: 0.5px solid var(--brass-mid);
    color: var(--brass-mid);
    font-family: var(--font-cn-serif);
    font-size: 14px;
    letter-spacing: 0.18em;
    text-decoration: none;
    transition: all 0.4s ease;
  }
  .cta-button:hover {
    background: var(--brass-mid);
    color: var(--ink-deep);
  }

  .commitments {
    padding: 120px 6vw;
    max-width: 1320px;
    margin: 0 auto;
    text-align: center;
  }
  .section-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 400;
    color: var(--cream-100);
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 24px auto 64px;
    max-width: 820px;
  }
  .commitment-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 56px;
    max-width: 960px;
    margin: 0 auto 56px;
    text-align: left;
  }
  .commitment-card {
    padding: 4px 0 4px 28px;
    border-left: 0.5px solid var(--border-mid);
  }
  .commitment-number {
    font-family: var(--font-en-serif);
    font-size: 14px;
    color: var(--brass-mid);
    letter-spacing: 0.15em;
    margin: 0 0 12px;
  }
  .commitment-title {
    font-family: var(--font-cn-serif);
    font-size: 20px;
    font-weight: 400;
    color: var(--cream-100);
    margin: 0 0 10px;
    letter-spacing: 0.04em;
  }
  .commitment-body {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    line-height: 1.9;
    color: var(--text-secondary);
    margin: 0;
  }
  .commitment-cta a {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    color: var(--brass-mid);
    letter-spacing: 0.1em;
    text-decoration: none;
    border-bottom: 0.5px solid var(--brass-mid);
    padding-bottom: 3px;
    transition: opacity 0.3s ease;
  }
  .commitment-cta a:hover {
    opacity: 0.7;
  }

  .for-whom-compact {
    padding: 90px 6vw 80px;
    max-width: 1320px;
    margin: 0 auto;
    text-align: center;
    border-top: 0.5px solid var(--border-quiet);
  }
  .for-whom-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 400;
    color: var(--text-primary);
    margin: 14px 0 10px;
    letter-spacing: 0.05em;
  }
  .for-whom-body {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 32px;
  }
  .for-whom-links {
    display: flex;
    justify-content: center;
    gap: 36px;
    flex-wrap: wrap;
  }
  .for-whom-links a {
    font-family: var(--font-cn-serif);
    font-size: 14px;
    color: var(--brass-mid);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.3s ease;
  }
  .for-whom-links a:hover {
    color: var(--brass-light);
  }

  .latest-note {
    padding: 100px 6vw;
    max-width: 720px;
    margin: 0 auto;
    text-align: left;
    border-top: 0.5px solid var(--border-quiet);
  }
  .note-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 400;
    color: var(--cream-100);
    margin: 18px 0 16px;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .note-excerpt {
    font-family: var(--font-cn-serif);
    font-size: 14px;
    line-height: 1.9;
    color: var(--text-secondary);
    margin: 0 0 24px;
  }
  .note-link {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    color: var(--brass-mid);
    letter-spacing: 0.1em;
    text-decoration: none;
    border-bottom: 0.5px solid var(--brass-mid);
    padding-bottom: 2px;
  }

  .closer {
    padding: 120px 6vw;
    text-align: center;
    border-top: 0.5px solid var(--border-quiet);
  }
  .closer-cn {
    font-family: var(--font-cn-serif);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    color: var(--cream-100);
    margin: 0 0 14px;
    letter-spacing: 0.08em;
  }
  .closer-en {
    font-family: var(--font-en-serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: var(--brass-mid);
    margin: 0 0 24px;
  }
  .closer-meta {
    font-family: var(--font-cn-serif);
    font-size: 12px;
    color: var(--text-tertiary);
    letter-spacing: 0.15em;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      gap: 40px;
    }
    .entry-card {
      padding: 40px 32px;
      min-height: 220px;
    }
    .card-tag-en {
      top: 28px;
      right: 28px;
      font-size: 20px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 60px 5vw 40px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hero-figure {
      order: -1;
      max-width: 280px;
      margin: 0 auto;
    }
    .hero-specimen {
      max-width: 280px;
    }
    .hero-text {
      max-width: 100%;
    }
    .scroll-indicator {
      margin-top: 36px;
    }

    .entry-grid {
      padding: 80px 5vw;
    }
    .section-major-title {
      margin-bottom: 48px;
    }
    .entry-cards {
      grid-template-columns: 1fr;
      border-left: none;
    }
    .entry-card {
      padding: 36px 24px;
      min-height: auto;
    }
    .card-tag-en {
      top: 28px;
      right: 24px;
      font-size: 18px;
    }

    .foundation {
      padding: 100px 5vw;
    }

    .commitments {
      padding: 80px 5vw;
    }
    .commitment-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      max-width: 100%;
    }

    .for-whom-compact {
