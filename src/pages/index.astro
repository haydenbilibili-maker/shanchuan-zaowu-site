---
import Layout from '../components/Layout.astro';
import AudienceCard from '../components/AudienceCard.astro';
import CommitmentBar from '../components/CommitmentBar.astro';
import PullQuote from '../components/PullQuote.astro';

const pillars = [
  {
    number: 'What',
    title: '我们做什么',
    subtitle: '产品、展陈与「不做」清单',
    body: '自然小匣主推、蝴蝶与贝壳、化石矿石与门店主题标本（约 20%）——以及我们拒绝成为的那种店。',
    cta: '阅读 What',
    href: '/what',
  },
  {
    number: 'Who',
    title: '我们是谁',
    subtitle: '团队、起源与长期坐标',
    body: '从长春出发的品牌与一群人——把博物学当作日常方法，而不是营销皮肤。',
    cta: '阅读 Who',
    href: '/who',
  },
  {
    number: 'Why',
    title: '为什么',
    subtitle: '三个判断与坐标',
    body: '若这些判断在你看来不成立，我们大概率不是同路人——省彼此时间。',
    cta: '阅读 Why',
    href: '/why',
  },
  {
    number: 'How',
    title: '怎么做',
    subtitle: '五感、空间、运营、科技',
    body: '理念落在可被感受的日常里——四个支点彼此咬合。',
    cta: '进入 How',
    href: '/how',
  },
];

const audiences = [
  {
    number: 'I',
    title: '物业招商',
    subtitle: '你想把铺位给一个长期主义的品牌',
    body: '我们正在寻找有美学底蕴的文创街区与文化综合体。从长春这有山起步，正在为 2026-2028 年的 6-10 家直营店选址。',
    cta: '了解我们对物业的要求',
    href: '/for-properties',
  },
  {
    number: 'II',
    title: '投资合作',
    subtitle: '你在找一个不追风口的标的',
    body: '未来 12-18 个月将启动正式融资。我们寻找接受 5-10 年回报周期的耐心资本——不接受要求短期爆发的对赌资本。',
    cta: '了解我们的资本观',
    href: '/for-investors',
  },
  {
    number: 'III',
    title: '加盟咨询',
    subtitle: '你想做一件 30 年的事',
    body: '加盟 toolkit 仍在搭建中，预计 2027 年下半年开放有限加盟。我们会拒绝大多数加盟意向，留下少数真正长期同行的人。',
    cta: '留下邮箱接收开放通知',
    href: '/for-franchise',
  },
  {
    number: 'IV',
    title: '品牌合作',
    subtitle: '你想和我们一起把山海美学带回家',
    body: '我们对自然博物馆 / 国家公园 / 自然教育机构 / 同业内容品牌的合作保持开放——前提是双方价值观相通。',
    cta: '写信给我们',
    href: 'mailto:hello@shanhaizaowu.com?subject=' + encodeURIComponent('品牌合作意向'),
  },
];
---

<Layout
  title="山海造物"
  description="把山海带回家——让自然博物美学进入日常生活"
>
  {/* ============ Hero · 全屏 Vision ============ */}
  <section class="relative min-h-[80vh] md:min-h-[90vh] flex items-center justify-center overflow-hidden">
    {/* 主视觉背景（深色渐变占位；实拍素材到位后替换为 <img>）*/}
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-ink-deep via-ink to-ink-elevated"></div>
      {/*
      真实素材到位后取消注释：
      <img src="/images/hero/home-hero.jpg" alt="山海造物 · 自然博物美学"
           class="w-full h-full object-cover opacity-50" />
      <div class="absolute inset-0 bg-gradient-to-b from-ink/40 via-ink/30 to-ink"></div>
      */}
    </div>

    {/* Hero 文字 */}
    <div class="relative z-10 max-w-editorial-wide mx-auto px-6 text-center">
      <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-6 fade-in">
        Nature&rsquo;s Creations · Since 2024
      </p>

      <h1 class="display-title text-cream mb-paragraph fade-in" style="line-height: 1.05;">
        让自然博物美学<br />进入日常生活
      </h1>

      <p class="font-serif-en italic text-brass-mid text-base md:text-lg mt-6 fade-in">
        Bring Nature Home.
      </p>

      <p class="prose-cn max-w-editorial mx-auto mt-section text-text-soft fade-in">
        山海造物是一个自然博物美学品牌。<br class="hidden md:inline" />
        我们做标本、自然小匣、衍生品，开城市里"让人留得比必要的久"的店。
      </p>

      {/* 滚动提示 */}
      <div class="mt-section flex flex-col items-center gap-2 text-text-dim fade-in">
        <span class="font-serif-en italic text-xs tracking-widest uppercase">Scroll</span>
        <svg width="16" height="24" viewBox="0 0 16 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="8" y1="2" x2="8" y2="20" />
          <polyline points="3,15 8,20 13,15" />
        </svg>
      </div>
    </div>
  </section>

  {/* ============ What / Who / Why / How · 叙事四卡 ============ */}
  <section class="editorial-section-wide pt-section">
    <div class="text-center mb-section fade-in">
      <p class="font-serif-en italic text-text-soft text-sm tracking-widest uppercase mb-4">
        Narrative · 从四个问题读我们
      </p>
      <h2 class="display-title text-cream">
        What · Who · Why · How
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brass-mid/10 fade-in">
      {pillars.map((p) => (
        <AudienceCard
          number={p.number}
          title={p.title}
          subtitle={p.subtitle}
          body={p.body}
          cta={p.cta}
          href={p.href}
        />
      ))}
    </div>
  </section>

  {/* ============ 4 Audience Cards ============ */}
  <section class="editorial-section-wide pt-section">
    <div class="text-center mb-section fade-in">
      <p class="font-serif-en italic text-text-soft text-sm tracking-widest uppercase mb-4">
        For Whom · 写给读到这里的你
      </p>
      <h2 class="display-title text-cream">
        你为何而来
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-brass-mid/10 fade-in">
      {audiences.map((a) => (
        <AudienceCard
          number={a.number}
          title={a.title}
          subtitle={a.subtitle}
          body={a.body}
          cta={a.cta}
          href={a.href}
        />
      ))}
    </div>
  </section>

  {/* ============ 承诺导航条 ============ */}
  <CommitmentBar />

  {/* ============ 价值底座 + How 入口 ============ */}
  <section class="editorial-section-wide pt-section pb-section">
    <div class="grid md:grid-cols-3 gap-px bg-brass-mid/15 fade-in">
      <a
        href="/foundation"
        class="group block p-8 bg-ink hover:bg-ink-elevated/60 transition-colors"
      >
        <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">Foundation</p>
        <h3 class="font-serif text-xl text-cream tracking-cn mb-3 group-hover:text-brass-bright transition-colors">
          价值底座
        </h3>
        <p class="text-sm text-text-soft leading-relaxed tracking-cn">
          六观裁定标准与 1% 营收承诺——同一条底线上的两面。
        </p>
      </a>
      <a
        href="/how/senses"
        class="group block p-8 bg-ink hover:bg-ink-elevated/60 transition-colors"
      >
        <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">Senses</p>
        <h3 class="font-serif text-xl text-cream tracking-cn mb-3 group-hover:text-brass-bright transition-colors">
          五感视觉基线
        </h3>
        <p class="text-sm text-text-soft leading-relaxed tracking-cn">
          进店之前，你已经在感受我们。
        </p>
      </a>
      <a
        href="/notes"
        class="group block p-8 bg-ink hover:bg-ink-elevated/60 transition-colors"
      >
        <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">Notes</p>
        <h3 class="font-serif text-xl text-cream tracking-cn mb-3 group-hover:text-brass-bright transition-colors">
          最新笔记
        </h3>
        <p class="text-sm text-text-soft leading-relaxed tracking-cn">
          公众号长文与内部备忘的公开整理。
        </p>
      </a>
    </div>
  </section>

  {/* ============ 收尾 PullQuote ============ */}
  <PullQuote
    quote="把山海带回家。"
    quoteEn="Bring Nature Home."
    cite="山海造物 · 自 2024"
  />
</Layout>
