---
// 山海造物 · Nature's Creations · 主页 v0.3.1
// Hero：Direction B 全幅背景图 + 文字叠加（CHANGELOG-v0.3.1）
import Layout from '../components/Layout.astro';
---

<Layout
  title="山海造物"
  description="做自然博物美学的标本与衍生品 · 开「让人留得比必要的久」的店 · 山海造物 Nature's Creations · 自 2024。"
  image="/specimens/hero-specimen.jpg"
  preloadImage="/specimens/hero-specimen.jpg"
>
  <div class="home">
    {/* 节拍 1 · Hero · Direction B · 全幅背景 + 文字叠加 */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" role="img" aria-label="山海造物展陈空间 · 暖光下实木标本柜与装框蝴蝶陈列"></div>
      <div class="hero-overlay" aria-hidden="true"></div>

      <div class="hero-content">
        <p class="caps-tag hero-caps">NATURE'S CREATIONS &nbsp;·&nbsp; SINCE 2024</p>
        <h1 id="hero-title" class="hero-title">
          <span class="hero-phrase">让自然博物美学</span><br aria-hidden="true" />
          <span class="hero-phrase">进入日常生活</span>
        </h1>
        <p class="hero-tagline-en">Bring Nature Home.</p>
        <p class="hero-blurb">
          做自然博物美学的标本与衍生品 · 开「让人留得比必要的久」的店。
        </p>
      </div>

      <div class="scroll-indicator" aria-hidden="true">
        <p class="caps-tag-mini">SCROLL</p>
        <span class="scroll-arrow">↓</span>
      </div>
    </section>

    {/* 节拍 2 · 品牌画像 · 四入口 */}
    <section class="entry-grid" aria-labelledby="entry-title">
      <h2 id="entry-title" class="section-major-title">品牌画像</h2>

      <div class="entry-cards">
        <a href="/what" class="entry-card">
          <p class="card-tag-en"><em>What</em></p>
          <h3 class="card-title">我们做什么</h3>
          <p class="card-subtitle">一份事业</p>
          <p class="card-body">
            自然小匣主推 · 蝴蝶与贝壳 · 化石矿石与门店主题标本（约 20%）——以及我们拒绝成为的那种店。
          </p>
          <p class="card-cta">阅读 What &nbsp;→</p>
        </a>

        <a href="/who" class="entry-card">
          <p class="card-tag-en"><em>Who</em></p>
          <h3 class="card-title">我们是谁</h3>
          <p class="card-subtitle">东北青年</p>
          <p class="card-body">
            从长春出发的品牌与一群人——把博物学当作日常方法 · 而不是营销皮肤。
          </p>
          <p class="card-cta">阅读 Who &nbsp;→</p>
        </a>

        <a href="/why" class="entry-card">
          <p class="card-tag-en"><em>Why</em></p>
          <h3 class="card-title">为什么</h3>
          <p class="card-subtitle">初心与理性</p>
          <p class="card-body">
            若这些判断在你看来不成立 · 我们大概率不是同路人——省彼此时间。
          </p>
          <p class="card-cta">阅读 Why &nbsp;→</p>
        </a>

        <a href="/how" class="entry-card">
          <p class="card-tag-en"><em>How</em></p>
          <h3 class="card-title">怎么做</h3>
          <p class="card-subtitle">方法论</p>
          <p class="card-body">
            理念落在可被感受的日常里——四个支点彼此咬合。
          </p>
          <p class="card-cta">进入 How &nbsp;→</p>
        </a>
      </div>
    </section>

    {/* 节拍 3 · 价值底座 */}
    <section class="foundation" aria-labelledby="foundation-title">
      <p class="caps-tag-deep">FOUNDATION</p>
      <h2 id="foundation-title" class="foundation-title">价值底座</h2>
      <p class="foundation-subtitle">一切的底色</p>
      <div class="hr-thin" aria-hidden="true"></div>
      <p class="foundation-body">
        六观裁定 · 1% 营收承诺<br />——同一条底线上的两面
      </p>
      <div class="foundation-cta-row">
        <a href="/foundation" class="cta-button">
          进入价值底座 &nbsp;→
        </a>
        <a href="/foundation/strategy" class="cta-button cta-button--quiet">
          战略与 30 年愿景 &nbsp;→
        </a>
      </div>
    </section>

    {/* 节拍 4 · 我们的承诺 · 2x2 */}
    <section class="commitments" aria-labelledby="commitments-title">
      <p class="caps-tag">OUR COMMITMENTS &nbsp;·&nbsp; 我们的承诺</p>
      <h2 id="commitments-title" class="section-title">
        山海造物的店不只是商业空间<br />是城市公共生活的一部分。
      </h2>

      <div class="commitment-grid">
        <article class="commitment-card">
          <p class="commitment-number"><em>01</em></p>
          <h3 class="commitment-title">门店即博物馆</h3>
          <p class="commitment-body">
            每家店都按博物馆标准做展陈与导览——而不是套件商品店。
          </p>
        </article>
        <article class="commitment-card">
          <p class="commitment-number"><em>02</em></p>
          <h3 class="commitment-title">门店即城市公共客厅</h3>
          <p class="commitment-body">
            即便不消费 · 也可以坐下 · 阅读 · 看标本——为城市留一处沉静处。
          </p>
        </article>
        <article class="commitment-card">
          <p class="commitment-number"><em>03</em></p>
          <h3 class="commitment-title">1% 营收用于自然保护</h3>
          <p class="commitment-body">
            不是利润 · 是营收——开店第一天起 · 每一笔交易就在做这件事。
          </p>
        </article>
        <article class="commitment-card">
          <p class="commitment-number"><em>04</em></p>
          <h3 class="commitment-title">AED 与应急服务</h3>
          <p class="commitment-body">
            应急设备与求助通道——店不只是买卖，也是城市里可依靠的一处。
          </p>
        </article>
      </div>

      <div class="commitment-cta">
        <a href="/foundation/conservation">了解 1% 承诺 &nbsp;→</a>
      </div>
    </section>

    {/* 节拍 5 · 你为何而来 · inline（路由对齐站内 /for-*） */}
    <section class="for-whom-compact" aria-labelledby="for-whom-title">
      <p class="caps-tag-quiet">FOR WHOM &nbsp;·&nbsp; 写给特定的你</p>
      <h2 id="for-whom-title" class="for-whom-title">你为何而来</h2>
      <p class="for-whom-body">
        若你属于这 4 类访客 · 我们准备好了独立的入口
      </p>
      <div class="for-whom-links">
        <a href="/for-properties">物业招商 &nbsp;→</a>
        <a href="/for-investors">投资合作 &nbsp;→</a>
        <a href="/for-franchise">加盟咨询 &nbsp;→</a>
        <a href={'mailto:hello@shanhaizaowu.com?subject=' + encodeURIComponent('品牌合作意向')}>品牌合作 &nbsp;→</a>
      </div>
    </section>

    {/* 节拍 6 · 最新笔记 */}
    <section class="latest-note" aria-labelledby="note-title">
      <p class="caps-tag-quiet">LATEST NOTE &nbsp;·&nbsp; 最近一封</p>
      <h3 id="note-title" class="note-title">「写在工作室开门之前」</h3>
      <p class="note-excerpt">
        这周我们把工作室开起来——写一封信 · 回答自己为什么做这件事 · 也回答那些一路看到这里的人。
      </p>
      <a href="/notes/founders-letter" class="note-link">阅读 &nbsp;→</a>
    </section>

    {/* 节拍 7 · 收束 */}
    <section class="closer">
      <h2 class="closer-cn">把山海带回家。</h2>
      <p class="closer-en">Bring Nature Home.</p>
      <p class="closer-meta">——山海造物 &nbsp;·&nbsp; 自 2024</p>
    </section>
  </div>
</Layout>

<style>
  .home {
    --ink: #0e0e0e;
    --ink-deep: #1a140b;
    --cream-100: #f5f0e1;
    --text-primary: #f5f0e1;
    --text-secondary: #a89f87;
    --text-tertiary: #6b6353;
    --brass-mid: #b89867;
    --brass-light: #c9a876;
    --border-quiet: rgba(184, 152, 103, 0.15);
    --border-mid: rgba(184, 152, 103, 0.3);

    --font-cn-serif: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', '宋体', serif;
    --font-en-serif: 'Cormorant Garamond', 'Lyon Text', Georgia, serif;

    background: var(--ink);
    color: var(--text-primary);
    font-family: var(--font-cn-serif);
  }

  .caps-tag,
  .caps-tag-deep,
  .caps-tag-quiet,
  .caps-tag-mini {
    font-family: var(--font-en-serif);
    text-transform: uppercase;
    font-weight: 400;
    margin: 0;
  }
  .caps-tag {
    font-size: 12px;
    letter-spacing: 0.25em;
    color: var(--brass-mid);
  }
  .caps-tag-deep {
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--brass-mid);
  }
  .caps-tag-quiet {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--text-tertiary);
  }
  .caps-tag-mini {
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--text-tertiary);
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px 6vw 80px;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/specimens/hero-specimen.jpg');
    background-size: cover;
    background-position: center 42%;
    background-color: var(--ink);
    filter: brightness(0.92);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to right,
        rgba(14, 14, 14, 0.78) 0%,
        rgba(14, 14, 14, 0.55) 30%,
        rgba(14, 14, 14, 0.15) 60%,
        rgba(14, 14, 14, 0.05) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(14, 14, 14, 0.5) 0%,
        rgba(14, 14, 14, 0) 20%,
        rgba(14, 14, 14, 0) 65%,
        rgba(14, 14, 14, 0.85) 92%,
        rgba(14, 14, 14, 1) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    width: 55%;
  }

  .hero-caps {
    margin-bottom: 28px;
    color: var(--brass-light);
  }

  .hero-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: 0.04em;
    margin: 0 0 22px;
    color: var(--cream-100);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
    word-break: normal;
    overflow-wrap: break-word;
    line-break: strict;
    text-wrap: balance;
  }

  .hero-phrase {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-tagline-en {
    font-family: var(--font-en-serif);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 28px);
    color: var(--brass-light);
    margin: 0 0 28px;
    font-weight: 400;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  .hero-blurb {
    font-family: var(--font-cn-serif);
    font-size: 14px;
    line-height: 1.9;
    color: var(--cream-100);
    max-width: 360px;
    margin: 0;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
    word-break: normal;
    overflow-wrap: break-word;
    line-break: strict;
    text-wrap: pretty;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #e8e2d0;
  }

  .scroll-arrow {
    font-size: 16px;
    animation: home-scroll-pulse 2.4s ease-in-out infinite;
  }
  @keyframes home-scroll-pulse {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(4px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow {
      animation: none;
    }

    .entry-card:hover .card-cta {
      transform: none;
    }
  }

  .entry-grid {
    padding: 120px 6vw;
    max-width: 1320px;
    margin: 0 auto;
  }
  .section-major-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 400;
    color: var(--cream-100);
    text-align: center;
    letter-spacing: 0.08em;
    margin: 0 0 80px;
    line-height: 1.2;
  }
  .entry-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 0.5px solid var(--border-quiet);
    border-left: 0.5px solid var(--border-quiet);
  }
  .entry-card {
    display: block;
    padding: 56px 44px;
    border-right: 0.5px solid var(--border-quiet);
    border-bottom: 0.5px solid var(--border-quiet);
    text-decoration: none;
    color: inherit;
    transition: background 0.5s ease;
    position: relative;
    min-height: 280px;
  }
  .entry-card:hover {
    background: rgba(184, 152, 103, 0.04);
  }
  .card-tag-en {
    position: absolute;
    top: 32px;
    right: 36px;
    font-family: var(--font-en-serif);
    font-size: 22px;
    color: var(--brass-mid);
    margin: 0;
  }
  .card-title {
    font-family: var(--font-cn-serif);
    font-size: 28px;
    font-weight: 400;
    color: var(--cream-100);
    margin: 0 0 8px;
    letter-spacing: 0.05em;
  }
  .card-subtitle {
    font-family: var(--font-cn-serif);
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0 0 20px;
  }
  .card-body {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    line-height: 1.85;
    color: var(--text-secondary);
    margin: 0 0 28px;
    max-width: 360px;
  }
  .card-cta {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    color: var(--brass-mid);
    margin: 0;
    letter-spacing: 0.05em;
    transition: transform 0.4s ease;
  }
  .entry-card:hover .card-cta {
    transform: translateX(4px);
  }

  .foundation {
    background: var(--ink-deep);
    padding: 140px 6vw;
    text-align: center;
    border-top: 0.5px solid var(--border-quiet);
    border-bottom: 0.5px solid var(--border-quiet);
  }
  .foundation-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(56px, 8vw, 96px);
    font-weight: 400;
    color: var(--cream-100);
    letter-spacing: 0.06em;
    margin: 28px 0 8px;
    line-height: 1.2;
  }
  .foundation-subtitle {
    font-family: var(--font-cn-serif);
    font-size: clamp(20px, 2.4vw, 28px);
    color: var(--brass-mid);
    margin: 0 0 32px;
    letter-spacing: 0.1em;
  }
  .hr-thin {
    width: 40px;
    height: 0.5px;
    background: var(--brass-mid);
    margin: 0 auto 32px;
  }
  .foundation-body {
    font-family: var(--font-cn-serif);
    font-size: 15px;
    line-height: 1.95;
    color: var(--text-secondary);
    margin: 0 0 40px;
  }
  .cta-button {
    display: inline-block;
    padding: 14px 32px;
    border: 0.5px solid var(--brass-mid);
    color: var(--brass-mid);
    font-family: var(--font-cn-serif);
    font-size: 14px;
    letter-spacing: 0.18em;
    text-decoration: none;
    transition: all 0.4s ease;
  }
  .cta-button:hover {
    background: var(--brass-mid);
    color: var(--ink-deep);
  }

  .foundation-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }

  .cta-button--quiet {
    border-color: rgba(184, 152, 103, 0.35);
    color: var(--text-secondary);
    font-size: 13px;
    letter-spacing: 0.12em;
    padding: 12px 22px;
  }

  .cta-button--quiet:hover {
    background: transparent;
    color: var(--brass-light);
    border-color: var(--brass-mid);
  }

  .commitments {
    padding: 120px 6vw;
    max-width: 1320px;
    margin: 0 auto;
    text-align: center;
  }
  .section-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 400;
    color: var(--cream-100);
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 24px auto 64px;
    max-width: 820px;
  }
  .commitment-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 56px;
    max-width: 960px;
    margin: 0 auto 56px;
    text-align: left;
  }
  .commitment-card {
    padding: 4px 0 4px 32px;
    border-left: 2px solid var(--brass-mid);
  }
  .commitment-number {
    font-family: var(--font-en-serif);
    font-size: 14px;
    color: var(--brass-mid);
    letter-spacing: 0.15em;
    margin: 0 0 12px;
  }
  .commitment-title {
    font-family: var(--font-cn-serif);
    font-size: 20px;
    font-weight: 400;
    color: var(--cream-100);
    margin: 0 0 10px;
    letter-spacing: 0.04em;
  }
  .commitment-body {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    line-height: 1.9;
    color: var(--text-secondary);
    margin: 0;
  }
  .commitment-cta a {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    color: var(--brass-mid);
    letter-spacing: 0.1em;
    text-decoration: none;
    border-bottom: 0.5px solid var(--brass-mid);
    padding-bottom: 3px;
    transition: opacity 0.3s ease;
  }
  .commitment-cta a::before {
    content: '○';
    color: var(--brass-mid);
    margin-right: 10px;
    font-size: 10px;
    vertical-align: 2px;
    letter-spacing: 0;
  }
  .commitment-cta a:hover {
    opacity: 0.7;
  }

  .for-whom-compact {
    padding: 90px 6vw 80px;
    max-width: 1320px;
    margin: 0 auto;
    text-align: center;
    border-top: 0.5px solid var(--border-quiet);
  }
  .for-whom-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 400;
    color: var(--text-primary);
    margin: 14px 0 10px;
    letter-spacing: 0.05em;
  }
  .for-whom-body {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 32px;
  }
  .for-whom-links {
    display: flex;
    justify-content: center;
    gap: 36px;
    flex-wrap: wrap;
  }
  .for-whom-links a {
    font-family: var(--font-cn-serif);
    font-size: 14px;
    color: var(--brass-mid);
    text-decoration: none;
    letter-spacing: 0.06em;
    display: inline-block;
    transition: color 0.3s ease, transform 0.3s ease;
  }
  .for-whom-links a:hover {
    color: var(--brass-light);
    transform: translateX(4px);
  }

  .latest-note {
    padding: 100px 6vw;
    max-width: 720px;
    margin: 0 auto;
    text-align: left;
    border-top: 0.5px solid var(--border-quiet);
  }
  .note-title {
    font-family: var(--font-cn-serif);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 400;
    color: var(--cream-100);
    margin: 18px 0 16px;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .note-excerpt {
    font-family: var(--font-cn-serif);
    font-size: 14px;
    line-height: 1.9;
    color: var(--text-secondary);
    margin: 0 0 24px;
  }
  .note-link {
    font-family: var(--font-cn-serif);
    font-size: 13px;
    color: var(--brass-mid);
    letter-spacing: 0.1em;
    text-decoration: none;
    border-bottom: 0.5px solid var(--brass-mid);
    padding-bottom: 2px;
  }

  .closer {
    padding: 120px 6vw;
    text-align: center;
    border-top: 0.5px solid var(--border-quiet);
  }
  .closer-cn {
    font-family: var(--font-cn-serif);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    color: var(--cream-100);
    margin: 0 0 14px;
    letter-spacing: 0.08em;
  }
  .closer-en {
    font-family: var(--font-en-serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: var(--brass-mid);
