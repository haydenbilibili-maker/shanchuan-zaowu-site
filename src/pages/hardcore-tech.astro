---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PullQuote from '../components/PullQuote.astro';
import ContactBlock from '../components/ContactBlock.astro';

// ============== 首屏宏观数字 ==============
const heroMetrics = [
  { num: '11', label: '推荐技术', en: 'Recommended' },
  { num: '3', label: '明确不做', en: 'Excluded' },
  { num: '4', label: '层级结构', en: 'Layers' },
  { num: '3', label: '年路线图', en: 'Years' },
];

// ============== § 一 · 19 世纪博物学家四个未竟梦想 ==============
const dreams = [
  { want: '精准记录标本每一个细节', blocked: '受限于摄影技术', today: '微距摄影 + 焦点堆栈' },
  { want: '长期保存标本免于时间侵蚀', blocked: '无温湿度控制', today: '物联网监测 + UV 玻璃' },
  { want: '让世界看到他的奇珍', blocked: '受限于交通与印刷', today: '3D 扫描 + AR + 数字孪生' },
  { want: '为每只标本定制陈列', blocked: '纯手工，效率低', today: '3D 打印 + 激光雕刻 + CNC' },
];

// 达尔文测试 · 二元对照
const darwinTest = {
  yes: [
    '会用 3D 扫描记录稀有标本',
    '会用微距摄影做物种图谱',
    '会用温湿度监测保护采集品',
    '会用焦点堆栈拼接超清细节',
  ],
  no: [
    '不会做 NFT 数字藏品',
    '不会用机械臂批量生产标本',
    '不会做元宇宙虚拟博物馆',
    '不会拿区块链当噱头做溯源',
  ],
};

// ============== § 二 · 4 层技术结构 ==============
const layers = [
  {
    key: 'I',
    en: 'Visual Digitization',
    name: '视觉数字化层',
    count: '3 项',
    desc: '把每只标本完整、精准、永久地记录下来——所有上层应用的前置数据基础。',
  },
  {
    key: 'II',
    en: 'Manufacturing',
    name: '生产与制造层',
    count: '4 项',
    desc: '让重复性工艺自动化，把工艺师的双手释放给真正需要手作的部分。',
  },
  {
    key: 'III',
    en: 'AI & Software',
    name: 'AI 与软件层',
    count: '3 项',
    desc: '让 AI 承担「快速试错」，把团队的人时释放给真正的创造性工作。',
  },
  {
    key: 'IV',
    en: 'Preservation',
    name: '保存与监测层',
    count: '2 项',
    desc: '让标本真正实现「被时间定格」——「做时间的朋友」精神在物理层的承担者。',
  },
];

// ============== § 三–§ 六 · 12 张技术卡（11 项推荐 + 1 项交叉引用） ==============
// tier: green=强烈推荐 / yellow=谨慎评估
type Tech = {
  layer: string;
  no: string;
  tier: 'green' | 'yellow';
  name: string;
  sub: string;
  capability: string;
  application: string;
  strategic?: string;
  redline?: string;
  timing: string;
};

const tech: Tech[] = [
  // === 视觉数字化层 ===
  {
    layer: 'I', no: '01', tier: 'green',
    name: '桌面级 3D 扫描仪',
    sub: '把每只标本变成「数字双胞胎」',
    capability: '把物理标本完整数字化——形态 / 色彩 / 纹理 / 细节全部保留，形成可永久存档的数字资产。',
    application: '每只标本进店即扫描归档；下游为 3D 打印底座、教育复刻件、衍生品 IP 设计、AR 展示提供数据源。',
    strategic: '这是品牌的「长期数字资产」——10 年后回看，这一代标本的完整数字档案是最难复制的护城河。',
    redline: '扫描数据不可商品化卖给「3D 打印爱好者」做翻刻——破坏品牌稀缺性。',
    timing: '第一年必上',
  },
  {
    layer: 'I', no: '02', tier: 'green',
    name: '高分辨率微距摄影 + 焦点堆栈',
    sub: '被严重低估的「基础硬核科技」',
    capability: '用现代焦点堆栈技术拍摄博物馆级别的标本档案照——蝴蝶翅膀的鳞片、矿石晶体的几何、贝壳纹理的肌理。',
    application: '为每只标本建立摄影档案；公众号长文 / 出版物 / 教育内容的视觉素材库。',
    strategic: '现代焦点堆栈能把上百张照片合成一张所有焦平面都清晰的图——这是 19 世纪博物学家做不到的事。完全契合品牌精神。',
    timing: '视觉资产基础',
  },
  {
    layer: 'I', no: '03', tier: 'yellow',
    name: 'CT 扫描 / X 光成像',
    sub: '看见标本的内部世界',
    capability: '标本内部结构的非破坏性成像——一只完整甲虫的内部骨骼、肌肉残留，CT 看得到。',
    application: '与博物馆 / 大学合作付费扫描；重要标本的「内部档案」；做「剖切教育内容」展示动物内部结构而不破坏标本。',
    strategic: '19 世纪博物学家用解剖刀打开生物——我们用 CT 实现同样的求知，但不破坏标本。',
    timing: '仅用于核心标本 · 外部合作模式',
  },
  // === 生产与制造层 ===
  {
    layer: 'II', no: '04', tier: 'green',
    name: '消费级桌面 3D 打印',
    sub: '已有专门方案文档 · 本卡片仅作交叉引用',
    capability: '塑料结构件的快速制造与原型迭代。',
    application: '标本陈列底座 / 衍生品原型打样 / 教育复刻模型。',
    strategic: '与激光雕刻互补——一台 3D 打印 + 一台激光雕刻覆盖 90% 的内部工具需求。',
    timing: '已立项 · 详见姊妹方案',
  },
  {
    layer: 'II', no: '05', tier: 'green',
    name: '桌面级激光雕刻机',
    sub: '3D 打印之后第二项要考虑的工具',
    capability: '在木头、皮革、亚克力、布料上做高精度雕刻或切割。',
    application: '手绘风格标签的批量精准化（保留手写感但实现一致性）；木质标本框 / 皮革包装 / 复古物种铭牌的批量定制。',
    strategic: '木材皮革是品牌的核心材料语言——激光雕刻直接服务于「博物学奇珍柜」视觉系统。',
    timing: '第二年加入',
  },
  {
    layer: 'II', no: '06', tier: 'green',
    name: '桌面级 UV 打印机',
    sub: '2025-2026 年最值得关注的新兴品类',
    capability: '在任何材料表面（玻璃 / 皮革 / 亚克力 / 金属 / 木盒）直接打印彩色图像，单件可定制。',
    application: '玻璃罩侧面定制图案与编号 / 玻璃瓶的标签打印（替代手贴）/ 木盒侧面图案。',
    strategic: '以前需要丝印工厂大批量起订（动辄 500 件起），现在桌面级可单件定制、成本可控。',
    redline: '不能用 UV 打印冒充手绘——必须明确这是数字打印的产品。',
    timing: '第二年观望后加入',
  },
  {
    layer: 'II', no: '07', tier: 'yellow',
    name: '桌面级 CNC 数控机床',
    sub: '可能不是最优先的，但值得了解',
    capability: '用切削刀具在金属、硬木、亚克力上做高精度加工。',
    application: '黄铜配件直接加工 / 硬木家具级别的标本陈列架 / 金属铭牌印章。',
    strategic: '学习曲线比 3D 打印陡峭很多，安全风险更高（飞屑、噪音）；多数应用场景 3D 打印 + 后期涂装已够用。',
    timing: '第三年再议 · 视黄铜需求增长再上',
  },
  // === AI 与软件层 ===
  {
    layer: 'III', no: '08', tier: 'green',
    name: 'AI 辅助 3D 建模',
    sub: '3D 扫描和 3D 打印的中间环节',
    capability: '上传几张产品照片或一句文字描述，AI 自动生成可打印的 3D 模型，让团队不需要学习专业建模软件就能产出原型。',
    application: '衍生品概念阶段的快速原型；IP 形象从 2D 草图转 3D 用于打印；教育模型的快速建模。',
    redline: 'AI 生成的模型只能作为起点，最终用于商品的模型必须经过人工修改——否则会产生廉价 AI 感，破坏品牌调性。',
    timing: '第一年开始用',
  },
  {
    layer: 'III', no: '09', tier: 'green',
    name: 'AI 文案 / 图像 / 视频生成',
    sub: '已经在用 · 本卡片做正式定位',
    capability: '文案 / 图像 / 视频 / 中文短视频 / 虚拟讲解人，主流工具均已成熟。',
    application: '快速试错品牌叙事方向；产品视觉概念图；店内主题海报；短视频与品牌片初稿。',
    strategic: 'AI 工具用在「快速试错」，最终对外发布的内容必须有人工严格筛选——这条边界即「AI 是副驾不是司机」科技观的执行落地。',
    timing: '持续投入',
  },
  {
    layer: 'III', no: '10', tier: 'yellow',
    name: '数字孪生 / AR 展示',
    sub: '当下不优先 · 未来会变得很关键',
    capability: '顾客手机扫一扫店里的标本，看到 3D 旋转模型 + 完整科普；网上虚拟逛店；展会用 AR 替代实体运输。',
    application: '先做数据积累（通过 3D 扫描已经在做），但不急于上线 AR 应用——等下一代消费级 AR 设备真正普及再做。',
    strategic: '现在做 AR 应用 ROI 不清晰，但底层数据积累不能等。这是「数据先行 · 应用待时」的典型案例。',
    timing: '数据先行 · 应用待时',
  },
  // === 保存与监测层 ===
  {
    layer: 'IV', no: '11', tier: 'green',
    name: '物联网温湿度监测',
    sub: '标本最大的敌人不是顾客，是温湿度变化',
    capability: '工业级温湿度传感器 + 自动除湿 / 加湿 / 空调联动，形成自动调节系统。每只标本拥有自己的「生命档案」——记录从入店到现在每一天的环境数据。',
    application: '东北的冬季干燥（湿度不足 20%）会让标本皮毛开裂，夏季潮湿会发霉——这是长春标本工作室的真实挑战。',
    strategic: '这是「做时间的朋友」精神在物理层的真正落地——承诺标本「被时间定格」，温湿度控制是这个承诺的物理保障。',
    timing: '第一年必上',
  },
  {
    layer: 'IV', no: '12', tier: 'green',
    name: 'UV 防护玻璃 + 抗紫外灯具',
    sub: '不是新技术，但严重被低估',
    capability: '博物馆级 UV 阻隔玻璃可阻挡 99% 紫外线 + 50% 红外线；专业博物馆 LED（无 UV、显色指数 95+）。',
    application: '展位玻璃罩升级 / 灯具升级；玻璃罩类、瓶身类衍生品同步升级。',
    strategic: '紫外线会让标本褪色、毛皮发黄。所有专业博物馆都用 UV 过滤玻璃——这种「看不见的科技」恰恰是「博物学奇珍柜级别」的差异化。',
    timing: '第一年必上',
  },
];

// 按层分组
const techByLayer = layers.map((l) => ({
  ...l,
  items: tech.filter((t) => t.layer === l.key),
}));

// ============== § 七 · 不做的 3 项 ==============
const noGo = [
  {
    name: 'NFT 数字藏品 / 区块链溯源',
    reasons: [
      '标本溯源已经有合规凭证 + 物理标签解决',
      'NFT 在 2026 年已退烧，且与品牌「实物在场」精神冲突',
      '成本远高于价值',
      '不通过达尔文测试',
    ],
  },
  {
    name: '大型工业自动化（机械臂 / 流水线）',
    reasons: [
      '与品牌「手作感」精神根本冲突',
      '未来扩店时，每一家店仍然应该保留手作工艺师',
      '规模化的应该是「方法论」，不是「机器」',
      '与品牌「不装的规模化」直接相关',
    ],
  },
  {
    name: '元宇宙 / 虚拟店铺 / 全 VR 沉浸式体验',
    reasons: [
      '山川造物的核心体验是顾客走进实体店、触摸真实标本',
      '这件事不能虚拟化——虚拟化之后情感价值瞬间归零',
      '局部 AR 增强可以（见第 10 项），全 VR 沉浸是不必要的',
      '达尔文不会做元宇宙博物馆',
    ],
  },
];

// ============== § 八 · 网络效应（IP 名匿名化为品类） ==============
const network = [
  { tech: '微距摄影 + 焦点堆栈', uses: ['IP 形象系标本档案', '昆虫 / 蝴蝶系细节呈现', '矿石系晶体几何', '贝壳系纹理肌理', '科普内容素材库'] },
  { tech: '3D 扫描', uses: ['全标本数字双胞胎归档', '插件化商品的设计基础', '教育复刻件的数据源', 'AR 展示底层数据', '与博物馆 / 大学合作的数据资产'] },
  { tech: '物联网温湿度', uses: ['工作室环境', '门店展位环境', '加盟店统一标准', '每只标本的生命档案'] },
  { tech: 'UV 玻璃 + 抗紫外灯具', uses: ['门店展位', '玻璃罩类衍生品', '瓶身类衍生品', '陈列家具级别的延伸'] },
  { tech: '激光雕刻', uses: ['手绘风格标签批量精准化', '木质标本框', '皮革包装', '物种铭牌'] },
  { tech: '3D 打印', uses: ['标本陈列底座', '衍生品原型打样', '教育复刻模型', 'IP 形象 3D 化'] },
];

// ============== § 九 · 三年路线图 ==============
const roadmap = [
  {
    year: '第一年 · 2026',
    eyebrow: 'Foundation',
    theme: '基础数字化',
    mission: '建立品牌的硬核基础设施。所有未来应用的底层数据全部在这一年开始积累。',
    techs: ['消费级 3D 打印', '桌面 3D 扫描仪', '微距摄影系统升级', '物联网温湿度监测', 'UV 玻璃和灯具升级', 'AI 工具订阅'],
    metrics: [
      '店内所有标本完成 3D 扫描数字归档',
      '至少 30 只标本完成微距摄影档案',
      '工作室和店面温湿度数据持续监测',
      '至少 1 个衍生品 SKU 通过 3D 打印走通',
    ],
  },
  {
    year: '第二年 · 2027',
    eyebrow: 'Production',
    theme: '生产能力扩展',
    mission: '把内部工艺生产能力建立起来，减少外包依赖，提升单 SKU 的定制化程度。',
    techs: ['桌面激光雕刻机', '桌面 UV 打印机（观望后决定）', '3D 打印产能扩充', 'AI 建模工具升级', 'CT 扫描外部合作（按需）'],
    metrics: [
      '至少 3 个衍生品 IP 全流程内部化（设计 → 打样 → 小批量生产）',
      '店内每只标本配套激光雕刻定制木标牌',
      '教育复刻模型形成 1-2 套完整教学产品',
    ],
  },
  {
    year: '第三年 · 2028',
    eyebrow: 'Long-term',
    theme: '长期战略层',
    mission: '把前两年积累的数据资产转化为品牌护城河——AR 应用、与博物馆合作、出版数字标本图鉴。',
    techs: ['数字孪生 + AR 应用开发', 'CT 扫描重要标本（与博物馆 / 大学合作）', '桌面 CNC（如黄铜需求增长）', '数字标本图鉴出版'],
    metrics: [
      '店内 AR 应用上线，顾客可扫描标本看完整科普',
      '数字标本图鉴出版（实体书或数字版）',
      '与至少 1 家博物馆 / 大学建立长期数据合作关系',
    ],
  },
];

// ============== § 十 · 战略价值（5 项隐性收益） ==============
const strategicValue = [
  {
    title: '品牌差异化',
    body: '在同质化文创市场，「拥有完整数字标本档案的品牌」是稀缺定位。',
  },
  {
    title: '投资人故事',
    body: '硬核基础设施是融资时的关键叙事——从「文创品牌」升级为「自然博物科技品牌」。',
  },
  {
    title: '团队效率',
    body: '工艺师每周省下的 10-15 小时，可以投入到更高价值的创造性工作。',
  },
  {
    title: '标本生命延长',
    body: 'UV 玻璃 + 物联网监测让标本寿命从 10 年延长到 50 年——「做时间的朋友」的物理回报。',
  },
  {
    title: '教育与科研合作',
    body: '完整数字档案让品牌有资格与博物馆、大学建立长期合作关系。这是普通文创品牌没有的对话权限。',
  },
];

// 颜色 / 标记小工具
const tierLabel = (t: 'green' | 'yellow') => (t === 'green' ? '强烈推荐' : '谨慎评估');
const tierEn = (t: 'green' | 'yellow') => (t === 'green' ? 'Recommended' : 'Cautious');
---

<Layout
  title="硬核科技应用蓝图"
  description="用未来的技术，做过去的事——11 项推荐技术 / 3 项明确不做 / 三年路线图。这不是一份让山川造物「现代化」的方案，是一份让我们「真正成为博物学奇珍柜」的方案。"
>
  <PageHero
    eyebrow="Hardcore Tech Application Blueprint · 硬核科技应用蓝图"
    title="用未来的技术，<br />做过去的事"
    lead="11 项推荐技术 · 3 项明确不做 · 三年路线图。这不是一份让山川造物「现代化」的方案，是一份让我们「真正成为博物学奇珍柜」的方案——19 世纪博物学家想做但做不到的事，今天可以了。"
  />

  <hr class="brass-divider" />

  {/* ============== 关键数字 ============== */}
  <section class="editorial-section-wide py-section fade-in">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brass-mid/10">
      {heroMetrics.map((m) => (
        <div class="bg-ink p-8 md:p-10 text-center">
          <p class="font-serif-en italic text-brass-bright mb-2"
             style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1;">
            {m.num}
          </p>
          <p class="font-serif text-cream text-sm md:text-base tracking-cn mb-1">{m.label}</p>
