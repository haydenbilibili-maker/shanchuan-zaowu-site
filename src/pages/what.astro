---
import Layout from '../components/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import NoListItem from '../components/NoListItem.astro';
import PullQuote from '../components/PullQuote.astro';

const noList = [
  '不做盲盒',
  '不做概率消费',
  '不做隐藏款',
  '不做限量发售制造抢购',
  '不做卖萌化的自然 IP',
  '不做与"自然博物美学"无关的跨品类延伸',
];

/** 自然小匣示意图（public 静态资源） */
const natureBoxSchematics = [
  {
    src: '/images/what/nature-box/nature-box-01.png',
    alt: '自然小匣示意：深框标本匣，蝴蝶、干果荚与手绘博物标签同匣陈列',
  },
  {
    src: '/images/what/nature-box/nature-box-02.png',
    alt: '自然小匣示意：白底深框，闪蝶与多种干果、甲虫等集合',
  },
  {
    src: '/images/what/nature-box/nature-box-03.png',
    alt: '自然小匣示意：黑底网格与手写学名标签，闪蝶与果实、种荚组合',
  },
  {
    src: '/images/what/nature-box/nature-box-04.png',
    alt: '自然小匣示意：开窗卡纸格内嵌植物与蝶类标本的集合陈列',
  },
];
---

<Layout
  title="我们做什么"
  description="山海造物 · 自然小匣主推 · 蝴蝶与贝壳 · 化石矿石 · 门店主题标本（约 20%）· 双 IP"
>
  <SectionHeader
    eyebrow="What We Make · 我们做什么"
    title={`我们做的不是\n标本店`}
    intro={`如果只是"卖标本"，这件事其实早就有人在做。我们做的是别的——把一种叫自然博物美学的东西，让它进入日常生活。`}
  />

  <hr class="brass-divider" />

  <!-- ============ 产品矩阵 · 结构一眼 ============ -->
  <section class="editorial-section fade-in max-w-editorial-wide mx-auto px-6">
    <p class="section-number mb-4">·</p>
    <h2 class="section-title text-cream">产品矩阵 · 结构一眼</h2>
    <p class="font-serif-en italic text-brass-mid text-sm mb-paragraph">SKU mix · 核心约束</p>
    <div class="prose-cn space-y-paragraph text-text-soft">
      <p>
        店内结构可以粗分为两块：<strong class="text-cream">约 20% 门店主题标本</strong>（随门店叙事轮换、部分可售、部分为非卖品）+
        <strong class="text-cream">约 80% 其余商品与自持衍生品</strong>。其中<strong class="text-brass-bright">自然小匣是主推</strong>——主体式的标本集合创作；蝴蝶与贝壳、植物果实、化石矿石等构成围绕它的材料线与流量入口。
      </p>
      <div class="p-6 border border-brass-mid/20 bg-ink-elevated/35 rounded-sm text-sm leading-relaxed tracking-cn">
        <p class="text-cream font-serif mb-3">五条主线（与店内陈列一致）</p>
        <ol class="list-decimal pl-5 space-y-2 text-text-soft">
          <li><strong class="text-brass-bright">自然小匣</strong>——主打；植物 / 矿物 / 昆虫等围绕冬天、东北、爱情等主题做集合创作。</li>
          <li><strong class="text-cream">蝴蝶及衍生品</strong>——如首饰、钟表等，承担流量入口与设计实验。</li>
          <li><strong class="text-cream">植物果实与自然小物</strong>——如果壳吊坠、铃与果实 DIY 等，偏自有工艺壁垒。</li>
          <li><strong class="text-cream">海洋贝壳</strong>——如餐具等，设计向日常餐桌延伸。</li>
          <li><strong class="text-cream">化石矿石</strong>——以合规采购为主，做稀缺性与知识深度的补充（不纳入「衍生品高自给率」的分子口径时，其余自持类目仍整体守住高自给目标）。</li>
        </ol>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ I. 自然小匣（主推） ============ -->
  <section class="editorial-section-wide fade-in">
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <figure class="border border-brass-mid/20 bg-ink-elevated/30 p-3 md:p-4 max-w-lg mx-auto md:mx-0 w-full">
        <p class="font-serif-en italic text-brass-mid/70 text-xs tracking-[0.2em] uppercase mb-3 text-center md:text-left">
          Nature Boxes
        </p>
        <div class="grid grid-cols-2 gap-2 md:gap-3">
          {natureBoxSchematics.map((item) => (
            <div class="aspect-square overflow-hidden rounded-sm bg-ink-deep ring-1 ring-brass-mid/15">
              <img
                src={item.src}
                alt={item.alt}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
                width="600"
                height="600"
              />
            </div>
          ))}
        </div>
        <figcaption class="mt-4 text-xs text-text-soft leading-relaxed tracking-cn text-center md:text-left">
          自然小匣示意图：主体式标本集合创作（植物 / 昆虫等 + 档案标签同匣）；主题为示意，以门店在售与策展为准。
        </figcaption>
      </figure>

      <div>
        <p class="section-number mb-4">I</p>
        <h2 class="section-title text-cream">自然小匣 · 主推</h2>
        <p class="font-serif-en italic text-brass-mid text-sm mb-paragraph">Nature Boxes · 门店与叙事的核心</p>

        <div class="prose-cn space-y-paragraph">
          <p>
            自然小匣不是「随便装几件标本的盒子」，而是<strong class="text-brass-bright">主体式的标本集合创作</strong>：以植物、矿物、昆虫等材料为主角，围绕<strong class="text-cream">冬天、东北、爱情、季节迁徙</strong>等明确主题，把多件自然物与一张<strong class="text-brass-bright">博物档案卡</strong>收进同一只匣子里。
          </p>
          <p>
            它不是手工艺品，也不是奢侈品。是一件可以放在桌上、家里、孩子房间里的<strong class="text-cream">「可以被翻看的小博物馆」</strong>——也是我们希望客人记住山海造物时，脑海里最先出现的那一类东西。
          </p>
          <p class="text-text-soft text-sm">
            每一只蝴蝶、每一颗矿石都有自己的来路、品相、合规边界。我们的工艺不能自动化到底——保留一定比例的手工，是这件事的一部分。
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ II. 蝴蝶及衍生品 ============ -->
  <section class="editorial-section-wide fade-in">
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <div class="md:order-2">
        <figure class="aspect-[4/5] bg-gradient-to-br from-brass-deep/20 to-brass-mid/5 border border-brass-mid/20 flex items-center justify-center">
          <span class="font-serif-en italic text-brass-mid/40 text-2xl">Lepidoptera</span>
        </figure>
      </div>

      <div class="md:order-1">
        <p class="section-number mb-4">II</p>
        <h2 class="section-title text-cream">蝴蝶及衍生品</h2>
        <p class="font-serif-en italic text-brass-mid text-sm mb-paragraph">Butterfly line · 流量与设计入口</p>

        <div class="prose-cn space-y-paragraph">
          <p>
            鳞翅目是我们最容易被看见的一条线——从标本本体延伸到<strong class="text-cream">首饰、座钟 / 怀表、墙面装置</strong>等可穿戴、可陈设的衍生品。它承担「被一眼认出」的任务，但叙事上仍必须回到：这只蝴蝶是谁、来自哪里、为何以这种形式被固定下来。
          </p>
          <p class="text-text-soft text-sm">
            与盲盒、概率玩法无关；每一件上架前仍走博物档案与合规审查，不把「稀有」写成无法核验的口号。
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ III. 植物果实与自然小物 ============ -->
  <section class="editorial-section-wide fade-in">
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <figure class="aspect-[4/5] bg-gradient-to-br from-brass-deep/20 to-brass-mid/5 border border-brass-mid/20 flex items-center justify-center">
        <span class="font-serif-en italic text-brass-mid/40 text-2xl">Botanical</span>
      </figure>

      <div>
        <p class="section-number mb-4">III</p>
        <h2 class="section-title text-cream">植物果实与自然小物</h2>
        <p class="font-serif-en italic text-brass-mid text-sm mb-paragraph">Fruits &amp; shells of land · 工艺壁垒</p>

        <div class="prose-cn space-y-paragraph">
          <p>
            果壳吊坠、果壳铃、可参与的果实 DIY——这类东西<strong class="text-cream">体量小、触感真</strong>，适合作为「把自然握在手里」的日常入口，也和自然小匣里的植物叙事彼此呼应。
          </p>
          <p class="text-text-soft text-sm">
            它们与自然小匣共享同一条伦理线：来源清楚、不夸大稀缺、不把保护物种当卖点。
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ IV. 海洋贝壳 ============ -->
  <section class="editorial-section-wide fade-in">
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <div class="md:order-2">
        <figure class="aspect-[4/5] bg-gradient-to-br from-brass-deep/20 to-brass-mid/5 border border-brass-mid/20 flex items-center justify-center">
          <span class="font-serif-en italic text-brass-mid/40 text-2xl">Marine</span>
        </figure>
      </div>

      <div class="md:order-1">
        <p class="section-number mb-4">IV</p>
        <h2 class="section-title text-cream">海洋贝壳</h2>
        <p class="font-serif-en italic text-brass-mid text-sm mb-paragraph">Shells · 向餐桌与日常延展</p>

        <div class="prose-cn space-y-paragraph">
          <p>
            贝壳、螺钿与食器相关的器物——例如<strong class="text-cream">餐具、托盘、杯垫</strong>——把「海」从展柜里拉到一日三餐旁边。设计上仍坚持博物标签与使用说明可读，而不是只做旅游纪念品式的堆砌。
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ V. 化石矿石 ============ -->
  <section class="editorial-section-wide fade-in">
    <figure class="aspect-[21/9] max-w-editorial-wide mx-auto bg-gradient-to-br from-ink-deep to-ink-elevated border border-brass-mid/20 flex items-center justify-center mb-10">
      <span class="font-serif-en italic text-brass-mid/40 text-2xl">Fossil &amp; Ore</span>
    </figure>

    <div class="max-w-editorial mx-auto px-6">
      <p class="section-number mb-4">V</p>
      <h2 class="section-title text-cream">化石矿石</h2>
      <p class="font-serif-en italic text-brass-mid text-sm mb-paragraph">Scarcity layer · 采购与合规优先</p>

      <div class="prose-cn space-y-paragraph">
        <p>
          这一线以<strong class="text-cream">合规采购与可追溯来源</strong>为主，用来补充店里「时间感」与地质叙事——与前面几条自持工艺线不同，它更依赖供应商与文书，因此<strong class="text-brass-bright">不自充「全店自给率」的分子</strong>，但在门店叙事里仍然重要：它回答「地球很久很久以前是什么样」。
        </p>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ VI. 门店主题标本（约 20%） ============ -->
  <section class="editorial-section-wide fade-in">
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <figure class="aspect-[4/5] bg-gradient-to-br from-brass-deep/20 to-brass-mid/5 border border-brass-mid/20 flex items-center justify-center">
        <span class="font-serif-en italic text-brass-mid/40 text-2xl">Theme Specimens</span>
      </figure>

      <div>
        <p class="section-number mb-4">VI</p>
        <h2 class="section-title text-cream">门店主题标本</h2>
        <p class="font-serif-en italic text-brass-mid text-sm mb-paragraph">~20% · 随店叙事轮换</p>

        <div class="prose-cn space-y-paragraph">
          <p>
            严格说，店里<strong class="text-cream">不是「主题展柜」四个字能概括</strong>——更准确的是：<strong class="text-brass-bright">围绕当期门店主题配置的一批主题标本</strong>，大约占店内相关陈列与库存结构的 <strong class="text-cream">20% 左右</strong>，随季节与策展轮换。
          </p>
          <p>
            其中<strong class="text-cream">多数可以出售</strong>，但也会保留<strong class="text-brass-bright">非卖品</strong>：用来定调、用来讲清楚一条科学叙事，或单纯因为这件东西不适合进入流通。维多利亚式奇珍柜的气质还在——只是我们把「卖与不卖」说在前面，而不是用「展柜」一笔带过。
          </p>
          <p class="text-text-soft text-sm">
            每一件可售或展示用的标本都配博物档案卡（中文名、学名、产地、采集背景、保护级别）——博物馆级标准，不是商场标价签。轮换节奏与讲座、工坊在 /how/space 里与空间动线一并说明。
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ VII. 双 IP ============ -->
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">VII</p>
    <h2 class="section-title text-cream">两个 IP · 马上有 与 小黄</h2>
    <p class="font-serif-en italic text-brass-mid text-sm mb-paragraph">Two IPs · 情感线索</p>

    <p class="prose-cn mb-section">
      <strong class="text-cream">马上有</strong>和<strong class="text-cream">小黄</strong>——这是山海造物的两个 IP。它们是这家店的两条情感线索。
    </p>

    <div class="grid md:grid-cols-2 gap-10">
      <article class="p-8 border border-brass-mid/20 bg-ink-elevated/40">
        <figure class="aspect-square mb-6 bg-gradient-to-br from-ink-deep to-ink-elevated border border-brass-mid/15 flex items-center justify-center">
          <span class="font-serif-en italic text-brass-mid/40 text-xl">IP 01</span>
        </figure>
        <h3 class="font-serif text-2xl text-cream mb-2 tracking-cn">马上有</h3>
        <p class="font-serif-en italic text-brass-mid text-sm mb-4">Mashangyou</p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          山海造物的主 IP 之一。详细人格档案与故事系统将在专门的内容中展开。
        </p>
      </article>

      <article class="p-8 border border-brass-mid/20 bg-ink-elevated/40">
        <figure class="aspect-square mb-6 bg-gradient-to-br from-ink-deep to-ink-elevated border border-brass-mid/15 flex items-center justify-center">
          <span class="font-serif-en italic text-brass-mid/40 text-xl">IP 02</span>
        </figure>
        <h3 class="font-serif text-2xl text-cream mb-2 tracking-cn">小黄</h3>
        <p class="font-serif-en italic text-brass-mid text-sm mb-4">Xiao Huang</p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          山海造物的主 IP 之二。详细人格档案与故事系统将在专门的内容中展开。
        </p>
      </article>
    </div>

    <p class="prose-cn mt-paragraph text-sm text-text-soft">
      关于双 IP 的诞生故事 → <a href="/notes" class="text-brass-mid hover:text-brass-bright">/notes</a>
    </p>
  </section>

  <hr class="brass-divider" />

  <!-- ============ VIII. 我们不做什么 ============ -->
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">VIII</p>
    <h2 class="section-title text-cream">我们不做的事</h2>

    <p class="prose-cn mb-paragraph">
      这些不是我们做不了。是我们<strong class="text-brass-bright">选择不做</strong>。
    </p>

    <ul class="border-l-2 border-brass-deep/40 pl-6 mt-paragraph">
      {noList.map((item) => (
        <NoListItem text={item} />
      ))}
    </ul>

    <p class="prose-cn mt-paragraph text-sm text-text-soft">
      完整的「不做」清单在战略原则文档中——共七类（内容 / 商品 / 经营 / 加盟 / 空间 / 文化 / 公共承诺）。
      <br />详见 → <a href="/who" class="text-brass-mid hover:text-brass-bright">/who</a>
    </p>
  </section>

  <PullQuote
    quote="自然小匣是主推，蝴蝶、贝壳、化石矿石与门店主题标本——这些是我们的产品语言。维多利亚博物学家奇珍柜的视觉、黄铜与暗调、博物馆级的灯光与档案——这些是我们的空间语言。"
  />
</Layout>
