---
import Layout from '../components/Layout.astro';
import {
  bioFilterOptions,
  formatPriceAmount,
  isPriceRange,
  packagingFilterOptions,
  priceListItems,
  priceListMeta,
  priceLowerBound,
  priceUpperBound,
  type BioFilter,
  type PackagingFilter,
  type PriceListItem,
} from '../data/priceList';

/** 解析展示用图集：优先 images，否则回退到单图 image */
function resolveGallery(item: PriceListItem): string[] {
  if (item.images && item.images.length > 0) return item.images;
  if (item.image) return [item.image];
  return [];
}

const coverImage = '/images/price-list/cover.jpg';
const totalCount = priceListItems.length;

function renderRow(item: PriceListItem) {
  const gallery = resolveGallery(item);
  const guide = item.guidePrice ?? null;
  return {
    ...item,
    priceLabel: formatPriceAmount(item.price),
    guidePriceLabel: formatPriceAmount(guide),
    priceIsRange: isPriceRange(item.price),
    guideIsRange: isPriceRange(guide),
    priceMin: priceLowerBound(item.price),
    priceMax: priceUpperBound(item.price),
    guideMin: priceLowerBound(guide),
    guideMax: priceUpperBound(guide),
    gallery,
    cover: gallery[0] || '',
    imageCount: gallery.length,
  };
}

const rows = priceListItems.map(renderRow);
---

<Layout
  title={priceListMeta.title}
  description="山海造物 · 线下供货价格表——按包装/品类与题材组合筛选，查阅商品图片、品名、物种、制作方式、包装、供货价、指导售价与规格。"
  image={coverImage}
  preloadImage={coverImage}
>
  {/* 全宽 bleed 封面：主视觉平面 + 标题叠层（本页专用，不改 PageHero） */}
  <section class="price-hero museum-hero-night" aria-labelledby="price-hero-title">
    <div class="price-hero-media">
      <img
        src={coverImage}
        alt="山海造物工作室 · 标本制作工作台"
        class="price-hero-img"
        width="1024"
        height="684"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="price-hero-overlay" aria-hidden="true"></div>
    <div class="price-hero-content">
      <p class="price-hero-eyebrow font-serif-en italic text-brass-mid text-sm tracking-widest uppercase">
        {priceListMeta.eyebrow}
      </p>
      <h1 id="price-hero-title" class="price-hero-title display-title">
        <span class="price-hero-brand">{priceListMeta.brand}</span>
        <span class="price-hero-heading">{priceListMeta.heading}</span>
      </h1>
      <p class="price-hero-year font-serif-en italic text-brass-mid tracking-widest" aria-hidden="true">
        {priceListMeta.year}
      </p>
      <p class="price-hero-lead font-serif text-cream tracking-cn">{priceListMeta.lead}</p>
    </div>
  </section>

  <hr class="brass-divider price-list-divider" />

  {/* 宽容器：突破 editorial 正文宽度；顶距收紧，筛选紧跟封面区 */}
  <section class="price-list-main max-w-7xl mx-auto px-4 md:px-6 fade-in" data-price-list>
    {/* 双维组合筛选 */}
    <div class="price-filters mb-8 space-y-5" role="group" aria-label="商品筛选">
      <div>
        <p class="font-serif text-sm text-brass-mid tracking-cn mb-2.5">包装 / 品类</p>
        <div
          class="price-filter-chips -mx-1 px-1 overflow-x-auto"
          role="toolbar"
          aria-label="按包装或品类筛选"
          data-filter-dim="packaging"
        >
          <ul class="flex flex-nowrap gap-2 min-w-min pb-1">
            <li class="shrink-0">
              <button
                type="button"
                class="price-filter-chip is-active whitespace-nowrap px-3.5 py-2 text-sm tracking-cn transition-colors duration-200 border border-brass-mid bg-brass-mid/15 text-cream"
                data-filter-value="all"
                aria-pressed="true"
              >
                全部
              </button>
            </li>
            {packagingFilterOptions.map((opt: PackagingFilter) => (
              <li class="shrink-0">
                <button
                  type="button"
                  class="price-filter-chip whitespace-nowrap px-3.5 py-2 text-sm tracking-cn transition-colors duration-200 border border-brass-mid/25 text-text-soft hover:border-brass-mid/50 hover:text-cream"
                  data-filter-value={opt}
                  aria-pressed="false"
                >
                  {opt}
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div>
        <p class="font-serif text-sm text-brass-mid tracking-cn mb-2.5">题材 / 生物</p>
        <div
          class="price-filter-chips -mx-1 px-1 overflow-x-auto"
          role="toolbar"
          aria-label="按题材或生物筛选"
          data-filter-dim="bio"
        >
          <ul class="flex flex-nowrap gap-2 min-w-min pb-1">
            <li class="shrink-0">
              <button
                type="button"
                class="price-filter-chip is-active whitespace-nowrap px-3.5 py-2 text-sm tracking-cn transition-colors duration-200 border border-brass-mid bg-brass-mid/15 text-cream"
                data-filter-value="all"
                aria-pressed="true"
              >
                全部
              </button>
            </li>
            {bioFilterOptions.map((opt: BioFilter) => (
              <li class="shrink-0">
                <button
                  type="button"
                  class="price-filter-chip whitespace-nowrap px-3.5 py-2 text-sm tracking-cn transition-colors duration-200 border border-brass-mid/25 text-text-soft hover:border-brass-mid/50 hover:text-cream"
                  data-filter-value={opt}
                  aria-pressed="false"
                >
                  {opt}
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    {/* sticky 在筛选下方：滚动清单时仍可开篮，不与筛选标题行叠打 */}
    <div class="price-list-toolbar mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
      <h2 class="font-serif text-2xl text-cream tracking-cn">商品清单</h2>
      <div class="price-list-toolbar-actions flex flex-wrap items-center gap-3">
        <p class="text-xs text-text-dim tracking-cn" data-price-count>
          显示 {totalCount} / {totalCount} 款
        </p>
        <button
          type="button"
          data-cart-open
          class="price-cart-trigger text-xs tracking-cn border border-brass-mid/40 px-3 py-1.5 text-brass-mid hover:border-brass-mid hover:text-cream transition-colors"
        >
          采购篮 <span data-cart-badge class="tabular-nums">0</span>
        </button>
      </div>
    </div>

    {/* 空结果 */}
    <div
      data-price-empty
      hidden
      class="border border-brass-mid/25 px-6 py-14 text-center bg-ink-elevated/30"
    >
      <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
        No matches
      </p>
      <p class="font-serif text-cream text-xl tracking-cn mb-2">暂无符合条件的商品</p>
      <p class="text-sm text-text-soft tracking-cn">
        可切换「全部」或调整包装 / 题材组合后再试。
      </p>
    </div>

    {/* 桌面：宽容器内自适应列宽；去掉 min-width 强制横滑。≥1024 通常整表可见，窄桌面保留 overflow 兜底 */}
    <div data-price-table-wrap class="hidden md:block overflow-x-auto border border-brass-mid/25">
      <table class="w-full border-collapse text-center">
        <thead>
          <tr class="bg-ink-elevated/60 border-b border-brass-mid/25">
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium w-[48px]">
              选
            </th>
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium w-[72px]">
              数量
            </th>
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium w-[80px]">
              图片
            </th>
            <th class="px-3 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium text-left whitespace-nowrap">
              品名
            </th>
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium whitespace-nowrap">
              物种
            </th>
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium whitespace-nowrap">
              制作
            </th>
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium whitespace-nowrap">
              包装
            </th>
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium whitespace-nowrap">
              供货
            </th>
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium whitespace-nowrap">
              指导
            </th>
            <th class="px-3 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium text-left min-w-[10rem]">
              规格
            </th>
            <th class="px-2 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium min-w-[6rem]">
              备注
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((item) => (
            <tr
              class="price-list-row border-b border-brass-mid/15 last:border-b-0 align-middle"
              data-packaging={item.packagingFilter}
              data-bio={item.bioFilter}
              data-sku-id={item.id}
              data-sku-name={item.name}
              data-sku-price-min={item.priceMin ?? ''}
              data-sku-price-max={item.priceMax ?? ''}
              data-sku-price-label={item.priceLabel}
              data-sku-price-range={item.priceIsRange ? '1' : ''}
              data-sku-guide-min={item.guideMin ?? ''}
              data-sku-guide-max={item.guideMax ?? ''}
              data-sku-guide-label={item.guidePriceLabel}
            >
              <td class="px-2 py-3">
                <input
                  type="checkbox"
                  class="price-sku-check accent-[var(--color-brass-mid)] h-4 w-4 cursor-pointer"
                  data-sku-check
                  aria-label={`选择 ${item.name}`}
                />
              </td>
              <td class="px-2 py-3">
                <input
                  type="number"
                  min="1"
                  max="9999"
                  value="1"
                  disabled
                  data-sku-qty
                  class="price-sku-qty w-14 mx-auto block rounded-none border border-brass-mid/25 bg-ink-deep/40 px-1 py-1 text-center text-sm text-cream tabular-nums disabled:opacity-40"
                  aria-label={`${item.name} 数量`}
                />
              </td>
              <td class="px-2 py-3">
                <div class="mx-auto w-[64px] aspect-square border border-brass-mid/30 bg-ink-deep/40 overflow-hidden flex items-center justify-center">
                  {item.cover ? (
                    <button
                      type="button"
                      class="price-zoom-trigger relative block h-full w-full cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brass-bright/70"
                      data-price-zoom
                      data-zoom-src={item.cover}
                      data-zoom-images={JSON.stringify(item.gallery)}
                      data-zoom-index="0"
                      data-zoom-alt={item.imageAlt || item.name}
                      aria-label={
                        item.imageCount > 1
                          ? `查看大图：${item.imageAlt || item.name}（共 ${item.imageCount} 张）`
                          : `查看大图：${item.imageAlt || item.name}`
                      }
                    >
                      <img
                        src={item.cover}
                        alt=""
                        class="pointer-events-none h-full w-full object-cover select-none"
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                        data-price-thumb
                      />
                      {item.imageCount > 1 && (
                        <span
                          class="price-zoom-badge absolute bottom-0.5 right-0.5 min-w-[1.1rem] px-1 py-px text-[10px] leading-tight tabular-nums text-cream bg-ink-deep/80 border border-brass-mid/40"
                          aria-hidden="true"
                        >
                          {item.imageCount}
                        </span>
                      )}
                    </button>
                  ) : (
                    <span class="price-thumb-oos" aria-label="暂时无货">
                      <span class="price-thumb-oos__text" aria-hidden="true">暂时<br />无货</span>
                    </span>
                  )}
                </div>
              </td>
              <td class="px-3 py-3 font-serif text-cream tracking-cn text-sm md:text-base text-left whitespace-nowrap">
                {item.name}
              </td>
              <td class="px-2 py-3 text-sm text-text-soft tracking-cn whitespace-nowrap">
                {item.species}
              </td>
              <td class="px-2 py-3 text-sm text-text-soft tracking-cn whitespace-nowrap">
                {item.prepMethod}
              </td>
              <td class="px-2 py-3 text-sm text-text-soft tracking-cn whitespace-nowrap">
                {item.packaging}
              </td>
              <td class="px-2 py-3 font-serif text-brass-bright text-lg tracking-cn tabular-nums whitespace-nowrap">
                {item.priceLabel}
              </td>
              <td class="px-2 py-3 font-serif text-cream/90 text-base tracking-cn tabular-nums whitespace-nowrap">
                {item.guidePriceLabel}
              </td>
              <td class="px-3 py-3 text-sm text-text-soft tracking-cn leading-relaxed text-left">
                {item.specs}
              </td>
              <td class="px-2 py-3 text-sm text-text-dim tracking-cn leading-relaxed">
                {item.note || '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* 移动：纵向条目，含物种 / 制作 / 包装 */}
    <ul data-price-mobile-list class="md:hidden border-t border-brass-mid/25">
      {rows.map((item) => (
        <li
          class="price-list-row border-b border-brass-mid/15 py-6"
          data-packaging={item.packagingFilter}
          data-bio={item.bioFilter}
          data-sku-id={item.id}
          data-sku-name={item.name}
          data-sku-price-min={item.priceMin ?? ''}
          data-sku-price-max={item.priceMax ?? ''}
          data-sku-price-label={item.priceLabel}
          data-sku-price-range={item.priceIsRange ? '1' : ''}
          data-sku-guide-min={item.guideMin ?? ''}
          data-sku-guide-max={item.guideMax ?? ''}
          data-sku-guide-label={item.guidePriceLabel}
        >
          <div class="mb-3 flex items-center justify-between gap-3">
            <label class="flex items-center gap-2 text-sm text-text-soft tracking-cn cursor-pointer">
              <input
                type="checkbox"
                class="price-sku-check accent-[var(--color-brass-mid)] h-4 w-4"
                data-sku-check
                aria-label={`选择 ${item.name}`}
              />
              加入采购篮
            </label>
            <input
              type="number"
              min="1"
              max="9999"
              value="1"
              disabled
              data-sku-qty
              class="price-sku-qty w-16 rounded-none border border-brass-mid/25 bg-ink-deep/40 px-1 py-1 text-center text-sm text-cream tabular-nums disabled:opacity-40"
              aria-label={`${item.name} 数量`}
            />
          </div>
          <div class="grid grid-cols-[88px_1fr] gap-4">
            <div class="aspect-square border border-brass-mid/30 bg-ink-deep/40 overflow-hidden flex items-center justify-center">
              {item.cover ? (
                <button
                  type="button"
                  class="price-zoom-trigger relative block h-full w-full cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brass-bright/70"
                  data-price-zoom
                  data-zoom-src={item.cover}
                  data-zoom-images={JSON.stringify(item.gallery)}
                  data-zoom-index="0"
                  data-zoom-alt={item.imageAlt || item.name}
                  aria-label={
                    item.imageCount > 1
                      ? `查看大图：${item.imageAlt || item.name}（共 ${item.imageCount} 张）`
                      : `查看大图：${item.imageAlt || item.name}`
                  }
                >
                  <img
                    src={item.cover}
                    alt=""
                    class="pointer-events-none h-full w-full object-cover select-none"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    data-price-thumb
                  />
                  {item.imageCount > 1 && (
                    <span
                      class="price-zoom-badge absolute bottom-0.5 right-0.5 min-w-[1.1rem] px-1 py-px text-[10px] leading-tight tabular-nums text-cream bg-ink-deep/80 border border-brass-mid/40"
                      aria-hidden="true"
                    >
                      {item.imageCount}
                    </span>
                  )}
                </button>
              ) : (
                <span class="price-thumb-oos" aria-label="暂时无货">
                  <span class="price-thumb-oos__text" aria-hidden="true">暂时<br />无货</span>
                </span>
              )}
            </div>
            <div class="min-w-0">
              <h3 class="font-serif text-cream text-lg tracking-cn mb-2">{item.name}</h3>
              <p class="text-xs text-text-dim tracking-cn mb-3 leading-relaxed">
                <span class="text-brass-mid/80">物种</span> {item.species}
                <span class="mx-1.5 text-brass-mid/40">·</span>
                <span class="text-brass-mid/80">制作</span> {item.prepMethod}
                <span class="mx-1.5 text-brass-mid/40">·</span>
                <span class="text-brass-mid/80">包装</span> {item.packaging}
              </p>
              <p class="mb-3 flex flex-wrap items-baseline gap-x-4 gap-y-1 tracking-cn tabular-nums">
                <span>
                  <span class="text-xs text-brass-mid/80 mr-1.5">供货</span>
                  <span class="font-serif text-brass-bright text-xl">{item.priceLabel}</span>
                </span>
                <span>
                  <span class="text-xs text-brass-mid/80 mr-1.5">指导</span>
                  <span class="font-serif text-cream/90 text-lg">{item.guidePriceLabel}</span>
                </span>
              </p>
              <p class="text-sm text-text-soft tracking-cn leading-relaxed mb-2">
                {item.specs}
              </p>
              {item.note && (
                <p class="text-xs text-text-dim tracking-cn">备注：{item.note}</p>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-12 text-center text-xs text-text-dim tracking-cn">
      价格单位：人民币元 · 供货 / 指导售价以实际沟通确认为准
    </p>
  </section>

  {/* 采购篮：侧栏汇总 + 提交意向（高于表格/页头，低于原生 dialog lightbox） */}
  <div
    data-cart-backdrop
    class="price-cart-backdrop"
    hidden
    aria-hidden="true"
  ></div>
  <aside
    data-cart-drawer
    class="price-cart-drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="price-cart-title"
    aria-hidden="true"
    tabindex="-1"
  >
    <div class="price-cart-shell">
      <header class="price-cart-header">
        <div class="min-w-0">
          <p class="font-serif-en italic text-[11px] text-brass-mid tracking-widest uppercase">
            Purchase basket
          </p>
          <h2 id="price-cart-title" class="font-serif text-xl text-cream tracking-cn mt-0.5">
            采购篮
          </h2>
        </div>
        <button
          type="button"
          data-cart-close
          class="price-cart-close"
          aria-label="关闭采购篮"
        >
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <div class="price-cart-body" data-cart-body>
        {/* 空篮 */}
        <div data-cart-empty class="price-cart-empty">
          <p class="font-serif-en italic text-[11px] text-brass-mid tracking-widest uppercase mb-3">
            Empty
          </p>
          <p class="font-serif text-cream text-lg tracking-cn mb-2">尚未选择商品</p>
          <p class="text-xs text-text-dim tracking-cn leading-relaxed">
            在清单中勾选商品并填写数量，再打开采购篮提交意向。
          </p>
          <button
            type="button"
            data-cart-close
            class="mt-6 border border-brass-mid/40 px-4 py-2 text-sm text-brass-mid tracking-cn hover:border-brass-mid hover:text-cream transition-colors"
          >
            继续选购
          </button>
        </div>

        {/* 已选清单 */}
        <section data-cart-lines-section class="price-cart-section" hidden>
          <div class="price-cart-section-label">
            <span>已选清单</span>
            <span data-cart-line-count class="tabular-nums text-text-dim">0 款</span>
          </div>
          <ul data-cart-lines class="price-cart-lines"></ul>
        </section>

        {/* 小计：独立分区，避免被列表/浮层遮挡 */}
        <section data-cart-total-wrap class="price-cart-total" hidden>
          <div class="price-cart-total-row">
            <span class="text-sm text-text-soft tracking-cn">供货价小计</span>
            <span data-cart-total class="font-serif text-brass-bright text-2xl tabular-nums tracking-cn">
              —
            </span>
          </div>
          <p data-cart-total-hint class="price-cart-total-hint" hidden>
            含区间价商品，按供货价下限估算；精确金额以沟通确认为准
          </p>
        </section>

        {/* 联系表单（操作按钮在 sticky footer） */}
        <form data-cart-form class="price-cart-form" hidden>
          <div class="price-cart-section-label">
            <span>联系与备注</span>
          </div>
          <label class="price-cart-field">
            <span>联系人 *</span>
            <input name="contactName" required maxlength="40" autocomplete="name" />
          </label>
          <label class="price-cart-field">
            <span>电话 / 微信 *</span>
            <input name="contactPhone" required maxlength="60" autocomplete="tel" />
          </label>
          <label class="price-cart-field">
            <span>公司或店铺名（可选）</span>
            <input name="company" maxlength="80" />
          </label>
          <label class="price-cart-field">
            <span>收货 / 备注（可选）</span>
            <textarea name="note" rows="2" maxlength="500"></textarea>
          </label>
          {/* 蜜罐：对用户隐藏，机器人填写则拒收 */}
          <label class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
            网站
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
        </form>

        {/* 成功态 */}
        <div data-cart-success class="price-cart-success" hidden>
          <p class="font-serif-en italic text-[11px] text-brass-mid tracking-widest uppercase mb-3">
            Sent
          </p>
          <p class="font-serif text-cream text-xl tracking-cn mb-2">已提交，我们会尽快联系</p>
          <p data-cart-success-note class="text-xs text-text-dim tracking-cn leading-relaxed mb-6">
            采购意向已进入后台清单
          </p>
          <button
            type="button"
            data-cart-success-close
            class="border border-brass-mid/50 bg-brass-mid/15 px-5 py-2.5 text-sm text-cream tracking-cn hover:bg-brass-mid/25 transition-colors"
          >
            继续浏览
          </button>
        </div>
      </div>

      <footer data-cart-footer class="price-cart-footer" hidden>
        <p data-cart-msg class="price-cart-msg" role="status" aria-live="polite"></p>
        <div class="price-cart-actions">
          <button type="button" data-cart-clear class="price-cart-btn-ghost">
            清空
          </button>
          <button type="button" data-cart-submit class="price-cart-btn-primary">
            提交采购意向
          </button>
        </div>
      </footer>
    </div>
  </aside>

  {/* 商品图放大：原生 dialog；多图时支持上一张 / 下一张 */}
  <dialog
    data-price-zoom-dialog
    class="price-zoom-dialog w-[min(96vw,48rem)] max-w-full border border-brass-mid/40 bg-ink-deep p-4 text-cream open:flex open:max-h-[90vh] open:flex-col open:gap-3"
    aria-label="商品大图"
  >
    <div class="relative flex min-h-0 flex-1 items-center justify-center">
      <button
        type="button"
        data-price-zoom-prev
        class="price-zoom-nav absolute left-0 top-1/2 z-10 -translate-y-1/2 px-2 py-3 text-brass-mid hover:text-brass-bright focus:outline-none focus-visible:ring-2 focus-visible:ring-brass-bright/70 disabled:opacity-0 disabled:pointer-events-none"
        aria-label="上一张"
        hidden
      >
        <span aria-hidden="true" class="text-2xl leading-none">‹</span>
      </button>
      <img
        data-price-zoom-img
        src=""
        alt=""
        class="mx-auto max-h-[min(70vh,820px)] w-full object-contain"
      />
      <button
        type="button"
        data-price-zoom-next
        class="price-zoom-nav absolute right-0 top-1/2 z-10 -translate-y-1/2 px-2 py-3 text-brass-mid hover:text-brass-bright focus:outline-none focus-visible:ring-2 focus-visible:ring-brass-bright/70 disabled:opacity-0 disabled:pointer-events-none"
        aria-label="下一张"
        hidden
      >
        <span aria-hidden="true" class="text-2xl leading-none">›</span>
      </button>
    </div>
    <div class="flex items-center justify-between gap-3 border-t border-brass-mid/20 pt-2">
      <p data-price-zoom-count class="text-xs text-text-dim tracking-cn tabular-nums min-w-[3.5rem]" hidden></p>
      <p data-price-zoom-cap class="flex-1 text-center text-sm text-text-soft tracking-cn"></p>
      <form method="dialog" class="shrink-0">
        <button
          type="submit"
          data-price-zoom-close
          class="text-sm text-brass-mid tracking-cn hover:text-brass-bright focus:outline-none focus-visible:ring-2 focus-visible:ring-brass-bright/70"
        >
          关闭
        </button>
      </form>
    </div>
  </dialog>
</Layout>

<script>
  import { submitPurchaseIntent } from '../lib/purchaseIntent';

  function setChipActive(chip: HTMLButtonElement, on: boolean) {
    chip.setAttribute('aria-pressed', on ? 'true' : 'false');
    chip.classList.toggle('is-active', on);
    chip.classList.toggle('border-brass-mid', on);
    chip.classList.toggle('bg-brass-mid/15', on);
    chip.classList.toggle('text-cream', on);
    chip.classList.toggle('border-brass-mid/25', !on);
    chip.classList.toggle('text-text-soft', !on);
  }

  function initPriceFilters() {
    const root = document.querySelector('[data-price-list]');
    if (!root) return;

    const packagingBar = root.querySelector<HTMLElement>('[data-filter-dim="packaging"]');
    const bioBar = root.querySelector<HTMLElement>('[data-filter-dim="bio"]');
    const countEl = root.querySelector<HTMLElement>('[data-price-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-price-empty]');
    const tableWrap = root.querySelector<HTMLElement>('[data-price-table-wrap]');
    const mobileList = root.querySelector<HTMLElement>('[data-price-mobile-list]');
    if (!packagingBar || !bioBar || !countEl || !emptyEl) return;

    const desktopRows = Array.from(
      root.querySelectorAll<HTMLElement>('tbody .price-list-row[data-packaging]')
    );
    const mobileRows = Array.from(
      root.querySelectorAll<HTMLElement>('[data-price-mobile-list] .price-list-row[data-packaging]')
    );
    const itemTotal = desktopRows.length || mobileRows.length;

    let packaging: string = 'all';
    let bio: string = 'all';

    function apply() {
      let visible = 0;
      const match = (el: HTMLElement) => {
        const p = el.dataset.packaging || '';
        const b = el.dataset.bio || '';
        const ok =
          (packaging === 'all' || p === packaging) && (bio === 'all' || b === bio);
        el.hidden = !ok;
        return ok;
      };

      desktopRows.forEach((row) => {
        if (match(row)) visible += 1;
      });
      mobileRows.forEach((row) => {
        match(row);
      });

      countEl!.textContent = `显示 ${visible} / ${itemTotal} 款`;
      const isEmpty = visible === 0;
      emptyEl!.hidden = !isEmpty;
      if (tableWrap) tableWrap.hidden = isEmpty;
      if (mobileList) mobileList.hidden = isEmpty;

      // Optional URL sync
      const params = new URLSearchParams();
      if (packaging !== 'all') params.set('pack', packaging);
      if (bio !== 'all') params.set('bio', bio);
      const qs = params.toString();
      const next = qs ? `?${qs}` : window.location.pathname;
      if (history.replaceState) {
        history.replaceState(null, '', next);
      }
    }

    function bindBar(bar: HTMLElement, dim: 'packaging' | 'bio') {
      const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('.price-filter-chip'));
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const value = chip.dataset.filterValue || 'all';
          if (dim === 'packaging') packaging = value;
          else bio = value;
          chips.forEach((c) => setChipActive(c, c === chip));
          apply();
        });
      });
    }

    bindBar(packagingBar, 'packaging');
    bindBar(bioBar, 'bio');

    // Restore from query
    const params = new URLSearchParams(window.location.search);
    const packQ = params.get('pack');
    const bioQ = params.get('bio');
    if (packQ) {
      const chip = packagingBar.querySelector<HTMLButtonElement>(
        `[data-filter-value="${CSS.escape(packQ)}"]`
      );
      if (chip) {
        packaging = packQ;
        packagingBar
          .querySelectorAll<HTMLButtonElement>('.price-filter-chip')
          .forEach((c) => setChipActive(c, c === chip));
      }
    }
    if (bioQ) {
      const chip = bioBar.querySelector<HTMLButtonElement>(
        `[data-filter-value="${CSS.escape(bioQ)}"]`
      );
      if (chip) {
        bio = bioQ;
        bioBar
          .querySelectorAll<HTMLButtonElement>('.price-filter-chip')
          .forEach((c) => setChipActive(c, c === chip));
      }
    }

    apply();
  }

  /** 与 SSR 无图占位同一 markup（.price-thumb-oos）；避免破图图标 + alt 挤框 */
  function createPriceThumbOos(): HTMLElement {
    const root = document.createElement('span');
    root.className = 'price-thumb-oos';
    root.setAttribute('aria-label', '暂时无货');
    const text = document.createElement('span');
    text.className = 'price-thumb-oos__text';
    text.setAttribute('aria-hidden', 'true');
    text.append('暂时', document.createElement('br'), '无货');
    root.appendChild(text);
    return root;
  }

  function initThumbFallbacks() {
    const thumbs = document.querySelectorAll<HTMLImageElement>('img[data-price-thumb]');
    thumbs.forEach((img) => {
      if (img.dataset.fallbackBound === 'true') return;
      img.dataset.fallbackBound = 'true';

      const applyFallback = () => {
        if (img.dataset.fallbackApplied === 'true') return;
        img.dataset.fallbackApplied = 'true';
        const trigger = img.closest('[data-price-zoom]');
        const wrap = trigger?.parentElement;
        if (!wrap) return;
        wrap.replaceChildren(createPriceThumbOos());
      };

      img.addEventListener('error', applyFallback, { once: true });
      if (img.complete && img.naturalWidth === 0) applyFallback();
    });
  }

  function initPriceZoom() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-price-zoom-dialog]');
    const dialogImg = document.querySelector<HTMLImageElement>('[data-price-zoom-img]');
    const dialogCap = document.querySelector<HTMLElement>('[data-price-zoom-cap]');
    const dialogCount = document.querySelector<HTMLElement>('[data-price-zoom-count]');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-price-zoom-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-price-zoom-next]');
    if (!dialog || !dialogImg || !dialogCap || !dialogCount || !prevBtn || !nextBtn) return;

    if (dialog.dataset.bound === 'true') return;
    dialog.dataset.bound = 'true';

    let images: string[] = [];
    let index = 0;
    let alt = '';

    function parseImages(btn: HTMLButtonElement): string[] {
      const raw = btn.dataset.zoomImages;
      if (raw) {
        try {
          const parsed = JSON.parse(raw) as unknown;
          if (Array.isArray(parsed) && parsed.every((x) => typeof x === 'string')) {
            return parsed as string[];
          }
        } catch {
          /* fall through */
        }
      }
      const src = btn.dataset.zoomSrc;
      return src ? [src] : [];
    }

    function renderSlide() {
      const src = images[index];
      if (!src) return;
      dialogImg.src = src;
      dialogImg.alt = alt;
      dialogCap.textContent = alt;

      const multi = images.length > 1;
      dialogCount.hidden = !multi;
      prevBtn.hidden = !multi;
      nextBtn.hidden = !multi;
      if (multi) {
        dialogCount.textContent = `${index + 1} / ${images.length}`;
        prevBtn.disabled = false;
        nextBtn.disabled = false;
      }
    }

    function step(delta: number) {
      if (images.length <= 1) return;
      index = (index + delta + images.length) % images.length;
      renderSlide();
    }

    function openFrom(btn: HTMLButtonElement) {
      images = parseImages(btn);
      if (images.length === 0) return;
      const start = Number.parseInt(btn.dataset.zoomIndex || '0', 10);
      index = Number.isFinite(start) ? Math.max(0, Math.min(start, images.length - 1)) : 0;
      alt = btn.dataset.zoomAlt || '';
      renderSlide();
      dialog.showModal();
      if (images.length > 1) nextBtn.focus();
      else {
        const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-price-zoom-close]');
        closeBtn?.focus();
      }
    }

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest<HTMLButtonElement>('[data-price-zoom]');
      if (!btn) return;
      openFrom(btn);
    });

    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      step(-1);
    });
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      step(1);
    });

    dialog.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      }
      // Esc closes via native <dialog> behavior
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      images = [];
      index = 0;
      dialogImg.removeAttribute('src');
      dialogImg.alt = '';
      dialogCap.textContent = '';
      dialogCount.textContent = '';
      dialogCount.hidden = true;
      prevBtn.hidden = true;
      nextBtn.hidden = true;
    });
  }

  function parseNullableNumber(raw: string | undefined): number | null {
    if (raw === undefined || raw === '') return null;
    const n = Number(raw);
    return Number.isFinite(n) ? n : null;
  }

  /** 与 formatPriceAmount 一致：¥290；无价为 — */
  function formatMoney(n: number | null): string {
    if (n === null || n === undefined) return '—';
    return `¥${n}`;
  }

  function syncPriceHeaderOffset() {
    const header = document.querySelector('header');
    const h = header ? Math.ceil(header.getBoundingClientRect().height) : 76;
    document.documentElement.style.setProperty('--price-header-offset', `${h}px`);
  }

  function initPurchaseCart() {
    const root = document.querySelector('[data-price-list]');
    const drawer = document.querySelector<HTMLElement>('[data-cart-drawer]');
    const backdrop = document.querySelector<HTMLElement>('[data-cart-backdrop]');
    if (!root || !drawer || !backdrop) return;
    if (drawer.dataset.bound === 'true') return;
    drawer.dataset.bound = 'true';

    const openBtns = document.querySelectorAll<HTMLButtonElement>('[data-cart-open]');
    const closeBtns = drawer.querySelectorAll<HTMLButtonElement>('[data-cart-close]');
    const clearBtn = drawer.querySelector<HTMLButtonElement>('[data-cart-clear]');
    const form = drawer.querySelector<HTMLFormElement>('[data-cart-form]');
    const linesSection = drawer.querySelector<HTMLElement>('[data-cart-lines-section]');
    const linesEl = drawer.querySelector<HTMLElement>('[data-cart-lines]');
    const lineCountEl = drawer.querySelector<HTMLElement>('[data-cart-line-count]');
    const emptyEl = drawer.querySelector<HTMLElement>('[data-cart-empty]');
    const totalWrap = drawer.querySelector<HTMLElement>('[data-cart-total-wrap]');
    const totalEl = drawer.querySelector<HTMLElement>('[data-cart-total]');
    const totalHint = drawer.querySelector<HTMLElement>('[data-cart-total-hint]');
    const footerEl = drawer.querySelector<HTMLElement>('[data-cart-footer]');
    const msgEl = drawer.querySelector<HTMLElement>('[data-cart-msg]');
    const successEl = drawer.querySelector<HTMLElement>('[data-cart-success]');
    const successNote = drawer.querySelector<HTMLElement>('[data-cart-success-note]');
    const successClose = drawer.querySelector<HTMLButtonElement>('[data-cart-success-close]');
    const submitBtn = drawer.querySelector<HTMLButtonElement>('[data-cart-submit]');
    const badges = document.querySelectorAll<HTMLElement>('[data-cart-badge]');

    let successMode = false;
    let lastFocus: HTMLElement | null = null;
    let submitting = false;

    syncPriceHeaderOffset();
    window.addEventListener('resize', syncPriceHeaderOffset, { passive: true });

    type CartLine = {
      skuId: string;
      name: string;
      quantity: number;
      price: number | null;
      priceMax: number | null;
      priceLabel: string;
      priceIsRange: boolean;
      guidePrice: number | null;
      guidePriceMax: number | null;
      guidePriceLabel: string;
    };

    function syncPair(skuId: string, checked: boolean, qty: number) {
      root!.querySelectorAll<HTMLElement>(`.price-list-row[data-sku-id="${CSS.escape(skuId)}"]`).forEach((row) => {
        const check = row.querySelector<HTMLInputElement>('[data-sku-check]');
        const qtyInput = row.querySelector<HTMLInputElement>('[data-sku-qty]');
        if (check) check.checked = checked;
        if (qtyInput) {
          qtyInput.disabled = !checked;
          qtyInput.value = String(qty);
        }
      });
    }

    function collect(): CartLine[] {
      const seen = new Set<string>();
      const lines: CartLine[] = [];
      for (const row of Array.from(root!.querySelectorAll<HTMLElement>('.price-list-row[data-sku-id]'))) {
        const skuId = row.dataset.skuId || '';
        if (!skuId || seen.has(skuId)) continue;
        const check = row.querySelector<HTMLInputElement>('[data-sku-check]');
        if (!check?.checked) continue;
        seen.add(skuId);
        const qtyInput = row.querySelector<HTMLInputElement>('[data-sku-qty]');
        const quantity = Math.min(9999, Math.max(1, Math.floor(Number(qtyInput?.value || 1))));
        const priceMin = parseNullableNumber(row.dataset.skuPriceMin);
        const priceMax = parseNullableNumber(row.dataset.skuPriceMax);
        const guideMin = parseNullableNumber(row.dataset.skuGuideMin);
        const guideMax = parseNullableNumber(row.dataset.skuGuideMax);
        const priceIsRange = row.dataset.skuPriceRange === '1';
        lines.push({
          skuId,
          name: row.dataset.skuName || skuId,
          quantity,
          price: priceMin,
          priceMax,
          priceLabel: row.dataset.skuPriceLabel || formatMoney(priceMin),
          priceIsRange,
          guidePrice: guideMin,
          guidePriceMax: guideMax,
          guidePriceLabel: row.dataset.skuGuideLabel || formatMoney(guideMin),
        });
      }
      return lines;
    }

    function setMsg(text: string, kind: 'idle' | 'info' | 'error' | 'ok' = 'idle') {
      if (!msgEl) return;
      msgEl.textContent = text;
      msgEl.dataset.kind = kind;
    }

    function escapeHtml(s: string) {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function focusableInDrawer(): HTMLElement[] {
      return Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => {
        if (el.closest('[hidden]')) return false;
        const style = window.getComputedStyle(el);
        return style.visibility !== 'hidden' && style.display !== 'none';
      });
    }

    function render() {
      const lines = collect();
      const count = lines.reduce((s, l) => s + l.quantity, 0);
      badges.forEach((b) => {
        b.textContent = String(count);
      });
      openBtns.forEach((btn) => {
        btn.dataset.hasItems = lines.length > 0 ? '1' : '0';
      });

      if (!linesEl || !emptyEl || !totalWrap || !totalEl || !form || !footerEl || !linesSection) return;

      if (successMode) {
        emptyEl.hidden = true;
        linesSection.hidden = true;
        totalWrap.hidden = true;
        form.hidden = true;
        footerEl.hidden = true;
        if (successEl) successEl.hidden = false;
        return;
      }

      if (successEl) successEl.hidden = true;

      if (lines.length === 0) {
        emptyEl.hidden = false;
        linesSection.hidden = true;
        linesEl.innerHTML = '';
        totalWrap.hidden = true;
        form.hidden = true;
        footerEl.hidden = true;
        if (totalHint) totalHint.hidden = true;
        return;
      }

      emptyEl.hidden = true;
      linesSection.hidden = false;
      form.hidden = false;
      totalWrap.hidden = false;
      footerEl.hidden = false;
      if (lineCountEl) lineCountEl.textContent = `${lines.length} 款`;

      let subtotal: number | null = null;
      let hasRange = false;
      linesEl.innerHTML = lines
        .map((l) => {
          if (l.priceIsRange) hasRange = true;
          const lineTotal =
            typeof l.price === 'number' ? Math.round(l.price * l.quantity * 100) / 100 : null;
          if (lineTotal !== null) subtotal = (subtotal ?? 0) + lineTotal;
          const lineTotalLabel =
            lineTotal === null
              ? ''
              : l.priceIsRange
                ? `约 ${formatMoney(lineTotal)}`
                : formatMoney(lineTotal);
          return `<li class="price-cart-line" data-cart-line data-sku-id="${escapeHtml(l.skuId)}">
            <div class="price-cart-line-top">
              <span class="price-cart-line-name">${escapeHtml(l.name)}</span>
              <button type="button" class="price-cart-line-remove" data-cart-remove="${escapeHtml(l.skuId)}" aria-label="移除 ${escapeHtml(l.name)}">移除</button>
            </div>
            <div class="price-cart-line-meta">
              <span>供货 ${escapeHtml(l.priceLabel)}</span>
              ${l.priceIsRange ? '<span class="price-cart-line-range">按下限估</span>' : ''}
            </div>
            <div class="price-cart-line-bottom">
              <div class="price-cart-qty" role="group" aria-label="${escapeHtml(l.name)} 数量">
                <button type="button" data-cart-qty-delta="-1" data-sku-id="${escapeHtml(l.skuId)}" aria-label="减少数量">−</button>
                <input type="number" min="1" max="9999" value="${l.quantity}" data-cart-qty-input data-sku-id="${escapeHtml(l.skuId)}" aria-label="${escapeHtml(l.name)} 数量" />
                <button type="button" data-cart-qty-delta="1" data-sku-id="${escapeHtml(l.skuId)}" aria-label="增加数量">+</button>
              </div>
              <span class="price-cart-line-subtotal tabular-nums">${lineTotalLabel || '—'}</span>
            </div>
          </li>`;
        })
        .join('');

      if (subtotal === null) {
        totalEl.textContent = '—';
        if (totalHint) totalHint.hidden = true;
      } else if (hasRange) {
        totalEl.textContent = `约 ${formatMoney(subtotal)}`;
        if (totalHint) totalHint.hidden = false;
      } else {
        totalEl.textContent = formatMoney(subtotal);
        if (totalHint) totalHint.hidden = true;
      }
    }

    function openDrawer() {
      successMode = false;
      setMsg('');
      syncPriceHeaderOffset();
      render();
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.hidden = false;
      backdrop.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('price-cart-open');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        backdrop.classList.add('is-open');
        const focusables = focusableInDrawer();
        (focusables[0] || drawer).focus?.();
      });
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      backdrop.classList.remove('is-open');
      backdrop.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('price-cart-open');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        if (!drawer.classList.contains('is-open')) {
          backdrop.hidden = true;
          backdrop.setAttribute('aria-hidden', 'true');
        }
      }, 300);
      lastFocus?.focus?.();
      lastFocus = null;
    }

    function setQty(skuId: string, qty: number) {
      const next = Math.min(9999, Math.max(1, Math.floor(qty)));
      syncPair(skuId, true, next);
      render();
    }

    function removeLine(skuId: string) {
      syncPair(skuId, false, 1);
      setMsg('');
      render();
    }

    function clearCart() {
      root!.querySelectorAll<HTMLInputElement>('[data-sku-check]').forEach((c) => {
        c.checked = false;
      });
      root!.querySelectorAll<HTMLInputElement>('[data-sku-qty]').forEach((q) => {
        q.value = '1';
        q.disabled = true;
      });
      successMode = false;
      setMsg('');
      render();
    }

    async function handleSubmit() {
      if (!form || submitting) return;
      const lines = collect();
      if (lines.length === 0) {
        setMsg('请至少选择 1 个商品', 'error');
        return;
      }
      const fd = new FormData(form);
      if (String(fd.get('website') || '').trim()) {
        // 蜜罐命中：静默成功，不落库
        successMode = true;
        if (successNote) successNote.textContent = '采购意向已进入后台清单';
        setMsg('');
        render();
        return;
      }
      const contactName = String(fd.get('contactName') || '').trim();
      const contactPhone = String(fd.get('contactPhone') || '').trim();
      if (!contactName || !contactPhone) {
        setMsg('请填写联系人与联系方式', 'error');
        form.querySelector<HTMLInputElement>(!contactName ? '[name="contactName"]' : '[name="contactPhone"]')?.focus();
        return;
      }

      submitting = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '提交中…';
      }
      setMsg('正在提交采购意向…', 'info');

      try {
        const result = await submitPurchaseIntent({
          contactName,
          contactPhone,
          company: String(fd.get('company') || '').trim() || undefined,
          note: String(fd.get('note') || '').trim() || undefined,
          items: lines,
        });
        if (!result.ok) {
          setMsg(result.error || '提交失败，请稍后重试', 'error');
          return;
        }
        form.reset();
        root!.querySelectorAll<HTMLInputElement>('[data-sku-check]').forEach((c) => {
          c.checked = false;
        });
        root!.querySelectorAll<HTMLInputElement>('[data-sku-qty]').forEach((q) => {
          q.value = '1';
          q.disabled = true;
        });
        successMode = true;
        if (successNote) {
          successNote.textContent =
            result.mode === 'local'
              ? '已本机暂存；云端就绪后可同步写入采购意向库'
              : '采购意向已进入后台清单';
        }
        setMsg('');
        render();
      } catch (err) {
        setMsg(err instanceof Error ? err.message : '提交失败，请稍后重试', 'error');
      } finally {
        submitting = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '提交采购意向';
        }
      }
    }

    root.addEventListener('change', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement)) return;
      const row = t.closest<HTMLElement>('.price-list-row[data-sku-id]');
      if (!row) return;
      const skuId = row.dataset.skuId || '';
      if (t.matches('[data-sku-check]')) {
        const qtyInput = row.querySelector<HTMLInputElement>('[data-sku-qty]');
        const qty = Math.min(9999, Math.max(1, Math.floor(Number(qtyInput?.value || 1))));
        syncPair(skuId, t.checked, qty);
        if (successMode) successMode = false;
        render();
      } else if (t.matches('[data-sku-qty]')) {
        const check = row.querySelector<HTMLInputElement>('[data-sku-check]');
        const qty = Math.min(9999, Math.max(1, Math.floor(Number(t.value || 1))));
        t.value = String(qty);
        syncPair(skuId, !!check?.checked, qty);
        render();
      }
    });

    root.addEventListener('input', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement) || !t.matches('[data-sku-qty]')) return;
      render();
    });

    linesEl?.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      const removeBtn = t.closest<HTMLElement>('[data-cart-remove]');
      if (removeBtn) {
        removeLine(removeBtn.getAttribute('data-cart-remove') || '');
        return;
      }
      const deltaBtn = t.closest<HTMLElement>('[data-cart-qty-delta]');
      if (deltaBtn) {
        const skuId = deltaBtn.getAttribute('data-sku-id') || '';
        const delta = Number(deltaBtn.getAttribute('data-cart-qty-delta') || 0);
        const line = collect().find((l) => l.skuId === skuId);
        if (!line) return;
        const next = line.quantity + delta;
        if (next < 1) removeLine(skuId);
        else setQty(skuId, next);
      }
    });

    linesEl?.addEventListener('change', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLInputElement) || !t.matches('[data-cart-qty-input]')) return;
      const skuId = t.getAttribute('data-sku-id') || '';
      setQty(skuId, Number(t.value || 1));
    });

    openBtns.forEach((btn) => btn.addEventListener('click', openDrawer));
    closeBtns.forEach((btn) => btn.addEventListener('click', closeDrawer));
    backdrop.addEventListener('click', closeDrawer);
    successClose?.addEventListener('click', () => {
      successMode = false;
      closeDrawer();
      render();
    });
    clearBtn?.addEventListener('click', clearCart);
    submitBtn?.addEventListener('click', () => {
      void handleSubmit();
    });
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      void handleSubmit();
    });

    document.addEventListener('keydown', (e) => {
      if (!drawer.classList.contains('is-open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDrawer();
        return;
      }
      if (e.key !== 'Tab') return;
      const focusables = focusableInDrawer();
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    render();
  }

  function initPriceListPage() {
    syncPriceHeaderOffset();
    initPriceFilters();
    initThumbFallbacks();
    initPriceZoom();
    initPurchaseCart();
  }

  initPriceListPage();
  document.addEventListener('astro:page-load', initPriceListPage);
</script>

