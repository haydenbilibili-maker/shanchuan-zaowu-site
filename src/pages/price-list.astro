---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { priceListCategories, priceListMeta } from '../data/priceList';

function formatPrice(price: number | null): string {
  if (price === null) return '—';
  return String(price);
}
---

<Layout
  title={`${priceListMeta.year}年${priceListMeta.title}`}
  description="山海造物 · 线下供货价格表——按品类查阅商品图片、品名、价格与规格。"
>
  <PageHero
    eyebrow={priceListMeta.eyebrow}
    title={`${priceListMeta.year}年<br />${priceListMeta.title}`}
    lead={priceListMeta.lead}
  />

  <hr class="brass-divider" />

  <section class="editorial-section py-section fade-in" data-price-list>
    {/* 品类切换 —— 对应报价表工作表标签 */}
    <nav
      class="price-list-tabs mb-10 -mx-2 px-2 overflow-x-auto"
      aria-label="报价单品类"
      role="tablist"
    >
      <ul class="flex flex-nowrap gap-2 min-w-min pb-1">
        {priceListCategories.map((cat, index) => (
          <li class="shrink-0">
            <button
              type="button"
              role="tab"
              id={`tab-${cat.id}`}
              aria-controls={`panel-${cat.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              data-tab={cat.id}
              class:list={[
                'price-list-tab whitespace-nowrap px-4 py-2.5 text-sm tracking-cn transition-colors duration-200 border',
                index === 0
                  ? 'is-active border-brass-mid bg-brass-mid/15 text-cream'
                  : 'border-brass-mid/25 text-text-soft hover:border-brass-mid/50 hover:text-cream',
              ]}
            >
              {cat.label}
            </button>
          </li>
        ))}
      </ul>
    </nav>

    {priceListCategories.map((cat, index) => (
      <div
        id={`panel-${cat.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${cat.id}`}
        data-panel={cat.id}
        hidden={index !== 0}
        class="price-list-panel"
      >
        <div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
          <div>
            {cat.eyebrow && (
              <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-2">
                {cat.eyebrow}
              </p>
            )}
            <h2 class="font-serif text-2xl text-cream tracking-cn">{cat.label}</h2>
          </div>
          <p class="text-xs text-text-dim tracking-cn">
            {cat.items.length > 0 ? `${cat.items.length} 款` : '待填充'}
          </p>
        </div>

        {cat.items.length === 0 ? (
          <div class="border border-brass-mid/25 px-6 py-14 text-center bg-ink-elevated/30">
            <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
              Coming soon
            </p>
            <p class="font-serif text-cream text-xl tracking-cn mb-2">该品类商品待填充</p>
            <p class="text-sm text-text-soft tracking-cn">
              图片、品名、价格与规格将在此陆续补充。
            </p>
          </div>
        ) : (
          <>
            {/* 桌面：五列表格骨架 */}
            <div class="hidden md:block overflow-x-auto border border-brass-mid/25">
              <table class="w-full min-w-[720px] border-collapse text-center">
                <thead>
                  <tr class="bg-ink-elevated/60 border-b border-brass-mid/25">
                    <th class="px-4 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium w-[140px]">
                      图片
                    </th>
                    <th class="px-4 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium">
                      品名
                    </th>
                    <th class="px-4 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium w-[100px]">
                      价格
                    </th>
                    <th class="px-4 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium">
                      规格
                    </th>
                    <th class="px-4 py-3 font-serif text-sm text-brass-mid tracking-cn font-medium w-[120px]">
                      备注
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {cat.items.map((item) => (
                    <tr class="border-b border-brass-mid/15 last:border-b-0 align-middle">
                      <td class="px-4 py-4">
                        <div class="mx-auto w-[96px] aspect-square border border-brass-mid/30 bg-ink-deep/40 overflow-hidden flex items-center justify-center">
                          {item.image ? (
                            <img
                              src={item.image}
                              alt={item.imageAlt || item.name}
                              class="w-full h-full object-cover"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <span class="font-serif-en italic text-[10px] text-text-dim tracking-widest uppercase">
                              Image
                            </span>
                          )}
                        </div>
                      </td>
                      <td class="px-4 py-4 font-serif text-cream tracking-cn text-base">
                        {item.name}
                      </td>
                      <td class="px-4 py-4 font-serif text-brass-bright text-xl tracking-cn tabular-nums">
                        {formatPrice(item.price)}
                      </td>
                      <td class="px-4 py-4 text-sm text-text-soft tracking-cn leading-relaxed text-left max-w-md">
                        {item.specs}
                      </td>
                      <td class="px-4 py-4 text-sm text-text-dim tracking-cn">
                        {item.note || '—'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* 移动：纵向条目，字段顺序与表格一致 */}
            <ul class="md:hidden border-t border-brass-mid/25">
              {cat.items.map((item) => (
                <li class="border-b border-brass-mid/15 py-6">
                  <div class="grid grid-cols-[88px_1fr] gap-4">
                    <div class="aspect-square border border-brass-mid/30 bg-ink-deep/40 overflow-hidden flex items-center justify-center">
                      {item.image ? (
                        <img
                          src={item.image}
                          alt={item.imageAlt || item.name}
                          class="w-full h-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="font-serif-en italic text-[10px] text-text-dim tracking-widest uppercase">
                          Image
                        </span>
                      )}
                    </div>
                    <div class="min-w-0">
                      <h3 class="font-serif text-cream text-lg tracking-cn mb-2">{item.name}</h3>
                      <p class="font-serif text-brass-bright text-xl tracking-cn tabular-nums mb-3">
                        {formatPrice(item.price)}
                      </p>
                      <p class="text-sm text-text-soft tracking-cn leading-relaxed mb-2">
                        {item.specs}
                      </p>
                      {item.note && (
                        <p class="text-xs text-text-dim tracking-cn">备注：{item.note}</p>
                      )}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    ))}

    <p class="mt-12 text-center text-xs text-text-dim tracking-cn">
      价格单位：人民币元 · 供货价以实际沟通确认为准
    </p>
  </section>
</Layout>

<script>
  function initPriceListTabs() {
    const root = document.querySelector('[data-price-list]');
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));

    function activate(id: string) {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.classList.toggle('is-active', on);
        tab.classList.toggle('border-brass-mid', on);
        tab.classList.toggle('bg-brass-mid/15', on);
        tab.classList.toggle('text-cream', on);
        tab.classList.toggle('border-brass-mid/25', !on);
        tab.classList.toggle('text-text-soft', !on);
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
      if (history.replaceState) {
        history.replaceState(null, '', `#${id}`);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        if (id) activate(id);
      });
    });

    const hash = window.location.hash.replace(/^#/, '');
    if (hash && tabs.some((t) => t.dataset.tab === hash)) {
      activate(hash);
    }
  }

  initPriceListTabs();
  document.addEventListener('astro:page-load', initPriceListTabs);
</script>

<style>
  .price-list-tabs {
    scrollbar-width: thin;
  }

  .price-list-tab.is-active {
    border-color: var(--color-brass-mid);
    background-color: color-mix(in srgb, var(--color-brass-mid) 15%, transparent);
    color: var(--color-cream);
  }
</style>
