---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Principle from '../components/Principle.astro';
import PullQuote from '../components/PullQuote.astro';
import ContactBlock from '../components/ContactBlock.astro';

// ============================================================
// I. 三档场景化定位（A.1.2）
// ============================================================
const tiers = [
  {
    name: 'Lite',
    role: '旅行 / 出行场景的伴手礼店',
    venue: '机场 · 高铁站 · 文旅景区出口',
    area: '50 – 80 ㎡',
    pricing: '中位价',
    benchmark: '中川政七「日本市」/ 蔦屋成田空港店',
  },
  {
    name: 'Pro',
    role: '城市中产 lifestyle 提案店',
    venue: '文创商场 · 生活方式街区',
    area: '150 – 250 ㎡',
    pricing: '中高位',
    benchmark: '中川政七标准店 / TSUTAYA BOOKSTORE',
  },
  {
    name: 'Max',
    role: '自然博物 + 工坊 + 教育 + 咖啡的城市目的地',
    venue: '城市文化综合体 · 与公共合作的复合空间',
    area: '400 – 600 ㎡',
    pricing: '高位',
    benchmark: '工作室带咖啡店模式 / 代官山 T-SITE',
  },
];

// ============================================================
// II. Jan Gehl《交往与空间》5 原则（A.1.4）
// ============================================================
const gehlPrinciples = [
  {
    number: 'I',
    title: '生活吸引生活',
    description: '有人的地方吸引更多人——这是城市生活的基础规律。',
    practices: [
      '工作室必须可见——玻璃 / 开放式',
      '活动密度作为开店第一年 KPI',
    ],
  },
  {
    number: 'II',
    title: '三类活动 · 必要 / 自发 / 社交',
    description: '好空间区别于差空间，在自发与社交活动是否真的发生——而不只是「人完成了消费」。',
    practices: [
      '设计时为自发 / 社交活动留物理空间',
      '不只规划销售动线，还规划停留动线',
    ],
  },
  {
    number: 'III',
    title: '柔性边界',
    description: '内外不截然分开——光线 / 视线 / 声音可以渗透。',
    practices: [
      '门头不做压迫式',
      '橱窗真展示，不堆陈列道具',
      '咖啡区保持视线穿透',
    ],
  },
  {
    number: 'IV',
    title: '边界效应',
    description: '人偏爱空间的边缘而不是中心——背后有依靠才舒适。',
    practices: [
      '座位优先靠墙 / 靠窗 / 靠柱',
      '互动区半围合',
      '收银台不居中',
    ],
  },
  {
    number: 'V',
    title: '留得比必要久',
    description: '"Good cities are like good parties" —— 衡量好空间的关键指标是：客人是否多停留了 5 分钟？',
    practices: [
      '每一处设计都问：促成离开还是促成停留？',
      '驻留时长是核心 KPI',
    ],
  },
];

// ============================================================
// III. 门店即博物馆 4 落地动作（A.1.5）
// ============================================================
const museumActions = [
  {
    number: '1',
    title: '馆藏 · 每件标本都有档案',
    description:
      '每一件展柜里的标本配博物档案卡——中文名 + 学名（拉丁文）、分类等级、产地、采集背景、保护级别、IP 关联。',
    practices: [
      '档案卡是博物馆级标准，不是商场标价签',
      '与野保白名单对照——合规边界透明',
    ],
  },
  {
    number: '2',
    title: '展览 · 每月主题中岛轮换',
    description:
      '每月做一次主题展（4 周持续）：主题展柜 + 主题档案小册子 + 主题讲座（一次） + 主题工坊（2-3 次）。',
    practices: [
      '12 个月 = 12 个主题展 = 12 期内容',
      '365 天的"持续到访理由"',
    ],
  },
  {
    number: '3',
    title: '教育 · 三层级内容输出',
    description:
      '日常（每周）：店员一句解说；月度（每月）：主题讲座 + DIY 工坊；季度（每季）：与学术机构合作的深度对谈。',
  },
  {
    number: '4',
    title: '不强制消费 · 看展不收费',
    description:
      '任何人都可以进店参观，不限时间。没有"导购"动作，没有"会员准入"门槛。',
    practices: [
      '写进店员培训手册',
      '店员不是销售员，是博物学概念的本地讲解员',
    ],
  },
];

// ============================================================
// IV. 门店即公共客厅 4 执行原则（A.1.6）
// ============================================================
const livingRoomPrinciples = [
  {
    number: 'I',
    title: '不强制购买',
    description:
      '任何人都可以使用，不是"消费 100 元后免费"——基础公共服务的门槛是 0。',
  },
  {
    number: 'II',
    title: '不刻意宣传',
    description:
      '服务被需要时被发现，不作为引流话术——把它当作店在那里"应当"做的事。',
  },
  {
    number: 'III',
    title: '主动维护',
    description:
      '固定 OPEX 项，不能为节省成本砍掉——年度成本约 Pro 店营收的 0.2-0.4%，已写进财务模型预期。',
  },
  {
    number: 'IV',
    title: '加盟方一并执行',
    description:
      '加盟合同强制项——这件事的成本不允许被加盟方"绕开"。',
  },
];

// ============================================================
// V. 公共客厅服务清单（A.1.7）—— 表格数据
// ============================================================
const livingRoomServices = [
  { item: '应急雨伞（借用归还）', lite: '✓', pro: '✓', max: '✓' },
  { item: '应急充电（USB / Type-C / Lightning）', lite: '✓', pro: '✓', max: '✓' },
  { item: '饮用水（免费）', lite: '✓', pro: '✓', max: '✓' },
  { item: '休息座位（无购买义务）', lite: '1-2', pro: '4-6', max: '10+' },
  { item: '应急雨衣 / 一次性雨披', lite: '✓', pro: '✓', max: '✓' },
  { item: 'AED 自动体外除颤器', lite: '—', pro: '✓', max: '✓' },
  { item: '公共卫生间（物业允许时）', lite: '视物业', pro: '✓', max: '✓' },
  { item: '母婴室 / 哺乳室', lite: '—', pro: '视空间', max: '✓' },
  { item: '应急医药箱', lite: '—', pro: '✓', max: '✓' },
  { item: 'WiFi 免费（不强制注册）', lite: '✓', pro: '✓', max: '✓' },
  { item: '员工接待陌生人问路 / 答疑', lite: '✓', pro: '✓', max: '✓' },
];

// ============================================================
// VI. 8 模块概览（A.2）
// ============================================================
const modules = [
  { num: 1, title: '门头', role: '识别 + 招徕', dna: '柔性边界 · 标志性"门面标本" · 副题"A NATURAL HISTORY HOUSE"' },
  { num: 2, title: '大型标本 + 仪式感', role: '仪式感开场', dna: '入门正前方一件视觉锚点 · 博物馆级射灯' },
  { num: 3, title: '珍奇展柜', role: '讲故事 / 奇观', dna: '维多利亚奇珍柜形制 · UV 防护玻璃 · 每件配档案卡' },
  { num: 4, title: '衍生品购买区', role: '成交', dna: '五大类清晰分区 · 自然小匣 C 位 · 每 SKU 配故事卡' },
  { num: 5, title: '互动 / DIY 区', role: '参与 + 内容生产', dna: '亲子高度 · 工坊感 · 半围合（边界效应）' },
  { num: 6, title: '茶饮咖啡区', role: '停留 + 公共客厅核心', dna: '视线穿透街道 · 边界座位优先 · 至少 1-2 个无消费暗示位' },
  { num: 7, title: '收银 + 仪式包装', role: '情感闭环 + 履约', dna: '收银 = 交付仪式 · 60–90 秒固定动作 · 物流分线' },
  { num: 8, title: '公共服务区', role: '城市公共客厅承诺的物理载体', dna: 'AED 显眼 · 应急服务明显但不打扰 · 中英文标识' },
];

// ============================================================
// VII. 价值七件套（A.5）
// ============================================================
const sevenValues = [
  { item: '教育内容', lite: '季度讲座 1 次', pro: '月度工作坊', max: '常态课程 + 讲师驻场' },
  { item: '本地客社群', lite: '简单会员卡', pro: '会员体系 + 私域', max: '全套 CRM + 月度活动' },
  { item: '复购路径', lite: '自然小匣季节更新', pro: '+ 订阅盒子', max: '+ 个性化推荐' },
  { item: '内容生产', lite: '公众号联动', pro: '+ 小红书联动', max: '+ 自家 B 站 / 视频出品' },
  { item: '专家 concierge', lite: '1 名认证店长', pro: '2-3 名专业人员', max: '全栈博物学家驻场' },
  { item: '博物馆功能', lite: '简版（馆藏 + 档案）', pro: '完整版（+ 主题展 + 月度讲座）', max: '旗舰版（+ 学术对谈 + 联合策展）' },
  { item: '公共客厅服务', lite: '基础包（雨伞 / 充电 / 饮水）', pro: '标准包（+ AED + 医药箱）', max: '全包（+ 母婴室 + 工作台）' },
];

// ============================================================
// VIII. 6 区运营动线（保留原内容）
// ============================================================
const zones = [
  {
    num: 'I',
    title: '入口惊奇',
    timing: '0–10 秒',
    body: '<p>一件大型标本从店外可见——黑马、蝴蝶阵列、或大型玻璃穹顶——触发那个反应：「这是什么地方？」</p><p>一进门是<strong>阈值转换</strong>：灯光从商场荧光灯切到暖色 3000K，材质从瓷砖变木质，品牌香氛标记出明确的边界。你已经不在商场了。</p>',
  },
  {
    num: 'II',
    title: '发现台',
    timing: '1–3 分钟',
    body: '<p>入口紧接的腰高中央展台，放最低价格带产品（29–49 元的种子罩、冰箱贴）——<strong>全部可触摸</strong>，密但有序，像博物学家的标本抽屉。</p><p>把浏览者变成接触者——触摸过之后，购买概率提升 3–5 倍。这是一个不动声色的转化点。</p>',
  },
  {
    num: 'III',
    title: '画廊墙',
    timing: '3–8 分钟',
    body: '<p>整面墙，沙龙式排列框装标本，轨道射灯照明。每框旁一块小铜牌：物种名 + 一句话事实。</p><p>30% 的位置留给<strong>城市特色主题</strong>——长春店有长春的物种、上海店有上海的物种。这是全店<strong>拍照频率最高</strong>的一面墙。</p>',
  },
  {
    num: 'IV',
    title: '奇珍柜',
    timing: '5–15 分钟',
    body: '<p>玻璃门木柜里的臻品——穿西装的土拨鼠、大型爬行类、哥特白鸟——<strong>需要店员开柜</strong>，制造「珠宝店时刻」。</p><p>每柜一个主题叙事。<strong>价格锚定</strong>：你看了 5 万的黑马，再看 298 的蝴蝶罩，会觉得是捡了便宜。</p>',
  },
  {
    num: 'V',
    title: '自然物料吧',
    timing: '5–20 分钟',
    body: '<p>长木槽散装区，几十格天然物——松果、桂皮、莲蓬、橡子——鼓励触摸、闻嗅。</p><p>提供棉布袋让客人自选组合，相当于<strong>集合框的 DIY 版</strong>。这是亲子客群的磁铁区——孩子在这里会停留 15 分钟以上。</p>',
  },
  {
    num: 'VI',
    title: '出口赠礼仪式',
    timing: '最后 2 分钟',
    body: '<p>收银台 = 赠礼站。店员当面包装，全程 60–90 秒，不快、不聊废话。</p><p>最后一句话是固定的：<strong>「这只 [物种名] 来自 [产地]，请好好照顾它。」</strong>把购买动作变成一次<strong>交接</strong>。客人离店时手里的品牌袋，会在商场走廊里成为一个流动的展示。</p>',
  },
];

// ============================================================
// IX. 四感官系统（保留原内容）
// ============================================================
const senses = [
  { sense: '视', en: 'Sight', body: '暖色 3000–3500K 灯光、木 + 绿 + 黄铜材质、高视觉密度。<strong>禁止</strong>荧光灯 / 白色层压板 / 塑料感的任何东西。' },
  { sense: '触', en: 'Touch', body: '原木台面、亚麻桌布、棉布袋、无涂布纸——所有可触摸的物件鼓励上手。质感是品牌的一部分。' },
  { sense: '嗅', en: 'Smell', body: '品牌统一扩香（雪松 / 苔藓 / 柑橘），每家店同款，<strong>淡而不浓</strong>。气味是离店之后大脑会自动回放的东西。' },
  { sense: '听', en: 'Sound', body: '低音量自然环境声 / 17–19 世纪室内乐 / 现代极简钢琴。<strong>禁止</strong>流行 / 电子节拍。' },
];
---

<Layout
  title="空间体系"
  description="空间 toolkit · 6 段设计哲学 + 8 模块 × 3 tier + 价值七件套——从零售空间升格为博物馆 + 公共客厅 + 零售三重职能"
>
  <PageHero
    eyebrow="Space · 空间体系"
    title="一家店，<br />即一座小型博物馆<br />也是一间城市公共客厅"
    lead="如果把店定位为零售店，所有判断按零售逻辑走（坪效 / 转化 / 客单价）。<br />如果把它定位为<strong>博物馆 + 公共客厅 + 零售</strong>三重职能——很多判断会反过来。"
  />

  {/* ============================================================
      § 0. PROLOGUE · 叙事根
      Manifesto Banner + 三段 Foreword（罗马数字 grid）+ 过渡段
      ============================================================ */}

  {/* ---------- Manifesto Banner ---------- */}
  <section class="editorial-section-wide fade-in pt-section">
    <div class="relative max-w-editorial mx-auto px-6 md:px-12 py-section md:py-20 text-center">
      {/* 顶部黄铜细线 */}
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-px bg-brass-mid/60" aria-hidden="true"></div>

      <p class="font-serif-en italic text-brass-mid text-xs tracking-[0.3em] uppercase mb-8">
        Manifesto · 我们的根
      </p>

      <p class="font-serif text-3xl md:text-5xl lg:text-6xl text-cream tracking-cn leading-[1.35] md:leading-[1.3]">
        山海造物的店<br />
        <span class="text-text-soft">不只是商业空间，</span><br />
        <span class="text-brass-bright">是城市公共生活的<br class="md:hidden" />一部分。</span>
      </p>

      {/* 底部黄铜细线 */}
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-32 h-px bg-brass-mid/60" aria-hidden="true"></div>
    </div>
  </section>

  {/* ---------- Foreword 三段 章节标题 ---------- */}
  <section class="editorial-section-wide fade-in pt-section">
    <div class="text-center mb-section">
      <p class="font-serif-en italic text-brass-mid text-xs tracking-[0.3em] uppercase mb-3">
        Prologue · Foreword · 叙事根
      </p>
      <h2 class="font-serif text-2xl md:text-3xl text-cream/90 tracking-cn">
        在结构化的设计哲学之前——
      </h2>
      <p class="font-serif text-base md:text-lg text-text-soft mt-3 tracking-cn max-w-editorial mx-auto">
        关于"我们为什么这样设计"，先说三件事。
      </p>
    </div>

    {/* 三段 Foreword（用 grid 罗马数字系统化布局） */}
    <div class="border-t border-brass-mid/15 max-w-editorial mx-auto">

      {/* Foreword I · 我们的店是博物馆 */}
      <article class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-12 py-section border-b border-brass-mid/15">
        <div class="md:w-32">
          <span class="block font-serif-en italic text-brass-mid/50 text-7xl md:text-8xl leading-none mb-2">
            I
          </span>
          <p class="font-serif-en italic text-brass-mid text-xs tracking-[0.25em] uppercase">
            The Museum
          </p>
        </div>
        <div>
          <h3 class="font-serif text-2xl md:text-4xl text-cream mb-paragraph tracking-cn leading-tight">
            我们的店是博物馆
          </h3>
          <p class="font-serif text-lg md:text-xl text-brass-bright italic tracking-cn mb-paragraph leading-relaxed">
            山海造物的每一家店，都是一座小型自然博物馆。
          </p>
          <div class="prose-cn space-y-paragraph">
            <p>
              每一件展柜里的标本都配博物档案卡——中文名、学名、产地、采集背景、与 IP 的关联——是<strong class="text-cream">博物馆级标准，不是商场标价签</strong>。
            </p>
            <p>
              每月有一次主题展柜轮换——从冬季的种子到春天的矿物，从东北的鳞翅目到云南的花期——12 个月对应 12 期内容。讲座、工坊、深度对谈持续发生——常态有自然博物学讲座，季度有与中科院、自然博物馆的深度对谈。
            </p>
            <p>
              最重要的是：<strong class="text-brass-bright">任何人都可以进店"只看不买"</strong>。我们的店员不是销售员，是博物学概念的本地讲解员。
            </p>
          </div>
        </div>
      </article>

      {/* Foreword II · 我们的店是城市的公共客厅 */}
      <article class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-12 py-section border-b border-brass-mid/15">
        <div class="md:w-32">
          <span class="block font-serif-en italic text-brass-mid/50 text-7xl md:text-8xl leading-none mb-2">
            II
          </span>
          <p class="font-serif-en italic text-brass-mid text-xs tracking-[0.25em] uppercase">
            The Living Room
          </p>
        </div>
        <div>
          <h3 class="font-serif text-2xl md:text-4xl text-cream mb-paragraph tracking-cn leading-tight">
            我们的店是城市的公共客厅
          </h3>
          <p class="font-serif text-lg md:text-xl text-brass-bright italic tracking-cn mb-paragraph leading-relaxed">
            山海造物的店不是封闭式销售空间。它是城市公共生活的一部分。
          </p>
          <div class="prose-cn space-y-paragraph">
            <p>
              进店不需要消费——你可以坐下来，喝一杯免费的水，给手机充电，避一场雨，借一把伞。
            </p>
            <p>
              每家店配备：<strong class="text-cream">AED 自动体外除颤器</strong>（Pro 版以上）、应急充电（USB / Type-C / Lightning）、应急雨伞（借用归还）、饮用水、应急医药箱、休息座位（无消费义务）。
            </p>
            <p>
              这些不收费、不强制消费、不刻意宣传——它们应该<strong class="text-brass-bright">被需要的人发现</strong>。
            </p>
            <p>
