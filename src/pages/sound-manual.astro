      },
      {
        time: '19:00–22:00',
        title: '夜段 · 鲸歌夜海',
        en: 'Whale Songs & Night Sea',
        tracks: [
          { ttl: 'Songs of the Humpback Whale（实地录音）', art: 'Roger Payne · 1970' },
          { ttl: 'Mercy', art: 'Max Richter & Hilary Hahn' },
          { ttl: 'Familiar', art: 'Nils Frahm' },
          { ttl: 'We Played Some Open Chords', art: 'A Winged Victory for the Sullen' },
          { ttl: 'Mineral', art: 'Hammock' },
          { ttl: 'Music for Airports — 2/1', art: 'Brian Eno' },
          { ttl: 'Bibo no Aozora', art: 'Ryuichi Sakamoto 坂本龙一' },
          { ttl: 'Merry Christmas Mr. Lawrence', art: 'Ryuichi Sakamoto 坂本龙一' },
          { ttl: '黑暗之光', art: '雷光夏' },
          { ttl: 'Untitled #3 (Samskeyti)', art: 'Sigur Rós' },
          { ttl: 'Threnody', art: 'Goldmund' },
          { ttl: '把山海带回家', art: '山海造物 · 21:30 起' },
        ],
      },
    ],
  },
  // ============== 纪录片日 ==============
  {
    key: 'doc',
    letter: 'F',
    index: 'VIII',
    num: '05',
    name: '纪录片日',
    nameEn: 'Documentary Day',
    subtitle: '12 hours of nature documentary scoring, no vocals',
    concept:
      'George Fenton、Hans Zimmer、Steven Price、Sarah Class、Joe Hisaishi——纪录片配乐界的顶级名字依次到场。整天 0% 歌词。这是手册里最纯粹的一天，店像一座 IMAX 影院的休息厅。也是品牌拍摄、媒体探店时的默认音乐。',
    color: 'doc',
    meta: ['48 tracks', '3 hr per block', '0% 含人声', '每周 1 次 + 拍摄日默认'],
    blocks: [
      {
