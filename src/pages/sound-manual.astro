          { ttl: 'Mountain Range', art: 'George Fenton · Planet Earth' },
          { ttl: 'Frozen Frontier', art: 'George Fenton · Frozen Planet' },
          { ttl: "Earth's Cradle", art: 'Sarah Class · BBC Africa' },
          { ttl: 'Islands Suite', art: 'Hans Zimmer · Planet Earth II' },
          { ttl: 'Mountains', art: 'Jacob Shea / Hans Zimmer · Planet Earth II' },
          { ttl: 'Cities', art: 'Hans Zimmer · Planet Earth II' },
          { ttl: 'Our Planet — Main Theme', art: 'Steven Price · Our Planet' },
          { ttl: 'Jungles', art: 'Jacob Shea · Planet Earth II' },
          { ttl: 'Coasts', art: 'Anne Dudley · Planet Earth III' },
          { ttl: 'Sahara', art: 'Sarah Class · Africa' },
          { ttl: 'Ice Worlds', art: 'George Fenton · Planet Earth' },
