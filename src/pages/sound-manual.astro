          { ttl: 'Plastic Oceans', art: 'Hans Zimmer · Blue Planet II' },
          { ttl: 'Frozen Worlds', art: 'Steven Price · Our Planet' },
          { ttl: 'Coastal Seas', art: 'Steven Price · Our Planet' },
          { ttl: 'High Seas', art: 'Steven Price · Our Planet' },
          { ttl: 'Forests', art: 'Steven Price · Our Planet' },
        ],
      },
      {
        time: '16:00–19:00',
        title: '晚段 · 野生奇观',
        en: 'Wildlife & Wonder',
        tracks: [
          { ttl: 'Power of Kahari', art: 'Sarah Class · Africa' },
          { ttl: 'Birth', art: 'Sarah Class' },
          { ttl: 'Life Suite', art: 'George Fenton · BBC Life' },
          { ttl: 'The Hunt — Main Theme', art: 'Steven Price · BBC The Hunt' },
          { ttl: 'Grasslands', art: 'Jacob Shea · Planet Earth II' },
          { ttl: 'Deserts', art: 'Hans Zimmer · Planet Earth II' },
          { ttl: 'The Race', art: 'Hans Zimmer · Planet Earth II' },
          { ttl: 'Frozen Planet — Spring', art: 'George Fenton' },
          { ttl: 'Migration', art: 'Daniel Pemberton · Life Story' },
          { ttl: 'Path of the Panda', art: 'Joby Talbot · IMAX Pandas' },
          { ttl: 'Life of Birds Suite', art: 'Ian Butcher / Steven Faux' },
          { ttl: 'Wild China — Tibet', art: 'Barnaby Taylor · BBC Wild China' },
