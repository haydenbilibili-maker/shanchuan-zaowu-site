      },
      {
        time: '19:00–22:00',
        title: '夜段 · 宇宙与沉思',
        en: 'Cosmos & Reflection',
        tracks: [
          { ttl: 'Cosmos — Main Theme', art: 'Vangelis · Carl Sagan Cosmos' },
          { ttl: 'A Spacetime Odyssey — Theme', art: 'Alan Silvestri' },
          { ttl: 'Wonders of the Solar System', art: 'Sarah Class' },
          { ttl: 'Wonders of the Universe', art: 'Sheridan Tongue / Murray Gold' },
          { ttl: 'First Step', art: 'Hans Zimmer · Interstellar' },
          { ttl: 'Cornfield Chase', art: 'Hans Zimmer · Interstellar' },
          { ttl: 'Stay', art: 'Hans Zimmer · Interstellar' },
          { ttl: 'The Legend of Ashitaka（幽灵公主）', art: 'Joe Hisaishi 久石让' },
          { ttl: "Spirited Away — One Summer's Day", art: 'Joe Hisaishi 久石让' },
          { ttl: 'Crouching Tiger, Hidden Dragon Theme', art: '谭盾 Tan Dun' },
          { ttl: 'Sleep — Dream 3', art: 'Max Richter' },
          { ttl: '把山海带回家', art: '山海造物 · 21:30 起' },
