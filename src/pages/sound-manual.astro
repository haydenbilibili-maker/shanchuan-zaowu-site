          { ttl: 'Open Ocean', art: 'George Fenton · Blue Planet' },
          { ttl: 'Frozen Seas', art: 'George Fenton · Blue Planet' },
          { ttl: 'The Blue', art: 'Hans Zimmer · Blue Planet II' },
          { ttl: 'Big Blue', art: 'Hans Zimmer · Blue Planet II' },
          { ttl: 'Coasts', art: 'Jacob Shea · Blue Planet II' },
