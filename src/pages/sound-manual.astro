// ============== § IX · 一周轮换参考 ==============
const weekSchedule = [
  { dow: 'Mon', day: '默认日', en: 'Default', color: 'brass' },
  { dow: 'Tue', day: '植物日', en: 'Plant', color: 'green' },
  { dow: 'Wed', day: '默认日', en: 'Default', color: 'brass' },
  { dow: 'Thu', day: '纪录片日', en: 'Documentary', color: 'doc' },
  { dow: 'Fri', day: '动物日', en: 'Animal', color: 'coral' },
  { dow: 'Sat', day: '默认日', en: 'Default', color: 'brass' },
  { dow: 'Sun', day: '海洋日', en: 'Ocean', color: 'cabinet' },
];

// ============== § X · 7 条内容守则 ==============
const rules = [
  {
    title: '标本不能做主语',
    body:
      '歌词里"蝴蝶飞""标本醒来"这类拟人化必须避免。主语永远是人、光、温度、时间或物件容器。原创 BGM 严格执行，外部歌单选曲也以此为审查标准。',
  },
  {
    title: '小黄不可爱化',
    body: '无论原创曲还是歌单选曲，避免"萌系"、"治愈口播"、"卡哇伊电子"等过度甜腻的声音。小黄的轻是节制的轻。',
  },
  {
    title: '不滥用纯音乐 / Lo-fi',
    body: 'Lo-fi 学习音乐表面好用、实际让人困。原则上禁用。需要"伴随专注"时使用各主题日的午段。',
  },
  {
    title: '避免商场感、电梯感',
    body: '过于"安全"的爵士钢琴翻弹合集、商场广播感的"天空之城"洞箫版——禁止。',
  },
  {
    title: '禁止热门口水歌',
    body: '无论中外。山海造物不是奶茶店。',
  },
  {
    title: '器乐优先',
    body:
      'v2 起全店音乐 70% 以上为纯器乐 / 自然纪录片配乐 / 世界音乐。歌词类作品集中在动物日早段、默认日早段、海洋日午段。',
  },
  {
    title: '《把山海带回家》一天最多两次',
    body: '集中在夜段最后 30 分钟（21:30 起）。除非品牌主题日 / 主理人到店等特殊场合。',
  },
];

// ============== § XI · 6 项特殊情境 ==============
const special = [
  {
    name: '雨天 / 雪天',
    sub: '东北冬天长，特殊处理',
    body: '植物日 + 海洋日夜段混编。窗外有自然白噪声时，BGM 整体音量调低 20%。Hauschka、Sakamoto《async》系列优先。',
  },
  {
    name: '节气节点',
    sub: '清明 · 立秋 · 冬至 · 大寒',
    body: '每个节气一份限定小歌单（5–6 首），在当天替换默认日的早段。是品牌做「节气海报 + 歌单」双内容输出的抓手。',
  },
  {
    name: '讲解 · 工坊',
    sub: '客人定制时段',
    body: '讲解全程切到纪录片日的器乐组（George Fenton / Steven Price 系列）。私人接待可由主理人指定专属歌单。',
  },
  {
    name: '主理人到店',
    sub: '独菽 · 廉澍',
    body: '到店日不强制切歌单。但主歌《把山海带回家》当天可在到店与离店各播一次，作为内部仪式。',
  },
  {
    name: '媒体探店 · 拍摄',
    sub: '对外内容产出',
    body: '拍摄期间默认纪录片日。出片素材使用原创 BGM（不要用版权歌曲做配乐）。',
  },
  {
    name: '音量基准',
    sub: '不写在歌单里但很重要',
    body: '早段 45%、午段 35%、晚段 50%、夜段 30%。客人听不清说话就是太响了。所有主题日通用。',
  },
];

// ========== 颜色 token 工具 ==========
// 主题色仅承担 text + tape · 边框统一 brass-mid/20（克制 · 不抢主体）
// coral/green/cabinet 是单色 CSS var · 不支持 opacity modifier
// 仅 brass 是 RGB tuple · 可以套 /opacity
const colorMap = {
  brass: { text: 'text-brass-mid', tape: 'bg-brass-mid' },
  coral: { text: 'text-coral-mid', tape: 'bg-coral-mid' },
  green: { text: 'text-green-mid', tape: 'bg-green-mid' },
  cabinet: { text: 'text-cabinet-mid', tape: 'bg-cabinet-mid' },
  doc: { text: 'text-brass-deep', tape: 'bg-brass-deep' },
} as const;
---

<Layout
  title="店内音乐手册 v2"
  description="240 首歌 · 5 主题日 · 12 小时全覆盖——把声音设计写进 SOP 是反直觉的，大多数零售店懒得做。我们做了。"
>
  <!-- ============== Hero ============== -->
  <PageHero
    eyebrow="Sound Manual · 店内音乐手册 v2"
    title={`一周里没有两天的声音是一样的，<br/>但每一天都明确知道自己是哪一天。`}
    lead="v1 解决了「《把山海带回家》不该一天循环八小时」。v2 把店里的声音从一条时间线扩展成一片地图：每一天都可以是不同的山海——非洲草原、南美雨林、东方山水、深海与星空。"
  />

  <!-- 首屏 Metrics ============== -->
  <section class="editorial-section">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-editorial-wide mx-auto">
      {heroMetrics.map((m) => (
        <div class="p-5 border border-brass-mid/20 bg-ink-elevated/40 text-center">
          <div class="font-serif-en italic text-5xl text-brass-mid mb-1">{m.num}</div>
          <div class="text-cream text-sm tracking-cn mb-1">{m.label}</div>
          <div class="font-serif-en italic text-xs text-text-soft">{m.en}</div>
        </div>
      ))}
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============== § I · 序言 · v1 → v2 ============== -->
  <section id="i" class="editorial-section">
    <div class="max-w-editorial mx-auto">
      <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-3">
        <span class="text-brass-deep">I.</span> Foreword — From a Day to a Map
      </p>
      <h2 class="text-3xl font-serif text-cream mb-paragraph tracking-cn">序言 · 从 v1 到 v2</h2>

      <div class="prose-cn space-y-4 p-8 border-l-2 border-brass-mid bg-ink-elevated/30">
        <p>
          v1 解决了第一个问题：《把山海带回家》不该一天循环八小时。但解决之后，又出现新的问题——一家自然博物馆式的店，应该听见什么？
        </p>
        <p>
          我们决定不让这家店每天听同一份歌单。山海造物对应的不是一种声音，是一整个自然世界的频谱：非洲草原的清晨、南美雨林的正午、东方山水的黄昏、深海中鲸鱼的夜歌、纪录片配乐里的整个地球。每一种我们都该有。
        </p>
        <p>
          v2 引入主题日系统：五个主题日，每一天是一个完整的 12 小时声音世界。同时 v1 的时段时间表被改写为更清爽的"四段制"——早段、午段、晚段、夜段，每段三小时，配合任何主题日都能严丝合缝。
        </p>
        <p class="text-right font-serif-en italic text-brass-mid text-sm">—— Hayden · 2026 春</p>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============== § II · 五条总原则 ============== -->
  <section id="ii" class="editorial-section">
    <div class="max-w-editorial-wide mx-auto">
      <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-3">
        <span class="text-brass-deep">II.</span> Five Governing Principles
      </p>
      <h2 class="text-3xl font-serif text-cream mb-paragraph tracking-cn">五条总原则</h2>

      <div class="grid md:grid-cols-2 gap-0 border border-brass-mid/20">
        {principles.map((p, i) => (
          <div
            class:list={[
              'p-6 border-brass-mid/20',
              i < principles.length - 1 && 'border-b',
              i % 2 === 0 && 'md:border-r',
              // 最后一个独占一行时需要重置
              i === principles.length - 1 && 'md:col-span-2',
            ]}
          >
            <div class="font-serif-en italic text-3xl text-brass-mid mb-2">{p.num}</div>
            <h3 class="font-serif text-lg text-cream mb-2 tracking-cn">{p.title}</h3>
            <p class="text-text-soft text-sm leading-[1.85] tracking-cn">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============== § III · 12 小时四段架构 ============== -->
  <section id="iii" class="editorial-section">
    <div class="max-w-editorial-wide mx-auto">
      <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-3">
        <span class="text-brass-deep">III.</span> The Four-Block Day
      </p>
      <h2 class="text-3xl font-serif text-cream mb-paragraph tracking-cn">12 小时四段时间架构</h2>

      <div class="prose-cn mb-paragraph">
        <p>
          v2 起，营业时间统一拆成四个三小时段。<strong>所有主题日都使用同一时间架构</strong>，差别只在内容。这让伙伴在做交接、做内容运营、做数据复盘时，有统一的时间坐标系。
        </p>
      </div>

      <div class="border-t border-b border-brass-mid">
        {blocks.map((b) => (
          <div class="grid grid-cols-[100px_1fr] md:grid-cols-[140px_1fr_180px] gap-4 py-5 border-b border-brass-mid/15 last:border-b-0">
            <div class="font-mono text-sm text-brass-deep">{b.time}</div>
            <div>
              <div class="font-serif text-cream tracking-cn">{b.name}</div>
              <div class="font-serif-en italic text-xs text-text-soft mt-1">{b.en}</div>
            </div>
            <div class="hidden md:block font-serif-en italic text-sm text-text-soft text-right">
              {b.mood}
            </div>
          </div>
        ))}
      </div>

      <p class="mt-paragraph text-sm text-text-soft tracking-cn">
        主歌《把山海带回家》仅在夜段最后 30 分钟（21:30 之后）出现，一天最多两次。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============== § IV–VIII · 5 个主题日 ============== -->
  {themeDays.map((day) => {
    const c = colorMap[day.color];
    return (
      <section id={day.key} class="editorial-section">
        <div class="max-w-editorial-wide mx-auto">
          <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-3">
            <span class="text-brass-deep">{day.index}.</span> Theme Day · {day.num} · {day.nameEn}
          </p>
          <h2 class="text-3xl font-serif text-cream mb-paragraph tracking-cn">
            主题日 · {day.name} <span class="font-serif-en italic text-brass-mid text-xl ml-2">/ {day.nameEn}</span>
          </h2>

          <article class="border border-brass-mid/20 bg-ink-elevated/30 relative overflow-hidden">
            <div class:list={['h-1.5 w-full', c.tape]}></div>
            <div class="p-6 md:p-10 relative">
              <div
                class:list={[
                  'absolute top-6 right-6 md:top-10 md:right-10',
                  'font-serif-en italic leading-none pointer-events-none select-none',
                  c.text,
                ]}
                style="font-size: clamp(56px, 8vw, 92px); opacity: 0.18; letter-spacing: -0.04em;"
              >
                {day.letter}
              </div>

              <h3 class:list={['font-serif text-2xl text-cream mb-2 tracking-cn']}>{day.name}</h3>
              <p class="font-serif-en italic text-text-soft mb-4">{day.subtitle}</p>
              <p class="text-text-soft text-sm leading-[1.85] tracking-cn max-w-[640px]">{day.concept}</p>

              <div class="flex flex-wrap gap-x-6 gap-y-2 mt-5 pt-5 border-t border-dashed border-brass-mid/30 font-mono text-xs text-text-soft">
                {day.meta.map((m) => (
                  <span><strong class:list={[c.text, 'font-medium']}>{m.split(' ')[0]}</strong> {m.split(' ').slice(1).join(' ')}</span>
                ))}
              </div>
            </div>

            <!-- 4 段 blocks 用 details 折叠 · 默认折叠避免歌单堆砌感 -->
            <details class="border-t border-brass-mid/20">
              <summary class:list={[
                'cursor-pointer list-none px-6 md:px-10 py-4',
                'flex items-center justify-between gap-3',
                'font-serif-en italic text-sm text-text-soft hover:text-brass-mid transition-colors',
                'select-none',
              ]}>
                <span class="summary-label-closed">展开完整 48 首曲目清单（4 段 × 12 首）</span>
                <span class="summary-label-open">收起完整曲目清单</span>
                <span class="text-xs opacity-60 shrink-0">
                  <span class="summary-label-closed">▼ Click to expand</span>
                  <span class="summary-label-open">▲ Click to collapse</span>
                </span>
              </summary>

              <div class="grid md:grid-cols-2 border-t border-brass-mid/20">
                {day.blocks.map((blk, bi) => (
                  <div
                    class:list={[
                      'p-6 md:p-8 border-brass-mid/15',
                      bi % 2 === 0 && 'md:border-r',
                      bi < day.blocks.length - 2 && 'border-b',
                      bi === day.blocks.length - 2 && 'md:border-b',
                      bi === day.blocks.length - 2 && 'border-b md:border-b-0',
                    ]}
                  >
                    <div class:list={['font-mono text-xs mb-1.5 font-medium', c.text]}>{blk.time}</div>
                    <div class="font-serif text-cream tracking-cn mb-1">{blk.title}</div>
                    <div class="font-serif-en italic text-xs text-text-soft mb-4 pb-3 border-b border-brass-mid/15">{blk.en}</div>
                    <ol class="space-y-2">
                      {blk.tracks.map((t, ti) => (
                        <li class="flex items-baseline gap-3 text-xs border-b border-brass-mid/10 pb-2 last:border-b-0">
                          <span class:list={['font-mono opacity-60 w-5 shrink-0', c.text]}>{String(ti + 1).padStart(2, '0')}</span>
                          <span class="flex-1">
                            <span class="text-cream">{t.ttl}</span>
                            <span class="block font-serif-en italic text-text-soft mt-0.5">{t.art}</span>
                          </span>
                        </li>
                      ))}
                    </ol>
                  </div>
                ))}
              </div>
            </details>
          </article>
        </div>
      </section>
    );
  })}

  <hr class="brass-divider" />

  <!-- ============== § IX · 一周轮换 + 平台部署 + 维护节奏 ============== -->
  <section id="ix" class="editorial-section">
    <div class="max-w-editorial-wide mx-auto">
      <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-3">
        <span class="text-brass-deep">IX.</span> Playback & Platform Setup
      </p>
      <h2 class="text-3xl font-serif text-cream mb-paragraph tracking-cn">12 小时一键播放方案</h2>

      <div class="prose-cn mb-paragraph">
        <p>
          所有五个主题日都按相同结构组织——四段三小时。这意味着<strong>每个主题日可以制作成一个 12 小时长歌单</strong>，按播放顺序排列后，开店时点开播放，即可走完一整天。
        </p>
      </div>

      <!-- 一周轮换 -->
      <div class="p-8 border border-brass-mid/20 bg-ink-elevated/30 mb-8">
        <p class="font-serif-en italic text-brass-deep text-xs tracking-widest uppercase mb-2">
          Weekly Schedule · 周播放计划建议
        </p>
        <h3 class="font-serif text-xl text-cream mb-3 tracking-cn">一周七天的主题日轮换</h3>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn mb-5">
          把五个主题日合理分布在一周中，避免同一主题日连续两天出现。东北冬季漫长时，可适当增加纪录片日和植物日的占比；春夏旺季加重动物日和海洋日。
        </p>

        <div class="grid grid-cols-7 gap-px bg-brass-mid/20 border border-brass-mid/20">
          {weekSchedule.map((d) => {
            const c = colorMap[d.color as keyof typeof colorMap];
            return (
              <div class="bg-ink-elevated p-3 text-center">
                <div class="font-serif-en italic text-[10px] tracking-widest uppercase text-text-soft mb-2">
                  {d.dow}
                </div>
                <div class:list={['font-serif text-sm mb-2 tracking-cn', c.text]}>{d.day}</div>
                <div
                  class:list={[
                    'inline-block px-2 py-0.5 text-[9px] font-mono tracking-wider uppercase border border-brass-mid/30',
                    c.text,
                  ]}
                >
                  {d.en}
                </div>
              </div>
            );
          })}
        </div>

        <p class="mt-4 text-xs text-text-soft tracking-cn">
          这只是一种参考排法。建议每月由主理人复盘一次，根据实际客流、伙伴反馈、节气调整。新品上市或品牌主题日另行配置。
        </p>
      </div>

      <!-- 平台部署 -->
      <div class="p-8 border border-brass-mid/20 bg-ink-elevated/30 mb-8">
        <p class="font-serif-en italic text-brass-deep text-xs tracking-widest uppercase mb-2">
          Platform Setup · 平台部署
        </p>
        <h3 class="font-serif text-xl text-cream mb-3 tracking-cn">三个平台的歌单建议</h3>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn mb-5">
          每个主题日在每个平台上做一份对应歌单，命名遵守统一格式：
          <code class="font-mono bg-brass-mid/10 px-2 py-0.5 text-xs text-brass-mid">山海造物 · [主题日名] · 12hr</code>。
        </p>

        <div class="grid md:grid-cols-3 gap-4">
          <div class="p-5 border border-brass-mid/15 bg-ink-elevated/50">
            <h4 class="font-serif text-base text-cream mb-2 tracking-cn">网易云音乐</h4>
            <p class="text-text-soft text-xs leading-[1.7] tracking-cn">
              国内主力平台。所有曲目命中率最高（含中文民族音乐和林海等本土艺术家）。建议作为首选。设置"心动模式"关闭、"私人 FM"关闭，纯顺序播放。
            </p>
          </div>
          <div class="p-5 border border-brass-mid/15 bg-ink-elevated/50">
            <h4 class="font-serif text-base text-cream mb-2 tracking-cn">Apple Music</h4>
            <p class="text-text-soft text-xs leading-[1.7] tracking-cn">
              国际作品最完整（BBC 系列、Sigur Rós、Hans Zimmer 全集）。建议作为备份。需要美区账号才能播放部分纪录片配乐专辑。
            </p>
          </div>
          <div class="p-5 border border-brass-mid/15 bg-ink-elevated/50">
            <h4 class="font-serif text-base text-cream mb-2 tracking-cn">YouTube Premium</h4>
            <p class="text-text-soft text-xs leading-[1.7] tracking-cn">
              真实自然录音、BBC Earth 现场录音的来源。也是制作"门店音乐视频"的素材库（投影时可作为视觉 + 听觉双输出）。
            </p>
          </div>
        </div>
      </div>

      <!-- 维护节奏 -->
      <div class="p-8 border border-brass-mid/20 bg-ink-elevated/30">
        <p class="font-serif-en italic text-brass-deep text-xs tracking-widest uppercase mb-2">
          Curator Schedule · 维护节奏
        </p>
        <h3 class="font-serif text-xl text-cream mb-3 tracking-cn">歌单的活水机制</h3>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn mb-4">
          歌单不是一次性产物，是活的。建议如下维护节奏：
        </p>

        <ol class="space-y-4">
          <li class="grid grid-cols-[40px_1fr] gap-4 pb-4 border-b border-brass-mid/15">
            <span class="font-serif-en italic text-2xl text-brass-mid leading-none">01</span>
            <div>
              <strong class="block font-serif text-cream tracking-cn mb-1">每月加新</strong>
              <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
                每个主题日每月新增 2–3 首歌（替换掉感觉"听腻了"的曲目），保持新鲜感。新增曲必须通过内容守则审查。
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[40px_1fr] gap-4 pb-4 border-b border-brass-mid/15">
            <span class="font-serif-en italic text-2xl text-brass-mid leading-none">02</span>
            <div>
              <strong class="block font-serif text-cream tracking-cn mb-1">季度大盘点</strong>
              <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
                每季度（春夏秋冬）做一次完整复盘：哪些曲目伙伴反馈好、哪些客人问得多、哪些应该下架。本手册每季度更新一版小修订（v2.1、v2.2…）。
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[40px_1fr] gap-4">
            <span class="font-serif-en italic text-2xl text-brass-mid leading-none">03</span>
            <div>
              <strong class="block font-serif text-cream tracking-cn mb-1">年度大改版</strong>
              <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
                每年做一次大改版（v3、v4…），可能引入新主题日（比如"沙漠日""极地日""城市日"）。这是品牌 IP 系统延展的重要机会。
              </p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============== § X · 内容守则 ============== -->
  <section id="x" class="editorial-section">
    <div class="max-w-editorial-wide mx-auto">
      <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-3">
        <span class="text-brass-deep">X.</span> Content Rules — Updated for v2
      </p>
      <h2 class="text-3xl font-serif text-cream mb-paragraph tracking-cn">音乐内容守则</h2>

      <div class="prose-cn mb-paragraph">
        <p>v2 在 v1 六条守则的基础上扩充至七条，新增的是关于主题日切换和器乐优先的明确规则。</p>
      </div>

      <ol class="space-y-0 border-t border-brass-mid/20">
        {rules.map((r, i) => (
          <li class="grid grid-cols-[48px_1fr] md:grid-cols-[64px_1fr] gap-3 md:gap-5 py-5 border-b border-brass-mid/15">
            <span class="font-serif-en italic text-2xl text-brass-mid leading-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <strong class="block font-serif text-cream tracking-cn mb-1.5">{r.title}</strong>
              <p class="text-text-soft text-sm leading-[1.85] tracking-cn">{r.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============== § XI · 特殊情境 ============== -->
  <section id="xi" class="editorial-section">
    <div class="max-w-editorial-wide mx-auto pt-section pb-section border-t-2 border-b-2 border-brass-mid/40">
      <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-3">
        <span class="text-brass-deep">XI.</span> Appendix · Special Situations
      </p>
      <h2 class="text-3xl font-serif text-cream mb-paragraph tracking-cn">特殊情境补充</h2>

      <div class="grid md:grid-cols-3 gap-6 mt-paragraph">
        {special.map((s) => (
          <div class="p-5 border border-brass-mid/15 bg-ink-elevated/30">
            <h4 class="font-serif text-base text-cream mb-1 tracking-cn">{s.name}</h4>
            <small class="block font-serif-en italic text-text-soft text-xs mb-3">{s.sub}</small>
            <p class="text-text-soft text-xs leading-[1.75] tracking-cn">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== 收束 PullQuote ============== -->
  <PullQuote
    quote="把声音设计写进 SOP 是反直觉的——大多数零售店懒得做。但店里的声音是你离开后大脑会自动回放的东西。"
    cite="《五感》· 听 · Sound"
  />

  <!-- ============== Colophon ============== -->
  <section class="editorial-section pb-section">
    <div class="max-w-editorial mx-auto text-center pt-paragraph border-t border-brass-mid/15">
      <p class="font-serif text-2xl text-brass-mid tracking-[0.5em] mb-3">山 川 造 物</p>
      <p class="font-serif-en italic text-text-soft text-sm leading-[1.85]">
        Sound Manual v2 · 软公开版<br/>
        Curated by Hayden · Issued Spring 2026<br/>
        240 tracks across 5 theme days<br/>
        <em class="text-brass-mid">把山海带回家</em>
      </p>
    </div>
  </section>

  <ContactBlock />
</Layout>

