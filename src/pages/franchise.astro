---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import WIPNotice from '../components/WIPNotice.astro';
---

<Layout
  title="加盟咨询"
  description="一座城一位合伙人 · 不是连锁，是城邦"
>
  <PageHero
    eyebrow="City Partners · 城市合伙人"
    title="一座城<br />一位合伙人"
    lead="我们不做加盟连锁——我们做城市合伙人。每座城只有一位，他/她是这座城里「山川造物」的代言人，与我们共同经营一家属于这座城的店。"
  />

  <hr class="brass-divider" />

  {/* ============== 数字化能力亮点（v0.1 即可对外的承诺）============== */}
  <section class="editorial-section py-section fade-in">
    <div class="p-8 md:p-12 border border-brass-mid/30 bg-ink-elevated/50">
      <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-3">
        Plug-and-Play · 你不需要自建任何数字化系统
      </p>
      <h2 class="font-serif text-2xl md:text-3xl text-cream tracking-cn mb-4">
        开箱即用的数字化能力<br class="md:hidden" />已为你准备好
      </h2>
      <p class="prose-cn text-text-soft mb-6">
        城市合伙人最大的负担——小程序、会员体系、库存管理、数据报表、AI 助手——我们已经全部建好。新店开业当天，所有数字化能力<strong class="text-cream">开店即上线</strong>，所有数据自动汇入中央 ERP。AI 智能中心为每家门店提供定价建议、补货预警、销售预测，<strong class="text-cream">大幅降低经营决策门槛</strong>。
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="text-center p-4 bg-ink-deep/40">
          <p class="font-serif-en italic text-brass-bright text-2xl">30+</p>
          <p class="text-xs text-text-soft tracking-cn mt-1">小程序页面</p>
        </div>
        <div class="text-center p-4 bg-ink-deep/40">
          <p class="font-serif-en italic text-brass-bright text-2xl">27</p>
          <p class="text-xs text-text-soft tracking-cn mt-1">ERP 模块</p>
        </div>
        <div class="text-center p-4 bg-ink-deep/40">
          <p class="font-serif-en italic text-brass-bright text-2xl">17</p>
          <p class="text-xs text-text-soft tracking-cn mt-1">AI 场景</p>
        </div>
        <div class="text-center p-4 bg-ink-deep/40">
          <p class="font-serif-en italic text-brass-bright text-2xl">¥0</p>
          <p class="text-xs text-text-soft tracking-cn mt-1">技术建设成本</p>
        </div>
      </div>
      <a
        href="/digital-ops"
        class="inline-flex items-center gap-3 border border-brass-mid/60 px-6 py-3 text-brass-mid hover:bg-brass-mid hover:text-ink transition-colors tracking-cn"
      >
        <span>查看完整能力清单</span>
        <span class="font-serif-en italic">/digital-ops →</span>
      </a>
    </div>
  </section>

  <WIPNotice
    topic="城市合伙人 · 选拔机制 / 利益结构 / 共同决策范围 / 申请入口"
    expectedVersion="v0.3"
  />
</Layout>
