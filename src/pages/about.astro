---
import Layout from '../components/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Principle from '../components/Principle.astro';
import PullQuote from '../components/PullQuote.astro';

const principles = [
  {
    number: 'I',
    title: '不装的规模化',
    description:
      '不为追求规模而牺牲品牌核心，不为追求规模而装高深、装稀缺；也不因为坚持品质而拒绝规模化（不做"小确幸式自我满足"）。中道——既扩张又克制。',
    practices: [
      '加盟开放但门槛严',
      '价格中位数定位',
      '内容输出有标准',
    ],
  },
  {
    number: 'II',
    title: 'Vision 51% : 利益 49%',
    description:
      '任何商业决策中，"是否贡献 Vision"权重 51%，"是否带来利润"权重 49%。51 vs 49 不是 50/50，是 Vision 微弱占优。',
    practices: [
      '接合作时优先看是否符合 Vision，再看赚不赚钱',
      '招人时先看是否认同 Vision，再看专业能力',
      'KPI 设计：店长考核必须包含 Vision 维度',
    ],
  },
  {
    number: 'III',
    title: '多 format 而非单一店型',
    description:
      '不追求一种"完美店型"复制 100 家，接受不同场景需要不同 format。format 之间共享 DNA，但允许独立演化。',
    practices: [
      'Lite / Pro / Max 三档场景化定位',
      '每个 format 都有自己的"非拍照价值"七件套',
      '加盟方根据物业 / 客群 / 城市选档',
    ],
  },
  {
    number: 'IV',
    title: '「非拍照价值」永远先于「拍照价值」',
    description:
      '山川造物天然上镜，进入网红打卡热潮是大概率事件。但颜值是入口，不是商业模型。必须 Day 1 就有"非拍照价值"七件套。',
    practices: [
      '每一家新店开业前必须把七件套的初版跑起来',
      '永远不接"纯网红打卡店"性质的商场招商邀请',
    ],
  },
  {
    number: 'V',
    title: '失败的容许 + 自我感动的警惕',
    description:
      '容许新尝试失败，但同时警惕"被自己感动"的产物。失败 + 验证机制 = 真正的成长。',
    practices: [
      '每份新文档附带"自我感动检查"标签',
      '季度做一次 v0.x 验证 review',
      '重要决策低容错，新尝试高容错',
    ],
  },
  {
    number: 'VI',
    title: '公共承诺与 1% 营收',
    description:
      '每一家直营店与加盟店每年营业收入的 1% 无条件捐赠给环保 / 自然博物 / 野生动植物保护 / 护林员相关公益。每一家店同时承担作为城市公共客厅的基础公共服务（AED、应急充电、应急雨伞、饮用水等）。山川造物的店不只是商业空间，是城市公共生活的一部分。',
    practices: [
      '1% 营收捐赠（不是利润）',
      '门店即博物馆 + 门店即公共客厅',
      'AED / 应急充电 / 应急雨伞 / 饮用水',
      '一线护林员 / 巡护员定向支持',
      '妈妈的饺子 A 套餐',
    ],
  },
];
---

<Layout
  title="我们是谁"
  description="山川造物 · 一个自然博物美学品牌的起源、哲学与价值观"
>
  <SectionHeader
    eyebrow="About · 我们是谁"
    title={`两个东北人，\n一个 30 年事业`}
    intro="山川造物是李贺与廉澍 2024 年共同创办的自然博物美学品牌。第一家店在长春的这有山，标本工作室 2026 年夏开业。"
  />

  <hr class="brass-divider" />

  <!-- ============ I. 创始团队 ============ -->
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">I</p>
    <h2 class="section-title text-cream">创始团队</h2>

    <div class="grid md:grid-cols-2 gap-10 mt-paragraph">
      <article>
        <figure class="aspect-[4/5] mb-6 bg-gradient-to-br from-ink-deep to-ink-elevated border border-brass-mid/20 flex items-center justify-center">
          <span class="font-serif-en italic text-brass-mid/40 text-2xl">Hayden Li</span>
          {/* 真实素材：<img src="/images/founders/lihe.jpg" alt="李贺" class="w-full h-full object-cover" /> */}
        </figure>
        <h3 class="font-serif text-2xl text-cream mb-1 tracking-cn">李贺</h3>
        <p class="font-serif-en italic text-brass-mid text-sm mb-4">Co-founder</p>
        <div class="prose-cn space-y-paragraph">
          <p>1992 年生于东北。互联网行业背景——优酷、支付宝、B 站。</p>
          <p>主导品牌叙事、IP 体系、空间规划、内容输出、资本结构。</p>
          <p class="text-text-soft text-sm">
            他不反感互联网的速度，但他知道<strong class="text-cream">那种速度并不适合所有事情</strong>。做一家自然博物美学的店，是不适合那种速度的。
          </p>
        </div>
      </article>

      <article>
        <figure class="aspect-[4/5] mb-6 border border-brass-mid/20 overflow-hidden bg-ink-elevated">
          <img
            src="/images/founders/lianshu.png"
            alt="廉澍 · 山川造物联合创始人"
            width="900"
            height="1125"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </figure>
        <h3 class="font-serif text-2xl text-cream mb-1 tracking-cn">廉澍</h3>
        <p class="font-serif-en italic text-brass-mid text-sm mb-4">Co-founder</p>
        <div class="prose-cn space-y-paragraph">
          <p>东北人。标本工艺与工坊运营主导。</p>
          <p>主导生产体系、品控、本地交付、加盟落地。</p>
          <p class="text-text-soft text-sm">
            他干这件事的方式更像一个手艺人——耐得住性子，钻得进细节，不被外面的喧嚣打扰。如果说李贺负责系统架构，<strong class="text-cream">他负责物质生产</strong>。
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- ============ II. 我们为什么做这件事 ============ -->
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">II</p>
    <h2 class="section-title text-cream">我们为什么做这件事</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        我们做的不是"标本店"。如果只是"卖标本"，这件事其实早就有人在做。
      </p>
      <p>
        我们做的是别的——<strong class="text-brass-bright">把一种叫自然博物美学的东西，让它进入日常生活</strong>。
      </p>
      <p>
        什么是自然博物美学？说人话——就是十九世纪英国维多利亚时代那些博物学家收集的、整理的、命名的、放在玻璃柜里被一代代人凝视的那种东西。一只蝴蝶。一块矿石。一颗果实。一片羽毛。它们本来不是为了"美"而存在，但它们经过收集、保存、整理之后，变成了可以被欣赏的对象。
      </p>
      <p>
        我们相信这种美学在今天的中国仍然成立。但它当下还没有一个像样的载体——所以我们想成为那个载体。
      </p>
    </div>

    <PullQuote
      quote="把山川带回家——这句话不是 slogan，是我们对你做出的具体承诺：你买回家的东西，会让你和自然之间多一根线索。"
    />
  </section>

  <hr class="brass-divider" />

  <!-- ============ III. 6 战略原则 ============ -->
  <section class="editorial-section-wide fade-in">
    <p class="section-number mb-4">III</p>
    <h2 class="section-title text-cream">我们的 6 战略原则</h2>

    <p class="prose-cn mb-section max-w-editorial">
      这 6 条不是营销 slogan，是<strong class="text-brass-bright">经营决策的第一原则</strong>。任何具体动作过这 6 条滤镜——是否贡献 Vision、是否触及不做清单、是否带来合理回报。
    </p>

    <div class="border-t border-brass-mid/15">
      {principles.map((p) => (
        <Principle
          number={p.number}
          title={p.title}
          description={p.description}
          practices={p.practices}
        />
      ))}
    </div>

    <p class="prose-cn mt-section text-text-soft text-sm">
      6 战略原则之下还有 <strong class="text-cream">6 个二级"观"</strong>——空间观 / 承诺观 / 青年观 / 科技观 / 内容观 / 人才观。
      <br />完整体系 → <a href="/values" class="text-brass-mid hover:text-brass-bright">/values</a>
    </p>
  </section>

  <hr class="brass-divider" />

  <!-- ============ IV. 30 年愿景 ============ -->
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">IV</p>
    <h2 class="section-title text-cream">30 年愿景</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        我们做这件事的时间表是 <strong class="text-brass-bright">30 年</strong>——而不是 5 年。
      </p>
      <p>
        到 2036 年（10 年），山川造物应当是 30+ 家直营店 + 加盟店、3-5 个子品牌、稳定的认证店长体系，与 5-10 家自然博物馆 / 国家公园 / 自然教育机构有稳定合作；累计向自然保护方向捐赠超过 1000 万元。
      </p>
      <p>
        到 2056 年（30 年），山川造物应当成为<strong class="text-cream">中国当代自然博物美学的代表品牌之一</strong>，进入"百年老铺"早期阶段；累计捐赠超过 1 亿元。
      </p>
    </div>

    <PullQuote
      quote="我和廉澍今年都三十多岁。如果一切顺利，我们会用未来 30 年做这件事。三十多年后，如果有一个城市的少年因为某天偶然进了我们的店、看到一只蝴蝶、回家的那个晚上对自然多了一点点好奇——我们就算赢了。"
    />
  </section>
</Layout>
