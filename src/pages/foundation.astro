---
import Layout from '../components/Layout.astro';
import PledgeBlock from '../components/PledgeBlock.astro';
import ContactBlock from '../components/ContactBlock.astro';
import PullQuote from '../components/PullQuote.astro';
import ViewBlock from '../components/ViewBlock.astro';
import ViewListItem from '../components/ViewListItem.astro';
import ViewTransition from '../components/ViewTransition.astro';
import SixViewsPyramid from '../components/SixViewsPyramid.astro';
import PledgeComplianceCompare from '../components/PledgeComplianceCompare.astro';
import { foundationViews, foundationViewTransitions } from '../data/foundationSixViews';

const recipients = [
  {
    name: '国家公园建设',
    detail:
      '通过中国国家公园基金会等合规渠道，支持东北虎豹国家公园、大熊猫国家公园等的基础建设与保护。',
  },
  {
    name: '自然博物馆',
    detail:
      '支持国家自然博物馆、重庆自然博物馆、浙江自然博物院、沈阳古生物博物馆等的科普 / 收藏 / 文创工作。',
  },
  {
    name: '野生动植物保护 NGO',
    detail:
      '山水自然保护中心、桃花源生态保护基金会、猫盟 CFCA、自然之友等合规公益组织。',
  },
  {
    name: '护林员 / 巡护员群体',
    detail:
      '通过上述 NGO 定向支持一线巡护工作者——他们是真实生态的守门人，但收入与工作强度严重不匹配。',
  },
];

const nonRecipients = [
  {
    name: '不捐给"明星公益"项目',
    detail: '单个艺人 / 名人发起的项目，受益对象不明确、可信度低。',
  },
  {
    name: '不捐给受益对象不明的"环保概念基金"',
    detail: '只有概念没有具体落地动作的项目，不在我们的捐赠范围。',
  },
  {
    name: '不捐给与山海造物自有 IP 关联的洗白型项目',
    detail: '绝对不会有"为马上有 IP 设立的环保基金"——这是利益输送，不是公益。',
  },
  {
    name: '不捐给政治敏感方向',
    detail: '保持公益的纯粹性。',
  },
];

---

<Layout
  title="价值底座 · Foundation"
  description="六观体系与 1% 承诺——山海造物做这件事的根本立场与不可触碰的边界"
>
  <!-- §1 · Hero -->
  <section class="editorial-section py-section md:py-24 px-6 text-center fade-in max-w-editorial mx-auto">
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">Foundation · 价值底座</p>
    <h1 class="font-serif text-display text-cream tracking-cn mb-4">价值底座</h1>
    <p class="text-base md:text-lg text-text-soft mb-12 tracking-cn">我们做这件事的根本立场</p>
    <div class="max-w-2xl mx-auto text-base md:text-lg leading-relaxed text-cream tracking-cn space-y-2">
      <p>六观，是我们做这件事时不会改变的六件事。</p>
      <p>它们不是宣传话术——</p>
      <p>而是会被违反时拒绝的事。</p>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- §2 · 关于六观 + 六观一览 -->
  <section class="editorial-section py-section fade-in max-w-editorial mx-auto px-6">
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-4">About the Six Views · 关于六观</p>
    <div class="prose-cn space-y-paragraph text-text-soft mb-10">
      <p>
        「观」是我们对世界的看法。六观，是我们做这件事时<strong class="text-cream">不会改变的六件事</strong>。它们不是宣传话术，而是<strong class="text-brass-bright">会被违反时拒绝的事</strong>。如果某天我们写不出这六观的具体动作，那一刻就是品牌死亡的时刻。
      </p>
      <p class="text-sm text-cream/90 leading-relaxed">
        每一观由<strong class="text-cream">一句话标题</strong>、<strong class="text-cream">三段展开</strong>、<strong class="text-cream">「我们不做什么」</strong>、<strong class="text-cream">具体动作</strong>与<strong class="text-cream">一句话作结</strong>构成。科技如何落地见
        <a href="/how/tech" class="text-brass-mid hover:text-brass-bright border-b border-brass-mid/40">/how/tech</a>。
      </p>
    </div>

    <h2 class="font-serif text-2xl md:text-3xl text-cream tracking-cn mb-6">六观一览</h2>
    <div class="mb-10">
      <ViewListItem number="1" title="自然观" subtitle="我们如何看待自然" href="#nature" />
      <ViewListItem number="2" title="空间观" subtitle="我们如何理解空间" href="#view-space" />
      <ViewListItem number="3" title="内容观" subtitle="我们如何表达" href="#content" />
      <ViewListItem number="4" title="人才观" subtitle="我们如何对待人" href="#talent" />
      <ViewListItem number="5" title="承诺观" subtitle="我们对外承担什么" href="#pledge-view" />
      <ViewListItem number="6" title="合规观" subtitle="我们不能做什么" highlight="coral" href="#view-compliance" />
    </div>
    <p class="text-base text-text-soft leading-relaxed tracking-cn">
      六观由下至上构建——<br />
      自然观是根本立场，合规观是品牌边界。<br />
      请逐观阅读，每一观都有 5 个段落，覆盖立场、反例、具体动作。
    </p>
  </section>

  <hr class="brass-divider" />

  <!-- §3 · 六观主体 -->
  {
    foundationViews.map((view, i) => {
      const { afterBlock, ...blockProps } = view;
      return (
        <>
          <ViewBlock {...blockProps} />
          {afterBlock ? <div class="editorial-section max-w-editorial mx-auto px-6" set:html={afterBlock} /> : null}
          {i < foundationViews.length - 1 ? <ViewTransition {...foundationViewTransitions[i]} /> : null}
        </>
      );
    })
  }

  <hr class="brass-divider" />

  <!-- §4 · 六观关系金字塔 -->
  <section class="editorial-section py-section fade-in px-6" id="six-views-pyramid">
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3 text-center">Structure · 六观之间的关系</p>
    <h2 class="font-serif text-display text-cream text-center mb-4 tracking-cn">六观之间的关系</h2>
    <p class="text-text-soft text-center max-w-xl mx-auto mb-12 leading-relaxed tracking-cn">
      六观不是并列的——<br />
      它们之间有层级，构成一个完整的结构。
    </p>
    <SixViewsPyramid />
    <div class="prose-cn max-w-editorial mx-auto mt-section space-y-paragraph text-text-soft text-sm leading-relaxed">
      <p class="font-serif text-cream text-base tracking-cn">金字塔的结构含义：</p>
      <ul class="list-disc pl-5 space-y-2">
        <li><strong class="text-cream">自然观</strong>是根 —— 一切从这里出发</li>
        <li><strong class="text-cream">空间观与内容观</strong>是表达层 —— 一对内、一对外</li>
        <li><strong class="text-cream">人才观</strong>是组织层 —— 决定谁来做这件事</li>
        <li><strong class="text-cream">承诺观</strong>是责任层 —— 决定我们额外承担什么</li>
        <li><strong class="text-coral-mid">合规观</strong>是边界层 —— 决定我们不能做什么</li>
      </ul>
      <p>
        合规观放在金字塔的最顶端不是因为最重要 —— 重要性上六观平等。是因为它是边界。其他观可以「做得更好或更差」，合规观只能「做到或没做到」。没有中间地带。触碰红线 → 其他五观全部失效。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- §5 · 承诺观 vs 合规观 -->
  <section class="editorial-section py-section fade-in px-6">
    <div class="max-w-3xl mx-auto text-center mb-8">
      <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">Boundary · 边界对照</p>
      <h2 class="font-serif text-display text-cream tracking-cn mb-4">承诺观与合规观 · 边界对照</h2>
      <p class="text-text-soft leading-relaxed tracking-cn">这两观看似相近 · 本质不同 · 两者都不能少。</p>
    </div>
    <PledgeComplianceCompare />
  </section>

  <hr class="brass-divider" />

  <!-- §6 · 1% 承诺独立强调 -->
  <section
    id="pledge-1pct-spotlight"
    class="editorial-section py-section md:py-24 px-6 text-center fade-in border-y border-brass-mid/15 bg-brass-mid/[0.06]"
  >
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-2">Our pledge · 1% · 我们的承诺</p>
    <div class="my-8">
      <span class="font-serif-en text-brass-bright block mb-2" style="font-size: clamp(4.5rem, 14vw, 7.5rem); line-height: 0.95; letter-spacing: -0.03em;">1%</span>
      <p class="text-sm text-text-soft italic tracking-cn">每家城市门店年营收</p>
    </div>
    <div class="text-lg md:text-xl text-cream leading-relaxed mb-8 max-w-2xl mx-auto tracking-cn space-y-2">
      <p>捐赠给本地动物园或动植物保护基金</p>
      <p>用于动物权益保护</p>
    </div>
    <hr class="border-brass-mid/25 my-8 max-w-md mx-auto" />
    <p class="text-sm text-text-soft leading-relaxed mb-2 tracking-cn">不是营销手段。</p>
    <p class="text-sm text-text-soft leading-relaxed mb-6 tracking-cn">是写进所有对外文件的底线。</p>
    <p class="text-xs font-serif-en text-brass-mid tracking-wide mb-8">第一份《1% 承诺年度透明报告》将于 2027 年 4 月发布。</p>
    <a
      href="#one-percent"
      class="inline-block text-sm text-brass-mid hover:text-brass-bright border border-brass-mid/40 px-5 py-2 rounded-sm tracking-cn transition-colors"
    >
      查看承诺细则
    </a>
  </section>

  <hr class="brass-divider" />

  <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase text-center mb-6">
    Pledge · 1% 承诺（执行全文）
  </p>
  <!-- ============ Hero · 大字 1% ============ -->
  <section id="one-percent" class="editorial-section pt-section text-center">
    <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-6 fade-in">
      Our Pledge · 1% 承诺
    </p>

    <div
      class="font-serif-en text-brass-bright fade-in"
      style="font-size: clamp(8rem, 20vw, 16rem); line-height: 0.9; letter-spacing: -0.04em;"
    >
      1<span class="text-brass-mid">%</span>
    </div>

    <p class="display-title text-cream mt-section fade-in">
      让自然博物美学进入日常生活，<br />
      这件事不能只发生在我们的店里。
    </p>

    <div class="prose-cn max-w-editorial mx-auto mt-section text-text-soft fade-in">
      <p>
        如果我们做的事情没有让真实的山川更好——那么我们的店里再美的标本，也只是标本而已。
      </p>
      <p>所以从第一家店开始，我们做了一个具体承诺。</p>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ 1% 营收 不是 1% 利润 ============ -->
  <section class="editorial-section fade-in">
    <h2 class="section-title text-cream">1% 营收 · 不是 1% 利润</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        每一家山海造物直营店与加盟店，每年<strong class="text-brass-bright">营业收入</strong>的 <strong class="text-brass-bright">1%</strong>，无条件捐赠给环保 / 自然博物 / 野生动植物保护 / 护林员相关公益方向。
      </p>
      <p>
        我们承诺的是 1% <strong class="text-cream">营收</strong>——不是 1% 利润。
      </p>
      <p>为什么这个区别重要？</p>
      <p>
        利润可以通过会计技术调整，营收不可以。<strong class="text-brass-bright">营收承诺意味着——无论盈亏，履行都不变</strong>。
      </p>
      <p class="text-text-soft text-sm">
        这个标准来自 1% for the Planet（Patagonia 创始人 Yvon Chouinard 2002 年发起的全球承诺组织）。我们采用同样的标准。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ 捐给谁 ============ -->
  <section class="editorial-section-wide fade-in">
    <h2 class="section-title text-cream">捐给谁</h2>

    <p class="prose-cn mb-section max-w-editorial">
      每年从以下四个方向中选择 2-4 个分配捐赠：
    </p>

    <PledgeBlock
      title="四个捐赠方向"
      subtitle="Recipients"
      items={recipients}
    />
  </section>

  <!-- ============ 不捐给谁 ============ -->
  <section class="editorial-section-wide fade-in">
    <h2 class="section-title text-cream">绝不捐给谁</h2>

    <p class="prose-cn mb-section max-w-editorial">
      我们对这件事有同样清晰的红线：
    </p>

    <PledgeBlock
      title="四条红线"
      subtitle="Non-recipients"
      items={nonRecipients}
      variant="negative"
    />
  </section>

  <hr class="brass-divider" />

  <!-- ============ 这笔钱有多大 · 它能做什么 ============ -->
  <section class="editorial-section fade-in">
    <h2 class="section-title text-cream">这笔钱有多大 · 它能做什么</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        我们做了一个保守估算：到 2028 年 6 家直营 + 加盟店，年总营收约 <strong class="text-brass-bright">6000 万</strong>。
      </p>
      <p>
        1% = <strong class="text-brass-bright">60 万 / 年</strong>。这个数字不大——但在自然保护一线，它意味着具体的事：
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-4 mt-paragraph">
      <article class="p-6 border border-brass-mid/20 bg-ink-elevated/40">
        <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-2">
          Equivalent · 等同于
        </p>
        <p class="text-cream font-serif text-lg tracking-cn mb-2">
          <strong class="text-brass-bright">8 – 10 名</strong>全职护林员一年的工资
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          按一线护林员年薪 6 – 8 万计算。他们是真实生态的守门人，但收入与工作强度严重不匹配。
        </p>
      </article>

      <article class="p-6 border border-brass-mid/20 bg-ink-elevated/40">
        <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-2">
          Equivalent · 等同于
        </p>
        <p class="text-cream font-serif text-lg tracking-cn mb-2">
          一次<strong class="text-brass-bright">小型自然博物馆特展</strong>的预算
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          可以让一个城市的孩子第一次近距离看到来自国家公园的标本与影像。
        </p>
      </article>

      <article class="p-6 border border-brass-mid/20 bg-ink-elevated/40">
        <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-2">
          Equivalent · 等同于
        </p>
        <p class="text-cream font-serif text-lg tracking-cn mb-2">
          一个 NGO <strong class="text-brass-bright">一线项目</strong>的年度核心支持
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          山水自然保护中心 / 桃花源 / 猫盟级别的合规公益组织，一个完整年度的项目预算。
        </p>
      </article>

      <article class="p-6 border border-brass-deep/30 bg-ink-deep/30">
        <p class="font-serif-en italic text-brass-deep text-xs tracking-widest uppercase mb-2">
          Hard Cost · 不是营销
        </p>
        <p class="text-cream font-serif text-lg tracking-cn mb-2">
          这不是营销预算，是<strong class="text-brass-deep">品牌承诺的硬成本</strong>
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          它必须写进损益表的"公益捐赠"栏，<strong class="text-cream">被审计、被披露、被铭记</strong>。
        </p>
      </article>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ 透明 ============ -->
  <section class="editorial-section fade-in">
    <h2 class="section-title text-cream">透明</h2>

    <p class="prose-cn">
      每年 4 月（环保月），我们公开发布<strong class="text-brass-bright">《山海造物 · 1% 承诺年度透明报告》</strong>，包含：
    </p>

    <ul class="prose-cn list-none pl-0 mt-paragraph space-y-2">
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        上一年度全部直营 + 加盟店营业总收入
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        1% 捐赠总金额
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        具体受益机构 / 项目
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        第三方审计意见
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        加盟方汇缴情况
      </li>
    </ul>

    <p class="prose-cn mt-paragraph">
      报告同时发布于公众号、本网站、加盟方内部。任何人都可以申请查看捐赠流水的脱敏版本。
    </p>

    <div class="mt-section p-6 border-l-2 border-brass-mid bg-ink-elevated/40">
      <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-2">
        First Report · 首份报告
      </p>
      <p class="font-serif text-xl text-cream tracking-cn">
        2027 年 4 月发布——覆盖 2026 全年。
      </p>
    </div>
  </section>

  <!-- ============ 加盟方一并执行 ============ -->
  <section class="editorial-section fade-in">
    <h2 class="section-title text-cream">加盟方一并执行</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        我们的加盟合同明确写入 1% 承诺条款。<strong class="text-brass-bright">加盟方不能选择"我家店不参与"</strong>——这件事的成本已经写进加盟方的财务模型预期。
      </p>
      <p>
        如果你是加盟方，我们希望你理解：你不只是在买一个品牌的使用权，是在加入一个对真实自然有承诺的社区。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ 为什么这件事重要 ============ -->
  <section class="editorial-section fade-in">
    <h2 class="section-title text-cream">为什么这件事重要</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        让自然博物美学进入日常生活——这是我们的 Vision。
      </p>
      <p>
        但如果我们做的事情没有让真实的山川更好——那么我们的店里再美的标本，也只是标本而已。<strong class="text-brass-bright">美学和保护必须是同一件事</strong>。
      </p>
      <p>
        1% 承诺，是让美学和保护成为同一件事的最小代价。
      </p>
    </div>

    <PullQuote
      quote="如果有一天山海造物不再做这件事，意味着我们的美学和真实生态彻底脱钩——那时候我们也不再是山海造物。"
    />
  </section>

  <hr class="brass-divider" />

  <!-- ============ 物理层落地：UV 玻璃 + IoT 监测 ============ -->
  <section class="editorial-section fade-in">
    <div class="mt-section p-6 md:p-8 border border-brass-bright/40 bg-ink-deep/40">
      <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-3">
        Physical Pledge · 「做时间的朋友」的物理层落地
      </p>
      <h3 class="font-serif text-2xl text-cream tracking-cn mb-4">
        承诺标本「被时间定格」<br class="md:hidden" />不是一句口号
      </h3>
      <p class="prose-cn text-text-soft mb-4">
        1% 营收承诺是<strong class="text-cream">价值观层</strong>的承诺——把品牌收益的一部分回到自然。<br />
