---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PledgeBlock from '../components/PledgeBlock.astro';
import ContactBlock from '../components/ContactBlock.astro';
import PullQuote from '../components/PullQuote.astro';

const recipients = [
  {
    name: '国家公园建设',
    detail:
      '通过中国国家公园基金会等合规渠道，支持东北虎豹国家公园、大熊猫国家公园等的基础建设与保护。',
  },
  {
    name: '自然博物馆',
    detail:
      '支持国家自然博物馆、重庆自然博物馆、浙江自然博物院、沈阳古生物博物馆等的科普 / 收藏 / 文创工作。',
  },
  {
    name: '野生动植物保护 NGO',
    detail:
      '山水自然保护中心、桃花源生态保护基金会、猫盟 CFCA、自然之友等合规公益组织。',
  },
  {
    name: '护林员 / 巡护员群体',
    detail:
      '通过上述 NGO 定向支持一线巡护工作者——他们是真实生态的守门人，但收入与工作强度严重不匹配。',
  },
];

const nonRecipients = [
  {
    name: '不捐给"明星公益"项目',
    detail: '单个艺人 / 名人发起的项目，受益对象不明确、可信度低。',
  },
  {
    name: '不捐给受益对象不明的"环保概念基金"',
    detail: '只有概念没有具体落地动作的项目，不在我们的捐赠范围。',
  },
  {
    name: '不捐给与山海造物自有 IP 关联的洗白型项目',
    detail: '绝对不会有"为马上有 IP 设立的环保基金"——这是利益输送，不是公益。',
  },
  {
    name: '不捐给政治敏感方向',
    detail: '保持公益的纯粹性。',
  },
];

// 6 观体系：3 个有独立页面（外联），3 个在本页内联（anchor 锚点）
const sixViews = [
  {
    num: 'I',
    cn: '空间观',
    en: 'Space',
    summary: '门店即博物馆 · 门店即城市公共客厅。',
    href: '/how/space',
    anchor: null,
  },
  {
    num: 'II',
    cn: '承诺观',
    en: 'Commitment',
    summary: '1% 营收用于自然保护——常量，不是活动。',
    href: '#one-percent',
    anchor: null,
  },
  {
    num: 'III',
    cn: '青年观',
    en: 'Youth',
    summary: '给年轻人真问题，不给年轻人假任务。',
    href: '#youth',
    anchor: 'youth',
  },
  {
    num: 'IV',
    cn: '科技观',
    en: 'Technology',
    summary: '技术是隐形的——只在让体验更安静的时候出现。',
    href: '/how/tech',
    anchor: null,
  },
  {
    num: 'V',
    cn: '内容观',
    en: 'Content',
    summary: '内容是空间的延伸，不是空间的广告。',
    href: '#content',
    anchor: 'content',
  },
  {
    num: 'VI',
    cn: '人才观',
    en: 'Talent',
    summary: '一人一口的利益分配——创始人少赚一点，多一点给员工。',
    href: '#talent',
    anchor: 'talent',
  },
];
---

<Layout
  title="价值底座 · Foundation"
  description="六观体系与 1% 承诺——山海造物做每一个决定背后的尺度与硬成本"
>
  <PageHero
    eyebrow="Foundation · 价值底座"
    title="价值观与承诺，<br />写进同一条底线"
    lead="这一页把「我们怎么判断对错」与「我们把钱放回哪里」放在一起：前者是六观裁定标准，后者是 1% 营收承诺。它们不是两套叙事，而是同一件事的两面。"
  />

  <hr class="brass-divider" />

  {/* ============== 六观速览 · 卡片导航 ============== */}
  <section class="editorial-section-wide py-section fade-in">
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3 text-center">
      Six Views · 速览
    </p>
    <h2 class="font-serif text-display text-cream text-center mb-section tracking-cn">
      六个观察角度
    </h2>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-brass-mid/20 max-w-5xl mx-auto">
      {sixViews.map((v) => (
        <li class="bg-ink">
          <a
            href={v.href}
            class="group block p-8 h-full hover:bg-ink-elevated/60 transition-colors duration-300"
          >
            <div class="flex items-baseline gap-3 mb-4">
              <span class="font-serif-en italic text-brass-mid/60 text-2xl">{v.num}</span>
              <h3 class="font-serif text-2xl text-brass-bright tracking-cn group-hover:text-cream transition-colors">
                {v.cn}
              </h3>
              <span class="font-serif-en italic text-text-soft text-xs">· {v.en}</span>
            </div>
            <p class="text-sm text-cream/85 tracking-cn leading-relaxed mb-6 italic">
              {v.summary}
            </p>
            <span class="inline-flex items-center gap-2 text-xs text-brass-mid font-serif-en italic tracking-widest uppercase">
              {v.anchor ? `Read below ↓` : `Open page →`}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <hr class="brass-divider" />

  {/* ============== III. 青年观 · 内联 ============== */}
  <section class="editorial-section py-section fade-in" id="youth">
    <p class="section-number mb-4">III</p>
    <div class="flex items-baseline gap-3 mb-paragraph">
      <h2 class="font-serif text-display text-cream tracking-cn">青年观</h2>
      <span class="font-serif-en italic text-text-soft text-base">· On Youth</span>
    </div>
    <p class="font-serif text-xl text-brass-bright italic mb-paragraph tracking-cn">
      给年轻人真问题，不给年轻人假任务。
    </p>
    <div class="prose-cn space-y-paragraph">
      <p>
        我们用大量的年轻人——不是因为他们便宜，是因为<strong class="text-cream">他们没被旧零售业的"假任务"驯化过</strong>。
      </p>
      <p>
        在我们的店里，店员不背销售指标——他们的考核是"今天有几位客人在店里停留超过了 30 分钟"。在我们的工坊，新人第一个月不做任何成品——他们被要求"<strong class="text-brass-bright">看老师傅工作 100 小时</strong>"。
      </p>
      <p>
        我们相信：<strong class="text-cream">把一件值得做的事交给一个相信它的年轻人，比把一件不值得做的事交给一个有经验的成年人，结果好得多</strong>。
      </p>
      <p>
        所以我们招人的优先级不是经验——是<strong class="text-brass-bright">他/她对自然博物 / 美学 / 慢生活有没有真实的好奇心</strong>。这一条没有也不强求，但我们会给那些有的人最好的成长环境。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  {/* ============== V. 内容观 · 内联 ============== */}
  <section class="editorial-section py-section fade-in" id="content">
    <p class="section-number mb-4">V</p>
    <div class="flex items-baseline gap-3 mb-paragraph">
      <h2 class="font-serif text-display text-cream tracking-cn">内容观</h2>
      <span class="font-serif-en italic text-text-soft text-base">· On Content</span>
    </div>
    <p class="font-serif text-xl text-brass-bright italic mb-paragraph tracking-cn">
      内容是空间的延伸，不是空间的广告。
    </p>
    <div class="prose-cn space-y-paragraph">
      <p>
        我们写公众号、做小红书、出品牌片——但这些都不是"营销内容"。它们是<strong class="text-brass-bright">我们工作日常的副产品</strong>：今天工坊收到一只新蝶、今天店里有客人讲了一个故事、今天我们读到一篇博物学旧文。
      </p>
      <p>
        我们不写"5 个理由让你必须拥有这只蝴蝶"那种文章——那不是我们的语言。我们写的是：
      </p>
      <p class="pl-6 border-l-2 border-brass-mid/50 italic text-cream">
        "这只蝶羽翼上的蓝，不是颜料。是光线穿过纳米级鳞片结构产生的衍射——所以每一个角度看，蓝都不一样。"
      </p>
      <p>
        以一个具体的事实或画面开头。<strong class="text-cream">禁止以 emoji 开头</strong>、<strong class="text-cream">禁止以叹号问号开头</strong>、<strong class="text-cream">禁止"亲们""宝子们"</strong>。
      </p>
      <p>
        门店是内容的源头，公众号 / 小红书 / 抖音是内容的扩散——但<strong class="text-brass-bright">如果一段内容没法在我们的店里被讲出来，它就不该被发出来</strong>。
      </p>
      <p class="text-sm text-text-soft">
        相关：完整的<a href="/notes" class="border-b border-brass-mid/40 hover:text-brass-bright">笔记</a>会逐步整理到本站。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  {/* ============== VI. 人才观 · 内联 ============== */}
  <section class="editorial-section py-section fade-in" id="talent">
    <p class="section-number mb-4">VI</p>
    <div class="flex items-baseline gap-3 mb-paragraph">
      <h2 class="font-serif text-display text-cream tracking-cn">人才观</h2>
      <span class="font-serif-en italic text-text-soft text-base">· On Talent</span>
    </div>
    <p class="font-serif text-xl text-brass-bright italic mb-paragraph tracking-cn">
      一人一口的利益分配——创始人少赚一点，多一点给员工。
    </p>
    <div class="prose-cn space-y-paragraph">
      <p>
        山海造物的人才观核心是<strong class="text-brass-bright">"一人一口"</strong>——
        创始人少赚一点，多一点给员工、给社会、给顾客。具体表现：
      </p>
    </div>

    <ul class="prose-cn list-none pl-0 mt-paragraph space-y-3">
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        创始人薪资水平明显低于一般创业公司同等阶段标准
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        创始人在公司亏损年度主动降薪
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        创始人不享受特殊福利（专车 / 高额报销 / 个人秘书等）
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        每年「妈妈的饺子 A 套餐」——核心团队家庭可享一次完整的工作室招待
      </li>
    </ul>

    <div class="prose-cn mt-paragraph space-y-paragraph">
      <p>
        这条原则会让一些投资人犹豫——他们习惯的是"创始人重金激励 = 高速增长"的模型。我们的回应是：<strong class="text-cream">山海造物想做的是 30 年的事业，不是 5 年退出的标的</strong>。在 30 年的尺度上，创始人能保持长期投入的真正保险是<strong class="text-brass-bright">对事业本身的信仰</strong>——而不是短期重金激励。
      </p>
    </div>

    <div class="mt-section p-6 border-l-2 border-brass-mid bg-ink-elevated/40">
      <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
        Talent Toolkit · 把理念落到执行
      </p>
      <p class="text-cream/85 text-sm leading-[1.85] tracking-cn mb-3">
        「一人一口」是<strong class="text-cream">理念层</strong>。具体到三段式速成课程、认证店长体系、招聘画像、薪酬结构与期权激励——这些是<strong class="text-cream">执行层</strong>。
      </p>
      <p class="text-sm">
        <a href="/talent" class="text-brass-mid hover:text-brass-bright border-b border-brass-mid/40">
          人才与店长培训 toolkit · /talent →
        </a>
      </p>
    </div>

    <p class="prose-cn mt-paragraph text-sm text-text-soft">
      相关：投资合作页对此有更长的说明 → <a href="/for-investors#one-bowl" class="border-b border-brass-mid/40 hover:text-brass-bright">/for-investors#one-bowl</a>
    </p>
  </section>


  <hr class="brass-divider" />

  <section class="editorial-section py-section fade-in" id="compliance">
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
      Compliance · 合规与披露
    </p>
    <h2 class="font-serif text-display text-cream tracking-cn mb-paragraph">公益捐赠与披露</h2>
    <div class="prose-cn space-y-paragraph text-text-soft">
      <p>
        1% 承诺以<strong class="text-cream">可审计、可披露</strong>的方式执行：捐赠进入合规公益渠道，年度透明报告同步发布于本站与公众号；加盟方汇缴情况一并纳入披露范围。
      </p>
      <p class="text-sm">
        具体受益机构与红线原则见下文「1% 承诺」章节；若你对流程或合作边界有疑问，可通过页尾联系入口与我们沟通。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase text-center mb-6">
    Pledge · 1% 承诺（全文）
  </p>
  <!-- ============ Hero · 大字 1% ============ -->
  <section id="one-percent" class="editorial-section pt-section text-center">
    <p class="font-serif-en italic text-brass-mid text-sm tracking-widest uppercase mb-6 fade-in">
      Our Pledge · 1% 承诺
    </p>

    <div
      class="font-serif-en text-brass-bright fade-in"
      style="font-size: clamp(8rem, 20vw, 16rem); line-height: 0.9; letter-spacing: -0.04em;"
    >
      1<span class="text-brass-mid">%</span>
    </div>

    <p class="display-title text-cream mt-section fade-in">
      让自然博物美学进入日常生活，<br />
      这件事不能只发生在我们的店里。
    </p>

    <div class="prose-cn max-w-editorial mx-auto mt-section text-text-soft fade-in">
      <p>
        如果我们做的事情没有让真实的山川更好——那么我们的店里再美的标本，也只是标本而已。
      </p>
      <p>所以从第一家店开始，我们做了一个具体承诺。</p>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ I. 1% 营收 不是 1% 利润 ============ -->
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">I</p>
    <h2 class="section-title text-cream">1% 营收 · 不是 1% 利润</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        每一家山海造物直营店与加盟店，每年<strong class="text-brass-bright">营业收入</strong>的 <strong class="text-brass-bright">1%</strong>，无条件捐赠给环保 / 自然博物 / 野生动植物保护 / 护林员相关公益方向。
      </p>
      <p>
        我们承诺的是 1% <strong class="text-cream">营收</strong>——不是 1% 利润。
      </p>
      <p>为什么这个区别重要？</p>
      <p>
        利润可以通过会计技术调整，营收不可以。<strong class="text-brass-bright">营收承诺意味着——无论盈亏，履行都不变</strong>。
      </p>
      <p class="text-text-soft text-sm">
        这个标准来自 1% for the Planet（Patagonia 创始人 Yvon Chouinard 2002 年发起的全球承诺组织）。我们采用同样的标准。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ II. 捐给谁 ============ -->
  <section class="editorial-section-wide fade-in">
    <p class="section-number mb-4">II</p>
    <h2 class="section-title text-cream">捐给谁</h2>

    <p class="prose-cn mb-section max-w-editorial">
      每年从以下四个方向中选择 2-4 个分配捐赠：
    </p>

    <PledgeBlock
      title="四个捐赠方向"
      subtitle="Recipients"
      items={recipients}
    />
  </section>

  <!-- ============ III. 不捐给谁 ============ -->
  <section class="editorial-section-wide fade-in">
    <p class="section-number mb-4">III</p>
    <h2 class="section-title text-cream">绝不捐给谁</h2>

    <p class="prose-cn mb-section max-w-editorial">
      我们对这件事有同样清晰的红线：
    </p>

    <PledgeBlock
      title="四条红线"
      subtitle="Non-recipients"
      items={nonRecipients}
      variant="negative"
    />
  </section>

  <hr class="brass-divider" />

  <!-- ============ IV. 这笔钱有多大 · 它能做什么 ============ -->
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">IV</p>
    <h2 class="section-title text-cream">这笔钱有多大 · 它能做什么</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        我们做了一个保守估算：到 2028 年 6 家直营 + 加盟店，年总营收约 <strong class="text-brass-bright">6000 万</strong>。
      </p>
      <p>
        1% = <strong class="text-brass-bright">60 万 / 年</strong>。这个数字不大——但在自然保护一线，它意味着具体的事：
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-4 mt-paragraph">
      <article class="p-6 border border-brass-mid/20 bg-ink-elevated/40">
        <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-2">
          Equivalent · 等同于
        </p>
        <p class="text-cream font-serif text-lg tracking-cn mb-2">
          <strong class="text-brass-bright">8 – 10 名</strong>全职护林员一年的工资
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          按一线护林员年薪 6 – 8 万计算。他们是真实生态的守门人，但收入与工作强度严重不匹配。
        </p>
      </article>

      <article class="p-6 border border-brass-mid/20 bg-ink-elevated/40">
        <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-2">
          Equivalent · 等同于
        </p>
        <p class="text-cream font-serif text-lg tracking-cn mb-2">
          一次<strong class="text-brass-bright">小型自然博物馆特展</strong>的预算
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          可以让一个城市的孩子第一次近距离看到来自国家公园的标本与影像。
        </p>
      </article>

      <article class="p-6 border border-brass-mid/20 bg-ink-elevated/40">
        <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-2">
          Equivalent · 等同于
        </p>
        <p class="text-cream font-serif text-lg tracking-cn mb-2">
          一个 NGO <strong class="text-brass-bright">一线项目</strong>的年度核心支持
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          山水自然保护中心 / 桃花源 / 猫盟级别的合规公益组织，一个完整年度的项目预算。
        </p>
      </article>

      <article class="p-6 border border-brass-deep/30 bg-ink-deep/30">
        <p class="font-serif-en italic text-brass-deep text-xs tracking-widest uppercase mb-2">
          Hard Cost · 不是营销
        </p>
        <p class="text-cream font-serif text-lg tracking-cn mb-2">
          这不是营销预算，是<strong class="text-brass-deep">品牌承诺的硬成本</strong>
        </p>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          它必须写进损益表的"公益捐赠"栏，<strong class="text-cream">被审计、被披露、被铭记</strong>。
        </p>
      </article>
    </div>
  </section>

  <hr class="brass-divider" />

  <!-- ============ V. 透明 ============ -->
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">V</p>
    <h2 class="section-title text-cream">透明</h2>

    <p class="prose-cn">
      每年 4 月（环保月），我们公开发布<strong class="text-brass-bright">《山海造物 · 1% 承诺年度透明报告》</strong>，包含：
    </p>

