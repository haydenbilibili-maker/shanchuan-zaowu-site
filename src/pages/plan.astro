---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import WIPNotice from '../components/WIPNotice.astro';
---

<Layout
  title="三年规划"
  description="2026–2028 · 山海造物的三年路线图"
>
  <PageHero
    eyebrow="Three-Year Plan · 三年规划"
    title="2026 — 2028<br />我们要走到哪儿"
    lead="不写五年——五年太长，写出来的都是空话。三年是我们能负责任的尺度——城市数、店型、产品体系、组织架构，都用月维度承诺。"
  />

  <hr class="brass-divider" />

  <WIPNotice
    topic="三年规划 · 2026–2028 路线图（含季度里程碑）"
    expectedVersion="v0.3"
  />
</Layout>
