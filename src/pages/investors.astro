---
import Layout from '../components/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContactBlock from '../components/ContactBlock.astro';
import PullQuote from '../components/PullQuote.astro';

const benchmarks = [
  {
    name: '中川政七商店',
    role: '灵魂模板',
    detail: 'Vision 第一原则、不做清单、慢与稳、300 年长期主义',
    nameEn: 'Nakagawa Masashichi',
  },
  {
    name: '蔦屋書店',
    role: '形态模板',
    detail: '多 format / 居心地 / Concierge / 失败的容许 / 公共合作',
    nameEn: 'Tsutaya Books',
  },
  {
    name: '泡泡玛特',
    role: '警示模板',
    detail: '可学：多 IP 矩阵 / DTC / 出海节奏。必避：盲盒 / 饥饿营销 / 快速迭代',
    nameEn: 'Pop Mart',
  },
];
---

<Layout
  title="投资合作"
  description="山海造物 · 我们寻找耐心资本"
>
  <SectionHeader
    eyebrow="Investors · 投资合作"
    title={`你在找一个\n不追风口的标的`}
    intro="未来 12-18 个月，山海造物将启动正式融资。我们的态度是——找钱很重要，找对的钱更重要。这页文档不是路演 deck 的简版，目的是双向筛选。"
  />

  <hr class="brass-divider" />

  {/* ============ I. 我们寻找什么样的资本 ============ */}
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">I</p>
    <h2 class="section-title text-cream">我们寻找什么样的资本</h2>

    <ul class="space-y-paragraph">
      <li class="prose-cn">
        <strong class="text-brass-bright">耐心资本</strong>——能接受 5-10 年回报周期、理解长期主义品牌的逻辑、不会在每个季度问"为什么不够快"的资本。
      </li>
      <li class="prose-cn">
        <strong class="text-brass-bright">理解新消费但不照搬新消费打法</strong>——山海造物属于第三代新消费品牌（内容 + 文化 + 长期），与第二代（流量 + 营销 + 爆款）的逻辑不同。
      </li>
      <li class="prose-cn">
        <strong class="text-brass-bright">与品牌价值观相通</strong>——我们做的是 30 年的事业。如果你的基金 LP 要求 5 年退出，可能我们的节奏会让你为难。
      </li>
      <li class="prose-cn">
        <strong class="text-brass-bright">有产业资源更好</strong>——与文化、自然博物、博物馆、文创、内容、教育领域有产业积累的资本，对我们的价值远高于纯财务投资。
      </li>
    </ul>
  </section>

  {/* ============ II. 我们不要什么样的资本 ============ */}
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">II</p>
    <h2 class="section-title text-cream">我们不要什么样的资本</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        <strong class="text-brass-bright">对赌资本</strong>——任何要求"3 年内必须做到 X 倍营收"或"5 年内必须上市"的对赌条款，我们不接受。
      </p>
      <p>
        <strong class="text-brass-bright">push 我们做盲盒 / 限量 / 饥饿营销的资本</strong>——这些与「不装的规模化」哲学根本对立，是我们「不做」清单上的永久红线。
      </p>
      <p>
        <strong class="text-brass-bright">push 跨品类快速扩张的资本</strong>——我们不做与"自然博物美学"无关的延伸。
      </p>
      <p>
        <strong class="text-brass-bright">短期套利型资本</strong>——我们的 IRR 不是 3 年内能爆发的那种。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  {/* ============ III. 当前阶段 ============ */}
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">III</p>
    <h2 class="section-title text-cream">当前阶段</h2>

    <div class="prose-cn">
      <h3 class="font-serif text-xl text-brass-bright mb-3 tracking-cn">业务现状</h3>
      <ul class="space-y-2 list-none pl-0 mb-paragraph">
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
          长春这有山首店运营中
        </li>
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
          标本工作室 + 咖啡店（Max 版原型）2026 年 6-7 月开业
        </li>
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
          第二家直营店选址中（2026 H2）
        </li>
      </ul>

      <h3 class="font-serif text-xl text-brass-bright mb-3 tracking-cn">商业基本盘（脱敏区间）</h3>
      <ul class="space-y-2 list-none pl-0 mb-paragraph">
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
          客单价中位数：三位数（与对标品牌中位数相当）
        </li>
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
          月均营收：6 位数（首店稳定后）
        </li>
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
          毛利率：高于零售业行业中位数
        </li>
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
          复购率：高于零售业行业中位数
        </li>
        <li class="pl-6 relative">
          <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
          当前盈亏：接近盈亏平衡
        </li>
      </ul>

      <p class="text-sm text-text-soft">
        详细财务模型通过正式邮件沟通后线下同步——我们认真看每一封投资人邮件。
      </p>
    </div>
  </section>

  {/* ============ IV. 商业模式与三条增长曲线 ============ */}
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">IV</p>
    <h2 class="section-title text-cream">商业模式与三条增长曲线</h2>

    <p class="prose-cn mb-paragraph">
      我们的增长不依赖单一路径，是三条曲线叠加：
    </p>

    <div class="space-y-paragraph">
      <div class="p-6 border-l-2 border-brass-mid pl-6">
        <h3 class="font-serif text-xl text-brass-bright mb-2 tracking-cn">曲线 1 · 直营连锁</h3>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          按 Lite / Pro / Max 三档场景化拓店，2028 年目标 6-10 家直营店。
        </p>
      </div>

      <div class="p-6 border-l-2 border-brass-mid pl-6">
        <h3 class="font-serif text-xl text-brass-bright mb-2 tracking-cn">曲线 2 · 加盟体系</h3>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          2027 H2 开放。基于我们正在搭建的空间 toolkit + 人才认证 toolkit，每年有限放开 5-8 家加盟店。<strong class="text-cream">不追求加盟数量，追求加盟质量</strong>。
        </p>
      </div>

      <div class="p-6 border-l-2 border-brass-mid pl-6">
        <h3 class="font-serif text-xl text-brass-bright mb-2 tracking-cn">曲线 3 · 公共合作</h3>
        <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
          探索中。参考蔦屋書店 × 武雄市图書館 PFI 模式，与中国自然博物馆 / 国家公园 / 自然教育机构合作。这是新消费品牌很少触及的领域，但<strong class="text-cream">它是 30 年品牌的隐性护城河</strong>。
        </p>
      </div>
    </div>
  </section>

  <hr class="brass-divider" />

  {/* ============ V. 对标定位 · 三对标合并坐标系 ============ */}
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">V</p>
    <h2 class="section-title text-cream">对标定位 · 三对标合并坐标系</h2>

    <p class="prose-cn mb-paragraph">
      我们花了大量时间研究三个对标品牌——不是为了模仿，是为了知道<strong class="text-brass-bright">自己的位置</strong>：
    </p>

    <div class="grid md:grid-cols-3 gap-4">
      {benchmarks.map((b) => (
        <div class="p-6 border border-brass-mid/20 bg-ink-elevated/40 fade-in flex flex-col">
          <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-2">
            {b.role}
          </p>
          <h3 class="font-serif text-lg text-cream mb-1 tracking-cn">{b.name}</h3>
          <p class="font-serif-en italic text-text-dim text-xs mb-3">{b.nameEn}</p>
          <p class="text-text-soft text-sm leading-[1.85] tracking-cn">{b.detail}</p>
        </div>
      ))}
    </div>

    <PullQuote
      quote="用中川政七的灵魂、运营蔦屋的形态、把泡泡玛特当反面镜子。"
    />
  </section>

  {/* ============ VI. 1% 承诺与品牌护城河 ============ */}
  <section class="editorial-section fade-in">
    <p class="section-number mb-4">VI</p>
    <h2 class="section-title text-cream">1% 承诺与品牌护城河</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        我们承诺将每年营业收入的 1%——<strong class="text-brass-bright">不是利润</strong>——无条件捐赠给环保 / 自然博物 / 野生动植物保护方向。这件事写进每一份直营店与加盟店的财务模型。
      </p>
      <p>为什么这件事对投资人重要？</p>
    </div>

    <ul class="prose-cn list-none pl-0 mt-paragraph space-y-3">
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        这是 0.5-1% 量级的"硬成本"——会出现在损益表上，不是 marketing budget
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        但它换来的是<strong class="text-cream">无法被竞争对手快速复制的品牌护城河</strong>——竞争品牌如果想跟进，要么承担同样的成本，要么选择不跟进
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        它强化了山海造物的"长期主义品牌"定位
      </li>
    </ul>

    <p class="prose-cn mt-paragraph">
      我们对 1% 承诺的态度是：<strong class="text-brass-bright">这不是讨论项</strong>。这是品牌身份的一部分，与"做不做盲盒""开不开 1000㎡ 的店"是同一性质的红线。
    </p>

    <p class="text-sm text-text-soft mt-paragraph">
      详细机制 → <a href="/commitment" class="text-brass-mid hover:text-brass-bright">/commitment</a>
    </p>

    {/* === 三道护城河：软（价值观）+ 硬-软件 + 硬-硬件 === */}
    <div class="mt-section p-6 md:p-8 border border-brass-bright/40 bg-ink-deep/40">
      <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-3">
        Three Moats · 三道护城河
      </p>
      <p class="font-serif text-lg md:text-xl text-cream tracking-cn mb-section leading-[1.7]">
        1% 承诺是<strong class="text-brass-mid">软护城河</strong>——价值观层；<br />
        自研数字化能力 + 硬核科技基础设施是<strong class="text-brass-bright">两道硬护城河</strong>——执行层。
      </p>

      {/* 软护城河 + 硬护城河：软件 / 硬件 三栏并列 */}
      <div class="grid md:grid-cols-2 gap-px bg-brass-mid/15 mb-section">
        {/* 硬护城河 I · 软件 */}
        <div class="bg-ink-deep/70 p-6">
          <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-3">
            Hard Moat I · 数字化能力
          </p>
          <h3 class="font-serif text-lg text-cream tracking-cn mb-4">软件层 · 一人构建的完整体系</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-4">
            <div class="text-center p-2 bg-ink/60">
              <p class="font-serif-en italic text-brass-bright text-lg">30+</p>
              <p class="text-xs text-text-soft tracking-cn mt-1">小程序页</p>
            </div>
            <div class="text-center p-2 bg-ink/60">
              <p class="font-serif-en italic text-brass-bright text-lg">27</p>
              <p class="text-xs text-text-soft tracking-cn mt-1">ERP 模块</p>
            </div>
            <div class="text-center p-2 bg-ink/60">
              <p class="font-serif-en italic text-brass-bright text-lg">17</p>
              <p class="text-xs text-text-soft tracking-cn mt-1">AI 场景</p>
            </div>
            <div class="text-center p-2 bg-ink/60">
              <p class="font-serif-en italic text-brass-bright text-lg">1</p>
              <p class="text-xs text-text-soft tracking-cn mt-1">人构建</p>
            </div>
          </div>
          <p class="text-text-soft text-sm leading-[1.85] tracking-cn mb-3">
            李贺一人开发完整数字化体系，<strong class="text-cream">无外部技术团队、无 SaaS 订阅</strong>——同类初创品牌中极为罕见的资本效率。
          </p>
          <a
            href="/digital-ops"
            class="inline-flex items-center gap-2 text-sm text-brass-mid hover:text-brass-bright border-b border-brass-mid/40 hover:border-brass-bright/60 transition-colors"
          >
            <span>查看完整能力清单</span>
            <span class="font-serif-en italic">/digital-ops →</span>
          </a>
        </div>

        {/* 硬护城河 II · 硬件 */}
        <div class="bg-ink-deep/70 p-6">
          <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-3">
            Hard Moat II · 硬核基础设施
          </p>
          <h3 class="font-serif text-lg text-cream tracking-cn mb-4">硬件层 · 用未来技术做过去的事</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-4">
            <div class="text-center p-2 bg-ink/60">
              <p class="font-serif-en italic text-brass-bright text-lg">11</p>
              <p class="text-xs text-text-soft tracking-cn mt-1">推荐技术</p>
            </div>
            <div class="text-center p-2 bg-ink/60">
              <p class="font-serif-en italic text-brass-bright text-lg">3</p>
              <p class="text-xs text-text-soft tracking-cn mt-1">明确不做</p>
            </div>
            <div class="text-center p-2 bg-ink/60">
              <p class="font-serif-en italic text-brass-bright text-lg">4</p>
              <p class="text-xs text-text-soft tracking-cn mt-1">层级结构</p>
            </div>
            <div class="text-center p-2 bg-ink/60">
              <p class="font-serif-en italic text-brass-bright text-lg">3</p>
              <p class="text-xs text-text-soft tracking-cn mt-1">年路线</p>
            </div>
          </div>
          <p class="text-text-soft text-sm leading-[1.85] tracking-cn mb-3">
            3D 扫描 / 微距摄影 / 物联网 / UV 玻璃 / 激光雕刻——<strong class="text-cream">每只标本完整数字归档 + 物理生命延长 50 年</strong>。这是从「文创品牌」升级为「自然博物科技品牌」的关键叙事。
          </p>
          <a
            href="/hardcore-tech"
            class="inline-flex items-center gap-2 text-sm text-brass-mid hover:text-brass-bright border-b border-brass-mid/40 hover:border-brass-bright/60 transition-colors"
          >
            <span>查看完整科技蓝图</span>
            <span class="font-serif-en italic">/hardcore-tech →</span>
          </a>
        </div>
      </div>

      <p class="text-text-soft text-sm leading-[1.85] tracking-cn italic">
        软 + 硬两道护城河同时存在——这是普通文创品牌没有的对话权限，也是 30 年品牌真正的执行壁垒。
      </p>
    </div>

    {/* === Callout · 对标研究（投资人是最直接的 target audience） === */}
    <div class="mt-section max-w-editorial-wide mx-auto">
      <a
        href="/benchmarks"
        class="group block p-8 md:p-10 border-2 border-brass-mid/40 bg-ink-elevated/40 hover:bg-ink-elevated/70 hover:border-brass-mid transition-all relative overflow-hidden"
      >
        <div class="absolute top-0 right-0 px-3 py-1 bg-brass-mid text-ink-deep font-mono text-[10px] tracking-widest uppercase">
          For Investors
        </div>

        <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
          Benchmarks · 对标研究 · 我们已经预演过的拒绝
        </p>
        <h3 class="font-serif text-cream text-2xl tracking-cn mb-3">
          我们已经准备好<span class="text-brass-bright">对你的某些建议说不</span>。
        </h3>
        <p class="text-text-soft text-sm md:text-base leading-[1.85] tracking-cn mb-4">
          一个品牌真正成熟的标志，不是它能做什么，而是<strong class="text-cream">在被诱惑做某件事时，能不能拿出已经想清楚的拒绝理由</strong>。
          山海造物研究过 7 家全球品牌（中川政七 / 蔦屋 / 泡泡玛特 / V&A / MUJI / Felissimo / Skansen），
          我们已经写好了 5 个最常见诱惑场景的应对话术——其中之一就是
          <em>"做成中国版 V&A，迅速铺 10 家博物馆形态店"</em>。
        </p>

        <div class="grid grid-cols-3 gap-3 md:gap-6 mt-6 pt-6 border-t border-brass-mid/20">
          <div class="text-center">
            <div class="font-serif-en italic text-2xl md:text-3xl text-green-mid mb-1">6</div>
            <p class="text-text-soft text-xs tracking-cn">正面学习</p>
          </div>
          <div class="text-center border-x border-brass-mid/15">
            <div class="font-serif-en italic text-2xl md:text-3xl text-coral-mid mb-1">5</div>
            <p class="text-text-soft text-xs tracking-cn">反面警示</p>
          </div>
          <div class="text-center">
            <div class="font-serif-en italic text-2xl md:text-3xl text-brass-mid mb-1">5</div>
            <p class="text-text-soft text-xs tracking-cn">应对话术</p>
          </div>
        </div>

        <p class="mt-6 text-right font-serif-en italic text-brass-mid group-hover:text-brass-bright transition-colors text-sm">
          查看 V&A 深度案例与三区判断 →
        </p>
      </a>
    </div>
  </section>

  {/* ============ VII. 一人一口的利益分配 ============ */}
  <section class="editorial-section fade-in" id="one-bowl">
    <p class="section-number mb-4">VII</p>
    <h2 class="section-title text-cream">一人一口的利益分配</h2>

    <div class="prose-cn space-y-paragraph">
      <p>
        山海造物的人才观核心是"一人一口的利益分配"——<strong class="text-brass-bright">创始人少赚一点，多一点给员工、给社会、给顾客</strong>。
      </p>
      <p>具体表现：</p>
    </div>

    <ul class="prose-cn list-none pl-0 mt-paragraph space-y-3">
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        创始人薪资水平明显低于一般创业公司同等阶段标准
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        创始人在公司亏损年度主动降薪
      </li>
      <li class="pl-6 relative">
        <span class="absolute left-0 top-2 w-2 h-px bg-brass-mid"></span>
        创始人不享受特殊福利（专车 / 高额报销 / 个人秘书等）
      </li>
    </ul>

    <p class="prose-cn mt-paragraph">
      这条原则会让一些投资人犹豫——他们习惯的是"创始人重金激励 = 高速增长"的模型。我们的回应是：<strong class="text-cream">山海造物想做的是 30 年的事业，不是 5 年退出的标的</strong>。在 30 年的尺度上，创始人能保持长期投入的真正保险是<strong class="text-brass-bright">对事业本身的信仰</strong>——而不是短期重金激励。
    </p>
    <p class="prose-cn">
