---
import Layout from '../components/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContactBlock from '../components/ContactBlock.astro';

// 关键宏观数字（首屏 metrics 行）
const metrics = [
  { num: '30+', label: '小程序页面', en: 'Mini Program Pages' },
  { num: '27', label: 'ERP 模块', en: 'Backend Modules' },
  { num: '17', label: 'AI 场景', en: 'AI Scenarios' },
  { num: '25+', label: '云函数', en: 'Cloud Functions' },
];

// 三大平台
const platforms = [
  {
    role: 'I',
    en: 'Consumer',
    name: '官方小程序',
    side: '消费者端',
    detail:
      '博物标本电商 + 内容社区 + AI 鉴定 + 预约 + 会员体系。微信小程序原生开发，覆盖从触达到留存的全链路。',
  },
  {
    role: 'II',
    en: 'Operations',
    name: '数智化中台',
    side: '管理端',
    detail:
      '藏品管理 + 财务核算 + 会员 CRM + 活动营销 + AI 决策。Vue 3 SPA，与小程序共享同一云数据库，数据实时互通。',
  },
  {
    role: 'III',
    en: 'Store',
    name: '店长后台',
    side: '门店运营端',
    detail:
      '嵌入小程序内的轻量管理界面，账本 / 订单 / 核销 / 藏品 / 活动 / 权益 / 人员 / 装修 / 内容 九大功能，手机即可日常运营。',
  },
];

// 17 AI 场景按领域分组
const aiDomains = [
  {
    domain: '门店经营',
    en: 'Store Operations',
    items: [
      { code: 'StoreAI', desc: '门店经营全场景 AI 助手' },
      { code: 'InventoryAI', desc: '库存周转分析、缺货预测、自动补货建议' },
      { code: 'PricingAI', desc: '市场 / 库存 / 竞品综合定价策略' },
      { code: 'SalesAI', desc: '历史 + 季节 + 活动因素预测销售趋势' },
    ],
  },
  {
    domain: '营销与内容',
    en: 'Marketing & Content',
    items: [
      { code: 'MarketingAI', desc: '营销活动策划与优化' },
      { code: 'ContentAI', desc: '内容创作辅助' },
    ],
  },
  {
    domain: '客户与客服',
    en: 'Customer',
    items: [
      { code: 'CustomerAI', desc: '客户画像分析、精准营销' },
      { code: 'CustomerServiceAI', desc: '智能客服应答' },
    ],
  },
  {
    domain: '供应链与规划',
    en: 'Supply & Planning',
    items: [
      { code: 'SupplyChainAI', desc: '供应链优化建议' },
      { code: 'BusinessPlanAI', desc: '商业计划生成与分析' },
    ],
  },
  {
    domain: '人力与财务',
    en: 'HR & Finance',
    items: [
      { code: 'StaffOptimizeAI', desc: '人员排班与效率优化' },
      { code: 'FinanceAI', desc: '财务分析与建议' },
      { code: 'DataReportAI', desc: '数据报表自动生成' },
    ],
  },
  {
    domain: '竞争与战略',
    en: 'Strategy',
    items: [
      { code: 'CompetitorAnalysisAI', desc: '竞品监测与分析' },
      { code: 'StrategyResearchAI', desc: '战略调研与洞察' },
    ],
  },
  {
    domain: '法务',
    en: 'Legal',
    items: [{ code: 'ContractReviewAI', desc: '合同审查辅助' }],
  },
  {
    domain: '协作',
    en: 'Collaboration',
    items: [{ code: 'VirtualBoard', desc: '虚拟董事会——多角色 AI 辩论决策' }],
  },
];

// 战略价值（三受众并重）
const valueForAudience = [
  {
    role: 'I',
    label: '对投资人',
    en: 'For Investors',
    pillars: [
      {
        title: 'AI 驱动超级个体不是概念，是已落地的能力',
        body: '一人构建小程序（30+ 页面）+ ERP 中台（27 模块）+ AI 智能中心（17 场景）+ 25+ 云函数 + 完整云数据库——这在同类初创品牌中极为罕见。',
      },
      {
        title: '极低技术成本',
        body: '无外部技术团队、无 SaaS 订阅费用。微信云开发按量计费，初创期成本极低。',
      },
      {
        title: '技术壁垒随时间加深',
        body: '数据积累、算法优化、用户行为数据沉淀——这些资产无法被竞争对手短期复制。',
      },
    ],
  },
  {
    role: 'II',
    label: '对加盟商',
    en: 'For Franchise Partners',
    pillars: [
      {
        title: '开箱即用',
        body: '加盟商不需自建任何数字化系统。小程序商城 / 会员体系 / 库存管理 / 数据报表 / AI 助手全部由公司统一提供。店长后台手机即可完成日常运营。',
      },
      {
        title: '数据驱动决策',
        body: 'AI 智能中心为每家门店提供定价建议、补货预警、销售预测，大幅降低加盟商的经营决策门槛。',
      },
      {
        title: '零边际成本复制',
        body: '新开一家加盟店时，数字化系统开店即上线，所有数据自动汇入中央 ERP。',
      },
    ],
  },
  {
    role: 'III',
    label: '对消费者',
    en: 'For Customers',
    pillars: [
      {
        title: '从一次性购买到持续收藏、探索、互动',
        body: '收藏家协会会员体系 + AI 标本鉴定 + 自然图鉴 + 成就系统 + 预约系统 + 内容社区，构成完整的数字化体验闭环——不是为了「让客人买更多」，是为了让一次购买的客人和山海造物之间多一根长期线索。',
      },
    ],
  },
];

// 技术路线图
const roadmap = [
  {
    period: 'Now',
    label: '已完成',
    items: [
      '小程序全功能上线（30+ 页面）',
      'ERP 中台 27 模块全部实现',
      'AI 智能中心 17 场景部署',
      '25+ 云函数运行中',
      '云数据库 30+ 集合建立',
      '客户端工具库（监控 / 性能 / 缓存 / 图片）',
    ],
  },
  {
    period: 'Near',
    label: '近期优化',
    items: [
      '门店 POS 与 ERP 数据打通',
      '库存系统与实际库存对齐',
      'AI 标本鉴定从 Mock 切换到正式模型',
      '多门店数据隔离与汇总',
      '加盟商专属数据看板',
      '小程序 LBS 就近门店推荐',
    ],
  },
  {
    period: 'Mid',
    label: '中期规划',
    items: [
      'AR 标本体验进一步完善',
      '多语言支持（日文 / 英文）',
      '微信支付全链路打通',
      '开放平台 API 供第三方接入',
    ],
  },
];
---

<Layout
  title="数字化运营能力"
  description="基于已交付代码库的真实能力映射——30+ 小程序页面 / 27 个 ERP 模块 / 17 个 AI 场景 / 25+ 云函数。一人构建，等效 3-5 人技术团队的产出。"
>
  <SectionHeader
    eyebrow="Digital Operations · 品牌数字化运营能力"
    title={`已交付的能力\n不是概念规划`}
    intro="山海造物已建成一套完整的自研数字化运营体系，覆盖从消费者触达到经营决策的全链路。这套体系由创始人李贺一人独立开发，等效于 3-5 人技术团队的产出。本文所有列出的功能均已实现并可运行——基于真实代码库的能力映射，不是 PPT 上的设想。"
  />

  <hr class="brass-divider" />

  {/* ============== 关键数字 ============== */}
  <section class="editorial-section-wide py-section fade-in">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-brass-mid/10">
      {metrics.map((m) => (
        <div class="bg-ink p-8 md:p-10 text-center">
          <p class="font-serif-en italic text-brass-bright mb-2"
             style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1;">
            {m.num}
          </p>
          <p class="font-serif text-cream text-sm md:text-base tracking-cn mb-1">{m.label}</p>
          <p class="font-serif-en italic text-text-dim text-xs tracking-widest uppercase">
            {m.en}
          </p>
        </div>
      ))}
    </div>
    <p class="text-center text-text-dim text-xs font-serif-en italic tracking-widest uppercase mt-6">
      Hand-built by founder · 一人构建 · Updated 2026.04
    </p>

    {/* 配对实证：硬核科技应用蓝图 */}
    <div class="mt-section p-5 md:p-6 border-l-2 border-brass-bright/60 bg-ink-deep/40 max-w-editorial mx-auto">
      <p class="font-serif-en italic text-brass-bright text-xs tracking-widest uppercase mb-2">
        Pair Proof · 另一条战略路线
      </p>
      <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
        本页讲的是<strong class="text-cream">软件层</strong>的数字化能力。<strong class="text-cream">硬件层</strong>的硬核基础设施（3D 扫描 / 微距摄影 / 物联网 / UV 玻璃 / 激光雕刻……）见<a href="/hardcore-tech" class="text-brass-bright border-b border-brass-bright/40 hover:border-brass-bright transition-colors mx-1">硬核科技应用蓝图</a>。两者共同构成《科技观》在执行层的实证。
      </p>
    </div>
  </section>

  {/* ============== 三大平台架构 ============== */}
  <section class="editorial-section py-section fade-in">
    <div class="text-center mb-section">
      <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
        Architecture · 三大平台架构
      </p>
      <h2 class="display-title text-cream tracking-cn">
        三个客户端<br class="md:hidden" />共享同一云环境
      </h2>
      <p class="prose-cn max-w-editorial mx-auto text-text-soft mt-paragraph">
        消费者端、管理端、门店运营端三个平台共享同一微信云开发环境，数据实时互通——一次写入，多端可见。
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-px bg-brass-mid/10">
      {platforms.map((p) => (
        <article class="bg-ink-elevated/50 p-6 md:p-8 relative">
          <p class="font-serif-en italic text-brass-mid/40 absolute top-4 right-5"
             style="font-size: 2rem; line-height: 1;">
            {p.role}
          </p>
          <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
            {p.en}
          </p>
          <h3 class="font-serif text-2xl text-cream tracking-cn mb-1">{p.name}</h3>
          <p class="font-serif text-sm text-brass-mid tracking-cn mb-4">{p.side}</p>
          <p class="text-text-soft text-sm leading-[1.85] tracking-cn">{p.detail}</p>
        </article>
      ))}
    </div>

    <div class="mt-paragraph p-6 border-l-2 border-brass-mid/40 bg-ink-deep/40">
      <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
        Tech Stack · 技术栈
      </p>
      <p class="text-text-soft text-sm leading-[1.85] tracking-cn">
        微信小程序原生（WXML / WXSS / JS）· Vue 3 + Vite + Element Plus · Chart.js · 微信云开发（云函数 Node.js + 云数据库 + 云存储）· 阿里云 DashScope（通义千问多模态）
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  {/* ============== Part I · 官方小程序 ============== */}
  <section class="editorial-section py-section fade-in">
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
      Part I · Consumer-facing Mini Program
    </p>
    <h2 class="display-title text-cream tracking-cn mb-paragraph">
      官方小程序 · 消费者端
    </h2>
    <p class="prose-cn max-w-editorial mb-section text-text-soft">
      微信小程序是消费者触达山海造物的主要数字界面。以下所有功能均已实现并可运行。
    </p>

    {/* 2.1 核心商业闭环 */}
    <div class="mb-section">
      <h3 class="font-serif text-xl md:text-2xl text-brass-mid tracking-cn mb-4 pb-3 border-b border-brass-mid/20">
        2.1 核心商业闭环
      </h3>
      <dl class="divide-y divide-brass-mid/10">
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>商品浏览与下单
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
            博物标本室四大品类入口（神奇昆虫 / 群山回响 / 植物探微 / 无尽海洋）、商品详情页、评论体系（发布 / 点赞）、搜索（热词 + 推荐算法）、收藏箱与结算的完整链路。
          </dd>
        </div>
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>优惠券体系
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
            领取、转赠、最优券自动匹配——为长期会员准备，<strong class="text-cream">不做饥饿营销 / 抢购式发券</strong>。
          </dd>
        </div>
      </dl>
    </div>

    {/* 2.2 预约与到店体验 */}
    <div class="mb-section">
      <h3 class="font-serif text-xl md:text-2xl text-brass-mid tracking-cn mb-4 pb-3 border-b border-brass-mid/20">
        2.2 预约与到店体验
      </h3>
      <dl class="divide-y divide-brass-mid/10">
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>预约系统
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
            三类预约：入店参观（免费，生成电子通行证）/ 手作课程 / 特别活动。日期 + 时段选择、人数控制、候补队列、预约提醒。
          </dd>
        </div>
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>票务与核销
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
            电子票证设计（&ldquo;山海造物标本艺术馆&rdquo;票面）、店长端扫码核销。
          </dd>
        </div>
      </dl>
    </div>

    {/* 2.3 会员与留存 */}
    <div class="mb-section">
      <h3 class="font-serif text-xl md:text-2xl text-brass-mid tracking-cn mb-4 pb-3 border-b border-brass-mid/20">
        2.3 会员与留存体系
      </h3>
      <dl class="divide-y divide-brass-mid/10">
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>收藏家协会
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
            多等级会员体系（如&ldquo;曜石·策展人&rdquo;）、成长值积累、等级权益（折扣 / 专属活动）、每日签到、积分余额、优惠券。
          </dd>
        </div>
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>自然图鉴
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
            用户个人收藏数字化——购买的每件标本自动归入个人图鉴，支持创建文件夹、移动分类、推荐。
          </dd>
        </div>
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>成就系统
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
            游戏化解锁条件驱动复购和互动，后台可配置成就规则。
          </dd>
        </div>
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>行为埋点
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
            全链路用户行为追踪，后台可配置追踪规则。
          </dd>
        </div>
      </dl>
    </div>

    {/* 2.4 AI 标本鉴定 */}
    <div class="mb-section p-6 md:p-8 border border-brass-mid/30 bg-ink-elevated/40">
      <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
        Featured · 招牌能力
      </p>
      <h3 class="font-serif text-xl md:text-2xl text-cream tracking-cn mb-3">
        2.4 AI 标本鉴定
      </h3>
      <p class="font-serif text-base md:text-lg text-brass-bright tracking-cn mb-4 italic">
        &ldquo;拍一张照片，读懂自然&rdquo;
      </p>
      <p class="prose-cn text-text-soft">
        用户拍照或从相册选择图片，AI 识别物种并输出科普信息。技术实现：调用阿里云 DashScope 多模态接口（通义千问），鉴定结果落库保存，支持生成分享海报。
      </p>
      <p class="prose-cn text-text-soft mt-3">
        这个功能在<strong class="text-cream">门店场景</strong>和<strong class="text-cream">线上场景</strong>均可使用，强化&ldquo;科学 + 美学&rdquo;的品牌认知。
      </p>
    </div>

    {/* 2.5 内容与社区 */}
    <div>
      <h3 class="font-serif text-xl md:text-2xl text-brass-mid tracking-cn mb-4 pb-3 border-b border-brass-mid/20">
        2.5 内容与社区
      </h3>
      <p class="prose-cn text-text-soft">
        文章栏目、视频内容、百科档案、社区互动、站内消息系统。底部导航五 Tab：探索 / 百科 / 社区 / 收藏箱 / 我的。
      </p>
    </div>
  </section>

  <hr class="brass-divider" />

  {/* ============== Part II · 数智化中台 ============== */}
  <section class="editorial-section py-section fade-in">
    <p class="font-serif-en italic text-brass-mid text-xs tracking-widest uppercase mb-3">
      Part II · Backend Operations Platform
    </p>
    <h2 class="display-title text-cream tracking-cn mb-paragraph">
      数智化中台 · 管理端
    </h2>
    <p class="prose-cn max-w-editorial mb-section text-text-soft">
      基于 Vue 3 + Element Plus 的单页应用，与小程序共享同一云环境，数据实时互通。<strong class="text-cream">27 个功能模块</strong>，覆盖经营全链路。
    </p>

    {/* 3.1 全局概览 */}
    <div class="mb-section">
      <h3 class="font-serif text-xl md:text-2xl text-brass-mid tracking-cn mb-4 pb-3 border-b border-brass-mid/20">
        3.1 全局概览 <span class="text-text-dim text-base">· 5 个模块</span>
      </h3>
      <dl class="divide-y divide-brass-mid/10">
        <div class="grid md:grid-cols-[200px_1fr] gap-3 md:gap-8 py-5">
          <dt class="font-serif text-cream tracking-cn">
            <span class="text-brass-mid mr-2">▸</span>经营驾驶舱
          </dt>
          <dd class="text-text-soft text-sm leading-[1.85] tracking-cn">
