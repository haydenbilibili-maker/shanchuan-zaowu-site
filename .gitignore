# build output
dist/
.output/

# ERP 构建产物（由 npm run build 生成；历史曾把 ADMIN_OPS_KEY 带进这些文件并入库发布）
# 2026-09-17 审计 D7：原规则只挡了 assets/ 与 index.html，导致 brand/、*.html、*.pdf、*.svg
# 等 7 项「admin/public → public/admin」的副本被双份入库（约 2.9MB）。现在整目录忽略，
# 只保留两个手写文件；构建时其余会重新生成。
/public/admin/*
!/public/admin/README.md
!/public/admin/cloud-check.html

# 脚本运行产物：14/23 份含真实 _openid（PII），一律不入库（2026-09-17 审计 D7）
/miniprogram/scripts/*.result.json

# local snapshots（审计/备份快照，不入版本库）
backups/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.local
.env.*.local
# 小程序码/物料生成用的一次性密钥（scripts/generate-store-qr.js 读它）
# ⚠️ 2026-09-18：脚本注释里一直写着"该文件已 gitignore"，但实际**没有** ——
# 照注释把 AppSecret 写进去就会被提交。补上，并由 check:wall-qr 守卫钉住。
scripts/.env.qr
miniprogram/scripts/.env.qr

