{
  "name": "shanhai-zaowu-site",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "admin"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:admin": "npm run dev -w admin",
    "start": "astro dev",
    "build:admin": "node scripts/build-admin.mjs",
    "build": "npm run build:admin && astro build && node scripts/verify-admin-dist.mjs",
    "pages:deploy": "wrangler pages deploy dist --project-name=shanchuan-zaowu-site --branch=main",
    "check:fn-sync": "node scripts/check-cloud-functions-sync.cjs",
    "check:cloud-files": "node miniprogram/scripts/check-cloud-files.cjs",
    "sync:miniprogram": "node scripts/check-miniprogram-sync.mjs --fix",
    "sync:miniprogram:check": "node scripts/check-miniprogram-sync.mjs",
    "lint:wxml": "node miniprogram/scripts/check-wxml.mjs miniprogram",
    "lint:wxml:selftest": "node miniprogram/scripts/check-wxml.mjs --selftest",
    "check:welcome-gift": "node miniprogram/scripts/check-welcome-gift-config.cjs",
    "check:welcome-gift:selftest": "node miniprogram/scripts/check-welcome-gift-config.cjs --selftest",
    "check:store-points": "node miniprogram/scripts/check-store-point-rules-sync.cjs",
    "check:store-points:selftest": "node miniprogram/scripts/check-store-point-rules-sync.cjs --selftest",
    "pages:version": "true",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/tailwind": "^5.1.4",
    "@cloudbase/js-sdk": "^2.9.1",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "astro": "^5.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
