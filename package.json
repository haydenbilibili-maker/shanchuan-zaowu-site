{
  "name": "shanhai-zaowu-site",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "admin"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:admin": "npm run dev -w admin",
    "start": "astro dev",
    "build:admin": "node scripts/build-admin.mjs",
    "build": "npm run build:admin && astro build && node scripts/verify-admin-dist.mjs",
    "pages:deploy": "wrangler pages deploy dist --project-name=shanchuan-zaowu-site --branch=main",
    "check:fn-sync": "node scripts/check-cloud-functions-sync.cjs",
    "check:cloud-files": "node miniprogram/scripts/check-cloud-files.cjs",
    "sync:miniprogram": "node scripts/check-miniprogram-sync.mjs --fix",
    "sync:miniprogram:check": "node scripts/check-miniprogram-sync.mjs",
    "lint:wxml": "node miniprogram/scripts/check-wxml.mjs miniprogram",
    "lint:wxml:selftest": "node miniprogram/scripts/check-wxml.mjs --selftest",
    "check:welcome-gift": "node miniprogram/scripts/check-welcome-gift-config.cjs",
    "check:welcome-gift:selftest": "node miniprogram/scripts/check-welcome-gift-config.cjs --selftest",
    "check:store-points": "node miniprogram/scripts/check-store-point-rules-sync.cjs",
    "check:store-points:selftest": "node miniprogram/scripts/check-store-point-rules-sync.cjs --selftest",
    "check:brand-contrast": "node admin/scripts/check-brand-contrast.mjs",
    "check:brand-contrast:selftest": "node admin/scripts/check-brand-contrast.mjs --selftest",
    "test:write-layer": "node admin/scripts/test-write-layer.mjs",
    "test:write-layer:selftest": "node admin/scripts/test-write-layer.mjs --selftest",
    "check:silent-catch": "node admin/scripts/check-silent-catch.mjs",
    "check:silent-catch:update": "node admin/scripts/check-silent-catch.mjs --update",
    "check:silent-catch:selftest": "node admin/scripts/check-silent-catch.mjs --selftest",
    "test:module-hash": "node admin/scripts/test-module-hash.mjs",
    "test:module-hash:selftest": "node admin/scripts/test-module-hash.mjs --selftest",
    "test:module-search": "node admin/scripts/test-module-search.mjs",
    "test:module-search:selftest": "node admin/scripts/test-module-search.mjs --selftest",
    "test:coupon-floor": "node admin/scripts/test-coupon-floor.mjs",
    "test:coupon-floor:selftest": "node admin/scripts/test-coupon-floor.mjs --selftest",
    "check:nav-sources": "node admin/scripts/check-nav-sources.mjs",
    "check:nav-sources:selftest": "node admin/scripts/check-nav-sources.mjs --selftest",
    "check:sfc-dev": "node admin/scripts/check-sfc-dev-transform.mjs",
    "check:sfc-dev:selftest": "node admin/scripts/check-sfc-dev-transform.mjs --selftest",
    "check:nav-dom": "node admin/scripts/check-nav-dom.mjs",
    "check:nav-dom:selftest": "node admin/scripts/check-nav-dom.mjs --selftest",
    "audit:collections": "node admin/scripts/audit-live-collections.mjs",
    "audit:collections:json": "node admin/scripts/audit-live-collections.mjs --json",
    "audit:collections:strict": "node admin/scripts/audit-live-collections.mjs --strict",
    "audit:collections:update": "node admin/scripts/audit-live-collections.mjs --update",
    "audit:collections:selftest": "node admin/scripts/audit-live-collections.mjs --selftest",
    "check:admin": "npm run check:sfc-dev && npm run check:nav-sources && npm run check:silent-catch && npm run check:brand-contrast && npm run check:welcome-gift && npm run check:store-points && npm run test:write-layer && npm run test:module-hash && npm run test:module-search && npm run test:coupon-floor",
    "check:admin:selftest": "npm run check:sfc-dev:selftest && npm run check:nav-sources:selftest && npm run check:silent-catch:selftest && npm run check:brand-contrast:selftest && npm run check:welcome-gift:selftest && npm run check:store-points:selftest && npm run test:write-layer:selftest && npm run test:module-hash:selftest && npm run test:module-search:selftest && npm run test:coupon-floor:selftest",
    "pages:version": "true",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/tailwind": "^5.1.4",
    "@cloudbase/js-sdk": "^2.9.1",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "astro": "^5.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
