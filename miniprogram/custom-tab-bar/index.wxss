/* custom-tab-bar/index.wxss — 与 app 导航规范一致 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: rgba(26, 24, 20, 0.97);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 9999;
  border-top: 1px solid rgba(38, 35, 32, 0.55);
  box-shadow: none;
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  transition: all 0.2s ease-in-out;
  position: relative;
}

/* 选中态：轻微强调，无发光 */
.tab-bar-item.active {
  transform: scale(1.04);
}

/* 点击反馈效果 */
.tab-bar-item-hover {
  opacity: 0.7;
  transform: scale(0.98);
}

.tab-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 6rpx;
  transition: all 0.3s;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  transition: color 0.25s ease;
}

.tab-bar-item.active .tab-text {
  text-shadow: none;
  font-weight: 600;
}

.tab-badge {
  position: absolute;
  top: 2rpx;
  right: 50%;
  margin-right: -42rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 9999px;
  background: #D64045;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  box-sizing: border-box;
}