/* utils/tools.wxs */
var calcRate = function(price, cost) {
  if (!price || price == 0) return '0.0';
  var p = parseFloat(price);
  var c = parseFloat(cost);
  if (isNaN(p) || isNaN(c)) return '0.0';
  var rate = (p - c) / p * 100;
  return rate.toFixed(1);
}
module.exports = {
  calcRate: calcRate
};