<!--components/WallFeed/index.wxml
  「祈福内容流」自包含组件（PRD §11.1 R2）。

  为什么是组件：祈福墙主页面正被 R1（玩法大改）编辑，内容流不能和它挤在同一批文件里。
  这里用「属性进 / 事件出」与页面解耦：
    · 页面给 `items` / `mineRows` / 各种 loading|error 位 / `allowed` / `hasMore` / `manageable`；
    · 组件自己持有**视图态**（两栏切换、筛选、排序、分页游标、加载更多状态机、详情层）；
    · 组件**不发云调用**，任何写操作只 `triggerEvent` 出去（见 index.js 顶部的契约表）。

  ⚠️ 类名一律 `wf-` 前缀：本组件与页面同处一个文档，页面用的是 `ww-` 前缀，
     全仓唯一性由 test-wish-wall 的全局撞名守卫兜底。

  ⚠️ 结构纪律（本仓踩过的编译级坑）：`wx:for` 与 `wx:if` **不许写在同一标签上** ——
     编译器不把它当 elif 链的起点，`wx:elif` 会报「wx:if not found」，
     整个分包编译失败。所以下面凡是"循环 + 条件"都套一层 `<block>`。 -->
<view class="wf" wx:if="{{allowed}}">
  <!-- 两栏：墙上的愿签 / 我的心愿（条数各挂各自那一段，语义自明） -->
  <view class="wf-seg" aria-role="tablist">
    <view
      class="wf-seg-item {{viewMode === 'wall' ? 'is-on' : ''}}"
      bindtap="onSwitchView"
      data-view="wall"
      hover-class="wf-press"
      hover-stay-time="70"
      aria-role="tab"
      aria-selected="{{viewMode === 'wall'}}"
    >
      <text class="wf-seg-label">墙上的愿签</text>
      <text class="wf-seg-n" wx:if="{{wallCount}}">{{wallCount}}</text>
    </view>
    <view
      class="wf-seg-item {{viewMode === 'mine' ? 'is-on' : ''}}"
      bindtap="onSwitchView"
      data-view="mine"
      hover-class="wf-press"
      hover-stay-time="70"
      aria-role="tab"
      aria-selected="{{viewMode === 'mine'}}"
    >
      <text class="wf-seg-label">我的心愿</text>
      <text class="wf-seg-n" wx:if="{{mineTotal}}">{{mineTotal}}</text>
    </view>
  </view>

  <!-- 筛选 + 排序：两个维度都只作用在**已取回的数据**上，不新增服务端契约 -->
  <view class="wf-controls">
    <view class="wf-chips" aria-role="tablist">
      <view
        class="wf-chip {{filter === item.id ? 'is-on' : ''}}"
        wx:for="{{filters}}"
        wx:key="id"
        bindtap="onFilter"
        data-filter="{{item.id}}"
        hover-class="wf-press"
        hover-stay-time="70"
        aria-role="tab"
        aria-selected="{{filter === item.id}}"
      >{{item.label}}</view>
    </view>
    <view class="wf-sorts" aria-role="tablist">
      <text class="wf-sort-lead">排序</text>
      <view
        class="wf-sort {{sort === item.id ? 'is-on' : ''}}"
        wx:for="{{sorts}}"
        wx:key="id"
        bindtap="onSort"
        data-sort="{{item.id}}"
        hover-class="wf-press"
        hover-stay-time="70"
        aria-role="tab"
        aria-selected="{{sort === item.id}}"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- ① 加载中：骨架**沿用两列瀑布的结构**（不是三条通栏）——列宽、卡高与真卡一致，数据到达时不跳高。
       整块是装饰，全部 aria-hidden（否则读屏把"正在加载"念成几个没有内容的空元素）。 -->
  <block wx:if="{{showSkeleton}}">
    <view class="wf-cols">
      <view class="wf-col">
        <view class="wf-skel" wx:for="{{[1, 2]}}" wx:key="*this">
          <view class="wf-skel-pin" aria-hidden="true"></view>
          <view class="wf-skel-line is-w1" aria-hidden="true"></view>
          <view class="wf-skel-line is-w2" aria-hidden="true"></view>
        </view>
      </view>
      <view class="wf-col">
        <view class="wf-skel" wx:for="{{[1, 2]}}" wx:key="*this">
          <view class="wf-skel-pin" aria-hidden="true"></view>
          <view class="wf-skel-line is-w1" aria-hidden="true"></view>
          <view class="wf-skel-line is-w2" aria-hidden="true"></view>
        </view>
      </view>
    </view>
  </block>

  <!-- ② 失败：说"没读到" + 给重试。**绝不与空文案同时出现** -->
  <view class="wf-error" wx:elif="{{showError}}">
    <text class="wf-error-text">{{errorText}}</text>
    <view class="wf-error-retry" bindtap="onRetry" hover-class="wf-press" hover-stay-time="70" aria-role="button">再试一次</view>
  </view>

  <block wx:else>
    <!-- 两列瀑布：与改造前的分列口径逐项一致（同一个 splitTagColumns 函数） -->
    <view class="wf-cols" wx:if="{{!showEmpty}}">
      <view class="wf-col" wx:for="{{columns}}" wx:for-item="col" wx:for-index="ci" wx:key="ci">
        <view
          class="wf-card {{item.isFresh ? 'is-fresh' : ''}} {{item.isMine ? 'is-mine' : ''}} {{item.hidden ? 'is-hidden' : ''}}"
          wx:for="{{col}}"
          wx:for-item="item"
          wx:key="_id"
          bindtap="onOpen"
          data-id="{{item._id}}"
          hover-class="wf-card-press"
          hover-stay-time="70"
          aria-role="button"
        >
          <view class="wf-card-pin" aria-hidden="true"></view>
          <!-- 印记优先级：已收起 > 置顶（都是"你需要先知道"的信息）。
               「我的」不再盖章（重复 5 次的信息不是信息）—— 改用左侧一道铜边 .is-mine -->
          <text class="wf-card-seal is-hidden" wx:if="{{item.hidden}}">已收起</text>
          <text class="wf-card-seal" wx:elif="{{item.pinned}}">置顶</text>
          <!-- 正文：**行数与截断**必须写死，长文案不许撑破卡片（几何判据见渲染台） -->
          <text class="wf-card-text">{{item.text}}</text>
          <view class="wf-card-foot">
            <image wx:if="{{item.avatar}}" class="wf-card-avatar" src="{{item.avatar}}" mode="aspectFill" lazy-load aria-hidden="true"></image>
            <text class="wf-card-meta">{{item.nickname}} · {{item.timeText}}</text>
          </view>
          <!-- 我的心愿：一眼看出"哪些是我的、状态如何" -->
          <view class="wf-card-state" wx:if="{{viewMode === 'mine'}}">
            <text class="wf-card-state-text {{item.hidden ? 'is-hidden' : 'is-live'}}">{{item.hidden ? '已被馆方收起 · 未公开展示' : '已上墙 · 公开可见'}}</text>
          </view>
          <!-- 管理动作：只在页面声明 manageable 时出现（写操作**只出事件**，组件不调云函数） -->
          <view class="wf-card-acts" wx:if="{{viewMode === 'mine' && manageable}}">
            <view
              class="wf-act"
              catchtap="onManage"
              data-id="{{item._id}}"
              data-act="{{item.hidden ? 'restore' : 'hide'}}"
              hover-class="wf-press"
              hover-stay-time="70"
              aria-role="button"
            >{{item.hidden ? '恢复上墙' : '收起'}}</view>
            <view
              class="wf-act is-danger"
              catchtap="onManage"
              data-id="{{item._id}}"
              data-act="delete"
              hover-class="wf-press"
              hover-stay-time="70"
              aria-role="button"
            >删除</view>
          </view>
        </view>
      </view>
    </view>

    <!-- ③ 空：**只在确认成功且为空**时出现（showEmpty 已把 loading / error 排除在外） -->
    <view class="wf-empty" wx:if="{{showEmpty}}">{{emptyText}}</view>

    <!-- 加载更多状态机：可加载 / 加载中 / 没有更多 / 失败可重试（四态各占一行） -->
    <view class="wf-more" wx:if="{{!showEmpty}}">
      <view class="wf-more-btn" wx:if="{{loadState === 'canload'}}" bindtap="onLoadMore" hover-class="wf-press" hover-stay-time="70" aria-role="button">{{loadLabel}}</view>
      <view class="wf-more-loading" wx:elif="{{loadState === 'loading'}}">
        <view class="wf-more-dot" aria-hidden="true"></view>
        <text class="wf-more-text">正在加载…</text>
      </view>
      <view class="wf-more-end" wx:elif="{{loadState === 'nomore'}}">
        <view class="wf-end-rule" aria-hidden="true"></view>
        <!-- 打到服务端上限时必须如实说「仅展示最近 N 条」，不能装作全量（页面传 capped，纯函数给 endText） -->
        <text class="wf-end-text">{{endText}}</text>
        <view class="wf-end-rule" aria-hidden="true"></view>
      </view>
      <block wx:elif="{{loadState === 'error'}}">
        <text class="wf-more-error">{{errorText}}</text>
        <view class="wf-more-retry" bindtap="onRetry" hover-class="wf-press" hover-stay-time="70" aria-role="button">再试一次</view>
      </block>
    </view>
  </block>
</view>

<!-- 愿签详情：明确的层级（遮罩 + 升起的笺）与**两种**关闭方式（点遮罩 / 点「收起」） -->
<view
  class="wf-mask"
  wx:if="{{detail}}"
  bindtap="onCloseDetail"
  catchtouchmove="noop"
  aria-role="button"
  aria-label="关闭愿签详情"
></view>
<view class="wf-sheet" wx:if="{{detail}}" catchtap="noop" aria-role="dialog" aria-label="愿签详情">
  <view class="wf-sheet-grip" aria-hidden="true"><view class="wf-sheet-grip-bar"></view></view>
  <view class="wf-sheet-head">
    <text class="wf-sheet-over">愿签</text>
    <view class="wf-sheet-close" bindtap="onCloseDetail" hover-class="wf-press" hover-stay-time="70" aria-role="button">收起</view>
  </view>
  <view class="wf-sheet-seals">
    <text class="wf-sheet-seal is-warn" wx:if="{{detail.hidden}}">已被馆方收起</text>
    <text class="wf-sheet-seal" wx:if="{{detail.isMine}}">我的</text>
    <text class="wf-sheet-seal" wx:if="{{detail.pinned}}">置顶</text>
  </view>
  <!-- 详情层的正文**不截断**（这正是"更完整的详情"与卡片截断的分工） -->
  <text class="wf-sheet-text">{{detail.text}}</text>
  <view class="wf-sheet-meta">
    <image wx:if="{{detail.avatar}}" class="wf-sheet-avatar" src="{{detail.avatar}}" mode="aspectFill" aria-hidden="true"></image>
    <text class="wf-sheet-who">{{detail.nickname}}</text>
    <text class="wf-sheet-time">{{detail.timeText}}</text>
    <text class="wf-sheet-count" wx:if="{{detailCount}}">{{detailCount}} 字</text>
  </view>
  <view class="wf-sheet-acts">
    <view class="wf-sheet-act" bindtap="onBorrow" hover-class="wf-press" hover-stay-time="70" aria-role="button">抄一句</view>
    <view class="wf-sheet-act" bindtap="onCopy" hover-class="wf-press" hover-stay-time="70" aria-role="button">复制</view>
  </view>
  <view class="wf-sheet-manage" wx:if="{{detail.isMine && manageable}}">
    <view
      class="wf-act"
      catchtap="onManage"
      data-id="{{detail._id}}"
      data-act="{{detail.hidden ? 'restore' : 'hide'}}"
      hover-class="wf-press"
      hover-stay-time="70"
      aria-role="button"
    >{{detail.hidden ? '恢复上墙' : '收起'}}</view>
    <view
      class="wf-act is-danger"
      catchtap="onManage"
      data-id="{{detail._id}}"
      data-act="delete"
      hover-class="wf-press"
      hover-stay-time="70"
      aria-role="button"
    >删除</view>
  </view>
</view>
