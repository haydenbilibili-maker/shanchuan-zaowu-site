/* components/WallFeed/index.wxss
 * 「祈福内容流」组件样式 —— **自包含**：不引用页面 .ww-* 的任何规则，只用设计令牌。
 *
 * 三条纪律（都来自产品负责人 2026-09-21「排版不合理」这条主诉）：
 *   ① 对齐：分段控件 / 筛选行 / 两列瀑布共用同一条左基线（组件不带左右内边距，
 *      沿用页面 `.ww-page` 的 --space-4，与改造前的愿签列表同一条线）；
 *   ② 间距节奏：只用 --space-* 令牌；同类元素同距（卡间距 14rpx、组间距 --space-3）；
 *   ③ 字阶：一律 var(--fs-*)，不写裸字号（新代码不得引入非令牌字号）；
 *   ④ 可点区 ≥88rpx：分段 / 筛选 / 排序 / 加载更多 / 详情关闭 / 卡片 / 管理动作逐条钉住。
 */

.wf {
  position: relative;
  z-index: 1;
  display: block;
}

/* ── 两栏分段（沿用页面同款"切换"语言，但类名走 wf- 前缀，组件自包含） ── */
.wf-seg {
  display: inline-flex;
  align-items: center;
  padding: 4rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.06);
}

.wf-seg-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  /* 可点区：88rpx（44pt）是可用的下限，低于它真机上容易点不中 */
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
}

.wf-seg-item.is-on {
  background: rgba(196, 167, 108, 0.16);
}

.wf-seg-label {
  font-size: var(--fs-24);
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
}

.wf-seg-item.is-on .wf-seg-label {
  color: var(--brass-200);
}

.wf-seg-n {
  font-size: var(--fs-18);
  font-family: var(--font-mono);
  color: var(--color-text-muted);
}

/* ── 筛选 + 排序 ── */
.wf-controls {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.wf-chips,
.wf-sorts {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.wf-sort-lead {
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

.wf-chip,
.wf-sort {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 0 var(--space-2);
  font-size: var(--fs-22);
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.04);
}

.wf-chip.is-on,
.wf-sort.is-on {
  color: var(--color-bg);
  border-color: var(--brass-400);
  background: var(--brass-400);
}

/* ── 两列瀑布（列间等宽、列内纵向堆叠；与改造前的分列口径同一套） ── */
.wf-cols {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: var(--space-3);
}

.wf-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* ── 愿签卡 ── */
.wf-card {
  position: relative;
  display: block;
  min-height: 88rpx;
  padding: var(--space-6) var(--space-2) var(--space-2) 22rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #221F1A 0%, #1B1917 100%);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

/* 左侧铜线是"签绳"（同时也是「我的」的标记位，见 .is-mine） */
.wf-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.7) 0%, rgba(196, 167, 108, 0.12) 100%);
}

.wf-card.is-mine::before {
  width: 5rpx;
  background: linear-gradient(180deg, var(--brass-300) 0%, rgba(196, 167, 108, 0.4) 100%);
}

.wf-card.is-fresh {
  border-color: rgba(196, 167, 108, 0.6);
  /* ⚠️ 2026-09-22 接线时的**最小修正②**（已在交付说明单列）：改造前页面愿签卡的
     `.ww-tag.is-fresh` 带一层入场动效（`ww-fresh-in`）—— 「刚落愿看得见」是**已上判据**的行为。
     组件原先只有静态铜边，直接接线会把这一层动效弄丢。这里按同一手法补回来
     （opacity + translateY + scale，0.5s ease-out both），不做别的样式改动。 */
  animation: wf-fresh-in 0.5s ease-out both;
}

@keyframes wf-fresh-in {
  from { opacity: 0; transform: translateY(-12rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.wf-card-press {
  opacity: 0.78;
}

.wf-card-pin {
  position: absolute;
  left: 5rpx;
  top: 17rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, var(--brass-200) 0%, var(--brass-500) 70%);
}

.wf-card-seal {
  position: absolute;
  right: 12rpx;
  top: 14rpx;
  padding: 2rpx var(--space-1);
  font-size: var(--fs-16);
  line-height: 1.4;
  letter-spacing: 0.04em;
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 6rpx;
  background: rgba(196, 167, 108, 0.08);
}

.wf-card-seal.is-hidden {
  color: var(--color-warning);
  border-color: rgba(233, 162, 59, 0.5);
  background: rgba(233, 162, 59, 0.1);
}

/* 正文：**行数上限 + 硬高度上限**双保险 —— 长文案不许撑破卡片。
   为什么两条都要：`-webkit-line-clamp` 在各端内核的 `<text>` 上支持并不一致，
   而 `max-height`（= 字号 × 行高 × 4 行）是不依赖内核的几何硬边界。
   渲染台按真实 DOM 量 `.wf-card-text` 的行数与卡高，两者都要过。 */
.wf-card-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  max-height: calc(var(--fs-30) * 6);
  overflow: hidden;
  font-family: var(--font-hand);
  font-size: var(--fs-30);
  line-height: 1.5;
  color: var(--brass-100);
  word-break: break-all;
}

.wf-card-foot {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-top: 10rpx;
  min-width: 0;
}

.wf-card-avatar {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.24);
}

.wf-card-meta {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 我的心愿：状态 + 管理动作 ── */
.wf-card-state {
  margin-top: var(--space-1);
}

.wf-card-state-text {
  font-size: var(--fs-18);
  letter-spacing: 0.04em;
}

.wf-card-state-text.is-live {
  color: var(--brass-300);
}

.wf-card-state-text.is-hidden {
  color: var(--color-warning);
}

.wf-card-acts,
.wf-sheet-manage {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.wf-act {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 0 var(--space-1);
  font-size: var(--fs-22);
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.05);
}

/* 删除：用「警示色 + 红边」表达破坏性，但**文字色取 --color-warning**。
   为什么不用 --color-error：实测 #D64045 落在本卡的深色面上对比度 4.02 < 4.5
   （check:mp-contrast 直接判违规）；warning 色在深色面上 ~7.7，是真读得清的。 */
.wf-act.is-danger {
  color: var(--color-warning);
  border-color: rgba(214, 64, 69, 0.5);
  background: rgba(214, 64, 69, 0.08);
}

/* ── 三态：骨架 / 错误 / 空 ── */
.wf-skel {
  position: relative;
  padding: var(--space-6) var(--space-2) var(--space-2) 22rpx;
  min-height: 196rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: linear-gradient(180deg, #221F1A 0%, #1B1917 100%);
}

.wf-skel-pin {
  position: absolute;
  left: 5rpx;
  top: 17rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.3);
}

.wf-skel-line {
  height: 24rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.06) 0%, rgba(196, 167, 108, 0.18) 50%, rgba(196, 167, 108, 0.06) 100%);
  background-size: 200% 100%;
  animation: wf-shimmer 1.5s ease-in-out infinite;
}

.wf-skel-line.is-w1 { width: 78%; }

.wf-skel-line.is-w2 {
  width: 52%;
  margin-top: var(--space-2);
}

@keyframes wf-shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.wf-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-5) var(--space-2);
  margin-top: var(--space-3);
  border: 1rpx dashed rgba(233, 162, 59, 0.35);
  border-radius: var(--radius-md);
  background: rgba(233, 162, 59, 0.05);
}

.wf-error-text {
  font-size: var(--fs-24);
  line-height: 1.5;
  text-align: center;
  color: var(--color-text-body);
}

.wf-error-retry,
.wf-more-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 200rpx;
  padding: 0 var(--space-4);
  font-size: var(--fs-24);
  color: var(--color-bg);
  border-radius: 999rpx;
  background: var(--brass-400);
}

.wf-empty {
  padding: var(--space-5) 0;
  margin-top: var(--space-3);
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-muted);
}

/* ── 加载更多状态机（可加载 / 加载中 / 没有更多 / 失败可重试） ── */
.wf-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-height: 88rpx;
  margin: var(--space-3) 0 var(--space-1);
}

.wf-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 240rpx;
  padding: 0 var(--space-5);
  font-size: var(--fs-24);
  letter-spacing: 0.04em;
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.06);
}

.wf-more-loading {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 88rpx;
}

.wf-more-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brass-400);
  animation: wf-breathe 1.1s ease-in-out infinite;
}

@keyframes wf-breathe {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

.wf-more-text {
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: var(--color-text-muted);
}

.wf-more-end {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  width: 100%;
  min-height: 88rpx;
}

.wf-end-rule {
  flex: 1;
  height: 1px;
  background: rgba(196, 167, 108, 0.16);
}

.wf-end-text {
  flex-shrink: 0;
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

.wf-more-error {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-22);
  color: var(--color-text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 愿签详情：遮罩 + 从底部升起的笺（明确的层级与两种关闭方式） ── */
.wf-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(12, 11, 9, 0.72);
}

.wf-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  max-height: 82vh;
  padding: var(--space-2) var(--space-4) calc(var(--space-5) + env(safe-area-inset-bottom));
  overflow-y: auto;
  background: linear-gradient(180deg, #26231E 0%, #1B1917 100%);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  box-shadow: 0 -12rpx 32rpx rgba(0, 0, 0, 0.5);
}

.wf-sheet-grip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
}

.wf-sheet-grip-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.4);
}

.wf-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  min-height: 88rpx;
}

.wf-sheet-over {
  font-size: var(--fs-20);
  letter-spacing: 0.24em;
  color: var(--color-text-muted);
}

/* 关闭：88×88rpx 的可点区（原来那种"一行小字"真机点不中） */
.wf-sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 88rpx;
  padding: 0 var(--space-2);
  font-size: var(--fs-24);
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: 999rpx;
}

.wf-sheet-seals {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.wf-sheet-seal {
  padding: 2rpx var(--space-1);
  font-size: var(--fs-18);
  letter-spacing: 0.04em;
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 6rpx;
  background: rgba(196, 167, 108, 0.08);
}

.wf-sheet-seal.is-warn {
  color: var(--color-warning);
  border-color: rgba(233, 162, 59, 0.5);
  background: rgba(233, 162, 59, 0.1);
}

/* 详情层正文**不截断**：这是它与卡片（4 行封顶）的分工 */
.wf-sheet-text {
  display: block;
  font-family: var(--font-hand);
  font-size: var(--fs-34);
  line-height: 1.6;
  color: var(--brass-100);
  word-break: break-all;
}

.wf-sheet-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-3);
  min-width: 0;
}

.wf-sheet-avatar {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.24);
}

.wf-sheet-who {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.wf-sheet-time {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wf-sheet-count {
  flex-shrink: 0;
  font-size: var(--fs-18);
  font-family: var(--font-mono);
  color: var(--color-text-muted);
}

.wf-sheet-acts {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.wf-sheet-act {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 88rpx;
  min-width: 88rpx;
  font-size: var(--fs-24);
  letter-spacing: 0.04em;
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.06);
}

/* 统一的按压反馈：本组件所有可点元素共用同一条 hover-class（同族同值） */
.wf-press {
  opacity: 0.75;
}
