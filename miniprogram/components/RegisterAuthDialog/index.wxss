/* 注册引导 / 一键注册弹窗 —— 博物黑 + 铜金铭牌（令牌取 app.wxss） */

.rad-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(12, 11, 9, 0.72);
  transition: opacity 0.28s ease;
}
.rad-mask.is-on { opacity: 1; }
.rad-mask.is-off { opacity: 0; }

/* 铭牌：与 sensitive-blur-gate 的 .sb-plate 同一套视觉语言 */
.rad-plate {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  padding: 44rpx 40rpx 32rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  border-radius: var(--radius-md, 16rpx);
  background: linear-gradient(180deg, #221F1B 0%, #1A1814 100%);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.55);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rad-corner {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-color: rgba(196, 167, 108, 0.8);
  border-style: solid;
  border-width: 0;
}
.rad-corner.is-tl { left: 12rpx; top: 12rpx; border-left-width: 2rpx; border-top-width: 2rpx; }
.rad-corner.is-tr { right: 12rpx; top: 12rpx; border-right-width: 2rpx; border-top-width: 2rpx; }
.rad-corner.is-bl { left: 12rpx; bottom: 12rpx; border-left-width: 2rpx; border-bottom-width: 2rpx; }
.rad-corner.is-br { right: 12rpx; bottom: 12rpx; border-right-width: 2rpx; border-bottom-width: 2rpx; }

.rad-overline {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(196, 167, 108, 0.75);
  font-family: var(--font-din, inherit);
  margin-bottom: 16rpx;
}

.rad-title {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--text-main, #FFFFFF);
  letter-spacing: 1rpx;
  text-align: center;
  line-height: 1.35;
}

.rad-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-sub, #A09A90);
  text-align: center;
}

.rad-perks {
  width: 100%;
  margin: 28rpx 0 8rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.16);
  box-sizing: border-box;
}
.rad-perk {
  display: flex;
  align-items: center;
  padding: 7rpx 0;
}
.rad-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold, #C4A76C);
  margin-right: 14rpx;
  flex-shrink: 0;
}
.rad-perk-t {
  font-size: 24rpx;
  color: var(--text-body, #D5D1C8);
  line-height: 1.5;
}

.rad-cta {
  width: 100%;
  margin-top: 26rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border: none;
  border-radius: var(--radius-sm, 8rpx);
  background: linear-gradient(180deg, #D8BC80 0%, #C4A76C 55%, #A8903C 100%);
  color: #1A1814;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}
.rad-cta::after { border: none; }
.rad-cta-press { opacity: 0.88; }
.rad-cta[disabled] { opacity: 0.6; }

.rad-fineprint {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: var(--text-muted, #6B6560);
  text-align: center;
  line-height: 1.6;
}
.rad-link { color: rgba(196, 167, 108, 0.9); }

.rad-close {
  margin-top: 22rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-sub, #A09A90);
}
.rad-close-press { opacity: 0.7; }
