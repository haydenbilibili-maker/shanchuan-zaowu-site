/* 全站样式化弹窗 —— 令牌取 app.wxss；与 RegisterAuthDialog / sensitive-blur-gate 同语言 */

.am-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 950;                     /* 略高于注册弹窗(900)，保证"确认"盖在最上层 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56rpx;
  box-sizing: border-box;
  background: rgba(12, 11, 9, 0.72);
  transition: opacity 0.24s ease;
}
.am-mask.is-on { opacity: 1; }
.am-mask.is-off { opacity: 0; }

.am-plate {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  padding: 40rpx 36rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  border-radius: var(--radius-md, 16rpx);
  background: linear-gradient(180deg, #221F1B 0%, #1A1814 100%);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.55);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.am-corner {
  position: absolute;
  width: 14rpx; height: 14rpx;
  border-color: rgba(196, 167, 108, 0.8);
  border-style: solid;
  border-width: 0;
}
.am-corner.is-tl { left: 12rpx; top: 12rpx; border-left-width: 2rpx; border-top-width: 2rpx; }
.am-corner.is-tr { right: 12rpx; top: 12rpx; border-right-width: 2rpx; border-top-width: 2rpx; }
.am-corner.is-bl { left: 12rpx; bottom: 12rpx; border-left-width: 2rpx; border-bottom-width: 2rpx; }
.am-corner.is-br { right: 12rpx; bottom: 12rpx; border-right-width: 2rpx; border-bottom-width: 2rpx; }

.am-overline {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(196, 167, 108, 0.75);
  margin-bottom: 12rpx;
}

.am-title {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text-main, #FFFFFF);
  text-align: center;
  line-height: 1.4;
}

.am-content {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--text-sub, #A09A90);
  text-align: center;
  white-space: pre-wrap;         /* 与 showModal 的 \n 换行语义一致 */
}

.am-actions {
  width: 100%;
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.am-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--radius-sm, 8rpx);
  font-size: 29rpx;
  font-weight: 800;
}
.am-btn.is-ghost {
  color: var(--text-sub, #A09A90);
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}
.am-btn.is-primary {
  color: #1A1814;
  background: linear-gradient(180deg, #D8BC80 0%, #C4A76C 55%, #A8903C 100%);
}
.am-btn.is-primary.is-danger {
  color: #FFF3F0;
  background: linear-gradient(180deg, #B4432F 0%, #93321F 100%);
}
.am-btn-press { opacity: 0.86; }
