/* 全站样式化弹窗 —— 遮罩 / 牌面 / 头部 / 按钮全部取 app.wxss 的 ui-pop-* 零件（addGlobalClass），
 * 这里只留本组件特有的：正文排版、多选项按钮收字、警示色、按压。规范：docs/弹层视觉规范_2026-10-13.md */
.am-mask { z-index: 950; }                 /* 略高于注册弹窗(900)，保证「确认」盖在最上层 */

.am-content {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-26);
  line-height: 1.7;
  color: var(--color-text-secondary, #A09A90);
  text-align: center;
  white-space: pre-wrap;         /* 与 showModal 的 \n 换行语义一致（C7 §4.4） */
}

/* 三个及以上选项：按钮等分一行，文字收一档避免四字按钮溢出 */
.am-actions.is-multi { gap: 14rpx; }
.am-actions.is-multi .ui-pop-btn { font-size: var(--fs-26); }

/* tone: 'warn'（不可逆但非破坏：覆盖 / 重置）= C7 §4.3 --color-warning */
.ui-pop-btn.is-primary.is-warn { background: var(--color-warning, #E9A23B); }

.am-btn-press { opacity: 0.86; }
