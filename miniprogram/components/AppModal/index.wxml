<!-- 全站样式化弹窗：确认 / 仅提示两态 —— 形态与零件见 app.wxss「弹层」与 docs/弹层视觉规范_2026-10-13.md -->
<view
  class="ui-pop-mask is-center am-mask"
  wx:if="{{visible}}"
  catchtouchmove="noop"
  bindtap="onMaskTap"
>
  <view class="ui-pop-dialog am-plate" catchtap="noop">
    <text class="ui-pop-close" wx:if="{{closeBtn}}" bindtap="onCancel">✕</text>

    <view class="ui-pop-head is-center">
      <text class="ui-pop-kicker" wx:if="{{overline}}">{{overline}}</text>
      <text class="ui-pop-title">{{title}}</text>
    </view>
    <text class="am-content" wx:if="{{content}}" user-select>{{content}}</text>

    <view class="ui-pop-foot am-actions is-multi" wx:if="{{actions.length}}">
      <view
        wx:for="{{actions}}"
        wx:key="key"
        class="ui-pop-btn {{item.type === 'danger' ? 'is-danger' : (item.type === 'primary' ? 'is-primary' : 'is-ghost')}}"
        data-key="{{item.key}}"
        bindtap="onAction"
        hover-class="am-btn-press"
        hover-stay-time="80"
      >{{item.text}}</view>
    </view>
    <view class="ui-pop-foot am-actions" wx:else>
      <view
        wx:if="{{showCancel}}"
        class="ui-pop-btn is-ghost"
        bindtap="onCancel"
        hover-class="am-btn-press"
        hover-stay-time="80"
      >{{cancelText}}</view>
      <view
        class="ui-pop-btn {{tone === 'danger' ? 'is-danger' : (tone === 'warn' ? 'is-primary is-warn' : 'is-primary')}}"
        bindtap="onConfirm"
        hover-class="am-btn-press"
        hover-stay-time="80"
      >{{confirmText}}</view>
    </view>
  </view>
</view>
