/* components/CommentList/index.wxss */

.comment-list {
  padding: 40rpx 30rpx;
  background: #1A1814;
}

/* 评价统计 */
.comment-stats {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats-title {
  display: flex;
  flex-direction: column;
}

.title-cn {
  font-size: 32rpx;
  font-weight: 900;
  color: #fff;
  margin-bottom: 8rpx;
  font-family: 'Times New Roman', serif;
}

.title-en {
  font-size: 20rpx;
  color: var(--primary);
  letter-spacing: 2rpx;
  font-family: 'DIN', sans-serif;
}

.stats-rating {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rating-value {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--primary);
  font-family: 'DIN', sans-serif;
}

.rating-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 24rpx;
  color: rgba(255,255,255,0.2);
  transition: all 0.3s;
}

.star.active {
  color: var(--primary);
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.6);
}

.stats-count {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  font-family: 'DIN', sans-serif;
}

/* 排序和筛选 */
.comment-filters {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 12rpx;
  border: 1px solid rgba(255,255,255,0.05);
}

.filter-group {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-right: 16rpx;
  min-width: 80rpx;
}

.filter-chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.filter-chip {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20rpx;
  transition: all 0.3s;
}

.filter-chip.active {
  color: var(--primary);
  background: rgba(196, 167, 108,0.15);
  border-color: rgba(196, 167, 108,0.4);
  font-weight: 700;
}

/* 评价列表 */
.comments-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.comment-item {
  padding: 30rpx;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 16rpx;
  transition: all 0.3s;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.comment-user {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.comment-rating {
  display: flex;
  gap: 4rpx;
}

.comment-time {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
  font-family: 'DIN', sans-serif;
}

.comment-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: rgba(255,255,255,0.8);
  margin-bottom: 20rpx;
  word-break: break-word;
}

/* 评价图片 */
.comment-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.comment-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.05);
}

.comment-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.comment-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.05);
  transition: all 0.3s;
}

.comment-like.liked {
  background: rgba(196, 167, 108,0.15);
  border: 1px solid rgba(196, 167, 108,0.3);
}

.like-icon {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  transition: all 0.3s;
}

.comment-like.liked .like-icon {
  color: var(--primary);
}

.like-count {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  font-family: 'DIN', sans-serif;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: rgba(255,255,255,0.6);
  font-size: 24rpx;
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: rgba(255,255,255,0.4);
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
}

.pin-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #52B788;
  border: 1px solid rgba(82, 183, 136, 0.4);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.merchant-reply {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(196, 167, 108, 0.08);
  border-left: 3rpx solid #C4A76C;
  border-radius: 8rpx;
}

.reply-label {
  display: block;
  font-size: 20rpx;
  color: #C4A76C;
  margin-bottom: 6rpx;
}

.reply-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.5;
}






