<view class="sb-wrap sb-{{size}}">
  <view class="sb-media {{enabled && veiled ? 'is-blurred' : ''}}">
    <slot></slot>
  </view>

  <block wx:if="{{enabled}}">
    <view
      class="sb-veil {{veiled ? 'is-on' : 'is-off'}}"
      catchtap="onReveal"
      hover-class="sb-veil-press"
      hover-stay-time="80"
    >
      <view class="sb-plate">
        <view class="sb-plate-corner tl"></view>
        <view class="sb-plate-corner tr"></view>
        <view class="sb-plate-corner bl"></view>
        <view class="sb-plate-corner br"></view>
        <text class="sb-kicker">CABINET</text>
        <text class="sb-title">{{title}}</text>
        <text class="sb-sub" wx:if="{{sub}}">{{sub}}</text>
      </view>
    </view>

    <view
      class="sb-badge"
      wx:if="{{showBadge && !veiled}}"
      style="{{badgeStyle}}"
      catchtap="onVeil"
      hover-class="sb-badge-press"
      hover-stay-time="80"
    >{{badge}}</view>
  </block>
</view>

<!-- 首次启视：全局展示偏好（确认框形态，ui-pop-*：docs/弹层视觉规范_2026-10-13.md） -->
<root-portal wx:if="{{showPrefModal}}">
  <view class="ui-pop-mask is-center sb-pref-mask" catchtouchmove="noop" catchtap="noop">
    <view class="ui-pop-dialog sb-pref-panel" catchtap="noop">
      <view class="ui-pop-head is-center">
        <text class="ui-pop-title">{{prefTitle}}</text>
      </view>
      <text class="sb-pref-body">{{prefBody}}</text>
      <view class="ui-pop-foot">
        <view
          class="ui-pop-btn is-ghost sb-pref-btn {{prefSaving ? 'disabled' : ''}}"
          catchtap="onPrefClear"
          hover-class="tap-press"
          hover-stay-time="80"
        >{{prefClear}}</view>
        <view
          class="ui-pop-btn is-primary sb-pref-btn {{prefSaving ? 'disabled' : ''}}"
          catchtap="onPrefKeep"
          hover-class="tap-press"
          hover-stay-time="80"
        >{{prefKeep}}</view>
      </view>
    </view>
  </view>
</root-portal>
