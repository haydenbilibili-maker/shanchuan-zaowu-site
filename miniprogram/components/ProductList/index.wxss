.product-list { width: 100%; }
.sort-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 0 20rpx;
}
.sort-item {
  font-size: 24rpx;
  color: #6B6560;
  padding: 8rpx 20rpx;
  border: 1px solid rgba(38, 35, 32, 0.6);
  border-radius: 9999px;
}
.sort-item.active {
  color: #C4A76C;
  border-color: rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.08);
}
.sort-item:active,
.sort-item-press { opacity: 0.82; }
.grid-waterfall { display: flex; gap: 20rpx; }
.col { flex: 1; min-width: 0; }
.list-footer {
  padding: 24rpx 0 40rpx;
  text-align: center;
  position: relative;
}
.loading-tip,
.end-tip {
  font-size: 24rpx;
  color: #6B6560;
  letter-spacing: 0.04em;
}
.end-tip {
  color: #4A4540;
  font-size: 22rpx;
}
.load-fallback {
  display: inline-block;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  color: #4A4540;
  letter-spacing: 0.06em;
}
.load-fallback-press { opacity: 0.7; color: #6B6560; }
.list-sentinel {
  width: 100%;
  height: 2rpx;
  pointer-events: none;
}
.empty-tip {
  margin-top: 24rpx;
  padding: 64rpx 24rpx;
  font-size: 24rpx;
  /* 2026-09-21 分子级审计：原 #6B6560 在本规则的不透明底 #1F1D1A 上仅 2.93（AA 需 4.5）。
     与 pages/category、pages/index 的同类「空态」统一到 --color-text-secondary（6.02）。 */
  color: var(--color-text-secondary);
  letter-spacing: 0.06em;
  background: #1F1D1A;
  border: 1px dashed rgba(77, 64, 26, 0.45);
  border-radius: 16rpx;
}
