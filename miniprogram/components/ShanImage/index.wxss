/* <shan-img>：外框 = 加载中 / 失败时的底；尺寸、圆角、滤镜由页面 ext-class 给 */
.si {
  position: relative;
  overflow: hidden;
  display: block;
  /* 暖深底：比页面底（#1A1814）亮一档，看得出「这里有一张图」，又不抢眼 */
  background: #24211D;
}
.si-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.32s ease-out;
}
.si.is-loaded .si-img { opacity: 1; }
/* 淡方印：只在没图时出现（加载中 / 失败 / 空地址） */
.si-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  padding: 6rpx 8rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: 4rpx; /* radius:object */
  font-family: var(--font-brand, serif);
  font-size: 20rpx;
  letter-spacing: 0.2em;
  line-height: 1;
  color: rgba(196, 167, 108, 0.32);
  white-space: nowrap;
}
@media (prefers-reduced-motion: reduce) {
  .si-img { transition: none; }
}
