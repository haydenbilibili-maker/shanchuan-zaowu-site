/* <shan-img>
 * 外层 .si：只承接页面 ext-class，**不写 position / display / overflow / background / 尺寸**。
 *   组件自己的类与外部样式类落在同一节点上、属性冲突时，微信不保证谁优先 ——
 *   2026-11-23 真机：外层 position:relative 压过了首页 .atelier-hero-img 的 position:absolute，头图掉回文档流，
 *   「标本工坊」卡只剩一张图、徽标 / 标语 / 两个入口都被挤出卡外。
 * 内层 .si-in：组件全权负责 —— 铺满外层、承接圆角、裁切、加载中暖深底、给图与方印定位。
 */
.si-in {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: inherit;
  /* 暖深底：比页面底（#1A1814）亮一档，看得出「这里有一张图」，又不抢眼 */
  background: #24211D;
}
.si-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.32s ease-out;
}
.si.is-loaded .si-img { opacity: 1; }
/* 淡方印：只在没图时出现（加载中 / 失败 / 空地址） */
.si-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  padding: 6rpx 8rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: 4rpx; /* radius:object */
  font-family: var(--font-brand, serif);
  font-size: 20rpx;
  letter-spacing: 0.2em;
  line-height: 1;
  color: rgba(196, 167, 108, 0.32);
  white-space: nowrap;
}
@media (prefers-reduced-motion: reduce) {
  .si-img { transition: none; }
}
