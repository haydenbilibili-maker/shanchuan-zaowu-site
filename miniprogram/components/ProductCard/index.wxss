.prod-card {
  --color-bg: #1A1814;
  --color-bg-card: #1F1D1A;
  --color-text-primary: #FFFFFF;
  --color-text-latin: #C4A76C;
  --color-border: rgba(38, 35, 32, 0.4);
  --font-heading: "Source Han Sans SC", "PingFang SC", sans-serif;
  --font-mono: "DIN", "DIN Alternate", monospace;
  --primary: #C4A76C;
  width: 100%;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1px solid var(--color-border);
  transition: transform 0.22s ease, border-color 0.22s ease;
}
.prod-card-press {
  transform: scale(0.98);
  border-color: rgba(196, 167, 108, 0.4);
}
/* 商品流主图：固定竖框 3:4 + aspectFill 居中裁切（样式写在组件内，避免 isolated 吃掉 app.wxss） */
.img-box {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--color-bg);
}
.img-box .sb-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.p-img {
  width: 100%;
  height: 100%;
  display: block;
}
.p-img-ph {
  width: 100%;
  height: 100%;
  min-height: 0;
  background: var(--color-bg-elevated, #262320);
}
.tag-new {
  position: absolute; top: 0; left: 0; background: var(--primary);
  color: var(--color-bg); font-size: 18rpx; padding: 4rpx 12rpx;
  border-bottom-right-radius: 12rpx; font-weight: bold;
  z-index: 3;
}
.tag-unique {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--primary);
  background: rgba(26, 24, 20, 0.88);
  border: 1px solid rgba(196, 167, 108, 0.55);
  border-top: none;
  border-right: none;
  border-bottom-left-radius: 12rpx;
  z-index: 3;
}
.p-info { padding: 20rpx; }
.p-title { font-size: 26rpx; color: var(--color-text-primary); font-weight: 600; margin-bottom: 4rpx; font-family: var(--font-heading); }
.p-latin { font-size: 20rpx; color: var(--color-text-latin); font-family: Georgia, 'Times New Roman', serif; font-style: italic; margin-bottom: 16rpx; }
.p-craft-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.p-latin + .p-craft-tags {
  margin-top: -8rpx;
}
.p-craft-tag {
  font-size: 18rpx;
  line-height: 1.3;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
  background: rgba(196, 167, 108, 0.08);
  border: 1px solid rgba(77, 64, 26, 0.5);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  white-space: nowrap;
}
.p-bot { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.p-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
}
.p-price { font-size: 32rpx; color: var(--primary); font-family: var(--font-mono); letter-spacing: 0.02em; }
.p-sold { font-size: 20rpx; color: var(--color-text-secondary); letter-spacing: 0.02em; white-space: nowrap; }
.p-from { font-size: 20rpx; color: var(--color-text-latin); margin-left: 2rpx; }
.btn-add {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.35); color: var(--color-text-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; padding-bottom: 4rpx;
}
.btn-add.disabled {
  opacity: 0.45;
  font-size: 20rpx;
  padding-bottom: 0;
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
  border-color: rgba(160, 154, 144, 0.35);
}

/* 售罄：仅压暗图片区，标题/价格保持可读，避免整卡发脏 */
.prod-card.is-soldout .p-img,
.prod-card.is-soldout .p-img-ph {
  filter: grayscale(0.32) brightness(0.9);
}
.soldout-veil {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 24, 20, 0.32);
  pointer-events: none;
  z-index: 1;
}
.soldout-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) rotate(-18deg);
  z-index: 2;
  padding: 10rpx 26rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.62);
  border-radius: 8rpx;
  background: rgba(26, 24, 20, 0.58);
  pointer-events: none;
}
.soldout-mark-text {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.2em;
  color: rgba(196, 167, 108, 0.92);
}

