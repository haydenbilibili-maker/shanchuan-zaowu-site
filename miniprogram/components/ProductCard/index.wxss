.prod-card {
  --color-bg: #1A1814;
  --color-bg-card: #1F1D1A;
  --color-text-primary: #FFFFFF;
  --color-text-latin: #C4A76C;
  --color-border: rgba(38, 35, 32, 0.4);
  --font-heading: "Source Han Sans SC", "PingFang SC", sans-serif;
  --font-mono: "DIN", "DIN Alternate", monospace;
  --primary: #C4A76C;
  width: 100%;
  background: var(--color-bg-card);
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1px solid var(--color-border);
}
.img-box { position: relative; width: 100%; background: var(--color-bg); }
.p-img { width: 100%; display: block; }
.tag-new {
  position: absolute; top: 0; left: 0; background: var(--primary);
  color: var(--color-bg); font-size: 18rpx; padding: 4rpx 12rpx;
  border-bottom-right-radius: 12rpx; font-weight: bold;
}
.p-info { padding: 20rpx; }
.p-title { font-size: 26rpx; color: var(--color-text-primary); font-weight: 600; margin-bottom: 4rpx; font-family: var(--font-heading); }
.p-latin { font-size: 20rpx; color: var(--color-text-latin); font-family: Georgia, 'Times New Roman', serif; font-style: italic; margin-bottom: 16rpx; }
.p-bot { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.p-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
}
.p-price { font-size: 32rpx; color: var(--primary); font-family: var(--font-mono); letter-spacing: 0.02em; }
.p-sold { font-size: 20rpx; color: #A09A90; letter-spacing: 0.02em; white-space: nowrap; }
.p-from { font-size: 20rpx; color: var(--color-text-latin); margin-left: 2rpx; }
.btn-add {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.35); color: var(--color-text-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; padding-bottom: 4rpx;
}
