<view class="prod-card" bindtap="onTap">
  <view class="img-box">
    <image class="p-img" src="{{info.httpImage}}" mode="widthFix" lazy-load />
    <view wx:if="{{info.isNew}}" class="tag-new">NEW</view>
  </view>
  <view class="p-info">
    <view class="p-title text-cut">{{info.title}}</view>
    <view class="p-latin text-cut">{{info.latinName}}</view>
    <view class="p-bot">
      <view class="p-price-wrap">
        <text class="p-price font-num">¥{{priceText}}<text wx:if="{{priceFrom}}" class="p-from">起</text></text>
        <text class="p-sold">已售 {{soldCount}}</text>
      </view>
      <view class="btn-add">+</view>
    </view>
  </view>
</view>