/* 「注记」长注释原文见 miniprogram/docs/源码注记_A流主包.md */
/* components/WishWallEntry/index.wxss 需求 28：祈福墙入口（注记 COM-1） */
.wish-wall-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-3, 24rpx);
  /* ⚠️ 根节点不留任何外边距：外间距 100% 归宿主的 ext-class。 */
  margin: 0;
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  /* 嵌墙浅纸：与主页墙面同暖纸阶 */
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.65) 0%, transparent 36%),
    linear-gradient(165deg, #F8F3E8 0%, #EFE7D6 52%, #E5DCC8 100%);
  border: 2rpx solid rgba(196, 167, 108, 0.58);
  border-radius: var(--radius-xl, 32rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.6),
    inset 0 0 0 6rpx rgba(196, 167, 108, 0.07),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.85),
    0 14rpx 32rpx rgba(48, 40, 16, 0.16);
}

/* 纸纤维：浅底用 multiply 才像纸 */
.wish-wall-entry::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.12;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.35' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}

.wish-wall-entry--press {
  opacity: 0.86;
}

.wish-wall-entry-main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.wish-wall-entry-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.wish-wall-entry .wish-wall-entry-row .wish-wall-entry-lamp {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  box-shadow: none;
  border-color: rgba(107, 90, 36, 0.55);
  background: #A8903C;
}

/* 迷你黄铜铭牌：与墙内 .ww-plate 同族（铜底 + 铆钉 + 内高光） */
.wish-wall-entry-brand {
  position: relative;
  flex-shrink: 0;
  padding: 8rpx 18rpx 9rpx;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 0.14em;
  color: #2A220E;
  background: linear-gradient(145deg, #F0E2B8 0%, #C4A76C 42%, #A8903C 78%, #8A7038 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.55);
  border-radius: 8rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(250, 246, 237, 0.55),
    inset 0 -2rpx 4rpx rgba(48, 40, 16, 0.28),
    0 4rpx 10rpx rgba(48, 40, 16, 0.2);
  text-shadow: 0 1rpx 0 rgba(250, 246, 237, 0.4);
}

.wish-wall-entry-brand::before,
.wish-wall-entry-brand::after {
  content: '';
  position: absolute;
  top: 6rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(48, 40, 16, 0.45);
  box-shadow: 0 0 0 1rpx rgba(250, 246, 237, 0.35);
}

.wish-wall-entry-brand::before { left: 6rpx; }
.wish-wall-entry-brand::after { right: 6rpx; }

.wish-wall-entry-title {
  min-width: 0;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.08em;
  color: #3A2E12;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 1rpx 0 rgba(250, 246, 237, 0.55);
}

.wish-wall-entry.is-compact {
  min-height: 80rpx;
  padding: 22rpx 26rpx;
}

.wish-wall-entry.is-compact .wish-wall-entry-title {
  font-size: 30rpx;
}

.wish-wall-entry-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.35;
  letter-spacing: 0.04em;
  color: rgba(90, 74, 36, 0.72);
}

.wish-wall-entry-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: rgba(90, 74, 36, 0.78);
}

/* 右侧进墙：铜铸小圆钮 */
.wish-wall-entry-go {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: -2rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #F0E2B8 0%, #C4A76C 48%, #A8903C 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.45);
  box-sizing: border-box;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.5),
    0 6rpx 14rpx rgba(48, 40, 16, 0.22);
}

.wish-wall-entry-chevron {
  width: 16rpx;
  height: 16rpx;
  margin-left: -2rpx;
  border-right: 3rpx solid #3A2E12;
  border-bottom: 3rpx solid #3A2E12;
  transform: rotate(-45deg);
}

/* ── 跑马灯 ─────────────────────────────────────────────────────（注记 COM-2） */
.wish-wall-entry-mq {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(107, 90, 36, 0.2);
  overflow: hidden;
  white-space: nowrap;
}

.wish-wall-entry-mq-track {
  display: inline-flex;
  align-items: center;
  animation-name: wish-wall-entry-mq-scroll;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  will-change: transform;
}

.wish-wall-entry-mq-item {
  position: relative;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-right: var(--space-3, 24rpx);
  padding: 8rpx 14rpx 8rpx 12rpx;
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  font-size: 22rpx;
  line-height: 1.4;
  color: #5A4A28;
  white-space: nowrap;
  background: linear-gradient(180deg, rgba(250, 246, 237, 0.92) 0%, rgba(242, 234, 214, 0.88) 100%);
  border: 1rpx solid rgba(138, 117, 48, 0.38);
  border-radius: 6rpx 10rpx 10rpx 6rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.85),
    0 4rpx 10rpx rgba(48, 40, 16, 0.12);
}

.wish-wall-entry-mq-pin {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, #F0E6CC 0%, #A8903C 70%);
  box-shadow: 0 0 0 1rpx rgba(196, 167, 108, 0.3);
}

.wish-wall-entry-mq-emoji {
  margin-right: 0;
  font-size: 24rpx;
}

.wish-wall-entry-mq-text {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
}

@keyframes wish-wall-entry-mq-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ── 墨底纸韵（#2C2822 起点被守卫钉死；2026-10-12 重构见 A 流第 8 轮） ── */
.wish-wall-entry.is-ink {
  gap: 20rpx;
  padding: 26rpx 28rpx 22rpx;
  background:
    radial-gradient(120% 90% at 100% 0%, rgba(196, 167, 108, 0.14) 0%, rgba(196, 167, 108, 0) 60%),
    linear-gradient(165deg, #2C2822 0%, #1E1A14 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: var(--radius-xl, 32rpx);
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.07),
    0 16rpx 36rpx rgba(0, 0, 0, 0.32);
}

.wish-wall-entry.is-ink::before {
  opacity: 0.14;
  mix-blend-mode: soft-light;
}

.wish-wall-entry.is-ink::after {
  content: '';
  position: absolute;
  inset: 10rpx;
  pointer-events: none;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: 22rpx;
}

.wish-wall-entry-kicker {
  display: block;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  line-height: 1.3;
  letter-spacing: 0.24em;
  color: rgba(196, 167, 108, 0.78);
  font-weight: 500;
}

.wish-wall-entry.is-ink .wish-wall-entry-row { gap: 14rpx; }

.wish-wall-entry.is-ink .wish-wall-entry-row .wish-wall-entry-lamp {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 0;
  background: #E3C98C;
  box-shadow: 0 0 12rpx rgba(227, 201, 140, 0.75);
}

.wish-wall-entry.is-ink .wish-wall-entry-brand {
  order: 3;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: #D4BC85;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 6rpx;
  box-shadow: none;
  text-shadow: none;
}
.wish-wall-entry.is-ink .wish-wall-entry-brand::before,
.wish-wall-entry.is-ink .wish-wall-entry-brand::after { display: none; }

.wish-wall-entry.is-ink .wish-wall-entry-title {
  order: 2;
  font-size: 34rpx;
  letter-spacing: 0.12em;
  color: #F7F1E4;
  text-shadow: none;
}

.wish-wall-entry.is-ink .wish-wall-entry-desc,
.wish-wall-entry.is-ink .wish-wall-entry-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(224, 207, 163, 0.7);
}

.wish-wall-entry.is-ink .wish-wall-entry-go {
  width: 60rpx;
  height: 60rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  box-shadow: none;
}

.wish-wall-entry.is-ink .wish-wall-entry-chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #D4BC85;
  border-bottom: 2rpx solid #D4BC85;
}

/* 墨底跑马灯（注记 COM-3） */
.wish-wall-entry.is-ink .wish-wall-entry-mq {
  margin-top: 18rpx;
  padding-top: 0;
  border-top: 0;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 88%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 88%, transparent 100%);
}

.wish-wall-entry.is-ink .wish-wall-entry-mq-item {
  gap: 10rpx;
  margin-right: 36rpx;
  padding: 2rpx 0;
  font-size: 24rpx;
  color: #E8D6A8;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  letter-spacing: 0.04em;
}

.wish-wall-entry.is-ink .wish-wall-entry-mq-item.is-v1 { opacity: 0.62; }
.wish-wall-entry.is-ink .wish-wall-entry-mq-item.is-v2 { opacity: 0.82; }

/* 铜钉 → 一粒微光金点（深底上铜钉的高光会变成"脏点"） */
.wish-wall-entry.is-ink .wish-wall-entry-mq-pin {
  width: 6rpx;
  height: 6rpx;
  background: #D4BC85;
  box-shadow: 0 0 8rpx rgba(212, 188, 133, 0.6);
}

/* emoji 降饱和：彩色 emoji 在暗金调里最抢眼，压到与文字同一亮度层 */
.wish-wall-entry.is-ink .wish-wall-entry-mq-emoji {
  font-size: 22rpx;
  opacity: 0.85;
  filter: saturate(0.55);
}

/* ── v2「马上有 · 心愿签」卡（2026-10-13）：发丝框墨底卡 + 实拍缩略，值对齐评审稿 ── */
.wl-entry { position: relative; display: flex; align-items: center; gap: 28rpx; margin: 0; padding: 24rpx 28rpx 24rpx 24rpx; border: 1rpx solid rgba(196, 167, 108, 0.24); border-radius: 28rpx; background: linear-gradient(165deg, #24201A, #191612); box-sizing: border-box; }
.wl-entry--press { opacity: 0.86; }
.wl-entry-thumb { flex-shrink: 0; width: 128rpx; height: 128rpx; border-radius: 16rpx; box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.35); background: #0E0D0B; }
.wl-entry-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.wl-entry-kicker { font-family: var(--font-mono); font-size: 18rpx; line-height: 26rpx; letter-spacing: 0.32em; color: var(--brass-400); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wl-entry-title { margin-top: 6rpx; font-family: var(--font-brand); font-size: 36rpx; line-height: 48rpx; font-weight: 500; letter-spacing: 0.12em; color: #F7F1E4; white-space: nowrap; }
.wl-entry-meta { margin-top: 8rpx; font-size: 22rpx; line-height: 1.45; color: var(--color-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wl-entry-wish { font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", serif; font-size: 26rpx; color: #E8D6A8; }
.wl-entry-chevron { flex-shrink: 0; width: 18rpx; height: 18rpx; margin-right: 6rpx; border-right: 3rpx solid var(--brass-300); border-bottom: 3rpx solid var(--brass-300); transform: rotate(-45deg); }
.wl-entry.is-compact { padding: 18rpx 24rpx 18rpx 18rpx; gap: 22rpx; }
.wl-entry.is-compact .wl-entry-thumb { width: 96rpx; height: 96rpx; }
.wl-entry.is-compact .wl-entry-title { font-size: 30rpx; line-height: 40rpx; }
