/* components/WishWallEntry/index.wxss 需求 28：祈福墙入口
 * 与祈福墙页的「牌匾」同一语言：浅纸 + 铜字 + 纸纤维；箭头用 CSS 折角而不是字符 › */
.wish-wall-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-3, 24rpx);
  /* ⚠️ 根节点不留任何外边距：外间距 100% 归宿主的 ext-class。
     同一元素上组件样式与宿主样式都设 margin 时，谁生效取决于样式表先后 ——
     实测（切片渲染）宿主的 margin-top 会被组件样式吃掉。职责分离才不会有这种隐性覆盖。 */
  margin: 0;
  padding: 24rpx;
  overflow: hidden;
  background: linear-gradient(165deg, #FAF6ED 0%, #F2EDE4 50%, #EDE6DA 100%);
  border: 1px solid #E0CFA3;
  border-radius: var(--radius-md, 16rpx);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.85);
}

/* 纸纤维：浅底用 multiply 才像纸 */
.wish-wall-entry::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.1;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.35' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}

.wish-wall-entry--press {
  opacity: 0.9;
}

.wish-wall-entry-main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

/* 品牌与标题同行：比两行更省竖向空间，也让"马上有 · 祈福墙"读成一个整体 */
.wish-wall-entry-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

/* 浅纸上的信号灯：#C4A76C on #FAF6ED 几乎看不见，需加深铜描边（同祈福墙页的牌匾）。
   ⚠️ 必须用三层选择器：全局是 `.signal-light.lamp-brass`（两个类），
   单类选择器会被它按特异性压过，灯就退回成空心铜圈。 */
.wish-wall-entry .wish-wall-entry-row .wish-wall-entry-lamp {
  flex-shrink: 0;
  box-shadow: none;
  border-color: rgba(107, 90, 36, 0.55);
  background: #A8903C;
}

.wish-wall-entry-brand {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 1.3;
  letter-spacing: 0.16em;
  color: #A8903C;
}

.wish-wall-entry-title {
  min-width: 0;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 0.04em;
  color: #6B5A24;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 首屏一行版：只有灯 + 品牌 + 标题 + 箭头 */
.wish-wall-entry.is-compact {
  /* 26rpx×2 + 标题行 ≈ 45px：一行版仍满足触控最小高度（≥44px） */
  padding: 26rpx 24rpx;
}

.wish-wall-entry.is-compact .wish-wall-entry-title {
  font-size: 30rpx;
}

.wish-wall-entry-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7A6E58;
}

/* 折角箭头：右 + 下描边旋转 45° */
.wish-wall-entry-chevron {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid #A8903C;
  border-bottom: 3rpx solid #A8903C;
  transform: rotate(-45deg);
}

/* ── 跑马灯（2026-09-20）：真实心愿横向流动 ─────────────────────────────────────
   与祈福墙页的弹幕同一意图（匀速线性），但**不吸顶、不遮挡、不拦点击**：它就是入口卡里的一行。
   轨道用 inline-flex 让宽度 = 内容宽 —— 这样 translateX(-50%) 才恰好滚过一份内容、循环处无缝；
   块级 flex 的宽度是父级 100%，-50% 只会滚半屏、循环时露出空档。 */
.wish-wall-entry-mq {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(107, 90, 36, 0.18);
  overflow: hidden;
  white-space: nowrap;
}

.wish-wall-entry-mq-track {
  display: inline-flex;
  align-items: center;
  gap: 24rpx;
  animation-name: wish-wall-entry-mq-scroll;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  will-change: transform;
}

.wish-wall-entry-mq-item {
  flex-shrink: 0;
  /* 与祈福墙页的愿签/弹幕**同一字栈**：手写体由 `handFont`（app.js onLaunch）全局加载
     （wx.loadFontFace + global:true + scopes 含 native），所以组件里**只写族名、不要重复加载**。
     系统栈兜底要写全：iOS 的 WeChat WebView 不暴露中文手写族，未加载成功时才轮到它们。 */
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  font-size: 22rpx;
  line-height: 1.4;
  color: #7A6E58;
  white-space: nowrap;
}

/* emoji 与祈福墙弹幕同款：略大一点、留 6rpx 间距（手写体里混 emoji 时基线才不会挤） */
.wish-wall-entry-mq-emoji {
  margin-right: 6rpx;
  font-size: 24rpx;
}

@keyframes wish-wall-entry-mq-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ── 羊皮纸变体（2026-09-20）：首页等**博物黑**页面用 ────────────────────────────
   产品负责人口径：「不是白信纸的感觉不好，而是**比较突兀、需要适配**」。
   所以**保留纸的性格**（暖调纸面 + 纸纤维 + 铜字 + 手写感跑马灯），只做三件适配：
     ① 压暗一档：#FAF6ED → 暖调羊皮纸（#F0E8D9 → #DFD3BC），亮度跳变小了就不再刺眼；
     ② 软投影：读成"**深色桌面上放着的一张纸**"，而不是一块发光的板；
     ③ 内嵌一道铜金细框（与祈福墙页 .ww-emboss 同一手法）—— 这既是本仓的牌匾语言，
        也是它与"普通深色卡片"的区别所在。
   文字/箭头/灯沿用浅纸版那一套（深棕 #6B5A24 / 铜 #A8903C）——纸没换，就不该换字色。 */
.wish-wall-entry.is-parchment {
  padding: 22rpx 24rpx 20rpx;
  background: linear-gradient(165deg, #F0E8D9 0%, #E7DCC7 52%, #DFD3BC 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.34), inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

.wish-wall-entry.is-parchment::after {
  content: '';
  position: absolute;
  inset: 8rpx;
  pointer-events: none;
  border: 1rpx solid rgba(107, 90, 36, 0.22);
  border-radius: 10rpx;
}
