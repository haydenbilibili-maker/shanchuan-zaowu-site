/* components/WishWallEntry/index.wxss 需求 28：祈福墙入口
 * ═══════════════════════════════════════════════════════════════════
 * 2026-09-26 v2「厅·墙·签」对齐：入口 = 嵌墙迷你铭牌（与墙内 .ww-plate / 双线浅纸同族）
 *   · 浅纸双线铜框 + 纤维；「马上有」铜铸铭牌带铆钉
 *   · 墨底版仍是「暗房里的纸」（#2C2822 起点守卫钉死），内嵌铜金细框
 * ═══════════════════════════════════════════════════════════════════ */
.wish-wall-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-3, 24rpx);
  /* ⚠️ 根节点不留任何外边距：外间距 100% 归宿主的 ext-class。 */
  margin: 0;
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  /* 嵌墙浅纸：与主页墙面同暖纸阶 */
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.65) 0%, transparent 36%),
    linear-gradient(165deg, #F8F3E8 0%, #EFE7D6 52%, #E5DCC8 100%);
  border: 2rpx solid rgba(196, 167, 108, 0.58);
  border-radius: var(--radius-xl, 32rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.6),
    inset 0 0 0 6rpx rgba(196, 167, 108, 0.07),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.85),
    0 14rpx 32rpx rgba(48, 40, 16, 0.16);
}

/* 纸纤维：浅底用 multiply 才像纸 */
.wish-wall-entry::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.12;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.35' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}

.wish-wall-entry--press {
  opacity: 0.86;
}

.wish-wall-entry-main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.wish-wall-entry-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.wish-wall-entry .wish-wall-entry-row .wish-wall-entry-lamp {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  box-shadow: none;
  border-color: rgba(107, 90, 36, 0.55);
  background: #A8903C;
}

/* 迷你黄铜铭牌：与墙内 .ww-plate 同族（铜底 + 铆钉 + 内高光） */
.wish-wall-entry-brand {
  position: relative;
  flex-shrink: 0;
  padding: 8rpx 18rpx 9rpx;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 0.14em;
  color: #2A220E;
  background: linear-gradient(145deg, #F0E2B8 0%, #C4A76C 42%, #A8903C 78%, #8A7038 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.55);
  border-radius: 8rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(250, 246, 237, 0.55),
    inset 0 -2rpx 4rpx rgba(48, 40, 16, 0.28),
    0 4rpx 10rpx rgba(48, 40, 16, 0.2);
  text-shadow: 0 1rpx 0 rgba(250, 246, 237, 0.4);
}

.wish-wall-entry-brand::before,
.wish-wall-entry-brand::after {
  content: '';
  position: absolute;
  top: 6rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(48, 40, 16, 0.45);
  box-shadow: 0 0 0 1rpx rgba(250, 246, 237, 0.35);
}

.wish-wall-entry-brand::before { left: 6rpx; }
.wish-wall-entry-brand::after { right: 6rpx; }

.wish-wall-entry-title {
  min-width: 0;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.08em;
  color: #3A2E12;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 1rpx 0 rgba(250, 246, 237, 0.55);
}

.wish-wall-entry.is-compact {
  min-height: 80rpx;
  padding: 22rpx 26rpx;
}

.wish-wall-entry.is-compact .wish-wall-entry-title {
  font-size: 30rpx;
}

.wish-wall-entry-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.35;
  letter-spacing: 0.04em;
  color: rgba(90, 74, 36, 0.72);
}

.wish-wall-entry-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: rgba(90, 74, 36, 0.78);
}

/* 右侧进墙：铜铸小圆钮 */
.wish-wall-entry-go {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: -2rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #F0E2B8 0%, #C4A76C 48%, #A8903C 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.45);
  box-sizing: border-box;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.5),
    0 6rpx 14rpx rgba(48, 40, 16, 0.22);
}

.wish-wall-entry-chevron {
  width: 16rpx;
  height: 16rpx;
  margin-left: -2rpx;
  border-right: 3rpx solid #3A2E12;
  border-bottom: 3rpx solid #3A2E12;
  transform: rotate(-45deg);
}

/* ── 跑马灯 ───────────────────────────────────────────────────── */
.wish-wall-entry-mq {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(107, 90, 36, 0.2);
  overflow: hidden;
  white-space: nowrap;
}

.wish-wall-entry-mq-track {
  display: inline-flex;
  align-items: center;
  animation-name: wish-wall-entry-mq-scroll;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  will-change: transform;
}

.wish-wall-entry-mq-item {
  position: relative;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-right: var(--space-3, 24rpx);
  padding: 8rpx 14rpx 8rpx 12rpx;
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  font-size: 22rpx;
  line-height: 1.4;
  color: #5A4A28;
  white-space: nowrap;
  background: linear-gradient(180deg, rgba(250, 246, 237, 0.92) 0%, rgba(242, 234, 214, 0.88) 100%);
  border: 1rpx solid rgba(138, 117, 48, 0.38);
  border-radius: 6rpx 10rpx 10rpx 6rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.85),
    0 4rpx 10rpx rgba(48, 40, 16, 0.12);
}

.wish-wall-entry-mq-pin {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, #F0E6CC 0%, #A8903C 70%);
  box-shadow: 0 0 0 1rpx rgba(196, 167, 108, 0.3);
}

.wish-wall-entry-mq-emoji {
  margin-right: 0;
  font-size: 24rpx;
}

.wish-wall-entry-mq-text {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
}

@keyframes wish-wall-entry-mq-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ── 墨底纸韵：暗房里的嵌墙纸（#2C2822 起点被守卫钉死） ───────────── */
.wish-wall-entry.is-ink {
  padding: 22rpx var(--space-3, 24rpx) 20rpx;
  background:
    linear-gradient(165deg, rgba(196, 167, 108, 0.16) 0%, rgba(196, 167, 108, 0.04) 46%, rgba(0, 0, 0, 0) 100%),
    linear-gradient(165deg, #2C2822 0%, #1E1A14 100%);
  border: 2rpx solid rgba(196, 167, 108, 0.48);
  border-radius: var(--radius-xl, 32rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.06),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.08),
    0 12rpx 28rpx rgba(0, 0, 0, 0.28);
}

.wish-wall-entry.is-ink::before {
  opacity: 0.16;
  mix-blend-mode: soft-light;
}

.wish-wall-entry.is-ink::after {
  content: '';
  position: absolute;
  inset: 8rpx;
  pointer-events: none;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: 18rpx;
}

.wish-wall-entry.is-ink .wish-wall-entry-brand {
  color: #2A220E;
  background: linear-gradient(145deg, #F0E2B8 0%, #C4A76C 42%, #A8903C 100%);
  border-color: rgba(107, 90, 36, 0.5);
}

.wish-wall-entry.is-ink .wish-wall-entry-title {
  color: #F7F1E4;
  text-shadow: none;
}

.wish-wall-entry.is-ink .wish-wall-entry-desc {
  color: rgba(224, 207, 163, 0.62);
}

.wish-wall-entry.is-ink .wish-wall-entry-hint {
  color: rgba(224, 207, 163, 0.55);
}

.wish-wall-entry.is-ink .wish-wall-entry-row .wish-wall-entry-lamp {
  border-color: rgba(196, 167, 108, 0.55);
  background: var(--brass-300, #D4BC85);
}

.wish-wall-entry.is-ink .wish-wall-entry-go {
  background: linear-gradient(145deg, #F0E2B8 0%, #C4A76C 48%, #A8903C 100%);
  border-color: rgba(107, 90, 36, 0.45);
}

.wish-wall-entry.is-ink .wish-wall-entry-chevron {
  border-right-color: #3A2E12;
  border-bottom-color: #3A2E12;
}

/* 墨底跑马灯 · 暗玻璃签条（2026-09-29 产品负责人：米白贴纸在博物黑首页上突兀）
 *   与入口卡同一套语言：深棕半透明底 + 细铜金描边 + 暖金手写字，不再出现任何亮块。
 *   · 左右渐隐遮罩：条目从卡边"浮出/隐没"，不再被硬切半个字；分隔线也跟着渐隐成一道金丝。
 *   · 错落明暗 is-v0/1/2：三档透明度，最暗档文字对底仍 ≥ 6:1。
 *   · 遮罩断点用百分比：不引入 calc(百分比 − rpx)（E26 真机精度）。 */
.wish-wall-entry.is-ink .wish-wall-entry-mq {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top-color: rgba(196, 167, 108, 0.3);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
}

.wish-wall-entry.is-ink .wish-wall-entry-mq-item {
  gap: 10rpx;
  padding: 7rpx 22rpx 7rpx 16rpx;
  color: #E8D6A8;
  background:
    linear-gradient(180deg, rgba(212, 188, 133, 0.14) 0%, rgba(212, 188, 133, 0.03) 100%),
    rgba(16, 13, 9, 0.55);
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 999rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(240, 226, 184, 0.1),
    0 4rpx 12rpx rgba(0, 0, 0, 0.32);
  letter-spacing: 0.04em;
}

.wish-wall-entry.is-ink .wish-wall-entry-mq-item.is-v1 {
  opacity: 0.72;
}

.wish-wall-entry.is-ink .wish-wall-entry-mq-item.is-v2 {
  opacity: 0.86;
  border-color: rgba(212, 188, 133, 0.28);
}

/* 铜钉 → 一粒微光金点（深底上铜钉的高光会变成"脏点"） */
.wish-wall-entry.is-ink .wish-wall-entry-mq-pin {
  width: 6rpx;
  height: 6rpx;
  background: #D4BC85;
  box-shadow: 0 0 8rpx rgba(212, 188, 133, 0.6);
}

/* emoji 降饱和：彩色 emoji 在暗金调里最抢眼，压到与文字同一亮度层 */
.wish-wall-entry.is-ink .wish-wall-entry-mq-emoji {
  font-size: 22rpx;
  opacity: 0.85;
  filter: saturate(0.55);
}
