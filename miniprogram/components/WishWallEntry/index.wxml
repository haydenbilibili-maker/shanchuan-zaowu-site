<!--components/WishWallEntry/index.wxml 需求 28：祈福墙入口（开关 + 藏品命中共同决定）
  ext-class 由宿主传入（外间距归宿主）；compact 为首屏位的一行变体 -->
<!-- v2「马上有 · 心愿签」卡（2026-10-13 重做，蓝图 docs/马上有心愿签_重设计蓝图_2026-10-13.md）：
     展品实拍缩略 + 眉标 + 主标 + 最新一句真实心愿（没有就用展品出处句）；不滚动、无铭牌、无发光灯 -->
<view
  class="wl-entry ext-class {{compact ? 'is-compact' : ''}}"
  wx:if="{{v2 && visible}}"
  bindtap="onTap"
  hover-class="wl-entry--press"
  hover-stay-time="70"
  aria-role="button"
  aria-label="马上有 · 心愿签：{{latest || productHint || descText}}"
>
  <!-- 实拍裱在米白卡纸上、微斜，像钉在展板上的照片 -->
  <view class="wl-entry-mat" wx:if="{{cover}}" aria-hidden="true">
    <image class="wl-entry-thumb" src="{{cover}}" mode="aspectFill" />
  </view>
  <view class="wl-entry-main">
    <text class="wl-entry-kicker">WISH LABELS</text>
    <text class="wl-entry-title">{{brandText || '马上有'}} · 心愿签</text>
    <!-- 最新一张 = 一枚标签纸（打孔 + 身后再叠一张），手写；没有真实心愿就不出（不编造） -->
    <view class="wl-entry-slip" wx:if="{{latest}}">
      <text class="wl-entry-slip-text">{{latest}}</text>
    </view>
    <text class="wl-entry-meta" wx:elif="{{productHint || descText}}">{{productHint || descText}}</text>
  </view>
  <view class="wl-entry-chevron" aria-hidden="true"></view>
</view>
<!-- 旧入口（WISH_LABELS_V2 = false 时的回退路径；心愿签稳定后随旧页一并删除） -->
<block wx:if="{{!v2}}">
<view
  class="wish-wall-entry ext-class {{compact ? 'is-compact' : ''}} {{tone === 'ink' ? 'is-ink' : ''}}"
  wx:if="{{visible}}"
  bindtap="onTap"
  hover-class="wish-wall-entry--press"
  hover-stay-time="70"
  aria-role="button"
  aria-label="{{brandText}}{{title}}：{{descText}}"
>
  <view class="wish-wall-entry-main">
    <!-- 墨底版眉标（2026-10-12 首页卡片重构）：英文眉标一行，主标「祈福墙」+ 细金印「马上有」一行 -->
    <text class="wish-wall-entry-kicker" wx:if="{{tone === 'ink'}}">WISH WALL</text>
    <view class="wish-wall-entry-row">
      <view class="signal-light lamp-brass wish-wall-entry-lamp"></view>
      <text class="wish-wall-entry-brand" wx:if="{{brandText}}">{{brandText}}</text>
      <text class="wish-wall-entry-title">{{title}}</text>
    </view>
    <!-- 紧凑态：详情首屏不放整段 desc，改用一行「回看本品」暗示，进墙/出墙叙事不断 -->
    <text class="wish-wall-entry-hint" wx:if="{{compact && productHint}}">{{productHint}}</text>
    <text class="wish-wall-entry-desc" wx:if="{{!compact}}">{{descText}}</text>
    <!-- 跑马灯（2026-09-20）：真实心愿横向流动 —— 把弹幕墙那一眼"别人也在写"搬到入口里。
         ⚠️ mqItems 为空就整行不渲染：**绝不编造**（宁可不放，也不摆几条假心愿充场面）。
         两份内容并排 + 平移 -50% = 无缝循环；时长按内容长度算（见 index.js 的 wishes observer）。
         aria-hidden：为无缝循环把每条重复了一遍，读屏会把同样几条心愿念两遍；
         入口自身的 aria-label 已说清"这是去哪"，故这里隐藏、语义由 aria-label 承担。 -->
    <view class="wish-wall-entry-mq" wx:if="{{mqItems.length}}">
      <view class="wish-wall-entry-mq-track" style="animation-duration:{{mqDurationMs}}ms" aria-hidden="true">
        <!-- is-v0/1/2：墨底版错落明暗，档位 item.v 由 index.js 按「第几条心愿」算好 -->
        <view class="wish-wall-entry-mq-item is-v{{item.v}}" wx:for="{{mqItems}}" wx:key="i">
          <view class="wish-wall-entry-mq-pin" aria-hidden="true"></view>
          <text class="wish-wall-entry-mq-emoji" wx:if="{{item.e}}">{{item.e}}</text>
          <text class="wish-wall-entry-mq-text">{{item.t}}</text>
        </view>
      </view>
    </view>
  </view>
  <!-- 右侧「进」暗示：折角 + 触控热区放大，一眼可点；aria 由根节点承担 -->
  <view class="wish-wall-entry-go" aria-hidden="true">
    <view class="wish-wall-entry-chevron"></view>
  </view>
</view>
</block>
