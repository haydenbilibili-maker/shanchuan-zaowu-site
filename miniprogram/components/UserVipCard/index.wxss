/* ==== Lv99 · 🏵 蔷薇章 / 黑蟒皮 ====
 * 深黑底 + 菱形蟒鳞重复纹 + 鳞脊轻高光；黄铜仅作铭牌点缀，主体一眼是黑蟒皮。
 * 底色用 Museum Dark 暖黑，禁止纯黑 #000。 */
.vip-card.level-skin-99 {
  background:
    /* 侧光：鳞面微起伏 */
    linear-gradient(108deg,
      rgba(196, 167, 108, 0.06) 0%,
      transparent 18%,
      transparent 70%,
      rgba(0, 0, 0, 0.45) 100%),
    linear-gradient(175deg, #221E1A 0%, #161310 42%, #0F0D0B 100%);
  border: 1px solid rgba(77, 64, 26, 0.55);
  box-shadow:
    0 12rpx 30rpx rgba(8, 6, 4, 0.65),
    0 3rpx 8rpx rgba(8, 6, 4, 0.45),
    inset 0 1rpx 0 rgba(196, 167, 108, 0.14),
    inset 0 -2rpx 8rpx rgba(0, 0, 0, 0.55);
}
.vip-card.level-skin-99 .bg-texture {
  opacity: 0.35;
  background-image: radial-gradient(rgba(196, 167, 108, 0.08) 0.45px, transparent 1px);
  background-size: 11rpx 11rpx;
}
.vip-card.level-skin-99 .card-grain {
  opacity: 1;
  background-image:
    /* 菱形鳞片网格（两向交叉 = 蟒鳞） */
    repeating-linear-gradient(60deg,
      transparent 0, transparent 15rpx,
      rgba(255, 248, 230, 0.055) 15rpx, rgba(255, 248, 230, 0.055) 16.2rpx,
      transparent 16.2rpx, transparent 32rpx),
    repeating-linear-gradient(-60deg,
      transparent 0, transparent 15rpx,
      rgba(0, 0, 0, 0.42) 15rpx, rgba(0, 0, 0, 0.42) 16.2rpx,
      transparent 16.2rpx, transparent 32rpx),
    /* 错位鳞列 */
    repeating-linear-gradient(60deg,
      transparent 0, transparent 7rpx,
      rgba(196, 167, 108, 0.04) 7rpx, rgba(196, 167, 108, 0.04) 8rpx,
      transparent 8rpx, transparent 32rpx),
    repeating-linear-gradient(-60deg,
      transparent 0, transparent 7rpx,
      rgba(255, 255, 255, 0.03) 7rpx, rgba(255, 255, 255, 0.03) 8rpx,
      transparent 8rpx, transparent 32rpx),
    /* 鳞面起伏：暗核 + 脊线高光 */
    repeating-radial-gradient(ellipse 28rpx 18rpx at 25% 30%,
      rgba(0, 0, 0, 0.28) 0, rgba(0, 0, 0, 0.28) 8rpx,
      transparent 14rpx, transparent 36rpx),
    repeating-radial-gradient(ellipse 28rpx 18rpx at 75% 70%,
      rgba(255, 248, 230, 0.04) 0, rgba(255, 248, 230, 0.04) 5rpx,
      transparent 12rpx, transparent 36rpx);
  background-size: auto, auto, auto, auto, 64rpx 40rpx, 64rpx 40rpx;
  background-position: 0 0, 0 0, 16rpx 10rpx, 16rpx 10rpx, 0 0, 32rpx 20rpx;
}
.vip-card.level-skin-99 .card-grain::after {
  /* 克制黄铜内框（铭牌感，非主材质） */
  content: '';
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  left: 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: calc(var(--radius-lg) - 14rpx);
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.35);
  pointer-events: none;
}
.vip-card.level-skin-99 .card-thickness {
  background:
    linear-gradient(160deg, rgba(196, 167, 108, 0.08) 0%, transparent 22%, transparent 68%, rgba(0, 0, 0, 0.4) 100%),
    radial-gradient(ellipse 90% 80% at 48% 42%, transparent 45%, rgba(0, 0, 0, 0.35) 100%);
  box-shadow: none;
}
.vip-card.level-skin-99 .card-sheen { opacity: 1; }
.vip-card.level-skin-99 .card-sheen::before {
  content: '';
  position: absolute;
  top: -24%;
  bottom: -24%;
  left: -38%;
  width: 22%;
  /* 皮革掠光：极弱，勿金属闪烁 */
  background: linear-gradient(90deg, transparent 0%, rgba(255, 248, 230, 0.04) 42%, rgba(196, 167, 108, 0.07) 52%, rgba(255, 248, 230, 0.03) 62%, transparent 100%);
  animation: scSheenSweep 12s ease-in-out infinite;
}
.vip-card.level-skin-99 .card-edge {
  border-color: rgba(48, 40, 16, 0.7);
  border-top-color: rgba(196, 167, 108, 0.28);
  border-bottom-color: rgba(0, 0, 0, 0.5);
  box-shadow: inset 0 1rpx 0 rgba(196, 167, 108, 0.12);
  animation: none;
}
.vip-card.level-skin-99 .card-edge::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 32%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108, 0.45), transparent);
  animation: scRimRun 9s ease-in-out infinite;
}
.vip-card.level-skin-99 .card-edge::after {
  content: none;
}
.vip-card.level-skin-99 .card-specimen {
