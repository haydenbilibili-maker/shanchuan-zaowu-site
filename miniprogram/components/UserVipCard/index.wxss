    linear-gradient(102deg, transparent 34%, rgba(232, 200, 196, 0.07) 50%, transparent 64%);
  background-size: 128rpx 128rpx, auto, auto, auto, auto;
}
.vip-card.level-skin-4 .card-grain::after {
