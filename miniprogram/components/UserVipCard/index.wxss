/* —— 等级权益弹窗材质：见下方「等级权益弹窗 · 材质皮肤」章节
 * （.current-level-card / .level-item 的 .level-skin-N），与主卡纸/木/金属对齐。 —— */

/*
 * 卡片翻到背面时暂停正面动效（省电）。
 * 必须写在各档 animation 简写之后：简写会把 animation-play-state 重置为 running。
 */
.vip-card-container.is-flipped .vip-card-front .card-specimen,
.vip-card-container.is-flipped .vip-card-front .card-sheen::before,
.vip-card-container.is-flipped .vip-card-front .card-edge,
.vip-card-container.is-flipped .vip-card-front .card-edge::before,
.vip-card-container.is-flipped .vip-card-front .progress-bar::after {
  animation-play-state: paused;
}

/* —— 背板：标本标签（中文名 + 拉丁学名，Georgia 斜体） —— */
.cb-specimen {
  font-size: 18rpx;
  color: rgba(213, 209, 200, 0.6);
  letter-spacing: 0.06em;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.cb-specimen-latin {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 18rpx;
  color: rgba(196, 167, 108, 0.72);
  letter-spacing: 0.02em;
  flex-shrink: 0;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 各档拉丁学名色随材质走，见上方「六档会员牌材质」章节 —— 此处不要再覆写，
 * 否则浅色纸卡（Lv1–2）会被冷银色改回近似隐形的浅字。 */


.card-flip-hint {
  font-size: 18rpx;
  color: rgba(196, 167, 108, 0.45);
  letter-spacing: 0.06em;
  flex-shrink: 0;
}

.card-flip-hint.back {
  color: rgba(196, 167, 108, 0.55);
}



/* === 会员卡背板 · 藏家铭牌 === */
.cb-stripe {
  flex-shrink: 0;
  width: 100%;
  height: 44rpx;
  background: linear-gradient(180deg, #14120f, #1e1a14);
  border-bottom: 1px solid rgba(77, 64, 26, 0.55);
  position: relative;
  z-index: 2;
}

.cb-stripe::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.1) 0,
    rgba(196, 167, 108, 0.1) 2rpx,
    transparent 2rpx,
    transparent 10rpx
  );
}

.cb-body {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
  padding: 20rpx 32rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  overflow: hidden;
}

.cb-head-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.cb-head-main {
  flex: 1;
  min-width: 0;
}

.cb-overline {
  display: block;
  font-size: 16rpx;
  color: var(--brass-400);
  letter-spacing: 0.14em;
  margin-bottom: 4rpx;
}

.cb-title {
  display: block;
  font-size: 30rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  line-height: 1.2;
}

.cb-member {
  font-size: 20rpx;
  font-family: var(--font-mono);
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.08em;
  flex-shrink: 0;
  text-align: right;
}

.cb-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 18rpx;
  background: rgba(31, 29, 26, 0.9);
  border: 1px solid rgba(196, 167, 108, 0.16);
  border-radius: var(--radius-md);
}

.cb-row-label,
.cb-tags-label {
  font-size: 18rpx;
  color: rgba(196, 167, 108, 0.65);
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.cb-row-content {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.cb-row-val {
  display: block;
  font-size: 28rpx;
  font-family: var(--font-mono);
  color: var(--brass-400);
  font-weight: 600;
  line-height: 1.2;
}

.cb-row-sub {
  display: block;
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cb-row-link {
  font-size: 22rpx;
  color: var(--brass-400);
  flex-shrink: 0;
}

.cb-birthday-row.today {
  border-color: rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.08);
}

.cb-birthday-row.today .cb-row-val {
  color: #fff;
}

.cb-stats-row {
  display: flex;
  align-items: stretch;
  gap: 10rpx;
}

.cb-stat-cell {
  flex: 1;
  min-width: 0;
  padding: 12rpx 8rpx;
  text-align: center;
  background: rgba(31, 29, 26, 0.9);
  border: 1px solid rgba(196, 167, 108, 0.14);
  border-radius: var(--radius-md);
}

.cb-stat-val {
  display: block;
  font-size: 24rpx;
  font-family: var(--font-mono);
  color: #fff;
  font-weight: 600;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cb-stat-label {
  display: block;
  font-size: 16rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
  white-space: nowrap;
}

.cb-tags-block {
  min-height: 0;
  flex-shrink: 1;
}

.cb-tag-scroll {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
