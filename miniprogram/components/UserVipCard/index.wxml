  <!-- 0. 未注册 / 本机退出登录：信封卡 + 停驻蝴蝶（需求 20）
       样式与交互沿用礼赠启封：perspective 场景 + 暖光 + 底座阴影 + 封缄铜印，
       轻触裂蜡 → 掀盖（rotateX(-118deg)，与礼盒盖同角度）→ 展信 → 进入；
       长按跳过（对齐礼赠「长按可跳过」）。刻意不是等级卡：无等级章 / 无成长轨 / 不翻转。 -->
  <view class="vip-card-container guest-card-wrap" wx:if="{{cardGuest}}">
    <view
      class="guest-envelope phase-{{ritePhase}}"
      bindtap="onGuestRite"
      bindlongpress="onGuestSkip"
      bindtouchstart="onGuestTouchStart"
      hover-class="guest-envelope-press"
      hover-stay-time="80"
      aria-role="button"
      aria-label="{{guestLoggedOut ? '轻触开启信封并重新进入，长按可直接进入' : '轻触开启信封并建立藏家档案，长按可直接进入'}}"
    >
      <view class="ge-glow" aria-hidden="true"></view>
      <view class="ge-shadow" aria-hidden="true"></view>

      <!-- 袋身：深墨卡纸 + 亚麻纸纹 + 封缄线（启封后铜边露出，说明信封已打开） -->
      <view class="ge-pocket" aria-hidden="true">
        <view class="ge-pocket-paper"></view>
        <view class="ge-pocket-seam-l"></view>
        <view class="ge-pocket-seam-r"></view>
        <view class="ge-flap-lip"></view>
      </view>

      <!-- 封缄态文案：启封后由升起的信纸接管（.ge-face 淡出） -->
      <view class="ge-face" aria-hidden="true">
        <text class="ge-overline">COLLECTOR PROFILE</text>
        <text class="ge-title">{{guestLoggedOut ? '会员卡 · 待恢复' : '藏家档案 · 尚未开启'}}</text>
      </view>

      <!-- 信纸：启封后自袋中升起，承载说明与去处 -->
      <view class="ge-letter">
        <view class="ge-letter-deco" aria-hidden="true">
          <view class="ge-letter-lines">
            <view class="ge-letter-line"></view>
            <view class="ge-letter-line short"></view>
          </view>
          <view class="ge-letter-seal"></view>
        </view>
        <view class="ge-letter-body">
          <text class="ge-overline">COLLECTOR PROFILE</text>
          <text class="ge-title">{{guestLoggedOut ? '会员卡 · 待恢复' : '藏家档案 · 尚未开启'}}</text>
          <text class="ge-desc">{{guestLoggedOut ? '本机登录状态已清除；重新进入即恢复全部权益' : '开启信封，建立你的档案并领取新客礼'}}</text>
          <view class="ge-cta">
            <text class="ge-cta-text">{{guestLoggedOut ? '重新进入' : '开启档案'}}</text>
            <text class="ge-cta-arr">→</text>
          </view>
          <text class="ge-note">{{guestLoggedOut ? '不会丢失云端档案与权益' : '绑定手机号即完成注册'}}</text>
        </view>
      </view>

      <!-- 封盖：沿顶边掀起（与礼盒盖同一 transform 与时长） -->
      <view class="ge-flap" aria-hidden="true">
        <view class="ge-flap-half ge-flap-l"></view>
        <view class="ge-flap-half ge-flap-r"></view>
        <view class="ge-flap-crease"></view>
      </view>

      <!-- 封缄铜印：钉在封盖尖端，seal 相位裂开 -->
      <view class="ge-seal" aria-hidden="true">
        <view class="ge-seal-ring"></view>
        <text class="ge-seal-glyph">山海</text>
      </view>

      <!-- 停驻蝴蝶：idle 漂浮 + 振翅 + 暖光；按住加速；启封后振翅飞离（对齐礼赠） -->
      <view class="ge-butterfly {{butterflyAlert ? 'is-alert' : ''}}" aria-hidden="true">
        <view class="ge-butterfly-glow"></view>
        <image class="ge-butterfly-img" src="/assets/envelope/butterfly_pink.png" mode="aspectFit"></image>
      </view>

      <!-- 封缄态手势提示（启封时淡出） -->
      <view class="ge-hint" aria-hidden="true">
        <text class="ge-hint-over">SEALED PROFILE</text>
        <text class="ge-hint-line">轻触开启 · 长按可直接进入</text>
      </view>
    </view>
  </view>

  <!-- 1. 光感会员卡（可翻转背板 · 淡入切换，避免真机镜像） -->
  <view class="vip-card-container {{cardFlipped ? 'is-flipped' : ''}}" wx:else>
    <view class="vip-card-stage">
      <!-- 正面：三区热区 — 品牌·翻转 / 身份·档案 / 里程·权益；签到与通行码独立 -->
      <view class="vip-card vip-card-front {{cardSkinClass}}">
        <view class="bg-texture"></view>
        <!-- 材质层（纸 → 木 → 金属，由 level-skin-N 决定；对标预约票纤维噪点） -->
        <view class="card-grain" aria-hidden="true"></view>
        <!-- 卡纸厚度：inset 高光 + 暗角（对标 ticket-paper-sheen） -->
        <view class="card-thickness" aria-hidden="true"></view>
        <!-- 金属光泽扫过层（仅 Lv5–6 启用，克制） -->
        <view class="card-sheen" aria-hidden="true"></view>
        <!-- 标本剪影水印：同构预约票 .watermark —— 右侧大淡影 emoji，非角标贴纸 -->
        <view class="card-specimen" aria-hidden="true">{{specimenEmoji}}</view>
        <view class="card-edge" aria-hidden="true"></view>

        <!-- 区 1 · 品牌 + 签到 / 通行码 -->
        <view class="card-top">
          <view
            class="org-name"
            catchtap="onToggleFlip"
            catchlongpress="onEasterEggLongPress"
            data-egg-id="xiwangmu"
            hover-class="org-name-press"
            hover-stay-time="80"
          >
            <text class="cn">山海造物</text>
            <text class="en">NATURE'S CREATIONS</text>
            <text class="tagline">把山海带回家</text>
          </view>

          <view class="card-actions">
            <view
              class="action-chip checkin-chip {{hasCheckedIn ? 'is-done' : ''}}"
              catchtap="onCheckIn"
              hover-class="action-chip-press"
              hover-stay-time="80"
            >
              <image class="ap-icon icon-gold" src="/assets/icons/checkin.png" mode="aspectFit" wx:if="{{!hasCheckedIn}}"></image>
              <text class="ap-text">{{hasCheckedIn ? '已签到' : '签到'}}</text>
            </view>
            <view
              class="action-chip pass-chip"
              catchtap="onShowMemberCode"
              hover-class="action-chip-press"
              hover-stay-time="80"
            >
              <image class="qr-icon icon-gold" src="/assets/icons/qrcode.png" mode="aspectFit"></image>
              <text class="ap-text">亮码</text>
            </view>
          </view>
        </view>

        <!-- 区 2 · 藏家身份：点头像选图；昵称/› 进档案 -->
        <view class="card-main">
          <view class="user-info-row">
            <view
              class="avatar-hit"
              catchtap="onChangeAvatar"
              hover-class="avatar-choose-press"
              hover-stay-time="80"
              aria-label="更换头像"
            >
              <view class="avatar-wrap {{cardPending ? 'is-pending' : ''}}">
                <view class="vip-skel vip-skel-avatar" wx:if="{{cardPending}}"></view>
                <image
                  class="avatar-img"
                  src="{{avatarBroken ? '/assets/icons/user.png' : (userInfo.avatarUrl || '/assets/icons/user.png')}}"
                  mode="aspectFill"
                  wx:else
                  binderror="onAvatarError"
                ></image>
              </view>
              <view class="avatar-badge" aria-hidden="true" wx:if="{{!cardPending}}">
                <image class="avatar-badge-icon" src="/assets/icons/camera.png" mode="aspectFit"></image>
              </view>
            </view>
            <view
              class="text-meta"
              catchtap="onGoProfile"
              hover-class="user-info-row-press"
              hover-stay-time="80"
            >
              <view class="nick-row">
                <view class="vip-skel vip-skel-nick" wx:if="{{cardPending}}"></view>
                <text class="nick-display" wx:else>{{userInfo.nickName || '设定代号'}}</text>
              </view>
              <view class="badge-row">
                <block wx:if="{{cardPending}}">
                  <view class="vip-skel vip-skel-badge"></view>
                </block>
                <block wx:else>
                  <view class="badge-pill">{{levelName}}</view>
                  <view class="rate-tag" wx:if="{{discountRate < 1}}">权益 {{discountText}}</view>
                </block>
              </view>
            </view>
            <!-- 2026-09-17：移除卡面「档案 xx% ›」入口 —— 资产区已有「我的档案」（带完成度角标），
                 同一入口两处既重复又抢卡片留白；点名字/称号区（.text-meta）仍可进档案，
                 成长细轨（card-section-rule-fill）继续承担「档案未满」的进度暗示。 -->
          </view>

        </view>

        <!-- 区隔：自定义细轨（禁用 border/原生 progress 在安卓上的粗白 SeekBar 观感）
             档案未满时在深色细轨上叠克制黄铜填充；已满/最高成长档仅显示细分隔线 -->
        <view class="card-section-rule" aria-hidden="true">
          <view
            class="card-section-rule-fill"
            wx:if="{{!cardPending && profileScore < 100}}"
            style="width: {{profileScore}}%;"
          ></view>
        </view>

        <!-- 区 3 · 成长里程 → 等级权益 -->
        <view class="card-footer">
          <view
            class="growth-panel {{growthIsMax ? 'is-max' : ''}}"
            catchtap="onShowLevelBenefits"
            hover-class="growth-panel-press"
            hover-stay-time="80"
          >
            <view class="growth-head">
              <text class="growth-overline">成长里程</text>
              <text class="growth-link-hint" wx:if="{{!cardPending}}">权益 ›</text>
            </view>
            <block wx:if="{{cardPending}}">
              <view class="growth-lead">
                <view class="vip-skel vip-skel-growth"></view>
              </view>
              <view class="vip-skel vip-skel-meta"></view>
              <view class="progress-track">
                <view class="progress-bar vip-skel-bar" style="width: 42%"></view>
              </view>
            </block>
            <block wx:else>
              <view class="growth-lead">
                <text class="growth-num">{{growthValueDisplay}}</text>
                <text class="growth-label">成长值</text>
                <text class="growth-target" wx:if="{{!growthIsMax && nextThreshold > 0}}">/ {{nextThresholdDisplay}}</text>
              </view>
              <view class="growth-meta" wx:if="{{!growthIsMax}}">
                <text class="growth-gap-line">{{growthGapLine}}</text>
                <text class="growth-perk-delta" wx:if="{{growthPerkDelta}}">{{growthPerkDelta}}</text>
              </view>
              <text class="growth-status is-max" wx:else>{{growthGapLine || '已达当前最高成长档'}}</text>
              <view class="progress-track" wx:if="{{!growthIsMax && nextThreshold > 0}}">
                <view class="progress-bar" style="width: {{progressWidth}}"></view>
              </view>
            </block>
          </view>
          <view
            class="card-flip-glyph"
            catchtap="onToggleFlip"
            hover-class="card-flip-glyph-press"
            hover-stay-time="80"
            aria-label="翻转铭牌"
            wx:if="{{!cardPending}}"
          >
            <view class="flip-layer flip-layer-back"></view>
            <view class="flip-layer flip-layer-front"></view>
          </view>
        </view>
      </view>

      <!-- 背板 · 藏家铭牌 -->
      <view class="vip-card vip-card-back {{cardSkinClass}}" bindtap="onToggleFlip">
        <view class="bg-texture"></view>
        <view class="card-grain" aria-hidden="true"></view>
        <view class="card-thickness" aria-hidden="true"></view>
        <view class="card-specimen card-specimen-back" aria-hidden="true">{{specimenEmoji}}</view>

        <view class="cb-stripe"></view>

        <view class="cb-body">
          <view class="cb-head-row">
            <view class="cb-head-main">
              <text class="cb-overline">COLLECTOR PLATE</text>
              <text class="cb-title">藏家铭牌</text>
            </view>
            <text class="cb-member">{{memberNo}}</text>
          </view>

          <view class="cb-row cb-birthday-row {{cardBirthday.isToday ? 'today' : ''}}">
            <text class="cb-row-label">生日礼券</text>
            <view class="cb-row-content" wx:if="{{cardBirthday.hasBirthday}}">
              <text class="cb-row-val">{{cardBirthday.headline}}</text>
              <text class="cb-row-sub">{{cardBirthday.subline}}</text>
            </view>
            <text class="cb-row-link" wx:else catchtap="onGoProfileFromCardBack">填写生日 →</text>
            <!-- 需求 21：生日已填也保留档案入口（此前只在缺失时才出现，老用户背板无路可走） -->
            <text class="cb-row-link" wx:if="{{cardBirthday.hasBirthday}}" catchtap="onGoProfileFromCardBack">档案 →</text>
          </view>

          <view class="cb-stats-row">
            <view class="cb-stat-cell">
              <text class="cb-stat-val">{{cardConsumptionDisplay}}</text>
              <text class="cb-stat-label">累计消费</text>
            </view>
            <view class="cb-stat-cell">
              <text class="cb-stat-val">{{statistics.orderCount || 0}}</text>
              <text class="cb-stat-label">订单</text>
            </view>
            <view class="cb-stat-cell">
              <text class="cb-stat-val">{{cardPointsDisplay}}</text>
              <text class="cb-stat-label">积分</text>
            </view>
          </view>

          <view class="cb-tags-block">
            <text class="cb-tags-label">偏好标签</text>
            <scroll-view scroll-x class="cb-tag-scroll" enable-flex show-scrollbar="{{false}}" wx:if="{{cardInterestTags.length}}">
              <view class="cb-tag-inner">
                <text
                  class="cb-tag"
                  wx:for="{{cardInterestTags}}"
                  wx:key="key"
                  style="border-color: {{item.color}}44; color: {{item.color}}; background: {{item.color}}14;"
                >{{item.label}}</text>
              </view>
            </scroll-view>
            <text class="cb-persona" wx:if="{{cardPersona}}">{{cardPersona}}</text>
            <text class="cb-tags-empty" wx:if="{{!cardInterestTags.length && !cardPersona}}" catchtap="onGoProfileFromCardBack">添加兴趣标签 →</text>
            <!-- 需求 21：已有标签也保留入口，避免「背板只有展示、没有去处」 -->
            <text class="cb-tags-link" wx:if="{{cardInterestTags.length || cardPersona}}" catchtap="onGoProfileFromCardBack">管理档案 →</text>
          </view>
        </view>

        <view class="card-back-foot">
          <text class="cb-since">{{levelName}}</text>
          <text class="cb-specimen" wx:if="{{specimenName}}">{{specimenName}}</text>
          <text class="cb-specimen-latin" wx:if="{{specimenLatin}}">{{specimenLatin}}</text>
          <!-- 需求 21：背板常驻档案入口（与生日 / 标签是否填写无关） -->
          <text class="cb-profile-cta" catchtap="onGoProfileFromCardBack" hover-class="cb-profile-cta-press" hover-stay-time="80">完善藏家档案 →</text>
        </view>
      </view>
    </view>
  </view>
