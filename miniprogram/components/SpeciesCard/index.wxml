<view class="species-card">
  <view class="card-image-wrap">
    <image class="card-image" src="{{displayImage}}" mode="aspectFill" />
    <view class="card-image-corner"></view>
  </view>

  <view class="card-body">
    <view class="specimen-plate">
      <view class="plate-tags" wx:if="{{rootCategoryTag}}">
        <text class="root-tag">{{rootCategoryTag}}</text>
      </view>
      <view class="name-block">
        <text class="name-zh">{{speciesInfo.species_name_zh || '—'}}</text>
        <text class="name-latin">{{speciesInfo.species_name_latin || ''}}</text>
      </view>
    </view>

    <scroll-view class="tax-scroll" scroll-x enable-flex>
      <view class="tax-inner">
        <block wx:for="{{taxTags}}" wx:key="*this">
          <view class="tax-chip">{{item}}</view>
        </block>
      </view>
    </scroll-view>

    <view class="confidence-row" wx:if="{{showConfidence}}">
      <view class="conf-left">
        <text class="conf-label">识别置信度</text>
        <text class="conf-desc">{{confidenceDesc}}</text>
      </view>
      <view class="stars">{{starText}}</view>
    </view>

    <view class="warn-banner" wx:if="{{warningText}}">
      <text>{{warningText}}</text>
    </view>

    <view class="photo-tips" wx:if="{{showPhotoTips}}">
      <text class="pt-title">重拍建议</text>
      <text class="pt-line">· 正对标本主体，减少倾斜</text>
      <text class="pt-line">· 避开强反光，选择均匀柔光</text>
      <text class="pt-line">· 可近距离补拍翅脉、纹理等细节</text>
    </view>

    <view class="section science" wx:if="{{aiContent.content}}">
      <view class="sec-head">
        <text class="sec-title">科普手记</text>
        <text class="sec-toggle" bindtap="toggleExpand">{{expanded ? '收起' : '展开'}}</text>
      </view>
      <text class="sci-text {{expanded ? 'expanded' : 'collapsed'}}">{{aiContent.content}}</text>
    </view>

    <view class="fun-fact" wx:if="{{aiContent.fun_fact}}">
      <view class="ff-icon">✦</view>
      <view class="ff-body">
        <text class="ff-label">冷知识</text>
        <text class="ff-text">{{aiContent.fun_fact}}</text>
      </view>
    </view>

    <text class="disclaimer">AI 鉴定仅供参考，收藏与交易请以实物及证书为准。</text>
  </view>
</view>
