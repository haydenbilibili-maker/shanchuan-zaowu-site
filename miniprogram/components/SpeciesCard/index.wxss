.species-card {
  background: linear-gradient(165deg, #1e1e22 0%, #121214 100%);
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(196, 167, 108, 0.15);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.45);
}

.card-image-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  background: #1A1814;
}

.card-image {
  width: 100%;
  height: 100%;
  display: block;
}

.card-image-corner {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(to top, rgba(18, 18, 20, 0.95), transparent);
}

.card-body {
  padding: 32rpx 28rpx 36rpx;
}

.specimen-plate {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #FAF6ED;
  border: 1rpx solid #E0CFA3;
  border-radius: 12rpx;
}

.plate-tags {
  margin-bottom: 12rpx;
}

.root-tag {
  display: inline-flex;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #8A7530;
  background: rgba(196, 167, 108, 0.18);
  border-radius: 8rpx;
}

.name-block {
  margin-bottom: 0;
}

.name-zh {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #6B5A24;
  letter-spacing: 0.04em;
}

.name-latin {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-style: italic;
  color: #C4A76C;
}

.tax-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.tax-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.tax-chip {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: rgba(196, 167, 108, 0.95);
  background: rgba(196, 167, 108, 0.08);
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
}

.confidence-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.conf-left {
  flex: 1;
  min-width: 0;
}

.conf-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

.conf-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.4;
}

.stars {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #C4A76C;
  letter-spacing: 2rpx;
}

.warn-banner {
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #E9A23B;
  background: rgba(233, 162, 59, 0.08);
  border-radius: 12rpx;
  border: 1rpx solid rgba(233, 162, 59, 0.25);
}

.photo-tips {
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.8);
}

.pt-title {
  display: block;
  font-size: 22rpx;
  color: #C4A76C;
  margin-bottom: 12rpx;
}

.pt-line {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.65;
}

.disclaimer {
  display: block;
  margin-top: 24rpx;
  font-size: 20rpx;
  color: #6B6560;
  line-height: 1.5;
}

.section.science {
  margin-top: 8rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(245, 240, 230, 0.95);
}

.sec-toggle {
  font-size: 24rpx;
  color: #C4A76C;
}

.sci-text {
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.78);
}

.sci-text.collapsed {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.sci-text.expanded {
  display: block;
}

.fun-fact {
  margin-top: 28rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108, 0.12) 0%, rgba(30, 30, 34, 0.9) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.2);
}

.ff-icon {
  font-size: 32rpx;
  color: #C4A76C;
  line-height: 1;
}

.ff-body {
  flex: 1;
  min-width: 0;
}

.ff-label {
  display: block;
  font-size: 22rpx;
  color: #C4A76C;
  margin-bottom: 8rpx;
  letter-spacing: 0.12em;
}

.ff-text {
  font-size: 26rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.88);
}
