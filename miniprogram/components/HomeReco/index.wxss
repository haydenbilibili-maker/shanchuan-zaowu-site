/* 「注记」见 miniprogram/docs/源码注记_A流主包.md（COM-1）；2026-10-13 重做为横滑展柜，口径见 docs/首页为你推荐_横滑展柜_2026-10-13.md */
.hr-body { width: 100%; --g1: rgba(196,167,108,.12); --g2: rgba(196,167,108,.2); --g4: rgba(196,167,108,.4); --t2: var(--color-text-secondary); }

.hr-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; padding-bottom: 18rpx; background: linear-gradient(90deg, rgba(196,167,108,.55), var(--g1) 60%, transparent) left bottom / 100% 1px no-repeat; }
.hr-title { display: flex; flex-direction: column; }
.hr-t-en { font-size: 18rpx; line-height: 26rpx; color: var(--brass-400); font-family: var(--font-mono); letter-spacing: .32em; }
.hr-t-cn { margin-top: 6rpx; font-size: 38rpx; line-height: 50rpx; font-weight: 500; color: var(--color-text-primary); font-family: var(--font-brand); letter-spacing: .12em; }
.hr-swap { position: relative; display: flex; align-items: center; gap: 10rpx; min-height: 56rpx; padding: 0 4rpx 0 16rpx; margin-bottom: -6rpx; font-size: 24rpx; color: var(--brass-300); letter-spacing: .12em; }
.hr-swap::after { content: ''; position: absolute; left: -16rpx; right: -12rpx; top: -17rpx; bottom: -17rpx; }
.hr-swap-ico { position: relative; width: 18rpx; height: 18rpx; border: 2rpx solid currentColor; border-top-color: transparent; border-radius: 50%; }
.hr-swap-ico::after { content: ''; position: absolute; top: -5rpx; right: -3rpx; border: 5rpx solid transparent; border-left: 7rpx solid currentColor; transform: rotate(-45deg); }
.hr-swap.is-turn .hr-swap-ico { animation: hr-spin 0.48s ease-out; }
.hr-swap.is-busy { color: var(--t2); }
.hr-swap.is-busy .hr-swap-ico { animation: hr-spin .9s linear infinite; }
@keyframes hr-spin { to { transform: rotate(360deg); } }

.hr-why-row { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 24rpx; padding-left: 18rpx; border-left: 2rpx solid var(--brass-500); }
.hr-why-tag { flex-shrink: 0; font-size: 20rpx; line-height: 36rpx; color: var(--t2); letter-spacing: .2em; }
.hr-why { flex: 1; min-width: 0; font-size: 25rpx; line-height: 36rpx; color: var(--brass-200); font-family: var(--font-brand); letter-spacing: .04em; -webkit-line-clamp: 2; }
.hr-why { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }

/* 横滑展柜：卡 300×568（图 400 + 体 166 + 边 2），骨架同尺寸 */
.hr-strip { width: 100%; white-space: nowrap; }
.hr-strip.is-turn .hr-card { animation: hr-rise .48s ease both; }
@keyframes hr-rise { from { opacity: 0; transform: translateY(14rpx); } }
.hr-card, .hr-more-card { display: inline-flex; flex-direction: column; vertical-align: top; width: 300rpx; height: 568rpx; margin-right: 18rpx; border: 1px solid var(--g2); border-radius: 6rpx; overflow: hidden; box-sizing: border-box; white-space: normal; }
.hr-card { background: var(--color-bg-card); box-shadow: 0 18rpx 36rpx -24rpx rgba(0,0,0,.6); }
.hr-img-box { position: relative; flex-shrink: 0; width: 100%; height: 400rpx; overflow: hidden; background: var(--color-bg-elevated); }
.hr-img, .hr-img-ph { display: block; width: 100%; height: 100%; }
.hr-img-ph { background: var(--color-bg-elevated); }
.hr-fade { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: 46%; background: linear-gradient(to bottom, rgba(31,29,26,0), rgba(31,29,26,.42) 58%, rgba(31,29,26,.9)); pointer-events: none; }
.hr-mark { position: absolute; z-index: 2; top: 14rpx; left: 14rpx; padding: 0 8rpx; font-size: 19rpx; line-height: 28rpx; color: var(--brass-200); background: rgba(26,24,20,.55); border: 1px solid var(--g4); letter-spacing: .1em; white-space: nowrap; }
.hr-mark--wall { background: rgba(196,167,108,.18); }
.hr-card-body { flex: 1; padding: 16rpx 20rpx 0; box-sizing: border-box; }
.hr-name, .hr-sub { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.hr-name { font-size: 30rpx; line-height: 42rpx; font-weight: 500; color: var(--color-text-primary); font-family: var(--font-brand); letter-spacing: .06em; }
.hr-sub { height: 32rpx; margin-top: 4rpx; font-size: 22rpx; line-height: 32rpx; color: var(--t2); letter-spacing: .04em; }
.hr-card-foot { display: flex; align-items: baseline; gap: 8rpx; margin-top: 12rpx; }
.hr-price { font-size: 28rpx; line-height: 40rpx; font-weight: 500; color: var(--brass-300); font-family: var(--font-mono); letter-spacing: .04em; white-space: nowrap; }
.hr-from { font-size: 20rpx; font-weight: 400; color: var(--t2); margin-left: 4rpx; }
.hr-soldout { font-size: 20rpx; color: var(--t2); letter-spacing: .08em; white-space: nowrap; }
.hr-more-card { width: 200rpx; align-items: center; justify-content: center; gap: 6rpx; margin-right: 4rpx; background: linear-gradient(160deg, rgba(196,167,108,.08), transparent 60%); }
.hr-more-en { font-size: 16rpx; line-height: 24rpx; color: var(--brass-400); font-family: var(--font-mono); letter-spacing: .24em; }
.hr-more-cn { font-size: 26rpx; line-height: 38rpx; color: var(--color-text-primary); font-family: var(--font-brand); letter-spacing: .1em; }
.hr-more-go { font-size: 34rpx; line-height: 1; color: var(--brass-300); }

.hr-sk-why { width: 360rpx; height: 36rpx; margin: 0 0 24rpx; }
.hr-sk-strip { display: flex; gap: 18rpx; overflow: hidden; }
.hr-sk-card { flex: 0 0 300rpx; height: 568rpx; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; border-radius: 6rpx; }
.hr-sk .hr-sk-img { width: 100%; height: 400rpx; margin: 0; border-radius: 0; }
.hr-sk-card .ui-sk-line { margin: 24rpx 0 0 20rpx; }
.hr-error, .hr-empty { display: flex; flex-direction: column; align-items: center; padding: 44rpx 24rpx 36rpx; font-size: 24rpx; color: var(--t2); letter-spacing: .08em; background: var(--color-bg-card); border: 1px solid var(--g2); border-radius: 6rpx; }
.hr-error-title { font-size: 28rpx; color: var(--color-text-primary); font-family: var(--font-brand); }
.hr-error-desc { margin-top: 8rpx; font-size: 22rpx; }
.hr-retry { margin-top: 24rpx; min-height: 88rpx; line-height: 88rpx; padding: 0 48rpx; color: var(--brass-300); }
