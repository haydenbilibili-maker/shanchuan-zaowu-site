<view class="hr-body">
  <view class="hr-head">
    <view class="hr-title">
      <text class="hr-t-en">FOR YOU</text>
      <text class="hr-t-cn">为你推荐</text>
    </view>
    <view class="hr-swap {{refreshing ? 'is-busy' : ''}} {{swapping ? 'is-turn' : ''}}" wx:if="{{phase === 'ready' && canSwap}}" aria-role="button" bindtap="onSwap" hover-class="tap-press" hover-stay-time="80"><view class="hr-swap-ico"></view><text>{{refreshing ? '更新中' : '换一批'}}</text></view>
  </view>

  <view class="hr-sk" wx:if="{{phase === 'loading'}}">
    <view class="ui-sk-line hr-sk-why"></view>
    <view class="hr-sk-strip">
      <view class="ui-sk-card hr-sk-card" wx:for="{{[1,2,3]}}" wx:key="*this"><view class="ui-sk-line hr-sk-img"></view><view class="ui-sk-line"></view><view class="ui-sk-line wide"></view></view>
    </view>
  </view>

  <view class="hr-error" wx:elif="{{phase === 'error'}}">
    <text class="hr-error-title">推荐没能送到</text>
    <text class="hr-error-desc">{{errorMsg || '网络开小差了'}}</text>
    <view class="hr-retry" bindtap="onRetry" hover-class="tap-press" hover-stay-time="80">轻点重试</view>
  </view>

  <view class="hr-empty" wx:elif="{{phase === 'empty'}}" bindtap="onMore" hover-class="tap-press" hover-stay-time="80">
    <text>馆里正在上新 · 先去逛逛全部藏品 ›</text>
  </view>

  <block wx:else>
    <view class="hr-why-row">
      <text class="hr-why-tag">策展手记</text>
      <text class="hr-why">{{whyText}}</text>
    </view>

    <!-- 横滑展柜（2026-10-13 重做）：统一 3:4 竖卡 · 图底渐隐 · 主名 / 门类 / 价格；末尾「逛全部藏品」；换一批 = 下一批 6 件 -->
    <scroll-view class="hr-strip {{swapping ? 'is-turn' : ''}}" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTo}}" scroll-with-animation>
      <view class="hr-card" id="hr-c{{index}}" wx:for="{{cards}}" wx:key="_id" aria-role="button" aria-label="{{item.title}}" bindtap="onCardTap" data-pos="{{item.pos}}" hover-class="tap-press-soft" hover-stay-time="80">
        <view class="hr-img-box">
          <sensitive-blur-gate enabled="{{item.sensitiveBlur}}" product-id="{{item._id}}" size="card">
            <image class="hr-img" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load />
            <view class="hr-img-ph" wx:else></view>
          </sensitive-blur-gate>
          <view class="hr-fade"></view>
          <text class="hr-mark hr-mark--{{item.mark.kind}}" wx:if="{{item.mark}}">{{item.mark.text}}</text>
          <protected-badge product="{{item}}" size="xs" corner="bl" />
        </view>
        <view class="hr-card-body">
          <text class="hr-name">{{item.name}}</text>
          <text class="hr-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
          <view class="hr-card-foot">
            <text class="hr-price" wx:if="{{item.priceText}}">{{item.priceText}}<text class="hr-from" wx:if="{{item.priceFrom}}">起</text></text>
            <text class="hr-soldout" wx:if="{{item.soldOut}}">售罄</text>
          </view>
        </view>
      </view>
      <view class="hr-more-card" bindtap="onMore" hover-class="tap-press-soft" hover-stay-time="80" aria-role="button">
        <text class="hr-more-en">COLLECTION</text>
        <text class="hr-more-cn">逛全部藏品</text>
        <text class="hr-more-go">›</text>
      </view>
    </scroll-view>
  </block>
</view>
