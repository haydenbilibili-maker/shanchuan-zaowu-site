}
.hero-card.level-skin-3 .card-grain,
.plate.level-skin-3 .card-grain {
  opacity: 0.85;
  background-image:
    repeating-linear-gradient(178deg, rgba(255, 226, 178, 0.07) 0, rgba(255, 226, 178, 0.07) 1rpx, transparent 1rpx, transparent 5rpx),
    repeating-linear-gradient(179deg, rgba(40, 24, 10, 0.16) 0, rgba(40, 24, 10, 0.16) 2rpx, transparent 2rpx, transparent 11rpx);
}
.hero-card.level-skin-3 .card-thickness,
.plate.level-skin-3 .card-thickness {
  background:
    linear-gradient(180deg, rgba(255, 238, 205, 0.16) 0%, transparent 6%),
    radial-gradient(ellipse 96% 84% at 46% 40%, transparent 52%, rgba(22, 13, 5, 0.22) 100%);
}
.hero-card.level-skin-3 .hero-name,
.hero-card.level-skin-3 .hero-progress-pct,
.hero-card.level-skin-3 .hero-max-text { color: #FFF6E6; }
.hero-card.level-skin-3 .hero-overline,
.hero-card.level-skin-3 .hero-growth,
.hero-card.level-skin-3 .hero-progress-text,
.hero-card.level-skin-3 .hero-next { color: #D4BE97; }
.hero-card.level-skin-3 .hero-badge {
  background: rgba(224, 207, 163, 0.18);
  border-color: rgba(240, 220, 174, 0.42);
  color: #F0DCAE;
}
.hero-card.level-skin-3 .hero-progress-track { background: rgba(24, 14, 6, 0.45); }
.hero-card.level-skin-3 .hero-progress-fill { background: linear-gradient(90deg, #8A6A2C, #E7D2A0); }
.hero-card.level-skin-3 .hero-watermark {
  filter: grayscale(1) brightness(0.42) contrast(1.1);
  opacity: 0.22;
}
.plate.level-skin-3 .plate-lv { color: #F0DCAE; }
.plate.level-skin-3 .plate-discount,
.plate.level-skin-3 .plate-name { color: #FFF6E6; }
.plate.level-skin-3 .plate-threshold { color: #D4BE97; }
.plate.level-skin-3 .plate-status { color: #E0CFA3; }
.plate.level-skin-3 .plate-status.is-current { color: #F0DCAE; }

/* —— Lv4 紫檀 · 浅字 —— */
.hero-card.level-skin-4,
.plate.level-skin-4 {
  background:
    linear-gradient(96deg, rgba(240, 170, 160, 0.14) 0%, transparent 20%, transparent 66%, rgba(10, 2, 6, 0.58) 100%),
    linear-gradient(178deg, #5A2030 0%, #3A1522 22%, #4E1E2C 44%, #2A1018 70%, #421C28 100%);
  border-color: rgba(12, 9, 7, 0.8);
  box-shadow: inset 0 1rpx 0 rgba(226, 218, 204, 0.1);
}
.hero-card.level-skin-4 .card-grain,
.plate.level-skin-4 .card-grain {
  opacity: 0.8;
