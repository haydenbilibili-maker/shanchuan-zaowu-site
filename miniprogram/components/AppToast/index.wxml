<!-- 全站样式化轻提示：牌面与 AppModal 同取 app.wxss 弹层令牌（--pop-*）；非阻塞 -->
<view
  class="at-mask {{leaving ? 'is-out' : 'is-in'}}"
  wx:if="{{visible}}"
>
  <view class="at-plate">
    <text class="at-overline" wx:if="{{overline}}">{{overline}}</text>
    <text class="at-title" wx:if="{{title}}">{{title}}</text>
    <text class="at-desc" wx:if="{{desc}}">{{desc}}</text>
  </view>
</view>
