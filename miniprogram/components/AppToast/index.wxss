/* 全站样式化轻提示 —— 令牌与 AppModal / RegisterAuthDialog 完全一致（app.wxss 设计令牌） */

.at-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 1080;                /* 高于 AppModal(950) / 注册弹窗(900)：提示要在最上层看得见 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56rpx;
  box-sizing: border-box;
  /* 非阻塞：不拦点击、不拦滚动（提示归提示，别挡住用户手里的动作） */
  pointer-events: none;
  background: transparent;
  transition: opacity 0.24s ease, transform 0.24s ease;
}
.at-mask.is-in { opacity: 1; transform: scale(1); }
.at-mask.is-out { opacity: 0; transform: scale(0.98); }

.at-plate {
  position: relative;
  max-width: 520rpx;
  padding: 32rpx 36rpx 30rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  border-radius: var(--radius-md, 16rpx);
  background: linear-gradient(180deg, #221F1B 0%, #1A1814 100%);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.55);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.at-corner {
  position: absolute;
  width: 14rpx; height: 14rpx;
  border-color: rgba(196, 167, 108, 0.5);
  border-style: solid;
  border-width: 0;
}
.at-corner.is-tl { left: 11rpx; top: 11rpx; border-left-width: 1rpx; border-top-width: 1rpx; }
.at-corner.is-tr { right: 11rpx; top: 11rpx; border-right-width: 1rpx; border-top-width: 1rpx; }
.at-corner.is-bl { left: 11rpx; bottom: 11rpx; border-left-width: 1rpx; border-bottom-width: 1rpx; }
.at-corner.is-br { right: 11rpx; bottom: 11rpx; border-right-width: 1rpx; border-bottom-width: 1rpx; }

.at-overline {
  font-size: var(--fs-18);
  line-height: 26rpx;
  font-family: var(--font-mono);
  letter-spacing: .32em;
  color: var(--brass-400, #C4A76C);
  margin-bottom: 10rpx;
}

.at-title {
  font-size: var(--fs-34);
  font-family: var(--font-brand);
  font-weight: 500;
  letter-spacing: .06em;
  font-family: var(--font-brand);
  color: var(--color-text-primary, #FFFFFF);
  line-height: 1.4;
}

.at-desc {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}
