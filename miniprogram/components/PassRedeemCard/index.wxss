/* 核销成功结果卡 — 与券夹亮码动效同源（Museum Mode） */
.pass-redeem-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 24rpx 32rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--brass-800);
  background: linear-gradient(165deg, rgba(196, 167, 108, 0.14) 0%, #1A1814 48%, #1F1D1A 100%);
  box-sizing: border-box;
}

.pass-redeem-card.is-animating {
  animation: passRedeemIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes passRedeemIn {
  0% {
    opacity: 0;
    transform: translateY(16rpx) scale(0.96);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.pass-redeem-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.pass-redeem-status .signal-light {
  width: 12rpx;
  height: 12rpx;
}

/* 2026-09-21 分子级审计：本组件 wxml 用的是 `.signal-light.lamp-success.blink`，
   但它的圆点几何/绿色/**闪烁动画**全部定义在 app.wxss（`.signal-light` / `.signal-light.lamp-success`
   / `@keyframes signal-blink`）。本组件 json 没有 `styleIsolation`（默认 isolated，同目录 8 个组件都显式
   apply-shared）→ 这些全局规则进不来：圆点会渲染成**无底色的透明方块**、且不会闪。
   故把灯座样式与动画**搬进组件自己**（keyframes 用组件内专名，避开跨组件重名）。 */
.pass-redeem-status .signal-light.lamp-success {
  border-radius: 50%;
  background: var(--color-success, #52B788);
  border: 2rpx solid var(--color-success, #52B788);
  box-shadow: 0 0 8rpx rgba(82, 183, 136, 0.45);
  animation: passRedeemLampBlink 0.5s infinite;
}

@keyframes passRedeemLampBlink {
  0%, 100% {
    opacity: 0.3;
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 10rpx var(--color-success, #52B788);
  }
}

.pass-redeem-status-text {
  font-size: var(--fs-24);
  font-weight: 500;
  color: var(--color-success);
  letter-spacing: 0.06em;
}

.pass-redeem-seal {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
}

.pass-redeem-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 3rpx solid var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
  box-sizing: border-box;
}

.pass-redeem-card.is-animating .pass-redeem-ring {
  animation: passSealPulse 0.7s ease-out both;
}

@keyframes passSealPulse {
  0% {
    transform: scale(0.72);
    opacity: 0.4;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.pass-redeem-check {
  position: absolute;
  left: 28rpx;
  top: 34rpx;
  width: 28rpx;
  height: 14rpx;
  border-left: 4rpx solid var(--color-primary);
  border-bottom: 4rpx solid var(--color-primary);
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.pass-redeem-card.is-animating .pass-redeem-check {
  animation: passCheckDraw 0.45s 0.18s ease-out both;
}

@keyframes passCheckDraw {
  0% {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }
  100% {
    opacity: 1;
    transform: rotate(-45deg) scale(1);
  }
}

.pass-redeem-kicker {
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: var(--color-text-secondary);
}

.pass-redeem-title {
  margin-top: 10rpx;
  font-size: var(--fs-30);
  font-weight: 500;
  color: #FFFFFF;
  text-align: center;
  line-height: 1.35;
  max-width: 100%;
}

.pass-redeem-value {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
  color: var(--color-primary);
}

.pass-redeem-currency {
  font-size: var(--fs-28);
  font-weight: 600;
  margin-right: 4rpx;
}

.pass-redeem-amount {
  font-family: var(--font-mono);
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.02em;
}

.pass-redeem-badge {
  margin-top: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brass-800);
  background: rgba(196, 167, 108, 0.16);
  color: var(--color-primary);
  font-size: var(--fs-22);
  font-weight: 600;
  letter-spacing: 0.08em;
}

.pass-redeem-note {
  margin-top: 16rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  letter-spacing: 0.04em;
  text-align: center;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .pass-redeem-status .signal-light.lamp-success {
    animation: none;
  }
}
