@import '../desk-common.wxss';

/* 给悬浮「新建价目」让出底部空间 */
.page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 顶部主视觉：黄铜渐变底 + 三个可点的关键数（等分用 flex，不用百分比列宽） */
.hero {
  margin: var(--space-4) 0 var(--space-3);
  padding: 32rpx 32rpx 28rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  background: linear-gradient(135deg, rgba(196, 167, 108, 0.2) 0%, rgba(196, 167, 108, 0.04) 60%, rgba(255, 255, 255, 0.02) 100%);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 48rpx;
  color: var(--color-text-primary);
}

.hero-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-body);
}

.hero-mark {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.55);
}

.hero-mark-text {
  font-family: var(--font-brand);
  font-size: 44rpx;
  color: var(--brass-300);
}

.hero-stats {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.2);
}

.hero-stat {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.hero-stat + .hero-stat {
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
}

.hero-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.hero-stat-value.warn {
  color: var(--color-warning);
}

.hero-stat-value.danger {
  color: #e07a5f;
}

.hero-stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.hero-note {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.tabs {
  margin-top: 0;
}

.note-card {
  margin-bottom: var(--space-4);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.1);
}

/* 伙伴排行 */
.rank-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.rank.top {
  color: var(--brass-200);
}

/* 账号与价目：四格等分 */
.mini-stats {
  display: flex;
  margin: 8rpx 0 12rpx;
}

.mini-stat {
  flex: 1;
  min-width: 0;
  padding: 12rpx 0;
  text-align: center;
}

.mini-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.mini-stat-value.dim {
  color: var(--color-text-secondary);
}

.mini-stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.fold {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.fold-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.fold-arrow {
  font-size: 22rpx;
  color: var(--brass-300);
}

/* 订单卡：左侧色条按履约阶段 */
.order-card {
  border-left: 6rpx solid rgba(255, 255, 255, 0.1);
}

.order-card.ok {
  border-left-color: rgba(82, 183, 136, 0.7);
}

.order-card.warn {
  border-left-color: rgba(233, 162, 59, 0.8);
}

.order-card.brass {
  border-left-color: rgba(196, 167, 108, 0.8);
}

.order-card.danger {
  border-left-color: rgba(224, 122, 95, 0.6);
}

/* 价目卡：缩略图 + 信息 + 「更多」 */
.pcard {
  display: flex;
  align-items: stretch;
  margin-bottom: 16rpx;
  overflow: hidden;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.03);
}

.pcard.off {
  opacity: 0.62;
}

.pthumb {
  width: 176rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: rgba(196, 167, 108, 0.06);
}

.pthumb-img {
  width: 100%;
  height: 100%;
  min-height: 176rpx;
}

.pthumb-ph {
  text-align: center;
}

.pthumb-ph-text {
  display: block;
  font-family: var(--font-brand);
  font-size: 48rpx;
  color: var(--brass-400);
}

.pthumb-ph-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.pbody {
  flex: 1;
  min-width: 0;
  padding: 22rpx 20rpx 20rpx 24rpx;
}

.pfoot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.pprice {
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--brass-300);
}

.pguide {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.pmore {
  width: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 1rpx solid rgba(255, 255, 255, 0.06);
}

.pmore-text {
  font-size: 22rpx;
  writing-mode: vertical-rl;
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

/* 悬浮新建 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 22rpx 34rpx;
  border-radius: 999rpx;
  background: var(--brass-500);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.45);
}

.fab-plus {
  margin-right: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1408;
}

.fab-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1408;
}

/* 伙伴卡 */
.ptn-card.off {
  opacity: 0.62;
}

.ptn-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 999rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.45);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-family: var(--font-brand);
  font-size: 38rpx;
  color: var(--brass-300);
}

.ptn-stats {
  display: flex;
  margin: 20rpx 0 12rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.ptn-stat {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.ptn-stat + .ptn-stat {
  border-left: 1rpx solid rgba(255, 255, 255, 0.06);
}

.ptn-stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.ptn-stat-value.warn {
  color: var(--color-warning);
}

.ptn-stat-value.danger {
  color: #e07a5f;
}

.ptn-stat-value.dim {
  color: var(--color-text-muted);
}

.ptn-stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.preview-link {
  margin-top: var(--space-5);
  padding: 20rpx 0;
  text-align: center;
}

.preview-link-text {
  font-size: 24rpx;
  color: var(--brass-300);
}
