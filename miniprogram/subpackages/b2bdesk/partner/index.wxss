@import '../desk-common.wxss';

.ptn-hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: var(--space-5) 0 var(--space-3);
}

.ptn-logo {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 999rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.55);
}

.ptn-logo-text {
  font-family: var(--font-brand);
  font-size: 56rpx;
  color: var(--brass-300);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.ptn-hero-copy {
  flex: 1;
  min-width: 0;
}

/* 三格关键数：flex 等分，不用百分比列宽 */
.ptn-kpis {
  display: flex;
  margin-bottom: var(--space-4);
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.3);
}

.ptn-kpi {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.ptn-kpi + .ptn-kpi {
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
}

.ptn-kpi-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.ptn-kpi-value.warn {
  color: var(--color-warning);
}

.ptn-kpi-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.img-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: var(--space-3);
}

.img-row.wrap {
  flex-wrap: wrap;
}

.uploader.tile {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.img-side {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.img-side .img-act {
  text-align: center;
}

.tile-del {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 8rpx 0;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
}

.tile-del-text {
  font-size: 20rpx;
  color: #f5f1e8;
}

.bar-main.idle {
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}

.bar-main.idle .bar-main-text {
  color: var(--brass-200);
  font-weight: 500;
}
