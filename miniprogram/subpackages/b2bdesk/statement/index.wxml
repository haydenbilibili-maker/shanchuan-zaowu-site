<view class="page">
  <view class="head">
    <text class="head-en">STATEMENT</text>
    <text class="head-cn">对账与物流</text>
    <text class="head-note">{{preview ? '超管预览：' + (partnerName || '未选择伙伴') + ' 看到的内容。' : '你的采购 / 供货单据、货款与运单号。'}}金额以总部系统记录为准，有疑问请联系总部。</text>
  </view>

  <view class="chips">
    <view wx:for="{{ranges}}" wx:key="key" class="chip {{range === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="onRange">
      <text class="chip-text">{{item.label}}</text>
    </view>
  </view>

  <view wx:if="{{flash}}" class="flash"><text class="flash-text">{{flash}}</text></view>

  <view wx:if="{{loading}}" class="state">
    <text class="state-title">正在读取…</text>
  </view>
  <view wx:elif="{{error}}" class="state err">
    <text class="state-title">暂时无法查看</text>
    <text class="state-body">{{error}}</text>
    <view class="state-retry" bindtap="load"><text class="state-retry-text">重试</text></view>
  </view>
  <view wx:elif="{{needPartner}}" class="state">
    <text class="state-title">请选择一位伙伴</text>
    <text class="state-body">超管请从「供应商管理 → 伙伴 → 预览 TA 的对账与物流」进入。</text>
  </view>
  <block wx:else>
    <view class="kpi-grid">
      <view wx:for="{{kpis}}" wx:key="key" class="kpi">
        <text class="kpi-label">{{item.label}}</text>
        <text class="kpi-value">{{item.value}}</text>
        <text class="kpi-sub">{{item.sub}}</text>
      </view>
    </view>

    <view wx:if="{{!list.length}}" class="state">
      <text class="state-title">所选范围内没有单据</text>
      <text class="state-body">下单或收到采购需求后会出现在这里。</text>
    </view>
    <view wx:for="{{list}}" wx:key="_id" class="card">
      <view class="card-row" data-id="{{item._id}}" bindtap="toggleOpen">
        <view class="card-main">
          <text class="card-title">{{item.title}}</text>
          <text class="card-meta">{{item.dateText}} · {{item.orderNo || item._id}} · {{item.qty}} 件</text>
        </view>
        <view class="card-side">
          <text class="card-amount">{{item.amountText}}</text>
        </view>
      </view>
      <view class="tags">
        <view class="tag"><text class="tag-text">{{item.stageLabel}}</text></view>
        <view wx:if="{{item.payBucket !== 'na'}}" class="tag {{item.payTone}}"><text class="tag-text">{{item.payLabel}}</text></view>
        <view wx:if="{{item.overdue}}" class="tag danger"><text class="tag-text">已 {{item.agingDays}} 天未结</text></view>
        <view wx:if="{{item.trackingNo}}" class="tag brass" data-no="{{item.trackingNo}}" bindtap="copyTracking"><text class="tag-text">{{item.carrier}} {{item.trackingNo}} · 复制</text></view>
        <view class="tag" data-id="{{item._id}}" bindtap="toggleOpen"><text class="tag-text">{{openId === item._id ? '收起进度' : '查看进度'}}</text></view>
      </view>
      <view wx:if="{{openId === item._id}}" class="tl tl-inset">
        <view wx:for="{{item.timeline}}" wx:for-item="node" wx:for-index="ni" wx:key="key" class="tl-node {{node.state}}">
          <view class="tl-rail">
            <view class="tl-dot"></view>
            <view wx:if="{{ni < item.timeline.length - 1}}" class="tl-line"></view>
          </view>
          <view class="tl-body">
            <text class="tl-title">{{node.title}}</text>
            <text wx:if="{{node.timeText}}" class="tl-time">{{node.timeText}}</text>
            <text wx:if="{{node.note}}" class="tl-note">{{node.note}}</text>
          </view>
        </view>
      </view>
    </view>
    <text class="foot">最多展示最近 50 张单据。物流轨迹请复制运单号后到快递公司查询。</text>
  </block>
</view>
