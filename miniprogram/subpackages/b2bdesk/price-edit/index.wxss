@import '../desk-common.wxss';

.gallery {
  display: flex;
  flex-wrap: wrap;
}

.g-tile {
  width: 31%;
  margin: 0 3.5% 3.5% 0;
}

.g-tile:nth-child(3n) {
  margin-right: 0;
}

.g-box {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.2);
  background: rgba(196, 167, 108, 0.04);
}

.g-tile.on .g-box {
  border-color: var(--brass-400);
}

.g-img,
.g-broken,
.g-add-inner {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.g-broken,
.g-add-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.g-broken-text {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.g-add {
  border-style: dashed;
  border-color: rgba(196, 167, 108, 0.45);
}

.g-cover {
  position: absolute;
  left: 0;
  top: 0;
  padding: 4rpx 14rpx;
  border-bottom-right-radius: var(--radius-md);
  background: rgba(20, 16, 10, 0.72);
}

.g-cover-text {
  font-size: var(--fs-20);
  color: var(--brass-200);
}

.g-no {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  min-width: 36rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  text-align: center;
  background: rgba(20, 16, 10, 0.6);
}

.g-no-text {
  font-size: var(--fs-20);
  color: #f5f1e8;
}

.g-tools {
  display: flex;
  margin-top: 4rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  overflow: hidden;
}

.g-tool {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-left: 1rpx solid rgba(196, 167, 108, 0.2);
}

.g-tool:first-child {
  border-left: 0;
}

.g-tool.off {
  opacity: 0.35;
}

.g-tool-text {
  font-size: var(--fs-24);
  color: var(--brass-200);
}

.g-tool.danger .g-tool-text {
  color: #e07a5f;
}

.panel .field:last-child {
  margin-bottom: 0;
}

.danger-zone {
  border-color: rgba(224, 122, 95, 0.25);
}
