/* 供应商管理中心 · 分包公共样式（深色馆藏风，与供应商工作台同一套色阶） */
page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  padding: var(--space-5) 0 var(--space-3);
}

.head-en {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-400);
}

.head-cn {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
}

.head-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
}

/* 顶部分段 */
.tabs {
  display: flex;
  margin: var(--space-2) 0 var(--space-4);
  padding: 6rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tab {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 999rpx;
  text-align: center;
}

.tab.on {
  background: rgba(196, 167, 108, 0.16);
}

.tab-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.tab.on .tab-text {
  color: var(--color-text-primary);
  font-weight: 500;
}

/* 筛选芯片 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: var(--space-3);
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.chip.on {
  border-color: rgba(196, 167, 108, 0.6);
  background: rgba(196, 167, 108, 0.1);
}

.chip-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.chip.on .chip-text {
  color: var(--color-text-primary);
}

.row-label {
  display: block;
  margin: var(--space-2) 0 12rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--color-text-secondary);
}

/* 搜索 */
.search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--space-3);
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
  color: var(--color-text-primary);
  font-size: 26rpx;
}

.search-go {
  flex-shrink: 0;
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
}

.search-go-text {
  font-size: 24rpx;
  color: var(--brass-300);
}

/* 指标卡：两列网格
 * ⚠️ 不用 `width: calc(50% - Xrpx)` + `gap`：两格加间距**恰好 = 100%、零余量**，真机 rpx 换算的精度误差
 * 只要多出一丝就整行折断 → 每行只剩一张、右半边空白（2026-09-29 真机截图）。离线预览 1rpx=1px 精确，永远复现不了。
 * 改为百分比宽度 + space-between，留 3% 余量；行距用 margin-bottom（守卫 check:supplier-desk 钉住）。 */
.kpi-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}

.kpi {
  width: 48.5%;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.03);
}

.kpi.hot {
  border-color: rgba(196, 167, 108, 0.4);
}

.kpi.warn,
.kpi.alert {
  border-color: rgba(233, 162, 59, 0.55);
  background: rgba(233, 162, 59, 0.07);
}

.kpi.alert .kpi-value {
  color: var(--color-warning);
}

.kpi.mute {
  border-color: rgba(255, 255, 255, 0.05);
  background: transparent;
}

.kpi.mute .kpi-value {
  color: var(--color-text-secondary);
  font-weight: 500;
}

.kpi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kpi-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--color-warning);
}

/* 汇总大卡：订单数 + 金额 / 已收 · 待收 */
.sum-card {
  margin-bottom: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.07);
}

.sum-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.sum-top-side {
  text-align: right;
}

.sum-big {
  display: block;
  margin-top: 6rpx;
  font-size: 56rpx;
  line-height: 1.1;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.sum-amount {
  display: block;
  margin-top: 6rpx;
  font-size: 40rpx;
  line-height: 1.1;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--brass-300);
}

.sum-split {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
}

.sum-cell {
  width: 48.5%;
  box-sizing: border-box;
}

.sum-cell + .sum-cell {
  padding-left: 24rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
}

.sum-mid {
  display: block;
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.sum-mid.due {
  color: var(--color-warning);
}

.grid-title {
  display: block;
  margin: 8rpx 0 12rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--color-text-secondary);
}

.kpi-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.kpi-value {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.kpi-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--color-text-secondary);
}

.section {
  margin-bottom: var(--space-5);
}

.section-title {
  display: block;
  margin-bottom: var(--space-2);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.section-sub {
  display: block;
  margin: -8rpx 0 var(--space-2);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

/* 账龄条 */
.bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.bar-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.bar-track {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--brass-500);
}

.bar-fill.warn {
  background: var(--color-warning);
}

.bar-value {
  width: 96rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.rank {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--brass-400);
}

.card-row.center {
  align-items: center;
}

/* 列表 */
.card {
  display: block;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.03);
}

.card-press {
  border-color: rgba(196, 167, 108, 0.45);
  opacity: 0.9;
}

.card-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  word-break: break-all;
}

.card-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--color-text-secondary);
  word-break: break-all;
}

.card-side {
  flex-shrink: 0;
  text-align: right;
}

.card-amount {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--brass-300);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.tag-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.tag.brass {
  border-color: rgba(196, 167, 108, 0.5);
}

.tag.brass .tag-text {
  color: var(--brass-300);
}

.tag.warn {
  border-color: rgba(233, 162, 59, 0.55);
}

.tag.warn .tag-text {
  color: var(--color-warning);
}

.tag.ok {
  border-color: rgba(82, 183, 136, 0.5);
}

.tag.ok .tag-text {
  color: var(--color-success);
}

.tag.danger {
  border-color: rgba(224, 122, 95, 0.55);
}

.tag.danger .tag-text {
  color: #e07a5f;
}

/* 状态面板 */
.state {
  margin-top: var(--space-2);
  padding: var(--space-5);
  border-radius: var(--radius-md);
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  text-align: center;
}

.state.err {
  border-style: solid;
  border-color: rgba(224, 122, 95, 0.4);
}

.state-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.state.err .state-title {
  color: #e07a5f;
}

.state-body {
  display: block;
  margin-top: var(--space-2);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.state-retry {
  display: inline-block;
  margin-top: var(--space-3);
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
}

.state-retry-text {
  font-size: 24rpx;
  color: var(--color-text-primary);
}

.flash {
  margin-bottom: var(--space-3);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
}

.flash.err {
  border-color: rgba(224, 122, 95, 0.5);
}

.flash-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--brass-200);
}

.flash.err .flash-text {
  color: #e07a5f;
}

/* 按钮（view 实现：不受原生 button 默认宽度影响，满宽由 display:block 保证） */
.btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-top: var(--space-3);
  padding: 24rpx 0;
  border-radius: 999rpx;
  text-align: center;
  background: var(--brass-500);
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1408;
}

.btn.ghost {
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
}

.btn.ghost .btn-text {
  color: var(--brass-200);
  font-weight: 500;
}

.btn.danger {
  background: transparent;
  border: 1rpx solid rgba(224, 122, 95, 0.55);
}

.btn.danger .btn-text {
  color: #e07a5f;
  font-weight: 500;
}

.btn.armed {
  background: rgba(224, 122, 95, 0.9);
}

.btn.armed .btn-text {
  color: #1a1408;
}

.btn.busy {
  opacity: 0.55;
}

.btn-press {
  opacity: 0.8;
}

.link {
  font-size: 24rpx;
  color: var(--brass-300);
}

.foot {
  display: block;
  margin-top: var(--space-4);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* 时间线 */
.tl {
  padding-left: 8rpx;
}

.tl-inset {
  margin-top: 24rpx;
}

.tl-node {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
}

.tl-rail {
  position: relative;
  width: 24rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  box-sizing: border-box;
}

.tl-node.done .tl-dot {
  border-color: var(--brass-400);
  background: var(--brass-400);
}

.tl-node.current .tl-dot {
  border-color: var(--color-warning);
  background: rgba(233, 162, 59, 0.3);
}

.tl-node.warn .tl-dot {
  border-color: #e07a5f;
  background: #e07a5f;
}

.tl-line {
  flex: 1;
  width: 2rpx;
  margin-top: 6rpx;
  background: rgba(255, 255, 255, 0.1);
}

.tl-node.done .tl-line {
  background: rgba(196, 167, 108, 0.45);
}

.tl-body {
  flex: 1;
  min-width: 0;
}

.tl-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.tl-node.done .tl-title,
.tl-node.current .tl-title,
.tl-node.warn .tl-title {
  color: var(--color-text-primary);
}

.tl-time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-secondary);
}

.tl-note {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--brass-200);
}

/* 键值表 */
.kv {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.kv-k {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.kv-v {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-primary);
  word-break: break-all;
}

/* 表单 */
.field {
  margin-bottom: var(--space-3);
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.field-input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.field-input.bad {
  border-color: rgba(224, 122, 95, 0.7);
}

.field-err {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #e07a5f;
}

.field-hint {
  display: block;
  margin: 8rpx 0 var(--space-3);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.pair {
  display: flex;
  gap: 16rpx;
}

.pair .field {
  flex: 1;
  min-width: 0;
}

/* 开关行（view 实现，避免原生 switch 在深色底上的默认配色） */
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.toggle-copy {
  flex: 1;
  min-width: 0;
}

.toggle-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.toggle-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--color-text-secondary);
}

.toggle {
  position: relative;
  width: 88rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
}

.toggle.on {
  background: var(--brass-500);
}

.toggle-knob {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #f5f1e8;
}

.toggle.on .toggle-knob {
  left: 46rpx;
}

/* ───────── 2026-09-30 改版：通用件（搜索框 / 分段 / 骨架 / 药丸 / 面板 / 底部弹层 / 吸底操作栏 / 图片上传） ───────── */
.tab {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-count {
  margin-left: 8rpx;
  padding: 0 10rpx;
  min-width: 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  color: var(--brass-300);
}

.tab-dot {
  width: 12rpx;
  height: 12rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
  background: var(--color-warning);
}

.chip-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: var(--space-3);
}

.chip-line {
  display: inline-flex;
  gap: 12rpx;
  padding-right: var(--space-4);
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
}

.search-box .search-input {
  height: 76rpx;
  padding: 0;
  border: none;
  background: transparent;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
  color: var(--brass-400);
}

.filter-btn {
  flex-shrink: 0;
  padding: 18rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.filter-btn.on {
  border-color: rgba(196, 167, 108, 0.6);
}

.filter-btn-text {
  font-size: 24rpx;
  color: var(--brass-200);
}

.filter-panel {
  margin: -8rpx 0 var(--space-3);
  padding: 8rpx 24rpx 12rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.22);
}

.link-row {
  padding: 8rpx 0 12rpx;
  text-align: right;
}

/* 分段筛选：等分，flex 撑满（不用百分比列宽） */
.seg {
  display: flex;
  margin-bottom: var(--space-3);
  padding: 6rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
}

.seg-item.on {
  background: rgba(196, 167, 108, 0.16);
}

.seg-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.seg-item.on .seg-text {
  color: var(--color-text-primary);
  font-weight: 500;
}

.seg-count {
  margin-left: 8rpx;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
  color: var(--brass-300);
}

/* 骨架屏 */
.skel-block,
.skel-line,
.skel-thumb,
.skel-avatar {
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  animation: skel-pulse 1.4s ease-in-out infinite;
}

.skel-block {
  height: 150rpx;
  margin-bottom: 16rpx;
}

.skel-block.tall {
  height: 240rpx;
}

.skel-grid {
  display: flex;
  justify-content: space-between;
}

.skel-grid .skel-block {
  width: 48.5%;
}

.skel-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.skel-card.row {
  display: flex;
  align-items: center;
}

.skel-thumb {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.skel-avatar {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  border-radius: 999rpx;
}

.skel-lines {
  flex: 1;
  min-width: 0;
}

.skel-line {
  height: 24rpx;
  margin: 12rpx 0;
}

.skel-line.w40 { width: 40%; }
.skel-line.w60 { width: 60%; }
.skel-line.w80 { width: 80%; }

@keyframes skel-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* 空态大字徽 */
.state-mark {
  display: inline-block;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: var(--space-3);
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  font-family: var(--font-brand);
  font-size: 44rpx;
  line-height: 96rpx;
  color: var(--brass-300);
}

.state-retry.primary {
  border-color: var(--brass-500);
}

.state-retry.primary .state-retry-text {
  color: var(--brass-200);
}

.empty-mini {
  padding: var(--space-3) 0;
  text-align: center;
}

/* 药丸状态（只展示，不可点） */
.pill {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.pill-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.pill.ok {
  border-color: rgba(82, 183, 136, 0.5);
}

.pill.ok .pill-text {
  color: var(--color-success);
}

.pill.danger {
  border-color: rgba(224, 122, 95, 0.55);
}

.pill.danger .pill-text {
  color: #e07a5f;
}

.clamp1 {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-meta.dim {
  color: var(--color-text-muted);
}

.card-arrow {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  color: var(--color-text-muted);
}

.tags.tight {
  margin-top: 8rpx;
}

.foot.center {
  text-align: center;
}

/* 面板（分区卡） */
.panel {
  margin-bottom: var(--space-4);
  padding: 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.025);
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.panel-head .section-title {
  margin-bottom: 0;
}

.panel-side {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.panel-foot {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
}

.panel-title-en {
  display: block;
  margin-bottom: 4rpx;
  font-size: 18rpx;
  letter-spacing: 0.16em;
  color: var(--brass-400);
}

/* 底部弹层（自定义，不用原生弹框） */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: rgba(0, 0, 0, 0.55);
}

.sheet {
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.3);
  background: #221f1a;
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 24rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sheet-thumb {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
}

.sheet-item {
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.sheet-item-text {
  display: block;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.sheet-item.primary .sheet-item-text {
  color: var(--brass-200);
  font-weight: 500;
}

.sheet-item-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.sheet-hint {
  display: block;
  padding: 22rpx 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.sheet-cancel {
  margin-top: 20rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  text-align: center;
}

.sheet-cancel-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.sheet-press {
  opacity: 0.7;
}

/* 吸底操作栏（编辑页） */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(196, 167, 108, 0.25);
  background: rgba(26, 24, 20, 0.96);
}

.bar-ghost {
  flex-shrink: 0;
  padding: 22rpx 30rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.bar-ghost-text {
  font-size: 26rpx;
  color: var(--color-text-body);
}

.bar-main {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  text-align: center;
  background: var(--brass-500);
}

.bar-main.busy {
  opacity: 0.55;
}

.bar-main-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1408;
}

.page.with-bar {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 图片上传 */
.uploader {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--radius-md);
  border: 1rpx dashed rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.04);
}

.uploader.has {
  border-style: solid;
  border-color: rgba(196, 167, 108, 0.3);
}

.uploader-img {
  width: 100%;
  height: 100%;
}

.uploader-empty {
  text-align: center;
}

.uploader-plus {
  display: block;
  font-size: 56rpx;
  line-height: 1;
  color: var(--brass-400);
}

.uploader-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--brass-200);
}

.uploader-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.uploader-busy {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
}

.uploader-busy-text {
  font-size: 24rpx;
  color: #f5f1e8;
}

.img-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.img-act {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}

.img-act-text {
  font-size: 24rpx;
  color: var(--brass-200);
}

.img-act.danger {
  border-color: rgba(224, 122, 95, 0.5);
}

.img-act.danger .img-act-text {
  color: #e07a5f;
}

/* 通用按压态（hover-class="wb-press"，与 workbench-nav.wxss 同值；b2bdesk 分包公共） */
.wb-press {
  opacity: 0.72;
}
