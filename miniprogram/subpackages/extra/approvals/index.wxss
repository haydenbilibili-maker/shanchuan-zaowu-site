/* 审批中心 — Museum Mode 体验打磨 */
@import '../utils/workbench-nav.wxss';
@import '../../../styles/badges.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.container {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— Header（对齐 CRM：无页内 NavBack，依赖原生顶栏左滑） —— */
.header {
  padding: var(--space-5) 0 var(--space-2);
}

.brand-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-3);
}

.brand-group {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.brand-group .en {
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.brand-group .cn {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  color: var(--color-text-primary);
  margin-top: 4rpx;
}

/* 副文案整行展示，避免挤进窄 chip 把「超管」拆开 */
.scope-sub {
  display: block;
  margin-top: var(--space-2);
  padding: 0;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.45;
  word-break: keep-all;
  overflow-wrap: break-word;
}

.sla-warn {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-22);
  color: var(--color-warning);
}

/* —— Tabs —— */
.tab-bar {
  display: flex;
  margin-top: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.tab-bar .tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: var(--fs-26);
  color: var(--color-text-secondary, #A09A90);
  border-bottom: 2rpx solid transparent;
  margin-bottom: -1px;
}

.tab-bar .tab.active {
  color: var(--brass-400);
  border-bottom-color: var(--brass-400);
  font-weight: 500;
}

.tab-badge {
  display: inline-flex;
  margin-left: 6rpx;
  vertical-align: middle;
  /* 视觉走全局 .badge-info（员工待办）；此处只负责间距 */
}

/* —— Filter pills —— */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-3);
  flex-wrap: wrap;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-full);
}

.filter-pill.locked {
  border-color: var(--color-border);
  opacity: 0.85;
}

.pill-label {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}

.pill-value {
  font-size: var(--fs-24);
  color: var(--color-text-primary);
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pill-caret {
  font-size: var(--fs-18);
  color: var(--brass-400);
  margin-left: 2rpx;
}

.filter-count {
  margin-left: auto;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  font-family: var(--font-mono);
}

/* —— Cards —— */
.card-list {
  margin-top: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.card.open {
  border-color: var(--brass-800);
}

.card.overdue {
  border-left: 4rpx solid var(--color-warning);
}

.card.rejected {
  border-color: rgba(214, 64, 69, 0.28);
}

.card.approved {
  border-color: rgba(82, 183, 136, 0.22);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-2);
}

.card-title {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  font-weight: 500;
  line-height: 1.35;
}

.status-pill {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-20);
  font-weight: 500;
  line-height: 1.4;
}

.status-pill.pending {
  background: rgba(233, 162, 59, 0.16);
  color: var(--color-warning);
}

.status-pill.approved {
  background: rgba(82, 183, 136, 0.16);
  color: var(--color-success);
}

.status-pill.rejected {
  background: rgba(214, 64, 69, 0.16);
  color: var(--color-error-on-tint);
}

.status-pill.ignored {
  background: rgba(233, 162, 59, 0.16);
  color: var(--color-warning);
}

.status-pill.cancelled {
  background: rgba(106, 101, 96, 0.2);
  color: var(--color-text-secondary, #A09A90);
}

.card-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.type-tag {
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-20);
  background: rgba(196, 167, 108, 0.12);
  color: var(--brass-400);
}

.sla-tag {
  font-size: var(--fs-20);
  color: var(--color-warning);
}

.card-summary {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-24);
  color: var(--color-text-body);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-top: 10rpx;
}

.card-meta {
  flex: 1;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta.subtle {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  opacity: 0.85;
}

.card-peek {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--brass-400);
}

/* 驳回提示条 */
.reject-bar {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: var(--space-2);
  padding: 12rpx 16rpx;
  background: rgba(214, 64, 69, 0.1);
  border-radius: var(--radius-md);
  border: 1px solid rgba(214, 64, 69, 0.28);
}

.reject-label {
  flex-shrink: 0;
  font-size: var(--fs-20);
  font-weight: 500;
  color: var(--color-error);
  letter-spacing: 0.04em;
}

.reject-text {
  flex: 1;
  font-size: var(--fs-22);
  color: var(--color-text-body);
  line-height: 1.4;
}

/* 详情 */
.card-detail {
  margin-top: var(--space-2);
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg-elevated);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
}

.detail-row {
  display: flex;
  gap: var(--space-2);
  margin-top: 8rpx;
}

.detail-row:first-child {
  margin-top: 0;
}

.detail-label {
  flex-shrink: 0;
  width: 64rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.detail-val {
  flex: 1;
  font-size: var(--fs-22);
  color: var(--color-text-body);
  word-break: break-all;
}

.detail-val.mono {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
}

.detail-hint {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

/* 操作区 */
.card-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.card-actions.decide .btn-reject,
.card-actions.decide .btn-ignore,
.card-actions.decide .btn-approve {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  font-weight: 500;
}

.btn-approve {
  background: var(--brass-400);
  color: var(--color-bg);
}

.btn-approve:active {
  background: var(--brass-500);
}

.btn-reject {
  background: transparent;
  border: 1px solid rgba(214, 64, 69, 0.55);
  color: var(--color-error);
}

.btn-reject:active {
  background: rgba(214, 64, 69, 0.1);
}

.btn-ignore {
  background: transparent;
  border: 1rpx solid var(--brass-400);
  color: var(--brass-400);
}

.btn-ignore:active {
  background: rgba(196, 167, 108, 0.1);
}

/* 按压态（:active 在部分真机不触发，以 hover-class 为准） */
.ap-btn-press { opacity: 0.72; }
/* 「通过」进入二次确认：描边加亮，提示再点一次 */
.btn-approve.is-confirm { box-shadow: 0 0 0 2rpx var(--color-bg), 0 0 0 4rpx var(--brass-400); }
/* 提交中：整排按钮压暗且不可再点（防重复提交的可见反馈） */
.card-actions.is-busy,
.btn-nudge.is-busy { opacity: 0.45; pointer-events: none; }
/* 正在处理的那张卡不压暗，按钮上的「处理中…」要看得清；仍不可再点 */
.card-actions.is-busy.is-current,
.btn-nudge.is-busy.is-current {
  opacity: 1;
}

/* 首屏 / 列表骨架 */
.ap-boot { padding-top: var(--space-5); }
.ap-skeleton { margin-top: var(--space-3); }
.ap-boot .ui-sk-line.bar { margin-top: 32rpx; }

.attach-block {
  margin-top: var(--space-2);
}

.claim-thumbs {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.claim-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
}

.attach-empty {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-sm);
}

.btn-nudge {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border: 1rpx solid var(--brass-400);
  color: var(--brass-400);
  border-radius: var(--radius-md);
  font-size: var(--fs-26);
}

/* Empty / footer */
.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}

.empty {
  padding: var(--space-8) var(--space-4);
  text-align: center;
}

.empty.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: var(--radius-md);
  margin: 0 var(--space-4);
  padding: 32rpx 24rpx;
}

.btn-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
  font-size: var(--fs-24);
  color: #e8dcc0;
}

.empty-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-secondary);
}

.empty-hint {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.load-more {
  text-align: center;
  padding: var(--space-4);
  font-size: var(--fs-24);
  color: var(--brass-400);
}

.footer-hint {
  text-align: center;
  padding: var(--space-2);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

/* ===== 数据概览（默认收起；对齐 CRM / 藏品库 pstats） ===== */
.overview-panel {
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-top: var(--space-2);
  margin-bottom: var(--space-3);
}

.overview-panel.is-collapsed {
  padding-bottom: var(--space-3);
}

.overview-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-2);
}

.overview-panel.is-open .overview-head {
  margin-bottom: var(--space-3);
}

.overview-head-press {
  opacity: 0.85;
}

.overview-title-wrap {
  flex: 1;
  min-width: 0;
}

.overview-title {
  display: block;
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--color-text-primary);
}

.overview-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-head-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-shrink: 0;
  padding-top: 4rpx;
}

.overview-refresh {
  font-size: var(--fs-22);
  color: var(--brass-400);
  padding: 8rpx 0;
  line-height: 1.3;
}

.overview-fold {
  font-size: var(--fs-22);
  color: var(--brass-400);
  padding: 8rpx 0;
  line-height: 1.3;
}

.overview-body {
  overflow: hidden;
  animation: overview-body-in 0.22s ease;
}

@keyframes overview-body-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.sub-tab-row {
  display: flex;
  margin-bottom: var(--space-3);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 8rpx;
  border: 1rpx solid var(--color-border);
}

.sub-tab-row .sub-tab {
  flex: 1;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  font-weight: 500;
  border-bottom: none;
  margin-bottom: 0;
}

.sub-tab-row .sub-tab.active {
  background: var(--color-bg-elevated);
  color: var(--brass-400);
}

.overview-loading {
  padding: var(--space-5) 0;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.overview-hint {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
  margin-bottom: var(--space-3);
}

.ov-cards {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.ov-card {
  width: calc(33.33% - 12rpx);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-2);
  box-sizing: border-box;
}

.ov-val {
  display: block;
  font-size: var(--fs-36);
  font-weight: 600;
  color: var(--color-text-primary);
  font-family: var(--font-mono);
  line-height: 1.2;
}

.ov-val.accent { color: var(--brass-400); }
.ov-val.muted { color: var(--color-text-secondary); }
.ov-val.warn { color: var(--color-warning); }

.ov-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
}

.ov-section { margin-bottom: var(--space-2); }

.ov-sec-title {
  display: block;
  font-size: var(--fs-22);
  color: var(--brass-400);
  letter-spacing: 0.06em;
  margin-bottom: var(--space-2);
}

.ov-bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.ov-bar-label {
  width: 160rpx;
  font-size: var(--fs-22);
  color: var(--color-text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}

.ov-bar-track {
  flex: 1;
  height: 12rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.ov-bar-fill {
  height: 100%;
  background: var(--brass-400);
  border-radius: var(--radius-full);
  min-width: 4rpx;
}

.ov-bar-count {
  width: 56rpx;
  text-align: right;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  font-family: var(--font-mono);
}

.ov-empty {
  padding: var(--space-3) 0;
  text-align: center;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

/* —— 审核区入口 —— */
.audit-hub {
  margin-top: var(--space-1);
  margin-bottom: var(--space-3);
}

.audit-hub-label {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: var(--color-text-secondary, #A09A90);
  text-transform: uppercase;
  margin-bottom: var(--space-2);
}

.audit-hub-row {
  display: flex;
  gap: 12rpx;
}

.audit-hub-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  white-space: nowrap;
}

.audit-hub-chip.active {
  color: var(--brass-400);
  border-color: var(--brass-800);
  background: rgba(196, 167, 108, 0.08);
}

.audit-hub-chip:active {
  opacity: 0.88;
}

/* —— 积分流水 —— */
.store-picker {
  margin-top: var(--space-3);
}

.picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 var(--space-4);
  margin-bottom: var(--space-2);
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.picker-inner.filter-picker {
  border-color: var(--color-border);
}

.picker-label {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.picker-value {
  flex: 1;
  margin-left: var(--space-3);
  font-size: var(--fs-28);
  color: var(--color-text-primary);
}

.picker-arrow {
  font-size: var(--fs-22);
  color: var(--brass-400);
}

.flow-note {
  display: block;
  margin: var(--space-2) 0 var(--space-3);
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

.flow-list {
  margin-top: var(--space-1);
}

.record {
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.record:last-child {
  border-bottom: none;
}

.rec-top,
.rec-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.rec-bottom {
  margin-top: 8rpx;
}

.rec-member {
  font-size: var(--fs-28);
  color: var(--color-text-primary);
}

.rec-points {
  font-family: var(--font-mono);
  font-size: var(--fs-28);
}

.rec-points.gold {
  color: var(--brass-400);
}

.rec-points.revoked {
  color: var(--color-text-secondary, #A09A90);
  text-decoration: line-through;
}

.rec-meta {
  font-family: var(--font-mono);  /* VIS3 纪律 05：金额等宽（¥ 金额 · 时间同行） */
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
  margin-top: 6rpx;
}

.rec-meta.warn {
  color: var(--color-warning);
}

.rec-remark {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.pending-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-top: 4rpx;
}

.pending-link {
  font-size: var(--fs-22);
  color: var(--brass-400);
  flex-shrink: 0;
}

.claim-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.claim-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-elevated);
}

.rec-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
}

.btn-danger-mini {
  padding: 10rpx 24rpx;
  font-size: var(--fs-22);
  color: #fff;
  background: var(--color-error);
  border-radius: var(--radius-sm);
}

.btn-danger-mini:active {
  opacity: 0.85;
}

.flow-empty {
  margin-top: var(--space-6);
}

/* —— 撤销弹窗 ——
   形态 / 遮罩 / 牌面 / 头部 / 标题 / 说明全取 app.wxss 的 ui-pop-*（docs/弹层视觉规范_2026-10-13.md）；
   这里只留本弹层特有的尺寸与滚动（牌面自带左右 40rpx 内边距，内部块不再加左右留白）。 */
.modal {
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-body {
  /* 2026-10-18 改为 <scroll-view scroll-y>：遮罩 catchtouchmove 会吞掉 view 的 overflow 滚动，长表单滑不动 */
  flex: 1 1 auto;
  min-height: 0;
  max-height: calc(86vh - 260rpx);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 8rpx 4rpx 0;
  box-sizing: border-box;
}

.field {
  margin-bottom: var(--space-4);
}

.field-label {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.field-hint {
  display: block;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

.input {
  width: 100%;
  min-height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: var(--fs-28);
}

.seg-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.seg-item {
  padding: 12rpx 20rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(160, 154, 144, 0.35);
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.seg-item.on {
  border-color: var(--brass-400);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.08);
}

.modal .workbench-modal-foot {
  display: flex;
  gap: var(--space-3);
  padding: 24rpx 0 0;
}

.modal .workbench-modal-foot .workbench-btn-outline,
.modal .workbench-modal-foot .workbench-btn-danger {
  flex: 1;
  width: auto;
}

/* ================================================================
   2026-10-18 审批中心：视觉对齐 + 驳回面板（产品负责人「可适当做前端交互与新的功能创新」）
   等宽眉标 + 宋体；卡片方角发丝框（超时仍是左侧警示线、驳回 / 通过仍是红绿边语义）；
   胶囊（筛选 / 状态 / 原因签 / 重试）改方签；审核区 = 方角分段；「通过」仍是卡内唯一实心金。
   ================================================================ */
.brand-group .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.brand-group .cn {
  margin-top: 8rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.overview-panel {
  background: rgba(243, 236, 221, 0.02);
  border-color: rgba(196, 167, 108, 0.16);
  border-radius: 4rpx;
}
.sub-tab-row,
.sub-tab-row .sub-tab,
.ov-card,
.picker-inner,
.input,
.page-tip,
.empty.is-error { border-radius: 2rpx; }

.audit-hub-chip {
  border-radius: 2rpx;
  background: transparent;
  border-color: rgba(196, 167, 108, 0.16);
}
.audit-hub-chip.active {
  color: var(--brass-200);
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}

.filter-pill {
  border-radius: 2rpx;
}

.card {
  background: rgba(243, 236, 221, 0.02);
  border: 1rpx solid rgba(196, 167, 108, 0.16);
  border-radius: 4rpx;
}
.card.open { border-color: rgba(196, 167, 108, 0.45); }
.card-title {
  font-family: var(--font-brand);
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #F3ECDD;
}
.status-pill,
.type-tag,
.reject-bar,
.card-detail,
.btn-nudge,
.btn-danger-mini { border-radius: 2rpx; }
.card-actions.decide .btn-reject,
.card-actions.decide .btn-ignore,
.card-actions.decide .btn-approve { border-radius: 4rpx; }
.btn-retry {
  border-radius: 2rpx;
  color: var(--brass-200);
}

/* 驳回面板 */
.reject-sheet .reason-chip,
.seg-item { border-radius: 2rpx; }
.reject-sheet .reason-chip {
  padding: 14rpx 20rpx;
  border-color: rgba(196, 167, 108, 0.2);
  color: var(--color-text-body);
}
.reject-sheet .reason-chip.on {
  color: #F0C9C0;
  border-color: rgba(214, 64, 69, 0.55);
  background: rgba(214, 64, 69, 0.1);
}
.reject-note {
  height: 168rpx;
  min-height: 168rpx;
  padding: 18rpx 20rpx;
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}
.reject-preview {
  margin-top: 4rpx;
  padding: 4rpx 0 4rpx 20rpx;
  border-left: 2rpx solid rgba(214, 64, 69, 0.5);
}
.reject-preview-label {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: var(--color-text-secondary);
}
.reject-preview-text {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-26);
  line-height: 1.5;
  color: #F3ECDD;
}
.reject-sheet .page-tip { margin-top: 16rpx; }

/* 小惊喜：待审清空朱印「审毕」（只在本次进页后亲手办结过才出现；首次打开就空不盖） */
.clear-seal {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto var(--space-3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(196, 72, 58, 0.85);
  border-radius: 6rpx;
  box-shadow: inset 0 0 0 5rpx rgba(26, 24, 20, 0.9), inset 0 0 0 7rpx rgba(196, 72, 58, 0.5);
  color: rgba(214, 92, 76, 0.92);
  transform: rotate(-10deg);
  animation: clear-seal-stamp 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
}
.clear-seal-ch {
  font-family: var(--font-brand);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 40rpx;
}
@keyframes clear-seal-stamp {
  0% { opacity: 0; transform: rotate(-10deg) scale(1.9); }
  60% { opacity: 1; transform: rotate(-10deg) scale(0.94); }
  100% { opacity: 1; transform: rotate(-10deg) scale(1); }
}
.clear-count {
  display: block;
  margin-bottom: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-300);
}
@media (prefers-reduced-motion: reduce) {
  .clear-seal { animation: none; }
}
