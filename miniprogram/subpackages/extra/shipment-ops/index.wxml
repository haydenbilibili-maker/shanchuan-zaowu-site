<page-meta page-style="{{skuPicker.show || skuEdit.show || picker.show || libForm.show || showDetail || memoBox.show || memoDetail.show ? 'overflow: hidden;' : ''}}" />
<!-- 出货中心（2026-09-28 合并）。单价只来自云函数，取不到显示「待核价」
     底部弹层：遮罩 / 标题 / 搜索 / 底部按钮 catchtouchmove，列表 scroll-view 不加（加了就滑不动）；page-meta 锁背后页面 -->
<view class="ops-boot" wx:if="{{!ready}}">柜门缓缓开启…</view>

<view class="ops-page sc-page {{activeTab === 'create' ? 'has-dock' : ''}}" wx:if="{{ready}}">
  <view class="ops-container">
    <view class="ops-header compact">
      <text class="ops-eyebrow">SHIPMENT · CENTER</text>
      <view class="ops-title-row">
        <text class="ops-title">出货中心</text>
        <text class="sc-role-chip">{{isSuper ? '超管' : '店长 · 本店'}}</text>
        <text class="ops-meta-chip" wx:if="{{dashLoading || loading || libLoading}}">刷新中</text>
      </view>
      <text class="ops-note">{{isSuper ? '开单、查单、物流和 SKU（含原材料 / 包装）都在这里' : '开单、查单、物流和原材料 / 包装资料都在这里'}}；结算在「工作室账单」里处理。</text>
    </view>

    <view class="ops-tip is-{{tipTone}}" wx:if="{{tipText}}"><text>{{tipText}}</text></view>

    <view class="sc-tabs">
      <view
        class="sc-tab {{activeTab === item.key ? 'on' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-tab="{{item.key}}"
        bindtap="switchTab"
      >{{item.label}}</view>
    </view>

    <!-- 开单 -->
    <block wx:if="{{activeTab === 'create'}}">
      <view class="sc-modes">
        <view class="sc-mode {{createMode === 'sku' ? 'on' : ''}}" wx:if="{{isSuper}}" data-mode="sku" bindtap="switchCreateMode">
          <text class="sc-mode-title">选 SKU</text>
          <text class="sc-mode-sub">目录组合 · 自动算价</text>
        </view>
        <view class="sc-mode {{createMode === 'paste' ? 'on' : ''}}" data-mode="paste" bindtap="switchCreateMode">
          <text class="sc-mode-title">粘贴识别</text>
          <text class="sc-mode-sub">整段文本 · 多店</text>
        </view>
        <view class="sc-mode {{createMode === 'single' ? 'on' : ''}}" data-mode="single" bindtap="switchCreateMode">
          <text class="sc-mode-title">单条补录</text>
          <text class="sc-mode-sub">一门店 · 一行明细</text>
        </view>
      </view>

      <view class="ops-tip is-{{createTipTone}}" wx:if="{{createTip}}"><text>{{createTip}}</text></view>

      <!-- 客户 + 出货日：SKU 与单条共用 -->
      <view class="ss-card" wx:if="{{createMode === 'sku' || createMode === 'single'}}">
        <text class="ss-card-en">ORDER</text>
        <view class="ss-row">
          <text class="ss-label">客户 / 门店</text>
          <picker class="ss-pick" mode="selector" range="{{storeNames}}" value="{{draft.storeIndex}}" bindchange="onDraftStore" disabled="{{!storeNames.length}}">
            <view class="ss-pick-inner">
              <text class="ss-pick-val {{storeNames[draft.storeIndex] ? '' : 'is-empty'}}">{{storeNames[draft.storeIndex] || (storeNames.length ? '请选择' : '暂无可选门店')}}</text>
              <text class="ss-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="ss-row">
          <text class="ss-label">出货日</text>
          <picker class="ss-pick" mode="date" value="{{draft.shipmentDate}}" bindchange="onDraftDate">
            <view class="ss-pick-inner">
              <text class="ss-pick-val">{{draft.shipmentDate || '请选择日期'}}</text>
              <text class="ss-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="ss-row is-last">
          <text class="ss-label">备注</text>
          <input class="ss-input" value="{{draft.note}}" placeholder="可留空" placeholder-class="ss-ph" bindinput="onDraftNote" />
        </view>
      </view>

      <!-- 选 SKU（仅超管） -->
      <block wx:if="{{createMode === 'sku'}}">
        <view class="ss-add-row">
          <view class="ss-add-btn is-primary {{pricingEnabled ? '' : 'is-disabled'}}" hover-class="ss-press" bindtap="openSkuPicker">
            <text class="ss-add-title">选已有 SKU</text>
            <text class="ss-add-sub">常用 · 直接开单</text>
          </view>
          <view class="ss-add-btn is-secondary {{pricingEnabled ? '' : 'is-disabled'}}" hover-class="ss-press" bindtap="openSkuForm">
            <text class="ss-add-title">新建 SKU</text>
            <text class="ss-add-sub">原材料 × 包装方式</text>
          </view>
        </view>

        <view class="ss-lines">
          <view class="ss-line {{item.pricingStatus !== 'priced' ? 'is-pending' : ''}}" wx:for="{{lines}}" wx:key="skuId">
            <view class="ss-line-head">
              <view class="ss-line-title">
                <text class="ss-line-name">{{item.skuName}}</text>
                <text class="ss-line-tag" wx:if="{{item.hasScene}}">造景</text>
              </view>
              <view class="ss-del" data-index="{{index}}" catchtap="onRemoveLine"><text>删除</text></view>
            </view>
            <view class="ss-line-calc">
              <text class="ss-unit">{{item.unitPriceText}}/件</text>
              <view class="ss-qty">
                <view class="ss-qty-btn" data-index="{{index}}" data-delta="-1" bindtap="onQtyStep"><text>−</text></view>
                <input class="ss-qty-input" type="number" value="{{item.qty}}" data-index="{{index}}" bindinput="onQtyInput" />
                <view class="ss-qty-btn" data-index="{{index}}" data-delta="1" bindtap="onQtyStep"><text>＋</text></view>
              </view>
              <text class="ss-line-total {{item.pricingStatus !== 'priced' ? 'is-pending' : ''}}">{{item.lineTotalText || '—'}}</text>
            </view>
            <view class="ss-rate-row">
              <switch class="ss-switch" checked="{{item.useLineRate}}" color="#C4A76C" data-index="{{index}}" bindchange="onToggleLineRate" />
              <text class="ss-rate-hint" wx:if="{{!item.useLineRate}}">手工费{{item.rateSource === 'sku' ? '（SKU 默认 ' + item.effectiveRatePct + '%）' : '（全局 ' + globalRatePct + '%）'}}</text>
              <block wx:else>
                <input class="ss-rate-input" type="digit" value="{{item.laborRatePct}}" data-index="{{index}}" bindinput="onLineRateInput" />
                <text class="ss-rate-hint">%（本行单独设）</text>
              </block>
            </view>
            <view class="ss-rate-row" wx:if="{{item.hasScene}}">
              <text class="ss-rate-hint">造景成本</text>
              <input class="ss-rate-input" type="digit" value="{{item.sceneCost}}" data-index="{{index}}" bindinput="onLineSceneCost" />
              <text class="ss-rate-hint">元 / 件</text>
            </view>
            <view class="ss-note" wx:if="{{item.pricingStatus !== 'priced'}}">
              <text>{{item.pricingNote || '这一行取不到价，未计入合计'}}</text>
            </view>
          </view>
        </view>

        <view class="ss-empty-box {{pricingEnabled ? '' : 'is-disabled'}}" wx:if="{{!lines.length && !createBusy}}" hover-class="ss-press" bindtap="openSkuPicker">
          <view class="ss-empty-mark"><text>+</text></view>
          <text class="ss-empty-title">还没有明细</text>
          <text class="ss-empty-hint">点此选已有 SKU，或上方「新建 SKU」</text>
        </view>
      </block>

      <!-- 粘贴识别：页内展开，不再套弹层 -->
      <block wx:if="{{createMode === 'paste'}}">
        <view class="ops-paste-card">
          <text class="ops-paste-hint">首行日期+出货（如 2026.9.22出货 / 2026年9月22日出货）；门店名单独成行；明细「品名-20个」或「品名20个」；空行分隔门店。</text>
          <textarea
            class="ops-paste-area"
            value="{{pasteText}}"
            bindinput="onPasteInput"
            placeholder="粘贴微信/飞书出货文本…"
            placeholder-class="ops-ph"
            maxlength="-1"
            auto-height
          />
          <view class="sc-paste-tools" wx:if="{{pasteText}}">
            <text class="sc-link" bindtap="clearPaste">清空重贴</text>
          </view>
        </view>

        <block wx:if="{{failedLines.length}}">
          <text class="ops-section-label">识别问题行 · 改后点「应用并重识别」</text>
          <view class="ops-issue-block {{item.severity === 'warn' ? 'warn' : ''}}" wx:for="{{failedLines}}" wx:key="line" wx:for-index="issueIdx">
            <view class="ops-issue-head">
              <text class="ops-issue-label">L{{item.line}} · {{item.severity === 'warn' ? '警告' : '失败'}}</text>
              <text class="ops-issue-apply" data-idx="{{issueIdx}}" bindtap="applyIssueLine">应用并重识别</text>
            </view>
            <input class="ops-issue-input" value="{{item.text}}" data-idx="{{issueIdx}}" bindinput="onIssueLineInput" />
            <text class="ops-issue-msg">{{item.msg}}</text>
          </view>
        </block>

        <view wx:if="{{parsePreview && parsePreview.canWrite}}" id="entryPreview">
          <view class="ops-preview-bar">
            <text class="ops-preview-label">出货日</text>
            <picker mode="date" value="{{parsePreview.shipmentDate}}" bindchange="onPreviewDate">
              <view class="ops-filter-chip brass">{{parsePreview.shipmentDate || '选日期'}}</view>
            </picker>
            <text class="ops-meta-inline" wx:if="{{parsePreview.summary}}">{{parsePreview.summary.storeCount}}店 · {{parsePreview.summary.totalQty}}件</text>
          </view>
          <block wx:for="{{parsePreview.shipments}}" wx:key="storeId" wx:for-item="block" wx:for-index="storeIdx">
            <view class="ops-group">
              <view class="ops-group-head" data-idx="{{storeIdx}}" bindtap="toggleStoreCollapse">
                <text class="ops-group-title">{{block.storeName}} · {{block.totalQty}}件</text>
                <view class="ops-group-side">
                  <text class="ops-qty-badge">{{block.itemCount}}</text>
                  <text class="ops-group-chevron">{{block.collapsed ? '▸' : '▾'}}</text>
                </view>
              </view>
              <view class="ops-group-body" wx:if="{{!block.collapsed}}">
                <view class="ops-line-row" wx:for="{{block.items}}" wx:key="itemName" wx:for-item="it" wx:for-index="itemIdx">
                  <input class="ops-preview-input" value="{{it.itemName}}" data-store-idx="{{storeIdx}}" data-item-idx="{{itemIdx}}" bindinput="onPreviewItemName" />
                  <input class="ops-preview-qty-input" type="number" value="{{it.qty}}" data-store-idx="{{storeIdx}}" data-item-idx="{{itemIdx}}" bindinput="onPreviewItemQty" />
                </view>
              </view>
            </view>
          </block>
          <view class="sc-edit-link" bindtap="openEditPage">
            <text class="sc-edit-link-main">逐行核对并算价 ›</text>
            <text class="sc-edit-link-sub">要逐行选原材料 / 包装方式、按价目表核价时用</text>
          </view>
        </view>
      </block>

      <!-- 单条补录 -->
      <block wx:if="{{createMode === 'single'}}">
        <view class="ss-card">
          <text class="ss-card-en">ITEM</text>
          <view class="ops-field-block">
            <text class="ops-field-k">从成品库存 / 藏品带入（可选）</text>
            <view class="ops-sku-search">
              <input class="ops-field-box sku-kw" value="{{itemKeyword}}" bindinput="onItemKeyword" bindconfirm="searchItem" placeholder="搜成品库存或藏品名…" placeholder-class="ops-ph" confirm-type="search" />
              <view class="ops-sku-btn {{itemSearching ? 'disabled' : ''}}" bindtap="searchItem">{{itemSearching ? '…' : '搜'}}</view>
            </view>
            <view class="ops-sku-hits" wx:if="{{itemHits.length}}">
              <view class="ops-sku-hit" wx:for="{{itemHits}}" wx:key="key" data-idx="{{index}}" bindtap="selectItemHit">
                <view class="ops-sku-hit-main">
                  <text class="ops-sku-hit-name">{{item.itemName}}</text>
                  <text class="ops-sku-hit-meta" wx:if="{{item.spec}}">{{item.spec}}</text>
                </view>
                <view class="ops-sku-hit-side">
                  <text class="ops-sku-hit-src">{{item.sourceLabel}}</text>
                  <text class="ops-sku-hit-price" wx:if="{{item.unitPrice}}">¥{{item.unitPrice}}</text>
                </view>
              </view>
            </view>
            <text class="ops-field-hint" wx:if="{{single.linkedLabel}}">已关联 · {{single.linkedLabel}}</text>
          </view>

          <view class="ops-field-line">
            <text class="ops-field-k">品名</text>
            <input class="ops-field-box ops-field-v" value="{{single.itemName}}" data-field="itemName" bindinput="onSingleInput" placeholder="必填" placeholder-class="ops-ph" />
          </view>
          <view class="ops-field-line twin">
            <view class="ops-field-half">
              <text class="ops-field-k">数量</text>
              <input class="ops-field-box" type="digit" value="{{single.qty}}" data-field="qty" bindinput="onSingleInput" placeholder="1" placeholder-class="ops-ph" />
            </view>
            <view class="ops-field-half">
              <text class="ops-field-k">出货单价（元）</text>
              <input class="ops-field-box" type="digit" value="{{single.unitPrice}}" data-field="unitPrice" bindinput="onSingleInput" placeholder="可留空" placeholder-class="ops-ph" />
            </view>
          </view>
          <text class="ops-field-hint" wx:if="{{formAmountPreview}}">合计约 ¥{{formAmountPreview}}</text>

          <view class="ops-field-line">
            <text class="ops-field-k">原材料</text>
            <view class="ss-pick-inner ss-pick-click" data-kind="material" data-target="single" bindtap="openPicker">
              <text class="{{single.materialName ? 'sc-pick-on' : 'sc-pick-off'}}">{{single.materialName ? single.materialName + (single.materialGrade ? '（' + single.materialGrade + '）' : '') : '可选 · 从资料选择'}}</text>
              <text class="ss-arrow">▾</text>
            </view>
            <text class="sc-clear" wx:if="{{single.materialName}}" bindtap="clearSingleMaterial">清除</text>
          </view>
          <view class="ops-field-line">
            <text class="ops-field-k">包装方式</text>
            <view class="ss-pick-inner ss-pick-click" data-kind="packaging" data-target="single" bindtap="openPicker">
              <text class="{{single.packagingName ? 'sc-pick-on' : 'sc-pick-off'}}">{{single.packagingName ? single.packagingName + (single.packagingSize ? ' ' + single.packagingSize : '') : '可选 · 从资料选择'}}</text>
              <text class="ss-arrow">▾</text>
            </view>
            <text class="sc-clear" wx:if="{{single.packagingName}}" bindtap="clearSinglePackaging">清除</text>
          </view>
          <text class="ops-field-hint" wx:if="{{single.materialName || single.packagingName}}">已选原材料 / 包装：算价开启时服务端按价目表核价；未命中则保留手填单价。</text>

          <view class="sc-more-toggle" bindtap="toggleSingleMore">
            <text>{{singleMoreOpen ? '收起更多字段' : '更多字段（规格 / 分类 / 购买人 / 状态 / 物流）'}}</text>
            <text class="ss-arrow">{{singleMoreOpen ? '▴' : '▾'}}</text>
          </view>
          <block wx:if="{{singleMoreOpen}}">
            <view class="ops-field-line">
              <text class="ops-field-k">规格型号</text>
              <input class="ops-field-box ops-field-v" value="{{single.spec}}" data-field="spec" bindinput="onSingleInput" placeholder="可选" placeholder-class="ops-ph" />
            </view>
            <view class="ops-field-line">
              <text class="ops-field-k">分类</text>
              <picker class="ops-field-v" mode="selector" range="{{formCategoryNames}}" value="{{formCategoryIndex}}" bindchange="onSingleCategory">
                <view class="ops-field-box">{{formCategoryNames[formCategoryIndex] || '可选'}}</view>
              </picker>
            </view>
            <view class="ops-field-line">
              <text class="ops-field-k">购买人</text>
              <input class="ops-field-box ops-field-v" value="{{single.buyerName}}" data-field="buyerName" bindinput="onSingleInput" placeholder="实际购买人" placeholder-class="ops-ph" />
            </view>
            <view class="ops-field-line">
              <text class="ops-field-k">客户名称</text>
              <input class="ops-field-box ops-field-v" value="{{single.customerName}}" data-field="customerName" bindinput="onSingleInput" placeholder="默认门店名" placeholder-class="ops-ph" />
            </view>
            <view class="ops-field-line">
              <text class="ops-field-k">状态</text>
              <picker class="ops-field-v" mode="selector" range="{{formStatusNames}}" value="{{formStatusIndex}}" bindchange="onSingleStatus">
                <view class="ops-field-box">{{formStatusNames[formStatusIndex] || '已确认'}}</view>
              </picker>
            </view>
            <view class="ops-field-line twin">
              <view class="ops-field-half">
                <text class="ops-field-k">快递公司</text>
                <input class="ops-field-box" value="{{single.expressCompany}}" data-field="expressCompany" bindinput="onSingleInput" placeholder="可选" placeholder-class="ops-ph" />
              </view>
              <view class="ops-field-half">
                <text class="ops-field-k">运单号</text>
                <input class="ops-field-box" value="{{single.trackingNo}}" data-field="trackingNo" bindinput="onSingleInput" placeholder="可选" placeholder-class="ops-ph" />
              </view>
            </view>
          </block>
        </view>
      </block>
    </block>

    <!-- 单据 -->
    <block wx:if="{{activeTab === 'list'}}">
      <view class="ops-list-tip is-{{listTipTone}} sc-list-tip" wx:if="{{listTip}}">
        <text class="sc-list-tip-text">{{listTip}}</text>
        <text class="sc-again" wx:if="{{showAgain && listTipTone !== 'warn'}}" bindtap="onCreateAgain">再开一单 ›</text>
      </view>

      <view class="mm-entry-row" wx:if="{{isSuper}}">
        <view class="mm-entry" data-kind="draft" bindtap="openMemoBox"><text>草稿箱</text><text class="mm-entry-n">{{memoCounts.draft}}</text></view>
        <view class="mm-entry" data-kind="history" bindtap="openMemoBox"><text>历史 · 已结清</text><text class="mm-entry-n">{{memoCounts.history}}</text></view>
      </view>

      <view class="ops-summary" wx:if="{{!loading || list.length}}">
        <view class="ops-summary-top">
          <text class="ops-summary-label">本筛选件数</text>
          <text class="ops-summary-value">{{summary.totalQty}}</text>
        </view>
        <text class="ops-summary-meta">{{summary.count}} 单 · {{summary.itemCount}} 行明细</text>
        <view class="ops-chips" wx:if="{{summary.byStore.length}}">
          <text class="ops-chip" wx:for="{{summary.byStore}}" wx:key="storeId">{{item.storeName}} {{item.totalQty}}件</text>
        </view>
      </view>

      <view class="ops-search-row">
        <input class="ops-search-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜单号 / 品名 / 门店 / 客户" placeholder-class="ops-ph" confirm-type="search" />
        <view class="ops-search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">清除</view>
      </view>

      <view class="ops-quick-row">
        <view class="ops-quick {{statusQuick === '' ? 'on' : ''}}" data-status="all" bindtap="onStatusQuick">全部</view>
        <view class="ops-quick {{statusQuick === 'pending' ? 'on' : ''}}" data-status="pending" bindtap="onStatusQuick">待发货</view>
        <view class="ops-quick {{statusQuick === 'shipped' ? 'on' : ''}}" data-status="shipped" bindtap="onStatusQuick">已发货</view>
        <view class="ops-quick {{statusQuick === 'completed' ? 'on' : ''}}" data-status="completed" bindtap="onStatusQuick">已完成</view>
        <view class="ops-quick sc-filter-toggle {{filterOpen || storeFilterIndex || sourceFilterIndex || dateFrom || dateTo ? 'is-active' : ''}}" bindtap="toggleFilter">筛选{{filterOpen ? ' ▴' : ' ▾'}}</view>
      </view>

      <view class="sc-filter-panel" wx:if="{{filterOpen}}">
        <view class="ops-filter-row">
          <picker mode="selector" range="{{storeFilterNames}}" value="{{storeFilterIndex}}" bindchange="onStoreFilter" wx:if="{{isSuper}}">
            <view class="ops-filter-chip">{{storeFilterNames[storeFilterIndex]}}</view>
          </picker>
          <picker mode="selector" range="{{statusFilterNames}}" value="{{statusFilterIndex}}" bindchange="onStatusFilter">
            <view class="ops-filter-chip">{{statusFilterNames[statusFilterIndex]}}</view>
          </picker>
          <picker mode="selector" range="{{sourceFilterNames}}" value="{{sourceFilterIndex}}" bindchange="onSourceFilter">
            <view class="ops-filter-chip">{{sourceFilterNames[sourceFilterIndex]}}</view>
          </picker>
        </view>
        <view class="ops-filter-row">
          <picker mode="date" value="{{dateFrom}}" bindchange="onDateFrom">
            <view class="ops-filter-chip">{{dateFrom || '起始日'}}</view>
          </picker>
          <picker mode="date" value="{{dateTo}}" bindchange="onDateTo">
            <view class="ops-filter-chip">{{dateTo || '截止日'}}</view>
          </picker>
          <view class="ops-filter-chip clear" wx:if="{{dateFrom || dateTo}}" bindtap="clearDates">清日期</view>
        </view>
      </view>
      <view class="sc-date-chip-row" wx:elif="{{dateFrom || dateTo}}">
        <text class="sc-date-chip">{{dateFrom || '…'}} ~ {{dateTo || '…'}}</text>
        <text class="sc-link" bindtap="clearDates">清日期</text>
      </view>

      <view class="ops-skeleton" wx:if="{{loading && !list.length && !listError}}">
        <view class="ui-sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="ui-sk-line wide"></view>
          <view class="ui-sk-line"></view>
          <view class="ui-sk-line mid"></view>
        </view>
      </view>

      <view class="ops-empty is-error" wx:elif="{{listError && !list.length}}">
        <text class="ops-empty-title">出货单未能展开</text>
        <text class="ops-empty-sub">{{listTip || '下拉或切筛选重试'}}</text>
        <view class="ops-chip-btn" bindtap="onRetryList">重试</view>
      </view>

      <view class="ops-empty" wx:elif="{{!loading && !listError && !list.length}}">
        <block wx:if="{{listTipTone === 'ok'}}">
          <text class="ops-empty-title">写入成功，本筛选暂无单据</text>
          <text class="ops-empty-sub">可点「清日期」或切「全部」再看；刚录的单可能不在当前日期范围内</text>
        </block>
        <block wx:else>
          <text class="ops-empty-title">柜中暂无出货单</text>
          <text class="ops-empty-sub">{{canWrite ? '到「开单」页签开第一张单' : '暂无可查看的单据'}}</text>
        </block>
      </view>

      <block wx:for="{{list}}" wx:key="_id">
        <view class="ops-card {{highlightIds[item._id] ? 'sc-card-new' : ''}}" data-id="{{item._id}}" bindtap="openDetail">
          <view class="ops-card-top">
            <text class="ops-card-title">{{item.customerLine || item.storeName}}</text>
            <text class="sc-new-badge" wx:if="{{highlightIds[item._id]}}">新</text>
            <text class="ops-status {{item.statusTone}}">{{item.statusLabel}}</text>
          </view>
          <view class="ops-card-tags">
            <text class="ops-source {{item.sourceTone}}">{{item.sourceLabel || '手工录入'}}</text>
            <text class="ops-settle {{item.settleTone}}" wx:if="{{item.settleLabel}}">{{item.settleLabel}}</text>
            <text class="ops-meta-inline warn" wx:if="{{item.pricingIncomplete}}">待核价</text>
            <text class="ops-meta-inline" wx:if="{{item.entryPathLabel}}">{{item.entryPathLabel}}</text>
            <text class="ops-meta-inline">{{item.shipmentNo}}</text>
            <text class="ops-meta-inline">{{item.shipmentDate}}</text>
          </view>
          <text class="ops-amount">{{item.totalQty}} 件 · {{item.itemCount}} 行{{item.amountText ? ' · ¥' + item.amountText : ''}}</text>
          <text class="ops-meta" wx:if="{{item.buyerName}}">购买人 {{item.buyerName}}</text>
          <text class="ops-meta" wx:if="{{item.itemsPreview}}">{{item.itemsPreview}}{{item.moreItems ? ' 等' : ''}}</text>
          <text class="ops-meta" wx:if="{{item.logisticsText}}">物流 {{item.logisticsText}}</text>
          <text class="ops-meta">更新 {{item.updatedAtText}}</text>
          <view class="ops-card-actions" catchtap="noop">
            <view class="ops-chip-btn brass" wx:if="{{item.canTransit && canWrite}}" data-id="{{item._id}}" catchtap="openDetail">详情 / 流转</view>
            <view class="ops-chip-btn danger" wx:if="{{canWrite}}" data-id="{{item._id}}" catchtap="onRemove">{{removePendingId === item._id ? '确认删除' : '删除'}}</view>
          </view>
        </view>
      </block>
    </block>

    <!-- 总览（观测台） -->
    <block wx:if="{{activeTab === 'overview'}}">
      <view class="ops-source-toggle" bindtap="toggleSource">
        <text class="ops-source-label">{{sourceOpen ? '收起数据说明' : '数据说明'}}</text>
        <text class="ops-source-chevron">{{sourceOpen ? '▴' : '▾'}}</text>
      </view>
      <view class="ops-source-panel" wx:if="{{sourceOpen}}">
        <text class="ops-note">{{sourceNote}}</text>
      </view>

      <picker mode="selector" range="{{storeFilterNames}}" value="{{storeFilterIndex}}" bindchange="onStoreFilter" wx:if="{{isSuper}}">
        <view class="ops-filter-chip dash-store">{{storeFilterNames[storeFilterIndex]}}</view>
      </picker>

      <view class="ops-skeleton" wx:if="{{dashLoading && !kpis && !dashError}}">
        <view class="ui-sk-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="ui-sk-line wide"></view>
          <view class="ui-sk-line"></view>
        </view>
      </view>

      <view class="ops-empty is-error" wx:elif="{{dashError && !kpis}}">
        <text class="ops-empty-title">观测台未能展开</text>
        <text class="ops-empty-sub">{{tipText || '请下拉刷新重试'}}</text>
        <view class="ops-chip-btn" bindtap="onRetryDash">重试</view>
      </view>

      <block wx:if="{{kpis}}">
        <view class="verdict-card" wx:if="{{verdict}}">
          <view class="verdict-top">
            <view class="verdict-left">
              <view class="signal-light lg {{verdict.className}}"></view>
              <view class="verdict-copy">
                <text class="verdict-en">SHIPMENT · HEALTH</text>
                <text class="verdict-title {{verdict.tone}}">{{verdict.title}}</text>
              </view>
            </view>
            <view class="verdict-badge {{verdict.tone}}">{{verdict.label}}</view>
          </view>
          <text class="verdict-insight">{{verdict.insight}}</text>
          <view class="summary-chips" wx:if="{{signalBoard.summary.ok || signalBoard.summary.warn || signalBoard.summary.danger}}">
            <text class="sum-chip ok" wx:if="{{signalBoard.summary.ok}}">正常 {{signalBoard.summary.ok}}</text>
            <text class="sum-chip warn" wx:if="{{signalBoard.summary.warn}}">关注 {{signalBoard.summary.warn}}</text>
            <text class="sum-chip danger" wx:if="{{signalBoard.summary.danger}}">告警 {{signalBoard.summary.danger}}</text>
          </view>
          <view class="verdict-foot">
            <text class="verdict-meta">{{verdict.updatedAt ? '更新 ' + verdict.updatedAt : '下拉可刷新'}}</text>
            <text class="legend-toggle" bindtap="toggleLegend">{{legendOpen ? '收起图例' : '信号图例'}}</text>
          </view>
          <view class="legend-box" wx:if="{{legendOpen}}">
            <view class="legend-row"><view class="signal-light blink"></view><text class="legend-text">绿 · 正常</text></view>
            <view class="legend-row"><view class="signal-light warn"></view><text class="legend-text">黄 · 需关注</text></view>
            <view class="legend-row"><view class="signal-light danger"></view><text class="legend-text">红 · 告警</text></view>
            <view class="legend-row"><view class="signal-light lamp-muted"></view><text class="legend-text">灰 · 样本不足</text></view>
            <text class="legend-hint">{{signalBoard.rulesNote}}</text>
          </view>
        </view>

        <view class="card signal-board" wx:if="{{signalBoard.items.length}}">
          <view class="card-top">
            <text class="card-title">出货信号灯</text>
            <text class="card-meta">六盏</text>
          </view>
          <view class="signal-grid">
            <view class="signal-item" wx:for="{{signalBoard.items}}" wx:key="id">
              <view class="signal-rail signal-rail--{{item.status}}"></view>
              <view class="signal-light {{item.lampClass}}"></view>
              <view class="signal-copy">
                <text class="signal-name">{{item.name}}</text>
                <text class="signal-val {{item.tone}}">{{item.value}}</text>
                <text class="signal-status">{{item.statusLabel}}</text>
                <text class="signal-reason" wx:if="{{item.reason}}">{{item.reason}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="kpi-section">
          <text class="ops-section-label">核心指标</text>
          <view class="kpi-grid">
            <view class="dash-card accent-brass">
              <view class="dash-accent"></view>
              <text class="dash-label">出货笔数</text>
              <text class="dash-value brass">{{kpis.shipmentCount}}</text>
            </view>
            <view class="dash-card">
              <text class="dash-label">出货营收</text>
              <text class="dash-value brass">¥{{kpis.revenueText}}</text>
            </view>
            <view class="dash-card">
              <text class="dash-label">客户数</text>
              <text class="dash-value">{{kpis.customerCount}}</text>
            </view>
            <view class="dash-card">
              <text class="dash-label">本月笔数{{kpis.monthDeltaText ? ' · ' + kpis.monthDeltaText : ''}}</text>
              <text class="dash-value {{kpis.monthDeltaTone}}">{{kpis.monthCount}}</text>
            </view>
          </view>
          <view class="hero-split" wx:if="{{kpis.hasPurchaseSample}}">
            <view class="hero-split-cell">
              <text class="hero-split-l">采购总额</text>
              <text class="hero-split-v flat">¥{{kpis.purchaseTotalText}}</text>
            </view>
            <view class="hero-split-cell">
              <text class="hero-split-l">净差额</text>
              <text class="hero-split-v {{kpis.netProfitTone}}">¥{{kpis.netProfitText}}</text>
            </view>
            <view class="hero-split-cell">
              <text class="hero-split-l">本月营收</text>
              <text class="hero-split-v brass">¥{{kpis.monthAmountText}}</text>
            </view>
          </view>
        </view>

        <view class="card" wx:if="{{completeness}}">
          <view class="card-top">
            <text class="card-title">字段完整度</text>
            <text class="card-meta {{completeness.tone}}">完整 {{completeness.okPctText}}</text>
          </view>
          <view class="progress-track">
            <view class="progress-fill tone-{{completeness.tone}}" style="width: {{completeness.okBar}}%;"></view>
          </view>
          <view class="progress-head" style="margin-top: 12rpx; margin-bottom: 0;">
            <text class="progress-label">待补全 {{completeness.incompleteText}}</text>
            <text class="progress-nums">无金额 {{completeness.zeroAmountPctText}}</text>
          </view>
        </view>

        <view class="card structure-card" wx:if="{{structure.length}}">
          <view class="card-top">
            <text class="card-title">品类结构</text>
            <text class="card-meta">金额占比</text>
          </view>
          <view class="structure-track">
            <view class="structure-seg tone-{{item.tone}}" wx:for="{{structure}}" wx:key="key" style="width: {{item.widthPct}}%;"></view>
          </view>
          <view class="structure-legend">
            <view class="structure-row" wx:for="{{structure}}" wx:key="key">
              <view class="structure-dot tone-{{item.tone}}"></view>
              <text class="structure-label">{{item.label}}</text>
              <text class="structure-pct">{{item.pct}}%</text>
              <text class="structure-amt">¥{{item.amountText}}</text>
            </view>
          </view>
        </view>

        <view class="card trend-card">
          <view class="card-top">
            <text class="card-title">月度出货趋势</text>
            <text class="card-meta">{{trendMode === 'single' ? '单月样本' : '金额'}}</text>
          </view>
          <block wx:if="{{trendMode === 'single' && trendSingle}}">
            <view class="trend-single">
              <view class="trend-single-head">
                <text class="trend-single-month">{{trendSingle.label}}</text>
                <text class="trend-single-hint">近 12 月仅此一月有记录</text>
              </view>
              <text class="trend-single-value">¥{{trendSingle.amountText}}</text>
              <text class="trend-single-count" wx:if="{{trendSingle.count}}">{{trendSingle.count}} 笔</text>
              <view class="trend-single-track"><view class="trend-single-fill"></view></view>
            </view>
          </block>
          <block wx:elif="{{trendMode === 'multi'}}">
            <view class="trend-multi">
              <view class="dash-bar-row trend-row" wx:for="{{trend}}" wx:key="key">
                <text class="dash-bar-label">{{item.label}}</text>
                <view class="dash-bar-track tall">
                  <view class="dash-bar-fill" style="width: {{item.pct}}%;"></view>
                </view>
                <text class="dash-bar-val">{{item.amountText}}</text>
              </view>
            </view>
            <text class="ops-section-label" style="margin-top: 20rpx;">月度笔数</text>
            <view class="trend-multi">
              <view class="dash-bar-row trend-row" wx:for="{{trendCount}}" wx:key="key">
                <text class="dash-bar-label">{{item.label}}</text>
                <view class="dash-bar-track tall">
                  <view class="dash-bar-fill alt" style="width: {{item.pct}}%;"></view>
                </view>
                <text class="dash-bar-val">{{item.count}}</text>
              </view>
            </view>
          </block>
          <text class="empty-hint" wx:else>{{trendNote || '暂无按月出货序列。'}}</text>
          <text class="trend-note" wx:if="{{trendMode !== 'empty' && trendNote}}">{{trendNote}}</text>
        </view>

        <view class="card" wx:if="{{charts.byCustomer.length}}">
          <view class="card-top">
            <text class="card-title">客户排行</text>
            <text class="card-meta" wx:if="{{kpis.topShareText}}">首位 {{kpis.topShareText}}</text>
          </view>
          <view class="bar-stack">
            <view class="bar-item" wx:for="{{charts.byCustomerView}}" wx:key="key">
              <view class="bar-meta">
                <text class="bar-label">{{item.label}}</text>
                <text class="bar-val">¥{{item.amountText}}</text>
              </view>
              <view class="bar-track">
                <view class="bar-fill" style="width: {{item.pct}}%;"></view>
              </view>
            </view>
          </view>
          <view class="list-more" wx:if="{{charts.byCustomerMore > 0 || listMore.customers}}" data-key="customers" bindtap="toggleListMore">
            <text>{{listMore.customers ? '收起客户列表' : '查看更多客户 · ' + charts.byCustomerMore}}</text>
          </view>
        </view>

        <view class="detail-toggle" bindtap="toggleDetail">
          <text class="detail-toggle-main">{{detailOpen ? '收起门店 · 状态明细' : '展开门店 · 状态明细'}}</text>
          <text class="detail-toggle-sub">不影响上方核心指标</text>
        </view>

        <view class="detail-panel" wx:if="{{detailOpen}}">
          <view class="detail-block">
            <view class="detail-block-head" data-key="stores" bindtap="toggleSection">
              <view class="detail-block-titles">
                <text class="detail-block-en">STORES</text>
                <text class="detail-block-cn">各门店出货金额</text>
              </view>
              <text class="detail-block-chevron">{{sectionOpen.stores ? '收起' : '展开'}}</text>
            </view>
            <view class="bar-stack" wx:if="{{sectionOpen.stores}}">
              <view class="bar-item" wx:for="{{charts.byStore}}" wx:key="key">
                <view class="bar-meta">
                  <text class="bar-label">{{item.label}}</text>
                  <text class="bar-val alt">¥{{item.amountText}}</text>
                </view>
                <view class="bar-track">
                  <view class="bar-fill alt" style="width: {{item.pct}}%;"></view>
                </view>
              </view>
              <text class="empty-hint" wx:if="{{!charts.byStore.length}}">暂无门店分布。</text>
            </view>
          </view>
          <view class="detail-block">
            <view class="detail-block-head" data-key="status" bindtap="toggleSection">
              <view class="detail-block-titles">
                <text class="detail-block-en">STATUS</text>
                <text class="detail-block-cn">状态笔数</text>
              </view>
              <text class="detail-block-chevron">{{sectionOpen.status ? '收起' : '展开'}}</text>
            </view>
            <view class="bar-stack" wx:if="{{sectionOpen.status}}">
              <view class="bar-item" wx:for="{{charts.byStatus}}" wx:key="key">
                <view class="bar-meta">
                  <text class="bar-label">{{item.label}}</text>
                  <text class="bar-val">{{item.count}} 笔</text>
                </view>
                <view class="bar-track">
                  <view class="bar-fill" style="width: {{item.pct}}%;"></view>
                </view>
              </view>
            </view>
          </view>
          <view class="detail-toggle secondary" bindtap="toggleDetail">
            <text class="detail-toggle-main">收起全部明细</text>
          </view>
        </view>

        <view class="ops-goto-list" data-tab="list" bindtap="switchTab">
          <text>前往单据 · 流转 / 物流</text>
        </view>
      </block>
    </block>

    <!-- SKU 页签（店长看到「资料」）：SKU 目录（仅超管）/ 原材料 / 包装方式（店长只读；写入口仅超管） -->
    <block wx:if="{{activeTab === 'library'}}">
      <view class="sc-modes">
        <view class="sc-mode {{libView === 'sku' ? 'on' : ''}}" wx:if="{{isSuper}}" hover-class="tap-press-soft" hover-stay-time="80" data-kind="sku" bindtap="switchLibKind">
          <text class="sc-mode-title">SKU 目录</text>
          <text class="sc-mode-sub">组合 · 现算单价</text>
        </view>
        <view class="sc-mode {{libView === 'material' ? 'on' : ''}}" hover-class="tap-press-soft" hover-stay-time="80" data-kind="material" bindtap="switchLibKind">
          <text class="sc-mode-title">原材料</text>
          <text class="sc-mode-sub">名称 × 等级 · 单价</text>
        </view>
        <view class="sc-mode {{libView === 'packaging' ? 'on' : ''}}" hover-class="tap-press-soft" hover-stay-time="80" data-kind="packaging" bindtap="switchLibKind">
          <text class="sc-mode-title">包装方式</text>
          <text class="sc-mode-sub">名称 × 尺寸 · 单价</text>
        </view>
      </view>

      <!-- SKU 目录（仅超管）：全量取回后本地筛选；点行打开详情 / 编辑弹层 -->
      <block wx:if="{{isSuper && libView === 'sku'}}">
      <view class="ops-list-tip is-{{skuCat.tipTone}}" wx:if="{{skuCat.tip}}"><text>{{skuCat.tip}}</text></view>
      <view class="sc-lib-bar">
        <input class="ops-search-input sc-lib-search" value="{{skuCat.keyword}}" bindinput="onSkuCatKeyword" placeholder="搜 SKU 名 / 原材料 / 包装 / 备注" placeholder-class="ops-ph" />
        <view class="sc-lib-add" hover-class="tap-press" hover-stay-time="80" bindtap="openSkuCreate">＋ 新建</view>
      </view>
      <view class="sk-filters">
        <view class="sk-chip {{skuCat.filter === 'all' ? 'on' : ''}}" hover-class="tap-press" hover-stay-time="80" data-filter="all" bindtap="setSkuCatFilter"><text>全部 {{skuCat.counts.all}}</text></view>
        <view class="sk-chip {{skuCat.filter === 'active' ? 'on' : ''}}" hover-class="tap-press" hover-stay-time="80" data-filter="active" bindtap="setSkuCatFilter"><text>启用 {{skuCat.counts.active}}</text></view>
        <view class="sk-chip {{skuCat.filter === 'inactive' ? 'on' : ''}}" hover-class="tap-press" hover-stay-time="80" data-filter="inactive" bindtap="setSkuCatFilter"><text>已停用 {{skuCat.counts.inactive}}</text></view>
        <view class="sk-chip {{skuCat.filter === 'review' ? 'on' : ''}} {{skuCat.counts.review ? 'is-warn' : ''}}" hover-class="tap-press" hover-stay-time="80" data-filter="review" bindtap="setSkuCatFilter"><text>待复核 {{skuCat.counts.review}}</text></view>
        <picker class="sk-cat" mode="selector" range="{{skuCat.categoryNames}}" value="{{skuCat.categoryIndex}}" bindchange="onSkuCatCategory">
          <view class="sk-chip {{skuCat.categoryIndex ? 'on' : ''}}"><text>{{skuCat.categoryNames[skuCat.categoryIndex]}} ▾</text></view>
        </picker>
      </view>
      <text class="sk-note">点一行看详情、改组成或停用。停用的 SKU 开单时选不到，已开的单据不受影响；单价按当前原材料 / 包装价现算。</text>
      <text class="sc-lib-note warn" wx:if="{{skuCat.truncated}}">共 {{skuCat.total}} 个，仅取前 200 个：请用搜索定位。</text>

      <view class="ops-skeleton" wx:if="{{skuCat.loading && !skuCat.list.length}}">
        <view class="ui-sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="ui-sk-line wide"></view>
          <view class="ui-sk-line"></view>
        </view>
      </view>
      <view class="ops-empty is-error" wx:elif="{{skuCat.error}}">
        <text class="ops-empty-title">SKU 目录未能展开</text>
        <text class="ops-empty-sub">{{skuCat.error}}</text>
        <view class="ops-chip-btn" hover-class="tap-press" hover-stay-time="80" bindtap="loadSkuCatalog">重试</view>
      </view>
      <view class="ops-empty" wx:elif="{{!skuCat.list.length}}">
        <text class="ops-empty-title">{{skuCat.keyword || skuCat.filter !== 'all' || skuCat.categoryIndex ? '没有符合条件的 SKU' : '还没有 SKU'}}</text>
        <text class="ops-empty-sub">{{skuCat.keyword || skuCat.filter !== 'all' || skuCat.categoryIndex ? '换个关键词或筛选试试' : '点「＋ 新建」建第一个（同一组合只需建一次）'}}</text>
      </view>
      <view
        class="sk-row {{item.inactive ? 'is-off' : ''}}"
        wx:for="{{skuCat.list}}"
        wx:key="_id"
        hover-class="tap-press-soft"
        hover-stay-time="80"
        data-id="{{item._id}}"
        bindtap="openSkuDetail"
      >
        <view class="sc-lib-main">
          <view class="sc-lib-title">
            <text class="sc-lib-name">{{item.skuName}}</text>
            <text class="ss-review-tag" wx:if="{{item.needsReview}}">待复核</text>
            <text class="sc-lib-tag off" wx:if="{{item.inactive}}">已停用</text>
          </view>
          <text class="sc-lib-meta">{{item.matText}} × {{item.pkgText}}{{item.sceneText ? ' · ' + item.sceneText : ''}}</text>
          <text class="sc-lib-meta">{{item.rateText}}{{item.materialCategory ? ' · ' + item.materialCategory : ''}}{{!item.priced && item.pricingNote ? ' · ' + item.pricingNote : ''}}</text>
        </view>
        <text class="sk-price {{item.priced ? '' : 'is-pending'}}">{{item.priceText}}</text>
      </view>
      </block>

      <block wx:if="{{libView !== 'sku'}}">

      <view class="ops-list-tip is-{{libTipTone}}" wx:if="{{libTip}}"><text>{{libTip}}</text></view>

      <view class="sc-lib-bar">
        <input class="ops-search-input sc-lib-search" value="{{libKeyword}}" bindinput="onLibKeyword" placeholder="搜名称 / 别名" placeholder-class="ops-ph" />
        <view class="sc-lib-add" wx:if="{{isSuper}}" bindtap="openLibForm">＋ 新增</view>
      </view>
      <text class="sc-lib-note">{{isSuper ? '开单时按这个顺序列出；停用的不再出现，已开的单不受影响。' : '只读：开单时按这个顺序列出，需要调整请联系超管。'}}</text>
      <text class="sc-lib-note warn" wx:if="{{libTruncated}}">共 {{libTotal}} 条，仅显示前 200 条：请用搜索定位。</text>

      <view class="ops-skeleton" wx:if="{{libLoading && !libList.length}}">
        <view class="ui-sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="ui-sk-line wide"></view>
          <view class="ui-sk-line"></view>
        </view>
      </view>
      <view class="ops-empty is-error" wx:elif="{{libError}}">
        <text class="ops-empty-title">资料未能展开</text>
        <text class="ops-empty-sub">{{libError}}</text>
        <view class="ops-chip-btn" bindtap="loadLibrary">重试</view>
      </view>
      <view class="ops-empty" wx:elif="{{!libList.length}}">
        <text class="ops-empty-title">{{libKeyword ? '没有匹配项' : '还没有条目'}}</text>
        <text class="ops-empty-sub">{{isSuper ? '点「＋ 新增」补第一条' : '超管尚未维护'}}</text>
      </view>

      <block wx:for="{{libList}}" wx:key="_id">
      <view class="sc-lib-row {{item.inactive ? 'is-off' : ''}}">
        <image class="sc-lib-thumb" wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" lazy-load data-id="{{item._id}}" bindtap="previewLibImage" binderror="onLibThumbError" />
        <view class="sc-lib-thumb is-empty" wx:else><text>无图</text></view>
        <view class="sc-lib-main">
          <view class="sc-lib-title">
            <text class="sc-lib-name">{{item.name}}</text>
            <text class="sc-lib-opt" wx:if="{{item.option && item.option !== '默认'}}">{{item.option}}</text>
            <text class="sc-lib-tag" wx:if="{{item.isDefaultOption}}">默认</text>
            <text class="sc-lib-tag off" wx:if="{{item.inactive}}">已停用</text>
          </view>
          <text class="sc-lib-meta">{{item.unitPriceText}}{{item.unit ? ' / ' + item.unit : ''}}{{item.category ? ' · ' + item.category : ''}}{{item.refText ? ' · ' + item.refText : ''}}</text>
          <text class="sc-lib-meta" wx:if="{{item.aliasesText}}">别名 {{item.aliasesText}}</text>
        </view>
        <view class="sc-lib-actions" wx:if="{{isSuper}}">
          <view class="sc-lib-sort">
            <text class="sc-lib-arrow {{index === 0 || libKeyword ? 'is-dim' : ''}}" data-id="{{item._id}}" data-dir="-1" bindtap="moveLibRow">↑</text>
            <text class="sc-lib-arrow {{index === libList.length - 1 || libKeyword ? 'is-dim' : ''}}" data-id="{{item._id}}" data-dir="1" bindtap="moveLibRow">↓</text>
          </view>
          <view class="sc-lib-btns">
            <text class="sc-lib-btn" data-id="{{item._id}}" bindtap="openLibForm">编辑</text>
            <text class="sc-lib-btn {{item.inactive ? 'on' : 'warn'}}" data-id="{{item._id}}" bindtap="toggleLibStatus">{{item.inactive ? '启用' : '停用'}}</text>
            <text class="sc-lib-btn warn" data-id="{{item._id}}" bindtap="askRemoveLib">删除</text>
          </view>
        </view>
      </view>
      <view class="sc-lib-inline" wx:if="{{isSuper && libConfirmId === item._id}}">
        <text class="sc-lib-inline-text">删除「{{item.name}}{{item.option !== '默认' ? ' · ' + item.option : ''}}」？仅在没有任何出货单 / SKU 引用时才会成功。</text>
        <view class="sc-lib-inline-btns">
          <text class="sc-lib-btn" bindtap="cancelLibInline">取消</text>
          <text class="sc-lib-btn danger" data-id="{{item._id}}" bindtap="confirmRemoveLib">{{libBusy ? '检查中…' : '确认删除'}}</text>
        </view>
      </view>
      <view class="sc-lib-inline is-warn" wx:if="{{isSuper && libBlocked.id === item._id}}">
        <text class="sc-lib-inline-text">{{libBlocked.text}}</text>
        <view class="sc-lib-inline-btns">
          <text class="sc-lib-btn" bindtap="cancelLibInline">知道了</text>
          <text class="sc-lib-btn danger" wx:if="{{libBlocked.canDeactivate}}" data-id="{{item._id}}" bindtap="deactivateBlocked">改为停用</text>
        </view>
      </view>
      </block>
      </block>
    </block>
  </view>
</view>

<!-- 开单底栏：.ss-cta 满宽（WXSS !important + 内联 width） -->
<view class="ss-dock" wx:if="{{ready && activeTab === 'create'}}">
  <block wx:if="{{createMode === 'sku'}}">
    <view class="ss-summary">
      <view class="ss-sum-left">
        <text class="ss-sum-meta">{{lines.length}} 行 · {{totalQty}} 件</text>
        <text class="ss-sum-warn" wx:if="{{pendingCount}}">待核价 {{pendingCount}}</text>
      </view>
      <view class="ss-sum-right">
        <text class="ss-sum-k">合计</text>
        <text class="ss-sum-value">{{totalText}}</text>
      </view>
    </view>
    <text class="ss-save-hint" wx:if="{{saveHint && !canSave}}">{{saveHint}}</text>
    <view
      class="ss-cta {{canSave && !createBusy ? '' : 'is-disabled'}}"
      style="width:100%;min-width:100%;max-width:100%;display:flex;box-sizing:border-box;"
      hover-class="{{canSave && !createBusy ? 'ss-cta-press' : ''}}"
      bindtap="onSaveSku"
    >
      <text>{{createBusy ? '处理中…' : '保存出货单'}}</text>
    </view>
  </block>
  <view class="sc-dock-row" wx:elif="{{createMode === 'paste'}}" style="width:100%;box-sizing:border-box;">
    <view class="sc-dock-btn is-ghost {{parsing ? 'is-disabled' : ''}}" bindtap="runParse"><text>{{parsing ? '识别中…' : '识别预览'}}</text></view>
    <view class="sc-dock-btn {{(!parsePreview || !parsePreview.canWrite || saving) ? 'is-disabled' : ''}}" bindtap="confirmPaste"><text>{{saving ? '写入中…' : '确认写入'}}</text></view>
  </view>
  <view class="sc-dock-row" wx:else style="width:100%;box-sizing:border-box;">
    <view class="sc-dock-btn is-ghost" bindtap="resetSingle"><text>清空</text></view>
    <view class="sc-dock-btn {{saving ? 'is-disabled' : ''}}" bindtap="confirmSingle"><text>{{saving ? '写入中…' : '确认写入'}}</text></view>
  </view>
</view>

<!-- 草稿箱 / 历史备忘（仅超管；独立旁路集合，不进任何统计） -->
<view class="ss-mask" wx:if="{{memoBox.show}}" bindtap="closeMemoBox" catchtouchmove="noop"></view>
<view class="ss-sheet" wx:if="{{memoBox.show}}">
  <view class="ss-sheet-head" catchtouchmove="noop">
    <text class="ss-sheet-title">{{memoBox.title}}</text>
    <view class="ss-sheet-close" bindtap="closeMemoBox"><text>关闭</text></view>
  </view>
  <view class="ss-search" catchtouchmove="noop">
    <text class="mm-note">{{memoBox.kind === 'history' ? '9.21 前的飞书出货单，已结清，只读备忘；不计入任何统计' : '9.21 起的飞书出货单：审核修改后可转为正式出货单，转正式前不计入任何统计'}}</text>
  </view>
  <scroll-view class="ss-sheet-body" scroll-y style="height: {{sheetBodyPx}}px;">
    <view class="ss-loading" wx:if="{{memoBox.loading}}"><text>加载中…</text></view>
    <view class="ss-empty" wx:elif="{{memoBox.error}}">
      <text>{{memoBox.error}}</text>
      <text class="ss-empty-hint" bindtap="loadMemoBox">点此重试</text>
    </view>
    <view class="ss-empty" wx:elif="{{!memoBox.list.length}}"><text>{{memoBox.kind === 'history' ? '暂无历史备忘' : '草稿箱是空的'}}</text></view>
    <block wx:else>
      <view class="mm-card" wx:for="{{memoBox.list}}" wx:key="_id" data-id="{{item._id}}" bindtap="openMemo">
        <view class="mm-top">
          <text class="mm-title">{{item.title}}</text>
          <text class="mm-tag {{item.kind === 'history' ? 'is-history' : ''}}">{{item.kind === 'history' ? '已结清·历史' : '草稿'}}</text>
          <text class="mm-tag is-pending" wx:if="{{item.pendingCount}}">待匹配 {{item.pendingCount}}</text>
        </view>
        <text class="mm-meta">{{item.shipmentDate}} · {{item.lineCount}} 行 · {{item.totalQty}} 件{{item.storeMatched && item.customerName ? ' · 飞书客户 ' + item.customerName : ''}}</text>
        <text class="mm-meta">飞书 {{item.feishuTotalText}}{{item.kind === 'draft' ? ' · 参考 ' + item.refTotalText : ''}}</text>
      </view>
    </block>
  </scroll-view>
</view>

<view class="ss-mask" wx:if="{{memoDetail.show}}" bindtap="closeMemoDetail" catchtouchmove="noop"></view>
<view class="ss-sheet" wx:if="{{memoDetail.show}}">
  <view class="ss-sheet-head" catchtouchmove="noop">
    <text class="ss-sheet-title">{{memoDetail.item.kind === 'history' ? '历史备忘' : '草稿'}} · {{memoDetail.item.shipmentDate}}</text>
    <view class="ss-sheet-close" bindtap="closeMemoDetail"><text>关闭</text></view>
  </view>
  <scroll-view class="ss-sheet-body" scroll-y style="height: {{sheetBodyPx}}px;">
    <view class="mm-head">
      <view class="mm-top">
        <text class="mm-tag {{memoDetail.item.kind === 'history' ? 'is-history' : ''}}">{{memoDetail.item.kind === 'history' ? '已结清·历史' : '草稿'}}</text>
        <picker wx:if="{{memoDetail.item.kind === 'draft'}}" mode="selector" range="{{storeNames}}" bindchange="onMemoStore">
          <view class="mm-store {{memoDetail.item.storeMatched ? '' : 'is-pending'}}">{{memoDetail.item.storeMatched ? memoDetail.item.storeName : '门店待匹配 · 点选'}} ▾</view>
        </picker>
        <text class="mm-title" wx:else>{{memoDetail.item.storeMatched ? memoDetail.item.storeName : '门店待匹配'}}</text>
      </view>
      <text class="mm-meta">飞书客户 {{memoDetail.item.customerName || '—'}}</text>
      <text class="mm-meta">飞书合计 {{memoDetail.item.feishuTotalText}}</text>
      <text class="mm-meta" wx:if="{{memoDetail.item.kind === 'draft'}}">系统参考 {{memoDetail.item.refTotalText}}{{memoDetail.item.diffTotalText ? ' · ' + memoDetail.item.diffTotalText : ''}}</text>
      <text class="mm-meta" wx:if="{{memoDetail.item.note}}">备注 {{memoDetail.item.note}}</text>
    </view>
    <view class="mm-line {{item.removed ? 'is-removed' : ''}}" wx:for="{{memoDetail.item.lines}}" wx:key="key">
      <view class="mm-top">
        <text class="mm-line-name">{{item.rawName}}{{item.rawSpec ? ' · ' + item.rawSpec : ''}}</text>
        <text class="mm-tag is-pending" wx:if="{{item.pending}}">待匹配</text>
        <text class="mm-tag" wx:if="{{item.removed}}">已删除</text>
      </view>
      <text class="mm-meta">飞书 {{item.qty}} 件 {{item.unitText}} · {{item.feishuText}}{{item.feishuNote ? ' · ' + item.feishuNote : ''}}</text>
      <text class="mm-meta" wx:if="{{item.match === 'sku'}}">SKU {{item.skuName}} · 参考 {{item.refText}}{{item.diffText ? ' · 差 ' + item.diffText : ''}}</text>
      <text class="mm-meta" wx:elif="{{item.matchNote}}">{{item.matchNote}}</text>
      <view class="mm-actions" wx:if="{{memoDetail.item.kind === 'draft'}}">
        <block wx:if="{{!item.removed}}">
          <view class="mm-btn" data-key="{{item.key}}" bindtap="onMemoPickSku">{{item.match === 'sku' ? '换 SKU' : '选 SKU'}}</view>
          <view class="mm-btn" wx:if="{{item.match === 'sku'}}" data-key="{{item.key}}" bindtap="onMemoClearSku">取消匹配</view>
          <view class="mm-btn" data-key="{{item.key}}" data-delta="-1" bindtap="onMemoQtyStep">−</view>
          <view class="mm-btn" data-key="{{item.key}}" data-delta="1" bindtap="onMemoQtyStep">＋</view>
          <view class="mm-btn danger" data-key="{{item.key}}" bindtap="onMemoToggleLine">删行</view>
        </block>
        <view class="mm-btn" wx:else data-key="{{item.key}}" bindtap="onMemoToggleLine">恢复此行</view>
      </view>
    </view>
  </scroll-view>
  <view class="mm-foot" catchtouchmove="noop">
    <text class="mm-tip" wx:if="{{memoDetail.tip}}">{{memoDetail.tip}}</text>
    <view class="mm-foot-row" wx:if="{{memoDetail.item.kind === 'draft'}}">
      <view class="mm-foot-btn is-ghost" bindtap="removeMemo">{{memoDetail.removePending ? '确认删除' : '删除草稿'}}</view>
      <view class="mm-foot-btn {{memoDetail.busy || memoDetail.item.pendingCount ? 'is-disabled' : ''}}" bindtap="confirmMemo">{{memoDetail.busy ? '处理中…' : (memoDetail.confirmPending ? '确认转正式' : '转为正式出货单')}}</view>
    </view>
    <text class="mm-tip" wx:else>已结清的历史备忘，只读；金额以飞书原始金额为准</text>
  </view>
</view>

<!-- 选已有 SKU -->
<view class="ss-mask" wx:if="{{skuPicker.show}}" bindtap="closeSkuPicker" catchtouchmove="noop"></view>
<view class="ss-sheet" wx:if="{{skuPicker.show}}">
  <view class="ss-sheet-head" catchtouchmove="noop">
    <text class="ss-sheet-title">选择出货 SKU</text>
    <view class="ss-sheet-close" bindtap="closeSkuPicker"><text>关闭</text></view>
  </view>
  <view class="ss-search" catchtouchmove="noop">
    <input class="ss-search-input" placeholder="搜 SKU 名（如 大蓝闪蝶）" value="{{skuPicker.keyword}}" bindinput="onSkuKeyword" />
    <view class="ss-review-filter {{skuPicker.reviewOnly ? 'on' : ''}}" wx:if="{{skuPicker.reviewCount || skuPicker.reviewOnly}}" bindtap="toggleSkuReviewOnly">
      <text>{{skuPicker.reviewOnly ? '显示全部' : '只看待复核 ' + skuPicker.reviewCount}}</text>
    </view>
  </view>
  <scroll-view class="ss-sheet-body" scroll-y style="height: {{sheetBodyPx}}px;">
    <view class="ss-loading" wx:if="{{skuPicker.loading}}"><text>加载中…</text></view>
    <view class="ss-empty" wx:elif="{{!skuPicker.list.length}}">
      <text>还没有 SKU</text>
      <text class="ss-empty-hint">点「新建 SKU」建一个（同组合只需建一次，以后直接选）</text>
    </view>
    <block wx:else>
      <view class="ss-sku" wx:for="{{skuPicker.list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onPickSku">
        <view class="ss-sku-main">
          <view class="ss-sku-title">
            <text class="ss-sku-name">{{item.skuName}}</text>
            <text class="ss-review-tag" wx:if="{{item.needsReview}}">待复核</text>
          </view>
          <text class="ss-sku-meta">{{item.rateText}}{{item.pricingStatus !== 'priced' ? ' · ' + (item.pricingNote || '待核价') : ''}}</text>
        </view>
        <text class="ss-sku-price {{item.pricingStatus !== 'priced' ? 'is-pending' : ''}}">{{item.unitPriceText}}</text>
      </view>
    </block>
  </scroll-view>
</view>

<!-- SKU 详情 / 编辑（SKU 目录与开单「新建 SKU」共用；仅超管）。删除只走 skuAdmin.removeIfUnused，被引用只能停用 -->
<view class="ss-mask" wx:if="{{skuEdit.show}}" bindtap="closeSkuEdit" catchtouchmove="noop"></view>
<view class="ss-sheet" wx:if="{{skuEdit.show}}">
  <view class="ss-sheet-head" catchtouchmove="noop">
    <view class="sk-sheet-heading">
      <text class="sk-sheet-en">{{skuEdit.mode === 'edit' ? 'SKU · DETAIL' : 'SKU · NEW'}}</text>
      <text class="ss-sheet-title">{{skuEdit.mode === 'edit' ? 'SKU 详情' : (skuEdit.origin === 'create' ? '新建 SKU 并加入本单' : '新建 SKU')}}</text>
    </view>
    <view class="ss-sheet-close" hover-class="tap-press" hover-stay-time="80" bindtap="closeSkuEdit"><text>关闭</text></view>
  </view>
  <scroll-view class="ss-sheet-body" scroll-y style="height: {{sheetBodyPx}}px;">
    <view class="ops-list-tip is-{{skuEdit.tipTone}} sk-sheet-tip" wx:if="{{skuEdit.tip}}"><text>{{skuEdit.tip}}</text></view>
    <view class="ss-alert" wx:if="{{skuEdit.mode !== 'edit'}}">
      <text>SKU = 原材料 × 等级 × 包装方式 × 尺寸 + 是否造景 + 默认手工费率。同组合只需建一次；原材料 / 包装缺项先到「SKU」页签的原材料 / 包装方式里补。</text>
    </view>

    <view class="sk-state" wx:if="{{skuEdit.mode === 'edit'}}">
      <view class="sk-state-tags">
        <text class="sk-state-tag {{skuEdit.status === 'inactive' ? 'is-off' : 'is-on'}}">{{skuEdit.status === 'inactive' ? '已停用' : '启用中'}}</text>
        <text class="ss-review-tag" wx:if="{{skuEdit.needsReview}}">待复核</text>
        <text class="sk-state-batch" wx:if="{{skuEdit.importBatch}}">导入批次 {{skuEdit.importBatch}}</text>
      </view>
      <text class="sk-state-line">{{skuEdit.refsLoading ? '正在查被引用情况…' : (skuEdit.refsError ? skuEdit.refsError : '被引用：' + (skuEdit.refsText || '无'))}}</text>
      <text class="sk-state-line" wx:if="{{skuEdit.metaText}}">{{skuEdit.metaText}}</text>
    </view>

    <view class="ss-row">
      <text class="ss-label">原材料</text>
      <view class="ss-pick-inner ss-pick-click" hover-class="tap-press-soft" hover-stay-time="80" data-kind="material" data-target="skuEdit" bindtap="openPicker">
        <text class="{{skuEdit.materialName ? 'sc-pick-on' : 'sc-pick-off'}}">{{skuEdit.materialName ? (skuEdit.materialName + (skuEdit.materialGrade ? '（' + skuEdit.materialGrade + '）' : '')) : '选择原材料'}}</text>
        <text class="ss-arrow">▾</text>
      </view>
    </view>
    <view class="ss-row">
      <text class="ss-label">包装方式</text>
      <view class="ss-pick-inner ss-pick-click" hover-class="tap-press-soft" hover-stay-time="80" data-kind="packaging" data-target="skuEdit" bindtap="openPicker">
        <text class="{{skuEdit.packagingName ? 'sc-pick-on' : 'sc-pick-off'}}">{{skuEdit.packagingName ? (skuEdit.packagingName + (skuEdit.packagingSize ? ' ' + skuEdit.packagingSize : '')) : '选择包装方式'}}</text>
        <text class="ss-arrow">▾</text>
      </view>
    </view>
    <view class="ss-row">
      <text class="ss-label">手工费</text>
      <view class="ss-rate-ctl">
        <switch class="ss-switch" checked="{{skuEdit.useGlobalRate}}" color="#C4A76C" bindchange="onSkuEditRateToggle" />
        <text class="ss-rate-hint" wx:if="{{skuEdit.useGlobalRate}}">用全局 {{globalRatePct}}%</text>
        <block wx:else>
          <input class="ss-rate-input" type="digit" value="{{skuEdit.laborRatePct}}" bindinput="onSkuEditRate" />
          <text class="ss-rate-hint">%</text>
        </block>
      </view>
    </view>
    <view class="ss-row">
      <text class="ss-label">造景</text>
      <view class="ss-rate-ctl">
        <switch class="ss-switch" checked="{{skuEdit.hasScene}}" color="#C4A76C" bindchange="onSkuEditSceneToggle" />
        <text class="ss-rate-hint" wx:if="{{!skuEdit.hasScene}}">不含造景</text>
        <block wx:else>
          <text class="ss-rate-hint">¥</text>
          <input class="ss-rate-input" type="digit" value="{{skuEdit.sceneCost}}" placeholder="元/件" bindinput="onSkuEditSceneCost" />
          <text class="ss-rate-hint">/ 件 · 计入金额与毛利扣减，不计手工费基数</text>
        </block>
      </view>
    </view>
    <view class="ss-row">
      <text class="ss-label">SKU 名</text>
      <input class="ss-input" value="{{skuEdit.name}}" placeholder="{{skuEdit.nameTouched ? '留空即自动生成' : skuEdit.namePlaceholder}}" placeholder-class="ss-ph" bindinput="onSkuEditName" />
    </view>
    <view class="ss-row is-last">
      <text class="ss-label">备注</text>
      <input class="ss-input" value="{{skuEdit.note}}" placeholder="可选，如 客户常用 / 换包装前用" placeholder-class="ss-ph" bindinput="onSkuEditNote" />
    </view>
    <view class="ss-preview">
      <text class="ss-preview-label">这一组合的单价（按当前价目表现算）</text>
      <text class="ss-preview-value {{skuEdit.pricingStatus !== 'priced' ? 'is-pending' : ''}}">{{skuEdit.unitPriceText}}</text>
      <text class="sk-breakdown" wx:if="{{skuEdit.breakdown}}">{{skuEdit.breakdown}}</text>
      <text class="ss-preview-note" wx:if="{{skuEdit.pricingNote}}">{{skuEdit.pricingNote}}</text>
    </view>
    <view class="ss-problems" wx:if="{{skuEdit.problems.length}}">
      <text wx:for="{{skuEdit.problems}}" wx:key="*this">· {{item}}</text>
    </view>

    <view class="sk-ops" wx:if="{{skuEdit.mode === 'edit'}}">
      <text class="sc-lib-btn {{skuEdit.status === 'inactive' ? 'on' : 'warn'}}" hover-class="tap-press" hover-stay-time="80" bindtap="toggleSkuEditStatus">{{skuEdit.busy ? '处理中…' : (skuEdit.status === 'inactive' ? '启用' : '停用')}}</text>
      <text class="sc-lib-btn on" wx:if="{{skuEdit.needsReview}}" hover-class="tap-press" hover-stay-time="80" bindtap="markSkuEditReviewed">标记已复核</text>
      <text class="sc-lib-btn" hover-class="tap-press" hover-stay-time="80" bindtap="copySkuEdit">复制为新 SKU</text>
      <text class="sc-lib-btn warn" hover-class="tap-press" hover-stay-time="80" bindtap="askRemoveSkuEdit">删除</text>
    </view>
    <view class="sc-lib-inline sk-inline" wx:if="{{skuEdit.removeStep === 'confirm'}}">
      <text class="sc-lib-inline-text">删除「{{skuEdit.name || skuEdit.namePlaceholder}}」？只有没被任何出货单 / 草稿用过才会成功，否则请停用。</text>
      <view class="sc-lib-inline-btns">
        <text class="sc-lib-btn" hover-class="tap-press" hover-stay-time="80" bindtap="cancelRemoveSkuEdit">取消</text>
        <text class="sc-lib-btn danger" hover-class="tap-press" hover-stay-time="80" bindtap="confirmRemoveSkuEdit">{{skuEdit.busy ? '检查中…' : '确认删除'}}</text>
      </view>
    </view>
    <view class="sc-lib-inline is-warn sk-inline" wx:if="{{skuEdit.removeStep === 'blocked'}}">
      <text class="sc-lib-inline-text">{{skuEdit.blockedText}}</text>
      <view class="sc-lib-inline-btns">
        <text class="sc-lib-btn" hover-class="tap-press" hover-stay-time="80" bindtap="cancelRemoveSkuEdit">知道了</text>
        <text class="sc-lib-btn danger" wx:if="{{skuEdit.status !== 'inactive'}}" hover-class="tap-press" hover-stay-time="80" bindtap="deactivateBlockedSku">改为停用</text>
      </view>
    </view>
  </scroll-view>
  <view class="ss-actions is-in-sheet" catchtouchmove="noop">
    <view class="ss-cta" style="width:100%;min-width:100%;max-width:100%;display:flex;box-sizing:border-box;" hover-class="ss-cta-press" bindtap="submitSkuEdit">
      <text>{{skuEdit.saving ? '保存中…' : (skuEdit.mode === 'edit' ? '保存修改' : (skuEdit.origin === 'create' ? '创建并加入明细' : '创建 SKU'))}}</text>
    </view>
  </view>
</view>

<!-- 原材料 / 包装方式选择器 -->
<view class="ss-mask is-top" wx:if="{{picker.show}}" bindtap="closePicker" catchtouchmove="noop"></view>
<view class="ss-sheet is-top" wx:if="{{picker.show}}">
  <view class="ss-sheet-head" catchtouchmove="noop">
    <text class="ss-sheet-title">选择{{picker.kind === 'material' ? '原材料' : '包装方式'}}</text>
    <view class="ss-sheet-close" bindtap="closePicker"><text>关闭</text></view>
  </view>
  <view class="ss-search" catchtouchmove="noop">
    <input class="ss-search-input" placeholder="输入名称或别名（如 大蓝闪）" value="{{picker.keyword}}" bindinput="onPickerKeyword" />
  </view>
  <scroll-view class="ss-sheet-body" scroll-y style="height: {{sheetBodyPx}}px;">
    <view class="ss-loading" wx:if="{{picker.loading}}"><text>加载中…</text></view>
    <view class="ss-empty" wx:elif="{{!picker.list.length}}">
      <text>没有匹配项</text>
      <text class="ss-empty-hint">{{isSuper ? '可到「SKU」页签的原材料 / 包装方式里新增' : '请联系超管在「资料」页签维护'}}</text>
    </view>
    <block wx:else>
      <view class="ss-group" wx:for="{{picker.list}}" wx:key="key">
        <view class="ss-group-head" data-key="{{item.key}}" bindtap="onToggleGroup">
          <image class="ss-group-thumb" wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" lazy-load />
          <view class="ss-group-main">
            <text class="ss-group-name">{{item.displayName}}</text>
            <text class="ss-group-meta" wx:if="{{item.aliasesText}}">别名 {{item.aliasesText}}</text>
          </view>
          <text class="ss-group-count">{{item.optionField === 'size' ? '尺寸' : '等级'}} {{item.optionCount}}</text>
        </view>
        <view class="ss-options" wx:if="{{picker.expandedKey === item.key || item.singleOption}}">
          <view class="ss-option" wx:for="{{item.options}}" wx:for-item="opt" wx:key="_id" data-key="{{item.key}}" data-option="{{opt.option}}" data-id="{{opt._id}}" bindtap="onPickOption">
            <text class="ss-option-name">{{opt.option}}</text>
            <text class="ss-option-price">{{opt.unitPriceText}}</text>
            <text class="ss-option-tag" wx:if="{{opt.isDefault}}">默认</text>
          </view>
        </view>
        <view class="ss-group-hint" wx:else><text>点一下展开 {{item.optionCount}} 个规格</text></view>
      </view>
    </block>
  </scroll-view>
</view>

<!-- 资料表单：新增 / 编辑 -->
<view class="ss-mask" wx:if="{{libForm.show}}" bindtap="closeLibForm" catchtouchmove="noop"></view>
<view class="ss-sheet" wx:if="{{libForm.show}}">
  <view class="ss-sheet-head" catchtouchmove="noop">
    <text class="ss-sheet-title">{{libForm.id ? '编辑' : '新增'}}{{libForm.kind === 'material' ? '原材料' : '包装方式'}}</text>
    <view class="ss-sheet-close" bindtap="closeLibForm"><text>关闭</text></view>
  </view>
  <scroll-view class="ss-sheet-body" scroll-y style="height: {{sheetBodyPx}}px;">
    <view class="ss-alert" wx:if="{{libForm.impactText}}"><text>{{libForm.impactText}}</text></view>
    <view class="ss-row">
      <text class="ss-label">名称</text>
      <input class="ss-input" value="{{libForm.name}}" data-field="name" bindinput="onLibInput" placeholder="必填，如 大蓝闪蝶 / 框" placeholder-class="ss-ph" />
    </view>
    <view class="ss-row">
      <text class="ss-label">{{libForm.kind === 'material' ? '等级' : '尺寸'}}</text>
      <input class="ss-input" value="{{libForm.option}}" data-field="option" bindinput="onLibInput" placeholder="{{libForm.kind === 'material' ? '如 A1；留空 = 默认' : '如 10x18；留空 = 默认'}}" placeholder-class="ss-ph" />
    </view>
    <view class="ss-row">
      <text class="ss-label">单价（元）</text>
      <input class="ss-input" type="digit" value="{{libForm.unitPrice}}" data-field="unitPrice" bindinput="onLibInput" placeholder="≥ 0" placeholder-class="ss-ph" />
    </view>
    <view class="ss-row">
      <text class="ss-label">单位</text>
      <input class="ss-input" value="{{libForm.unit}}" data-field="unit" bindinput="onLibInput" placeholder="只 / 个 / 份（可选）" placeholder-class="ss-ph" />
    </view>
    <view class="ss-row" wx:if="{{libForm.kind === 'material'}}">
      <text class="ss-label">分类</text>
      <picker class="ss-pick" mode="selector" range="{{libCategoryNames}}" value="{{libCategoryIndex}}" bindchange="onLibCategory">
        <view class="ss-pick-inner">
          <text class="ss-pick-val">{{libCategoryNames[libCategoryIndex]}}</text>
          <text class="ss-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="ss-row">
      <text class="ss-label">别名</text>
      <input class="ss-input" value="{{libForm.aliases}}" data-field="aliases" bindinput="onLibInput" placeholder="逗号分隔（可选），如 大蓝闪" placeholder-class="ss-ph" />
    </view>
    <view class="ss-row">
      <text class="ss-label">默认{{libForm.kind === 'material' ? '等级' : '尺寸'}}</text>
      <view class="ss-rate-ctl">
        <switch class="ss-switch" checked="{{libForm.isDefault}}" color="#C4A76C" bindchange="onLibDefault" />
        <text class="ss-rate-hint">文本没写{{libForm.kind === 'material' ? '等级' : '尺寸'}}时用这一行取价（同名只能一个）</text>
      </view>
    </view>
    <view class="ss-row">
      <text class="ss-label">备注</text>
      <input class="ss-input" value="{{libForm.note}}" data-field="note" bindinput="onLibInput" placeholder="可选" placeholder-class="ss-ph" />
    </view>
    <view class="ss-row is-last">
      <text class="ss-label">图片</text>
      <view class="sc-lib-img-ctl">
        <image class="sc-lib-img" wx:if="{{libForm.imageThumb}}" src="{{libForm.imageThumb}}" mode="aspectFill" bindtap="previewLibImage" binderror="onLibThumbError" />
        <view class="sc-lib-img is-empty" wx:else bindtap="chooseLibImage"><text>{{libForm.uploading ? '上传中…' : '＋'}}</text></view>
        <view class="sc-lib-img-btns">
          <text class="sc-lib-btn" bindtap="chooseLibImage">{{libForm.uploading ? '上传中…' : (libForm.image ? '换一张' : '上传图片')}}</text>
          <text class="sc-lib-btn warn" wx:if="{{libForm.image && !libForm.uploading}}" bindtap="removeLibImage">删除图片</text>
        </view>
      </view>
    </view>
    <view class="ss-problems" wx:if="{{libForm.problems}}"><text>· {{libForm.problems}}</text></view>
  </scroll-view>
  <view class="ss-actions is-in-sheet" catchtouchmove="noop">
    <view class="ss-cta" style="width:100%;min-width:100%;max-width:100%;display:flex;box-sizing:border-box;" hover-class="ss-cta-press" bindtap="submitLibForm">
      <text>{{libForm.saving ? '保存中…' : '保存'}}</text>
    </view>
  </view>
</view>

<!-- 详情：物流 + 状态流转（契约：setStatus / update；结算只读） -->
<view class="ops-mask" wx:if="{{showDetail}}" bindtap="closeDetail" catchtouchmove="noop"></view>
<view class="ops-sheet sc-detail-sheet" wx:if="{{showDetail && detail}}">
  <view class="ops-sheet-head" catchtouchmove="noop">
    <text class="ops-sheet-title">{{detail.customerLine || detail.storeName}}</text>
    <text class="ops-sheet-close" bindtap="closeDetail">关闭</text>
  </view>
  <scroll-view scroll-y class="ops-sheet-body sc-detail-body" style="height: {{sheetBodyPx}}px;">
    <view class="ops-card-tags" style="margin-bottom: 16rpx;">
      <text class="ops-status {{detail.statusTone}}">{{detail.statusLabel}}</text>
      <text class="ops-settle {{detail.settleTone}}" wx:if="{{detail.settleLabel}}">结算 {{detail.settleLabel}}</text>
      <text class="ops-source {{detail.sourceTone}}">{{detail.sourceLabel}}</text>
      <text class="ops-meta-inline warn" wx:if="{{detail.pricingIncomplete}}">核价未完</text>
      <text class="ops-meta-inline" wx:if="{{detail.entryPathLabel}}">{{detail.entryPathLabel}}</text>
    </view>
    <text class="ops-meta">{{detail.shipmentNo}} · {{detail.shipmentDate}}</text>
    <text class="ops-meta" wx:if="{{detail.buyerName}}">购买人 {{detail.buyerName}}</text>
    <text class="ops-amount">{{detail.totalQty}} 件 · {{detail.itemCount}} 行{{detail.amountText ? ' · ¥' + detail.amountText : ''}}</text>

    <view class="ops-group" style="margin-top: 20rpx;">
      <view class="sc-detail-line" wx:for="{{detail.items}}" wx:key="itemName">
        <view class="sc-detail-line-main">
          <text class="ops-line-name">{{item.itemName}}{{item.spec ? ' · ' + item.spec : ''}}</text>
          <text class="sc-detail-mat" wx:if="{{item.matLine}}">{{item.matLine}}</text>
        </view>
        <text class="ops-qty-badge">{{item.qty}}</text>
      </view>
    </view>

    <view class="ops-detail-section" wx:if="{{canWrite}}">
      <text class="ops-section-label">物流（快递公司 / 运单号）</text>
      <view class="ops-field-row">
        <view class="ops-field half">
          <input class="ops-field-input" value="{{shipForm.expressCompany}}" data-field="expressCompany" bindinput="onShipFormInput" placeholder="快递公司" placeholder-class="ops-ph" />
        </view>
        <view class="ops-field half">
          <input class="ops-field-input" value="{{shipForm.trackingNo}}" data-field="trackingNo" bindinput="onShipFormInput" placeholder="运单号" placeholder-class="ops-ph" />
        </view>
      </view>
      <view class="ops-chip-btn brass" bindtap="saveLogistics">{{detailBusy ? '保存中…' : '保存物流'}}</view>
    </view>
    <text class="ops-meta" wx:elif="{{detail.expressCompany || detail.trackingNo}}">物流 {{detail.expressCompany || '—'}} {{detail.trackingNo || ''}}</text>

    <view class="ops-detail-section" wx:if="{{canWrite && nextActions.length}}">
      <text class="ops-section-label">下一状态</text>
      <view class="ops-next-row">
        <view class="ops-chip-btn brass" wx:for="{{nextActions}}" wx:key="value" data-status="{{item.value}}" bindtap="applyStatus">{{item.label}}</view>
      </view>
      <text class="ops-field-hint">发货前可先填运单；点「已发货」时会一并写入。取消 / 完成等不可逆路径请谨慎。</text>
    </view>
    <view class="ops-detail-section" wx:elif="{{!nextActions.length}}">
      <text class="ops-field-hint">当前状态无后续流转（已完成或已取消）。</text>
    </view>

    <view class="ops-list-tip is-{{detailTipTone}}" wx:if="{{detailTip}}"><text>{{detailTip}}</text></view>

    <text class="ops-meta" wx:if="{{detail.note}}">备注 {{detail.note}}</text>
    <text class="ops-meta" wx:if="{{detail.billNo}}">关联账单 {{detail.billNo}}</text>
    <text class="ops-meta" wx:if="{{detail.feishuRecordId}}">飞书记录 {{detail.feishuRecordId}}</text>
    <text class="ops-meta" wx:if="{{detail.batchId}}">批次 {{detail.batchId}}</text>
    <view class="ops-chip-btn danger sc-detail-remove" wx:if="{{canWrite}}" data-id="{{detail._id}}" bindtap="onRemove">{{removePendingId === detail._id ? '确认删除（软删）' : '删除此单'}}</view>
    <text class="ops-settle-note">结算状态跟随「工作室账单」，这里只能查看。</text>
  </scroll-view>
</view>
