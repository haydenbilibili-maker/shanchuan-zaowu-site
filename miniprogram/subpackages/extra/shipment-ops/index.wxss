@import '../utils/ops-museum.wxss';
@import '../utils/ops-dashboard.wxss';

.ops-entry-tabs {
  display: flex;
  gap: 12rpx;
  padding: 0 32rpx 12rpx;
}

.ops-entry-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary, #a09a90);
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(77, 64, 26, 0.4);
}

.ops-entry-tab.on {
  color: var(--color-bg, #1a1814);
  background: var(--brass-400, #c4a76c);
  border-color: var(--brass-400, #c4a76c);
  font-weight: 500;
}

.ops-field {
  margin-bottom: 24rpx;
}

.ops-field.half {
  flex: 1;
  min-width: 0;
}

.ops-field-row {
  display: flex;
  gap: 16rpx;
}

.ops-field-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.ops-field-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  border-radius: 16rpx;
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.ops-field-hint {
  display: block;
  margin: -12rpx 0 20rpx;
  font-size: 22rpx;
  color: var(--brass-300, #d4bc85);
}

.ops-sku-search {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.ops-sku-search .sku-kw {
  flex: 1;
}

.ops-sku-btn {
  flex-shrink: 0;
  min-width: 88rpx;
  padding: 20rpx 18rpx;
  text-align: center;
  border-radius: 16rpx;
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  color: var(--brass-400, #c4a76c);
  font-size: 26rpx;
}

.ops-sku-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.ops-sku-hits {
  margin-top: 12rpx;
  max-height: 320rpx;
  overflow-y: auto;
  border-radius: 16rpx;
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  background: var(--color-bg, #1a1814);
}

.ops-sku-hit {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid rgba(38, 35, 32, 0.9);
}

.ops-sku-hit:last-child {
  border-bottom: none;
}

.ops-sku-hit.on {
  background: rgba(196, 167, 108, 0.1);
}

.ops-sku-hit-main {
  flex: 1;
  min-width: 0;
}

.ops-sku-hit-name {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.35;
}

.ops-sku-hit-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #a09a90);
}

.ops-sku-hit-side {
  flex-shrink: 0;
  text-align: right;
}

.ops-sku-hit-src {
  display: block;
  font-size: 20rpx;
  color: var(--brass-300, #d4bc85);
}

.ops-sku-hit-price {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}
