/* 出货中心 · 开单与弹层样式（2026-09-28 自原 shipment-sku 页迁入；ss- 前缀保持不变） */

.ss-lines { display: flex; flex-direction: column; gap: 16rpx; }
.ss-line { background: var(--color-bg-elevated, #262320); border: 1rpx solid rgba(77, 64, 26, 0.5); border-radius: 16rpx; padding: 20rpx 24rpx; }
.ss-line.is-pending { border-color: rgba(196, 92, 74, 0.66); }
.ss-line-head { display: flex; align-items: center; gap: 12rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid rgba(77, 64, 26, 0.34); }
.ss-line-title { flex: 1; display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.ss-line-name { flex: 1; font-size: 28rpx; color: var(--color-text-primary, #f2ece1); }
.ss-line-tag { flex-shrink: 0; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 6rpx; background: rgba(196, 167, 108, 0.2); color: #c4a76c; }
.ss-del { padding: 6rpx 16rpx; border: 1rpx solid rgba(196, 92, 74, 0.46); border-radius: 8rpx; }
.ss-del text { font-size: 22rpx; color: #e3a99e; }

.ss-line-calc { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 16rpx 0; }
.ss-unit { font-size: 24rpx; color: #c4a76c; width: 170rpx; }
.ss-qty { display: flex; align-items: center; gap: 8rpx; }
.ss-qty-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(196, 167, 108, 0.36); border-radius: 10rpx; color: #e8dcc0; font-size: 30rpx; }
.ss-qty-input { width: 96rpx; text-align: center; font-size: 28rpx; color: var(--color-text-primary, #f2ece1); }
.ss-line-total { font-size: 32rpx; font-weight: 600; color: #e8dcc0; min-width: 160rpx; text-align: right; }
.ss-line-total.is-pending { font-size: 24rpx; color: #e3a99e; }

.ss-rate-row { display: flex; align-items: center; gap: 10rpx; padding-top: 12rpx; border-top: 1rpx solid rgba(77, 64, 26, 0.34); }
.ss-switch { transform: scale(0.72); }
.ss-rate-hint { font-size: 22rpx; color: var(--color-text-secondary, #a09a90); }
.ss-rate-input { width: 110rpx; background: rgba(0, 0, 0, 0.28); border: 1rpx solid rgba(196, 167, 108, 0.36); border-radius: 10rpx; color: var(--color-text-primary, #f2ece1); font-size: 26rpx; padding: 8rpx 12rpx; text-align: center; }
.ss-rate-ctl { flex: 1; display: flex; align-items: center; gap: 10rpx; }
.ss-note { margin-top: 10rpx; font-size: 22rpx; color: #e3a99e; line-height: 1.5; }

.ss-press { opacity: 0.82; }

.ss-card { background: var(--color-bg-elevated, #262320); border: 1rpx solid rgba(77, 64, 26, 0.55); border-radius: 16rpx; padding: 18rpx 24rpx 8rpx; margin-bottom: 16rpx; }
.ss-card-en { display: block; font-size: 20rpx; letter-spacing: 0.16em; color: #c4a76c; margin-bottom: 6rpx; font-weight: 500; }
.ss-row { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 10rpx 0; border-bottom: 1rpx solid rgba(77, 64, 26, 0.38); }
.ss-row.is-last { border-bottom: none; }
.ss-label { width: 144rpx; flex-shrink: 0; font-size: 24rpx; color: #a09a90; line-height: 1.3; }
.ss-input { flex: 1; min-width: 0; height: 64rpx; line-height: 64rpx; background: rgba(0, 0, 0, 0.28); border: 1rpx solid rgba(196, 167, 108, 0.32); border-radius: 10rpx; color: var(--color-text-primary, #f2ece1); font-size: 28rpx; padding: 0 16rpx; box-sizing: border-box; }
.ss-ph { color: #7d786f; }
.ss-pick { flex: 1; min-width: 0; }
.ss-pick-inner { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; min-height: 64rpx; padding: 0 16rpx; background: rgba(0, 0, 0, 0.26); border: 1rpx solid rgba(196, 167, 108, 0.32); border-radius: 10rpx; box-sizing: border-box; }
.ss-pick-val { flex: 1; min-width: 0; font-size: 28rpx; color: var(--color-text-primary, #f2ece1); }
.ss-pick-val.is-empty { color: #b8796c; }
.ss-arrow { flex-shrink: 0; font-size: 22rpx; color: #c4a76c; }
.ss-pick-click { flex: 1; }

.ss-add-row { display: flex; gap: 14rpx; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; }
.ss-add-btn { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 6rpx; padding: 22rpx 20rpx; border-radius: 14rpx; box-sizing: border-box; }
/* 主 CTA：实心铜底（勿用虚线框，避免与旧版混淆） */
.ss-add-btn.is-primary { background: linear-gradient(135deg, #c4a76c, #a8874c) !important; border: 1rpx solid #a8874c !important; }
.ss-add-btn.is-secondary { background: transparent; border: 1rpx solid rgba(196, 167, 108, 0.45); }
.ss-add-btn.is-disabled { opacity: 0.42; }
.ss-add-title { font-size: 28rpx; font-weight: 600; color: #e8dcc0; }
.ss-add-btn.is-primary .ss-add-title { color: #221e17 !important; }
.ss-add-sub { font-size: 20rpx; color: #8a8378; }
.ss-add-btn.is-primary .ss-add-sub { color: rgba(34, 30, 23, 0.72) !important; }

/* 空态：虚线可点框 + 中央 +（与纯文字旧版区分） */
.ss-empty-box { margin-top: 8rpx; width: 100%; padding: 56rpx 28rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; border-radius: 16rpx; border: 2rpx dashed rgba(196, 167, 108, 0.55) !important; background: rgba(196, 167, 108, 0.08); box-sizing: border-box; }
.ss-empty-box.is-disabled { opacity: 0.45; }
.ss-empty-mark { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 4rpx; border: 1rpx solid rgba(196, 167, 108, 0.55); background: rgba(196, 167, 108, 0.16); }
.ss-empty-mark text { font-size: 40rpx; color: #c4a76c; line-height: 1; }
.ss-empty-title { font-size: 28rpx; color: #e8dcc0; }
.ss-empty-hint { font-size: 22rpx; color: #7d786f; text-align: center; line-height: 1.45; }

.ss-empty { padding: 50rpx 0; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.ss-empty text { font-size: 26rpx; color: var(--color-text-secondary, #a09a90); }

.ss-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100% !important;
  z-index: 21;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 0 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(20, 18, 15, 0.92), rgba(20, 18, 15, 0.98) 28%);
  border-top: 1rpx solid rgba(196, 167, 108, 0.34);
  box-sizing: border-box;
}
.ss-summary { display: flex; width: 100% !important; align-items: flex-end; justify-content: space-between; gap: 16rpx; padding: 18rpx 0 14rpx; box-sizing: border-box; }
.ss-sum-left { display: flex; flex-direction: column; gap: 4rpx; }
.ss-sum-meta { font-size: 22rpx; color: #a09a90; }
.ss-sum-warn { font-size: 20rpx; color: #e3a99e; }
.ss-sum-right { display: flex; align-items: baseline; gap: 10rpx; }
.ss-sum-k { font-size: 22rpx; color: #a09a90; }
.ss-sum-value { font-size: 40rpx; font-weight: 600; color: #c4a76c; font-variant-numeric: tabular-nums; }
.ss-save-hint { display: block; width: 100%; text-align: center; font-size: 22rpx; color: #e3a99e; margin-bottom: 10rpx; box-sizing: border-box; }
/* 底栏主 CTA：强制横贯 dock 内容宽（小程序 flex 子项无 width 会按文案收缩成半宽） */
.ss-cta {
  display: flex !important;
  flex: 0 0 auto;
  width: 100% !important;
  min-width: 100% !important;
  max-width: 100% !important;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  align-self: stretch !important;
  box-sizing: border-box !important;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #c4a76c, #a8874c);
  border: 1rpx solid transparent;
  margin: 0;
  padding: 0;
}
.ss-cta text { font-size: 30rpx; font-weight: 600; color: #221e17; }
.ss-cta-press { opacity: 0.88; }
.ss-cta.is-disabled { background: rgba(196, 167, 108, 0.18); border: 1rpx solid rgba(196, 167, 108, 0.28); }
.ss-cta.is-disabled text { color: #7d786f; font-weight: 500; }

.ss-actions { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 28rpx 28rpx; background: rgba(20, 18, 15, 0.98); z-index: 21; box-sizing: border-box; }
.ss-actions.is-in-sheet { position: static; flex-shrink: 0; background: transparent; padding: 16rpx 28rpx 28rpx; display: flex; flex-direction: column; align-items: stretch; width: 100%; box-sizing: border-box; }

.ss-mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.62); z-index: 40; }
/* 弹层：标题 / 搜索 / 底部按钮固定，只有 .ss-sheet-body 滚动；高度由内联 sheetBodyPx 决定（见 parts/shared.js） */
.ss-sheet { position: fixed; left: 0; right: 0; bottom: 0; max-height: 80vh; overflow: hidden; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; background: #211e1a; border-top-left-radius: 22rpx; border-top-right-radius: 22rpx; border-top: 1rpx solid rgba(196, 167, 108, 0.4); z-index: 41; }
.ss-sheet-head { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: 22rpx 28rpx 12rpx; }
.ss-sheet-title { font-size: var(--fs-28); color: var(--color-text-primary, #f2ece1); }
.ss-sheet-close text { font-size: var(--fs-24); color: #c4a76c; }
.ss-search { flex-shrink: 0; padding: 0 28rpx 14rpx; }
.ss-search-input { background: rgba(0, 0, 0, 0.34); border: 1rpx solid rgba(196, 167, 108, 0.34); border-radius: 12rpx; padding: 16rpx 20rpx; font-size: var(--fs-26); color: var(--color-text-primary, #f2ece1); }
/* flex: 1（基准 0%）在不定高的弹层里按内容撑开、无视内联高度 → 列表比屏幕还高、滑不动 */
.ss-sheet-body { flex: 0 1 auto; min-height: 0; padding: 0 20rpx 20rpx; box-sizing: border-box; }

.ss-alert { margin: 0 8rpx 12rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: rgba(196, 167, 108, 0.12); border: 1rpx solid rgba(196, 167, 108, 0.32); }
.ss-alert text { font-size: 22rpx; color: #e8dcc0; line-height: 1.6; }

.ss-sku { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 18rpx; margin-bottom: 10rpx; background: rgba(0, 0, 0, 0.22); border: 1rpx solid rgba(77, 64, 26, 0.5); border-radius: 12rpx; }
.ss-sku-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.ss-sku-name { font-size: var(--fs-26); color: var(--color-text-primary, #f2ece1); }
.ss-sku-meta { font-size: var(--fs-20); color: #7d786f; }
.ss-sku-price { font-size: 28rpx; color: #c4a76c; }
.ss-sku-price.is-pending { font-size: 22rpx; color: #e3a99e; }

.ss-loading { padding: 48rpx 0; display: flex; flex-direction: column; align-items: center; }
.ss-loading text { font-size: 26rpx; color: var(--color-text-secondary, #a09a90); }

.ss-preview { display: flex; flex-direction: column; gap: 6rpx; margin: 12rpx 8rpx; padding: 18rpx; border-radius: 12rpx; background: rgba(0, 0, 0, 0.24); border: 1rpx solid rgba(196, 167, 108, 0.28); }
.ss-preview-label { font-size: 22rpx; color: var(--color-text-secondary, #a09a90); }
.ss-preview-value { font-size: 40rpx; font-weight: 600; color: #c4a76c; }
.ss-preview-value.is-pending { font-size: 26rpx; color: #e3a99e; }
.ss-preview-note { font-size: var(--fs-20); color: #e3a99e; }

.ss-problems { margin: 0 8rpx 12rpx; display: flex; flex-direction: column; gap: 6rpx; }
.ss-problems text { font-size: 22rpx; color: #e3a99e; line-height: 1.5; }

.ss-group { margin-bottom: 14rpx; background: rgba(0, 0, 0, 0.2); border: 1rpx solid rgba(77, 64, 26, 0.44); border-radius: 14rpx; overflow: hidden; }
.ss-group-head { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 22rpx; }
.ss-group-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ss-group-thumb { width: 72rpx; height: 72rpx; flex-shrink: 0; margin-right: 16rpx; border-radius: 10rpx; background: rgba(0, 0, 0, 0.25); border: 1rpx solid rgba(196, 167, 108, 0.28); }
.ss-group-name { font-size: 28rpx; color: var(--color-text-primary, #f2ece1); }
.ss-group-meta { font-size: var(--fs-20); color: #7d786f; }
.ss-group-count { font-size: var(--fs-22); color: #c4a76c; }
.ss-group-hint { padding: 0 22rpx 18rpx; }
.ss-group-hint text { font-size: var(--fs-20); color: #7d786f; }
.ss-options { padding: 0 14rpx 14rpx; }
.ss-option { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 18rpx; margin-top: 8rpx; background: rgba(196, 167, 108, 0.08); border: 1rpx solid rgba(196, 167, 108, 0.26); border-radius: 10rpx; }
.ss-option-name { flex: 1; font-size: 26rpx; color: var(--color-text-primary, #f2ece1); }
.ss-option-price { font-size: var(--fs-24); color: #c4a76c; }
.ss-option-tag { font-size: 19rpx; color: #221e17; background: #c4a76c; border-radius: 6rpx; padding: 2rpx 8rpx; }
