@import "../index.wxss";

/* 全部私信详情统一博物纸信签；页底仍 Museum Dark。回执用略深暖纸 + 绿灯区分馆讯。
   iPhone / 全面屏：不用 flex:1 + height:0。page → 根节点 → 信签层给明确高度，
   scroll-view 用 calc，避免中间信签高度塌成 0。 */

page {
  height: 100vh;
  height: 100%;
  overflow: hidden;
}

.page-msg.detail-root {
  height: 100vh;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.paper-mode.letter-page.standalone {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
  opacity: 1;
  pointer-events: auto;
  transform: none;
  z-index: 1;
}

.standalone .letter-scroll {
  flex: none;
  width: 100%;
  min-height: 420rpx;
  height: calc(100vh - 400rpx);
  height: calc(100% - 400rpx);
  box-sizing: border-box;
}

.standalone .letter-actions {
  flex: none;
  flex-shrink: 0;
  position: relative;
  z-index: 6;
  background: var(--color-bg);
}

.standalone .letter-card.paper {
  min-height: 520rpx;
}

.standalone .paper-fiber {
  mix-blend-mode: normal;
}

.letter-stage {
  width: 100%;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.letter-stage .letter-card {
  margin: 0;
}

.paper-stage .letter-card.paper {
  overflow: hidden;
  background: #F2EDE4;
  border: 1px solid var(--gold);
  border-radius: var(--radius-lg, 24rpx);
  transform: translateY(16rpx);
  opacity: 0.88;
  box-shadow:
    0 18rpx 36rpx rgba(26, 24, 20, 0.42),
    0 4rpx 10rpx rgba(26, 24, 20, 0.28),
    inset 0 0 0 7rpx #FAF6ED,
    inset 0 0 0 9rpx var(--gold),
    inset 0 0 0 12rpx #FAF6ED,
    inset 0 -16rpx 22rpx rgba(139, 111, 71, 0.07);
}

.paper-stage .letter-card.paper-receipt,
.paper-stage .letter-card.paper-notice {
  background: #EDE6D8;
  box-shadow:
    0 18rpx 36rpx rgba(26, 24, 20, 0.42),
    0 4rpx 10rpx rgba(26, 24, 20, 0.28),
    inset 0 0 0 7rpx #F2EDE4,
    inset 0 0 0 9rpx var(--gold),
    inset 0 0 0 12rpx #F2EDE4,
    inset 0 -16rpx 22rpx rgba(139, 111, 71, 0.1);
}

.paper-stage.entered .letter-card.paper.settled {
  transform: translateY(0);
  opacity: 1;
  transition:
    transform 0.4s ease,
    opacity 0.4s ease,
    box-shadow 0.4s ease;
}

.paper-plate-outer {
  position: absolute;
  inset: 14rpx;
  border: 1px solid rgba(196, 167, 108, 0.28);
  border-radius: 12rpx;
  pointer-events: none;
  z-index: 1;
}

.kind-receipt .paper-plate-outer {
  border-color: rgba(82, 183, 136, 0.22);
}

.paper-laid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.22;
  background-image: repeating-linear-gradient(
    0deg,
    rgba(139, 111, 71, 0.07) 0,
    rgba(139, 111, 71, 0.07) 1rpx,
    transparent 1rpx,
    transparent 9rpx
  );
}

.paper-fiber {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.11;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.35' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}

.paper-fiber.fine {
  opacity: 0.07;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='2.1' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}

.paper-wear {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  background:
    radial-gradient(28rpx 22rpx at 10rpx 10rpx, rgba(139, 111, 71, 0.14), transparent 72%),
    radial-gradient(24rpx 20rpx at calc(100% - 12rpx) 14rpx, rgba(77, 64, 26, 0.12), transparent 70%),
    radial-gradient(26rpx 20rpx at 14rpx calc(100% - 10rpx), rgba(139, 111, 71, 0.1), transparent 74%),
    radial-gradient(22rpx 18rpx at calc(100% - 10rpx) calc(100% - 12rpx), rgba(77, 64, 26, 0.1), transparent 70%),
    linear-gradient(180deg, rgba(250, 246, 237, 0.38) 0%, transparent 16%, transparent 84%, rgba(139, 111, 71, 0.08) 100%);
}

.paper-crease {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 17%;
  width: 2rpx;
  pointer-events: none;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(139, 111, 71, 0) 0%,
    rgba(139, 111, 71, 0.18) 16%,
    rgba(196, 167, 108, 0.12) 48%,
    rgba(139, 111, 71, 0.14) 84%,
    rgba(139, 111, 71, 0) 100%
  );
}

.paper-fold {
  position: absolute;
  left: 0;
  right: 0;
  top: 36%;
  height: 2rpx;
  pointer-events: none;
  z-index: 1;
  background: linear-gradient(
    90deg,
    rgba(139, 111, 71, 0) 0%,
    rgba(139, 111, 71, 0.12) 18%,
    rgba(196, 167, 108, 0.1) 50%,
    rgba(139, 111, 71, 0.1) 82%,
    rgba(139, 111, 71, 0) 100%
  );
}

.paper-mode .letter-stamp {
  border: 1px dashed rgba(138, 117, 48, 0.55);
  background: rgba(250, 246, 237, 0.55);
}

.stamp-receipt {
  border-color: rgba(45, 90, 63, 0.35);
}

.paper-mode .letter-plate {
  position: relative;
  z-index: 2;
}

.paper-mode .letter-kicker {
  padding-right: 100rpx;
}

.paper-mode .signal-label {
  color: #8B6F47;
}

.paper-mode .lamp-brass.hollow {
  border-color: #6B5A24;
}

.paper-mode .letter-sender {
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: #8A7530;
}

.paper-mode .letter-title {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  color: #33302C;
  font-weight: 600;
}

.paper-mode .letter-time {
  color: #8B6F47;
}

.paper-mode .letter-rule {
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(196, 167, 108, 0.55) 12%,
    rgba(212, 188, 133, 0.7) 50%,
    rgba(196, 167, 108, 0.55) 88%,
    transparent 100%
  );
}

.paper-mode .letter-p {
  display: block;
  font-size: 28rpx;
  line-height: 1.95;
  color: #4A4540;
  margin-bottom: 8rpx;
}

.run {
  display: inline;
  font-size: 28rpx;
  line-height: 1.95;
}

.run-text {
  color: #4A4540;
  font-weight: 400;
}

.run-money {
  color: #8A7530;
  font-weight: 600;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
}

.run-coupon {
  color: #8A7530;
  font-weight: 600;
}

.run-points,
.run-balance {
  color: #2D5A3F;
  font-weight: 600;
}

.run-growth {
  color: #8B6F47;
  font-weight: 600;
}

.run-name {
  color: #8A7530;
  font-weight: 600;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
}

.run-date {
  color: #8B6F47;
  font-weight: 400;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
}

/* 店长订单备注（发货私信里的「馆员留言」）：整行加重，压在纸面上更醒目 */
.run-note {
  color: #8B6F47;
  font-weight: 600;
  background: rgba(196, 167, 108, 0.16);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  letter-spacing: 0.02em;
}

.letter-sum {
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  border: 1px solid rgba(196, 167, 108, 0.42);
  background: rgba(250, 246, 237, 0.7);
  border-radius: 8rpx;
}

.letter-sum-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.sum-label {
  font-size: 22rpx;
  color: #8B6F47;
  letter-spacing: 0.08em;
}

.sum-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D5A3F;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
}

/* 需求 10：信件商品卡（名称 + 图片 + 规格）—— 沿用信纸配色，做成「随信附件」的观感 */
.letter-goods {
  margin-top: 28rpx;
  padding: 18rpx 22rpx 8rpx;
  border: 1px solid rgba(196, 167, 108, 0.42);
  background: rgba(250, 246, 237, 0.7);
  border-radius: 8rpx;
}

.goods-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 14rpx;
  border-bottom: 1px dashed rgba(196, 167, 108, 0.42);
}

.goods-head-title {
  font-size: 22rpx;
  color: #8B6F47;
  letter-spacing: 0.08em;
}

.goods-head-count {
  font-size: 20rpx;
  color: #8B6F47;
  opacity: 0.75;
}

.goods-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.22);
}

.goods-row:last-child {
  border-bottom: none;
}

.goods-thumb {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 6rpx;
  background: rgba(45, 35, 20, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.32);
}

.goods-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-thumb-mark {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 22rpx;
  color: rgba(139, 111, 71, 0.7);
  letter-spacing: 0.08em;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  font-size: 26rpx;
  color: #2B2B2B;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-spec {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8B6F47;
}

.goods-spec-muted {
  opacity: 0.6;
}

.goods-qty {
  flex-shrink: 0;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 24rpx;
  color: #2D5A3F;
}

.letter-sign {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.sign-line {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 24rpx;
  color: #6B5A24;
  letter-spacing: 0.12em;
}

.sign-mark {
  font-size: 22rpx;
  color: #8B6F47;
  letter-spacing: 0.18em;
}

.kind-receipt .sign-mark {
  color: #2D5A3F;
}
