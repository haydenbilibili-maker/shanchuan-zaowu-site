@import "../index.wxss";

/* 全部私信详情统一博物纸信签；页底仍 Museum Dark。回执用略深暖纸 + 绿灯区分馆讯。
   iPhone / 全面屏：不用 flex:1 + height:0。page → 根节点 → 信签层给明确高度，
   scroll-view 用 calc，避免中间信签高度塌成 0。 */

page {
  height: 100vh;
  height: 100%;
  overflow: hidden;
}

.page-msg.detail-root {
  height: 100vh;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.paper-mode.letter-page.standalone {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
  opacity: 1;
  pointer-events: auto;
  transform: none;
  z-index: 1;
}

.standalone .letter-scroll {
  flex: none;
  width: 100%;
  min-height: 420rpx;
  height: calc(100vh - 400rpx);
  height: calc(100% - 400rpx);
  box-sizing: border-box;
}

.standalone .letter-actions {
  flex: none;
  flex-shrink: 0;
  position: relative;
  z-index: 6;
  background: var(--color-bg);
}

.standalone .letter-card.paper {
  min-height: 520rpx;
}

.letter-stage {
  width: 100%;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.letter-stage .letter-card {
  margin: 0;
}

.paper-stage .letter-card.paper {
  overflow: hidden;
  background: #F2EDE4;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-lg, 24rpx);
  transform: translateY(16rpx);
  opacity: 0.88;
  box-shadow:
    0 18rpx 36rpx rgba(26, 24, 20, 0.42),
    0 4rpx 10rpx rgba(26, 24, 20, 0.28),
    inset 0 0 0 7rpx #FAF6ED,
    inset 0 0 0 9rpx var(--color-primary),
    inset 0 0 0 12rpx #FAF6ED,
    inset 0 -16rpx 22rpx rgba(139, 111, 71, 0.07);
}

.paper-stage .letter-card.paper-receipt,
.paper-stage .letter-card.paper-notice {
  background: #EDE6D8;
  box-shadow:
    0 18rpx 36rpx rgba(26, 24, 20, 0.42),
    0 4rpx 10rpx rgba(26, 24, 20, 0.28),
    inset 0 0 0 7rpx #F2EDE4,
    inset 0 0 0 9rpx var(--color-primary),
    inset 0 0 0 12rpx #F2EDE4,
    inset 0 -16rpx 22rpx rgba(139, 111, 71, 0.1);
}

.paper-stage.entered .letter-card.paper.settled {
  transform: translateY(0);
  opacity: 1;
  transition:
    transform var(--dur-slow) var(--ease-standard), opacity var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard);
}

.paper-plate-outer {
  position: absolute;
  inset: 14rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-md);
  pointer-events: none;
  z-index: 1;
}

.kind-receipt .paper-plate-outer {
  border-color: rgba(82, 183, 136, 0.22);
}

.paper-mode .letter-plate {
  position: relative;
  z-index: 2;
}

.paper-mode .lamp-brass.hollow {
  border-color: #6B5A24;
}

.paper-mode .letter-sender {
  font-size: var(--fs-20);
  letter-spacing: 0.14em;
  color: #8A7530;
}

.paper-mode .letter-title {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  color: #33302C;
  font-weight: 600;
}

.paper-mode .letter-time {
  color: #8B6F47;
}

.paper-mode .letter-rule {
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(196, 167, 108, 0.55) 12%,
    rgba(212, 188, 133, 0.7) 50%,
    rgba(196, 167, 108, 0.55) 88%,
    transparent 100%
  );
}

.paper-mode .letter-p {
  display: block;
  font-size: var(--fs-28);
  line-height: 1.95;
  color: #4A4540;
  margin-bottom: 8rpx;
}

.run {
  display: inline;
  font-size: var(--fs-28);
  line-height: 1.95;
}

.run-text {
  color: #4A4540;
  font-weight: 400;
}

.run-money {
  color: #8A7530;
  font-weight: 600;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
}

.run-coupon {
  color: #8A7530;
  font-weight: 600;
}

.run-points,
.run-balance {
  color: #2D5A3F;
  font-weight: 600;
}

.run-growth {
  color: #8B6F47;
  font-weight: 600;
}

.run-name {
  color: #8A7530;
  font-weight: 600;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
}

.run-date {
  color: #8B6F47;
  font-weight: 400;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
}

/* 店长订单备注（发货私信里的「馆员留言」）：整行加重，压在纸面上更醒目 */
.run-note {
  color: var(--color-wood-on-tint);
  font-weight: 600;
  background: rgba(196, 167, 108, 0.16);
  border-radius: var(--radius-sm);
  padding: 2rpx 8rpx;
  letter-spacing: 0.02em;
}

.letter-sum {
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  background: rgba(250, 246, 237, 0.7);
  border-radius: var(--radius-sm);
}

.letter-sum-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.sum-label {
  font-size: var(--fs-22);
  color: #8B6F47;
  letter-spacing: 0.08em;
}

.sum-value {
  font-size: var(--fs-30);
  font-weight: 600;
  color: #2D5A3F;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
}

/* 需求 10：信件商品卡（名称 + 图片 + 规格）—— 沿用信纸配色，做成「随信附件」的观感 */
.letter-goods {
  margin-top: 28rpx;
  padding: 18rpx 22rpx 8rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  background: rgba(250, 246, 237, 0.7);
  border-radius: var(--radius-sm);
}

.goods-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 14rpx;
  border-bottom: 1px dashed rgba(196, 167, 108, 0.42);
}

.goods-head-title {
  font-size: var(--fs-22);
  color: #8B6F47;
  letter-spacing: 0.08em;
}

.goods-head-count {
  font-size: var(--fs-20);
  color: #8B6F47;
  opacity: 0.75;
}

.goods-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.22);
}

.goods-row:last-child {
  border-bottom: none;
}

.goods-thumb {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  background: rgba(45, 35, 20, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.32);
}

.goods-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-thumb-mark {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: var(--fs-22);
  color: rgba(139, 111, 71, 0.7);
  letter-spacing: 0.08em;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  font-size: var(--fs-26);
  color: #2B2B2B;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-spec {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: #8B6F47;
}

.goods-spec-muted {
  opacity: 0.6;
}

.goods-qty {
  flex-shrink: 0;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: var(--fs-24);
  color: #2D5A3F;
}

.letter-sign {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.sign-line {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: var(--fs-24);
  color: #6B5A24;
  letter-spacing: 0.12em;
}

.sign-mark {
  font-size: var(--fs-22);
  color: #8B6F47;
  letter-spacing: 0.18em;
}

.kind-receipt .sign-mark {
  color: #2D5A3F;
}

/* 发货包装图片（可选附件）：沿用商品卡的「随信附件」观感，做成可放大的一组实拍。
   字号与间距口径跟本文件/本页既有约定一致（rpx）；字号统一走 --fs-* 令牌。
   三列定宽网格：1rpx = 屏宽/750，卡片内可用宽约 606rpx，
   3×188 + 2×20 = 604 ≤ 606，故**只在卡片内换行、不溢出信纸**。 */
.letter-photos {
  margin-top: 28rpx;
  padding: 18rpx 22rpx 16rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  background: rgba(250, 246, 237, 0.7);
  border-radius: var(--radius-sm, 8rpx);
}

.photos-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 14rpx;
  border-bottom: 1px dashed rgba(196, 167, 108, 0.42);
}

.photos-head-title {
  font-size: var(--fs-22, 22rpx);
  color: #8B6F47;
  letter-spacing: 0.08em;
}

.photos-head-count {
  font-size: var(--fs-20, 20rpx);
  color: #8B6F47;
  opacity: 0.75;
}

.photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 18rpx 0 4rpx;
}

.photos-item {
  width: 188rpx;
  height: 188rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: rgba(45, 35, 20, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.32);
}

.photos-tip {
  display: block;
  font-size: var(--fs-20, 20rpx);
  color: #8B6F47;
  opacity: 0.8;
}

/* ── 每日日报（letter-digest）─────────────────────────────────────────────
   只在 type=daily_digest 且带 payload 的消息上出现，其余信件完全不受影响。
   字号一律走 --fs-* 令牌、间距走 --space-*（仓内硬性约定，勿写字面量）。 */
.letter-digest {
  margin-top: var(--space-4, 32rpx);
  padding-top: var(--space-3, 24rpx);
  border-top: 1rpx dashed rgba(196, 167, 108, 0.42);
}

.dg-head {
  display: flex;
  flex-direction: column;
  gap: var(--space-1, 8rpx);
  margin-bottom: var(--space-3, 24rpx);
}

.dg-head-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2, 16rpx);
}

.dg-title {
  font-size: var(--fs-30, 30rpx);
  font-weight: 600;
  color: #2D2314;
}

.dg-role {
  font-size: var(--fs-20, 20rpx);
  color: #8B6F47;
  opacity: 0.9;
}

.dg-generated {
  font-size: var(--fs-18, 18rpx);
  color: #8B6F47;
  opacity: 0.8;
  font-variant-numeric: tabular-nums;
}

.dg-head-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dg-dayline {
  font-size: var(--fs-20, 20rpx);
  color: #8B6F47;
  opacity: 0.9;
}

.dg-health {
  margin-top: var(--space-2, 16rpx);
  padding: 10rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(45, 35, 20, 0.1);
  background: rgba(196, 167, 108, 0.08);
}

.dg-health-label {
  display: block;
  font-size: var(--fs-22, 22rpx);
  font-weight: 600;
  color: #6B5A24;
}

.dg-health-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dg-health-lamp {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-success);
  flex-shrink: 0;
}
.dg-health-lamp.tone-failed { background: #C4A06A; }
.dg-health-lamp.tone-partial { background: var(--color-primary); }
.dg-health-lamp.tone-ok { background: var(--color-success); }

.dg-health-summary {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-18, 18rpx);
  color: #8B6F47;
}

.dg-health.tone-failed {
  border-color: rgba(138, 90, 43, 0.4);
  background: rgba(138, 90, 43, 0.08);
}
.dg-health.tone-failed .dg-health-label {
  color: #8A5A2B;
}

.dg-health.tone-partial {
  border-color: rgba(196, 167, 108, 0.4);
}

.dg-health.tone-ok {
  border-color: rgba(82, 183, 136, 0.3);
  background: rgba(82, 183, 136, 0.06);
}
.dg-health.tone-ok .dg-health-label {
  color: #2D6A4F;
}

.dg-sec-count {
  font-size: var(--fs-18, 18rpx);
  color: #8B6F47;
  opacity: 0.9;
  flex-shrink: 0;
}
.dg-sec-count.tone-failed {
  color: #8A5A2B;
}

.dg-tool {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(139, 111, 71, 0.35);
  background: rgba(250, 246, 237, 0.65);
}
.dg-tool text {
  font-size: var(--fs-20, 20rpx);
  color: #6B5A24;
}

.letter-digest-missing {
  margin-top: var(--space-4, 32rpx);
  padding: var(--space-3, 24rpx);
  border-radius: var(--radius-sm);
  border: 1rpx dashed rgba(138, 90, 43, 0.4);
  background: rgba(138, 90, 43, 0.06);
}
.dgm-title {
  display: block;
  font-size: var(--fs-24, 24rpx);
  font-weight: 600;
  color: #8A5A2B;
  margin-bottom: 8rpx;
}
.dgm-desc {
  display: block;
  font-size: var(--fs-20, 20rpx);
  color: #8B6F47;
  line-height: 1.45;
}

.dg-alert {
  margin-bottom: var(--space-3, 24rpx);
  padding: var(--space-2, 16rpx);
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(138, 90, 43, 0.35);
  background: rgba(138, 90, 43, 0.08);
}

.dg-alert-text {
  font-size: var(--fs-20, 20rpx);
  color: #8A5A2B;
  line-height: 1.45;
}

.dg-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2, 16rpx);
  margin-bottom: var(--space-3, 24rpx);
}

.dg-hi {
  flex: 1 1 28%;
  min-width: 160rpx;
  padding: var(--space-2, 16rpx);
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(45, 35, 20, 0.1);
  background: rgba(196, 167, 108, 0.08);
  box-sizing: border-box;
}

.dg-hi-label {
  display: block;
  font-size: var(--fs-18, 18rpx);
  color: #8B6F47;
}

.dg-hi-value {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-28, 28rpx);
  font-weight: 600;
  color: #2D2314;
  font-variant-numeric: tabular-nums;
}

.dg-hi.is-missing .dg-hi-value {
  font-weight: 400;
  color: #8B6F47;
  opacity: 0.65;
}

.dg-hi.is-failed {
  border-color: rgba(138, 90, 43, 0.4);
  background: rgba(138, 90, 43, 0.08);
}

.dg-hi.is-primary {
  flex: 1 1 100%;
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.14);
}

.dg-hi-kicker {
  display: block;
  font-size: var(--fs-18, 18rpx);
  color: #8B6F47;
  letter-spacing: 0.08em;
  margin-bottom: 4rpx;
}

.dg-hi.is-primary .dg-hi-value {
  font-size: var(--fs-34, 34rpx);
}

.dg-sec-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: var(--space-2, 16rpx);
}

.dg-tool.ghost {
  background: transparent;
  border-color: rgba(139, 111, 71, 0.25);
}

.dg-section {
  margin-bottom: var(--space-3, 24rpx);
  padding: 4rpx 0 0;
  border-radius: var(--radius-sm);
}

.dg-section.tone-failed {
  background: rgba(138, 90, 43, 0.05);
  padding: 8rpx 10rpx;
}

.dg-sec-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: var(--space-2, 16rpx);
}

.dg-sec-lamp {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #7CB592;
  flex-shrink: 0;
}
.dg-sec-lamp.tone-failed {
  background: #C4A06A;
}
.dg-sec-lamp.tone-partial {
  background: var(--color-primary);
}
.dg-sec-lamp.tone-ok {
  background: var(--color-success);
}

.dg-sec-title {
  display: block;
  font-size: var(--fs-24, 24rpx);
  font-weight: 600;
  color: #6B5A24;
  flex: 1;
  min-width: 0;
}

.dg-sec-chevron {
  font-size: var(--fs-18, 18rpx);
  color: #8B6F47;
  flex-shrink: 0;
}

.dg-sec-collapsed {
  padding: 8rpx 0 12rpx;
}
.dg-sec-collapsed text {
  font-size: var(--fs-20, 20rpx);
  color: #8B6F47;
  opacity: 0.85;
}

.standalone .letter-actions.digest-actions {
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(196, 167, 108, 0.22);
}

.dg-row {
  padding: var(--space-2, 16rpx) 0;
  border-bottom: 1rpx solid rgba(45, 35, 20, 0.06);
}

.dg-row:last-child {
  border-bottom: none;
}

.dg-row.row-failed {
  background: rgba(138, 90, 43, 0.04);
  margin: 0 -8rpx;
  padding-left: 8rpx;
  padding-right: 8rpx;
  border-radius: var(--radius-sm);
}

.dg-row-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2, 16rpx);
}

.dg-label {
  font-size: var(--fs-24, 24rpx);
  color: #4A3F2E;
}

.dg-value {
  font-size: var(--fs-28, 28rpx);
  font-weight: 600;
  color: #2D2314;
  font-variant-numeric: tabular-nums;
}

/* 「当日无数据」与「数字确实是 0」必须一眼可分 —— 前者是灰的，后者是正常字重 */
.dg-value.is-missing {
  font-weight: 400;
  color: #8B6F47;
  opacity: 0.65;
}

.dg-value.is-failed {
  font-weight: 600;
  color: #8A5A2B;
}

.dg-row-note {
  display: block;
  margin-top: var(--space-1, 8rpx);
  font-size: var(--fs-18, 18rpx);
  color: #8B6F47;
  opacity: 0.85;
}

.dg-caveat {
  display: block;
  margin-top: var(--space-1, 8rpx);
  font-size: var(--fs-18, 18rpx);
  color: #8A5A2B;
  opacity: 0.9;
}

.dg-split {
  margin-top: var(--space-1, 8rpx);
  padding-left: var(--space-2, 16rpx);
  border-left: 2rpx solid rgba(196, 167, 108, 0.45);
}

.dg-split-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2, 16rpx);
  padding: 4rpx 0;
}

.dg-split-name {
  font-size: var(--fs-22, 22rpx);
  color: #6B5A45;
}

.dg-split-val {
  font-size: var(--fs-24, 24rpx);
  color: #2D2314;
  font-variant-numeric: tabular-nums;
}

.dg-foot {
  margin-top: var(--space-3, 24rpx);
  padding-top: var(--space-2, 16rpx);
  border-top: 1rpx solid rgba(45, 35, 20, 0.06);
}

.dg-note {
  display: block;
  font-size: var(--fs-18, 18rpx);
  color: #8B6F47;
  opacity: 0.85;
  line-height: 1.5;
}

.dg-note.warn {
  margin-top: var(--space-1, 8rpx);
  color: #8A5A2B;
  opacity: 0.95;
}

/* ── 信笺（2026-10-17 第二轮重构）──────────────────────────────────────
   与证书 / 礼笺 / 心愿签同一种纸：浅纸渐变 + 墨色 + 内发丝框 + 顶边铜别针 + 方寸印。
   纤维 / 压纹 / 磨损 / 折痕 / 折角节点与三枚信号灯已从模板移除；日报正文版式不变。 */
.paper-stage .letter-card.paper,
.paper-stage .letter-card.paper-receipt,
.paper-stage .letter-card.paper-notice {
  position: relative;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border: none;
  border-radius: 4rpx;
  /* 内边距写在这里（不靠 @import 进来的列表页 .letter-card），纸边与内发丝框之间留足呼吸 */
  padding: 56rpx 44rpx 48rpx;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.45);
}

.paper-mode .paper-plate-outer,
.kind-receipt .paper-plate-outer {
  inset: 16rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  border-radius: 0;
}

.letter-pin {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: #B08D57;
  z-index: 3;
}

/* 方寸印：类别（回执 / 通知 / 馆方 / 日报），墨铜底刻纸色字 */
.letter-seal {
  position: absolute;
  top: 44rpx;
  right: 44rpx;
  z-index: 3;
  min-width: 64rpx;
  height: 64rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #B08D57;
  border-radius: 4rpx;
  transform: rotate(-6deg);
}

.letter-seal text {
  font-family: var(--font-brand);
  font-size: var(--fs-22);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
}

.letter-seal.seal-campaign { background: #9E3B2E; }
.letter-seal.seal-digest { background: #5E7A93; }

.paper-mode .letter-plate {
  padding-top: 24rpx;
}

.letter-eyebrow {
  display: block;
  padding-right: 120rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.18em;
  color: #8B6F47;
}

.paper-mode .letter-sender {
  display: block;
  margin-top: 20rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.12em;
  color: #8A7F6C;
}

.paper-mode .letter-title {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-36);
  line-height: 1.4;
  color: #2E2618;
}

.paper-mode .letter-time {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: #8A7F6C;
}

.paper-mode .letter-rule {
  height: 1rpx;
  margin: 28rpx 0;
  background: rgba(46, 38, 24, 0.22);
}

.paper-mode .letter-p,
.run-text {
  color: #3E3626;
}

.sign-line { color: #2E2618; }
.sign-mark { color: #8B6F47; }

/* ── 拆信仪式（2026-10-18）────────────────────────────────────────────
   未读纸信：信封封着 → 掀封口 → 信纸从信封里抽出、信封沉下退场。只在亲手打开未读信时播；已读信直接展开。 */
.letter-stage { position: relative; }
.unseal-envelope {
  position: absolute;
  top: 60rpx;
  left: 64rpx;
  right: 64rpx;
  height: 340rpx;
  z-index: 8;
  perspective: 1200rpx;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s ease 0.1s;
}
.ue-body {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 36rpx 36rpx;
  background: linear-gradient(180deg, #E6DAC2, #D9CAAD);
  border-radius: 6rpx;
  box-shadow: inset 0 0 0 1rpx rgba(46, 38, 24, 0.18), 0 20rpx 44rpx rgba(0, 0, 0, 0.5);
}
.ue-from {
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  letter-spacing: 0.12em;
  color: #2E2618;
}
.ue-en {
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: #8B6F47;
}
/* 封口：上沿铰链的三角，掀开即绕 X 轴翻到背后 */
.ue-flap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(180deg, #DDD0B5, #CFBE9C);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  transform-origin: 50% 0;
  transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
}
.ue-wax {
  position: absolute;
  top: 164rpx;
  left: 50%;
  width: 72rpx;
  height: 72rpx;
  margin-left: -36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 34%, #B5483A, #8E2F24 70%);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
  transition: transform 0.3s ease, opacity 0.3s ease;
}
.ue-wax text {
  font-family: var(--font-brand);
  font-size: var(--fs-20);
  font-weight: 600;
  color: #F3ECDD;
}
.unseal-open .ue-flap,
.unseal-out .ue-flap { transform: rotateX(180deg); }
.unseal-open .ue-wax,
.unseal-out .ue-wax { opacity: 0; transform: scale(1.3); }
.unseal-out .unseal-envelope { transform: translateY(240rpx); opacity: 0; }
/* 封着 / 掀口时信纸藏在信封里；抽出时沿用 .entered .settled 的上浮过渡 */
.letter-stage.paper-stage.unseal-sealed .letter-card.settled,
.letter-stage.paper-stage.unseal-open .letter-card.settled,
.letter-stage.paper-stage.unseal-sealed .letter-card,
.letter-stage.paper-stage.unseal-open .letter-card {
  opacity: 0;
  transform: translateY(120rpx) scale(0.94);
}
.letter-stage.paper-stage.unseal-out .letter-card.settled {
  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.3, 1), opacity 0.4s ease;
}
@media (prefers-reduced-motion: reduce) {
  .unseal-envelope { display: none; }
  .letter-stage.paper-stage.unseal-sealed .letter-card.settled,
  .letter-stage.paper-stage.unseal-open .letter-card.settled { opacity: 1; transform: none; }
}
