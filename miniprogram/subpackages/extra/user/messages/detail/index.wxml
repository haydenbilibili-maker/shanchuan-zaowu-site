<!--subpackages/extra/user/messages/detail/index.wxml-->
<view class="page-msg detail-root">
  <view class="grain-overlay"></view>

  <view class="letter-page visible standalone paper-mode kind-{{selectedMessage.kind}}" wx:if="{{selectedMessage._id}}">
    <scroll-view
      scroll-y
      class="letter-scroll"
      style="{{scrollStyle}}"
    >
      <view class="letter-stage paper-stage kind-{{selectedMessage.kind}} {{entered ? 'entered' : ''}}">
        <view class="letter-card paper paper-{{selectedMessage.kind}} {{entered ? 'settled' : ''}}">
          <view class="paper-plate-outer"></view>
          <view class="paper-laid"></view>
          <view class="paper-fiber"></view>
          <view class="paper-fiber fine"></view>
          <view class="paper-wear"></view>
          <view class="paper-crease"></view>
          <view class="paper-fold"></view>
          <view class="letter-stamp stamp-{{selectedMessage.kind}}">
            <text class="stamp-en">{{selectedMessage.stampEn}}</text>
            <text class="stamp-cn">{{selectedMessage.stampCn}}</text>
          </view>

          <view class="letter-plate">
            <view class="letter-kicker">
              <view class="signal-row">
                <view class="lamp {{selectedMessage.readLampClass}}"></view>
                <text class="signal-label">{{selectedMessage.readLabel}}</text>
              </view>
              <view class="signal-row">
                <view class="lamp {{selectedMessage.kindLampClass}}"></view>
                <text class="signal-label">{{selectedMessage.kindLabel}}</text>
              </view>
              <view class="signal-row">
                <view class="lamp {{selectedMessage.statusLampClass}}"></view>
                <text class="signal-label">{{selectedMessage.statusLabel}}</text>
              </view>
            </view>

            <text class="letter-sender">{{selectedMessage.senderName}}</text>
            <text class="letter-title">{{selectedMessage.title}}</text>
            <text class="letter-time">{{selectedMessage.formattedTime}} · {{selectedMessage.typeName}}</text>
            <view class="letter-rule"></view>
            <view class="letter-body">
              <text
                class="letter-p"
                wx:for="{{selectedMessage.bodyBlocks}}"
                wx:key="id"
              >
                <text
                  wx:for="{{item.runs}}"
                  wx:for-item="run"
                  wx:key="rid"
                  class="run run-{{run.type}}"
                >{{run.text}}</text>
              </text>
            </view>
            <view class="letter-sum" wx:if="{{selectedMessage.summaries.length}}">
              <view class="letter-sum-row" wx:for="{{selectedMessage.summaries}}" wx:key="id">
                <text class="sum-label">{{item.label}}</text>
                <text class="sum-value">{{item.value}}</text>
              </view>
            </view>
            <!-- 需求 10：信件商品卡 —— 名称 + 图片 + 规格 -->
            <view class="letter-goods" wx:if="{{selectedMessage.hasProductCards}}">
              <view class="goods-head">
                <text class="goods-head-title">信中藏品</text>
                <text class="goods-head-count">{{selectedMessage.productCards.length}} 项</text>
              </view>
              <view class="goods-row" wx:for="{{selectedMessage.productCards}}" wx:key="id">
                <image
                  wx:if="{{item.hasImage}}"
                  class="goods-thumb"
                  src="{{item.image}}"
                  mode="aspectFill"
                  lazy-load
                ></image>
                <view class="goods-thumb goods-thumb-empty" wx:else>
                  <text class="goods-thumb-mark">山海</text>
                </view>
                <view class="goods-main">
                  <text class="goods-name">{{item.title}}</text>
                  <text class="goods-spec" wx:if="{{item.hasSku}}">规格 · {{item.skuLabel}}</text>
                  <text class="goods-spec goods-spec-muted" wx:else>规格 · 单件</text>
                </view>
                <text class="goods-qty" wx:if="{{item.countText}}">{{item.countText}}</text>
              </view>
            </view>
            <view class="letter-sign">
              <text class="sign-line">{{selectedMessage.senderName}}</text>
              <text class="sign-mark">{{selectedMessage.signOff}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="letter-actions on-paper">
      <button
        class="btn-primary"
        bindtap="handleAction"
        wx:if="{{selectedMessage.hasAction}}"
      >{{selectedMessage.actionLabel || '前往相关页'}}</button>
      <button class="btn-secondary" bindtap="leaveLetter">返回信箱</button>
      <view class="letter-delete" bindtap="deleteMessage">从信箱移除</view>
    </view>
  </view>

  <view class="empty-state" wx:elif="{{loadError}}">
    <view class="empty-lamps">
      <view class="lamp lamp-warning"></view>
    </view>
    <text class="empty-text">这封信暂时读不到</text>
    <text class="empty-desc">请先回到信箱，稍后再打开。</text>
    <view class="retry-btn" hover-class="retry-btn-press" hover-stay-time="80" bindtap="leaveLetter">返回信箱</view>
  </view>
</view>
