<!--subpackages/extra/user/messages/detail/index.wxml-->
<view class="page-msg detail-root">
  <view class="grain-overlay"></view>

  <view class="letter-page visible standalone paper-mode kind-{{selectedMessage.kind}}" wx:if="{{selectedMessage._id}}">
    <scroll-view
      scroll-y
      class="letter-scroll"
      style="{{scrollStyle}}"
    >
      <view class="letter-stage paper-stage kind-{{selectedMessage.kind}} {{entered ? 'entered' : ''}}">
        <view class="letter-card paper paper-{{selectedMessage.kind}} {{entered ? 'settled' : ''}}">
          <view class="paper-plate-outer"></view>
          <view class="paper-laid"></view>
          <view class="paper-fiber"></view>
          <view class="paper-fiber fine"></view>
          <view class="paper-wear"></view>
          <view class="paper-crease"></view>
          <view class="paper-fold"></view>
          <view class="letter-stamp stamp-{{selectedMessage.kind}}">
            <text class="stamp-en">{{selectedMessage.stampEn}}</text>
            <text class="stamp-cn">{{selectedMessage.stampCn}}</text>
          </view>

          <view class="letter-plate">
            <view class="letter-kicker">
              <view class="signal-row">
                <view class="lamp {{selectedMessage.readLampClass}}"></view>
                <text class="signal-label">{{selectedMessage.readLabel}}</text>
              </view>
              <view class="signal-row">
                <view class="lamp {{selectedMessage.kindLampClass}}"></view>
                <text class="signal-label">{{selectedMessage.kindLabel}}</text>
              </view>
              <view class="signal-row">
                <view class="lamp {{selectedMessage.statusLampClass}}"></view>
                <text class="signal-label">{{selectedMessage.statusLabel}}</text>
              </view>
            </view>

            <text class="letter-sender">{{selectedMessage.senderName}}</text>
            <text class="letter-title">{{selectedMessage.title}}</text>
            <text class="letter-time">{{selectedMessage.formattedTime}} · {{selectedMessage.typeName}}</text>
            <view class="letter-rule"></view>
            <!-- 有结构化日报时，纯文本正文让位（避免与关键数重复）；无 payload 时仍显示正文兜底 -->
            <view class="letter-body" wx:if="{{!digestView}}">
              <text
                class="letter-p"
                wx:for="{{selectedMessage.bodyBlocks}}"
                wx:key="id"
              >
                <text
                  wx:for="{{item.runs}}"
                  wx:for-item="run"
                  wx:key="rid"
                  class="run run-{{run.type}}"
                >{{run.text}}</text>
              </text>
            </view>
            <view class="letter-sum" wx:if="{{!digestView && selectedMessage.summaries.length}}">
              <view class="letter-sum-row" wx:for="{{selectedMessage.summaries}}" wx:key="id">
                <text class="sum-label">{{item.label}}</text>
                <text class="sum-value">{{item.value}}</text>
              </view>
            </view>
            <!-- 需求 10：信件商品卡 —— 名称 + 图片 + 规格 -->
            <view class="letter-goods" wx:if="{{selectedMessage.hasProductCards}}">
              <view class="goods-head">
                <text class="goods-head-title">信中藏品</text>
                <text class="goods-head-count">{{selectedMessage.productCards.length}} 项</text>
              </view>
              <view class="goods-row" wx:for="{{selectedMessage.productCards}}" wx:key="id">
                <image
                  wx:if="{{item.hasImage}}"
                  class="goods-thumb"
                  src="{{item.image}}"
                  mode="aspectFill"
                  lazy-load
                ></image>
                <view class="goods-thumb goods-thumb-empty" wx:else>
                  <text class="goods-thumb-mark">山海</text>
                </view>
                <view class="goods-main">
                  <text class="goods-name">{{item.title}}</text>
                  <text class="goods-spec" wx:if="{{item.hasSku}}">规格 · {{item.skuLabel}}</text>
                  <text class="goods-spec goods-spec-muted" wx:else>规格 · 单件</text>
                </view>
                <text class="goods-qty" wx:if="{{item.countText}}">{{item.countText}}</text>
              </view>
            </view>
            <!-- 发货包装图片（可选附件）：馆员发货时留档的实拍，随「山海有信」一起给到顾客。
                 非必须 —— hasPackagePhotos 为 false 时整块不出现，老信与「这次没传图」完全一样。 -->
            <view class="letter-photos" wx:if="{{selectedMessage.hasPackagePhotos}}">
              <view class="photos-head">
                <text class="photos-head-title">包装实拍</text>
                <text class="photos-head-count" wx:if="{{selectedMessage.packagePhotoCountText}}">{{selectedMessage.packagePhotoCountText}}</text>
              </view>
              <view class="photos-grid">
                <image
                  class="photos-item"
                  wx:for="{{selectedMessage.packagePhotos}}"
                  wx:key="*this"
                  src="{{item}}"
                  mode="aspectFill"
                  data-src="{{item}}"
                  bindtap="previewPackagePhoto"
                  lazy-load
                ></image>
              </view>
              <text class="photos-tip">这是这件的打包留影；点击可放大查看。</text>
            </view>
            <!-- 每日日报：结构化正文 + 每个数字的**口径与来源**。
                 digestView 只在 type=daily_digest 且带 payload 时非空；
                 非日报消息整块不出现 —— 与老信完全一致，不改变既有版式。 -->
            <view class="letter-digest" wx:if="{{digestView}}">
              <view class="dg-head">
                <view class="dg-head-main">
                  <text class="dg-title">{{digestView.title}}</text>
                  <text class="dg-role" wx:if="{{digestView.roleLabel}}">{{digestView.roleLabel}}</text>
                </view>
                <view class="dg-head-meta">
                  <text class="dg-dayline" wx:if="{{digestView.dayLine}}">{{digestView.dayLine}}</text>
                  <text class="dg-generated" wx:if="{{digestView.generatedAtText}}">生成 {{digestView.generatedAtText}}</text>
                </view>
                <view class="dg-health tone-{{digestView.healthTone}}" wx:if="{{digestView.healthLabel}}">
                  <view class="dg-health-row">
                    <view class="dg-health-lamp tone-{{digestView.healthTone}}"></view>
                    <text class="dg-health-label">{{digestView.healthLabel}}</text>
                  </view>
                  <text class="dg-health-summary">{{digestView.countNote}}</text>
                </view>
              </view>

              <view class="dg-alert" wx:if="{{digestView.failedCount > 0}}">
                <text class="dg-alert-text">{{digestView.failedNote}}</text>
              </view>

              <view class="dg-highlights" wx:if="{{digestView.hasHighlights}}">
                <view
                  class="dg-hi {{m.primary ? 'is-primary' : ''}} {{m.failed ? 'is-failed' : ''}} {{m.missing ? 'is-missing' : ''}}"
                  wx:for="{{digestView.highlights}}"
                  wx:for-item="m"
                  wx:key="id"
                >
                  <text class="dg-hi-kicker" wx:if="{{m.primary}}">关键</text>
                  <text class="dg-hi-label">{{m.label}}</text>
                  <text class="dg-hi-value">{{m.valueText}}</text>
                </view>
              </view>

              <view class="dg-sec-tools" wx:if="{{digestView.sections.length > 1}}">
                <view class="dg-tool ghost" bindtap="expandAllDigestSections" hover-class="tap-press" hover-stay-time="80">
                  <text>全部展开</text>
                </view>
                <view class="dg-tool ghost" bindtap="collapseOkDigestSections" hover-class="tap-press" hover-stay-time="80">
                  <text>收起正常组</text>
                </view>
              </view>

              <view class="dg-section tone-{{sec.healthTone}} {{sectionCollapsed[sec.key] ? 'is-collapsed' : ''}}" wx:for="{{digestView.sections}}" wx:for-item="sec" wx:key="key">
                <view
                  class="dg-sec-head"
                  bindtap="toggleDigestSection"
                  data-key="{{sec.key}}"
                  hover-class="tap-press"
                  hover-stay-time="80"
                >
                  <view class="dg-sec-lamp tone-{{sec.healthTone}}"></view>
                  <text class="dg-sec-title">{{sec.label}}</text>
                  <text class="dg-sec-count tone-{{sec.healthTone}}">{{sec.countText}}</text>
                  <text class="dg-sec-chevron">{{sectionCollapsed[sec.key] ? '展开' : '收起'}}</text>
                </view>
                <view class="dg-sec-body" wx:if="{{!sectionCollapsed[sec.key]}}">
                  <view class="dg-row {{m.failed ? 'row-failed' : ''}}" wx:for="{{sec.metrics}}" wx:for-item="m" wx:key="id">
                    <view class="dg-row-top">
                      <text class="dg-label">{{m.label}}</text>
                      <text class="dg-value {{m.missing ? 'is-missing' : ''}} {{m.failed ? 'is-failed' : ''}}">{{m.valueText}}</text>
                    </view>
                    <view class="dg-split" wx:if="{{m.stores}}">
                      <view class="dg-split-row" wx:for="{{m.stores}}" wx:for-item="st" wx:key="storeId">
                        <text class="dg-split-name">{{st.name}}</text>
                        <text class="dg-split-val">{{st.valueText}}</text>
                      </view>
                    </view>
                    <text class="dg-caveat" wx:if="{{m.failedText}}">{{m.failedText}}</text>
                    <text class="dg-row-note" wx:if="{{m.note}}">{{m.note}}</text>
                  </view>
                  <text class="dg-caveat" wx:if="{{sec.storeNotice}}">{{sec.storeNotice}}</text>
                </view>
                <view class="dg-sec-collapsed" wx:else>
                  <text>{{sec.collapsedHint || '已收起'}}</text>
                </view>
              </view>

              <!-- 「复制摘要」只留底部操作栏一处（正文末尾曾重复一枚同功能按钮） -->
              <view class="dg-foot">
                <text class="dg-note">{{digestView.snapshotNote}}</text>
                <text class="dg-note" wx:if="{{digestView.generatedNote}}">{{digestView.generatedNote}}</text>
                <text class="dg-note warn" wx:if="{{digestView.missingNote}}">{{digestView.missingNote}}</text>
              </view>
            </view>

            <!-- 日报但无结构化 payload：诚实提示，不假装「没生意」 -->
            <view class="letter-digest-missing" wx:elif="{{digestPayloadMissing}}">
              <text class="dgm-title">本期只有文字版</text>
              <text class="dgm-desc">这期日报没有分项数字，请看上面的文字摘要。</text>
            </view>
            <view class="letter-sign">
              <text class="sign-line">{{selectedMessage.senderName}}</text>
              <text class="sign-mark">{{selectedMessage.signOff}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="letter-actions on-paper {{digestView ? 'digest-actions' : ''}}" style="{{actionPadStyle}}">
      <button
        class="btn-primary"
        bindtap="handleAction"
        wx:if="{{selectedMessage.hasAction && !digestView}}"
      >{{selectedMessage.actionLabel || '前往相关页'}}</button>
      <button class="btn-primary" bindtap="leaveLetter" wx:if="{{digestView}}">返回工作信息</button>
      <button class="btn-secondary" bindtap="shareDigestSheet" wx:if="{{digestView}}">复制摘要</button>
      <button class="btn-secondary" bindtap="leaveLetter" wx:elif="{{!digestView}}">返回信箱</button>
      <view class="letter-delete" bindtap="deleteMessage" hover-class="tap-press" hover-stay-time="80">{{digestView ? '移除本期日报' : '从信箱移除'}}</view>
    </view>
  </view>

  <view class="empty-state" wx:elif="{{letterLoading}}">
    <view class="empty-lamps">
      <view class="lamp lamp-info dim"></view>
    </view>
    <text class="empty-text">正在取信</text>
    <text class="empty-desc">稍候即可对账本期数字。</text>
  </view>

  <view class="empty-state" wx:elif="{{loadError}}">
    <view class="empty-lamps">
      <view class="lamp lamp-warning"></view>
    </view>
    <text class="empty-text">{{selectedMessage.isDigest || digestPayloadMissing ? '这份日报暂时读不到' : '这封信暂时读不到'}}</text>
    <text class="empty-desc">请先回到工作信息或信箱，稍后再打开。</text>
    <view class="retry-btn" hover-class="tap-press" hover-stay-time="80" bindtap="leaveLetter">返回列表</view>
  </view>
</view>
