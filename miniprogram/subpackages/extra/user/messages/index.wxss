/* subpackages/feature/user/messages/index.wxss */
page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-primary, #FFFFFF);
}

.page-msg {
  min-height: 100vh;
  position: relative;
  background: var(--color-bg, #1A1814);
}

.grain-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  z-index: 0;
}

/* —— 信号灯布局（色值见 app.wxss 全局 token） —— */
.lamp {
  width: 14rpx;
  height: 14rpx;
}

.lamp-col {
  width: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding-top: 8rpx;
  flex-shrink: 0;
}

.signal-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.signal-label {
  font-size: 20rpx;
  letter-spacing: 0.08em;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.status-chip text {
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
}

/* —— 顶栏 —— */
.sticky-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(26, 24, 20, 0.96);
  border-bottom: 1px solid rgba(38, 35, 32, 0.6);
  pointer-events: none;
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}

.sticky-header.tucked {
  opacity: 0;
  transform: translateY(-8rpx);
  pointer-events: none;
}

.sticky-header.tucked .toolbar,
.sticky-header.tucked .mark-read-btn,
.sticky-header.tucked .queue-tabs,
.sticky-header.tucked .queue-tab,
.sticky-header.tucked .filter-scroll,
.sticky-header.tucked .filter-row,
.sticky-header.tucked .filter-pill {
  pointer-events: none;
}

.sticky-header .toolbar,
.sticky-header .mark-read-btn,
.sticky-header .queue-tabs,
.sticky-header .queue-tab,
.sticky-header .workflow-context,
.sticky-header .filter-scroll,
.sticky-header .filter-row,
.sticky-header .filter-pill {
  pointer-events: auto;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 0;
  min-height: 56rpx;
  box-sizing: border-box;
}

.toolbar-meta {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.unread-hint {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  letter-spacing: 0.08em;
}

.unread-hint.muted {
  color: var(--color-text-muted, #6B6560);
}

.mark-read-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-full, 9999px);
  flex-shrink: 0;
  box-sizing: border-box;
}

.mark-read-btn:active { opacity: 0.82; }

.mark-read-btn text {
  font-size: 22rpx;
  line-height: 1;
  color: var(--brass-400, #C4A76C);
  font-weight: 500;
}

/* 顾客信息 | 工作流 */
.queue-tabs {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 8rpx 32rpx 0;
  box-sizing: border-box;
}
.queue-tab {
  flex: 1;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1px solid rgba(38, 35, 32, 0.85);
  border-radius: var(--radius-md, 16rpx);
  background: var(--color-bg-card, #1F1D1A);
  box-sizing: border-box;
}
.queue-tab.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.12);
}
.queue-tab.workflow.active {
  border-color: rgba(45, 90, 63, 0.7);
  background: rgba(45, 90, 63, 0.16);
}
.queue-tab-press { opacity: 0.85; transform: scale(0.98); }
.queue-tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
}
.queue-tab.active .queue-tab-label {
  color: var(--brass-400, #C4A76C);
}
.queue-tab.workflow.active .queue-tab-label {
  color: #7CB592;
}
/* 视觉走全局 .badge-solid-danger / .badge-info；此处仅保留间距 */
.queue-tab-badge {
  margin-left: 0;
}

.workflow-context {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 32rpx 0;
  box-sizing: border-box;
}
.workflow-context-text {
  font-size: 22rpx;
  color: #7CB592;
  letter-spacing: 0.06em;
}
.workflow-context.cat-digest .workflow-context-text {
  color: #8BA8C4;
}
.workflow-context.cat-ops .workflow-context-text {
  color: #7CB592;
}
.workflow-context.cat-system .workflow-context-text {
  color: #C4A76C;
}
/* 日报档顶栏 */
.digest-rail {
  margin: 8rpx 32rpx 0;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(139, 168, 196, 0.28);
  background: rgba(91, 143, 185, 0.08);
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.digest-rail-lamp {
  width: 12rpx;
  height: 12rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #8BA8C4;
  flex-shrink: 0;
}
.digest-rail-lamp.tip-warn { background: #C4A06A; }
.digest-rail-lamp.tip-partial { background: #C4A76C; }
.digest-rail-lamp.tip-ok { background: #52B788; }
.digest-rail-lamp.tip-muted { background: #6B6560; }
.digest-rail-text {
  font-size: 20rpx;
  color: #8BA8C4;
  line-height: 1.45;
  flex: 1;
  min-width: 0;
}
.digest-rail.tip-warn {
  border-color: rgba(168, 90, 43, 0.4);
  background: rgba(138, 90, 43, 0.1);
}
.digest-rail.tip-warn .digest-rail-text {
  color: #C4A06A;
}
.digest-rail.tip-partial {
  border-color: rgba(196, 167, 108, 0.35);
  background: rgba(196, 167, 108, 0.08);
}
.digest-rail.tip-partial .digest-rail-text {
  color: #C4A76C;
}
.digest-rail.tip-ok .digest-rail-text {
  color: #8BA8C4;
}
.digest-rail.tip-muted .digest-rail-text {
  color: var(--color-text-muted, #6B6560);
}

.sk-digest-chips {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 0 8rpx 8rpx;
}
.sk-chip {
  flex: 1;
  height: 56rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.04);
}

.filter-pill.workflow.active {
  border-color: rgba(45, 90, 63, 0.55);
  background: rgba(45, 90, 63, 0.14);
}
.filter-pill.workflow.active text {
  color: #7CB592;
}
/* 三分档各自色相：日报蓝 / 待办绿 / 审批铜 —— 只改视觉，不改 id/契约 */
.filter-pill.tab-digest.active {
  border-color: rgba(91, 143, 185, 0.55);
  background: rgba(91, 143, 185, 0.12);
}
.filter-pill.tab-digest.active text {
  color: #8BA8C4;
}
.filter-pill.tab-ops.active {
  border-color: rgba(45, 90, 63, 0.55);
  background: rgba(45, 90, 63, 0.14);
}
.filter-pill.tab-ops.active text {
  color: #7CB592;
}
.filter-pill.tab-system.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.12);
}
.filter-pill.tab-system.active text {
  color: #C4A76C;
}

.filter-pill-badge {
  margin-left: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.22);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.filter-pill-badge text {
  font-size: 18rpx;
  color: var(--brass-400, #C4A76C);
  font-weight: 600;
  line-height: 1;
}
.filter-pill.tab-digest .filter-pill-badge {
  background: rgba(91, 143, 185, 0.22);
}
.filter-pill.tab-digest .filter-pill-badge text {
  color: #8BA8C4;
}
.filter-pill.tab-ops .filter-pill-badge {
  background: rgba(45, 90, 63, 0.22);
}
.filter-pill.tab-ops .filter-pill-badge text {
  color: #7CB592;
}
.filter-pill.tab-system .filter-pill-badge {
  background: rgba(196, 167, 108, 0.22);
}
.filter-pill.tab-system .filter-pill-badge text {
  color: #C4A76C;
}

.page-msg.queue-workflow .unread-hint {
  color: #7CB592;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 16rpx 0 20rpx;
  height: 96rpx;
  box-sizing: border-box;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 32rpx;
  padding-right: 48rpx;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  border-radius: var(--radius-full, 9999px);
  border: 1px solid rgba(38, 35, 32, 0.8);
  background: var(--color-bg-card, #1F1D1A);
  transition: border-color var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
}

.filter-pill text {
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
  font-weight: 500;
}

.filter-pill.active {
  border-color: rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.12);
}

.filter-pill.active text {
  color: var(--brass-400, #C4A76C);
}

.filter-pill-press { opacity: 0.82; transform: scale(0.97); }

.filter-pad {
  display: inline-block;
  width: 32rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  box-sizing: border-box;
  transition: opacity var(--dur-base) var(--ease-standard);
}

.main-scroll.dimmed {
  opacity: 0.28;
  pointer-events: none;
}

.scroll-top-pad {
  height: 16rpx;
  flex-shrink: 0;
}

.skeleton-wrap {
  padding: 8rpx 32rpx 32rpx;
}

.sk-card {
  height: 176rpx;
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: 20rpx;
  background: var(--color-bg-card, #1F1D1A);
  display: flex;
  align-items: flex-start;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.sk-lamps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.sk-shine {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.04) 0%,
    rgba(196, 167, 108, 0.09) 50%,
    rgba(196, 167, 108, 0.04) 100%
  );
  background-size: 200% 100%;
  animation: shine 1.4s ease infinite;
}

@keyframes shine {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx;
  text-align: center;
}

.empty-lamps {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 20rpx 24rpx;
  margin-bottom: 36rpx;
  max-width: 560rpx;
}

.lamp-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.lamp-legend text {
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 0.06em;
}

.empty-text {
  font-size: 30rpx;
  color: var(--color-text-body, #D5D1C8);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.6;
}

.retry-btn {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border: 1px solid var(--gold);
  border-radius: 16rpx;
  color: var(--gold);
  font-size: 26rpx;
}


.message-list {
  padding: 8rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.message-item {
  position: relative;
  display: flex;
  gap: 16rpx;
  padding: 28rpx 28rpx 28rpx 28rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(38, 35, 32, 0.7);
  border-radius: var(--radius-lg, 24rpx);
  overflow: hidden;
  transition: border-color var(--dur-base) var(--ease-standard), background var(--dur-base) var(--ease-standard), opacity var(--dur-base) var(--ease-standard);
}

.message-item-press {
  opacity: 0.9;
  transform: scale(0.985);
}

.message-item.unread {
  border-color: rgba(196, 167, 108, 0.32);
}

.message-item.read {
  opacity: 0.88;
}

.message-item.read .message-title {
  color: var(--color-text-body, #D5D1C8);
  font-weight: 500;
}

.message-item.read .message-preview {
  color: var(--color-text-muted, #6B6560);
}

.item-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: transparent;
  transition: background var(--dur-base) var(--ease-standard);
}

.item-accent.on {
  background: var(--gold);
}

.message-body {
  flex: 1;
  min-width: 0;
}

.message-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.kind-tag {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.kind-tag.kind-campaign { color: #5B8FB9; }
.kind-tag.kind-receipt { color: #52B788; }
.kind-tag.kind-notice { color: #5B8FB9; }
.kind-tag.kind-workflow { color: #7CB592; }
.kind-tag.kind-digest { color: #8BA8C4; }

.message-item.workflow-card {
  border-color: rgba(77, 64, 26, 0.85);
  background: linear-gradient(180deg, rgba(45, 90, 63, 0.08) 0%, var(--color-bg-card, #1F1D1A) 42%);
}
.message-item.workflow-card.unread {
  border-color: rgba(196, 167, 108, 0.45);
}
.message-item.digest-card {
  background: linear-gradient(180deg, rgba(91, 143, 185, 0.1) 0%, var(--color-bg-card, #1F1D1A) 48%);
}
.message-item.digest-card.unread {
  border-color: rgba(139, 168, 196, 0.45);
}
.message-item.digest-card.health-failed {
  border-color: rgba(168, 90, 43, 0.45);
}
.message-item.digest-card.health-failed .item-accent.on {
  background: #C4A06A;
}
.message-item.digest-card.health-ok .item-accent.on {
  background: #52B788;
}
.message-item.digest-card.health-partial .item-accent.on {
  background: #C4A76C;
}
.item-accent.forest.on {
  background: #2D5A3F;
}
.item-accent.digest.on {
  background: #5B8FB9;
}

/* 日报列表关键数 */
.digest-list-card {
  margin-top: 12rpx;
}
.dlc-health {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(139, 168, 196, 0.35);
  background: rgba(91, 143, 185, 0.1);
}
.dlc-lamp {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8BA8C4;
  flex-shrink: 0;
}
.dlc-lamp.tone-failed { background: #C4A06A; }
.dlc-lamp.tone-partial { background: #C4A76C; }
.dlc-lamp.tone-ok { background: #52B788; }
.dlc-health text {
  font-size: 18rpx;
  color: #8BA8C4;
  letter-spacing: 0.04em;
}
.dlc-health.tone-failed {
  border-color: rgba(168, 90, 43, 0.45);
  background: rgba(138, 90, 43, 0.12);
}
.dlc-health.tone-failed text {
  color: #C4A06A;
}
.dlc-health.tone-partial {
  border-color: rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.1);
}
.dlc-health.tone-partial text {
  color: #C4A76C;
}
.dlc-health.tone-ok {
  border-color: rgba(82, 183, 136, 0.35);
  background: rgba(82, 183, 136, 0.08);
}
.dlc-health.tone-ok text {
  color: #7CB592;
}
.dlc-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.dlc-chip {
  flex: 1 1 28%;
  min-width: 140rpx;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(139, 168, 196, 0.28);
  background: rgba(91, 143, 185, 0.08);
  box-sizing: border-box;
}
.dlc-chip.is-primary {
  flex: 1 1 100%;
  border-color: rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.1);
}
.dlc-chip-kicker {
  display: block;
  font-size: 16rpx;
  color: #C4A76C;
  letter-spacing: 0.06em;
  margin-bottom: 2rpx;
}
.dlc-chip.is-primary .dlc-chip-value {
  font-size: 28rpx;
}
.dlc-chip-label {
  display: block;
  font-size: 18rpx;
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 0.04em;
}
.dlc-chip-value {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #C9D6E4;
  font-variant-numeric: tabular-nums;
}
.dlc-chip.is-missing .dlc-chip-value {
  font-weight: 400;
  color: #8B6F47;
  opacity: 0.75;
}
.dlc-chip.is-failed {
  border-color: rgba(168, 90, 43, 0.45);
  background: rgba(138, 90, 43, 0.12);
}
.dlc-chip.is-failed .dlc-chip-value {
  color: #C4A06A;
}
.dlc-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #8BA8C4;
  opacity: 0.9;
}
.dlc-hint.warn {
  color: #C4A06A;
}

.digest-payload-missing {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  border: 1rpx dashed rgba(196, 167, 108, 0.35);
  background: rgba(196, 167, 108, 0.06);
}
.dpm-text {
  display: block;
  font-size: 20rpx;
  color: #C4A76C;
  margin-bottom: 8rpx;
}

.type-tag {
  font-size: 20rpx;
  color: var(--color-wood, #8B6F47);
  letter-spacing: 0.04em;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-time {
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
  flex-shrink: 0;
  font-family: var(--font-mono, monospace);
}

.message-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
  line-height: 1.4;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color var(--dur-base) var(--ease-standard);
}

.message-sender {
  display: block;
  font-size: 20rpx;
  color: var(--brass-600, #8A7530);
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
}

.message-preview {
  display: -webkit-box;
  font-size: 24rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.55;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 需求 10：列表商品线索（缩略图 + 首件名称） */
.message-goods {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mg-thumb {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
}

.mg-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 发货包装图片（可选附件）列表线索：与商品线索同一行距口径，颜色走品牌金令牌。
   本页是深色信箱底，故用 --brass-400（与 .mg-text 同源），不引入新裸色。 */
.message-photos-hint {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mph-lamp {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brass-400, #C4A76C);
  opacity: 0.85;
}

.mph-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20, 20rpx);
  color: var(--brass-400, #C4A76C);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.message-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.action-hint {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
}

.load-more.muted {
  color: var(--color-text-muted, #6B6560);
}

/* —— 信签层 —— */
.letter-page {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  flex-direction: column;
  background: var(--color-bg, #1A1814);
  opacity: 0;
  pointer-events: none;
  transform: translateY(24rpx);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}

.letter-page.visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.letter-scroll {
  /* 列表页遗留样式；详情页已用 JS px 高度。勿用 flex:1+height:0 */
  width: 100%;
  flex-shrink: 0;
  height: calc(100vh - 120rpx);
  max-height: calc(100vh - 120rpx);
  box-sizing: border-box;
}

.letter-card {
  position: relative;
  margin: 24rpx 32rpx 16rpx;
  padding: 40rpx 36rpx 48rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-lg, 24rpx);
  overflow: hidden;
}

.letter-card.receipt {
  border-color: rgba(77, 64, 26, 0.55);
}

.letter-card.paper {
  background: #F2EDE4;
  border: 1px solid var(--gold);
  box-shadow:
    inset 0 0 0 8rpx #FAF6ED,
    inset 0 0 0 10rpx rgba(196, 167, 108, 0.55);
}

.paper-fiber {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.14;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)' fill='%238B6F47'/%3E%3C/svg%3E");
  mix-blend-mode: multiply;
}

.paper-crease {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 18%;
  width: 2rpx;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(139, 111, 71, 0) 0%,
    rgba(139, 111, 71, 0.16) 18%,
    rgba(139, 111, 71, 0.1) 82%,
    rgba(139, 111, 71, 0) 100%
  );
}

.letter-stamp {
  position: absolute;
  top: 36rpx;
  right: 36rpx;
  width: 92rpx;
  height: 92rpx;
  border: 1px dashed rgba(139, 111, 71, 0.5);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transform: rotate(8deg);
  z-index: 2;
}

.stamp-en {
  font-size: 16rpx;
  letter-spacing: 0.14em;
  color: #8B6F47;
}

.stamp-cn {
  font-size: 22rpx;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  color: #8A7530;
}

.letter-plate {
  position: relative;
  z-index: 1;
}

.letter-kicker {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx 28rpx;
  margin-bottom: 28rpx;
}

.paper-mode .letter-kicker {
  padding-right: 100rpx;
}

.museum-mode .signal-label {
  color: var(--color-text-secondary, #A09A90);
}

.paper-mode .signal-label {
  color: #8B6F47;
}

.letter-sender {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  margin-bottom: 12rpx;
}

.museum-mode .letter-sender {
  color: var(--brass-400, #C4A76C);
}

.paper-mode .letter-sender {
  color: #8A7530;
}

.letter-title {
  display: block;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.45;
  margin-bottom: 16rpx;
}

.museum-mode .letter-title {
  color: var(--color-text-primary);
}

.paper-mode .letter-title {
  color: #33302C;
}

.letter-time {
  display: block;
  font-size: 22rpx;
  font-family: var(--font-mono, monospace);
}

.museum-mode .letter-time {
  color: var(--color-text-muted, #6B6560);
}

.paper-mode .letter-time {
  color: #8B6F47;
}

.letter-rule {
  height: 1px;
  margin: 28rpx 0;
}

.museum-mode .letter-rule {
  background: rgba(196, 167, 108, 0.22);
}

.paper-mode .letter-rule {
  background: rgba(196, 167, 108, 0.45);
}

.letter-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.letter-p {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
}

.museum-mode .letter-p {
  color: var(--color-text-body, #D5D1C8);
}

.paper-mode .letter-p {
  color: #4A4540;
}

.letter-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(38, 35, 32, 0.8);
  background: var(--color-bg, #1A1814);
}

.letter-actions .btn-secondary,
.letter-actions .btn-primary {
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-md, 16rpx);
  box-sizing: border-box;
}

.letter-actions .btn-secondary {
  background: transparent;
  color: var(--brass-400, #C4A76C);
  border: 1px solid var(--brass-400, #C4A76C);
}

.letter-actions .btn-primary {
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  border: 1px solid var(--brass-400, #C4A76C);
}

.letter-actions .btn-secondary:active { opacity: 0.82; }
.letter-actions .btn-primary:active { background: #A8903C; }

.letter-actions .btn-secondary::after,
.letter-actions .btn-primary::after {
  border: none;
}

.letter-delete {
  text-align: center;
  padding: 8rpx 0 4rpx;
  font-size: 24rpx;
  color: var(--color-text-muted, #6B6560);
}

.letter-delete:active { opacity: 0.7; }

/* 独立信签页：占满系统导航栏下方，不再当浮层 */
.letter-page.standalone {
  position: relative;
  inset: auto;
  min-height: 100vh;
  opacity: 1;
  pointer-events: auto;
  transform: none;
  z-index: 1;
}
