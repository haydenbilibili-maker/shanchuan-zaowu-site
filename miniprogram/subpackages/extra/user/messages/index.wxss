/* subpackages/feature/user/messages/index.wxss */
page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-primary, #FFFFFF);
}

.page-msg {
  min-height: 100vh;
  position: relative;
  background: var(--color-bg, #1A1814);
}

/* —— 信号灯布局（色值见 app.wxss 全局 token） —— */
.lamp {
  width: 14rpx;
  height: 14rpx;
}

.lamp-col {
  width: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding-top: 8rpx;
  flex-shrink: 0;
}

.signal-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.signal-label {
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.status-chip text {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
}

/* —— 顶栏 —— */
.sticky-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(26, 24, 20, 0.96);
  border-bottom: 1px solid rgba(38, 35, 32, 0.6);
  pointer-events: none;
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}

.sticky-header.tucked {
  opacity: 0;
  transform: translateY(-8rpx);
  pointer-events: none;
}

.sticky-header.tucked .toolbar,
.sticky-header.tucked .mark-read-btn,
.sticky-header.tucked .queue-tabs,
.sticky-header.tucked .queue-tab,
.sticky-header.tucked .filter-scroll,
.sticky-header.tucked .filter-row,
.sticky-header.tucked .filter-pill {
  pointer-events: none;
}

.sticky-header .toolbar,
.sticky-header .mark-read-btn,
.sticky-header .queue-tabs,
.sticky-header .queue-tab,
.sticky-header .workflow-context,
.sticky-header .filter-scroll,
.sticky-header .filter-row,
.sticky-header .filter-pill {
  pointer-events: auto;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 0;
  min-height: 56rpx;
  box-sizing: border-box;
}

.toolbar-meta {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.unread-hint {
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
  letter-spacing: 0.08em;
}

.unread-hint.muted {
  color: var(--color-text-muted, #6B6560);
}

.mark-read-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-full, 9999px);
  flex-shrink: 0;
  box-sizing: border-box;
}

.mark-read-btn:active { opacity: 0.82; }

.mark-read-btn text {
  font-size: var(--fs-22);
  line-height: 1;
  color: var(--brass-400, #C4A76C);
  font-weight: 500;
}

/* 顾客信息 | 工作流 */
.queue-tabs {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 8rpx 32rpx 0;
  box-sizing: border-box;
}
.queue-tab {
  flex: 1;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1px solid rgba(38, 35, 32, 0.85);
  border-radius: var(--radius-md, 16rpx);
  background: var(--color-bg-card, #1F1D1A);
  box-sizing: border-box;
}
.queue-tab.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.12);
}
.queue-tab.workflow.active {
  border-color: rgba(45, 90, 63, 0.7);
  background: rgba(45, 90, 63, 0.16);
}
.queue-tab-press { opacity: 0.85; transform: scale(0.98); }
.queue-tab-label {
  font-size: var(--fs-24);
  font-weight: 500;
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
}
.queue-tab.active .queue-tab-label {
  color: var(--brass-400, #C4A76C);
}
.queue-tab.workflow.active .queue-tab-label {
  color: #7CB592;
}
/* 视觉走全局 .badge-solid-danger / .badge-info；此处仅保留间距 */
.queue-tab-badge {
  margin-left: 0;
}

.workflow-context {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 32rpx 0;
  box-sizing: border-box;
}
.workflow-context-text {
  font-size: var(--fs-22);
  color: #7CB592;
  letter-spacing: 0.06em;
}
.workflow-context.cat-digest .workflow-context-text {
  color: #8BA8C4;
}
.workflow-context.cat-ops .workflow-context-text {
  color: #7CB592;
}
.workflow-context.cat-system .workflow-context-text {
  color: var(--color-primary);
}
/* 日报档顶栏 */
.digest-rail {
  margin: 8rpx 32rpx 0;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(139, 168, 196, 0.28);
  background: rgba(91, 143, 185, 0.08);
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.digest-rail-lamp {
  width: 12rpx;
  height: 12rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #8BA8C4;
  flex-shrink: 0;
}
.digest-rail-lamp.tip-warn { background: #C4A06A; }
.digest-rail-lamp.tip-partial { background: var(--color-primary); }
.digest-rail-lamp.tip-ok { background: var(--color-success); }
.digest-rail-lamp.tip-muted { background: #6B6560; }
.digest-rail-text {
  font-size: var(--fs-20);
  color: #8BA8C4;
  line-height: 1.45;
  flex: 1;
  min-width: 0;
}
.digest-rail.tip-warn {
  border-color: rgba(168, 90, 43, 0.4);
  background: rgba(138, 90, 43, 0.1);
}
.digest-rail.tip-warn .digest-rail-text {
  color: #C4A06A;
}
.digest-rail.tip-partial {
  border-color: rgba(196, 167, 108, 0.35);
  background: rgba(196, 167, 108, 0.08);
}
.digest-rail.tip-partial .digest-rail-text {
  color: var(--color-primary);
}
.digest-rail.tip-ok .digest-rail-text {
  color: #8BA8C4;
}
.digest-rail.tip-muted .digest-rail-text {
  color: var(--color-text-muted, #6B6560);
}

.sk-digest-chips {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 0 8rpx 8rpx;
}
.sk-chip {
  flex: 1;
  height: 56rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.04);
}

.filter-pill.workflow.active {
  border-color: rgba(45, 90, 63, 0.55);
  background: rgba(45, 90, 63, 0.14);
}
.filter-pill.workflow.active text {
  color: #7CB592;
}
/* 三分档各自色相：日报蓝 / 待办绿 / 审批铜 —— 只改视觉，不改 id/契约 */
.filter-pill.tab-digest.active {
  border-color: rgba(91, 143, 185, 0.55);
  background: rgba(91, 143, 185, 0.12);
}
.filter-pill.tab-digest.active text {
  color: #8BA8C4;
}
.filter-pill.tab-ops.active {
  border-color: rgba(45, 90, 63, 0.55);
  background: rgba(45, 90, 63, 0.14);
}
.filter-pill.tab-ops.active text {
  color: #7CB592;
}
.filter-pill.tab-system.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.12);
}
.filter-pill.tab-system.active text {
  color: var(--color-primary);
}

.filter-pill-badge {
  margin-left: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.22);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.filter-pill-badge text {
  font-size: var(--fs-18);
  color: var(--brass-400, #C4A76C);
  font-weight: 600;
  line-height: 1;
}
.filter-pill.tab-digest .filter-pill-badge {
  background: rgba(91, 143, 185, 0.22);
}
.filter-pill.tab-digest .filter-pill-badge text {
  color: #8BA8C4;
}
.filter-pill.tab-ops .filter-pill-badge {
  background: rgba(45, 90, 63, 0.22);
}
.filter-pill.tab-ops .filter-pill-badge text {
  color: #7CB592;
}
.filter-pill.tab-system .filter-pill-badge {
  background: rgba(196, 167, 108, 0.22);
}
.filter-pill.tab-system .filter-pill-badge text {
  color: var(--color-primary);
}

.page-msg.queue-workflow .unread-hint {
  color: #7CB592;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 16rpx 0 20rpx;
  height: 96rpx;
  box-sizing: border-box;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 32rpx;
  padding-right: 48rpx;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  border-radius: var(--radius-full, 9999px);
  border: 1px solid rgba(38, 35, 32, 0.8);
  background: var(--color-bg-card, #1F1D1A);
  transition: border-color var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
}

.filter-pill text {
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  font-weight: 500;
}

.filter-pill.active {
  border-color: rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.12);
}

.filter-pill.active text {
  color: var(--brass-400, #C4A76C);
}

.filter-pill-press { opacity: 0.82; transform: scale(0.97); }

.filter-pad {
  display: inline-block;
  width: 32rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  box-sizing: border-box;
  transition: opacity var(--dur-base) var(--ease-standard);
}

.main-scroll.dimmed {
  opacity: 0.28;
  pointer-events: none;
}

.scroll-top-pad {
  height: 16rpx;
  flex-shrink: 0;
}

.skeleton-wrap {
  padding: 8rpx 32rpx 32rpx;
}

.sk-card {
  height: 176rpx;
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: 20rpx;
  background: var(--color-bg-card, #1F1D1A);
  display: flex;
  align-items: flex-start;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.sk-lamps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.sk-shine {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.04) 0%,
    rgba(196, 167, 108, 0.09) 50%,
    rgba(196, 167, 108, 0.04) 100%
  );
  background-size: 200% 100%;
  animation: shine 1.4s ease infinite;
}

@keyframes shine {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx;
  text-align: center;
}

.empty-lamps {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 20rpx 24rpx;
  margin-bottom: 36rpx;
  max-width: 560rpx;
}

.lamp-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.lamp-legend text {
  font-size: var(--fs-20);
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 0.06em;
}

.empty-text {
  font-size: var(--fs-30);
  color: var(--color-text-body, #D5D1C8);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--fs-24);
  color: var(--color-text-muted, #6B6560);
  line-height: 1.6;
}

.retry-btn {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  color: var(--color-primary);
  font-size: var(--fs-26);
}


.message-list {
  padding: 8rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.message-item {
  position: relative;
  display: flex;
  gap: 16rpx;
  padding: 28rpx 28rpx 28rpx 28rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(38, 35, 32, 0.7);
  border-radius: var(--radius-lg, 24rpx);
  overflow: hidden;
  transition: border-color var(--dur-base) var(--ease-standard), background var(--dur-base) var(--ease-standard), opacity var(--dur-base) var(--ease-standard);
}

.message-item-press {
  opacity: 0.9;
  transform: scale(0.985);
}

.message-item.unread {
  border-color: rgba(196, 167, 108, 0.32);
}

.message-item.read {
  opacity: 0.88;
}

.message-item.read .message-title {
  color: var(--color-text-body, #D5D1C8);
  font-weight: 500;
}

.message-item.read .message-preview {
  color: var(--color-text-muted, #6B6560);
}

.item-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: transparent;
  transition: background var(--dur-base) var(--ease-standard);
}

.item-accent.on {
  background: var(--color-primary);
}

/* ── 顾客来信 · 信件列表（2026-10-17 重置）────────────────────────────
   顾客队列不再是一张张卡：发丝线分隔的信件行；未读 = 标题前一枚铜点，已读不再挂灯；
   类别只用一个黄铜眉标字（原五色类别字 + 左侧金条 + 双信号灯，一封信上三种提示语言）。
   工作流 / 日报卡（员工队列）不在此列，保持原样。 */
.queue-customer .message-list {
  padding-top: 0;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) {
  gap: 20rpx;
  padding: 32rpx 0 30rpx;
  margin-bottom: 0;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  /* radius:object */ border-radius: 0;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .item-accent {
  display: none;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .lamp-col {
  width: 14rpx;
  padding-top: 18rpx;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .lamp-col .lamp + .lamp {
  display: none;
}
.queue-customer .message-item.read:not(.workflow-card):not(.digest-card) .lamp-col .lamp {
  visibility: hidden;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .kind-tag {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-400);
}
.queue-customer .message-item.read:not(.workflow-card):not(.digest-card) {
  opacity: 1;
}
.queue-customer .message-item.read .message-preview {
  color: var(--color-text-secondary);
}

.message-body {
  flex: 1;
  min-width: 0;
}

.message-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.kind-tag {
  font-size: var(--fs-20);
  font-weight: 500;
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.kind-tag.kind-campaign { color: var(--color-info); }
.kind-tag.kind-receipt { color: var(--color-success); }
.kind-tag.kind-notice { color: var(--color-info); }
.kind-tag.kind-workflow { color: #7CB592; }
.kind-tag.kind-digest { color: #8BA8C4; }

.message-item.workflow-card {
  border-color: rgba(77, 64, 26, 0.85);
  background: linear-gradient(180deg, rgba(45, 90, 63, 0.08) 0%, var(--color-bg-card, #1F1D1A) 42%);
}
.message-item.workflow-card.unread {
  border-color: rgba(196, 167, 108, 0.45);
}
.message-item.digest-card {
  background: linear-gradient(180deg, rgba(91, 143, 185, 0.1) 0%, var(--color-bg-card, #1F1D1A) 48%);
}
.message-item.digest-card.unread {
  border-color: rgba(139, 168, 196, 0.45);
}
.message-item.digest-card.health-failed {
  border-color: rgba(168, 90, 43, 0.45);
}
.message-item.digest-card.health-failed .item-accent.on {
  background: #C4A06A;
}
.message-item.digest-card.health-ok .item-accent.on {
  background: var(--color-success);
}
.message-item.digest-card.health-partial .item-accent.on {
  background: var(--color-primary);
}
.item-accent.forest.on {
  background: #2D5A3F;
}
.item-accent.digest.on {
  background: var(--color-info);
}

/* 日报列表关键数 */
.digest-list-card {
  margin-top: 12rpx;
}
.dlc-health {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(139, 168, 196, 0.35);
  background: rgba(91, 143, 185, 0.1);
}
.dlc-lamp {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8BA8C4;
  flex-shrink: 0;
}
.dlc-lamp.tone-failed { background: #C4A06A; }
.dlc-lamp.tone-partial { background: var(--color-primary); }
.dlc-lamp.tone-ok { background: var(--color-success); }
.dlc-health text {
  font-size: var(--fs-18);
  color: #8BA8C4;
  letter-spacing: 0.04em;
}
.dlc-health.tone-failed {
  border-color: rgba(168, 90, 43, 0.45);
  background: rgba(138, 90, 43, 0.12);
}
.dlc-health.tone-failed text {
  color: #C4A06A;
}
.dlc-health.tone-partial {
  border-color: rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.1);
}
.dlc-health.tone-partial text {
  color: var(--color-primary);
}
.dlc-health.tone-ok {
  border-color: rgba(82, 183, 136, 0.35);
  background: rgba(82, 183, 136, 0.08);
}
.dlc-health.tone-ok text {
  color: #7CB592;
}
.dlc-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.dlc-chip {
  flex: 1 1 28%;
  min-width: 140rpx;
  padding: 10rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(139, 168, 196, 0.28);
  background: rgba(91, 143, 185, 0.08);
  box-sizing: border-box;
}
.dlc-chip.is-primary {
  flex: 1 1 100%;
  border-color: rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.1);
}
.dlc-chip-kicker {
  display: block;
  font-size: var(--fs-16);
  color: var(--color-primary);
  letter-spacing: 0.06em;
  margin-bottom: 2rpx;
}
.dlc-chip.is-primary .dlc-chip-value {
  font-size: var(--fs-28);
}
.dlc-chip-label {
  display: block;
  font-size: var(--fs-18);
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 0.04em;
}
.dlc-chip-value {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-24);
  font-weight: 600;
  color: #C9D6E4;
  font-variant-numeric: tabular-nums;
}
.dlc-chip.is-missing .dlc-chip-value {
  font-weight: 400;
  color: #8B6F47;
  opacity: 0.75;
}
.dlc-chip.is-failed {
  border-color: rgba(168, 90, 43, 0.45);
  background: rgba(138, 90, 43, 0.12);
}
.dlc-chip.is-failed .dlc-chip-value {
  color: #C4A06A;
}
.dlc-hint {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-20);
  color: #8BA8C4;
  opacity: 0.9;
}
.dlc-hint.warn {
  color: #C4A06A;
}

.digest-payload-missing {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx dashed rgba(196, 167, 108, 0.35);
  background: rgba(196, 167, 108, 0.06);
}
.dpm-text {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-primary);
  margin-bottom: 8rpx;
}

.type-tag {
  font-size: var(--fs-20);
  color: var(--color-wood, #8B6F47);
  letter-spacing: 0.04em;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-time {
  font-size: var(--fs-20);
  color: var(--color-text-muted, #6B6560);
  flex-shrink: 0;
  font-family: var(--font-mono, monospace);
}

.message-title {
  display: block;
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
  line-height: 1.4;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color var(--dur-base) var(--ease-standard);
}

.message-sender {
  display: block;
  font-size: var(--fs-20);
  color: var(--brass-600, #8A7530);
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
}

.message-preview {
  display: -webkit-box;
  font-size: var(--fs-24);
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.55;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 需求 10：列表商品线索（缩略图 + 首件名称） */
.message-goods {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mg-thumb {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
}

.mg-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 发货包装图片（可选附件）列表线索：与商品线索同一行距口径，颜色走品牌金令牌。
   本页是深色信箱底，故用 --brass-400（与 .mg-text 同源），不引入新裸色。 */
.message-photos-hint {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.mph-lamp {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brass-400, #C4A76C);
  opacity: 0.85;
}

.mph-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20, 20rpx);
  color: var(--brass-400, #C4A76C);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.message-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.action-hint {
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
  letter-spacing: 0.02em;
  flex-shrink: 0;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0;
  font-size: var(--fs-24);
  color: var(--brass-400, #C4A76C);
}

.load-more.muted {
  color: var(--color-text-muted, #6B6560);
}

/* —— 信签层 —— */
.letter-page {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  flex-direction: column;
  background: var(--color-bg, #1A1814);
  opacity: 0;
  pointer-events: none;
  transform: translateY(24rpx);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}

.letter-page.visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.letter-scroll {
  /* 列表页遗留样式；详情页已用 JS px 高度。勿用 flex:1+height:0 */
  width: 100%;
  flex-shrink: 0;
  height: calc(100vh - 120rpx);
  max-height: calc(100vh - 120rpx);
  box-sizing: border-box;
}

.letter-card {
  position: relative;
  margin: 24rpx 32rpx 16rpx;
  padding: 40rpx 36rpx 48rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-lg, 24rpx);
  overflow: hidden;
}

.letter-card.receipt {
  border-color: rgba(77, 64, 26, 0.55);
}

.letter-card.paper {
  background: #F2EDE4;
  border: 1rpx solid var(--color-primary);
  box-shadow:
    inset 0 0 0 8rpx #FAF6ED,
    inset 0 0 0 10rpx rgba(196, 167, 108, 0.55);
}

.paper-fiber {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.14;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)' fill='%238B6F47'/%3E%3C/svg%3E");
  mix-blend-mode: multiply;
}

.paper-crease {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 18%;
  width: 2rpx;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(139, 111, 71, 0) 0%,
    rgba(139, 111, 71, 0.16) 18%,
    rgba(139, 111, 71, 0.1) 82%,
    rgba(139, 111, 71, 0) 100%
  );
}

.letter-stamp {
  position: absolute;
  top: 36rpx;
  right: 36rpx;
  width: 92rpx;
  height: 92rpx;
  border: 1px dashed rgba(139, 111, 71, 0.5);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transform: rotate(8deg);
  z-index: 2;
}

.stamp-en {
  font-size: var(--fs-16);
  letter-spacing: 0.14em;
  color: #8B6F47;
}

.stamp-cn {
  font-size: var(--fs-22);
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  color: #8A7530;
}

.letter-plate {
  position: relative;
  z-index: 1;
}

.letter-kicker {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx 28rpx;
  margin-bottom: 28rpx;
}

.paper-mode .letter-kicker {
  padding-right: 100rpx;
}

.museum-mode .signal-label {
  color: var(--color-text-secondary, #A09A90);
}

.paper-mode .signal-label {
  color: #8B6F47;
}

.letter-sender {
  display: block;
  font-size: var(--fs-22);
  letter-spacing: 0.08em;
  margin-bottom: 12rpx;
}

.museum-mode .letter-sender {
  color: var(--brass-400, #C4A76C);
}

.paper-mode .letter-sender {
  color: #8A7530;
}

.letter-title {
  display: block;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: var(--fs-40);
  font-weight: 600;
  line-height: 1.45;
  margin-bottom: 16rpx;
}

.museum-mode .letter-title {
  color: var(--color-text-primary);
}

.paper-mode .letter-title {
  color: #33302C;
}

.letter-time {
  display: block;
  font-size: var(--fs-22);
  font-family: var(--font-mono, monospace);
}

.museum-mode .letter-time {
  color: var(--color-text-muted, #6B6560);
}

.paper-mode .letter-time {
  color: #8B6F47;
}

.letter-rule {
  height: 1px;
  margin: 28rpx 0;
}

.museum-mode .letter-rule {
  background: rgba(196, 167, 108, 0.22);
}

.paper-mode .letter-rule {
  background: rgba(196, 167, 108, 0.45);
}

.letter-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.letter-p {
  display: block;
  font-size: var(--fs-28);
  line-height: 1.85;
}

.museum-mode .letter-p {
  color: var(--color-text-body, #D5D1C8);
}

.paper-mode .letter-p {
  color: #4A4540;
}

.letter-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(38, 35, 32, 0.8);
  background: var(--color-bg, #1A1814);
}

.letter-actions .btn-secondary,
.letter-actions .btn-primary {
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0;
  font-size: var(--fs-28);
  font-weight: 500;
  border-radius: var(--radius-md, 16rpx);
  box-sizing: border-box;
}

.letter-actions .btn-secondary {
  background: transparent;
  color: var(--brass-400, #C4A76C);
  border: 1rpx solid var(--brass-400, #C4A76C);
}

.letter-actions .btn-primary {
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  border: 1rpx solid var(--brass-400, #C4A76C);
}

.letter-actions .btn-secondary:active { opacity: 0.82; }
.letter-actions .btn-primary:active { background: #A8903C; }

.letter-actions .btn-secondary::after,
.letter-actions .btn-primary::after {
  border: none;
}

.letter-delete {
  text-align: center;
  padding: 8rpx 0 4rpx;
  font-size: var(--fs-24);
  color: var(--color-text-muted, #6B6560);
}

.letter-delete:active { opacity: 0.7; }

/* 独立信签页：占满系统导航栏下方，不再当浮层 */
.letter-page.standalone {
  position: relative;
  inset: auto;
  min-height: 100vh;
  opacity: 1;
  pointer-events: auto;
  transform: none;
  z-index: 1;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .sk-shine {
    animation: none;
  }
}

/* ── 顾客信箱「信笺」（2026-10-17 第二轮重构）────────────────────────────
   卷首（眉标 + 未读大数字 + 全部标为已读）；分类改下划线页签；按日分组的日轨；
   行内：宋体标题、类别 · 类型眉标、状态改一行小字（不再是灯 + 胶囊）。
   只作用于顾客队列（.queue-customer）；员工工作信息 / 日报卡不在此列，保持原样。 */
.letters-head {
  padding: 28rpx 32rpx 8rpx;
}

.lh-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.lh-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.lh-count {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.lh-num {
  font-family: var(--font-mono);
  font-size: 72rpx;
  line-height: 1;
  color: var(--brass-200);
}

.lh-unit,
.lh-all-read {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: var(--color-text-body);
}

.lh-mark {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: var(--fs-24);
  color: var(--brass-300);
}

/* 分类：下划线页签（顾客队列） */
.queue-customer .filter-row {
  height: 76rpx;
  gap: 36rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.queue-customer .filter-pill {
  height: 76rpx;
  padding: 0;
  background: transparent;
  border: none;
  border-bottom: 4rpx solid transparent;
  /* radius:object */ border-radius: 0;
}

.queue-customer .filter-pill text {
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
}

.queue-customer .filter-pill.active {
  background: transparent;
  border-bottom-color: var(--brass-400);
  box-shadow: none;
}

.queue-customer .filter-pill.active text {
  color: var(--brass-200);
  font-weight: 500;
}

/* 日轨 */
.day-rail {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 36rpx 0 8rpx;
}

.day-rail::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: rgba(196, 167, 108, 0.18);
}

.day-rail-t {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: var(--brass-300);
}

/* 行内 */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .message-title {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: var(--mat-paper-tone);
}

.queue-customer .message-item.read:not(.workflow-card):not(.digest-card) .message-title {
  color: var(--color-text-body);
}

.queue-customer .message-item:not(.workflow-card):not(.digest-card) .type-tag {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.queue-customer .message-item:not(.workflow-card):not(.digest-card) .status-chip {
  padding: 0;
  background: transparent;
  border: none;
}

.queue-customer .message-item:not(.workflow-card):not(.digest-card) .status-chip .lamp {
  display: none;
}

.queue-customer .message-item:not(.workflow-card):not(.digest-card) .status-chip text {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.queue-customer .message-item:not(.workflow-card):not(.digest-card) .action-hint {
  font-size: var(--fs-22);
  color: var(--brass-300);
}

.queue-customer .message-item:not(.workflow-card):not(.digest-card) .mg-thumb {
  border-radius: var(--r-thumb-sm, 8rpx);
}

/* 信封记号（2026-10-18）：未读 = 封好的信封 + 一点火漆；已读 = 封口朝上敞开、颜色退一档 */
.env-mark {
  position: relative;
  width: 34rpx;
  height: 24rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 2rpx solid var(--brass-300);
  border-radius: 2rpx;
}
.env-mark::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -11rpx;
  width: 20rpx;
  height: 20rpx;
  margin-left: -10rpx;
  box-sizing: border-box;
  border: 0 solid var(--brass-300);
  transform: rotate(45deg);
}
.env-mark.is-sealed::before { border-right-width: 2rpx; border-bottom-width: 2rpx; }
.env-mark.is-sealed::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 9rpx;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: #B5483A;
}
.env-mark.is-opened { border-color: rgba(196, 167, 108, 0.45); }
.env-mark.is-opened::before { border-color: rgba(196, 167, 108, 0.45); border-top-width: 2rpx; border-left-width: 2rpx; }

/* 列表直达（2026-11-23）：动作字可点 —— 加「›」与命中区（上下 12rpx、左 16rpx），视觉位置不变 */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .action-hint.is-go {
  padding: 12rpx 0 12rpx 16rpx;
  margin: -12rpx 0;
  color: var(--brass-200, #E3D2AC);
}
.load-more.muted { flex-direction: column; gap: 8rpx; }
.load-more-tip {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

/* ── 顾客来信 · 纸笺卡（2026-11-25，第二轮产品负责人定稿 + 第三轮细节 + 材质规范收口）──────
   每封信是一张**标本签纸**（材质规范 docs/材质规范_纸与金属_2026-11-25.md：--mat-paper-label），
   内框发丝线、宋体标题、朱砂印章式类别、黄铜实心动作钮；未读在左侧一枚朱砂火漆点。
   日期用铜金胶囊做锚点，与纸卡形成明暗节奏。

   ⚠️ 特异性：文件前段（2026-10/11 暗底时代）有同前缀的旧规则（状态胶囊 padding:0 + 透明底、
   动作字浅金无内边距、已读灯 visibility:hidden）。本段一律写**同一前缀**（同特异性、后写者胜），
   不要退回 `.queue-customer .status-chip` 这种短前缀 —— 那会输给旧规则，纸上变成「浅字贴边」。
   ⚠️ 层级：「山海」水印是 ::after 绝对定位，默认画在正文之上；正文必须抬一层（z-index:1）、水印沉底（z-index:0）。 */
.queue-customer .message-list {
  padding: 6rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}
.queue-customer .day-rail {
  padding: 30rpx 2rpx 12rpx;
  gap: 14rpx;
}
.queue-customer .day-rail-t {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.1);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.24);
  color: var(--brass-200, #E3D2AC);
  letter-spacing: 0.12em;
}
.queue-customer .day-rail::after {
  background: rgba(196, 167, 108, 0.12);
}

/* 纸面：标本签纸 + 极淡纸纹；内框 inset 8rpx；按压 = 下沉 + 投影收短（不缩放） */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) {
  position: relative;
  margin-bottom: 18rpx;
  padding: 26rpx 26rpx 22rpx;
  gap: 16rpx;
  background: var(--mat-paper-grain), var(--mat-paper-label);
  border: none;
  border-radius: 10rpx;
  box-shadow: var(--mat-paper-shadow), var(--mat-paper-edge);
  color: var(--mat-ink);
  transition: transform var(--dur-instant) var(--ease-standard), box-shadow var(--dur-instant) var(--ease-standard);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card)::before {
  content: '';
  position: absolute;
  inset: 8rpx;
  border: 1rpx solid var(--mat-paper-frame);
  border-radius: 6rpx;
  pointer-events: none;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .message-body,
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .lamp-col {
  position: relative;
  z-index: 1;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card)::after {
  content: '山海';
  position: absolute;
  z-index: 0;
  right: 22rpx;
  bottom: 14rpx;
  font-family: var(--font-brand);
  font-size: 44rpx;
  line-height: 1;
  letter-spacing: 0.08em;
  color: rgba(138, 111, 69, 0.06);
  pointer-events: none;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card):last-child {
  margin-bottom: 0;
}
.queue-customer .message-item-press:not(.workflow-card):not(.digest-card) {
  transform: var(--mat-press-shift);
  box-shadow: var(--mat-paper-shadow-press), var(--mat-paper-edge);
  opacity: 1;
}

/* 未读：左侧一枚朱砂火漆点（已读留位不显示，保证各卡正文左缘对齐） */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .lamp-col {
  width: 16rpx;
  padding-top: 12rpx;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .lamp-col .lamp {
  width: 12rpx;
  height: 12rpx;
  background: var(--mat-seal);
  box-shadow: 0 0 0 4rpx rgba(142, 59, 46, 0.12);
}
.queue-customer .message-item.read:not(.workflow-card):not(.digest-card) .lamp-col .lamp {
  visibility: hidden;
}

/* 类别：朱砂小印章 */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .kind-tag {
  padding: 3rpx 12rpx;
  border-radius: var(--r-thumb-sm, 8rpx);
  font-family: var(--font-brand);
  font-size: var(--fs-18);
  letter-spacing: 0.14em;
  color: var(--mat-seal);
  background: var(--mat-seal-tint);
  box-shadow: inset 0 0 0 1rpx var(--mat-seal-line);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .type-tag {
  color: var(--mat-ink-soft);
  font-size: var(--fs-18);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .message-time {
  color: var(--mat-ink-label);
  font-size: var(--fs-18);
}

/* 标题与正文：宋体标题压在纸上，正文用墨色；两行截断 */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .message-title {
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--mat-ink);
  letter-spacing: 0.02em;
  margin-bottom: 4rpx;
  line-height: 1.35;
}
.queue-customer .message-item.read:not(.workflow-card):not(.digest-card) .message-title {
  color: var(--mat-ink-body);
  font-weight: 500;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .message-sender {
  color: var(--mat-ink-label);
  font-size: var(--fs-18);
  margin-bottom: 6rpx;
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .message-preview {
  color: var(--mat-ink-body);
  font-size: var(--fs-24);
  line-height: 1.6;
  -webkit-line-clamp: 2;
}
.queue-customer .message-item.read:not(.workflow-card):not(.digest-card) .message-preview {
  color: var(--mat-ink-soft);
}

/* 商品 / 实拍线索：纸上用墨棕；缩略图加一圈纸色衬边，像贴在信上的小照片 */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .mg-thumb {
  border-radius: var(--r-thumb-sm, 8rpx);
  background: #E2D6BB;
  border: 1rpx solid var(--mat-paper-frame);
  box-shadow: 0 2rpx 4rpx rgba(92, 70, 28, 0.15);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .mg-text,
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .mph-text {
  color: var(--mat-ink-soft);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .mph-lamp {
  background: var(--mat-ink-label);
}

/* 信封记号：墨线；离内框一点；已读封口敞开、退一档 */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .env-mark {
  margin-top: 4rpx;
  margin-right: 2rpx;
  border-color: var(--mat-ink-label);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .env-mark.is-opened {
  opacity: 0.5;
}

/* 行脚：纸上虚线 + 状态签条 + 黄铜实心钮 */
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .message-foot {
  margin-top: 16rpx;
  padding-top: 14rpx;
  align-items: center;
  border-top: 1rpx dashed var(--mat-paper-rule);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .status-chip {
  gap: 8rpx;
  padding: 6rpx 16rpx 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(138, 111, 69, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(138, 111, 69, 0.26);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .status-chip .lamp {
  display: block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--mat-ink-label);
  box-shadow: none;
}
.queue-customer .message-item.unread:not(.workflow-card):not(.digest-card) .status-chip .lamp {
  background: var(--mat-seal);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .status-chip text {
  font-size: var(--fs-18);
  line-height: 1.4;
  letter-spacing: 0.08em;
  color: var(--mat-ink-body);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .action-hint {
  font-size: var(--fs-20);
  color: var(--mat-ink-soft);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .action-hint.is-go {
  margin: 0 4rpx 0 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: var(--fs-20);
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.06em;
  color: var(--mat-brass-ink);
  background: var(--mat-brass);
  box-shadow: var(--mat-brass-shadow), var(--mat-brass-edge);
}
.queue-customer .message-item:not(.workflow-card):not(.digest-card) .action-hint.is-go.tap-press {
  transform: translateY(1rpx);
  box-shadow: 0 1rpx 3rpx rgba(92, 70, 28, 0.2), inset 0 0 0 1rpx rgba(122, 96, 44, 0.4);
}
