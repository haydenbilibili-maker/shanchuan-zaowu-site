<!--subpackages/extra/user/messages/index.wxml-->
<view class="page-msg {{activeQueue === 'workflow' ? 'queue-workflow' : 'queue-customer'}} {{activeCategory === 'digest' ? 'cat-digest' : ''}}">
  <view class="sticky-header">
    <view class="toolbar">
      <view class="toolbar-meta">
        <view class="lamp {{unreadCount > 0 ? (activeQueue === 'workflow' ? 'lamp-forest' : 'lamp-brass') : 'lamp-brass hollow'}}"></view>
        <text class="unread-hint" wx:if="{{unreadCount > 0}}">{{unreadCount}} 封未读</text>
        <text class="unread-hint muted" wx:else>全部已读</text>
      </view>
      <view class="mark-read-btn" bindtap="markAllRead" hover-class="tap-press-soft" hover-stay-time="80" wx:if="{{unreadCount > 0}}">
        <text>全部已读</text>
      </view>
    </view>

    <!-- 工作信息情境条：随分档切换文案，与待办/审批同级 -->
    <view class="workflow-context cat-{{activeCategory}}" wx:if="{{workflowMode}}">
      <view class="lamp {{activeCategory === 'digest' ? 'lamp-info' : (activeCategory === 'ops' ? 'lamp-forest' : (activeCategory === 'system' ? 'lamp-brass' : 'lamp-forest'))}}"></view>
      <text class="workflow-context-text">{{workflowContextText}}</text>
    </view>

    <!-- 日报档顶栏：最新一期健康态 / 无 payload 诚实提示（不另打云端） -->
    <view class="digest-rail tip-{{digestRailTip.tone}}" wx:if="{{workflowMode && activeCategory === 'digest' && digestRailTip.show}}">
      <view class="digest-rail-lamp tip-{{digestRailTip.tone}}"></view>
      <text class="digest-rail-text">{{digestRailTip.text}}</text>
    </view>

    <!-- 双队列 Tab 已弱化：主入口为工作台「工作信息」；保留 showQueueTabs 开关以备兼容 -->
    <view class="queue-tabs" wx:if="{{showQueueTabs && isStaff && !workflowMode}}">
      <view
        class="queue-tab {{activeQueue === 'customer' ? 'active' : ''}}"
        hover-class="queue-tab-press"
        hover-stay-time="80"
        bindtap="switchQueue"
        data-queue="customer"
      >
        <text class="queue-tab-label">顾客信息</text>
        <view class="badge-solid-danger badge-sm queue-tab-badge badge-enter" wx:if="{{customerUnread > 0}}">
          <text>{{customerUnread > 99 ? '99+' : customerUnread}}</text>
        </view>
      </view>
      <view
        class="queue-tab workflow {{activeQueue === 'workflow' ? 'active' : ''}}"
        hover-class="queue-tab-press"
        hover-stay-time="80"
        bindtap="switchQueue"
        data-queue="workflow"
      >
        <text class="queue-tab-label">工作流</text>
        <view class="badge-info badge-sm queue-tab-badge badge-enter" wx:if="{{workflowUnread > 0}}">
          <text>{{workflowUnread > 99 ? '99+' : workflowUnread}}</text>
        </view>
      </view>
    </view>

    <scroll-view scroll-x class="filter-scroll" show-scrollbar="{{false}}">
      <view class="filter-row">
        <view
          class="filter-pill {{activeCategory === item.id ? 'active' : ''}} {{activeQueue === 'workflow' ? 'workflow' : ''}} tab-{{item.id}}"
          wx:for="{{filterTabs}}"
          wx:key="id"
          hover-class="filter-pill-press"
          hover-stay-time="80"
          bindtap="switchCategory"
          data-id="{{item.id}}"
        >
          <text>{{item.label}}</text>
          <view class="filter-pill-badge" wx:if="{{item.hasBadge}}">
            <text>{{item.badgeText}}</text>
          </view>
        </view>
        <view class="filter-pad"></view>
      </view>
    </scroll-view>
  </view>

  <scroll-view
    scroll-y
    class="main-scroll"
    style="top: {{headerHeight}}px;"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onReachBottom"
    lower-threshold="80"
    refresher-background="#1A1814"
  >
    <view class="scroll-top-pad"></view>

    <view class="skeleton-wrap" wx:if="{{loading}}">
      <view class="sk-card sk-shine {{activeCategory === 'digest' ? 'sk-digest' : ''}}" wx:for="{{[1,2,3,4]}}" wx:key="*this">
        <view class="sk-lamps">
          <view class="lamp lamp-brass dim"></view>
          <view class="lamp lamp-info dim"></view>
        </view>
        <view class="sk-digest-chips" wx:if="{{activeCategory === 'digest'}}">
          <view class="sk-chip"></view>
          <view class="sk-chip"></view>
          <view class="sk-chip"></view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:elif="{{loadError}}">
      <view class="empty-lamps">
        <view class="lamp lamp-warning"></view>
      </view>
      <text class="empty-text">{{activeCategory === 'digest' ? '日报暂时读不到' : '来信暂时读不到'}}</text>
      <text class="empty-desc">线路不稳，请稍后再试。</text>
      <view class="retry-btn" hover-class="tap-press" hover-stay-time="80" bindtap="retryLoad">再试一次</view>
    </view>

    <view class="empty-state" wx:elif="{{messages.length === 0}}">
      <view class="empty-lamps">
        <view class="lamp-legend">
          <view class="lamp {{activeQueue === 'workflow' ? (activeCategory === 'digest' ? 'lamp-info' : 'lamp-forest') : 'lamp-brass'}}"></view>
          <text>未读</text>
        </view>
        <view class="lamp-legend">
          <view class="lamp lamp-brass hollow"></view>
          <text>已读</text>
        </view>
      </view>
      <text class="empty-text">{{emptyCopy.title}}</text>
      <text class="empty-desc">{{emptyCopy.desc}}</text>
    </view>

    <view class="message-list" wx:else>
      <view
        class="message-item {{item.isUnread ? 'unread' : 'read'}} {{item.isPaper ? 'paper' : item.kind}} {{activeQueue === 'workflow' || item.kind === 'workflow' || item.isDigest ? 'workflow-card' : ''}} {{item.isDigest ? 'digest-card' : ''}} {{item.digestCard ? 'health-' + item.digestCard.healthTone : ''}}"
        wx:for="{{messages}}"
        wx:key="_id"
        hover-class="message-item-press"
        hover-stay-time="80"
        bindtap="viewMessage"
        bindlongpress="onLongPressDelete"
        data-id="{{item._id}}"
        data-index="{{index}}"
      >
        <view class="item-accent {{item.isUnread ? 'on' : ''}} {{activeQueue === 'workflow' ? 'forest' : ''}} {{item.isDigest ? 'digest' : ''}}"></view>
        <view class="lamp-col">
          <view class="lamp {{item.readLampClass}}"></view>
          <view class="lamp {{item.kindLampClass}}"></view>
        </view>
        <view class="message-body">
          <view class="message-meta">
            <text class="kind-tag kind-{{item.kind}}">{{item.kindLabel}}</text>
            <text class="type-tag">{{item.typeName}}</text>
            <text class="message-time">{{item.formattedTime}}</text>
          </view>
          <text class="message-title">{{item.digestCard.headline || item.title}}</text>
          <text class="message-sender" wx:if="{{item.isPaper && !item.isDigest}}">寄件 · {{item.senderName}}</text>

          <!-- 日报关键数条：有 payload 时优先于纯文本 preview -->
          <view class="digest-list-card tone-{{item.digestCard.healthTone}}" wx:if="{{item.digestCard}}">
            <view class="dlc-health tone-{{item.digestCard.healthTone}}" wx:if="{{item.digestCard.healthLabel}}">
              <view class="dlc-lamp tone-{{item.digestCard.healthTone}}"></view>
              <text>{{item.digestCard.healthLabel}}</text>
            </view>
            <view class="dlc-chips" wx:if="{{item.digestCard.hasHighlights}}">
              <view class="dlc-chip {{m.primary ? 'is-primary' : ''}} {{m.failed ? 'is-failed' : ''}} {{m.missing ? 'is-missing' : ''}}" wx:for="{{item.digestCard.highlights}}" wx:for-item="m" wx:key="id">
                <text class="dlc-chip-kicker" wx:if="{{m.primary}}">关键</text>
                <text class="dlc-chip-label">{{m.label}}</text>
                <text class="dlc-chip-value">{{m.valueText}}</text>
              </view>
            </view>
            <text class="dlc-hint {{item.digestCard.healthTone === 'failed' ? 'warn' : ''}}">{{item.digestCard.statusHint}}</text>
          </view>

          <view class="digest-payload-missing" wx:elif="{{item.isDigest && item.digestPayloadMissing}}">
            <text class="dpm-text">仅有文字摘要</text>
            <text class="message-preview" wx:if="{{item.preview}}">{{item.preview}}</text>
          </view>

          <text class="message-preview" wx:elif="{{item.preview}}">{{item.preview}}</text>
          <!-- 需求 10：列表也给出商品线索（缩略图 + 首件名称），不再只有订单号 -->
          <view class="message-goods" wx:if="{{item.hasProductCards}}">
            <image
              wx:for="{{item.productThumbs}}"
              wx:for-item="thumb"
              wx:key="id"
              class="mg-thumb"
              src="{{thumb.image}}"
              mode="aspectFill"
              lazy-load
            ></image>
            <text class="mg-text">{{item.productSummary}}</text>
          </view>
          <!-- 发货包装图片（可选附件）：列表里先给一个「这封信里有实拍」的线索，
               否则顾客不会专门点进信里看图（图片只在信内渲染）。非必须 → 没图就整块不出现。 -->
          <view class="message-photos-hint" wx:if="{{item.hasPackagePhotos}}">
            <view class="mph-lamp"></view>
            <text class="mph-text">随信附包装实拍{{item.packagePhotoCountText ? ' ' + item.packagePhotoCountText : ' 1 张'}}</text>
          </view>
          <view class="message-foot">
            <view class="status-chip">
              <view class="lamp {{item.statusLampClass}}"></view>
              <text>{{item.statusLabel}}</text>
            </view>
            <text class="action-hint" wx:if="{{item.isDigest}}">{{item.digestPayloadMissing ? '查看原文' : '查看详情'}}</text>
            <text class="action-hint" wx:elif="{{item.actionUrl}}">{{item.actionLabel || '打开相关页'}}</text>
          </view>
        </view>
      </view>

      <view class="load-more" wx:if="{{loadingMore}}">
        <view class="lamp lamp-brass dim"></view>
        <text>继续取信</text>
      </view>
      <view class="load-more muted" wx:elif="{{!hasMore && messages.length > 0}}">
        <text>{{activeCategory === 'digest' ? '以上是可回看的日报' : '以上是全部来信'}}</text>
      </view>
    </view>
  </scroll-view>
</view>

<!-- 全站样式化弹窗宿主（utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
