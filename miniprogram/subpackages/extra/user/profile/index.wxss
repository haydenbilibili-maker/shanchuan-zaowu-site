/* 藏家档案 · 2026-10-17 重构（产品负责人「彻底重构我的档案页面」）
   不再 @import ../user-account.wxss（那份与 onboarding / feedback 共用，注册链路属稳定期，不动它）；
   本页自给自足：博物黑底 + 一张纸质「藏家标本签」+ 眉标/主标分组 + 发丝线两栏行。
   规范依据：VI 规范 v1 §6（选中 = 金线环）、§8（两栏行左标签右数值、实心金只给主按钮）、纪律 02 发丝金 1rpx。
   类名约束：.account-nav / .account-footer（JS 实测高度）、.account-section-card next-steps-card、
   .next-step-row / .next-step-gain / .next-step-empty（test:member-card-guest 钉住）。 */

page {
  background: var(--color-bg);
}

.page-profile {
  --paper: #F3ECDD;
  --paper-2: #E8DFCB;
  --ink: #2E2618;
  --ink-2: #5A4A28;
  --ink-3: #7C6E55;
  position: relative;
  min-height: 100vh;
}

/* ── 页头：眉标 + 主标（大标题式，随页面滚走 —— 原生导航栏已常驻「藏家档案」，不再钉一条重复标题栏；
   JS 仍量它的高度给正文让位，所以用 absolute 而不是放进文档流） ── */
.account-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  padding: 28rpx var(--space-4) 0;
}

.pf-nav-en {
  font-family: var(--font-mono);
  font-size: var(--fs-16);
  letter-spacing: 0.32em;
  color: var(--brass-400);
}

.pf-nav-cn {
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  letter-spacing: 0.16em;
  color: var(--color-text-primary);
}

.pf-body {
  box-sizing: border-box;
  padding-left: var(--space-4);
  padding-right: var(--space-4);
}

/* ── 骨架 / 失败态 ── */
.pf-skeleton {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 32rpx;
}

.pf-sk-label { height: 420rpx; }
.pf-sk-row { height: 96rpx; }

.pf-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 160rpx 0 80rpx;
  text-align: center;
}

.pf-state-label {
  position: relative;
  width: 200rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
  border: 1rpx dashed rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-sm);
}

.pf-state-label::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #F0E6CC, #A8903C);
}

.pf-state-title {
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  color: var(--color-text-primary);
}

.pf-state-desc {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.pf-ghost-btn {
  margin-top: 16rpx;
  padding: 0 40rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  border-radius: 40rpx;
  font-size: var(--fs-26);
  color: var(--brass-300);
}

/* ══ ① 藏家标本签 ══════════════════════════════════════════════════
   浅纸 + 内发丝框 + 顶上一枚铜别针（与「马上有 · 心愿签」、礼赠礼笺同一张纸）。
   原「藏家身份」：深色卡 + 铆钉铜牌 + 独立进度条，且完成度在顶栏角标 / 头像环 / 进度条出现三次。 */
.pf-label {
  position: relative;
  margin-top: 40rpx;
  padding: 36rpx 40rpx 34rpx;
  background: linear-gradient(170deg, var(--paper), var(--paper-2));
  border-radius: var(--radius-sm);
  color: var(--ink);
  box-shadow: 0 30rpx 64rpx rgba(0, 0, 0, 0.45);
  animation: pf-label-in var(--dur-slow) var(--ease-out-soft) both;
}

.pf-label::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(138, 117, 48, 0.35);
  pointer-events: none;
}

.pf-label::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #F4ECD4, #A8903C 70%);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.4);
}

@keyframes pf-label-in {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: none; }
}

.pf-label-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pf-label-k {
  font-family: var(--font-mono);
  font-size: var(--fs-16);
  letter-spacing: 0.3em;
  color: var(--brass-600);
}

/* 编号：等宽 + 「复制」小字，整块可点（≥ 64rpx 热区，负边距不改视觉） */
.pf-label-no {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: -16rpx -12rpx -16rpx 0;
  padding: 16rpx 12rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: var(--ink-2);
}

.pf-label-copy {
  padding: 0 10rpx;
  font-family: var(--font-body);
  font-size: var(--fs-16);
  letter-spacing: 0.08em;
  color: var(--brass-700);
  border: 1rpx solid rgba(107, 90, 36, 0.45);
  border-radius: 4rpx;
}

.pf-label-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 28rpx;
}

/* 头像：外环 = 完成度（conic 由 JS 给），中间实拍，右下相机角标 */
.pf-avatar {
  position: relative;
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
}

.pf-avatar-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.pf-avatar-face {
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #DCD2BC;
  border: 4rpx solid var(--paper);
}

.pf-avatar-face.has-error {
  border-color: #E8B4AC;
}

.pf-avatar-img {
  width: 100%;
  height: 100%;
}

.pf-avatar-cam {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ink);
  border: 3rpx solid var(--paper);
}

.pf-avatar-cam-icon {
  width: 24rpx;
  height: 24rpx;
}

.pf-identity {
  flex: 1;
  min-width: 0;
}

.pf-field-k {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: var(--ink-3);
}

.pf-field-k.is-dark {
  margin-bottom: 16rpx;
  color: var(--color-text-secondary);
}

/* 代号：签面上直接写（宋体大字 + 一道墨线），不是深色输入框 */
.pf-nick {
  width: 100%;
  height: 72rpx;
  margin-top: 6rpx;
  padding: 0;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  letter-spacing: 0.06em;
  color: var(--ink);
  border-bottom: 1rpx solid rgba(46, 38, 24, 0.35);
}

.pf-nick-ph {
  color: rgba(46, 38, 24, 0.32);
}

.pf-avatar-hint {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-20);
  color: var(--ink-3);
}

.pf-avatar-hint.has-error {
  color: #9C3B33;
}

.pf-score {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(138, 117, 48, 0.3);
}

.pf-score-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.pf-score-val {
  font-family: var(--font-mono);
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--brass-700);
}

.pf-score-track {
  height: 4rpx;
  margin-top: 14rpx;
  background: rgba(138, 117, 48, 0.18);
}

.pf-score-fill {
  height: 100%;
  background: var(--brass-600);
  transition: width var(--dur-slow) var(--ease-standard);
}

.pf-score-note {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--ink-2);
}

/* ══ 分组：眉标（等宽英文）+ 主标（宋体），组与组靠留白与一道发丝线分，不再一组一张卡 ══ */
.account-section-card {
  margin-top: 64rpx;
}

.pf-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.22);
}

.pf-head-t {
  display: flex;
  flex-direction: column;
}

.pf-en {
  font-family: var(--font-mono);
  font-size: var(--fs-16);
  letter-spacing: 0.32em;
  color: var(--brass-400);
}

.pf-cn {
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  letter-spacing: 0.12em;
  color: var(--color-text-primary);
}

.pf-head-meta {
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.pf-desc {
  display: block;
  margin-top: 18rpx;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* ── ② 下一步 ── */
.next-steps-count {
  font-size: var(--fs-22);
  color: var(--brass-300);
}

.next-steps-count.is-done {
  color: var(--color-success);
}

.next-step-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}

.next-step-gain {
  flex-shrink: 0;
  width: 76rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--brass-300);
}

.next-step-copy {
  flex: 1;
  min-width: 0;
}

.next-step-label {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
}

.next-step-desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.next-step-cta {
  flex-shrink: 0;
  font-size: var(--fs-24);
  color: var(--brass-300);
}

.next-step-more {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.next-step-empty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 0;
}

.next-step-empty-mark {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: var(--fs-22);
  color: var(--color-success);
  border: 1rpx solid var(--color-success);
}

.next-step-empty-text {
  flex: 1;
  font-size: var(--fs-24);
  color: var(--color-text-body);
}

/* ── 两栏行：左标签（+ 小注）/ 右数值或控件 ── */
.pf-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 112rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}

.pf-row.is-last {
  border-bottom: none;
}

.pf-row.is-stack {
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
}

.pf-row-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pf-row-k {
  font-size: var(--fs-28);
  color: var(--color-text-primary);
}

.pf-row-note {
  margin-top: 4rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.pf-row-note.is-brass {
  color: var(--brass-300);
}

.pf-row-v {
  flex-shrink: 0;
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

.pf-row-v.is-mono {
  font-family: var(--font-mono);
  letter-spacing: 0.04em;
}

.pf-row-v.is-empty {
  color: var(--brass-300);
}

.pf-row-go {
  font-size: var(--fs-32);
  color: var(--color-text-secondary);
}

/* 手机号未绑定：整块（说明 + 勾选协议 + 绑定钮）；勾选门控结构不变（check:privacy-consent） */
.pf-bind {
  padding: 24rpx 0 28rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}

.phone-agree-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 24rpx;
  padding: 8rpx 0;
}

.phone-agree-row.is-shake {
  animation: pf-shake 0.42s ease-in-out;
}

@keyframes pf-shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-8rpx); }
  40%, 80% { transform: translateX(8rpx); }
}

.phone-agree-check {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-top: 4rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(196, 167, 108, 0.6);
  border-radius: 4rpx;
}

.phone-agree-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
  position: relative;
}

.phone-agree-check.checked::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 3rpx;
  width: 8rpx;
  height: 15rpx;
  border-right: 3rpx solid var(--color-bg);
  border-bottom: 3rpx solid var(--color-bg);
  transform: rotate(45deg);
}

.phone-agree-text {
  flex: 1;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.phone-agree-link {
  color: var(--brass-300);
}

.phone-agree-hint {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-error-on-tint);
}

/* 绑定钮：描边次级（实心金只给底栏「保存」）；未勾选时降一档但仍可点（点了提示先勾选） */
button.profile-bind-phone {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 84rpx;
  margin: 20rpx 0 0;
  padding: 0;
  font-size: var(--fs-26);
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  line-height: 1.2;
}

button.profile-bind-phone::after {
  border: none;
}

button.profile-bind-phone.is-off {
  color: var(--color-text-secondary);
  background: transparent;
  border-color: rgba(196, 167, 108, 0.3);
}

/* 性别：四格分段（等宽），选中 = 金线环 */
.pf-seg {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.pf-seg-item,
.pf-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  box-sizing: border-box;
  font-size: var(--fs-24);
  color: var(--color-text-body);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-sm);
  transition: color var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard), box-shadow var(--dur-fast) var(--ease-standard);
}

.pf-seg-item.on,
.pf-chip.on {
  color: var(--brass-200);
  border-color: var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
  box-shadow: var(--ring-brass);
  font-weight: 500;
}

/* 兴趣：可换行的胶囊 */
.pf-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.pf-chip {
  padding: 0 26rpx;
  border-radius: 999rpx;
}

/* 一句话：与上面两行选择器隔开 */
.pf-group {
  margin-top: 36rpx;
}

.pf-bio-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.pf-bio-count {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.pf-bio {
  width: 100%;
  height: 80rpx;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.35);
}

.pf-bio-ph {
  color: rgba(160, 154, 144, 0.6);
}

/* 敏感形态：单选行 —— 右侧圆点，选中 = 实心金点 + 金线环 */
.pf-radio-dot {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}

.pf-radio.on .pf-radio-dot {
  border-color: var(--color-primary);
  background: radial-gradient(circle, var(--color-primary) 0 9rpx, transparent 10rpx);
  box-shadow: var(--ring-brass-soft);
}

.pf-radio.on .pf-row-k {
  color: var(--brass-200);
}

/* 开关：发丝框轨道 + 圆钮；开 = 浅金轨 + 金钮靠右 */
.pf-switch {
  position: relative;
  flex-shrink: 0;
  width: 84rpx;
  height: 48rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  background: rgba(255, 255, 255, 0.03);
  transition: background-color var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
}

.pf-switch::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--color-text-secondary);
  transition: transform var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard);
}

.pf-switch.on {
  border-color: var(--color-primary);
  background: rgba(196, 167, 108, 0.22);
}

.pf-switch.on::after {
  transform: translateX(36rpx);
  background: var(--color-primary);
}

/* ── 退出登录：文字级危险动作 ── */
.pf-logout {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-top: 80rpx;
  padding-bottom: 24rpx;
}

.pf-logout-btn {
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
  font-size: var(--fs-26);
  letter-spacing: 0.08em;
  color: var(--color-error-on-tint);
}

.pf-logout-hint {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

/* ── 底栏：唯一实心金「保存资料」；没有改动时是描边的「已保存」 ── */
.account-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx var(--space-4) calc(20rpx + env(safe-area-inset-bottom));
  /* 底栏本体实底：「已保存」是透明描边钮，渐隐若落在钮后，滚过的正文会透出来和钮字叠在一起（2026-10-17 真机截图）。
     渐隐只留在底栏**上方**一小段 */
  background: var(--color-bg);
}

.account-footer::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -40rpx;
  height: 40rpx;
  background: linear-gradient(180deg, rgba(26, 24, 20, 0), var(--color-bg));
  pointer-events: none;
}

.pf-save {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: var(--fs-30);
  font-weight: 500;
  letter-spacing: 0.12em;
  color: var(--color-bg);
  background: var(--brass-400);
  border-radius: var(--radius-md);
  transition: background-color var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
}

.pf-save.is-off {
  color: rgba(212, 188, 133, 0.6);
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  line-height: 90rpx;
}
