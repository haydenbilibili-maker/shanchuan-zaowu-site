<!-- subpackages/extra/user/profile/index.wxml
     藏家档案 · 2026-10-17 重构（产品负责人「彻底重构我的档案页面」）
     信息架构：一张纸质「藏家标本签」（头像 · 代号 · 编号 · 完成度）→ 下一步 → 分组两栏行
     （基础资料 / 兴趣偏好 / 自我标签 / 敏感形态 / 隐私 / 账户与帮助）→ 退出登录。
     ⚠️ 不改契约：事件名、data 字段、字段锚点 id（#field-*，「下一步」与 ?focus= 共用）、
        .account-nav / .account-footer（JS 实测高度）、手机号授权的勾选门控结构（check:privacy-consent）原样保留。 -->
<view class="account-page page-profile">

  <view class="account-nav pf-nav" style="padding-right: {{navPaddingRight}}px;">
    <text class="pf-nav-en">COLLECTOR PROFILE</text>
    <text class="pf-nav-cn">藏家档案</text>
  </view>

  <view class="pf-body" style="padding-top: {{headerBlockPx}}px; padding-bottom: {{footerPadPx}}px;">

    <!-- 加载骨架 -->
    <view class="pf-skeleton" wx:if="{{loading}}">
      <view class="ui-sk-card pf-sk-label"></view>
      <view class="ui-sk-line wide"></view>
      <view class="ui-sk-line"></view>
      <view class="ui-sk-card pf-sk-row"></view>
      <view class="ui-sk-card pf-sk-row"></view>
    </view>

    <!-- 加载失败 -->
    <view class="pf-state" wx:elif="{{loadError}}">
      <view class="pf-state-label" aria-hidden="true"></view>
      <text class="pf-state-title">档案暂时无法读取</text>
      <text class="pf-state-desc">请检查网络后重试</text>
      <view class="pf-ghost-btn" hover-class="tap-press-soft" hover-stay-time="80" bindtap="retryLoad">重新读取</view>
    </view>

    <block wx:else>
      <!-- ① 藏家标本签：一张浅纸档案卡（与心愿签 / 礼笺同一种纸），完成度只在这里出现一次 -->
      <view class="pf-label">
        <view class="pf-label-top">
          <text class="pf-label-k">COLLECTOR</text>
          <view class="pf-label-no" hover-class="tap-press" hover-stay-time="80" bindtap="copyMemberNo" aria-role="button" aria-label="复制会员卡编号">
            <text>No. {{memberNo || '—'}}</text>
            <text class="pf-label-copy">复制</text>
          </view>
        </view>

        <view class="pf-label-main">
          <view class="pf-avatar" id="field-avatar" hover-class="tap-press-soft" hover-stay-time="80" catchtap="onChangeAvatar" aria-role="button" aria-label="更换头像">
            <view class="pf-avatar-ring" style="{{avatarRingStyle}}" aria-hidden="true"></view>
            <view class="pf-avatar-face {{avatarPickError ? 'has-error' : ''}}">
              <image class="pf-avatar-img" src="{{avatarLoadError || !avatarUrl ? '/assets/icons/user.png' : avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
            </view>
            <view class="pf-avatar-cam" aria-hidden="true">
              <image class="pf-avatar-cam-icon" src="/assets/icons/camera.png" mode="aspectFit"></image>
            </view>
          </view>

          <view class="pf-identity" id="field-nick">
            <text class="pf-field-k">藏家代号</text>
            <input
              class="pf-nick"
              type="nickname"
              value="{{nickName}}"
              bindinput="onNickInput"
              maxlength="20"
              placeholder="写下你的藏家代号"
              placeholder-class="pf-nick-ph"
            />
            <text class="pf-avatar-hint {{avatarPickError ? 'has-error' : ''}}">{{avatarPickError ? '头像未更新，点头像重试' : (avatarSaving ? '头像保存中…' : '点头像可更换')}}</text>
          </view>
        </view>

        <view class="pf-score">
          <view class="pf-score-head">
            <text class="pf-field-k">档案完成度</text>
            <view class="pf-score-valwrap">
              <text class="pf-score-bump" wx:if="{{scoreBump}}" aria-hidden="true">{{scoreBump}}</text>
              <text class="pf-score-val {{scoreBump ? 'is-bump' : ''}}">{{profileScore}}%</text>
            </view>
          </view>
          <view class="pf-score-track"><view class="pf-score-fill" style="width: {{profileScore}}%;"></view></view>
          <text class="pf-score-note">{{rewardHint}}</text>
        </view>
      </view>

      <!-- ② 下一步：按分值从高到低（需求 21） -->
      <view class="account-section-card next-steps-card">
        <view class="pf-head">
          <view class="pf-head-t"><text class="pf-en">NEXT</text><text class="pf-cn">下一步</text></view>
          <text class="next-steps-count" wx:if="{{!nextStepsDone}}">待补 {{nextStepsTotal}} 项</text>
          <text class="next-steps-count is-done" wx:else>已完整</text>
        </view>

        <view class="next-step-empty" wx:if="{{nextStepsDone}}">
          <text class="next-step-empty-mark">✓</text>
          <text class="next-step-empty-text">档案已完整；生日与偏好会持续影响礼券与推荐</text>
        </view>
        <block wx:else>
          <view
            class="next-step-row"
            wx:for="{{nextSteps}}"
            wx:key="key"
            hover-class="tap-press-soft"
            hover-stay-time="80"
            bindtap="goNextStep"
            data-key="{{item.key}}"
          >
            <text class="next-step-gain">+{{item.gain}}</text>
            <view class="next-step-copy">
              <text class="next-step-label">{{item.label}}</text>
              <text class="next-step-desc">{{item.desc}}</text>
            </view>
            <text class="next-step-cta">去补全 ›</text>
          </view>
          <text class="next-step-more" wx:if="{{nextStepsMore > 0}}">其余 {{nextStepsMore}} 项可稍后补充</text>
        </block>
      </view>

      <!-- ③ 基础资料：左标签 / 右数值 -->
      <view class="account-section-card">
        <view class="pf-head"><view class="pf-head-t"><text class="pf-en">BASICS</text><text class="pf-cn">基础资料</text></view></view>

        <view class="pf-row" wx:if="{{phoneBound}}" id="field-phone">
          <view class="pf-row-l"><text class="pf-row-k">手机号</text><text class="pf-row-note">订单与门店通知</text></view>
          <text class="pf-row-v is-mono">{{phoneMasked}}</text>
        </view>
        <view class="pf-bind" wx:else id="field-phone">
          <view class="pf-row-l"><text class="pf-row-k">绑定手机号</text><text class="pf-row-note">订单通知、预约提醒与门店权益；下单前需完成绑定</text></view>
          <view
            class="phone-agree-row {{phoneAgreeShake ? 'is-shake' : ''}}"
            bindtap="togglePhoneAgree"
            hover-class="tap-press-soft"
            hover-stay-time="80"
          >
            <view class="phone-agree-check {{phoneAgreed ? 'checked' : ''}}"></view>
            <view class="phone-agree-text">
              <text>我已阅读并同意</text>
              <text class="phone-agree-link" catchtap="openLegal" data-type="terms">《用户服务协议》</text>
              <text>和</text>
              <text class="phone-agree-link" catchtap="openLegal" data-type="privacy">《隐私政策》</text>
            </view>
          </view>
          <text wx:if="{{phoneAgreeHint && !phoneAgreed}}" class="phone-agree-hint">请先阅读并勾选同意</text>
          <button
            wx:if="{{phoneAgreed}}"
            class="profile-bind-phone"
            open-type="getPhoneNumber"
            bindgetphonenumber="onGetPhoneNumber"
            hover-class="tap-press"
            hover-stay-time="80"
          >手机号快捷绑定</button>
          <button
            wx:else
            class="profile-bind-phone is-off"
            bindtap="onPhoneBindBlocked"
            hover-class="tap-press"
            hover-stay-time="80"
          >手机号快捷绑定</button>
        </view>

        <view class="pf-row is-stack" id="field-gender">
          <view class="pf-row-l"><text class="pf-row-k">性别</text><text class="pf-row-note">可选，便于更贴切的称呼</text></view>
          <view class="pf-seg">
            <view
              class="pf-seg-item {{gender === item.key ? 'on' : ''}}"
              wx:for="{{genderOptions}}"
              wx:key="key"
              hover-class="tap-press-soft"
              hover-stay-time="80"
              bindtap="selectGender"
              data-key="{{item.key}}"
            >{{item.label}}</view>
          </view>
        </view>

        <picker mode="date" value="{{birthday}}" end="{{birthdayMax}}" bindchange="onBirthdayChange">
          <view class="pf-row is-last" id="field-birthday" hover-class="tap-press-soft" hover-stay-time="80">
            <view class="pf-row-l"><text class="pf-row-k">生日</text><text class="pf-row-note is-brass">生日当天可领生日礼券与祝福</text></view>
            <text class="pf-row-v {{birthday ? 'is-mono' : 'is-empty'}}">{{birthday || '去填写'}} ›</text>
          </view>
        </picker>
      </view>

      <!-- ④ 兴趣偏好：选中 = 金线环（不再按品类各染一色） -->
      <view class="account-section-card" id="field-interests">
        <view class="pf-head">
          <view class="pf-head-t"><text class="pf-en">PREFERENCES</text><text class="pf-cn">兴趣偏好</text></view>
          <text class="pf-head-meta">{{interests.length}}/5</text>
        </view>
        <text class="pf-desc">最多 5 项；馆藏与活动推荐会更贴合你</text>
        <view class="pf-chips">
          <view
            class="pf-chip {{item.selected ? 'on' : ''}}"
            wx:for="{{interestChips}}"
            wx:key="key"
            bindtap="toggleInterest"
            data-key="{{item.key}}"
            hover-class="tap-press-soft"
            hover-stay-time="80"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- ⑤ 自我标签：MBTI / 星座改为原生选择器两行（原 4×4 + 4×3 宫格占两屏，2026-10-17 产品负责人点名）；
           首项「暂不填写」= 清空。下标与显示文字由 wxs 现算，不另存一份状态。 -->
      <wxs module="pk">
        function at(list, v) {
          for (var i = 0; i < list.length; i++) { if ((list[i].key || list[i]) === v) return i + 1 }
          return 0
        }
        function zodiacLabel(list, v) {
          for (var i = 0; i < list.length; i++) { if (list[i].key === v) return list[i].label }
          return ''
        }
        module.exports = { at: at, zodiacLabel: zodiacLabel }
      </wxs>
      <view class="account-section-card">
        <view class="pf-head"><view class="pf-head-t"><text class="pf-en">NOTES</text><text class="pf-cn">自我标签</text></view></view>
        <text class="pf-desc">可选填写，默认仅自己可见</text>

        <picker mode="selector" range="{{mbtiRange}}" value="{{pk.at(mbtiOptions, mbti)}}" bindchange="onMbtiPick">
          <view class="pf-row" id="field-mbti" hover-class="tap-press-soft" hover-stay-time="80">
            <view class="pf-row-l"><text class="pf-row-k">MBTI</text><text class="pf-row-note">16 型人格，用于玩法与推荐语气</text></view>
            <text class="pf-row-v {{mbti ? 'is-mono' : 'is-empty'}}">{{mbti || '去选择'}} ›</text>
          </view>
        </picker>
        <picker mode="selector" range="{{zodiacRange}}" value="{{pk.at(zodiacOptions, zodiac)}}" bindchange="onZodiacPick">
          <view class="pf-row" id="field-zodiac" hover-class="tap-press-soft" hover-stay-time="80">
            <view class="pf-row-l"><text class="pf-row-k">星座</text><text class="pf-row-note">填了生日会自动带出</text></view>
            <text class="pf-row-v {{zodiac ? '' : 'is-empty'}}">{{pk.zodiacLabel(zodiacOptions, zodiac) || '去选择'}} ›</text>
          </view>
        </picker>

        <view class="pf-group">
          <view class="pf-bio-head">
            <text class="pf-field-k is-dark">一句话</text>
            <text class="pf-bio-count">{{bioLength}}/40</text>
          </view>
          <input
            class="pf-bio"
            maxlength="40"
            value="{{bio}}"
            bindinput="onBioInput"
            placeholder="可选，最多 40 字"
            placeholder-class="pf-bio-ph"
          />
        </view>
      </view>

      <!-- ⑥ 敏感形态展示（与 sensitive_blur_pref_v1 / users.sensitiveBlurPref 同 SSOT） -->
      <view class="account-section-card">
        <view class="pf-head"><view class="pf-head-t"><text class="pf-en">CABINET</text><text class="pf-cn">敏感形态展示</text></view></view>
        <text class="pf-desc">蛇类、两栖等封面是否默认轻掩；与藏品流同步</text>
        <view
          class="pf-row pf-radio {{sensitiveBlurPref === item.key ? 'on' : ''}} {{index === sensitiveOptions.length - 1 ? 'is-last' : ''}}"
          wx:for="{{sensitiveOptions}}"
          wx:key="key"
          hover-class="tap-press-soft"
          hover-stay-time="80"
          bindtap="selectSensitivePref"
          data-key="{{item.key}}"
        >
          <view class="pf-row-l"><text class="pf-row-k">{{item.label}}</text><text class="pf-row-note">{{item.hint}}</text></view>
          <view class="pf-radio-dot" aria-hidden="true"></view>
        </view>
      </view>

      <!-- ⑦ 隐私 -->
      <view class="account-section-card">
        <view class="pf-head"><view class="pf-head-t"><text class="pf-en">PRIVACY</text><text class="pf-cn">隐私设置</text></view></view>
        <view class="pf-row" hover-class="tap-press-soft" hover-stay-time="80" bindtap="togglePrivacy" data-key="showMbti">
          <view class="pf-row-l"><text class="pf-row-k">公开 MBTI</text><text class="pf-row-note">社区与个人主页展示</text></view>
          <view class="pf-switch {{privacy.showMbti ? 'on' : ''}}"></view>
        </view>
        <view class="pf-row" hover-class="tap-press-soft" hover-stay-time="80" bindtap="togglePrivacy" data-key="showZodiac">
          <view class="pf-row-l"><text class="pf-row-k">公开星座</text><text class="pf-row-note">社区与个人主页展示</text></view>
          <view class="pf-switch {{privacy.showZodiac ? 'on' : ''}}"></view>
        </view>
        <view class="pf-row is-last" hover-class="tap-press-soft" hover-stay-time="80" bindtap="togglePrivacy" data-key="showBirthday">
          <view class="pf-row-l"><text class="pf-row-k">公开生日月日</text><text class="pf-row-note">仅展示月日，不含年份</text></view>
          <view class="pf-switch {{privacy.showBirthday ? 'on' : ''}}"></view>
        </view>
      </view>

      <!-- ⑧ 账户与帮助 -->
      <view class="account-section-card">
        <view class="pf-head"><view class="pf-head-t"><text class="pf-en">HELP</text><text class="pf-cn">账户与帮助</text></view></view>
        <view class="pf-row" hover-class="tap-press-soft" hover-stay-time="80" bindtap="goFeedback">
          <text class="pf-row-k">反馈与建议</text><text class="pf-row-go">›</text>
        </view>
        <view class="pf-row" hover-class="tap-press-soft" hover-stay-time="80" bindtap="goSupport">
          <text class="pf-row-k">联系专员</text><text class="pf-row-go">›</text>
        </view>
        <view class="pf-row" hover-class="tap-press-soft" hover-stay-time="80" bindtap="openLegal" data-type="terms">
          <text class="pf-row-k">用户服务协议</text><text class="pf-row-go">›</text>
        </view>
        <view class="pf-row is-last" hover-class="tap-press-soft" hover-stay-time="80" bindtap="openLegal" data-type="privacy">
          <text class="pf-row-k">隐私政策</text><text class="pf-row-go">›</text>
        </view>
      </view>

      <!-- 退出登录：页底文字级危险动作（不与保存抢主位） -->
      <view class="pf-logout">
        <view class="pf-logout-btn" hover-class="tap-press" hover-stay-time="80" bindtap="onLogoutTap">退出登录</view>
        <text class="pf-logout-hint">清除本机登录状态，不注销云端藏家档案</text>
      </view>
    </block>
  </view>

  <view class="account-footer pf-footer" wx:if="{{!loading && !loadError}}">
    <view
      class="pf-save {{saving || loading || !isDirty ? 'is-off' : ''}}"
      hover-class="{{saving || loading || !isDirty ? '' : 'tap-press'}}"
      hover-stay-time="80"
      bindtap="saveProfile"
    >{{footerPrimaryText}}</view>
  </view>
</view>

<!-- 全站样式化弹窗宿主（utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
