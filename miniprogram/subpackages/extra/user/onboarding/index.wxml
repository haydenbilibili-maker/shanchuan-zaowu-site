<!--subpackages/extra/user/onboarding/index.wxml-->
<!-- 单页注册 / 下单回流绑号：博物柜语气，礼包卡不挤行 -->
<!-- 注册成功后原页切成功态（2026-10-11 完成页并入；旧 done 页路径只做重定向到这里） -->
<block wx:if="{{!doneView}}">
<view class="account-page page-onboard {{hasReturn ? 'is-return' : ''}} {{phoneOnly ? 'is-phone-only' : ''}}">
  <view class="grain-overlay"></view>

  <view
    class="account-nav ob-nav"
    style="padding-right: {{navPaddingRight}}px;"
  >
    <view class="account-nav-row">
      <view class="account-nav-brand">
        <text class="account-nav-title">{{navTitle}}</text>
        <text class="account-nav-sub">{{navSub}}</text>
      </view>
    </view>
  </view>

  <view
    class="ob-body"
    style="padding-top: {{headerBlockPx}}px; padding-bottom: {{footerPadPx}}px;"
  >
    <view class="step-panel">
      <view class="step-hero compact">
        <text class="step-overline">{{heroOverline}}</text>
        <text class="step-title">{{heroTitle}}</text>
        <text class="step-desc">{{heroDesc}}</text>
      </view>

      <!-- 2026-09-17：accountReady 之前不渲染 —— 会话未返回时无法判断这是新号还是老号，
           先亮出「新客礼」就是对老用户的空承诺（首屏竞态的老问题） -->
      <view class="reward-plate" wx:if="{{accountReady && showGiftPack}}">
        <view class="reward-plate-head">
          <text class="reward-plate-overline">WELCOME GIFT</text>
          <text class="reward-plate-title">新客礼</text>
        </view>
        <view class="reward-plate-stats">
          <view class="reward-stat" wx:if="{{showPoints}}">
            <text class="reward-stat-value">+{{rewardPoints}}</text>
            <text class="reward-stat-label">积分</text>
          </view>
          <view class="reward-stat-rule" wx:if="{{showPoints}}" aria-hidden="true"></view>
          <view class="reward-stat">
            <text class="reward-stat-value">{{rewardCouponCount}}</text>
            <text class="reward-stat-label">张礼券</text>
          </view>
        </view>
        <scroll-view
          class="coupon-ticket-scroll"
          scroll-x
          enable-flex
          show-scrollbar="{{false}}"
          wx:if="{{rewardCouponCards.length}}"
        >
          <view class="coupon-ticket-row">
            <view class="coupon-ticket" wx:for="{{rewardCouponCards}}" wx:key="key">
              <view class="coupon-ticket-face">
                <view class="coupon-ticket-value-wrap">
                  <text class="coupon-ticket-currency">¥</text>
                  <text class="coupon-ticket-value">{{item.value}}</text>
                </view>
                <view class="coupon-ticket-dash" aria-hidden="true"></view>
                <view class="coupon-ticket-meta">
                  <text class="coupon-ticket-type">代金券</text>
                  <text class="coupon-ticket-rule">{{item.label}}</text>
                </view>
              </view>
              <view class="coupon-ticket-notch coupon-ticket-notch-top" aria-hidden="true"></view>
              <view class="coupon-ticket-notch coupon-ticket-notch-bottom" aria-hidden="true"></view>
            </view>
            <view class="coupon-ticket-pad"></view>
          </view>
        </scroll-view>
        <text class="reward-plate-note">与授权同步到账；已领取不会重复发放。</text>
      </view>

      <view class="phone-bound-plate" wx:if="{{phoneBound}}">
        <text class="phone-bound-label">已绑定</text>
        <text class="phone-bound-value">{{phoneMasked}}</text>
      </view>
    </view>

    <view class="ob-body-pad"></view>
  </view>

  <view class="account-footer account-footer-safe ob-footer">
    <!-- 协议勾选贴着按钮、始终可见；默认不勾，点协议名只打开协议 -->
    <view
      class="agree-row ob-agree {{agreeShake ? 'is-shake' : ''}}"
      bindtap="toggleAgree"
      hover-class="tap-press-soft"
      hover-stay-time="80"
    >
      <view class="agree-check {{agreed ? 'checked' : ''}}"></view>
      <view class="agree-copy">
        <text class="agree-text">我已阅读并同意</text>
        <text class="agree-link" hover-class="tap-press" catchtap="openTerms">《用户服务协议》</text>
        <text class="agree-sep">和</text>
        <text class="agree-link" hover-class="tap-press" catchtap="openPrivacy">《隐私政策》</text>
      </view>
    </view>
    <button
      wx:if="{{!phoneBound}}"
      class="account-btn-phone ob-cta {{(!agreed || saving) ? 'disabled' : ''}}"
      open-type="{{agreed && !saving ? 'getPhoneNumber' : ''}}"
      bindtap="onPhoneCtaTap"
      bindgetphonenumber="onGetPhoneNumber"
      disabled="{{saving}}"
      loading="{{saving}}"
    >{{saving ? loadingText + '…' : ctaPhoneText}}</button>

    <view
      class="account-btn-primary ob-cta {{saving ? 'disabled' : ''}}"
      wx:else
      hover-class="{{saving ? '' : 'account-btn-press'}}"
      hover-stay-time="80"
      bindtap="finishWithGift"
    >{{saving ? loadingText + '…' : ctaFinishText}}</view>
  </view>
</view>
</block>

<!-- 成功态：欢迎 / 欢迎回来、礼包明细与补领、去处由用户选（不自动跳转） -->
<view
  wx:if="{{doneView}}"
  class="page-done account-page"
  style="padding-top: {{pagePadTop}}px; padding-bottom: {{pagePadBottom}}px; padding-left: {{pagePadX}}px; padding-right: {{pagePadX}}px;"
>
  <view class="grain-overlay"></view>

  <!-- 顶部：欢迎 -->
  <view class="done-hero done-enter">
    <view class="done-seal">
      <view class="done-seal-ring"></view>
      <text class="done-seal-glyph">{{hasReturn ? '续' : '山'}}</text>
    </view>
    <text class="done-overline">{{hasReturn ? 'CONTINUE' : 'WELCOME'}}</text>
    <!-- 2026-09-17：按「新号/老号」分支 —— 老号确认手机号不该被说成刚注册、也不该承诺新客礼 -->
    <text class="done-title">{{giftFail ? (isNewUser ? '档案已建立' : '手机号已确认') : (hasReturn ? '可以继续了' : (welcomeBack ? '欢迎回来，' + nickName : '欢迎，' + nickName))}}</text>
    <text class="done-desc" wx:if="{{giftFail}}">{{isNewUser ? '注册已完成。礼包可一键补领，不影响继续使用。' : '手机号已确认。礼包可一键补领，不影响继续使用。'}}</text>
    <text class="done-desc" wx:elif="{{giftPartial}}">部分礼券待补齐，稍后可在「我的」补领。</text>
    <text class="done-desc" wx:elif="{{hasReturn}}">{{isNewUser ? '新客礼已放入账户，接着走完刚才那一步即可。' : '手机号已确认，接着走完刚才那一步即可。'}}</text>
    <text class="done-desc" wx:elif="{{welcomeBack}}">手机号已确认，账号里的礼券与记录都还在。</text>
    <text class="done-desc" wx:else>新客礼已放入账户，接下来去哪由你决定。</text>
  </view>

  <!-- 礼包明细：两张卡（券卡可点，直达礼券夹） -->
  <!-- 老号只在确实补到券时才展示礼包明细（否则会出现「0 张礼券」） -->
  <view class="done-gifts done-enter done-enter-d1" wx:if="{{hasRegisterGift && !giftFail && !giftPartial && (isNewUser || giftCoupons > 0)}}">
    <view
      class="gift-card gift-card-tap"
      hover-class="gift-card-press"
      hover-stay-time="80"
      bindtap="goCoupons"
      aria-label="去礼券夹核销"
    >
      <text class="gift-num">{{giftCoupons}}</text>
      <text class="gift-unit">张礼券</text>
      <text class="gift-foot">去核销 ›</text>
    </view>
    <!-- 2026-09-17 起新客礼包不再含积分 → 为 0 时不渲染这张卡（否则「0 积分 已入账」） -->
    <view class="gift-card" wx:if="{{giftPoints > 0}}">
      <text class="gift-num">{{giftPoints}}</text>
      <text class="gift-unit">积分</text>
      <text class="gift-foot muted">已入账</text>
    </view>
  </view>

  <!-- 礼包异常 -->
  <view class="done-warn done-enter done-enter-d1" wx:elif="{{giftPartial || giftFail}}">
    <text class="done-warn-title">{{giftPartial ? '礼券未全部到账' : '礼包发放异常'}}</text>
    <text class="done-warn-msg" wx:if="{{giftMsg}}">{{giftMsg}}</text>
    <view
      class="account-btn-ghost done-warn-btn"
      hover-class="done-btn-press"
      bindtap="retryGift"
    >{{repairing ? '补领中…' : '补领新客礼'}}</view>
  </view>

  <!-- 明确选择：逛馆 / 去礼券夹核销（无自动跳转） -->
  <view class="done-choices done-enter done-enter-d2">
    <view class="account-btn-primary done-btn" hover-class="done-btn-press" bindtap="goPrimary">{{primaryCta}}</view>

    <view
      class="account-btn-ghost done-btn"
      hover-class="done-btn-press"
      bindtap="goCoupons"
      wx:if="{{showCouponsEntry && !hasReturn}}"
    >去礼券夹核销{{giftCoupons > 0 ? ' · ' + giftCoupons + ' 张' : ''}}</view>

    <view
      class="done-sub-link"
      hover-class="tap-press"
      bindtap="goBrowse"
      wx:if="{{hasReturn}}"
    >先去逛逛馆 ›</view>
  </view>

  <text class="done-footnote">礼券有效期以券面为准，可随时在「我的 → 礼券夹」查看</text>
</view>
