<!--subpackages/extra/user/onboarding/index.wxml-->
<!-- 单页注册 / 下单回流绑号：博物柜语气，礼包卡不挤行 -->
<view class="account-page page-onboard {{hasReturn ? 'is-return' : ''}} {{phoneOnly ? 'is-phone-only' : ''}}">
  <view class="grain-overlay"></view>

  <view
    class="account-nav ob-nav"
    style="padding-right: {{navPaddingRight}}px;"
  >
    <view class="account-nav-row">
      <view class="account-nav-brand">
        <text class="account-nav-title">{{navTitle}}</text>
        <text class="account-nav-sub">{{navSub}}</text>
      </view>
    </view>
  </view>

  <view
    class="ob-body"
    style="padding-top: {{headerBlockPx}}px; padding-bottom: {{footerPadPx}}px;"
  >
    <view class="step-panel">
      <view class="step-hero compact">
        <text class="step-overline">{{heroOverline}}</text>
        <text class="step-title">{{heroTitle}}</text>
        <text class="step-desc">{{heroDesc}}</text>
      </view>

      <!-- 2026-09-17：accountReady 之前不渲染 —— 会话未返回时无法判断这是新号还是老号，
           先亮出「新客礼」就是对老用户的空承诺（首屏竞态的老问题） -->
      <view class="reward-plate" wx:if="{{accountReady && showGiftPack}}">
        <view class="reward-plate-head">
          <text class="reward-plate-overline">WELCOME GIFT</text>
          <text class="reward-plate-title">新客礼</text>
        </view>
        <view class="reward-plate-stats">
          <view class="reward-stat" wx:if="{{showPoints}}">
            <text class="reward-stat-value">+{{rewardPoints}}</text>
            <text class="reward-stat-label">积分</text>
          </view>
          <view class="reward-stat-rule" wx:if="{{showPoints}}" aria-hidden="true"></view>
          <view class="reward-stat">
            <text class="reward-stat-value">{{rewardCouponCount}}</text>
            <text class="reward-stat-label">张礼券</text>
          </view>
        </view>
        <scroll-view
          class="coupon-ticket-scroll"
          scroll-x
          enable-flex
          show-scrollbar="{{false}}"
          wx:if="{{rewardCouponCards.length}}"
        >
          <view class="coupon-ticket-row">
            <view class="coupon-ticket" wx:for="{{rewardCouponCards}}" wx:key="key">
              <view class="coupon-ticket-face">
                <view class="coupon-ticket-value-wrap">
                  <text class="coupon-ticket-currency">¥</text>
                  <text class="coupon-ticket-value">{{item.value}}</text>
                </view>
                <view class="coupon-ticket-dash" aria-hidden="true"></view>
                <view class="coupon-ticket-meta">
                  <text class="coupon-ticket-type">代金券</text>
                  <text class="coupon-ticket-rule">{{item.label}}</text>
                </view>
              </view>
              <view class="coupon-ticket-notch coupon-ticket-notch-top" aria-hidden="true"></view>
              <view class="coupon-ticket-notch coupon-ticket-notch-bottom" aria-hidden="true"></view>
            </view>
            <view class="coupon-ticket-pad"></view>
          </view>
        </scroll-view>
        <text class="reward-plate-note">与授权同步到账；已领取不会重复发放。</text>
      </view>

      <block wx:if="{{showProfileExtras}}">
        <view
          class="avatar-plate"
          hover-class="avatar-btn-press"
          hover-stay-time="80"
          catchtap="onChangeAvatar"
          aria-label="设定头像（选填）"
        >
          <view class="avatar-stack">
            <view class="avatar-btn">
              <image class="avatar-img" src="{{avatarUrl || '/assets/icons/user.png'}}" mode="aspectFill"></image>
            </view>
            <view class="avatar-badge" aria-hidden="true">
              <image class="avatar-badge-icon" src="/assets/icons/camera.png" mode="aspectFit"></image>
            </view>
          </view>
          <text class="avatar-hint">{{avatarUrl ? '点击更换' : '头像选填'}}</text>
        </view>

        <view class="account-section-card">
          <view class="account-field">
            <text class="account-field-label">藏家代号（选填）</text>
            <text class="account-field-hint" wx:if="{{nickName}}">已带出，可修改</text>
            <text class="account-field-hint" wx:else>轻点可选用微信昵称；不填则为「藏家」</text>
            <input
              class="account-field-input"
              type="nickname"
              maxlength="20"
              placeholder="轻点选用微信昵称"
              value="{{nickName}}"
              bindinput="onNickInput"
              bindblur="onNickBlur"
              bindnicknamereview="onNicknameReview"
            />
          </view>
        </view>
      </block>

      <view class="account-section-card agree-card">
        <view class="agree-row" bindtap="toggleAgree">
          <view class="agree-check {{agreed ? 'checked' : ''}}"></view>
          <view class="agree-copy">
            <text class="agree-text">我已阅读并同意</text>
            <view class="agree-links">
              <text class="agree-link" hover-class="agree-link-press" catchtap="openTerms">《用户服务协议》</text>
              <text class="agree-sep">与</text>
              <text class="agree-link" hover-class="agree-link-press" catchtap="openPrivacy">《隐私政策》</text>
            </view>
          </view>
        </view>
      </view>

      <view class="phone-bound-plate" wx:if="{{phoneBound}}">
        <text class="phone-bound-label">已绑定</text>
        <text class="phone-bound-value">{{phoneMasked}}</text>
      </view>
    </view>

    <view class="ob-body-pad"></view>
  </view>

  <view class="account-footer account-footer-safe ob-footer">
    <button
      wx:if="{{!phoneBound}}"
      class="account-btn-phone ob-cta {{(!agreed || saving) ? 'disabled' : ''}}"
      open-type="{{agreed && !saving ? 'getPhoneNumber' : ''}}"
      bindtap="onPhoneCtaTap"
      bindgetphonenumber="onGetPhoneNumber"
      disabled="{{saving}}"
      loading="{{saving}}"
    >{{saving ? loadingText + '…' : ctaPhoneText}}</button>

    <view
      class="account-btn-primary ob-cta {{saving ? 'disabled' : ''}}"
      wx:else
      bindtap="finishWithGift"
    >{{saving ? loadingText + '…' : ctaFinishText}}</view>
  </view>
</view>
