@import '../user-account.wxss';

page {
  min-height: 100vh;
  background: var(--color-bg);
}

.page-done {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

/* 入场动画（原 care-enter 只在 care 页作用域内定义，这里是空类，故自带一套） */
.done-enter {
  animation: doneRise 520ms cubic-bezier(0.22, 0.7, 0.24, 1) both;
}
.done-enter-d1 { animation-delay: 90ms; }
.done-enter-d2 { animation-delay: 170ms; }

@keyframes doneRise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 顶部欢迎 ===== */
.done-hero {
  text-align: center;
  margin-bottom: var(--space-5);
}

.done-seal {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto var(--space-4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-seal-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1px solid var(--brass-400);
  opacity: 0.55;
  animation: doneSealPulse 2600ms ease-in-out infinite;
}

.done-seal-glyph {
  font-family: var(--font-brand);
  font-size: var(--fs-44);
  color: var(--brass-400);
  letter-spacing: 0.04em;
}

@keyframes doneSealPulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.06); opacity: 0.85; }
}

.done-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-600);
  letter-spacing: 0.18em;
  margin-bottom: 14rpx;
}

.done-title {
  display: block;
  font-size: 44rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  line-height: 1.35;
  margin-bottom: 14rpx;
}

.done-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
  padding: 0 var(--space-2);
}

/* ===== 礼包两张卡 ===== */
.done-gifts {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}

.gift-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-4) var(--space-2);
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid var(--brass-800);
}

.gift-card-tap {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.12);
}

.gift-card-press {
  opacity: 0.85;
  transform: scale(0.98);
}

.gift-num {
  font-size: var(--fs-48);
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--brass-400);
  line-height: 1.1;
}

.gift-unit {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.gift-foot {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--brass-400);
}

.gift-foot.muted {
  color: var(--color-text-muted);
}

/* ===== 礼包异常 ===== */
.done-warn {
  margin-bottom: var(--space-5);
  padding: var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid rgba(233, 162, 59, 0.45);
  background: rgba(233, 162, 59, 0.08);
  text-align: center;
}

.done-warn-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-warning);
}

.done-warn-msg {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.done-warn-btn {
  margin-top: var(--space-3);
}

/* ===== 明确选择 ===== */
.done-choices {
  margin-bottom: var(--space-4);
}

.done-btn {
  margin-bottom: var(--space-3);
}

.done-btn:last-child {
  margin-bottom: 0;
}

.done-btn-press {
  opacity: 0.86;
  transform: scale(0.98);
}

.done-sub-link {
  margin-top: var(--space-3);
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 12rpx 0;
}

.done-sub-link-press {
  opacity: 0.7;
}

.done-footnote {
  display: block;
  text-align: center;
  font-size: var(--fs-20);
  line-height: 1.6;
  color: var(--color-text-muted);
  opacity: 0.85;
}
