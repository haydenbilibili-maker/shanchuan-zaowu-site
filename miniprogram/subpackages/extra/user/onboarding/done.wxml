<!--subpackages/extra/user/onboarding/done.wxml-->
<view
  class="page-done account-page"
  style="padding-top: {{pagePadTop}}px; padding-bottom: {{pagePadBottom}}px; padding-left: {{pagePadX}}px; padding-right: {{pagePadX}}px;"
>
  <view class="grain-overlay"></view>

  <!-- 顶部：欢迎 -->
  <view class="done-hero done-enter">
    <view class="done-seal">
      <view class="done-seal-ring"></view>
      <text class="done-seal-glyph">{{hasReturn ? '续' : '山'}}</text>
    </view>
    <text class="done-overline">{{hasReturn ? 'CONTINUE' : 'WELCOME'}}</text>
    <text class="done-title">{{giftFail ? '档案已建立' : (hasReturn ? '可以继续了' : '欢迎，' + nickName)}}</text>
    <text class="done-desc" wx:if="{{giftFail}}">注册已完成。礼包可一键补领，不影响继续使用。</text>
    <text class="done-desc" wx:elif="{{giftPartial}}">积分可能已到账，部分礼券待补齐。</text>
    <text class="done-desc" wx:elif="{{hasReturn}}">新客礼已放入账户，接着走完刚才那一步即可。</text>
    <text class="done-desc" wx:else>新客礼已放入账户，接下来去哪由你决定。</text>
  </view>

  <!-- 礼包明细：两张卡（券卡可点，直达礼券夹） -->
  <view class="done-gifts done-enter done-enter-d1" wx:if="{{hasRegisterGift && !giftFail && !giftPartial}}">
    <view
      class="gift-card gift-card-tap"
      hover-class="gift-card-press"
      hover-stay-time="80"
      bindtap="goCoupons"
      aria-label="去礼券夹核销"
    >
      <text class="gift-num">{{giftCoupons}}</text>
      <text class="gift-unit">张礼券</text>
      <text class="gift-foot">去核销 ›</text>
    </view>
    <!-- 2026-09-17 起新客礼包不再含积分 → 为 0 时不渲染这张卡（否则「0 积分 已入账」） -->
    <view class="gift-card" wx:if="{{giftPoints > 0}}">
      <text class="gift-num">{{giftPoints}}</text>
      <text class="gift-unit">积分</text>
      <text class="gift-foot muted">已入账</text>
    </view>
  </view>

  <!-- 礼包异常 -->
  <view class="done-warn done-enter done-enter-d1" wx:elif="{{giftPartial || giftFail}}">
    <text class="done-warn-title">{{giftPartial ? '礼券未全部到账' : '礼包发放异常'}}</text>
    <text class="done-warn-msg" wx:if="{{giftMsg}}">{{giftMsg}}</text>
    <view
      class="account-btn-ghost done-warn-btn"
      hover-class="done-btn-press"
      bindtap="retryGift"
    >{{repairing ? '补领中…' : '补领新客礼'}}</view>
  </view>

  <!-- 明确选择：逛馆 / 去礼券夹核销（无自动跳转） -->
  <view class="done-choices done-enter done-enter-d2">
    <view class="account-btn-primary done-btn" hover-class="done-btn-press" bindtap="goPrimary">{{primaryCta}}</view>

    <view
      class="account-btn-ghost done-btn"
      hover-class="done-btn-press"
      bindtap="goCoupons"
      wx:if="{{showCouponsEntry && !hasReturn}}"
    >去礼券夹核销{{giftCoupons > 0 ? ' · ' + giftCoupons + ' 张' : ''}}</view>

    <view
      class="done-sub-link"
      hover-class="done-sub-link-press"
      bindtap="goBrowse"
      wx:if="{{hasReturn}}"
    >先去逛逛馆 ›</view>
  </view>

  <text class="done-footnote">礼券有效期以券面为准，可随时在「我的 → 礼券夹」查看</text>
</view>
