@import '../user-account.wxss';

page {
  background: var(--color-bg);
}

.page-onboard.account-page {
  height: auto;
  min-height: 100vh;
  overflow: visible;
}

.ob-body {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  padding-left: var(--space-4);
  padding-right: var(--space-4);
  overflow: visible;
}

.ob-body-pad {
  height: var(--space-4);
}





.progress-track {
  height: 2rpx;
  background: transparent;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brass-600), var(--brass-400));
  transition: width 0.35s ease;
}

.step-panel {
  animation: careFadeUp 0.4s ease;
  padding-top: var(--space-2);
}

.step-hero.compact {
  margin-bottom: var(--space-5);
}

.step-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-600);
  letter-spacing: 0.16em;
  margin-bottom: 12rpx;
}

.step-title {
  display: block;
  font-size: 40rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
  line-height: 1.35;
}

.step-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
}

/* 新客礼：铜牌分区，避免长串折行 */
.reward-plate {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.reward-plate-head {
  text-align: center;
  margin-bottom: var(--space-3);
}

.reward-plate-overline {
  display: block;
  font-size: 18rpx;
  color: var(--brass-600);
  letter-spacing: 0.14em;
  margin-bottom: 8rpx;
}

.reward-plate-title {
  display: block;
  font-size: 28rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
}

.reward-plate-stats {
  display: flex;
  align-items: stretch;
  margin-bottom: var(--space-3);
}

.reward-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) 0;
}

.reward-stat-rule {
  width: 1px;
  align-self: stretch;
  margin: 8rpx 0;
  background: var(--brass-800);
  opacity: 0.75;
  flex-shrink: 0;
}

.reward-stat-value {
  font-size: 36rpx;
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--brass-400);
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.reward-stat-label {
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.06em;
}

/* 新客礼券：横向卡券视觉 */
.coupon-ticket-scroll {
  width: 100%;
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.coupon-ticket-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 4rpx 2rpx 8rpx;
}

.coupon-ticket {
  position: relative;
  flex-shrink: 0;
  width: 220rpx;
}

.coupon-ticket-face {
  display: flex;
  flex-direction: column;
  min-height: 168rpx;
  padding: 20rpx 18rpx 18rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #FAF6ED 0%, #F0E6CC 100%);
  border: 1rpx solid #E0CFA3;
  border-radius: 16rpx;
  overflow: hidden;
}

.coupon-ticket-value-wrap {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  padding-bottom: 14rpx;
}

.coupon-ticket-currency {
  font-size: 22rpx;
  font-weight: 600;
  color: #8A7530;
  line-height: 1.2;
  padding-bottom: 6rpx;
}

.coupon-ticket-value {
  font-size: 48rpx;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
  color: #6B5A24;
  line-height: 1;
}

.coupon-ticket-dash {
  height: 0;
  margin: 0 -18rpx 14rpx;
  border-top: 2rpx dashed rgba(138, 117, 48, 0.35);
}

.coupon-ticket-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coupon-ticket-type {
  font-size: 18rpx;
  letter-spacing: 0.12em;
  color: #8A7530;
}

.coupon-ticket-rule {
  font-size: 22rpx;
  color: #6B5A24;
  font-weight: 500;
}

.coupon-ticket-notch {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-bg-card, #1F1D1A);
  top: 72rpx;
  z-index: 2;
  box-shadow: inset 0 0 0 1rpx #E0CFA3;
}

.coupon-ticket-notch-top {
  left: -10rpx;
}

.coupon-ticket-notch-bottom {
  display: block;
  right: -10rpx;
  top: 72rpx;
}

.coupon-ticket-pad {
  width: 8rpx;
  height: 1rpx;
  flex-shrink: 0;
}



.reward-plate-note {
  display: block;
  margin-top: var(--space-3);
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
  text-align: center;
}

.agree-card {
  margin-bottom: var(--space-4);
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-top: 0;
  border-top: none;
}

.agree-copy {
  flex: 1;
  min-width: 0;
}

.agree-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
  padding-top: 8rpx;
  padding-left: 0;
}

.phone-bound-plate {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  background: rgba(82, 183, 136, 0.08);
  border: 1px solid rgba(82, 183, 136, 0.28);
  border-radius: var(--radius-md);
  text-align: center;
}

.phone-bound-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-success);
  letter-spacing: 0.06em;
  margin-bottom: 6rpx;
}

.phone-bound-value {
  display: block;
  font-size: 30rpx;
  font-family: var(--font-mono);
  color: var(--color-text-body);
}

.page-onboard.is-phone-only .step-hero.compact,
.page-onboard.is-return .step-hero.compact {
  margin-bottom: var(--space-4);
}

/* 完成奖励旧类保留兼容 */

.avatar-plate {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-5) var(--space-4);
  margin-bottom: var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
}

.avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
  flex: none;
  pointer-events: none;
}

.avatar-stack {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  pointer-events: none;
}

.avatar-btn-press {
  opacity: 0.88;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid var(--brass-800);
  background: var(--color-bg-elevated);
  display: block;
  box-sizing: border-box;
  pointer-events: none;
}

.avatar-badge {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  z-index: 4;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brass-400);
  border: 3rpx solid var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  box-sizing: border-box;
}

.avatar-badge-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) saturate(100%);
  opacity: 0.85;
  pointer-events: none;
}

.avatar-hint {
  font-size: 22rpx;
  color: var(--brass-400);
  margin-top: 16rpx;
  pointer-events: none;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-top: 0;
  border-top: none;
}

.agree-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 1px solid var(--brass-800);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.agree-check.checked {
  background: var(--brass-400);
  border-color: var(--brass-400);
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.agree-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
  padding-top: 8rpx;
  padding-left: 0;
}

.agree-link {
  font-size: 22rpx;
  color: var(--brass-400);
}

.agree-link-press {
  opacity: 0.7;
}

.agree-sep {
  font-size: 22rpx;
  color: var(--color-text-muted);
}








/* 底栏 CTA：全宽居中，2/4·3/4·4/4 一致 */
.ob-footer {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.ob-footer .ob-cta,
.ob-footer .account-btn-phone,
.ob-footer .account-btn-primary {
  width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}

.ob-footer .account-btn-phone.disabled {
  opacity: 0.55;
}


/* 兴趣选中态与性别一致：黄铜描边 + 浅金底 */
.page-onboard .account-chip.active {
  border-color: var(--brass-400);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
}

/* 完成奖励：Museum 礼包分区卡 */










/* 敏感形态展示选项 */
.sensitive-option {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: rgba(26, 24, 20, 0.35);
  box-sizing: border-box;
}

.sensitive-option:last-child {
  margin-bottom: 0;
}

.sensitive-option.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}

.sensitive-option-press {
  opacity: 0.88;
}

.sensitive-option-radio {
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  border: 1px solid rgba(160, 154, 144, 0.55);
  box-sizing: border-box;
  flex-shrink: 0;
}

.sensitive-option-radio.on {
  border-color: var(--brass-400);
  background: radial-gradient(circle at center, var(--brass-400) 0 40%, transparent 42%);
}

.sensitive-option-copy {
  flex: 1;
  min-width: 0;
}

.sensitive-option-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  letter-spacing: 0.02em;
  line-height: 1.4;
}

.sensitive-option-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}
