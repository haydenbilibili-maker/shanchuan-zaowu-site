@import '../user-account.wxss';

page {
  background: var(--color-bg);
}

.page-onboard.account-page {
  height: auto;
  min-height: 100vh;
  overflow: visible;
}

.ob-body {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  padding-left: var(--space-4);
  padding-right: var(--space-4);
  overflow: visible;
}

.ob-body-pad {
  height: var(--space-4);
}





.progress-track {
  height: 2rpx;
  background: transparent;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brass-600), var(--brass-400));
  transition: width var(--dur-slow) var(--ease-standard);
}

.step-panel {
  animation: careFadeUp 0.4s ease;
  padding-top: var(--space-2);
}

.step-hero.compact {
  margin-bottom: var(--space-5);
}

.step-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-600);
  letter-spacing: 0.16em;
  margin-bottom: 12rpx;
}

.step-title {
  display: block;
  font-size: 40rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
  line-height: 1.35;
}

.step-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
}

/* 新客礼：铜牌分区，避免长串折行 */
.reward-plate {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.reward-plate-head {
  text-align: center;
  margin-bottom: var(--space-3);
}

.reward-plate-overline {
  display: block;
  font-size: 18rpx;
  color: var(--brass-600);
  letter-spacing: 0.14em;
  margin-bottom: 8rpx;
}

.reward-plate-title {
  display: block;
  font-size: 28rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
}

.reward-plate-stats {
  display: flex;
  align-items: stretch;
  margin-bottom: var(--space-3);
}

.reward-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) 0;
}

.reward-stat-rule {
  width: 1px;
  align-self: stretch;
  margin: 8rpx 0;
  background: var(--brass-800);
  opacity: 0.75;
  flex-shrink: 0;
}

.reward-stat-value {
  font-size: 36rpx;
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--brass-400);
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.reward-stat-label {
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.06em;
}

/* 新客礼券：横向卡券视觉 */
.coupon-ticket-scroll {
  width: 100%;
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.coupon-ticket-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 4rpx 2rpx 8rpx;
}

.coupon-ticket {
  position: relative;
  flex-shrink: 0;
  width: 220rpx;
}

.coupon-ticket-face {
  display: flex;
  flex-direction: column;
  min-height: 168rpx;
  padding: 20rpx 18rpx 18rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #FAF6ED 0%, #F0E6CC 100%);
  border: 1rpx solid #E0CFA3;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.coupon-ticket-value-wrap {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  padding-bottom: 14rpx;
}

.coupon-ticket-currency {
  font-size: 22rpx;
  font-weight: 600;
  color: #8A7530;
  line-height: 1.2;
  padding-bottom: 6rpx;
}

.coupon-ticket-value {
  font-size: 48rpx;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
  color: #6B5A24;
  line-height: 1;
}

.coupon-ticket-dash {
  height: 0;
  margin: 0 -18rpx 14rpx;
  border-top: 2rpx dashed rgba(138, 117, 48, 0.35);
}

.coupon-ticket-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coupon-ticket-type {
  font-size: 18rpx;
  letter-spacing: 0.12em;
  color: #8A7530;
}

.coupon-ticket-rule {
  font-size: 22rpx;
  color: #6B5A24;
  font-weight: 500;
}

.coupon-ticket-notch {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-bg-card, #1F1D1A);
  top: 72rpx;
  z-index: 2;
  box-shadow: inset 0 0 0 1rpx #E0CFA3;
}

.coupon-ticket-notch-top {
  left: -10rpx;
}

.coupon-ticket-notch-bottom {
  display: block;
  right: -10rpx;
  top: 72rpx;
}

.coupon-ticket-pad {
  width: 8rpx;
  height: 1rpx;
  flex-shrink: 0;
}



.reward-plate-note {
  display: block;
  margin-top: var(--space-3);
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
  text-align: center;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-top: 0;
  border-top: none;
}

.agree-copy {
  flex: 1;
  min-width: 0;
}

.phone-bound-plate {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  background: rgba(82, 183, 136, 0.08);
  border: 1px solid rgba(82, 183, 136, 0.28);
  border-radius: var(--radius-md);
  text-align: center;
}

.phone-bound-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-success);
  letter-spacing: 0.06em;
  margin-bottom: 6rpx;
}

.phone-bound-value {
  display: block;
  font-size: 30rpx;
  font-family: var(--font-mono);
  color: var(--color-text-body);
}

.page-onboard.is-phone-only .step-hero.compact,
.page-onboard.is-return .step-hero.compact {
  margin-bottom: var(--space-4);
}

/* 完成奖励旧类保留兼容 */

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-top: 0;
  border-top: none;
}

.agree-copy {
  flex: 1;
  min-width: 0;
}

.phone-bound-plate {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  background: rgba(82, 183, 136, 0.08);
  border: 1px solid rgba(82, 183, 136, 0.28);
  border-radius: var(--radius-md);
  text-align: center;
}

.phone-bound-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-success);
  letter-spacing: 0.06em;
  margin-bottom: 6rpx;
}

.phone-bound-value {
  display: block;
  font-size: 30rpx;
  font-family: var(--font-mono);
  color: var(--color-text-body);
}

.page-onboard.is-phone-only .step-hero.compact,
.page-onboard.is-return .step-hero.compact {
  margin-bottom: var(--space-4);
}

/* 完成奖励旧类保留兼容 */

.avatar-plate {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-5) var(--space-4);
  margin-bottom: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
}

.avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
  flex: none;
  pointer-events: none;
}

.avatar-stack {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  pointer-events: none;
}


.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid var(--brass-800);
  background: var(--color-bg-elevated);
  display: block;
  box-sizing: border-box;
  pointer-events: none;
}

.avatar-badge {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  z-index: 4;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brass-400);
  border: 3rpx solid var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  box-sizing: border-box;
}

.avatar-badge-icon {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) saturate(100%);
  opacity: 0.85;
  pointer-events: none;
}

.avatar-hint {
  font-size: 22rpx;
  color: var(--brass-400);
  margin-top: 16rpx;
  pointer-events: none;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: none;
}

.agree-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--brass-800);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.agree-check.checked {
  position: relative;
  background: var(--brass-400);
  border-color: var(--brass-400);
}

.agree-check.checked::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 8rpx;
  height: 16rpx;
  border: solid #1A1814;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}

.agree-row.is-shake { animation: agree-shake 0.42s ease; }
@keyframes agree-shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-10rpx); }
  40%, 80% { transform: translateX(10rpx); }
}

.agree-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.ob-agree {
  padding: 4rpx 0 20rpx;
  line-height: 1.55;
}

.agree-link {
  font-size: 24rpx;
  color: var(--brass-400);
}


.agree-sep {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}








/* 底栏 CTA：全宽居中，2/4·3/4·4/4 一致 */
.ob-footer {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.ob-footer .ob-cta,
.ob-footer .account-btn-phone,
.ob-footer .account-btn-primary {
  width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}

.ob-footer .account-btn-phone.disabled {
  opacity: 0.55;
}


/* 兴趣选中态与性别一致：黄铜描边 + 浅金底 */
.page-onboard .account-chip.active {
  border-color: var(--brass-400);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
}

/* 完成奖励：Museum 礼包分区卡 */










/* 敏感形态展示选项 */
.sensitive-option {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: rgba(26, 24, 20, 0.35);
  box-sizing: border-box;
}

.sensitive-option:last-child {
  margin-bottom: 0;
}

.sensitive-option.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}

.sensitive-option-press {
  opacity: 0.88;
}

.sensitive-option-radio {
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  border: 1px solid rgba(160, 154, 144, 0.55);
  box-sizing: border-box;
  flex-shrink: 0;
}

.sensitive-option-radio.on {
  border-color: var(--brass-400);
  background: radial-gradient(circle at center, var(--brass-400) 0 40%, transparent 42%);
}

.sensitive-option-copy {
  flex: 1;
  min-width: 0;
}

.sensitive-option-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  letter-spacing: 0.02em;
  line-height: 1.4;
}

.sensitive-option-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ===== 成功态（原完成页 done.wxss 并入，2026-10-11） ===== */
.page-done {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

/* 入场动画（原 care-enter 只在 care 页作用域内定义，这里是空类，故自带一套） */
.done-enter {
  animation: doneRise 520ms cubic-bezier(0.22, 0.7, 0.24, 1) both;
}
.done-enter-d1 { animation-delay: 90ms; }
.done-enter-d2 { animation-delay: 170ms; }

@keyframes doneRise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 顶部欢迎 ===== */
.done-hero {
  text-align: center;
  margin-bottom: var(--space-5);
}

.done-seal {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto var(--space-4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-seal-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1rpx solid var(--brass-400);
  opacity: 0.55;
  animation: doneSealPulse 2600ms ease-in-out infinite;
}

.done-seal-glyph {
  font-family: var(--font-brand);
  font-size: var(--fs-44);
  color: var(--brass-400);
  letter-spacing: 0.04em;
}

@keyframes doneSealPulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.06); opacity: 0.85; }
}

.done-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-600);
  letter-spacing: 0.18em;
  margin-bottom: 14rpx;
}

.done-title {
  display: block;
  font-size: 44rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  line-height: 1.35;
  margin-bottom: 14rpx;
}

.done-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
  padding: 0 var(--space-2);
}

/* ===== 礼包两张卡 ===== */
.done-gifts {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}

.gift-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-4) var(--space-2);
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid var(--brass-800);
}

.gift-card-tap {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.12);
}

.gift-card-press {
  opacity: 0.85;
  transform: scale(0.98);
}

.gift-num {
  font-size: var(--fs-48);
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--brass-400);
  line-height: 1.1;
}

.gift-unit {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.gift-foot {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--brass-400);
}

.gift-foot.muted {
  color: var(--color-text-muted);
}

/* ===== 礼包异常 ===== */
.done-warn {
  margin-bottom: var(--space-5);
  padding: var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid rgba(233, 162, 59, 0.45);
  background: rgba(233, 162, 59, 0.08);
  text-align: center;
}

.done-warn-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-warning);
}

.done-warn-msg {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.done-warn-btn {
  margin-top: var(--space-3);
}

/* ===== 明确选择 ===== */
.done-choices {
  margin-bottom: var(--space-4);
}

.done-btn {
  margin-bottom: var(--space-3);
}

.done-btn:last-child {
  margin-bottom: 0;
}

.done-btn-press {
  opacity: 0.86;
  transform: scale(0.98);
}

.done-sub-link {
  margin-top: var(--space-3);
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 12rpx 0;
}


.done-footnote {
  display: block;
  text-align: center;
  font-size: var(--fs-20);
  line-height: 1.6;
  color: var(--color-text-secondary);
  opacity: 0.85;
}
