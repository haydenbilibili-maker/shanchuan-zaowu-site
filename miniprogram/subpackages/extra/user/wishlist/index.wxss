/* Museum Mode — 收藏与候补 */
page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-primary, #FFFFFF);
}

.page-wishlist {
  min-height: 100vh;
  background: var(--color-bg, #1A1814);
}

.content {
  padding: 0 32rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header-text {
  margin: 32rpx 0 40rpx;
}

.page-overline {
  display: block;
  font-size: var(--fs-22);
  letter-spacing: 0.1em;
  color: var(--brass-400, #C4A76C);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.h1 {
  display: block;
  font-family: var(--font-brand, 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif);
  font-size: var(--fs-48);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
  letter-spacing: 0.04em;
}

.h2 {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border, #26232066);
  background: var(--color-bg-card, #1F1D1A);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--color-text-secondary, #A09A90);
  font-size: var(--fs-26);
  font-weight: 500;
}

.tab.on {
  border-color: var(--brass-800, #4D401A);
  color: var(--brass-400, #C4A76C);
}


.tab-count {
  font-size: var(--fs-22);
  opacity: 0.85;
}

.hint-card {
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border, #26232066);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}

.hint-title {
  display: block;
  font-size: var(--fs-26);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.hint-body {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.55;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: var(--color-text-secondary, #A09A90);
  font-size: var(--fs-26);
}

.item-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border, #26232066);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 20rpx;
}


.thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
  flex-shrink: 0;
}

.meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title {
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latin {
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
  font-style: italic; font-family: var(--font-latin);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.price {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

.tag {
  font-size: var(--fs-20);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
}

.tag.sold {
  color: #E9A23B;
  background: rgba(233, 162, 59, 0.12);
}

.tag.deposit {
  color: var(--brass-400, #C4A76C);
  background: rgba(196, 167, 108, 0.12);
}

.remove {
  flex-shrink: 0;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  padding: 12rpx 8rpx;
}

.empty-state {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.empty-sub {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.btn-go {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  height: 72rpx;
  padding: 0 40rpx;
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  font-weight: 500;
}

.btn-go-press { background: #A8903C; }
