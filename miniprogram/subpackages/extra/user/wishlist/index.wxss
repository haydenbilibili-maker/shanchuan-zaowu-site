/* 收藏与候补「藏品清单」（2026-10-17 重构）：博物黑底；下划线页签；发丝线行；本页无实心金。 */
page {
  background: #1A1814;
}

.page-wishlist {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
}

.eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.head-title {
  display: block;
  margin-top: 16rpx;
  font-family: var(--font-brand);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

/* —— 下划线页签 —— */
.tabs {
  display: flex;
  gap: 48rpx;
  margin-top: 36rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.tab {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin-bottom: -1rpx;
  border-bottom: 4rpx solid transparent;
}

.tab-t {
  font-size: var(--fs-28);
  color: var(--color-text-secondary);
}

.tab-count {
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.tab.on { border-bottom-color: var(--brass-400); }
.tab.on .tab-t { color: var(--brass-200); font-weight: 500; }
.tab.on .tab-count { color: var(--brass-200); }

.tab-note {
  display: block;
  margin-top: 20rpx;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* —— 清单 —— */
.list { margin-top: 24rpx; }

.item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.item:last-child { border-bottom: 1rpx solid rgba(196, 167, 108, 0.14); }

.thumb {
  flex-shrink: 0;
  width: 168rpx;
  height: 168rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
}

.meta { flex: 1; min-width: 0; }

.title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: #F3ECDD;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.latin {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-latin);
  font-style: italic;
  font-size: var(--fs-22);
  color: var(--brass-300);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.price {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

.tag {
  padding: 0 12rpx;
  line-height: 36rpx;
  font-size: var(--fs-20);
  border-radius: 4rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: var(--brass-200);
}

.tag.sold { color: var(--color-text-secondary); border-color: rgba(196, 167, 108, 0.22); }

.note {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.remove {
  flex-shrink: 0;
  align-self: stretch;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

/* —— 骨架 / 空态 —— */
.skeleton { margin-top: 24rpx; }

.sk-row {
  height: 168rpx;
  margin-bottom: 24rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
  animation: wl-pulse 1.4s ease-in-out infinite;
}

@keyframes wl-pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.empty-state {
  margin-top: 32rpx;
  padding: 40rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.empty-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: #F3ECDD;
}

.empty-sub {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.btn-go {
  display: inline-block;
  margin-top: 20rpx;
  font-size: var(--fs-24);
  color: var(--brass-200);
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .sk-row {
    animation: none;
  }
}
