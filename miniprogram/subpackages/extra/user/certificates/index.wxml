<!--subpackages/extra/user/certificates/index.wxml-->
<view class="container">

  <scroll-view scroll-y class="content" style="padding-top: {{headerBlockPx}}px">

    <view class="header-text">
      <text class="page-overline">证书收藏夹｜MY CERTIFICATES</text>
      <text class="h1">荣誉档案</text>
      <text class="h2" wx:if="{{loading}}">正在检索档案…</text>
      <text class="h2" wx:else>共收藏 {{holderCount}} 件珍品<block wx:if="{{givenCount > 0}}"> · 赠出 {{givenCount}} 件</block></text>
    </view>

    <view class="cert-grid" wx:if="{{certificates.length}}">
      <block wx:for="{{certificates}}" wx:key="_id">
        <view class="cert-item stagger-item" style="animation-delay: {{index < 8 ? index * 0.06 : 0.48}}s" hover-class="tap-press-soft" bindtap="viewCert" data-id="{{item._id}}">
          <view class="cert-frame">
            <image src="{{item.displayImage}}" mode="aspectFill" class="c-img" binderror="onThumbError" data-index="{{index}}"></image>
             <view class="c-overlay">
               <text class="c-no">{{item.orderNo}}</text>
             </view>
             <view class="c-seal">{{item.kind === 'gift_voucher' ? 'GIFTED' : 'CERTIFIED'}}</view>
             <text class="c-kind c-kind--{{item.kind}}" wx:if="{{item.kindLabel}}">{{item.kindLabel}}</text>
          </view>
          <text class="c-name">{{item.displayTitle}}</text>
          <text class="c-date" wx:if="{{item.dateStr}}">{{item.dateStr}}</text>
        </view>
      </block>
    </view>

    <view class="empty-state" wx:if="{{certificates.length === 0 && !loading}}">
       <text>{{loadError ? '档案暂时无法读取' : '还没有收藏证书'}}</text>
       <text class="empty-sub">{{loadError ? '请检查网络或登录状态后重试' : '藏品签收后，收藏证书会自动签发到这里'}}</text>
       <view class="btn-go" hover-class="btn-go-press" bindtap="onEmptyAction">{{loadError ? '重新加载' : '去逛逛'}}</view>
    </view>

  </scroll-view>
</view>
