<!--subpackages/extra/user/certificates/index.wxml · 荣誉档案（2026-10-17 重构）
    每张证书缩成一张浅纸签（铜别针 + 内发丝框 + 标本框实拍 + 名称 / 日期 + 方寸小印：收藏 = 铜、赠予 = 朱），
    与证书本身（certDraw 纸质标本签）同一种纸。页面滚动；赠出过才出现「全部 / 收藏 / 赠出」筛选。 -->
<view class="container">
  <view class="header-text">
    <text class="page-overline">CERTIFICATES · 荣誉档案</text>
    <text class="h1">我的证书</text>
    <text class="h2" wx:if="{{loading}}">正在检索档案…</text>
    <text class="h2" wx:else>共收藏 {{holderCount}} 件珍品<block wx:if="{{givenCount > 0}}"> · 赠出 {{givenCount}} 件</block></text>
  </view>

  <view class="filters" wx:if="{{givenCount > 0 && !loading}}">
    <view class="filter {{filter === 'all' ? 'on' : ''}}" data-key="all" bindtap="onFilter" hover-class="tap-press" hover-stay-time="80">全部</view>
    <view class="filter {{filter === 'holder' ? 'on' : ''}}" data-key="holder" bindtap="onFilter" hover-class="tap-press" hover-stay-time="80">收藏</view>
    <view class="filter {{filter === 'given' ? 'on' : ''}}" data-key="given" bindtap="onFilter" hover-class="tap-press" hover-stay-time="80">赠出</view>
  </view>

  <view class="cert-grid" wx:if="{{visible.length}}">
    <block wx:for="{{visible}}" wx:key="_id">
      <view class="cert-item stagger-item" style="animation-delay: {{index < 8 ? index * 0.06 : 0.48}}s" hover-class="tap-press-soft" hover-stay-time="80" bindtap="viewCert" data-id="{{item._id}}" aria-role="button" aria-label="{{item.displayTitle}}{{item.kindLabel ? '，' + item.kindLabel : ''}}">
        <view class="cert-pin" aria-hidden="true"></view>
        <text class="c-eyebrow">{{item.kind === 'gift_voucher' ? 'CERTIFICATE OF GIFT' : 'CERTIFICATE'}}</text>
        <view class="c-frame">
          <image src="{{item.displayImage}}" mode="aspectFill" class="c-img" binderror="onThumbError" data-id="{{item._id}}"></image>
          <view class="c-seal {{item.kind === 'gift_voucher' ? 'is-gift' : ''}}" aria-hidden="true"><text>{{item.kind === 'gift_voucher' ? '赠' : '藏'}}</text></view>
        </view>
        <text class="c-name">{{item.displayTitle}}</text>
        <view class="c-foot">
          <text class="c-date" wx:if="{{item.dateStr}}">{{item.dateStr}}</text>
          <text class="c-kind" wx:if="{{item.kindLabel}}">{{item.kindLabel}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:if="{{certificates.length === 0 && !loading}}">
    <text class="empty-title">{{loadError ? '档案暂时无法读取' : '还没有收藏证书'}}</text>
    <text class="empty-sub">{{loadError ? '请检查网络或登录状态后重试' : '藏品签收后，收藏证书会自动签发到这里'}}</text>
    <view class="btn-go" hover-class="tap-press" hover-stay-time="80" bindtap="onEmptyAction">{{loadError ? '重新加载 ›' : '去馆里看看 ›'}}</view>
  </view>
</view>
