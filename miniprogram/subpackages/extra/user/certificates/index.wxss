/* subpackages/feature/user/certificates/index.wxss - Museum Mode */
page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-primary, #FFFFFF);
}

.content {
  padding: 0 30rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header-text {
  margin: 40rpx 0 60rpx;
  overflow: visible;
}

.page-overline {
  display: block;
  font-size: 24rpx;
  letter-spacing: 0.1em;
  color: var(--brass-400, #C4A76C);
  font-weight: 600;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.h1 {
  display: block;
  font-family: var(--font-brand, 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif);
  font-size: var(--fs-48);
  font-weight: 600;
  line-height: 1.45;
  padding: 4rpx 0;
  margin-bottom: 14rpx;
  color: var(--color-text-primary, #FFFFFF);
  letter-spacing: 0.06em;
  overflow: visible;
}

.h2 {
  display: block;
  font-size: 26rpx;
  color: rgba(196, 167, 108, 0.8);
  font-family: var(--font-mono, 'JetBrains Mono', 'DIN', monospace);
  letter-spacing: 0.08em;
  font-weight: 600;
  line-height: 1.4;
}

.cert-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 30rpx;
}

.cert-item { display: flex; flex-direction: column; align-items: center; margin-bottom: 30rpx; }

.cert-frame {
  width: 100%; 
  aspect-ratio: 3/4; 
  position: relative;
  border: 10rpx solid rgba(196, 167, 108,0.3);
  border-radius: 16rpx;
  box-shadow:
    0 16rpx 48rpx rgba(0,0,0,0.6),
    0 4rpx 16rpx rgba(0,0,0,0.4),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  overflow: hidden; 
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(0,0,0,0.8), rgba(20,20,20,0.6));
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard), color var(--dur-slow) var(--ease-standard), background-color var(--dur-slow) var(--ease-standard), border-color var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard);
}
.cert-item:active .cert-frame {
  transform: scale(0.98) translateY(-4rpx);
  border-color: rgba(196, 167, 108,0.5);
  box-shadow:
    0 12rpx 36rpx rgba(0,0,0,0.7),
    0 2rpx 12rpx rgba(0,0,0,0.5),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
}
.c-img { 
  width: 100%; 
  height: 100%; 
  opacity: 0.75; 
  filter: brightness(0.7) contrast(1.1) saturate(1.1) grayscale(0.2) sepia(0.1); 
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard), color var(--dur-slow) var(--ease-standard), background-color var(--dur-slow) var(--ease-standard), border-color var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard);
}
.cert-item:active .c-img { 
  opacity: 1; 
  filter: brightness(0.9) contrast(1.2) saturate(1.2) grayscale(0) sepia(0.15); 
  transform: scale(1.08); 
}

.c-overlay {
  position: absolute; 
  inset: 0; 
  background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.6) 50%, transparent 100%);
  display: flex; 
  align-items: flex-end; 
  justify-content: center; 
  padding-bottom: 24rpx;
  pointer-events: none;
}
.c-no { 
  font-family: var(--font-mono); 
  font-size: 18rpx; 
  color: rgba(196, 167, 108,0.8); 
  letter-spacing: 3rpx;
  font-weight: 700;
  text-shadow: none;
}

/* 礼赠：受赠（持有人）/ 赠予凭证（送礼人）角标 */
.c-kind {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  font-size: var(--fs-18);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  letter-spacing: 2rpx;
  background: rgba(31, 29, 26, 0.72);
}
.c-kind--gift_holder { color: var(--brass-300); border: 2rpx solid var(--brass-400); }
.c-kind--gift_voucher { color: var(--brass-50); border: 2rpx solid var(--color-wood); background: rgba(139, 111, 71, 0.72); }

.c-seal {
  position: absolute; 
  top: 24rpx; 
  right: 24rpx;
  border: 2.5rpx solid var(--gold); 
  color: var(--gold);
  font-size: 18rpx; 
  padding: 6rpx 12rpx; 
  border-radius: 6rpx;
  transform: rotate(-12deg); 
  background: linear-gradient(135deg, rgba(196, 167, 108,0.15), rgba(196, 167, 108,0.08));
  font-weight: 800;
  letter-spacing: 2rpx;
  box-shadow:
    0 4rpx 12rpx rgba(0,0,0,0.4),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  backdrop-filter: blur(8px);
  text-shadow: none;
}

.c-name { 
  font-size: 28rpx; 
  font-weight: 900; 
  color: rgba(255,255,255,0.95); 
  text-align: center; 
  margin-bottom: 8rpx;
  text-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.8),
    0 1rpx 4rpx rgba(0,0,0,0.6);
  letter-spacing: 1rpx;
}
.c-date { 
  font-family: var(--font-mono); 
  font-size: 22rpx; 
  color: rgba(196, 167, 108,0.7);
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: none;
}

.empty-state { 
  text-align: center; 
  margin-top: 200rpx; 
  color: #D5D1C8;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.empty-sub { display: block; margin-top: 12rpx; font-size: 24rpx; font-weight: 400; letter-spacing: 0; color: #A09A90; }
.btn-go { 
  margin-top: 40rpx; 
  display: inline-block;
  border: 1.5px solid rgba(196, 167, 108,0.5); 
  color: var(--gold);
  padding: 14rpx 44rpx; 
  border-radius: 44rpx; 
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.12), rgba(196, 167, 108,0.06));
  box-shadow:
    0 4rpx 12rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard), color var(--dur-slow) var(--ease-standard), background-color var(--dur-slow) var(--ease-standard), border-color var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard);
  text-shadow: none;
}
.btn-go-press {
  transform: scale(0.97);
  border-color: rgba(196, 167, 108,0.7);
  background: rgba(196, 167, 108,0.18);
}

.stagger-item { opacity: 0; animation: fadeIn 0.6s ease forwards; }
@keyframes fadeIn { to { opacity: 1; transform: translateY(0); } }