/* 荣誉档案（2026-10-17 重构）：每张证书是一张浅纸签缩样（与证书本身同一种纸）；本页无实心金。 */
page {
  background: #1A1814;
}

.container {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
}

.page-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.h1 {
  display: block;
  margin-top: 16rpx;
  font-family: var(--font-brand);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.h2 {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

/* —— 筛选：发丝框小签，选中金线环 —— */
.filters {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.filter {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: var(--fs-24);
  color: var(--color-text-body);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-sm);
}

.filter.on {
  color: var(--brass-200);
  border-color: var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
  box-shadow: var(--ring-brass);
}

/* —— 证书缩样：两列浅纸签 —— */
.cert-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 32rpx;
}

.cert-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.4);
}

.cert-item::before {
  content: '';
  position: absolute;
  inset: 10rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.cert-pin {
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border-radius: 50%;
  background: #B08D57;
}

.c-eyebrow {
  font-family: var(--font-mono);
  font-size: 16rpx;
  letter-spacing: 0.16em;
  color: #8B6F47;
  white-space: nowrap;
}

/* 标本框：外发丝 + 纸边 */
.c-frame {
  position: relative;
  width: 100%;
  margin-top: 16rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
}

.c-img {
  display: block;
  width: 100%;
  height: 220rpx;
  background: rgba(46, 38, 24, 0.06);
}

.c-name {
  margin-top: 16rpx;
  max-width: 100%;
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  font-weight: 600;
  color: #2E2618;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.c-foot {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  min-height: 32rpx;
}

.c-date {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  color: #8A7F6C;
}

.c-kind {
  padding: 0 8rpx;
  line-height: 28rpx;
  font-size: var(--fs-18);
  color: #8B6F47;
  border: 1rpx solid rgba(139, 111, 71, 0.5);
  border-radius: 4rpx;
}

/* 方寸小印：收藏 = 铜，赠予 = 朱（证书本身的印色口径） */
.c-seal {
  position: absolute;
  right: -10rpx;
  bottom: -12rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #B08D57;
  border-radius: 4rpx;
  transform: rotate(-6deg);
  opacity: 0.92;
}

.c-seal text {
  font-family: var(--font-brand);
  font-size: var(--fs-20);
  font-weight: 600;
  color: #F3ECDD;
}

.c-seal.is-gift { background: #9E3B2E; }

/* —— 空态 —— */
.empty-state {
  margin-top: 40rpx;
  padding: 40rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.empty-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: #F3ECDD;
}

.empty-sub {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.btn-go {
  display: inline-block;
  margin-top: 20rpx;
  font-size: var(--fs-24);
  color: var(--brass-200);
}
