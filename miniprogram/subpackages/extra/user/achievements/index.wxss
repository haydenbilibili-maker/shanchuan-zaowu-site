/* 我的成就 · 馆志（2026-10-17 重设计）
   博物黑底 + 纸面铭牌（点亮的节点）+ 发丝空环（未点亮）；整页没有实心金块，金只用在铭牌圈、刻度和进度线上。 */
page {
  background: #1A1814;
  color: #FFFFFF;
}

.page-achievements {
  min-height: 100vh;
  width: 100%;
  background: #1A1814;
  overflow-x: hidden;
}

.content {
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 分享引导：贴在右上角（菜单 ··· 下方），可关闭 —— */
.share-tip {
  position: fixed;
  right: 24rpx;
  top: 16rpx;
  z-index: 120;
  max-width: 420rpx;
}

.share-tip-body {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx 14rpx 18rpx;
  background: #262320;
  border: 1rpx solid rgba(196, 167, 108, 0.32);
  border-radius: var(--radius-md);
}

.share-tip-icon { width: 22rpx; height: 22rpx; flex-shrink: 0; }

.share-tip-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-22);
  color: var(--color-text-body);
}

.share-tip-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-tip-close-icon { width: 22rpx; height: 22rpx; }

.icon-gold {
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

/* —— 卷首 —— */
.cover {
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.cover-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cover-eyebrow,
.sec-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.cover-share {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: var(--fs-24);
  color: var(--brass-300);
}

.cover-title {
  display: block;
  margin-top: 16rpx;
  font-family: var(--font-brand);
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.cover-count {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 36rpx;
}

.cover-num {
  font-family: var(--font-mono);
  font-size: 88rpx;
  line-height: 1;
  color: var(--brass-200);
}

.cover-total {
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

/* 每枚一格：顺序 = 下面五章成长线的顺序 */
.ticks {
  display: flex;
  gap: 5rpx;
  margin-top: 24rpx;
}

.tick {
  flex: 1;
  height: 10rpx;
  border-radius: 2rpx;
  background: rgba(196, 167, 108, 0.14);
}

.tick.is-lit { background: var(--brass-400); }

.cover-points {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.cover-points-icon { width: 28rpx; height: 28rpx; }

.cover-points-t {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.cover-points-v {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--brass-200);
}

/* —— 分区头 —— */
.block { margin-top: 56rpx; }

.sec-head { padding-bottom: 20rpx; }

.sec-head.is-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.sec-head-t { display: flex; flex-direction: column; }

.sec-title {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-34);
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.sec-count {
  font-family: var(--font-mono);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

/* —— 下一枚 —— */
.next {
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.next:last-child { border-bottom: 1rpx solid rgba(196, 167, 108, 0.14); }

.next-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.next-name {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: var(--color-text-body);
}

.next-pct {
  font-family: var(--font-mono);
  font-size: var(--fs-24);
  color: var(--brass-200);
}

.next-bar {
  height: 4rpx;
  margin-top: 16rpx;
  border-radius: 2rpx;
  background: rgba(196, 167, 108, 0.14);
  overflow: hidden;
}

.next-fill {
  height: 100%;
  background: var(--brass-400);
}

.next-foot {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 12rpx;
}

.next-desc,
.next-remain {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.next-remain { flex-shrink: 0; color: var(--brass-300); }

/* 2026-11-23：下一枚可走 —— 奖励积分小签 + 行尾「去点亮 ›」（没有落点的写一句提示） */
.next-top .next-name { flex: 1; min-width: 0; }
.next-reward {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill, 999rpx);
  font-size: var(--fs-18);
  color: var(--brass-300);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.35);
}
.next-foot { align-items: center; }
.next-go {
  flex-shrink: 0;
  padding: 6rpx 0 6rpx 16rpx;
  font-size: var(--fs-22);
  color: var(--brass-200);
}
.next-hint {
  min-width: 0;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  text-align: right;
}

/* —— 成长线 —— */
.track {
  /* 2026-11-22 一行成长线：左列线名 + 差额，右侧节点（原两行：名 + 「下一枚」句，节点另起一行） */
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 0 16rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.track:last-child { border-bottom: 1rpx solid rgba(196, 167, 108, 0.14); }

.track-head {
  flex: none;
  width: 150rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-top: 8rpx;
}

.track-name {
  flex-shrink: 0;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: var(--color-text-body);
}

.track-next {
  min-width: 0;
  font-size: var(--fs-20);
  color: var(--brass-300);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.track-done {
  font-size: var(--fs-20);
  color: var(--brass-300);
  letter-spacing: 0.08em;
}

/* 节点：固定格宽（五枚 = 640rpx 以内），单枚的线也从左起 */
.nodes {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
}

.node-cell {
  position: relative;
  width: 104rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 连线：从本节点圆心到下一节点圆心；通往「下一枚」的那段按进度部分填 */
.node-line {
  position: absolute;
  top: 29rpx;
  left: 50%;
  width: 104rpx;
  height: 2rpx;
  background: rgba(196, 167, 108, 0.18);
}

.node-line-fill {
  height: 100%;
  background: var(--brass-400);
}

.node {
  position: relative;
  z-index: 1;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
  background: #1A1814;
  border: 2rpx solid rgba(196, 167, 108, 0.28);
}

/* 点亮：纸面铭牌（浅纸 + 铜圈 + 墨色罗马数字） */
.node.is-lit {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border: 3rpx solid #B08D57;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
}

.node-roman {
  font-family: var(--font-latin);
  font-size: var(--fs-22);
  color: rgba(196, 167, 108, 0.5);
}

.node.is-lit .node-roman { color: #2E2618; font-weight: 600; }

.node-label {
  margin-top: 10rpx;
  max-width: 100rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.node-label.is-lit { color: var(--brass-200); }

/* 下一枚：铜色虚环 + 标签提亮 —— 一眼看出这条线下一步在哪 */
.node.is-next {
  border: 2rpx dashed var(--brass-400, #C4A76C);
}
.node.is-next .node-roman { color: var(--brass-300); }
.node-label.is-next { color: var(--brass-300); }

/* —— 章目录（2026-11-22）：五章一排，进度弧 + 罗马章号；点一章滚到该章 —— */
.toc {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  padding: 24rpx 8rpx 20rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}
.toc-cell {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.toc-ring {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.toc-ring-in {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #1A1814;
  display: flex;
  align-items: center;
  justify-content: center;
}
.toc-cell.is-done .toc-ring-in {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
}
.toc-no {
  font-family: var(--font-latin);
  font-size: var(--fs-20);
  color: var(--brass-300);
}
.toc-cell.is-done .toc-no { color: #2E2618; font-weight: 600; }
.toc-name {
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  color: var(--color-text-body);
}
.toc-count {
  margin-top: 2rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}
.toc-cell.is-done .toc-count { color: var(--brass-300); }

/* 章进度细线 + 全章点亮印 */
.chapter-bar {
  height: 2rpx;
  margin: 0 0 4rpx;
  background: rgba(196, 167, 108, 0.14);
}
.chapter-bar-fill {
  height: 100%;
  background: var(--brass-400);
}
/* 进度细线已当分隔：第一条成长线不再画自己的顶边（否则两道线贴在一起） */
.chapter-bar + .track { border-top: none; }
.chapter-seal {
  padding: 4rpx 14rpx;
  border: 2rpx solid rgba(196, 72, 58, 0.8);
  border-radius: 4rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-20);
  color: rgba(214, 92, 76, 0.95);
  transform: rotate(-4deg);
}

/* —— 山海拾遗：两列纸签（已偶遇 = 浅纸，未偶遇 = 虚线空签）—— */
.relics-desc {
  display: block;
  margin-bottom: 20rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.relics-cabinet {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.relic {
  position: relative;
  min-height: 148rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 4rpx;
}

.relic.is-lit {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.3);
}

.relic.is-lit::before {
  content: '';
  position: absolute;
  inset: 8rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.relic.is-blank { border: 2rpx dashed rgba(196, 167, 108, 0.22); }

.relic-roman {
  display: block;
  font-family: var(--font-latin);
  font-size: var(--fs-22);
  color: rgba(196, 167, 108, 0.5);
}

.relic.is-lit .relic-roman { color: #8B6F47; }

.relic-title {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
}

.relic.is-lit .relic-title { color: #2E2618; font-weight: 600; }

.relic-hint {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.relic.is-lit .relic-hint { color: #8A7F6C; }

/* —— 骨架 / 错误 —— */
.skeleton { margin-top: 40rpx; }

.skel-line,
.skel-track {
  height: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
  animation: ach-pulse 1.4s ease-in-out infinite;
}

.skel-line.is-big { height: 88rpx; width: 40%; }
.skel-track { height: 120rpx; }

@keyframes ach-pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-title { font-size: var(--fs-30); color: #FFFFFF; }

.empty-text { font-size: var(--fs-24); color: var(--color-text-secondary); }

.retry-btn {
  margin-top: 12rpx;
  padding: 0 40rpx;
  line-height: 72rpx;
  font-size: var(--fs-26);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-md);
}

/* —— 详情 / 点亮弹层：一枚纸面铭牌（ui-pop-mask / ui-pop-dialog 全局零件，docs/弹层视觉规范_2026-10-13.md）—— */
.achievement-modal,
.unlock-overlay { opacity: 0; transition: opacity var(--dur-base) var(--ease-standard); }
.achievement-modal.show,
.unlock-overlay.show { opacity: 1; }

.modal-content,
.unlock-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.modal-close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-icon { width: 28rpx; height: 28rpx; }

.medal {
  width: 152rpx;
  height: 152rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx dashed rgba(196, 167, 108, 0.35);
}

.medal.is-lit {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border: 4rpx solid #B08D57;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.medal.is-big { width: 184rpx; height: 184rpx; }

.medal-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.4;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

/* 铭牌上的图标用墨色（压在浅纸上） */
.medal.is-lit .medal-icon {
  opacity: 1;
  filter: brightness(0) saturate(100%) invert(14%) sepia(18%) saturate(1200%) hue-rotate(5deg) brightness(92%) contrast(92%);
}

.modal-overline {
  margin-top: 28rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.modal-title {
  margin-top: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.modal-cond {
  margin-top: 12rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-body);
}

.modal-rows {
  align-self: stretch;
  margin-top: 28rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.16);
}

.modal-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}

.modal-k { font-size: var(--fs-24); color: var(--color-text-secondary); }

.modal-v {
  font-family: var(--font-mono);
  font-size: var(--fs-24);
  color: var(--color-text-body);
}

.modal-v.is-brass { color: var(--brass-200); }

.next-bar.is-modal { margin-top: 0; }

.modal-remain {
  display: block;
  padding: 12rpx 0 20rpx;
  text-align: left;
  font-size: var(--fs-22);
  color: var(--brass-300);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}

.modal-btn {
  align-self: stretch;
  flex: 1;
  margin-top: 32rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: var(--fs-28);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-md);
}

.modal-btn.is-primary {
  color: #1A1814;
  background: var(--brass-400);
  border-color: var(--brass-400);
  font-weight: 500;
}

.unlock-actions {
  align-self: stretch;
  display: flex;
  gap: 16rpx;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .skel-line,
  .skel-track {
    animation: none;
  }
}

/* 新点亮射灯（2026-10-18）：本机第一次见到的已点亮成就 —— 由暗到亮 + 一道光斜扫过铭牌，只播一次 */
.node.is-fresh { overflow: hidden; animation: node-fresh-lit 0.9s ease-out 0.3s both; }
.node.is-fresh::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -60%;
  width: 40%;
  height: 140%;
  background: linear-gradient(90deg, rgba(255, 248, 230, 0), rgba(255, 248, 230, 0.85), rgba(255, 248, 230, 0));
  transform: rotate(18deg);
  animation: node-fresh-sweep 0.9s ease-in-out 0.9s both;
}
@keyframes node-fresh-lit {
  0% { filter: brightness(0.35); box-shadow: 0 0 0 0 rgba(242, 213, 142, 0); }
  70% { filter: brightness(1.1); box-shadow: 0 0 0 10rpx rgba(242, 213, 142, 0.25); }
  100% { filter: brightness(1); box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35); }
}
@keyframes node-fresh-sweep {
  0% { left: -60%; opacity: 0; }
  20% { opacity: 1; }
  100% { left: 130%; opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .node.is-fresh,
  .node.is-fresh::after { animation: none; }
}

/* 2026-11-22 交互巡查：可点区域扩到约 72rpx（视觉不变；透明 ::after 外扩，事件冒泡到本元素） */
.share-tip-close { position: relative; }
.share-tip-close::after { content: ''; position: absolute; top: -16rpx; right: -16rpx; bottom: -16rpx; left: -16rpx; }

/* 成就详情：未点亮时「知道了 + 去点亮」并排；没有落点时一句提示 */
.modal-actions {
  align-self: stretch;
  display: flex;
  gap: 20rpx;
}
.modal-hint {
  margin-top: 24rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  text-align: center;
}

/* 新点亮（2026-11-23）：卷首下一行铜字，左「新点亮」小签 */
.fresh-note {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-card, 16rpx);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
}
.fresh-k {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: var(--brass-300);
}
.fresh-v {
  min-width: 0;
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  color: var(--brass-200);
}

/* 弹层里的成长线（2026-11-23）：小号节点一排，当前这枚铜框 */
.modal-track {
  align-self: stretch;
  margin-top: 24rpx;
  padding: 18rpx 0 4rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}
.modal-track-t {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  text-align: center;
}
.modal-track-nodes {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 14rpx;
}
.mt-cell { display: flex; flex-direction: column; align-items: center; width: 84rpx; }
.mt-node {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid rgba(196, 167, 108, 0.28);
}
.mt-node.is-lit { background: linear-gradient(180deg, #F3ECDD, #E8DFCB); border-color: #B08D57; }
.mt-node.is-current { box-shadow: 0 0 0 4rpx rgba(196, 167, 108, 0.35); }
.mt-roman { font-family: var(--font-latin); font-size: var(--fs-18); color: rgba(196, 167, 108, 0.6); }
.mt-node.is-lit .mt-roman { color: #2E2618; font-weight: 600; }
.mt-label {
  margin-top: 6rpx;
  max-width: 84rpx;
  font-size: var(--fs-18);
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mt-label.is-current { color: var(--brass-200); }

/* 尚有 N 待点亮（2026-11-23）：同一行靠右，弱一档 */
.cover-points-more {
  margin-left: auto;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}
.fresh-note { align-items: center; }
.fresh-v { flex: 1; }
.fresh-go {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--brass-300);
}
/* 成长线节点可点：命中区补足到 84rpx 宽、上下留白 */
.mt-cell { padding: 6rpx 0; border-radius: var(--r-control, 16rpx); }
