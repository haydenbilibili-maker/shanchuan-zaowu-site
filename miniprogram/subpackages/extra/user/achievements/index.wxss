/* 我的成就 · 馆志（2026-10-17 重设计）
   博物黑底 + 纸面铭牌（点亮的节点）+ 发丝空环（未点亮）；整页没有实心金块，金只用在铭牌圈、刻度和进度线上。 */
page {
  background: #1A1814;
  color: #FFFFFF;
}

.page-achievements {
  min-height: 100vh;
  width: 100%;
  background: #1A1814;
  overflow-x: hidden;
}

.content {
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 分享引导：贴在右上角（菜单 ··· 下方），可关闭 —— */
.share-tip {
  position: fixed;
  right: 24rpx;
  top: 16rpx;
  z-index: 120;
  max-width: 420rpx;
}

.share-tip-body {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx 14rpx 18rpx;
  background: #262320;
  border: 1rpx solid rgba(196, 167, 108, 0.32);
  border-radius: var(--radius-md);
}

.share-tip-icon { width: 22rpx; height: 22rpx; flex-shrink: 0; }

.share-tip-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-22);
  color: var(--color-text-body);
}

.share-tip-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-tip-close-icon { width: 22rpx; height: 22rpx; }

.icon-gold {
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

/* —— 卷首 —— */
.cover {
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.cover-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cover-eyebrow,
.sec-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.cover-share {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: var(--fs-24);
  color: var(--brass-300);
}

.cover-title {
  display: block;
  margin-top: 16rpx;
  font-family: var(--font-brand);
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.cover-count {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 36rpx;
}

.cover-num {
  font-family: var(--font-mono);
  font-size: 88rpx;
  line-height: 1;
  color: var(--brass-200);
}

.cover-total {
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

/* 每枚一格：顺序 = 下面五章成长线的顺序 */
.ticks {
  display: flex;
  gap: 5rpx;
  margin-top: 24rpx;
}

.tick {
  flex: 1;
  height: 10rpx;
  border-radius: 2rpx;
  background: rgba(196, 167, 108, 0.14);
}

.tick.is-lit { background: var(--brass-400); }

.cover-points {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.cover-points-icon { width: 28rpx; height: 28rpx; }

.cover-points-t {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.cover-points-v {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--brass-200);
}

/* —— 分区头 —— */
.block { margin-top: 56rpx; }

.sec-head { padding-bottom: 20rpx; }

.sec-head.is-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.sec-head-t { display: flex; flex-direction: column; }

.sec-title {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-34);
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.sec-count {
  font-family: var(--font-mono);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

/* —— 下一枚 —— */
.next {
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.next:last-child { border-bottom: 1rpx solid rgba(196, 167, 108, 0.14); }

.next-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.next-name {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: var(--color-text-body);
}

.next-pct {
  font-family: var(--font-mono);
  font-size: var(--fs-24);
  color: var(--brass-200);
}

.next-bar {
  height: 4rpx;
  margin-top: 16rpx;
  border-radius: 2rpx;
  background: rgba(196, 167, 108, 0.14);
  overflow: hidden;
}

.next-fill {
  height: 100%;
  background: var(--brass-400);
}

.next-foot {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 12rpx;
}

.next-desc,
.next-remain {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.next-remain { flex-shrink: 0; color: var(--brass-300); }

/* —— 成长线 —— */
.track {
  padding: 28rpx 0 20rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.track:last-child { border-bottom: 1rpx solid rgba(196, 167, 108, 0.14); }

.track-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
}

.track-name {
  flex-shrink: 0;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: var(--color-text-body);
}

.track-next {
  min-width: 0;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.track-done {
  font-size: var(--fs-22);
  color: var(--brass-300);
  letter-spacing: 0.08em;
}

/* 节点：固定格宽（五枚 = 640rpx 以内），单枚的线也从左起 */
.nodes {
  display: flex;
  margin-top: 24rpx;
}

.node-cell {
  position: relative;
  width: 128rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 连线：从本节点圆心到下一节点圆心；通往「下一枚」的那段按进度部分填 */
.node-line {
  position: absolute;
  top: 35rpx;
  left: 50%;
  width: 128rpx;
  height: 2rpx;
  background: rgba(196, 167, 108, 0.18);
}

.node-line-fill {
  height: 100%;
  background: var(--brass-400);
}

.node {
  position: relative;
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
  background: #1A1814;
  border: 2rpx solid rgba(196, 167, 108, 0.28);
}

/* 点亮：纸面铭牌（浅纸 + 铜圈 + 墨色罗马数字） */
.node.is-lit {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border: 3rpx solid #B08D57;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
}

.node-roman {
  font-family: var(--font-latin);
  font-size: var(--fs-22);
  color: rgba(196, 167, 108, 0.5);
}

.node.is-lit .node-roman { color: #2E2618; font-weight: 600; }

.node-label {
  margin-top: 12rpx;
  max-width: 120rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.node-label.is-lit { color: var(--brass-200); }

/* —— 山海拾遗：两列纸签（已偶遇 = 浅纸，未偶遇 = 虚线空签）—— */
.relics-desc {
  display: block;
  margin-bottom: 20rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.relics-cabinet {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.relic {
  position: relative;
  min-height: 148rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 4rpx;
}

.relic.is-lit {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.3);
}

.relic.is-lit::before {
  content: '';
  position: absolute;
  inset: 8rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.relic.is-blank { border: 2rpx dashed rgba(196, 167, 108, 0.22); }

.relic-roman {
  display: block;
  font-family: var(--font-latin);
  font-size: var(--fs-22);
  color: rgba(196, 167, 108, 0.5);
}

.relic.is-lit .relic-roman { color: #8B6F47; }

.relic-title {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
}

.relic.is-lit .relic-title { color: #2E2618; font-weight: 600; }

.relic-hint {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.relic.is-lit .relic-hint { color: #8A7F6C; }

/* —— 骨架 / 错误 —— */
.skeleton { margin-top: 40rpx; }

.skel-line,
.skel-track {
  height: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
  animation: ach-pulse 1.4s ease-in-out infinite;
}

.skel-line.is-big { height: 88rpx; width: 40%; }
.skel-track { height: 120rpx; }

@keyframes ach-pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-title { font-size: var(--fs-30); color: #FFFFFF; }

.empty-text { font-size: var(--fs-24); color: var(--color-text-secondary); }

.retry-btn {
  margin-top: 12rpx;
  padding: 0 40rpx;
  line-height: 72rpx;
  font-size: var(--fs-26);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-md);
}

/* —— 详情 / 点亮弹层：一枚纸面铭牌（ui-pop-mask / ui-pop-dialog 全局零件，docs/弹层视觉规范_2026-10-13.md）—— */
.achievement-modal,
.unlock-overlay { opacity: 0; transition: opacity var(--dur-base) var(--ease-standard); }
.achievement-modal.show,
.unlock-overlay.show { opacity: 1; }

.modal-content,
.unlock-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.modal-close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-icon { width: 28rpx; height: 28rpx; }

.medal {
  width: 152rpx;
  height: 152rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx dashed rgba(196, 167, 108, 0.35);
}

.medal.is-lit {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border: 4rpx solid #B08D57;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.medal.is-big { width: 184rpx; height: 184rpx; }

.medal-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.4;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

/* 铭牌上的图标用墨色（压在浅纸上） */
.medal.is-lit .medal-icon {
  opacity: 1;
  filter: brightness(0) saturate(100%) invert(14%) sepia(18%) saturate(1200%) hue-rotate(5deg) brightness(92%) contrast(92%);
}

.modal-overline {
  margin-top: 28rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.modal-title {
  margin-top: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.modal-cond {
  margin-top: 12rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-body);
}

.modal-rows {
  align-self: stretch;
  margin-top: 28rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.16);
}

.modal-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}

.modal-k { font-size: var(--fs-24); color: var(--color-text-secondary); }

.modal-v {
  font-family: var(--font-mono);
  font-size: var(--fs-24);
  color: var(--color-text-body);
}

.modal-v.is-brass { color: var(--brass-200); }

.next-bar.is-modal { margin-top: 0; }

.modal-remain {
  display: block;
  padding: 12rpx 0 20rpx;
  text-align: left;
  font-size: var(--fs-22);
  color: var(--brass-300);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}

.modal-btn {
  align-self: stretch;
  flex: 1;
  margin-top: 32rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: var(--fs-28);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-md);
}

.modal-btn.is-primary {
  color: #1A1814;
  background: var(--brass-400);
  border-color: var(--brass-400);
  font-weight: 500;
}

.unlock-actions {
  align-self: stretch;
  display: flex;
  gap: 16rpx;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .skel-line,
  .skel-track {
    animation: none;
  }
}

/* 新点亮射灯（2026-10-18）：本机第一次见到的已点亮成就 —— 由暗到亮 + 一道光斜扫过铭牌，只播一次 */
.node.is-fresh { overflow: hidden; animation: node-fresh-lit 0.9s ease-out 0.3s both; }
.node.is-fresh::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -60%;
  width: 40%;
  height: 140%;
  background: linear-gradient(90deg, rgba(255, 248, 230, 0), rgba(255, 248, 230, 0.85), rgba(255, 248, 230, 0));
  transform: rotate(18deg);
  animation: node-fresh-sweep 0.9s ease-in-out 0.9s both;
}
@keyframes node-fresh-lit {
  0% { filter: brightness(0.35); box-shadow: 0 0 0 0 rgba(242, 213, 142, 0); }
  70% { filter: brightness(1.1); box-shadow: 0 0 0 10rpx rgba(242, 213, 142, 0.25); }
  100% { filter: brightness(1); box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35); }
}
@keyframes node-fresh-sweep {
  0% { left: -60%; opacity: 0; }
  20% { opacity: 1; }
  100% { left: 130%; opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .node.is-fresh,
  .node.is-fresh::after { animation: none; }
}
