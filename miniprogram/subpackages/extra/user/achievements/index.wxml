<!-- 我的成就 · 馆志（2026-10-17 重设计）：卷首（大数字 + 每枚一格刻度）→ 下一枚（最近的三枚）→ 五章 × 成长线 → 山海拾遗。
     分档徽章收成一条成长线（点亮 = 纸面铭牌、未点亮 = 发丝空环），不再是 24 张卡 + 三层筛选。 -->
<view class="page-achievements">
  <!-- 分享引导：可关闭，不挡内容 -->
  <view class="share-tip" wx:if="{{showShareTip}}" catchtap="stopPropagation">
    <view class="share-tip-body">
      <image class="share-tip-icon icon-gold" src="/assets/icons/share.png" mode="aspectFit"></image>
      <text class="share-tip-text">请点右上角 ··· 分享</text>
      <view class="share-tip-close" hover-class="tap-press" catchtap="dismissShareTip">
        <image class="share-tip-close-icon icon-gold" src="/subpackages/feature/assets/icons/nav-close-brass.png" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <view class="content">

    <!-- 卷首 -->
    <view class="cover">
      <view class="cover-top">
        <text class="cover-eyebrow">ACHIEVEMENTS · 馆志</text>
        <text class="cover-share" wx:if="{{achievementStats && achievementStats.unlocked}}" bindtap="shareAchievements" hover-class="tap-press" hover-stay-time="80">分享 ›</text>
      </view>
      <text class="cover-title">我的成就</text>
      <block wx:if="{{achievementStats}}">
        <view class="cover-count">
          <text class="cover-num">{{achievementStats.unlocked}}</text>
          <text class="cover-total">/ {{achievementStats.total}} 枚已点亮</text>
        </view>
        <view class="ticks" wx:if="{{ticks.length}}" aria-hidden="true">
          <view class="tick {{item.lit ? 'is-lit' : ''}}" wx:for="{{ticks}}" wx:key="id"></view>
        </view>
        <view class="cover-points" wx:if="{{achievementStats.totalRewards}}">
          <image class="cover-points-icon icon-gold" src="/assets/icons/coin_gold.png" mode="aspectFit"></image>
          <text class="cover-points-t">点亮累计获得积分</text>
          <text class="cover-points-v">{{achievementStats.totalRewards}}</text>
        </view>
      </block>
    </view>

    <!-- 下一枚：离点亮最近的三枚 -->
    <view class="block" wx:if="{{nextUp.length}}">
      <view class="sec-head">
        <text class="sec-eyebrow">NEXT</text>
        <text class="sec-title">下一枚</text>
      </view>
      <view
        class="next"
        wx:for="{{nextUp}}"
        wx:key="id"
        bindtap="viewAchievement"
        data-id="{{item.id}}"
        hover-class="tap-press-soft"
        hover-stay-time="80"
        aria-role="button"
        aria-label="{{item.name}}，{{item.remainText}}"
      >
        <view class="next-top">
          <text class="next-name">{{item.name}}</text>
          <text class="next-pct">{{item.progressPercent}}%</text>
        </view>
        <view class="next-bar"><view class="next-fill" style="width: {{item.progressPercent}}%;"></view></view>
        <view class="next-foot">
          <text class="next-desc">{{item.desc}}</text>
          <text class="next-remain">{{item.remainText}}</text>
        </view>
      </view>
    </view>

    <!-- 五章 × 成长线 -->
    <view class="block chapter" wx:for="{{chapters}}" wx:key="type" wx:for-item="chapter">
      <view class="sec-head is-row">
        <view class="sec-head-t">
          <text class="sec-eyebrow">{{chapter.no}} · {{chapter.enName}}</text>
          <text class="sec-title">{{chapter.name}}</text>
        </view>
        <text class="sec-count">{{chapter.got}}/{{chapter.total}}</text>
      </view>

      <view class="track" wx:for="{{chapter.tracks}}" wx:key="key" wx:for-item="track">
        <view class="track-head">
          <text class="track-name">{{track.name}}</text>
          <text class="track-done" wx:if="{{track.done}}">已全部点亮</text>
          <text class="track-next" wx:else>下一枚「{{track.nextName}}」· {{track.nextRemain}}</text>
        </view>
        <view class="nodes">
          <view class="node-cell" wx:for="{{track.nodes}}" wx:key="id" wx:for-item="node">
            <view class="node-line" wx:if="{{node.linkFill >= 0}}" aria-hidden="true">
              <view class="node-line-fill" style="width: {{node.linkFill}}%;"></view>
            </view>
            <view
              class="node {{node.unlocked ? 'is-lit' : ''}}"
              bindtap="viewAchievement"
              data-id="{{node.id}}"
              hover-class="tap-press"
              hover-stay-time="80"
              aria-role="button"
              aria-label="{{node.achievement.name}}，{{node.unlocked ? '已点亮' : '未点亮'}}"
            >
              <text class="node-roman">{{node.roman}}</text>
            </view>
            <text class="node-label {{node.unlocked ? 'is-lit' : ''}}">{{node.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 山海拾遗：在馆中偶遇的笔记（与积分无关） -->
    <view class="block relics-card">
      <view class="sec-head is-row">
        <view class="sec-head-t">
          <text class="sec-eyebrow">SHANHAI RELICS</text>
          <text class="sec-title">{{relicsName}}</text>
        </view>
        <text class="sec-count">{{relicsFound}}/{{relicsTotal}}</text>
      </view>
      <text class="relics-desc" wx:if="{{relicsUnlocked}}">五页已聚。其余仍藏在馆中，遇见再读即可。</text>
      <text class="relics-desc" wx:else>在馆中偶遇的笔记，会慢慢记在这里。与积分无关。</text>
      <view class="relics-cabinet">
        <view
          class="relic {{item.discovered ? 'is-lit' : 'is-blank'}}"
          wx:for="{{relicsCatalog}}"
          wx:key="id"
          hover-class="tap-press-soft"
          hover-stay-time="80"
          bindtap="openRelic"
          data-id="{{item.id}}"
          aria-role="button"
          aria-label="{{item.discovered ? item.plateTitle : '尚未偶遇的一页'}}"
        >
          <text class="relic-roman">{{item.roman}}</text>
          <text class="relic-title">{{item.plateTitle}}</text>
          <text class="relic-hint">{{item.plateHint}}</text>
        </view>
      </view>
    </view>

    <view class="skeleton" wx:if="{{loading && !chapters.length}}">
      <view class="skel-line is-big"></view>
      <view class="skel-line"></view>
      <view class="skel-track" wx:for="{{3}}" wx:key="*this"></view>
    </view>

    <view class="empty-state" wx:if="{{!loading && loadError && !chapters.length}}">
      <text class="empty-title">档案暂时读不出</text>
      <text class="empty-text">网络不稳或尚未登录时，成就会空着</text>
      <view class="retry-btn" hover-class="tap-press" bindtap="onRetry">重新读取</view>
    </view>

  </view>

  <!-- 成就详情：一枚纸面铭牌 -->
  <view class="ui-pop-mask is-center achievement-modal {{showModal ? 'show' : ''}}" wx:if="{{selectedAchievement}}" catchtap="closeModal" catchtouchmove="true">
    <view class="ui-pop-dialog modal-content" catchtap="stopPropagation">
      <view class="modal-close" hover-class="tap-press" bindtap="closeModal">
        <image class="modal-close-icon icon-gold" src="/subpackages/feature/assets/icons/nav-close-brass.png" mode="aspectFit"></image>
      </view>
      <view class="medal {{selectedAchievement.unlocked ? 'is-lit' : ''}}">
        <image class="medal-icon" src="{{selectedAchievement.icon || '/assets/icons/medal_gold.png'}}" mode="aspectFit"></image>
      </view>
      <text class="modal-overline">{{selectedAchievement.typeEn || 'BADGE'}} · {{selectedAchievement.statusLabel}}</text>
      <text class="modal-title">{{selectedAchievement.name}}</text>
      <text class="modal-cond">{{selectedAchievement.condition || selectedAchievement.desc}}</text>

      <view class="modal-rows">
        <view class="modal-row" wx:if="{{!selectedAchievement.unlocked}}">
          <text class="modal-k">进度</text>
          <text class="modal-v">{{selectedAchievement.progressText}}</text>
        </view>
        <view class="next-bar is-modal" wx:if="{{!selectedAchievement.unlocked}}"><view class="next-fill" style="width: {{selectedAchievement.progressPercent}}%;"></view></view>
        <text class="modal-remain" wx:if="{{!selectedAchievement.unlocked}}">{{selectedAchievement.remainText}}</text>
        <view class="modal-row" wx:if="{{selectedAchievement.rewardPoints > 0}}">
          <text class="modal-k">点亮奖励</text>
          <text class="modal-v is-brass">+{{selectedAchievement.rewardPoints}} 积分{{selectedAchievement.unlocked ? ' · 已计入' : ''}}</text>
        </view>
      </view>

      <view class="modal-btn is-primary" wx:if="{{selectedAchievement.unlocked}}" hover-class="tap-press" hover-stay-time="80" bindtap="shareSingleAchievement">分享这枚徽章</view>
      <view class="modal-btn" wx:else hover-class="tap-press" hover-stay-time="80" bindtap="closeModal">知道了</view>
    </view>
  </view>

  <!-- 点亮提示 -->
  <view class="ui-pop-mask is-center is-deep unlock-overlay {{showUnlockAnimation ? 'show' : ''}}" wx:if="{{unlockedAchievement}}" catchtap="closeUnlockAnimation" catchtouchmove="true">
    <view class="ui-pop-dialog unlock-content" catchtap="stopPropagation">
      <view class="medal is-lit is-big">
        <image class="medal-icon" src="{{unlockedAchievement.icon || '/assets/icons/medal_gold.png'}}" mode="aspectFit"></image>
      </view>
      <text class="modal-overline">ACHIEVEMENT · 新点亮</text>
      <text class="modal-title">{{unlockedAchievement.name}}</text>
      <text class="modal-cond" wx:if="{{unlockedAchievement.rewardPoints > 0}}">+{{unlockedAchievement.rewardPoints}} 积分，已计入累计</text>
      <text class="modal-cond" wx:else>已收入你的馆志</text>
      <view class="unlock-actions">
        <view class="modal-btn" hover-class="tap-press" hover-stay-time="80" bindtap="closeUnlockAnimation">知道了</view>
        <view class="modal-btn is-primary" hover-class="tap-press" hover-stay-time="80" bindtap="shareUnlockedAchievement">分享</view>
      </view>
    </view>
  </view>
  <easter-egg-note id="easterEggNote" />
</view>
