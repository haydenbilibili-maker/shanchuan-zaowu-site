/* 联系专员 · 专员服务台（2026-10-17 重构）
   页头眉标 + 宋体主标；服务时间 / 响应为发丝线两栏行；咨询类型方角发丝签、选中金线环；
   联系方式为发丝线行，实心金只给「开始对话」（微信专员是主路径）；留言写在浅纸便笺上，提交为金线环；
   FAQ / 到店为发丝线行。页头高度仍由 index.js 按 statusBar + 72px 计算，内容高度不得超过它。
   附图九宫格样式在 ../../utils/ticket-images.wxss（与意见反馈共用，勿在此改）。 */
@import '../../utils/ticket-images.wxss';

page {
  background: #1A1814;
  color: var(--mat-paper-tone);
}

.page-support {
  min-height: 100vh;
  position: relative;
  background: #1A1814;
}

/* —— 页头（2026-11-26 与订单认领同构：短金线 + 眉标 + 宋体主标 + 一句说明；不再有固定页头叠在系统导航栏下） —— */
.sp-head {
  padding: 52rpx 40rpx 30rpx;
}
.sp-rule {
  width: 48rpx;
  height: 4rpx;
  margin-bottom: 28rpx;
  border-radius: 2rpx;
  background: var(--brass-400, #C4A76C);
}
.sp-en {
  display: block;
  font-size: var(--fs-20);
  font-weight: 500;
  letter-spacing: 0.18em;
  color: var(--brass-600, #8A7530);
}
.sp-cn {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-48);
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-text-primary, #FFFFFF);
}
.sp-desc {
  display: block;
  max-width: 620rpx;
  margin-top: 20rpx;
  font-size: var(--fs-24);
  line-height: 1.65;
  color: var(--color-text-secondary, #A09A90);
}
.main-flow { padding-bottom: env(safe-area-inset-bottom); }

/* —— 骨架 —— */
.skeleton-wrap { padding: 32rpx; }

.sk-card {
  height: 180rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-card, 16rpx);
  background: #1F1D1A;
}

.sk-card.short { height: 120rpx; }

.sk-shine {
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.04) 0%, rgba(196, 167, 108, 0.09) 50%, rgba(196, 167, 108, 0.04) 100%);
  background-size: 200% 100%;
  animation: shine 1.4s ease infinite;
}

@keyframes shine {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* —— 分区 —— */
.section { padding: 0 32rpx 40rpx; }

.section-hint {
  display: block;
  margin: -8rpx 0 20rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: var(--color-text-secondary, #A09A90);
}

/* —— 服务信息：发丝线两栏行 —— */
.service-card {
  margin: 0 32rpx 36rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.service-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.service-label {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.service-val {
  flex: 1;
  text-align: right;
  font-size: var(--fs-26);
  color: var(--mat-paper-tone);
}

.service-val.muted {
  font-size: var(--fs-22);
  line-height: 1.55;
  color: var(--color-text-secondary, #A09A90);
}

.context-banner {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-card, 16rpx);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass-soft);
}

.context-banner.soft { background: transparent; box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2); }

.context-text {
  font-size: var(--fs-22);
  line-height: 1.6;
  white-space: pre-wrap;
  color: var(--brass-200);
}

.context-banner.soft .context-text { color: var(--color-text-secondary, #A09A90); }

/* —— 会话上下文条（订单 / 藏品进线时） —— */
/* 2026-11-26：随页面流动，落在品牌头下面（原固定在自绘页头下） */
.context-strip {
  box-sizing: border-box;
  padding: 0 32rpx 8rpx;
}

.context-card {
  display: flex;
  flex-direction: column;
  padding: 18rpx 20rpx 16rpx;
  border-radius: var(--r-card, 16rpx);
  background: #1F1D1A;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
  box-sizing: border-box;
}

.context-card.is-tappable { box-shadow: var(--ring-brass-soft); }

.context-card-press { background: rgba(196, 167, 108, 0.06); }

.context-card-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.context-thumb {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-thumb-sm, 8rpx);
  background: #262320;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
}

.context-thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}


.context-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.context-kind {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  line-height: 1.2;
  color: var(--brass-300);
}

.context-title {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  line-height: 1.35;
  color: var(--mat-paper-tone);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-sub {
  font-size: var(--fs-22);
  line-height: 1.35;
  color: var(--color-text-secondary, #A09A90);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: var(--r-pill, 999rpx);
  box-shadow: var(--ring-brass-soft);
  background: rgba(196, 167, 108, 0.08);
}

.context-go-label {
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: var(--brass-200);
}

.context-go-arrow {
  margin-top: -2rpx;
  font-size: var(--fs-28);
  line-height: 1;
  color: var(--brass-200);
}

.context-tip {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.context-tip-text {
  display: block;
  font-size: var(--fs-20);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

/* —— 咨询类型：方角发丝签，选中金线环 —— */
.topic-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
}

.topic-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  padding: 24rpx 22rpx;
  border-radius: var(--r-card, 16rpx);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2);
  box-sizing: border-box;
}

.topic-item.active { background: rgba(196, 167, 108, 0.12); box-shadow: var(--ring-brass); }
.topic-item:active { transform: scale(0.985); }

/* 图标统一成同一种黄铜色（各主题 icon 来源不同、深浅不一 → 用滤镜统一，选中再提亮一档） */
.topic-head { display: flex; align-items: center; justify-content: space-between; width: 100%; }
.topic-pick {
  font-size: var(--fs-18);
  line-height: 1.4;
  color: var(--mat-ink);
  background: var(--mat-brass);
  border-radius: var(--r-thumb-sm, 4rpx);
  padding: 1rpx 8rpx;
}

.topic-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.92;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}
.topic-item.active .topic-icon { opacity: 1; filter: brightness(0) saturate(100%) invert(84%) sepia(28%) saturate(700%) hue-rotate(2deg) brightness(104%) contrast(96%); }

.topic-label {
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  line-height: 1.35;
  color: var(--mat-paper-tone);
}

.topic-item.active .topic-label { color: var(--brass-200); }

.topic-desc {
  font-size: var(--fs-20);
  line-height: 1.45;
  word-break: break-all;
  color: var(--color-text-secondary, #A09A90);
}

/* —— 联系方式：发丝线行；实心金只给「开始对话」 —— */
.channel-list { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.channel-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.channel-info { flex: 1; min-width: 0; }

.channel-name {
  display: block;
  margin-bottom: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--mat-paper-tone);
}

.channel-desc {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.channel-item.primary .channel-desc { color: var(--brass-200); }

.channel-arrow {
  flex-shrink: 0;
  font-size: var(--fs-32);
  color: var(--brass-300);
}

/* —— 留言：浅纸便笺（墨色宋体），提交为金线环 —— */
.form-card {
  position: relative;
  padding: 32rpx 28rpx 28rpx;
  border-radius: var(--r-card, 16rpx);
  background: var(--mat-paper-label);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.42);
  color: var(--mat-ink);
}

.message-input {
  width: 100%;
  min-height: 200rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  line-height: 1.75;
  color: var(--mat-ink);
  box-sizing: border-box;
}

.ph { color: rgba(46, 38, 24, 0.42); }

/* 附图块落在浅纸上：只改字色，九宫格本体沿用共享样式 */
.form-card .ti-label,
.form-card .ti-count { color: #8A7F6C; }

.form-card .ti-warn { color: #8B4A2B; }

.form-card .ti-add { background: rgba(46, 38, 24, 0.04); border-color: rgba(139, 111, 71, 0.5); }
.form-card .ti-add-plus { color: #8B6F47; }
.form-card .ti-add-text { color: #8A7F6C; }

.phone-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(46, 38, 24, 0.14);
}

.phone-label {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: #8A7F6C;
}

.phone-input {
  flex: 1;
  background: transparent;
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--mat-ink);
}

.form-actions {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(46, 38, 24, 0.14);
}

/* 原生 <button> 自带 margin / 宽度，需 !important 才压得住（沿用原写法） */
.submit-btn {
  width: 100% !important;
  margin: 0 !important;
  padding: 0 32rpx;
  height: 84rpx;
  line-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
  border-radius: var(--r-control, 16rpx);
  background: transparent !important;
  box-shadow: inset 0 0 0 2rpx #8B6F47;
  font-size: var(--fs-28);
  font-weight: 600;
  letter-spacing: 0.16em;
  color: #5A4527 !important;
}

.submit-btn::after { border: none; }

.submit-btn-press { background: rgba(139, 111, 71, 0.1) !important; }

.submit-btn[disabled],
.submit-btn.is-loading {
  background: transparent !important;
  box-shadow: inset 0 0 0 1rpx rgba(46, 38, 24, 0.24);
  color: rgba(46, 38, 24, 0.45) !important;
  opacity: 1;
}

/* —— FAQ：发丝线行 —— */
.faq-list { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.faq-item {
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.faq-item.expanded { background: rgba(196, 167, 108, 0.04); }

.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  font-size: var(--fs-26);
  line-height: 1.5;
  color: var(--mat-paper-tone);
}

.faq-toggle {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-32);
  line-height: 1;
  color: var(--brass-300);
}

.faq-a {
  display: block;
  margin-top: 14rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid rgba(196, 167, 108, 0.35);
  font-size: var(--fs-24);
  line-height: 1.7;
  color: var(--color-text-secondary, #A09A90);
}

/* —— 到店：发丝线行 —— */
.visit-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 4rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.visit-addr {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--mat-paper-tone);
}

.visit-link {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--brass-300);
}

.footer-pad { height: calc(48rpx + env(safe-area-inset-bottom)); }

/* —— 社群弹窗（壳由 ui-pop-* 统一，这里只排内容） —— */
.modal-mask.active {
  opacity: 1;
  pointer-events: all;
}

.modal-sheet {
  width: 620rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-28);
  color: var(--color-text-secondary, #A09A90);
}

.modal-title {
  margin-bottom: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  letter-spacing: 0.08em;
}

.modal-sub {
  margin-bottom: 32rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.community-qr {
  width: 360rpx;
  height: 360rpx;
  padding: 16rpx;
  border-radius: var(--r-thumb-sm, 8rpx);
  background: var(--mat-paper-tone);
  box-sizing: border-box;
}

.modal-tip {
  margin-top: 24rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .sk-shine { animation: none; }
}

/* 2026-11-22 交互巡查：可点区域扩到约 64rpx（视觉不变；透明 ::after 外扩，事件冒泡到本元素） */
.modal-close::after { content: ''; position: absolute; top: -12rpx; right: -12rpx; bottom: -12rpx; left: -12rpx; }

/* 首屏主行动（2026-11-26）：开始对话上移到第一屏，类型选择结果在这里回显 */
.hero-talk {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 32rpx 26rpx;
  padding: 26rpx 24rpx;
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.34);
}
.hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.hero-k { font-size: var(--fs-18); letter-spacing: 0.2em; color: var(--brass-300); }
.hero-t { font-family: var(--font-brand); font-size: var(--fs-34); color: var(--mat-paper-tone); }
/* 2026-11-26：暗底上的说明字改用暗底次级字（原 --mat-ink-soft 是纸上的墨，放暗底上对比不足） */
.hero-k-row { display: flex; align-items: center; gap: 12rpx; }
.hero-live {
  padding: 0 12rpx;
  border-radius: var(--r-pill, 999rpx);
  font-size: var(--fs-18);
  line-height: 30rpx;
  color: var(--color-text-secondary, #A09A90);
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.4);
}
.hero-live.is-on { color: var(--color-success, #52B788); box-shadow: inset 0 0 0 1rpx rgba(82, 183, 136, 0.45); }
.hero-s {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 2rpx;
  font-size: var(--fs-22);
  line-height: 1.45;
  color: var(--color-text-secondary, #A09A90);
}
.hero-s.is-off { color: var(--color-text-secondary, #A09A90); }
.hero-s-go { flex-shrink: 0; color: var(--brass-200, #E0CFA3); }
.hero-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 30rpx;
  height: 76rpx;
  line-height: 76rpx;
  border: none;
  border-radius: var(--r-pill, 999rpx);
  background: var(--mat-brass);
  color: var(--mat-ink);
  font-size: var(--fs-24);
  font-weight: 600;
}
.hero-btn::after { border: none; }
/* 微信内置 button:not([size=mini]) { width: 184px } 比单类名优先，两层类名压回自适应宽 */
.hero-talk .hero-btn { width: auto; }

/* 订单类咨询：指定具体订单（2026-11-26） */
.hero-order {
  flex-basis: 100%;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.18);
}
.hero-talk { display: flex; flex-wrap: wrap; }
.hero-order-t { flex: 1; min-width: 0; font-size: var(--fs-22); color: var(--mat-paper-tone); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.hero-order-t.is-empty { color: var(--color-text-secondary, #A09A90); }
.hero-order-a { flex-shrink: 0; font-size: var(--fs-22); color: var(--brass-200); }
.hero-order-x { flex-shrink: 0; font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); padding: 0 4rpx; }

.order-picker-body { max-height: 60vh; padding: 0 0 24rpx; }
.order-picker-tip { padding: 24rpx; font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); }
/* 选择咨询订单（2026-11-26 二改：按商品认单） */
.op-sheet { padding-bottom: env(safe-area-inset-bottom); }
.op-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 32rpx var(--pop-pad-x, 40rpx) 18rpx;
}
.op-head-t { display: flex; flex-direction: column; gap: 6rpx; }
.op-kicker { font-size: var(--fs-18); letter-spacing: 0.2em; color: var(--brass-600, #8A7530); }
.op-title-main { font-family: var(--font-brand); font-size: var(--fs-34); font-weight: 600; color: var(--color-text-primary, #FFFFFF); }
.op-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  background: rgba(255, 255, 255, 0.04);
}
.op-search { padding: 0 var(--pop-pad-x, 40rpx) 14rpx; }
.op-search-input {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill, 999rpx);
  background: rgba(255, 255, 255, 0.04);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2);
  font-size: var(--fs-24);
  color: var(--color-text-primary, #FFFFFF);
}
.op-ph { color: var(--color-text-secondary, #A09A90); }
.order-pick-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx var(--pop-pad-x, 40rpx);
  border-top: 1rpx solid rgba(196, 167, 108, 0.08);
}
.order-pick-row.is-picked { background: rgba(196, 167, 108, 0.08); }
.op-thumb {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--r-thumb-sm, 8rpx);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108, 0.08);
}
.op-thumb-img { width: 104rpx; height: 104rpx; }
.op-thumb-ico {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}
.op-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.op-line1 { display: flex; align-items: baseline; gap: 8rpx; min-width: 0; }
.op-title { min-width: 0; font-size: var(--fs-26); font-weight: 600; color: var(--mat-paper-tone); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.op-more { flex-shrink: 0; font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); }
.op-spec { font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.op-sub { font-family: var(--font-mono); font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); }
.op-status { color: var(--brass-200, #E0CFA3); }
.op-go { flex-shrink: 0; color: var(--brass-300); }
.op-check {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: var(--r-pill, 999rpx);
  font-size: var(--fs-20);
  color: var(--brass-200, #E0CFA3);
  box-shadow: var(--ring-brass-soft);
}

/* 上下文卡占位图标（2026-11-26：不再用「单 / 藏」文字当图标） */
.context-thumb-ico {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

/* 直接办理（发票 / 标本师招募）：发丝线行，不占咨询类型宫格 */
.direct-list { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }
.direct-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.1);
}
.direct-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.direct-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.direct-l { font-size: var(--fs-26); color: var(--mat-paper-tone); }
.direct-d { font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); }
/* 直接办理与即时联系同一种行：圆形铜底图标 + 名称 / 说明 + › */
.row-ico {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108, 0.1);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2);
}
.row-ico .direct-icon {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}
.channel-item { justify-content: flex-start; }
.direct-item { gap: 20rpx; }

/* 选完就地开聊：发丝金描边（页面唯一实心金留给首屏「开始对话」） */
.topic-go {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx 16rpx 16rpx 22rpx;
  border-radius: var(--r-card, 16rpx);
  background: rgba(196, 167, 108, 0.06);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
}
.topic-go-copy { flex: 1; min-width: 0; display: flex; align-items: baseline; gap: 10rpx; }
.topic-go-k { flex-shrink: 0; font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); }
.topic-go-t { min-width: 0; font-size: var(--fs-26); color: var(--mat-paper-tone); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.topic-go .topic-go-btn {
  flex-shrink: 0;
  width: auto;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border: none;
  border-radius: var(--r-pill, 999rpx);
  background: rgba(196, 167, 108, 0.14);
  box-shadow: var(--ring-brass-soft);
  color: var(--brass-200, #E0CFA3);
  font-size: var(--fs-24);
  font-weight: 600;
}
.topic-go .topic-go-btn::after { border: none; }

/* 留言字数 */
.message-count { display: block; margin-top: 4rpx; text-align: right; font-family: var(--font-mono); font-size: var(--fs-18); color: var(--mat-ink-label); }
.direct-go { flex-shrink: 0; color: var(--brass-300); }

/* 类型一行：长了就省略，别把「换类型」挤掉 */
.hero-s { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.hero-s text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hero-s-go { flex-shrink: 0; }

/* 首屏信号灯：绿=服务时间、红=非服务时间（颜色走全局 .lamp-forest / .lamp-error 令牌） */
.hero-lamp { margin-right: 2rpx; }

/* 到店咨询卡（2026-11-26，参考品牌故事的地图模块）：小地图 + 地址 + 营业时间 + 导航 */
.visit-card { display: flex; flex-direction: column; gap: 16rpx; }
.visit-map-box {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
}
.visit-map { width: 100%; height: 100%; filter: brightness(0.78) contrast(1.15) saturate(0.9) sepia(0.12); }
.visit-map-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 12rpx 16rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 40%, rgba(0, 0, 0, 0.45) 100%);
}
.visit-map-mask text { font-size: var(--fs-18); letter-spacing: 0.14em; color: var(--mat-paper-tone); }
.visit-body { display: flex; flex-direction: column; gap: 8rpx; }
.visit-row { display: flex; align-items: flex-start; gap: 12rpx; }
.visit-addr { flex: 1; min-width: 0; font-size: var(--fs-24); line-height: 1.5; color: var(--mat-paper-tone); }
.visit-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.visit-hours { font-size: var(--fs-20); color: var(--mat-ink-soft); }
.visit-link { flex-shrink: 0; font-size: var(--fs-22); color: var(--brass-200); }
