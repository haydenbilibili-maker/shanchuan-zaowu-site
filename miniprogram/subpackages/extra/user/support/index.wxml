<!--subpackages/extra/user/support/index.wxml-->
<!-- 2026-10-17「专员服务台」重构：页头眉标 + 宋体主标；服务时间 / 响应为发丝线两栏行；咨询类型方角发丝签、选中金线环；
     联系方式发丝线行，实心金只给「开始对话」（微信专员 = 主路径）；留言写在浅纸便笺上，提交为金线环；FAQ / 到店为发丝线行。数据与交互不变。 -->
<view class="page-support">

  <view class="sticky-header" style="padding-top: {{statusBarHeight}}px; padding-right: {{navPaddingRight}}px;">
    <view class="nav-row">
      <view class="nav-brand">
        <text class="nav-sub">SUPPORT DESK · 专员服务台</text>
        <text class="nav-title">联系专员</text>
      </view>
    </view>
  </view>

  <!-- 会话上下文卡：订单/藏品进线时固定展示，便于用户与专员对齐 -->
  <view
    class="context-strip"
    wx:if="{{contextCard.visible}}"
    style="top: {{headerHeight}}px;"
  >
    <view
      class="context-card {{contextCard.tapPath ? 'is-tappable' : ''}}"
      hover-class="{{contextCard.tapPath ? 'context-card-press' : ''}}"
      hover-stay-time="80"
      bindtap="openContextTarget"
    >
      <view class="context-card-main">
        <shan-img ext-class="context-thumb" wx:if="{{contextCard.image}}" src="{{contextCard.image}}" mode="aspectFill" mark="{{false}}" />
        <view class="context-thumb placeholder" wx:else>
          <shan-img ext-class="context-thumb-ico" src="{{contextCard.kind === 'order' ? '/assets/icons/cart.png' : '/assets/icons/knowledge.png'}}" mode="aspectFit" mark="{{false}}" />
        </view>
        <view class="context-meta">
          <text class="context-kind">{{contextCard.kindLabel}}</text>
          <text class="context-title">{{contextCard.title}}</text>
          <text class="context-sub" wx:if="{{contextCard.subtitle}}">{{contextCard.subtitle}}</text>
        </view>
        <view class="context-go" wx:if="{{contextCard.tapPath}}">
          <text class="context-go-label">{{contextCard.actionLabel || '查看'}}</text>
          <text class="context-go-arrow">›</text>
        </view>
      </view>
      <view class="context-tip" wx:if="{{contextCard.tip}}">
        <text class="context-tip-text">{{contextCard.tip}}</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="main-scroll" style="top: {{scrollTop}}px;">
    <view class="skeleton-wrap" wx:if="{{loading}}">
      <view class="sk-card sk-shine"></view>
      <view class="sk-card sk-shine short"></view>
    </view>

    <block wx:else>
      <!-- 首屏主行动（2026-11-26 产品负责人：开始对话要在第一屏显著位置） -->
      <view class="hero-talk">
        <view class="hero-copy">
          <text class="hero-k">微信专员</text>
          <text class="hero-t">开始对话</text>
          <text class="hero-s">已选：{{activeTopicLabel}} · 专员会在 {{config.responseHint || '工作时间内 30 分钟'}} 回复</text>
        </view>
        <button
          class="hero-btn"
          open-type="contact"
          session-from="{{sessionFrom}}"
          send-message-title="{{sendMessageTitle}}"
          send-message-path="{{sendMessagePath}}"
          send-message-img="{{sendMessageImg}}"
          show-message-card="{{showMessageCard}}"
          bindcontact="onContactTap"
        >开始对话</button>
        <!-- 订单类咨询：让顾客直接指定哪一单（2026-11-26），专员在会话标签与卡片里就能看到 -->
        <view class="hero-order" wx:if="{{activeTopic === 'order' || activeTopic === 'refund' || activeTopic === 'invoice'}}">
          <block wx:if="{{pickedOrderNo}}">
            <text class="hero-order-t">已选订单 · {{pickedOrderNo}}</text>
            <text class="hero-order-a" bindtap="openOrderPicker" hover-class="tap-press-soft" hover-stay-time="80">换一单</text>
            <text class="hero-order-x" bindtap="clearPickedOrder" hover-class="tap-press-soft" hover-stay-time="80">✕</text>
          </block>
          <block wx:else>
            <text class="hero-order-t is-empty">还没指定订单</text>
            <text class="hero-order-a" bindtap="openOrderPicker" hover-class="tap-press-soft" hover-stay-time="80">选择订单 ›</text>
          </block>
        </view>
      </view>

      <!-- 服务信息 -->
      <view class="service-card">
        <view class="service-row">
          <text class="service-label">服务时间</text>
          <text class="service-val">{{config.hours || '上午10点至下午5点'}}</text>
        </view>
        <view class="service-row">
          <text class="service-label">响应说明</text>
          <text class="service-val muted">{{config.responseHint}}</text>
        </view>
        <view class="context-banner" wx:if="{{contextSummary && !contextCard.visible}}">
          <text class="context-text">{{contextSummary}}</text>
        </view>
        <view class="context-banner soft" wx:if="{{hasConsultContext && !contextCard.visible}}">
          <text class="context-text">进入微信会话后，点右下角发送卡片，专员即可看到对应订单或藏品。</text>
        </view>
      </view>

      <!-- 咨询主题 -->
      <view class="section">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">TOPICS</text><text class="mu-cn">选择咨询类型</text></view></view>
        <text class="section-hint">选中的类型会写进会话标签，专员一进来就知道你在问什么（也会带进下面的留言）。</text>
        <view class="topic-grid">
          <view
            class="topic-item {{activeTopic === item.id ? 'active' : ''}}"
            wx:for="{{topics}}"
            wx:key="id"
            hover-class="tap-press-soft" hover-stay-time="80"
            bindtap="selectTopic"
            data-id="{{item.id}}"
          >
            <view class="topic-head">
              <image class="topic-icon" src="{{item.icon}}" mode="aspectFit"></image>
              <text class="topic-pick" wx:if="{{activeTopic === item.id}}">已选</text>
            </view>
            <text class="topic-label">{{item.label}}</text>
            <text class="topic-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 直接办理（2026-11-26 产品负责人：发票 / 标本师招募是功能入口，不混在咨询类型里） -->
      <view class="section" wx:if="{{directActions.length}}">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">DIRECT</text><text class="mu-cn">直接办理</text></view></view>
        <view class="direct-list">
          <view
            class="direct-item"
            wx:for="{{directActions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="selectTopic"
            hover-class="tap-press-soft"
            hover-stay-time="80"
            aria-role="button"
            aria-label="{{item.label}}"
          >
            <shan-img ext-class="direct-icon" src="{{item.icon}}" mode="aspectFit" mark="{{false}}" />
            <view class="direct-copy">
              <text class="direct-l">{{item.label}}</text>
              <text class="direct-d">{{item.desc}}</text>
            </view>
            <text class="direct-go">›</text>
          </view>
        </view>
      </view>

      <!-- 联系方式 -->
      <view class="section">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">CONTACT</text><text class="mu-cn">即时联系</text></view></view>
        <view class="channel-list">
          <view class="channel-item" hover-class="tap-press-soft" hover-stay-time="80" bindtap="callPhone">
            <view class="channel-info">
              <text class="channel-name">电话专线</text>
              <text class="channel-desc">{{config.phone}}</text>
            </view>
            <text class="channel-arrow">›</text>
          </view>

          <view class="channel-item" hover-class="tap-press-soft" hover-stay-time="80" bindtap="goMessages">
            <view class="channel-info">
              <text class="channel-name">山海有信</text>
              <text class="channel-desc">查看系统通知与留言回执</text>
            </view>
            <text class="channel-arrow">›</text>
          </view>

          <view class="channel-item" hover-class="tap-press-soft" hover-stay-time="80" bindtap="openCommunity">
            <view class="channel-info">
              <text class="channel-name">官方社群</text>
              <text class="channel-desc">添加微信助手后入群</text>
            </view>
            <text class="channel-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 留言表单 -->
      <view class="section">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">LEAVE A NOTE</text><text class="mu-cn">留言给专员</text></view></view>
        <text class="section-hint">若暂时无法接入微信客服，可留下文字说明，专员会通过山海有信回复</text>
        <view class="form-card">
          <textarea
            class="message-input"
            placeholder="请描述您的问题（至少 5 字）"
            placeholder-class="ph"
            maxlength="500"
            value="{{messageText}}"
            bindinput="onMessageInput"
            bindblur="onMessageInput"
          ></textarea>
          <view class="ti-block">
            <view class="ti-head">
              <text class="ti-label">附图（选填，最多 {{maxTicketImages}} 张）</text>
              <text class="ti-count">{{ticketImages.length}}/{{maxTicketImages}}</text>
            </view>
            <view class="ti-grid">
              <view class="ti-cell" wx:for="{{ticketImages}}" wx:key="key">
                <shan-img ext-class="ti-img" src="{{item.local}}" mode="aspectFill" bindtap="previewTicketImage" data-url="{{item.local}}" />
                <view class="ti-mask" wx:if="{{item.status === 'uploading'}}"><text class="ti-mask-text">上传中…</text></view>
                <view class="ti-mask is-failed" wx:elif="{{item.status === 'failed'}}" hover-class="tap-press-soft" hover-stay-time="80" catchtap="retryTicketImage" data-key="{{item.key}}"><text class="ti-mask-text">上传失败</text><text class="ti-mask-text">点此重试</text></view>
                <view hover-class="tap-press" hover-stay-time="80" class="ti-del" catchtap="removeTicketImage" data-key="{{item.key}}"><text class="ti-del-x">×</text></view>
              </view>
              <view class="ti-cell ti-add" wx:if="{{ticketImages.length < maxTicketImages}}" hover-class="tap-press-soft" hover-stay-time="80" bindtap="chooseTicketImages">
                <text class="ti-add-plus">+</text>
                <text class="ti-add-text">添加图片</text>
              </view>
            </view>
            <text class="ti-warn" wx:if="{{ticketImgFailed}}">有 {{ticketImgFailed}} 张没传上去，点图片重试或删掉后再提交</text>
          </view>
          <view class="phone-row">
            <text class="phone-label">联系电话（选填）</text>
            <input
              class="phone-input"
              type="number"
              maxlength="11"
              placeholder="便于专员回拨"
              placeholder-class="ph"
              value="{{contactPhone}}"
              bindinput="onPhoneInput"
            />
          </view>
          <view class="form-actions">
            <button
              class="submit-btn {{submitting ? 'is-loading' : ''}}"
              hover-class="submit-btn-press"
              hover-stay-time="80"
              bindtap="submitTicket"
              loading="{{submitting}}"
              disabled="{{submitting || ticketImgBusy}}"
            >{{submitting ? '提交中…' : (ticketImgBusy && !ticketImgFailed ? '图片上传中…' : '提交留言')}}</button>
          </view>
        </view>
      </view>

      <!-- 常见问题 -->
      <view class="section" wx:if="{{faqs.length}}">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">FAQ</text><text class="mu-cn">常见问题</text></view></view>
        <view class="faq-list">
          <view hover-class="tap-press-soft" hover-stay-time="80"
            class="faq-item {{expandedFaq === index ? 'expanded' : ''}}"
            wx:for="{{faqs}}"
            wx:key="index"
            bindtap="toggleFaq"
            data-index="{{index}}"
          >
            <view class="faq-q">
              <text>{{item.q}}</text>
              <text class="faq-toggle">{{expandedFaq === index ? '−' : '+'}}</text>
            </view>
            <text class="faq-a" wx:if="{{expandedFaq === index}}">{{item.a}}</text>
          </view>
        </view>
      </view>

      <!-- 到店信息 -->
      <view class="section visit-section">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">VISIT US</text><text class="mu-cn">到店咨询</text></view></view>
        <view class="visit-card" hover-class="tap-press-soft" hover-stay-time="80" bindtap="openMap">
          <text class="visit-addr">{{config.address || '门店地址加载中'}}</text>
          <text class="visit-link">导航前往 ›</text>
        </view>
      </view>

      <view class="footer-pad"></view>
    </block>
  </scroll-view>

  <!-- 社群弹窗 -->
  <view class="ui-pop-mask is-center modal-mask {{showCommunity ? 'active' : ''}}" bindtap="closeCommunity" wx:if="{{showCommunity}}" catchtouchmove="true">
    <view class="ui-pop-dialog modal-sheet" catchtap="true">
      <view hover-class="tap-press" hover-stay-time="80" class="modal-close" bindtap="closeCommunity">✕</view>
      <text class="modal-title">官方社群</text>
      <text class="modal-sub">COMMUNITY</text>
      <shan-img ext-class="community-qr" src="{{config.communityQr}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
      <text class="modal-tip">长按识别添加微信助手，随后拉入官方服务微信群</text>
    </view>
  </view>

  <!-- 选择咨询订单（2026-11-26）：订单 / 退款 / 发票类咨询指定具体一单 -->
  <view class="ui-pop-mask" wx:if="{{orderPickerOpen}}" catchtap="closeOrderPicker" catchtouchmove="true">
    <view class="ui-pop-sheet modal-panel" catchtap="true">
      <view class="modal-head">
        <text>选择咨询的订单</text>
        <view class="close-btn" hover-class="tap-press" hover-stay-time="80" catchtap="closeOrderPicker">✕</view>
      </view>
      <scroll-view scroll-y class="order-picker-body">
        <view class="order-picker-tip" wx:if="{{orderPickerLoading}}">正在读取订单…</view>
        <view class="order-picker-tip" wx:elif="{{!orderOptions.length}}">还没有可选的订单，可直接开始对话说明情况。</view>
        <view
          class="order-pick-row"
          wx:for="{{orderOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-no="{{item.no}}"
          data-title="{{item.title}}"
          catchtap="pickOrder"
          hover-class="tap-press-soft"
          hover-stay-time="80"
        >
          <view class="op-main">
            <text class="op-title">{{item.title}}</text>
            <text class="op-sub">单号 {{item.no}} · ¥{{item.amount}} · {{item.time}}</text>
          </view>
          <text class="op-go">›</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
