<!--subpackages/extra/user/support/index.wxml-->
<view class="page-support">
  <view class="grain-overlay"></view>

  <view class="sticky-header" style="padding-right: {{navPaddingRight}}px;">
    <view class="nav-row">
      <view class="nav-brand">
        <text class="nav-title">联系专员</text>
        <text class="nav-sub">SUPPORT</text>
      </view>
    </view>
  </view>

  <!-- 会话上下文卡：订单/藏品进线时固定展示，便于用户与专员对齐 -->
  <view
    class="context-strip"
    wx:if="{{contextCard.visible}}"
    style="top: {{headerHeight}}px;"
  >
    <view
      class="context-card {{contextCard.tapPath ? 'is-tappable' : ''}}"
      hover-class="{{contextCard.tapPath ? 'context-card-press' : ''}}"
      hover-stay-time="80"
      bindtap="openContextTarget"
    >
      <view class="context-card-main">
        <image
          class="context-thumb"
          wx:if="{{contextCard.image}}"
          src="{{contextCard.image}}"
          mode="aspectFill"
        ></image>
        <view class="context-thumb placeholder" wx:else>
          <text class="context-thumb-mark">{{contextCard.kind === 'order' ? '单' : '藏'}}</text>
        </view>
        <view class="context-meta">
          <text class="context-kind">{{contextCard.kindLabel}}</text>
          <text class="context-title">{{contextCard.title}}</text>
          <text class="context-sub" wx:if="{{contextCard.subtitle}}">{{contextCard.subtitle}}</text>
        </view>
        <view class="context-go" wx:if="{{contextCard.tapPath}}">
          <text class="context-go-label">{{contextCard.actionLabel || '查看'}}</text>
          <text class="context-go-arrow">›</text>
        </view>
      </view>
      <view class="context-tip" wx:if="{{contextCard.tip}}">
        <text class="context-tip-text">{{contextCard.tip}}</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="main-scroll" style="top: {{scrollTop}}px;">
    <view class="skeleton-wrap" wx:if="{{loading}}">
      <view class="sk-card sk-shine"></view>
      <view class="sk-card sk-shine short"></view>
    </view>

    <block wx:else>
      <!-- 服务信息 -->
      <view class="service-card">
        <view class="service-row">
          <text class="service-label">服务时间</text>
          <text class="service-val">{{config.hours || '上午10点至下午5点'}}</text>
        </view>
        <view class="service-row">
          <text class="service-label">响应说明</text>
          <text class="service-val muted">{{config.responseHint}}</text>
        </view>
        <view class="context-banner" wx:if="{{contextSummary && !contextCard.visible}}">
          <text class="context-text">{{contextSummary}}</text>
        </view>
        <view class="context-banner soft" wx:if="{{hasConsultContext && !contextCard.visible}}">
          <text class="context-text">进入微信会话后，点右下角发送卡片，专员即可看到对应订单或藏品。</text>
        </view>
      </view>

      <!-- 咨询主题 -->
      <view class="section">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">TOPICS</text><text class="mu-cn">选择咨询类型</text></view></view>
        <view class="topic-grid">
          <view
            class="topic-item {{activeTopic === item.id ? 'active' : ''}}"
            wx:for="{{topics}}"
            wx:key="id"
            hover-class="tap-press-soft"
            bindtap="selectTopic"
            data-id="{{item.id}}"
          >
            <image class="topic-icon" src="{{item.icon}}" mode="aspectFit"></image>
            <text class="topic-label">{{item.label}}</text>
            <text class="topic-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 联系方式 -->
      <view class="section">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">CONTACT</text><text class="mu-cn">即时联系</text></view></view>
        <view class="channel-list">
          <view class="channel-item primary">
            <view class="channel-info">
              <text class="channel-name">微信专员</text>
              <text class="channel-desc">{{hasConsultContext ? '推荐 · 将带上订单/藏品卡片' : '推荐 · 可发送订单/藏品卡片'}}</text>
            </view>
            <button
              class="channel-btn"
              open-type="contact"
              session-from="{{sessionFrom}}"
              send-message-title="{{sendMessageTitle}}"
              send-message-path="{{sendMessagePath}}"
              send-message-img="{{sendMessageImg}}"
              show-message-card="{{showMessageCard}}"
              bindcontact="onContactTap"
            >开始对话</button>
          </view>

          <view class="channel-item" hover-class="tap-press-soft" bindtap="callPhone">
            <view class="channel-info">
              <text class="channel-name">电话专线</text>
              <text class="channel-desc">{{config.phone}}</text>
            </view>
            <text class="channel-arrow">→</text>
          </view>

          <view class="channel-item" hover-class="tap-press-soft" bindtap="goMessages">
            <view class="channel-info">
              <text class="channel-name">山海有信</text>
              <text class="channel-desc">查看系统通知与留言回执</text>
            </view>
            <text class="channel-arrow">→</text>
          </view>

          <view class="channel-item" hover-class="tap-press-soft" bindtap="openCommunity">
            <view class="channel-info">
              <text class="channel-name">官方社群</text>
              <text class="channel-desc">添加微信助手后入群</text>
            </view>
            <text class="channel-arrow">→</text>
          </view>
        </view>
      </view>

      <!-- 留言表单 -->
      <view class="section">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">LEAVE A NOTE</text><text class="mu-cn">留言给专员</text></view></view>
        <text class="section-hint">若暂时无法接入微信客服，可留下文字说明，专员会通过山海有信回复</text>
        <view class="form-card">
          <textarea
            class="message-input"
            placeholder="请描述您的问题（至少 5 字）"
            placeholder-class="ph"
            maxlength="500"
            value="{{messageText}}"
            bindinput="onMessageInput"
            bindblur="onMessageInput"
          ></textarea>
          <view class="ti-block">
            <view class="ti-head">
              <text class="ti-label">附图（选填，最多 {{maxTicketImages}} 张）</text>
              <text class="ti-count">{{ticketImages.length}}/{{maxTicketImages}}</text>
            </view>
            <view class="ti-grid">
              <view class="ti-cell" wx:for="{{ticketImages}}" wx:key="key">
                <image class="ti-img" src="{{item.local}}" mode="aspectFill" bindtap="previewTicketImage" data-url="{{item.local}}"/>
                <view class="ti-mask" wx:if="{{item.status === 'uploading'}}"><text class="ti-mask-text">上传中…</text></view>
                <view class="ti-mask is-failed" wx:elif="{{item.status === 'failed'}}" hover-class="tap-press-soft" catchtap="retryTicketImage" data-key="{{item.key}}"><text class="ti-mask-text">上传失败</text><text class="ti-mask-text">点此重试</text></view>
                <view class="ti-del" catchtap="removeTicketImage" data-key="{{item.key}}"><text class="ti-del-x">×</text></view>
              </view>
              <view class="ti-cell ti-add" wx:if="{{ticketImages.length < maxTicketImages}}" hover-class="tap-press-soft" bindtap="chooseTicketImages">
                <text class="ti-add-plus">+</text>
                <text class="ti-add-text">添加图片</text>
              </view>
            </view>
            <text class="ti-warn" wx:if="{{ticketImgFailed}}">有 {{ticketImgFailed}} 张没传上去，点图片重试或删掉后再提交</text>
          </view>
          <view class="phone-row">
            <text class="phone-label">联系电话（选填）</text>
            <input
              class="phone-input"
              type="number"
              maxlength="11"
              placeholder="便于专员回拨"
              placeholder-class="ph"
              value="{{contactPhone}}"
              bindinput="onPhoneInput"
            />
          </view>
          <view class="form-actions">
            <button
              class="submit-btn {{submitting ? 'is-loading' : ''}}"
              hover-class="submit-btn-press"
              hover-stay-time="80"
              bindtap="submitTicket"
              loading="{{submitting}}"
              disabled="{{submitting || ticketImgBusy}}"
            >{{submitting ? '提交中…' : (ticketImgBusy && !ticketImgFailed ? '图片上传中…' : '提交留言')}}</button>
          </view>
        </view>
      </view>

      <!-- 常见问题 -->
      <view class="section" wx:if="{{faqs.length}}">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">FAQ</text><text class="mu-cn">常见问题</text></view></view>
        <view class="faq-list">
          <view
            class="faq-item {{expandedFaq === index ? 'expanded' : ''}}"
            wx:for="{{faqs}}"
            wx:key="index"
            bindtap="toggleFaq"
            data-index="{{index}}"
          >
            <view class="faq-q">
              <text>{{item.q}}</text>
              <text class="faq-toggle">{{expandedFaq === index ? '−' : '+'}}</text>
            </view>
            <text class="faq-a" wx:if="{{expandedFaq === index}}">{{item.a}}</text>
          </view>
        </view>
      </view>

      <!-- 到店信息 -->
      <view class="section visit-section">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">VISIT US</text><text class="mu-cn">到店咨询</text></view></view>
        <view class="visit-card" hover-class="tap-press-soft" bindtap="openMap">
          <text class="visit-addr">{{config.address || '门店地址加载中'}}</text>
          <text class="visit-link">点击导航 →</text>
        </view>
      </view>

      <view class="footer-pad"></view>
    </block>
  </scroll-view>

  <!-- 社群弹窗 -->
  <view class="modal-mask {{showCommunity ? 'active' : ''}}" bindtap="closeCommunity" wx:if="{{showCommunity}}">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-close" bindtap="closeCommunity">✕</view>
      <text class="modal-title">官方社群</text>
      <text class="modal-sub">COMMUNITY</text>
      <image class="community-qr" src="{{config.communityQr}}" mode="aspectFit" show-menu-by-longpress="{{true}}"></image>
      <text class="modal-tip">长按识别添加微信助手，随后拉入官方服务微信群</text>
    </view>
  </view>
</view>
