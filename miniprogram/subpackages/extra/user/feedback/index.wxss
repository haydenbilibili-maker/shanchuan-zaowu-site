@import '../user-account.wxss';
@import '../../utils/ticket-images.wxss';

page {
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
}

.fb-intro-text {
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  line-height: 1.65;
}

.fb-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: var(--space-3);
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-body);
  font-size: var(--fs-26);
  line-height: 1.6;
}

.fb-counter {
  display: block;
  text-align: right;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.fb-links {
  padding-top: var(--space-2);
  padding-bottom: var(--space-2);
}

.fb-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--color-border);
}

.fb-link-row.last {
  border-bottom: none;
}


.fb-link-label {
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

.fb-link-arrow {
  font-size: var(--fs-24);
  color: var(--brass-400);
}

.account-footer .account-btn-primary {
  margin-bottom: 0;
}

/* 仪式感：反馈回执单（2026-10-18）—— 与入馆券同一张纸、同一方朱印；遮罩取 ui-pop-mask is-center is-deep */
.fb-receipt-mask { z-index: 900; }
.fb-receipt {
  position: relative;
  width: 520rpx;
  padding: 44rpx 44rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 14rpx #F0E8D6, inset 0 0 0 15rpx rgba(46, 38, 24, 0.22), 0 24rpx 60rpx rgba(0, 0, 0, 0.55);
  animation: fb-receipt-rise 0.36s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}
.fb-receipt-en {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.28em;
  color: #8B6F47;
}
.fb-receipt-title {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #2E2618;
}
.fb-receipt-rule {
  width: 72rpx;
  height: 2rpx;
  margin: 18rpx 0 14rpx;
  background: #B08D57;
}
.fb-receipt-row {
  display: flex;
  gap: 20rpx;
  padding: 6rpx 0;
  font-size: var(--fs-24);
}
.fb-receipt-k { flex-shrink: 0; color: #8A7F6C; letter-spacing: 0.1em; }
.fb-receipt-v { color: #2E2618; }
.fb-receipt-v.mono { font-family: var(--font-mono); letter-spacing: 0.06em; }
.fb-receipt-seal {
  position: absolute;
  right: 40rpx;
  bottom: 36rpx;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(168, 53, 42, 0.85);
  border-radius: 6rpx;
  box-shadow: inset 0 0 0 3rpx rgba(243, 236, 221, 0.5), inset 0 0 0 5rpx rgba(168, 53, 42, 0.5);
  color: rgba(168, 53, 42, 0.9);
  transform: rotate(-12deg);
  animation: fb-receipt-seal 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.2) 0.45s both;
}
.fb-receipt-seal-ch {
  font-family: var(--font-brand);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 34rpx;
}
@keyframes fb-receipt-rise { from { opacity: 0; transform: translateY(48rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes fb-receipt-seal {
  0% { opacity: 0; transform: rotate(-12deg) scale(1.9); }
  60% { opacity: 1; transform: rotate(-12deg) scale(0.94); }
  100% { opacity: 1; transform: rotate(-12deg) scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .fb-receipt,
  .fb-receipt-seal { animation: none; }
}
