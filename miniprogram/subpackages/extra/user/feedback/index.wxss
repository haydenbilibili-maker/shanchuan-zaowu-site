@import '../user-account.wxss';
@import '../../utils/ticket-images.wxss';

page {
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
}

.fb-intro-text {
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  line-height: 1.65;
}

.fb-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: var(--space-3);
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-body);
  font-size: var(--fs-26);
  line-height: 1.6;
}

.fb-counter {
  display: block;
  text-align: right;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.fb-links {
  padding-top: var(--space-2);
  padding-bottom: var(--space-2);
}

.fb-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--color-border);
}

.fb-link-row.last {
  border-bottom: none;
}


.fb-link-label {
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

.fb-link-arrow {
  font-size: var(--fs-24);
  color: var(--brass-400);
}

.account-footer .account-btn-primary {
  margin-bottom: 0;
}
