<!--subpackages/extra/user/feedback/index.wxml-->
<view class="account-page page-feedback">
  <view class="grain-overlay"></view>

  <view
    class="account-nav"
    style=" padding-right: {{navPaddingRight}}px;"
  >
    <view class="account-nav-row">
      <view class="account-nav-brand">
        <text class="account-nav-title">反馈与建议</text>
        <text class="account-nav-sub">FEEDBACK</text>
      </view>
    </view>
  </view>

  <scroll-view
    scroll-y
    class="account-scroll"
    show-scrollbar="{{false}}"
    style="top: {{headerBlockPx}}px; height: {{scrollHeightPx}}px;"
  >
    <view class="account-section-card fb-intro">
      <text class="fb-intro-text">你的每一条建议，都会帮助我们把藏品与体验做得更好。提交后可在「山海有信」查看回执。</text>
    </view>

    <view class="account-section-card">
      <view class="account-section-label">反馈类型</view>
      <view class="account-chip-row">
        <view
          class="account-chip {{activeCategory === item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          hover-class="account-chip-press"
          bindtap="selectCategory"
          data-id="{{item.id}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="account-section-card">
      <view class="account-section-label">详细描述</view>
      <textarea
        class="fb-textarea"
        placeholder="请描述你的建议或遇到的问题（至少 5 字）"
        maxlength="500"
        value="{{messageText}}"
        bindinput="onMessageInput"
        show-confirm-bar="{{false}}"
      ></textarea>
      <text class="fb-counter">{{messageText.length}}/500</text>
      <view class="ti-block">
        <view class="ti-head">
          <text class="ti-label">截图 / 照片（选填，最多 {{maxTicketImages}} 张）</text>
          <text class="ti-count">{{ticketImages.length}}/{{maxTicketImages}}</text>
        </view>
        <view class="ti-grid">
          <view class="ti-cell" wx:for="{{ticketImages}}" wx:key="key">
            <image class="ti-img" src="{{item.local}}" mode="aspectFill" bindtap="previewTicketImage" data-url="{{item.local}}"/>
            <view class="ti-mask" wx:if="{{item.status === 'uploading'}}"><text class="ti-mask-text">上传中…</text></view>
            <view class="ti-mask is-failed" wx:elif="{{item.status === 'failed'}}" hover-class="tap-press-soft" catchtap="retryTicketImage" data-key="{{item.key}}"><text class="ti-mask-text">上传失败</text><text class="ti-mask-text">点此重试</text></view>
            <view hover-class="tap-press" hover-stay-time="80" class="ti-del" catchtap="removeTicketImage" data-key="{{item.key}}"><text class="ti-del-x">×</text></view>
          </view>
          <view class="ti-cell ti-add" wx:if="{{ticketImages.length < maxTicketImages}}" hover-class="tap-press-soft" bindtap="chooseTicketImages">
            <text class="ti-add-plus">+</text>
            <text class="ti-add-text">添加图片</text>
          </view>
        </view>
        <text class="ti-warn" wx:if="{{ticketImgFailed}}">有 {{ticketImgFailed}} 张没传上去，点图片重试或删掉后再提交</text>
      </view>
    </view>

    <view class="account-section-card">
      <view class="account-field">
        <text class="account-field-label">联系电话（选填）</text>
        <input
          class="account-field-input"
          type="number"
          maxlength="11"
          placeholder="便于我们必要时联系您"
          value="{{contactPhone}}"
          bindinput="onPhoneInput"
        />
      </view>
    </view>

    <view class="account-section-card fb-links">
      <view class="fb-link-row" hover-class="tap-press" bindtap="openLegal" data-type="terms">
        <text class="fb-link-label">用户服务协议</text>
        <text class="fb-link-arrow">→</text>
      </view>
      <view class="fb-link-row" hover-class="tap-press" bindtap="openLegal" data-type="privacy">
        <text class="fb-link-label">隐私政策</text>
        <text class="fb-link-arrow">→</text>
      </view>
      <view class="fb-link-row last" hover-class="tap-press" bindtap="goSupport">
        <text class="fb-link-label">需要订单/售后帮助？联系专员</text>
        <text class="fb-link-arrow">→</text>
      </view>
    </view>

    <view class="account-scroll-pad"></view>
  </scroll-view>

  <view class="account-footer account-footer-safe">
    <view class="account-btn-primary {{submitting || ticketImgBusy ? 'disabled' : ''}}" hover-class="{{submitting || ticketImgBusy ? '' : 'account-btn-press'}}" hover-stay-time="80" bindtap="submitFeedback">
      {{submitting ? '提交中…' : (ticketImgBusy && !ticketImgFailed ? '图片上传中…' : '提交反馈')}}
    </view>
  </view>
</view>

<!-- 仪式感（2026-10-18）：提交成功 → 纸质回执单（编号 / 类型 / 去处）+「已收」朱印；约 1.8s 后照原路去「山海有信」 -->
<view class="ui-pop-mask is-center is-deep fb-receipt-mask" wx:if="{{receipt.show}}" catchtouchmove="true" aria-label="反馈已提交">
  <view class="fb-receipt">
    <text class="fb-receipt-en">RECEIPT</text>
    <text class="fb-receipt-title">已收到你的建议</text>
    <view class="fb-receipt-rule"></view>
    <view class="fb-receipt-row"><text class="fb-receipt-k">编号</text><text class="fb-receipt-v mono">{{receipt.no}}</text></view>
    <view class="fb-receipt-row"><text class="fb-receipt-k">类型</text><text class="fb-receipt-v">{{receipt.label}}</text></view>
    <view class="fb-receipt-row"><text class="fb-receipt-k">回信</text><text class="fb-receipt-v">寄到「山海有信」</text></view>
    <view class="fb-receipt-seal" aria-hidden="true"><text class="fb-receipt-seal-ch">已</text><text class="fb-receipt-seal-ch">收</text></view>
  </view>
</view>
