@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-body, #D5D1C8);
}

.page { min-height: 100vh; }

.container {
  padding: 0 var(--space-4, 32rpx) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pc-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  line-height: 1.5;
}
.pc-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.pc-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}

.empty-tip.is-error {
  margin: 8rpx 0 20rpx;
  padding: 40rpx 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
}
.pc-retry {
  display: inline-block;
  margin-top: 20rpx;
  padding: 14rpx 36rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  font-size: var(--fs-26);
  color: #e8dcc0;
}
.card.pending-remove {
  border-color: rgba(196, 92, 74, 0.55);
}

.header { padding: var(--space-5, 40rpx) 0 var(--space-2, 16rpx); }
.brand-group { display: flex; flex-direction: column; }
.brand-group .en {
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-600, #8A7530);
  text-transform: uppercase;
}
.brand-group .cn {
  font-family: var(--font-brand, Georgia, serif);
  font-size: var(--fs-40);
  color: var(--color-text-primary, #FFFFFF);
  margin-top: 6rpx;
}
.header-note {
  display: block;
  margin-top: var(--space-2, 16rpx);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.summary-bar {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
}
.summary-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.summary-label {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
}
.summary-value {
  font-family: var(--font-mono, monospace);
  font-size: var(--fs-40);
  font-weight: 600;
  color: var(--brass-400, #C4A76C);
}
.summary-count {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}
.summary-entities {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}
.entity-chip {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-20);
  color: var(--brass-300, #D4BC85);
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
}
.entity-chip.muted {
  color: var(--color-text-secondary, #A09A90);
  background: rgba(38, 35, 32, 0.8);
  border-color: rgba(38, 35, 32, 0.9);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 24rpx;
}
.filter-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.8);
  background: var(--color-bg-elevated, #262320);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}
.filter-chip.clear { color: var(--color-primary); }
.btn-add {
  margin-left: auto;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-md);
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  font-size: var(--fs-24);
  font-weight: 500;
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.skeleton-card {
  padding: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(38, 35, 32, 0.66);
  border-radius: var(--radius-md);
}
.sk-line {
  height: 24rpx;
  width: 42%;
  margin-top: 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-elevated, #262320);
  animation: sk-pulse 1.2s ease-in-out infinite;
}
.sk-line.wide { width: 72%; margin-top: 0; height: 32rpx; }
.sk-line.mid { width: 58%; }
@keyframes sk-pulse {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.85; }
}

.empty-tip {
  padding: 48rpx 24rpx;
  text-align: center;
}
.empty-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-primary, #FFFFFF);
}
.empty-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(38, 35, 32, 0.66);
  border-radius: var(--radius-md);
}
.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.card-title {
  flex: 1;
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  font-weight: 500;
}
.status-tag {
  font-size: var(--fs-20);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
  background: rgba(38, 35, 32, 0.9);
}
.status-tag.brass { color: var(--color-primary); background: rgba(196, 167, 108, 0.15); }
.status-tag.warn { color: #E9A23B; background: rgba(233, 162, 59, 0.15); }
.status-tag.muted { color: var(--color-text-secondary); }
.amount {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-36);
  color: var(--brass-400, #C4A76C);
  font-family: var(--font-mono, monospace);
  font-weight: 600;
}
.meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.45;
}
.receipt-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}
.receipt-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(77, 64, 26, 0.4);
}
.receipt-thumb.lg {
  width: 144rpx;
  height: 144rpx;
}
.receipt-edit {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.receipt-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.receipt-item {
  position: relative;
}
.receipt-del {
  position: absolute;
  right: 4rpx;
  top: 4rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-18);
  color: var(--color-text-primary);
  background: rgba(214, 64, 69, 0.85);
}
.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.chip-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
  align-self: flex-start;
}
.chip-btn.danger {
  border-color: rgba(214, 64, 69, 0.4);
  color: #D64045;
}

.sheet {
  max-height: 82vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}
.sheet-title {
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  font-weight: 500;
}
.sheet-close {
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}
.sheet-body {
  max-height: 68vh;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}
.field { margin-bottom: 20rpx; }
.field-row { display: flex; gap: 16rpx; }
.field.half { flex: 1; }
.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}
.input {
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(38, 35, 32, 0.8);
  color: var(--color-text-primary);
  font-size: var(--fs-26);
}
.ph { color: var(--color-text-muted); }
.btn.primary {
  margin-top: 12rpx;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  font-size: var(--fs-28);
  font-weight: 500;
}
.btn.primary.disabled { opacity: 0.55; }

.workbench-state.loading {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary, #A09A90);
  font-size: var(--fs-26);
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .sk-line {
    animation: none;
  }
}
