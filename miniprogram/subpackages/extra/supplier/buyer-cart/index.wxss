@import '../utils/supplier-common.wxss';

/* 2026-10-18 视觉对齐（产品负责人点名「继续重构采购商子页面」；与采购商工作台 supplier-common 同口径，只改样式）：
   方角（卡 4rpx / 签 2rpx）、标题宋体、数量金额等宽暖金；列表项不给实心金。
   本页唯一实心金 = 底栏「提交」；横幅的成功绿 / 错误红为反馈语义，保留。 */

.header.compact {
  padding-bottom: var(--space-3);
}

.banner {
  margin-bottom: var(--space-3);
  padding: 20rpx 24rpx;
  border-radius: 4rpx;
  font-size: var(--fs-24);
  line-height: 1.45;
}

.banner.ok {
  background: rgba(80, 160, 100, 0.15);
  color: #9dcea8;
}

.banner.warn {
  background: rgba(196, 167, 108, 0.12);
  color: var(--brass-500, var(--brass-600));
}

.banner.err {
  background: rgba(180, 80, 80, 0.15);
  color: #e8a0a0;
}

.sec {
  margin-bottom: var(--space-5);
}

.sec-head {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-3);
  padding-bottom: 14rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

.sec-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.sec-cn {
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.cart-list {
  display: flex;
  flex-direction: column;
}

.cart-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.cart-thumb {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 4rpx;
  overflow: hidden;
  background: #1F1D1A;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
}

.cart-thumb image {
  width: 96rpx;
  height: 96rpx;
  display: block;
}

.cart-thumb.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.cart-thumb.ph text {
  font-size: var(--fs-18);
  color: var(--color-text-secondary, #A09A90);
}

.cart-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cart-name {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
  line-height: 1.3;
}

.cart-pack {
  font-size: var(--fs-22);
  color: var(--brass-300);
}

.cart-unit {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.cart-row-ops {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.cart-line-total {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--brass-200);
  font-variant-numeric: tabular-nums;
}

.qty-stepper {
  display: flex;
  align-items: center;
  height: 52rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3);
  overflow: hidden;
}

.qty-stepper.sm {
  height: 48rpx;
}

.qty-btn {
  width: 48rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-26);
  color: var(--color-text-primary);
  background: rgba(255, 255, 255, 0.03);
}

.qty-press {
  background: rgba(196, 167, 108, 0.15);
}

.qty-num {
  min-width: 44rpx;
  text-align: center;
  font-size: var(--fs-24);
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
  border-right: 1rpx solid rgba(255, 255, 255, 0.08);
  line-height: 48rpx;
}

.cart-remove {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  padding-top: 8rpx;
}

.form-card {
  padding: 8rpx 20rpx 4rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2);
}

.form-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.form-row.last {
  border-bottom: none;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.form-input {
  height: 56rpx;
  width: 100%;
  background: transparent;
  color: #F3ECDD;
  font-size: var(--fs-28);
}

.checkout-spacer {
  height: 220rpx;
}

.checkout-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx var(--space-4) calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(26, 24, 20, 0.98);
  border-top: 1rpx solid rgba(196, 167, 108, 0.22);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  z-index: 20;
}

.checkout-total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.checkout-total {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.checkout-total-label {
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.checkout-total-val {
  font-family: var(--font-mono);
  font-size: var(--fs-36);
  font-weight: 600;
  color: var(--brass-200);
  font-variant-numeric: tabular-nums;
}

.checkout-hint {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.checkout-actions {
  display: flex;
  gap: 16rpx;
}

.btn-ghost,
.btn-primary {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  font-size: var(--fs-28);
}

.btn-ghost {
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.4);
  color: var(--color-text-body, #D5D1C8);
  letter-spacing: 0.08em;
}

.btn-primary {
  flex: 1.35;
  background: var(--brass-400);
  color: #1A1814;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.btn-press {
  opacity: 0.88;
}

.btn-ghost.disabled,
.btn-primary.disabled {
  opacity: 0.45;
  pointer-events: none;
}
