@import '../utils/supplier-common.wxss';

.header.compact {
  padding-bottom: var(--space-3);
}

.banner {
  margin-bottom: var(--space-3);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.banner.ok {
  background: rgba(80, 160, 100, 0.15);
  color: #9dcea8;
}

.banner.warn {
  background: rgba(196, 167, 108, 0.12);
  color: var(--brass-500, var(--brass-600));
}

.banner.err {
  background: rgba(180, 80, 80, 0.15);
  color: #e8a0a0;
}

.sec {
  margin-bottom: var(--space-5);
}

.sec-head {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-3);
}

.sec-en {
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: var(--color-text-muted);
}

.sec-cn {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.cart-list {
  display: flex;
  flex-direction: column;
}

.cart-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.cart-thumb {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.04);
}

.cart-thumb image {
  width: 96rpx;
  height: 96rpx;
  display: block;
}

.cart-thumb.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
}

.cart-thumb.ph text {
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.cart-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cart-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.cart-pack {
  font-size: 22rpx;
  color: var(--brass-600);
}

.cart-unit {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.cart-row-ops {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.cart-line-total {
  font-size: 26rpx;
  color: var(--brass-500, var(--brass-600));
  font-variant-numeric: tabular-nums;
}

.qty-stepper {
  display: flex;
  align-items: center;
  height: 52rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 10rpx;
  overflow: hidden;
}

.qty-stepper.sm {
  height: 48rpx;
}

.qty-btn {
  width: 48rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-text-primary);
  background: rgba(255, 255, 255, 0.03);
}

.qty-press {
  background: rgba(196, 167, 108, 0.15);
}

.qty-num {
  min-width: 44rpx;
  text-align: center;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
  border-right: 1rpx solid rgba(255, 255, 255, 0.08);
  line-height: 48rpx;
}

.cart-remove {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-muted);
  padding-top: 8rpx;
}

.form-card {
  padding: 8rpx 20rpx 4rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.form-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.form-row.last {
  border-bottom: none;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--color-text-muted);
}

.form-input {
  height: 56rpx;
  width: 100%;
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.checkout-spacer {
  height: 220rpx;
}

.checkout-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx var(--space-4) calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(10, 10, 12, 0.97);
  border-top: 1rpx solid rgba(196, 167, 108, 0.22);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  z-index: 20;
}

.checkout-total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.checkout-total {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.checkout-total-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.checkout-total-val {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--brass-500, var(--brass-600));
  font-variant-numeric: tabular-nums;
}

.checkout-hint {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.checkout-actions {
  display: flex;
  gap: 16rpx;
}

.btn-ghost,
.btn-primary {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.btn-ghost {
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: var(--color-text-primary);
}

.btn-primary {
  flex: 1.35;
  background: var(--brass-600);
  color: #1a1408;
  font-weight: 500;
}

.btn-press {
  opacity: 0.88;
}

.btn-ghost.disabled,
.btn-primary.disabled {
  opacity: 0.45;
  pointer-events: none;
}
