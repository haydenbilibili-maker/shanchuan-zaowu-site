@import '../utils/supplier-common.wxss';

.page-with-bar {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.flash-bar {
  margin-bottom: var(--space-3);
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.12);
  font-size: var(--fs-24);
  color: var(--brass-500, var(--brass-600));
  line-height: 1.4;
}

.flash-bar.warn {
  background: rgba(224, 122, 95, 0.12);
  color: #e07a5f;
}

.flash-bar.ok {
  background: rgba(80, 160, 100, 0.14);
  color: #9dcea8;
}

.skeleton-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  opacity: 0.55;
}

.skeleton-thumb {
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.06);
}

.skeleton-body {
  flex: 1;
  padding-top: 16rpx;
}

.skeleton-line {
  height: 22rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.06);
}

.skeleton-line.w70 { width: 70%; }
.skeleton-line.w40 { width: 40%; }

.cat-list {
  display: flex;
  flex-direction: column;
}

.cat-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: background var(--dur-base) var(--ease-standard);
}

.cat-card.just-added {
  background: rgba(196, 167, 108, 0.08);
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: var(--radius-md);
}

.cat-card.locked {
  opacity: 0.78;
}

.cat-thumb-wrap {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.04);
}

.cat-thumb-press {
  opacity: 0.82;
}

.cat-thumb {
  width: 144rpx;
  height: 144rpx;
  display: block;
}

.cat-thumb-ph {
  width: 144rpx;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-sizing: border-box;
  border-radius: var(--radius-md);
}

.cat-thumb-ph-text {
  font-size: var(--fs-22);
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

.in-cart-dot {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--brass-600);
  display: flex;
  align-items: center;
  justify-content: center;
}

.in-cart-dot text {
  font-size: var(--fs-18);
  font-weight: 600;
  color: #1a1408;
}

.cat-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-top: 2rpx;
}

.cat-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.cat-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-28);
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.35;
}

.cat-price {
  flex-shrink: 0;
  font-size: var(--fs-28);
  color: var(--brass-500, var(--brass-600));
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
}

.cat-pack {
  font-size: var(--fs-24);
  color: var(--brass-600);
  line-height: 1.35;
}

.cat-meta {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.cat-lock-hint {
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.02em;
}

.cat-ops {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.qty-stepper {
  display: flex;
  align-items: center;
  height: 56rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  background: rgba(255, 255, 255, 0.03);
}

.qty-btn.dim {
  opacity: 0.35;
}

.qty-press {
  background: rgba(196, 167, 108, 0.15);
}

.qty-num {
  min-width: 48rpx;
  text-align: center;
  font-size: var(--fs-26);
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
  border-right: 1rpx solid rgba(255, 255, 255, 0.08);
  line-height: 56rpx;
}

.add-btn {
  padding: 0 28rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--brass-500);  /* 深字压 brass-600 仅 4.07:1 → 提一档 ≈5.3:1 */
  color: #1a1408;
  font-size: var(--fs-24);
  font-weight: 500;
}

.add-press {
  opacity: 0.88;
}

.add-btn.muted {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: var(--color-text-secondary);
  font-weight: 400;
}

.add-btn.in {
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  color: var(--brass-600);
}

.add-btn.busy {
  opacity: 0.55;
  pointer-events: none;
}

.cart-bar {
  position: fixed;
  left: var(--space-4);
  right: var(--space-4);
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  min-height: 96rpx;
  padding: 16rpx 20rpx 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-radius: var(--radius-lg);
  background: rgba(14, 12, 10, 0.97);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  z-index: 20;
  box-sizing: border-box;
}

.cart-bar.ready {
  border-color: rgba(196, 167, 108, 0.5);
  background: rgba(22, 18, 12, 0.98);
}

.cart-bar-press {
  opacity: 0.9;
}

.cart-bar-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: var(--brass-600);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cart-bar-badge text {
  font-size: var(--fs-22);
  font-weight: 600;
  color: #1a1408;
}

.cart-bar-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.cart-bar-label {
  font-size: var(--fs-26);
  font-weight: 500;
  color: var(--color-text-primary);
}

.cart-bar-count {
  font-size: var(--fs-22);
  color: var(--brass-600);
}

.cart-bar-count.muted {
  color: var(--color-text-secondary);
}

.cart-bar-cta {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: var(--brass-500);  /* 深字压 brass-600 仅 4.07:1 → 提一档 ≈5.3:1 */
  color: #1a1408;
  font-size: var(--fs-24);
  font-weight: 500;
}
