<view class="page">
  <view class="page-boot" wx:if="{{!ready}}">
    <text class="boot-en">ORDERS</text>
    <text class="boot-cn">采购需求</text>
    <text class="boot-hint">校验权限中…</text>
  </view>

  <block wx:elif="{{ready}}">
    <view class="header">
      <view class="brand-group">
        <text class="en">ORDERS</text>
        <text class="cn">采购需求</text>
      </view>
      <view class="header-row">
        <text class="greeting">发给您的采购需求</text>
        <view class="preview-chip" wx:if="{{isPreview}}"><text>预览</text></view>
        <view class="demo-chip" wx:if="{{demoOn}}"><text>演示</text></view>
      </view>
      <text class="header-note">流程：待确认 → 待发货 → 已发货。{{demoOn ? '演示下可点「确认接单」推进状态。' : '只显示与您相关的单据。'}}</text>
    </view>

    <view class="flash-bar" wx:if="{{flash}}">
      <text>{{flash}}</text>
    </view>

    <view class="status-tabs">
      <view hover-class="wb-press" hover-stay-time="80"
        class="status-tab {{tab===item.key?'on':''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="setTab"
      >{{item.label}}</view>
    </view>

    <block wx:if="{{list.length}}">
      <view class="list-card" wx:for="{{list}}" wx:key="key">
        <view class="list-main">
          <text class="list-title">{{item.title}}</text>
          <text class="list-meta">{{item.meta}}</text>
          <text class="list-hint">{{item.actionHint}}</text>
          <view hover-class="wb-press" hover-stay-time="80"
            class="list-action"
            wx:if="{{item.canConfirm}}"
            data-key="{{item.key}}"
            bindtap="onConfirm"
          >确认接单（演示）</view>
        </view>
        <view class="list-side">
          <text class="list-qty">{{item.qtyLabel}}</text>
        </view>
      </view>
      <view hover-class="wb-press" hover-stay-time="80" class="link-row" wx:if="{{demoOn && tab==='pending_ship'}}" bindtap="goShip">
        <text class="link-copy">待发货可去回传运单</text>
        <text class="link-go">发货回传 ›</text>
      </view>
    </block>

    <view class="empty-panel" wx:else>
      <text class="empty-panel-title">{{emptyTitle}}</text>
      <text class="empty-panel-body">{{emptyBody}}</text>
      <view hover-class="wb-press" hover-stay-time="80" class="retry-btn" wx:if="{{demoOn && tab==='pending_ship'}}" bindtap="goShip">去发货回传</view>
    </view>
  </block>
</view>
