@import '../../utils/workbench-nav.wxss';

/* 采购商 / 供货方工作台共享样式（2026-10-18 视觉对齐，产品负责人点名「采购商工作台」；与主播 / 标本师工作台同口径）
   眉标等宽 + 宋体主标；三步流程 = 等宽编号 + 下划线；入口 / 列表为发丝线行 + 方印图标；状态页签为方角发丝签、选中金线环；
   列表行动作不再是实心金药丸（一屏多行 = 多颗实心金）。演示模式的橙色是「假数据」警示，保留。
   本文件被工作台与 catalog / buyer-cart / buyer-orders / orders / ship / settlement 六个子页共用。 */

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-boot {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: var(--space-6) 0;
}

.boot-en,
.brand-group .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.boot-cn,
.brand-group .cn {
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.boot-hint {
  margin-top: var(--space-3);
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.header {
  padding: var(--space-5) 0 var(--space-4);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.header-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-4);
}

.greeting {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.preview-chip,
.demo-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 2rpx;
}

.preview-chip {
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}

.preview-chip text {
  font-size: var(--fs-20);
  letter-spacing: 0.06em;
  color: var(--brass-600);
}

.demo-chip {
  border: 1rpx solid rgba(224, 122, 95, 0.55);
  background: rgba(224, 122, 95, 0.12);
}

.demo-chip text {
  font-size: var(--fs-20);
  letter-spacing: 0.04em;
  color: #e07a5f;
}

.mode-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 2rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.mode-chip text {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

/* 三步流程：等宽编号 + 下划线（原金底圆角条 + 圆圈编号） */
.flow-strip {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  margin-bottom: var(--space-5);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.flow-step-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx 8rpx 16rpx;
  border-bottom: 3rpx solid transparent;
  margin-bottom: -1rpx;
}

.flow-step-btn.hot {
  border-bottom-color: var(--brass-400);
}

.flow-press {
  opacity: 0.85;
}

.flow-num {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.1em;
  color: var(--brass-300);
}

.flow-label {
  font-size: var(--fs-26);
  color: var(--color-text-secondary, #A09A90);
}

.flow-step-btn.hot .flow-label { color: #F3ECDD; font-family: var(--font-brand); font-weight: 600; }

.flow-sep {
  flex-shrink: 0;
  align-self: center;
  font-size: var(--fs-26);
  color: rgba(196, 167, 108, 0.45);
}

.flow-step {
  font-size: var(--fs-22);
  color: var(--brass-600);
}

.demo-reset {
  margin: -8rpx 0 var(--space-4);
  font-size: var(--fs-22);
  color: #e07a5f;
  text-decoration: underline;
}

.module-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 2rpx;
  background: var(--brass-300);
  display: flex;
  align-items: center;
  justify-content: center;
}

.module-badge text {
  font-size: var(--fs-18);
  color: #1a1408;
  font-weight: 600;
}

.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.group {
  margin-bottom: var(--space-5);
}

/* 分区头 = 等宽眉标 + 宋体主标 + 渐隐金线 */
.group-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: var(--space-3);
  padding-bottom: 16rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

.group-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.group-cn {
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.module-card.primary-card {
  background: transparent;
}

.module-card.muted-card {
  opacity: 0.92;
}

.group-head.fold {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: var(--space-3);
}

.group-head-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.group-sub {
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}

.fold-chevron {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--brass-300);
  padding: 8rpx 0;
}

.supplier-group {
  margin-top: var(--space-4);
}

/* 入口：发丝线行 + 方印图标（原圆角卡） */
.module-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.module-card-press {
  background: rgba(196, 167, 108, 0.06);
}

.module-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.35);
}

.module-icon image {
  width: 36rpx;
  height: 36rpx;
}

.module-card-body {
  flex: 1;
  min-width: 0;
}

.module-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.module-desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.module-chevron {
  flex-shrink: 0;
  font-size: var(--fs-36);
  line-height: 1;
  color: var(--brass-300);
}

.demo-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: var(--space-4);
  padding: 20rpx 24rpx;
  border: 1rpx dashed rgba(224, 122, 95, 0.4);
  border-radius: 4rpx;
  background: rgba(224, 122, 95, 0.06);
}

.demo-bar-copy {
  flex: 1;
  min-width: 0;
}

.demo-bar-title {
  display: block;
  font-size: var(--fs-24);
  font-weight: 500;
  color: #e07a5f;
}

.demo-bar-hint {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.4;
}

.demo-toggle {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  font-size: var(--fs-22);
  color: #e07a5f;
  border: 1rpx solid rgba(224, 122, 95, 0.5);
  border-radius: 2rpx;
}

.demo-toggle.on {
  background: rgba(224, 122, 95, 0.2);
}

.status-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: var(--space-4);
}

/* 状态页签：方角发丝签，选中金线环 */
.status-tab {
  padding: 12rpx 22rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2);
}

.status-tab.on {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass);
}

.list-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.list-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.list-title {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.list-meta,
.list-hint {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.list-hint {
  color: var(--brass-300);
}

.list-side {
  flex-shrink: 0;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.list-qty,
.list-amount {
  font-family: var(--font-mono);
  font-size: var(--fs-28);
  color: var(--brass-200);
  font-variant-numeric: tabular-nums;
}

.list-status {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}

.empty-panel {
  margin-top: var(--space-2);
  padding: var(--space-5);
  border: 1rpx dashed rgba(196, 167, 108, 0.24);
  border-radius: 4rpx;
  text-align: center;
}

.empty-panel-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.empty-panel-body {
  display: block;
  margin-top: var(--space-3);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.error-panel {
  margin-top: var(--space-2);
  padding: var(--space-5);
  border: 1rpx solid rgba(224, 122, 95, 0.35);
  border-radius: 4rpx;
  background: rgba(224, 122, 95, 0.06);
}

.error-panel-title {
  display: block;
  font-size: var(--fs-28);
  font-weight: 500;
  color: #e07a5f;
}

.error-panel-body {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.retry-btn {
  display: inline-block;
  margin-top: var(--space-4);
  padding: 12rpx 28rpx;
  font-size: var(--fs-24);
  color: var(--brass-200);
  border-radius: 4rpx;
  box-shadow: var(--ring-brass-soft);
}

.foot-note {
  margin-top: var(--space-2);
  padding: 0 4rpx;
}

.foot-note text {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.55;
}

.flash-bar {
  margin-bottom: var(--space-3);
  padding: 16rpx 20rpx;
  border-radius: 4rpx;
  background: rgba(196, 167, 108, 0.1);
  box-shadow: var(--ring-brass-soft);
  font-size: var(--fs-24);
  color: var(--brass-200);
  line-height: 1.45;
}

/* 行内动作：金线环（原实心金药丸 —— 列表每行一颗实心金会把整屏点亮） */
.list-action {
  margin-top: 12rpx;
  align-self: flex-start;
  padding: 10rpx 22rpx;
  border-radius: 4rpx;
  background: rgba(196, 167, 108, 0.1);
  box-shadow: var(--ring-brass);
  color: var(--brass-200);
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 0 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 4rpx;
  background: rgba(196, 167, 108, 0.06);
  box-shadow: var(--ring-brass-soft);
}

.link-copy {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.link-go {
  font-size: var(--fs-24);
  color: var(--brass-300);
  flex-shrink: 0;
}

.ship-form {
  margin-bottom: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ship-form .form-label {
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.ship-form .form-input {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: var(--color-text-primary);
  font-size: var(--fs-26);
}
