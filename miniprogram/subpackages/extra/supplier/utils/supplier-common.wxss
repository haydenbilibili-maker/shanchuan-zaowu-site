@import '../../utils/workbench-nav.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-boot {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: var(--space-6) 0;
}

.boot-en,
.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
}

.boot-cn,
.brand-group .cn {
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
}

.boot-hint {
  margin-top: var(--space-3);
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}

.header {
  padding: var(--space-5) 0 var(--space-4);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.header-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-4);
}

.greeting {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.preview-chip,
.demo-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.preview-chip {
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}

.preview-chip text {
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: var(--brass-600);
}

.demo-chip {
  border: 1rpx solid rgba(224, 122, 95, 0.55);
  background: rgba(224, 122, 95, 0.12);
}

.demo-chip text {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: #e07a5f;
}

.mode-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.mode-chip text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.flow-strip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: var(--space-4);
  padding: 14rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.2);
}

.flow-step-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 8rpx;
  border-radius: 10rpx;
}

.flow-step-btn.hot {
  background: rgba(196, 167, 108, 0.12);
}

.flow-press {
  opacity: 0.85;
}

.flow-num {
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  font-size: 18rpx;
  color: var(--brass-600);
  text-align: center;
  line-height: 30rpx;
}

.flow-label {
  font-size: 22rpx;
  color: var(--color-text-primary);
}

.flow-sep {
  font-size: 22rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.flow-step {
  font-size: 22rpx;
  color: var(--brass-600);
}

.demo-reset {
  margin: -8rpx 0 var(--space-4);
  font-size: 22rpx;
  color: #e07a5f;
  text-decoration: underline;
}

.module-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--brass-600);
  display: flex;
  align-items: center;
  justify-content: center;
}

.module-badge text {
  font-size: 18rpx;
  color: #1a1408;
  font-weight: 600;
}

.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.group {
  margin-bottom: var(--space-6);
}

.group-head {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-3);
}

.group-en {
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--color-text-secondary, #A09A90);
}

.group-cn {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.module-card.primary-card {
  border-color: rgba(196, 167, 108, 0.28);
}

.module-card.muted-card {
  opacity: 0.92;
}

.group-head.fold {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: var(--space-3);
}

.group-head-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.group-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
}

.fold-chevron {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-600);
  padding: 8rpx 0;
}

.supplier-group {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.module-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-border, rgba(255, 255, 255, 0.08));
  border-radius: var(--radius-md, 16rpx);
  background: var(--color-surface, rgba(255, 255, 255, 0.03));
}

.module-card-press {
  opacity: 0.85;
  border-color: rgba(196, 167, 108, 0.45);
}

.module-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md, 12rpx);
  background: rgba(196, 167, 108, 0.1);
}

.module-icon image {
  width: 40rpx;
  height: 40rpx;
}

.module-card-body {
  flex: 1;
  min-width: 0;
}

.module-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.module-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.module-chevron {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
  color: var(--brass-400, var(--brass-600));
  opacity: 0.85;
}

.demo-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: var(--space-4);
  padding: 20rpx 24rpx;
  border: 1rpx dashed rgba(224, 122, 95, 0.4);
  border-radius: 16rpx;
  background: rgba(224, 122, 95, 0.06);
}

.demo-bar-copy {
  flex: 1;
  min-width: 0;
}

.demo-bar-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #e07a5f;
}

.demo-bar-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.4;
}

.demo-toggle {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #e07a5f;
  border: 1rpx solid rgba(224, 122, 95, 0.5);
  border-radius: 999rpx;
}

.demo-toggle.on {
  background: rgba(224, 122, 95, 0.2);
}

.status-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: var(--space-4);
}

.status-tab {
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
}

.status-tab.on {
  color: var(--color-text-primary);
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}

.list-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.list-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.list-meta,
.list-hint {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.list-hint {
  color: var(--brass-600);
}

.list-side {
  flex-shrink: 0;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.list-qty,
.list-amount {
  font-size: 28rpx;
  color: var(--brass-500, var(--brass-600));
  font-variant-numeric: tabular-nums;
}

.list-status {
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
}

.empty-panel {
  margin-top: var(--space-2);
  padding: var(--space-5);
  border: 1rpx dashed var(--color-border, rgba(255, 255, 255, 0.12));
  border-radius: 16rpx;
  text-align: center;
}

.empty-panel-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.empty-panel-body {
  display: block;
  margin-top: var(--space-3);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.error-panel {
  margin-top: var(--space-2);
  padding: var(--space-5);
  border: 1rpx solid rgba(224, 122, 95, 0.35);
  border-radius: 16rpx;
  background: rgba(224, 122, 95, 0.06);
}

.error-panel-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #e07a5f;
}

.error-panel-body {
  display: block;
  margin-top: var(--space-2);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.retry-btn {
  display: inline-block;
  margin-top: var(--space-4);
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: var(--color-text-primary);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
}

.foot-note {
  margin-top: var(--space-2);
  padding: 0 4rpx;
}

.foot-note text {
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.55;
}

.flash-bar {
  margin-bottom: var(--space-3);
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  background: rgba(196, 167, 108, 0.12);
  font-size: 24rpx;
  color: var(--brass-500, var(--brass-600));
  line-height: 1.45;
}

.list-action {
  margin-top: 12rpx;
  align-self: flex-start;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--brass-600);
  color: #1a1408;
  font-size: 22rpx;
  font-weight: 500;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 0 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.25);
}

.link-copy {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.link-go {
  font-size: 24rpx;
  color: var(--brass-600);
  flex-shrink: 0;
}

.ship-form {
  margin-bottom: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ship-form .form-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.ship-form .form-input {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: var(--color-text-primary);
  font-size: 26rpx;
}
