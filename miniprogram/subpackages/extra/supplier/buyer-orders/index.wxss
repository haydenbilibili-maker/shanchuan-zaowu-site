@import '../utils/supplier-common.wxss';

/* 2026-10-18 视觉对齐（产品负责人点名「继续重构采购商子页面」；与采购商工作台 supplier-common 同口径，只改样式）：
   方角（卡 4rpx / 签 2rpx）、标题宋体、数量金额等宽暖金；列表项不给实心金。
   采购单为发丝线块（当前单左侧金线）；「去支付」等行内主操作改金线环；支付状态签的待付铜 / 已付绿 / 处理中蓝为语义，保留，只改方角。 */

.header.compact {
  padding-bottom: var(--space-3);
}

.stat-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 2rpx;
  box-shadow: var(--ring-brass-soft);
  background: rgba(196, 167, 108, 0.08);
}

.stat-chip text {
  font-size: var(--fs-20);
  color: var(--brass-200);
}

.banner {
  margin-bottom: var(--space-3);
  padding: 18rpx 20rpx;
  border-radius: 4rpx;
  font-size: var(--fs-24);
  line-height: 1.45;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.banner-text {
  flex: 1;
  min-width: 0;
}

.banner-x {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: inherit;
  opacity: 0.7;
  padding: 2rpx 0;
}

.banner.ok {
  background: rgba(80, 160, 100, 0.15);
  color: #9dcea8;
}

.banner.warn {
  background: rgba(196, 167, 108, 0.12);
  color: var(--brass-500, var(--brass-600));
}

.banner.err {
  background: rgba(180, 80, 80, 0.15);
  color: #e8a0a0;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: var(--space-3);
  padding: 20rpx 22rpx;
  border-radius: 4rpx;
  background: rgba(196, 167, 108, 0.06);
  box-shadow: var(--ring-brass-soft);
}

.link-press {
  opacity: 0.88;
}

.link-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.link-title {
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  color: #F3ECDD;
}

.link-copy {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.link-go {
  font-size: var(--fs-24);
  color: var(--brass-300);
  flex-shrink: 0;
}

.sticky-tabs {
  margin-bottom: var(--space-4);
}

.po-skeleton {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.03);
  opacity: 0.55;
}

.sk-line {
  height: 20rpx;
  margin-bottom: 14rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.06);
}

.sk-line.w50 { width: 50%; }
.sk-line.w80 { width: 80%; }
.sk-line.w30 { width: 30%; margin-bottom: 0; }

.empty-panel.rich {
  text-align: left;
}

.empty-steps {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: var(--space-4);
  padding: 16rpx 18rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.empty-step {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.po-list {
  display: flex;
  flex-direction: column;
  padding-bottom: var(--space-4);
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

/* 采购单：发丝线块（原圆角卡） */
.po-card {
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.po-card.on {
  padding-left: 20rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.1), transparent 70%);
  box-shadow: inset 3rpx 0 0 var(--brass-400);
}

.po-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.po-no {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  letter-spacing: 0.04em;
  color: #F3ECDD;
  font-variant-numeric: tabular-nums;
}

.pay-chip {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 2rpx;
  border: 1rpx solid rgba(160, 154, 144, 0.3);
}

.pay-chip text {
  font-size: var(--fs-20);
  letter-spacing: 0.02em;
}

.pay-chip.warn {
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.12);
}

.pay-chip.warn text {
  color: var(--brass-200);
}

.pay-chip.ok {
  border-color: rgba(125, 180, 130, 0.4);
  background: rgba(80, 160, 100, 0.12);
}

.pay-chip.ok text {
  color: #9dcea8;
}

.pay-chip.info {
  border-color: rgba(140, 160, 200, 0.35);
  background: rgba(100, 130, 180, 0.12);
}

.pay-chip.info text {
  color: #a8b8d8;
}

.pay-chip.neutral text {
  color: var(--color-text-secondary, #A09A90);
}

.po-brief {
  display: block;
  margin-top: 14rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.po-fulfill-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.po-fulfill-label {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.06em;
}

.po-fulfill {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.po-next {
  display: block;
  margin-top: 12rpx;
  padding: 4rpx 0 4rpx 16rpx;
  border-left: 2rpx solid rgba(196, 167, 108, 0.35);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.po-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.po-amount {
  font-family: var(--font-mono);
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--brass-200);
  font-variant-numeric: tabular-nums;
}

.po-time {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}

.po-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.po-btn {
  padding: 14rpx 24rpx;
  border-radius: 4rpx;
  font-size: var(--fs-24);
  letter-spacing: 0.06em;
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.35);
  color: var(--color-text-body, #D5D1C8);
}

/* 行内主操作（去支付 / 确认收货…）：金线环 —— 列表每张单一颗实心金会把整屏点亮 */
.po-btn.primary {
  background: rgba(196, 167, 108, 0.1);
  box-shadow: var(--ring-brass);
  color: var(--brass-200);
}

.po-btn.ghost {
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.25);
  color: var(--color-text-secondary, #A09A90);
}

.po-btn-press {
  opacity: 0.85;
}

.po-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}
