<!-- 重定向壳：出货开单已并入「出货中心 · 开单」 -->
<view class="rd-page">
  <text class="rd-en">SHIPMENT · CENTER</text>
  <text class="rd-title">{{failed ? '未能自动跳转' : '正在前往出货中心…'}}</text>
  <text class="rd-sub">「出货开单」已并入出货中心的「开单」页签。</text>
  <view class="rd-actions" wx:if="{{failed}}">
    <view hover-class="tap-press" hover-stay-time="80" class="rd-btn" bindtap="goCenter"><text>前往出货中心</text></view>
    <view hover-class="tap-press" hover-stay-time="80" class="rd-btn is-ghost" bindtap="goBack"><text>返回</text></view>
  </view>
</view>
