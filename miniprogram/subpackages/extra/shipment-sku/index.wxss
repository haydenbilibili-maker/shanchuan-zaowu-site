page { background: #1a1814; }
.rd-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 48rpx;
  box-sizing: border-box;
}
.rd-en { font-size: var(--fs-20); letter-spacing: 0.18em; color: #7d786f; }
.rd-title { font-size: var(--fs-34); font-weight: 600; color: #f2ece1; }
.rd-sub { font-size: var(--fs-24); color: #a09a90; text-align: center; line-height: 1.5; }
.rd-actions { display: flex; flex-direction: column; gap: 14rpx; width: 100%; margin-top: 24rpx; }
.rd-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--color-primary), #a8874c);
  box-sizing: border-box;
}
.rd-btn text { font-size: var(--fs-28); font-weight: 600; color: #221e17; }
.rd-btn.is-ghost { background: transparent; border: 1rpx solid rgba(196, 167, 108, 0.5); }
.rd-btn.is-ghost text { color: #e8dcc0; font-weight: 500; }
