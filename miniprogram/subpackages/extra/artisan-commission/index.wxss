@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header { padding: var(--space-3) 0 var(--space-1); }
.brand-group { display: flex; flex-direction: column; }
.brand-group .en {
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600);
  text-transform: uppercase;
}
.brand-group .cn {
  font-family: var(--font-brand);
  font-size: 34rpx;
  color: var(--color-text-primary);
  margin-top: 4rpx;
}
.header-note {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
  line-height: 1.45;
}

.tabs {
  display: flex;
  gap: var(--space-2);
  margin: var(--space-2) 0 var(--space-3);
}
.tab {
  flex: 1;
  text-align: center;
  padding: var(--space-2) 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}
.tab.on {
  color: var(--brass-400);
  border-color: var(--brass-800);
}

.preview {
  font-size: 24rpx;
  color: var(--brass-400);
  margin-bottom: var(--space-3);
  line-height: 1.5;
}
.meta-line {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: var(--space-3);
}

/* ---------- 规则配置 ---------- */
.rule-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) 0 var(--space-2);
}
.rule-status-main {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  min-width: 0;
}
.status-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-muted);
}
.status-tag.on {
  color: var(--color-success);
  border-color: rgba(82, 183, 136, 0.4);
  background: rgba(82, 183, 136, 0.08);
}
.status-tag.off {
  color: var(--color-warning);
  border-color: rgba(233, 162, 59, 0.35);
  background: rgba(233, 162, 59, 0.08);
}
.rule-status-rate {
  font-family: var(--font-mono);
  font-size: 36rpx;
  color: var(--brass-400);
  letter-spacing: 0.02em;
}
.rule-summary {
  margin-bottom: var(--space-3);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--brass-400);
}
.rule-summary.muted {
  color: var(--color-text-muted);
}

.rule-block {
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-4);
  border-bottom: 1rpx solid var(--color-border);
}
.rule-block.advanced {
  border-bottom: none;
  padding-bottom: 0;
}
.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}
.block-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}
.block-hint {
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.block-note {
  display: block;
  margin-top: var(--space-3);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
}

.rate-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.rate-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--brass-400);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
  flex-shrink: 0;
}
.rate-btn:active {
  background: rgba(196, 167, 108, 0.12);
}
.rate-display {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}
.rate-input {
  width: 160rpx;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  text-align: center;
  font-family: var(--font-mono);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 80rpx;
  color: var(--brass-400);
  background: transparent;
  border: none;
}
.rate-unit {
  margin-left: 4rpx;
  font-size: 28rpx;
  color: var(--brass-600);
}
.preset-row {
  display: flex;
  gap: 12rpx;
  margin-top: var(--space-3);
}
.preset {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}
.preset.on {
  color: var(--brass-400);
  border-color: var(--brass-700);
  background: rgba(196, 167, 108, 0.08);
}

.sel-group + .sel-group {
  margin-top: var(--space-3);
}
.sel-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sel-tag {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 8rpx 10rpx 8rpx 16rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}
.sel-tag-text {
  max-width: 420rpx;
  font-size: 22rpx;
  color: var(--brass-300);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sel-tag-x {
  margin-left: 8rpx;
  padding: 0 8rpx;
  font-size: 28rpx;
  line-height: 1;
  color: var(--color-text-muted);
}

.search-btn {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 80rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--brass-400);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}
.hit-list {
  margin-top: var(--space-2);
  max-height: 420rpx;
  overflow-y: auto;
}
.hit-action.dim {
  color: var(--color-text-muted);
}

.advanced-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) 0 var(--space-3);
}
.advanced-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.advanced-arrow {
  font-size: 20rpx;
  color: var(--color-text-muted);
}
.field-block.first {
  margin-top: 0;
}

.section {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) 0;
}
.form-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.form-label.block {
  display: block;
  margin-bottom: 8rpx;
}
.field-block { margin-top: var(--space-3); }

/* 小程序 native input：左右留白防光标贴边；固定高度 + line-height 避免中文顶裁切 */
.input {
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  min-height: 80rpx;
  height: 80rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  line-height: 80rpx;
  overflow: visible;
}
.input.full { width: 100%; }
.input.sm {
  width: 168rpx;
  min-height: 72rpx;
  height: 72rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
  text-align: right;
}
.input.flex {
  flex: 1;
  min-width: 0;
  width: auto;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-2);
}
.chip {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}
.chip.on {
  color: var(--brass-400);
  border-color: var(--brass-700);
  background: rgba(196, 167, 108, 0.08);
}

.form-hint {
  margin-top: var(--space-2);
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.search-row {
  display: flex;
  gap: var(--space-2);
  align-items: center;
}
.hit-row, .sel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border);
}
.hit-main {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-2);
}
.hit-title {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-body);
  margin-right: var(--space-2);
}
.hit-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}
.hit-action {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-400);
}

.actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
}
.btn-primary {
  flex: 1;
  text-align: center;
  background: var(--brass-400);
  color: var(--color-bg);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  font-size: 28rpx;
  font-weight: 500;
}
.btn-ghost {
  flex: 1;
  text-align: center;
  border: 1rpx solid var(--brass-400);
  color: var(--brass-400);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  font-size: 28rpx;
}

.summary-card {
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
}
.summary-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.summary-value {
  margin-top: 6rpx;
  font-family: var(--font-mono);
  font-size: 36rpx;
  color: var(--brass-400);
}
.summary-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.filter-card {
  margin-bottom: var(--space-3);
  padding: var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}
.filter-field {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 20rpx;
  margin-bottom: 12rpx;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}
.filter-field.half {
  flex: 1;
  margin-bottom: 0;
}
.filter-dates {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.filter-dates picker {
  flex: 1;
  min-width: 0;
}
.filter-label {
  flex-shrink: 0;
  width: 88rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}
.filter-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filter-value.ph {
  color: var(--color-text-muted);
}
.filter-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--brass-400);
}
.filter-clear-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.filter-clear {
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.filter-btn {
  flex: none;
  width: 100%;
  margin: 0;
  padding: var(--space-2) 0;
  font-size: 26rpx;
}

.ledger-card {
  padding: var(--space-3);
  margin-bottom: var(--space-2);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}
.ledger-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ledger-type {
  font-size: 22rpx;
  color: var(--brass-400);
}
.ledger-type.reverse { color: var(--color-error); }
.ledger-amt {
  font-family: var(--font-mono);
  font-size: 28rpx;
  color: var(--color-text-primary);
}
.ledger-title {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-body);
}
.ledger-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.empty {
  text-align: center;
  padding: var(--space-6) 0;
  font-size: 24rpx;
  color: var(--color-text-muted);
}
.empty-friendly {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: var(--space-5) var(--space-4);
}
.empty-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.empty-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}
.empty-mini {
  padding: var(--space-3) 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(26, 24, 20, 0.72);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  max-height: 70vh;
  padding: var(--space-4) var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  border-top: 1rpx solid var(--brass-800);
  box-sizing: border-box;
}
.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}
.sheet-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}
.sheet-close {
  font-size: 24rpx;
  color: var(--brass-400);
}
.sheet-search { margin-bottom: var(--space-3); }
.sheet-list {
  max-height: 48vh;
}
.sheet-item {
  padding: 22rpx 8rpx;
  font-size: 28rpx;
  color: var(--color-text-body);
  border-bottom: 1rpx solid var(--color-border);
}
.sheet-item.on {
  color: var(--brass-400);
}

/* ---------- 多规则列表 ---------- */
.list-intro {
  margin-bottom: var(--space-3);
  padding-bottom: var(--space-2);
  border-bottom: 1rpx solid var(--color-border);
}
.list-intro-main {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}
.list-intro-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
  line-height: 1.45;
}

.rule-card {
  margin-bottom: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}
.rule-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
}
.rule-card-titles {
  flex: 1;
  min-width: 0;
}
.rule-card-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}
.rule-card-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}
.tier-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  color: var(--brass-400);
  border: 1rpx solid var(--brass-800);
  background: rgba(196, 167, 108, 0.08);
}
.tier-tag.muted {
  color: var(--color-text-muted);
  border-color: var(--color-border);
  background: transparent;
}
.rule-card-scope {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}
.rule-card-rate {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 34rpx;
  color: var(--brass-400);
}
.rule-card-meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-2);
}
.rule-card-pri {
  font-size: 20rpx;
  color: var(--color-text-muted);
}
.rule-card-actions {
  display: flex;
  gap: var(--space-4);
  margin-top: var(--space-3);
  padding-top: var(--space-2);
  border-top: 1rpx solid var(--color-border);
}
.rule-card-actions .act {
  font-size: 24rpx;
  color: var(--brass-400);
}
.rule-card-actions .act.danger {
  color: var(--color-error);
}

.editor-bar {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}
.editor-back {
  font-size: 24rpx;
  color: var(--brass-400);
}
.editor-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.workbench-footer-secondary {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-2);
}
.danger-outline {
  border-color: rgba(214, 64, 69, 0.55) !important;
  color: var(--color-error) !important;
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.empty-tip.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  margin: 16rpx 0;
}
.empty-title { display: block; font-size: 28rpx; color: #f0c9c0; margin-bottom: 8rpx; }
.empty-sub { display: block; font-size: 22rpx; color: rgba(232, 220, 192, 0.72); line-height: 1.5; }
.btn-retry {
  display: inline-block; margin-top: 24rpx; padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5); border-radius: 999rpx;
  font-size: 24rpx; color: #e8dcc0;
}
