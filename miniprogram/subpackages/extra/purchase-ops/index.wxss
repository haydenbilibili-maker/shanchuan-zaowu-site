@import '../utils/ops-museum.wxss';
@import '../utils/ops-dashboard.wxss';

.ops-container {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.ops-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  line-height: 1.5;
}
.ops-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.ops-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.ops-empty.is-error {
  border-style: solid;
  border-color: rgba(196, 92, 74, 0.4);
}
.po-retry {
  margin: 24rpx auto 0;
  max-width: 280rpx;
}
.ops-card.pending-remove {
  border-color: rgba(196, 92, 74, 0.55);
}

.ops-field {
  margin-bottom: 24rpx;
}

.ops-field-label {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.ops-field-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: var(--fs-28);
}

.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
}

.batch-hint {
  font-size: var(--fs-22);
  color: var(--brass-300, #d4bc85);
}

.chip-btn {
  padding: 8rpx 18rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #a09a90);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
}

.chip-btn.brass {
  color: var(--color-bg, #1a1814);
  background: var(--brass-400, #c4a76c);
  border-color: var(--brass-400, #c4a76c);
}

.ops-card.selected {
  border-color: var(--brass-400, #c4a76c);
}

.sync-body .sync-label {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.sync-body .sync-value {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  font-family: var(--font-mono, monospace);
}

.sync-body .sync-msg,
.sync-body .sync-note {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.sync-body .ops-btn-primary {
  margin-top: 28rpx;
}
