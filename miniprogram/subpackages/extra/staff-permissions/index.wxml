<view class="container" wx:if="{{ready}}">

  <view class="header">
    <view class="brand-group">
      <text class="en">STAFF ACCESS</text>
      <text class="cn">权限配置</text>
    </view>
    <view class="signal-legend header-legend">
      <view class="signal-legend-item"><view class="signal-light lamp-forest"></view><text class="signal-legend-text">深绿 · 生效</text></view>
      <view class="signal-legend-item"><view class="signal-light lamp-muted hollow"></view><text class="signal-legend-text">灰空心 · 停用</text></view>
    </view>
  </view>

  <view class="page-tip is-{{tipTone}}" wx:if="{{tipText}}"><text>{{tipText}}</text></view>

  <view class="section">
    <text class="section-title">后台角色</text>
    <text class="section-note">在这里为员工开通工作台功能（仅超管）。店员的报销、清单等审批由店长处理，超管可代审。</text>
    <view hover-class="tap-press" hover-stay-time="80" class="btn-primary" bindtap="openStaffModal">开通后台角色</view>
    <text class="section-note link-note" bindtap="copyOpenidHint">查不到人？点此查看如何获取微信编号</text>
  </view>

  <view class="section">
    <view class="loading-hint" wx:if="{{loading && !staffList.length && !listError}}">加载权限名单…</view>
    <view class="empty is-error" wx:if="{{listError && !staffList.length}}">
      <text class="empty-title">权限名单未能取回</text>
      <text class="empty-desc">{{tipText || '请下拉刷新重试'}}</text>
      <view hover-class="tap-press" hover-stay-time="80" class="btn-retry" bindtap="onRetryList">重试</view>
    </view>
    <block wx:elif="{{staffList.length}}">
      <view class="row staff-row" wx:for="{{staffList}}" wx:key="_id">
        <view class="row-main">
          <view class="staff-title-line">
            <view class="signal-light {{item.status === 'active' ? 'lamp-forest' : 'lamp-muted hollow'}}"></view>
            <text class="row-title">{{item.name || '未命名'}} · {{item.roleText}}</text>
            <text class="tag {{item.status}}">{{item.status === 'active' ? '生效' : '已停用'}}</text>
          </view>
          <text class="row-sub">…{{item.openidTail}}{{item.staffNo ? ' · ' + item.staffNo : ''}}</text>
          <text class="row-sub" wx:if="{{item.showStoreScope}}">{{item.storeIds.length ? '限门店 ' + item.storeIds.length + ' 家' : '全部门店'}}{{item.dailyGrantCap > 0 ? ' · 日限 ' + item.dailyGrantCap + ' 分' : ''}}</text>
          <text class="row-sub" wx:if="{{item.shareholderProfile && item.shareholderProfile.storeId}}">股东 · {{item.shareholderProfile.storeName || item.shareholderProfile.storeId}} · 占股 {{item.shareholderProfile.ownershipRatio || 0}}% · 回本前 {{item.shareholderProfile.dividendRatioBeforePayback != null ? item.shareholderProfile.dividendRatioBeforePayback : (item.shareholderProfile.dividendRatio || 0)}}% · 回本后 {{item.shareholderProfile.dividendRatioAfterPayback != null ? item.shareholderProfile.dividendRatioAfterPayback : (item.shareholderProfile.dividendRatio || 0)}}%</text>
        </view>
        <view class="staff-actions">
          <view hover-class="tap-press" hover-stay-time="80" class="staff-btn edit" catchtap="openStaffModal" data-id="{{item._id}}">编辑</view>
          <view hover-class="tap-press" hover-stay-time="80"
            class="staff-btn danger"
            wx:if="{{item.status === 'active'}}"
            catchtap="disableStaff"
            data-id="{{item._id}}"
          >{{disablePendingId === item._id ? '确认停用' : '停用'}}</view>
          <view hover-class="tap-press" hover-stay-time="80"
            class="staff-btn success"
            wx:else
            catchtap="enableStaff"
            data-id="{{item._id}}"
          >{{enablePendingId === item._id ? '确认启用' : '启用'}}</view>
        </view>
      </view>
    </block>
    <view class="empty" wx:elif="{{!loading && !listError}}">还没有员工账号，可用手机号开通</view>
  </view>

  <view class="section">
    <text class="field-label">权限边界</text>
    <text class="section-note">可按工作台勾选功能；没勾选的功能，员工看不到也用不了。超管拥有全部功能。</text>
  </view>
</view>

<view class="ui-pop-mask is-center" wx:if="{{showStaffModal}}" bindtap="closeStaffModal" catchtouchmove="true">
  <view class="ui-pop-dialog modal" catchtap="true">
    <view class="ui-pop-head">
      <text class="ui-pop-title">编辑权限</text>
      <text class="ui-pop-sub">输入手机号或会员号查找</text>
    </view>

    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="modal-body">
      <view class="field">
        <text class="field-label">手机号 / 会员号查找</text>
        <view class="phone-toolbar">
          <input class="input phone-input" type="number" maxlength="11"
                 placeholder="对方已授权的 11 位手机号" placeholder-class="ph"
                 value="{{staffForm.phone}}" bindinput="onStaffInput" data-field="phone" />
          <view hover-class="tap-press" hover-stay-time="80" class="lookup-btn {{staffLookingUp ? 'disabled' : ''}}" bindtap="lookupStaffByPhone">
            {{staffLookingUp ? '查找中' : '查找'}}
          </view>
        </view>
        <view class="phone-toolbar member-no-toolbar">
          <input class="input phone-input" maxlength="14"
                 placeholder="或输入会员号 MT-XXXX-XXXX" placeholder-class="ph"
                 value="{{staffMemberNoInput}}" bindinput="onStaffMemberNoInput" />
          <view hover-class="tap-press" hover-stay-time="80" class="lookup-btn {{staffLookingUp ? 'disabled' : ''}}" bindtap="lookupStaffByMemberNo">
            {{staffLookingUp ? '查找中' : '查找'}}
          </view>
        </view>
        <text class="field-hint warn" wx:if="{{staffMatchHint && !staffMatched}}">{{staffMatchHint}}</text>
        <view class="match-card" wx:if="{{staffMatched && staffMatched.openid}}">
          <text class="match-badge">已匹配</text>
          <text class="match-name">{{staffMatched.nickName || '藏家'}}</text>
          <text class="match-meta" wx:if="{{staffMatched.phoneMasked}}">{{staffMatched.phoneMasked}} · …{{staffMatched.openidTail}}</text>
          <text class="match-meta" wx:else>…{{staffMatched.openidTail}}</text>
          <text class="match-meta" wx:if="{{staffMatched.memberNo}}">会员号 {{staffMatched.memberNo}}</text>
        </view>
        <view class="candidate-list" wx:if="{{staffCandidates.length > 1}}">
          <text class="field-hint">找到多个账号，点选其一</text>
          <view hover-class="tap-press" hover-stay-time="80" class="candidate {{item.openid === staffForm.openid ? 'on' : ''}}"
                wx:for="{{staffCandidates}}" wx:key="openid"
                bindtap="selectStaffCandidate" data-openid="{{item.openid}}">
            <text class="match-name">{{item.nickName || '藏家'}}</text>
            <text class="match-meta">{{item.phoneMasked || item.memberNo}} · …{{item.openidTail}}</text>
          </view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">微信编号（openid）</text>
        <input class="input" placeholder="粘贴微信 openid / users._openid" placeholder-class="ph"
               value="{{staffForm.openid}}" bindinput="onStaffInput" data-field="openid" />
        <text class="field-hint" wx:if="{{staffForm.openid}}">当前 …{{staffForm.openidTail || staffForm.openid}}</text>
        <text class="field-hint" wx:else>手机号、会员号都查不到时，可粘贴微信编号（openid）</text>
      </view>

      <view class="field">
        <text class="field-label">姓名</text>
        <input class="input" value="{{staffForm.name}}" bindinput="onStaffInput" data-field="name" placeholder="选填" placeholder-class="ph" />
      </view>

      <view class="field">
        <text class="field-label">工号</text>
        <input class="input" value="{{staffForm.staffNo}}" bindinput="onStaffInput" data-field="staffNo" placeholder="选填" placeholder-class="ph" />
      </view>

      <view class="field">
        <text class="field-label">角色</text>
        <view class="seg-row wrap">
          <view hover-class="tap-press-soft" hover-stay-time="80"
            class="seg-item {{staffRoleSelected[staffRoleValues[index]] ? 'on' : ''}}"
            wx:for="{{staffRoleLabels}}"
            wx:key="*this"
            bindtap="onStaffRoleTap"
            data-idx="{{index}}"
          >{{item}}</view>
        </view>
        <text class="field-hint">可同时担任多个角色，将在「我的」分别显示对应工作台</text>
      </view>

      <view class="field {{!showStoreScope ? 'last' : ''}}" wx:if="{{featureGroups.length}}">
        <text class="field-label">工作台功能</text>
        <view class="feature-group" wx:for="{{featureGroups}}" wx:for-index="gidx" wx:key="roleKey">
          <view class="feature-group-head">
            <text class="feature-group-title">{{item.title}}</text>
            <text class="feature-group-en">{{item.en}}</text>
          </view>
          <text class="field-hint" wx:if="{{item.readOnly}}">超管工作台为全集，不可逐项关闭</text>
          <view hover-class="tap-press" hover-stay-time="80"
            class="feature-check {{feat.checked ? 'on' : ''}} {{item.readOnly || feat.disabled ? 'locked' : ''}}"
            wx:for="{{item.items}}"
            wx:for-item="feat"
            wx:for-index="iidx"
            wx:key="key"
            bindtap="toggleFeature"
            data-gidx="{{gidx}}"
            data-iidx="{{iidx}}"
          >
            <text class="feature-check-label">{{feat.label}}</text>
            <text class="feature-check-state">{{feat.checked ? '开' : '关'}}</text>
          </view>
        </view>
      </view>

      <view class="field" wx:if="{{showShareholderConfig}}">
        <text class="field-label">股东配置</text>
        <text class="field-hint">绑定门店；回本前/后分成占投资人分红池比重（与财务双阶段一致）。完整维护请用「股东配置」入口。</text>
        <view class="store-check-list">
          <view hover-class="tap-press" hover-stay-time="80"
            class="store-check {{item.selected ? 'on' : ''}}"
            wx:for="{{shareholderStoreChecks}}"
            wx:key="key"
            bindtap="toggleShareholderStore"
            data-id="{{item.storeId}}"
          >{{item.name}}</view>
        </view>
        <view class="shareholder-fields">
          <view class="field">
            <text class="field-label">占股比例 (%)</text>
            <input class="input" type="digit" value="{{staffForm.ownershipRatio}}" bindinput="onStaffInput" data-field="ownershipRatio" placeholder="如 30" placeholder-class="ph" />
          </view>
          <view class="field">
            <text class="field-label">回本前分成 (%)</text>
            <input class="input" type="digit" value="{{staffForm.dividendRatioBeforePayback}}" bindinput="onStaffInput" data-field="dividendRatioBeforePayback" placeholder="占投资人分红池，如 50" placeholder-class="ph" />
          </view>
          <view class="field">
            <text class="field-label">回本后分成 (%)</text>
            <input class="input" type="digit" value="{{staffForm.dividendRatioAfterPayback}}" bindinput="onStaffInput" data-field="dividendRatioAfterPayback" placeholder="默认同回本前" placeholder-class="ph" />
          </view>
          <view class="field">
            <text class="field-label">出资额 （元）</text>
            <input class="input" type="digit" value="{{staffForm.capitalContribution}}" bindinput="onStaffInput" data-field="capitalContribution" placeholder="个人出资额" placeholder-class="ph" />
          </view>
          <view class="field last">
            <text class="field-label">生效日</text>
            <picker mode="date" value="{{staffForm.effectiveDate || '2024-01-01'}}" bindchange="onShareholderDateChange">
              <view class="input picker-like">{{staffForm.effectiveDate || '选择生效日'}}</view>
            </picker>
          </view>
        </view>
      </view>

      <view class="field" wx:if="{{showStoreScope}}">
        <text class="field-label">可操作门店</text>
        <view class="store-check-list">
          <view hover-class="tap-press" hover-stay-time="80"
            class="store-check {{item.selected ? 'on' : ''}}"
            wx:for="{{staffStoreChecks}}"
            wx:key="key"
            bindtap="toggleStaffStore"
            data-id="{{item.storeId}}"
            data-all="{{item.isAll}}"
          >{{item.name}}</view>
        </view>
        <text class="field-hint">未选或「全部门店」= 全部；勾选后仅限所选</text>
      </view>

      <view class="field last" wx:if="{{showStoreScope}}">
        <text class="field-label">单日发放积分上限</text>
        <input class="input" type="number" value="{{staffForm.dailyGrantCap}}" bindinput="onStaffInput" data-field="dailyGrantCap" placeholder="0 = 不额外限制" placeholder-class="ph" />
      </view>
    </scroll-view>

    <view class="page-tip is-warn" wx:if="{{formTip}}" style="margin:0 24rpx 16rpx;"><text>{{formTip}}</text></view>
    <view class="workbench-modal-foot">
      <view hover-class="tap-press-soft" hover-stay-time="80" class="workbench-btn-outline" bindtap="closeStaffModal">取消</view>
      <view hover-class="tap-press" hover-stay-time="80" class="workbench-btn-primary {{staffSaving ? 'is-disabled' : ''}}" bindtap="saveStaff">{{staffSaving ? '保存中…' : '保存'}}</view>
    </view>
  </view>
</view>
