/* 权限配置 — Museum Mode（与门店积分页共用视觉） */
@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.container {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  padding: var(--space-5) 0 var(--space-2);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.brand-group .cn {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.section {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.section-title {
  display: block;
  margin-bottom: var(--space-2);
  font-size: var(--fs-28);
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
}

.feature-group {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border);
}

.feature-group-head {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.feature-group-title {
  font-size: var(--fs-26);
  color: var(--color-text-primary);
}

.feature-group-en {
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: var(--brass-600);
}

.feature-check {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-3);
  margin-bottom: var(--space-2);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
}

.feature-check.on {
  border-color: var(--brass-800);
}

.feature-check.locked {
  opacity: 0.72;
}

.feature-check-label {
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

.feature-check-state {
  font-size: var(--fs-22);
  color: var(--brass-400);
}

.section-note {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-secondary, #A09A90);
}

.section-note.link-note {
  color: var(--brass-400);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  margin-top: var(--space-3);
  padding: 0 var(--space-5);
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  font-weight: 500;
  letter-spacing: 0.02em;
  background: var(--brass-400);
  color: var(--color-bg);
  border: 1rpx solid var(--brass-400);
}

.btn-primary:active {
  background: var(--brass-500);
  border-color: var(--brass-500);
}

.staff-row {
  flex-direction: row;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) 0;
}

.staff-title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.header-legend {
  margin-top: var(--space-3);
}

.staff-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex-shrink: 0;
  gap: var(--space-2);
}

.staff-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  min-height: 64rpx;
  padding: 0 var(--space-3);
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  font-weight: 500;
  box-sizing: border-box;
}

.staff-btn.edit {
  background: transparent;
  border: 1rpx solid var(--brass-400);
  color: var(--brass-400);
}

.staff-btn.danger {
  background: transparent;
  border: 1rpx solid rgba(214, 64, 69, 0.55);
  color: var(--color-error);
}

.staff-btn.success {
  background: transparent;
  border: 1rpx solid rgba(82, 183, 136, 0.55);
  color: var(--color-success);
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.row-title {
  font-size: var(--fs-28);
  color: var(--color-text-primary);
}

.row-sub {
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-20);
  color: var(--color-success);
  background: rgba(82, 183, 136, 0.1);
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.field {
  margin-bottom: 32rpx;
}

.field.last {
  margin-bottom: 8rpx;
}

.field-hint {
  display: block;
  margin-top: 14rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

.field-hint.warn {
  color: var(--color-warning);
}

.seg-row {
  display: flex;
  gap: 16rpx;
}

.seg-row.wrap {
  flex-wrap: wrap;
}

.seg-item {
  flex: 0 0 auto;
  padding: 0 24rpx;
  min-width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.seg-item.on {
  color: var(--brass-400);
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.14);
}

.store-check-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.store-check {
  padding: 0 24rpx;
  height: 68rpx;
  line-height: 68rpx;
  border: 1rpx solid rgba(77, 64, 26, 0.4);
  border-radius: var(--radius-md);
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  box-sizing: border-box;
}

.store-check.on {
  border-color: var(--brass-400);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.14);
}

.phone-toolbar {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  height: 80rpx;
}

.member-no-toolbar {
  margin-top: 16rpx;
}

.phone-toolbar .phone-input {
  flex: 1;
  min-width: 0;
  width: auto;
}

.lookup-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 80rpx;
  font-size: var(--fs-26);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.lookup-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.match-card,
.candidate {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-md);
}

.candidate-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.candidate {
  border-color: rgba(77, 64, 26, 0.55);
  background: var(--color-bg-elevated);
}

.candidate.on {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
}

.match-badge {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 2rpx 12rpx;
  font-size: var(--fs-20);
  color: var(--brass-400);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-full);
}

.match-name {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
}

.match-meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.input {
  display: block;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 24rpx;
  line-height: normal;
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: var(--fs-28);
  box-sizing: border-box;
}
.picker-like {
  display: flex;
  align-items: center;
}
.shareholder-fields .field {
  margin-top: 16rpx;
}

.ph {
  color: var(--color-text-secondary, #A09A90);
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}

.loading-hint {
  padding: var(--space-6) var(--space-2);
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.empty {
  padding: var(--space-6) var(--space-2);
  text-align: center;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary, #A09A90);
}
.empty.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: var(--radius-md);
  padding: 32rpx 24rpx;
}
.empty-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}
.empty-desc {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}
.btn-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
  font-size: var(--fs-24);
  color: #e8dcc0;
}



.modal {
  width: 100%;
  max-height: calc(100vh - 64rpx - constant(safe-area-inset-bottom));
  max-height: calc(100vh - 64rpx - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}



.modal-body {
  /* 可收缩滚动：长内容时让出底栏；短内容时弹层随内容变矮 */
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 28rpx 0 16rpx;
  box-sizing: border-box;
}





/* 弹窗底栏固定可见：不随内容滚动；覆盖 width:100% 使取消/保存并排等宽 */
.modal .workbench-modal-foot {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  position: relative;
  z-index: 2;
}

.modal .workbench-modal-foot .workbench-btn-primary,
.modal .workbench-modal-foot .workbench-btn-outline {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
}

/* ================================================================
   2026-10-18 产品负责人真机截图「此页面无法滑动」+「相关二级页面修复提升」
   ① 滑不动：遮罩 catchtouchmove 会吞掉 view 的 overflow 滚动 → 弹窗正文改 <scroll-view scroll-y>
     （docs/弹层视觉规范 §遮罩：长内容用 scroll-view）；正文限高，底栏永远可见。
   ② 右缘被裁：正文左右留 4rpx，1rpx 描边不再落在裁切边上（真机 0.5px 取整被吃掉）。
   ③ 底栏：workbench-modal-foot 是抽屉用的（卡底 + 安全区内边距），放进居中弹窗只留发丝顶线。
   ④ 视觉对齐：方角发丝框、等宽眉标 + 宋体、方签；实心金只留主按钮（「开通后台角色」/「保存」）。
   本文件 manager / extra 两份（subpackage-mirrors 登记为非一致镜像），本段两份同写。
   ================================================================ */
.modal {
  max-height: calc(100vh - 160rpx);
}
.modal-body {
  flex: 1 1 auto;
  min-height: 0;
  max-height: calc(100vh - 600rpx);
  padding: 24rpx 4rpx 16rpx;
}
.modal .workbench-modal-foot {
  gap: 20rpx;
  padding: 24rpx 4rpx 0;
  background: transparent;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.brand-group .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.brand-group .cn {
  margin-top: 8rpx;
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}
.section {
  background: rgba(243, 236, 221, 0.02);
  border: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: 4rpx;
}
.section-title {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  letter-spacing: 0.08em;
  color: #F3ECDD;
}
.row { border-bottom-color: rgba(196, 167, 108, 0.14); }
.btn-primary {
  border-radius: 4rpx;
  font-weight: 600;
  color: #1A1814;
}
.staff-btn,
.tag,
.lookup-btn,
.seg-item,
.store-check,
.input,
.match-badge,
.btn-retry,
.page-tip {
  border-radius: 2rpx;
}
.lookup-btn { background: transparent; }
.seg-item.on,
.store-check.on {
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass-soft);
}
.match-card,
.candidate,
.empty.is-error {
  border-radius: 4rpx;
}
.feature-group { border-top-color: rgba(196, 167, 108, 0.14); }
.feature-group-title {
  font-family: var(--font-brand);
  font-weight: 600;
  color: #F3ECDD;
}
.feature-group-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}
.feature-check {
  border-radius: 2rpx;
  background: transparent;
  border-color: rgba(196, 167, 108, 0.14);
}
.feature-check.on {
  background: rgba(196, 167, 108, 0.06);
  border-color: rgba(196, 167, 108, 0.45);
}
.feature-check-state {
  font-family: var(--font-mono);
  letter-spacing: 0.1em;
  color: rgba(185, 173, 150, 0.8);
}
.feature-check.on .feature-check-state { color: var(--brass-200); }
