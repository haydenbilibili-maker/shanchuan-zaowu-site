@import '../../utils/workbench-nav.wxss';

/* 2026-10-18 视觉对齐（产品负责人点名「继续子页面重构」；与标本师工作台首页同口径，只改样式）：
   方角（卡 4rpx / 签 2rpx）、眉标等宽、标题宋体；列表为发丝线行；状态色（待办黄 / 驳回红 / 已上架绿 …）为员工端语义，保留。 */

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header { padding: var(--space-5) 0 var(--space-3); }
.brand-group { display: flex; flex-direction: column; }
.brand-group .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.brand-group .cn {
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}
.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

/* 汇总 = 浅纸账签（墨色等宽大数） */
.summary-card {
  position: relative;
  padding: 40rpx 32rpx 28rpx;
  margin-bottom: var(--space-5);
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.42);
}
.summary-card::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.summary-label {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: #8B6F47;
}
.summary-value {
  margin-top: 10rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-48);
  color: #2E2618;
}
.summary-sub {
  margin-top: 10rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: #5A4E3A;
}

.section-title {
  margin-bottom: var(--space-3);
  padding-bottom: 14rpx;
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

/* 明细：发丝线行（原圆角卡） */
.ledger-card {
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}
.ledger-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ledger-type {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-300);
}
.ledger-type.reverse { color: var(--color-error); }
.ledger-amt {
  font-family: var(--font-mono);
  font-size: var(--fs-30);
  color: var(--brass-200);
}
.ledger-title {
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  color: #F3ECDD;
}
.ledger-meta {
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.empty {
  text-align: center;
  padding: var(--space-6) 0;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}
