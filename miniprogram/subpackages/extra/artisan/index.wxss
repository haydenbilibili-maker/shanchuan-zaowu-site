@import '../utils/workbench-nav.wxss';

/* 标本师工作台（2026-10-18 视觉对齐，产品负责人点名；只改本页样式，workbench-nav 共享件不动）
   眉标 + 宋体分区题；今日待办 = 发丝线账格（有待办的格暖金底 + 金线环）；工单预览 / 作品库 / 档案与薪酬 = 发丝线行 + 方印图标。
   员工端信号灯语义保留（黄 = 待办、蓝 = 装裱中、深绿 = 已上架、灰 = 空闲，页头有图例）。与主播工作台同口径。 */

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  padding: var(--space-5) 0 var(--space-4);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.brand-group .cn {
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.greeting {
  display: block;
  margin-top: var(--space-4);
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  color: #F3ECDD;
}

.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 工作通知声音 chip（#29） */
.header-voice {
  margin-top: var(--space-2);
}

.group {
  margin-bottom: var(--space-6);
}

/* 分区头 = 等宽眉标 + 宋体主标 + 渐隐金线（与全站 mu-head 同口径） */
.group-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: var(--space-3);
  padding-bottom: 16rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

.group-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.group-cn {
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

/* 今日待办：方角发丝账格；有待办的格 = 暖金底 + 金线环，零的格退到发丝框 */
.todo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.todo-chip {
  flex: 1;
  min-width: 46%;
  padding: 22rpx 24rpx;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.18);
  box-sizing: border-box;
}

.todo-chip.hot {
  background: rgba(196, 167, 108, 0.07);
  box-shadow: var(--ring-brass-soft);
}

.todo-chip-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.header-legend {
  margin-top: var(--space-3);
}

.module-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.todo-chip-press {
  background: rgba(196, 167, 108, 0.12);
}

.todo-val {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-36);
  color: rgba(160, 154, 144, 0.85);
}

.todo-chip.hot .todo-val { color: var(--brass-200); }

.todo-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.todo-empty {
  margin-top: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border: 1rpx dashed rgba(196, 167, 108, 0.24);
  border-radius: 4rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.job-preview {
  margin-top: var(--space-4);
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.job-preview-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.job-preview-press {
  background: rgba(196, 167, 108, 0.06);
}

.job-preview-main {
  flex: 1;
  min-width: 0;
}

.job-preview-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-preview-meta {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

/* 作品库 / 档案与薪酬：发丝线行（原大圆角卡），图标为方印 */
.module-card {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.module-card:last-child {
  margin-bottom: 0;
}

.module-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.35);
}

.module-icon image {
  width: 36rpx;
  height: 36rpx;
}

.module-card-body {
  flex: 1;
  min-width: 0;
}

.module-chevron {
  flex-shrink: 0;
  font-size: var(--fs-36);
  line-height: 1;
  color: var(--brass-300);
}

.module-card-press {
  background: rgba(196, 167, 108, 0.06);
}

.module-card-press .module-chevron {
  color: var(--brass-200);
}

.module-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.module-desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.empty-hint {
  margin-top: var(--space-6);
  padding: var(--space-4);
  border: 1rpx dashed rgba(196, 167, 108, 0.24);
  border-radius: 4rpx;
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  text-align: center;
}

.page-boot {
  padding: var(--space-6) 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.page-boot .boot-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.page-boot .boot-cn {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.page-boot .boot-hint {
  margin-top: var(--space-4);
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
}
