@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  padding: var(--space-5) 0 var(--space-4);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
}

.brand-group .cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.greeting {
  display: block;
  margin-top: var(--space-4);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 工作通知声音 chip（#29） */
.header-voice {
  margin-top: var(--space-2);
}

.group {
  margin-bottom: var(--space-6);
}

.group-head {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-3);
}

.group-en {
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--color-text-secondary, #A09A90);
}

.group-cn {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.todo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.todo-chip {
  flex: 1;
  min-width: 46%;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.todo-chip.hot {
  border-color: var(--brass-800);
}

.todo-chip-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.header-legend {
  margin-top: var(--space-3);
}

.module-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.todo-chip-press {
  background: var(--color-bg-elevated);
  border-color: var(--brass-800);
}

.todo-val {
  display: block;
  font-family: var(--font-mono);
  font-size: 32rpx;
  color: var(--brass-400);
}

.todo-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.todo-empty {
  margin-top: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border: 1rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.job-preview {
  margin-top: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.job-preview-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.job-preview-press {
  border-color: var(--brass-800);
  background: var(--color-bg-elevated);
}

.job-preview-main {
  flex: 1;
  min-width: 0;
}

.job-preview-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-preview-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.module-card {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.module-card:last-child {
  margin-bottom: 0;
}

.module-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.1);
}

.module-icon image {
  width: 40rpx;
  height: 40rpx;
}

.module-card-body {
  flex: 1;
  min-width: 0;
}

.module-chevron {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
  color: var(--brass-400);
  opacity: 0.85;
}

.module-card-press {
  border-color: var(--brass-800);
  background: var(--color-bg-elevated);
}

.module-card-press .module-chevron {
  color: var(--brass-300);
}

.module-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.module-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.empty-hint {
  margin-top: var(--space-6);
  padding: var(--space-4);
  border: 1rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.page-boot {
  padding: var(--space-6) 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.page-boot .boot-en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
}

.page-boot .boot-cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.page-boot .boot-hint {
  margin-top: var(--space-4);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
