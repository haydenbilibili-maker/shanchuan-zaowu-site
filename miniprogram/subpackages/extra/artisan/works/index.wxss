@import '../index.wxss';
@import '../../utils/workbench-nav.wxss';

/* 2026-10-18 视觉对齐（产品负责人点名「继续子页面重构」；与标本师工作台首页同口径，只改样式）：
   页头不再装盒（眉标 + 宋体主标）；筛选为方角发丝签、选中金线环；作品 / 工单为发丝线行；
   状态签颜色（已上架绿 / 待确认黄 / 驳回红 / 装裱铜 / 打包蓝）为员工端语义，保留。详情弹层壳由 ui-pop-* 管，不动。 */

.page-mode-manage .mode-banner {
  background: transparent;
}

.page-mode-works .mode-banner {
  background: transparent;
}

.mode-banner {
  padding: var(--space-5) 0 var(--space-4);
  margin-bottom: var(--space-2);
}

.mode-tag {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.mode-title {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.mode-banner .sub {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.toolbar {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.toolbar-primary {
  flex: 1;
}

.toolbar-side {
  flex: 0 0 auto;
  min-width: 168rpx;
}

.toolbar-batch .toolbar-side {
  flex: 1;
}

.filter-row {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.filter-chip {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) var(--space-3);
  box-sizing: border-box;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2);
  text-align: center;
}

.filter-chip.on {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass);
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.skeleton-card {
  display: flex;
  gap: var(--space-3);
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.sk-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 4rpx;
  background: var(--color-bg-elevated);
  animation: sk-pulse 1.2s ease-in-out infinite;
}

.sk-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-3);
}

.sk-line {
  height: 24rpx;
  width: 55%;
  border-radius: var(--radius-sm);
  background: var(--color-bg-elevated);
  animation: sk-pulse 1.2s ease-in-out infinite;
}

.sk-line.wide {
  width: 85%;
}

@keyframes sk-pulse {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.9; }
}

.retry-btn,
.empty-cta {
  margin-top: var(--space-4);
  width: 100%;
}

.empty-cta-row {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.empty-cta-row .empty-cta {
  margin-top: 0;
  flex: 1;
}

.empty-state {
  padding: var(--space-6) var(--space-4);
}

.work-list {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

/* 作品 / 工单行：发丝线（原圆角卡），选中 = 淡金底 + 左侧金线 */
.work-card {
  display: flex;
  align-items: stretch;
  gap: var(--space-3);
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.work-card.is-selected {
  background: rgba(196, 167, 108, 0.08);
  box-shadow: inset 3rpx 0 0 var(--brass-400);
}

.select-mark {
  flex-shrink: 0;
  align-self: center;
  min-width: 72rpx;
  padding: 6rpx 10rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.35);
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  text-align: center;
}

.select-mark.on {
  color: var(--brass-200);
  box-shadow: var(--ring-brass);
}

.work-card-press {
  background: rgba(196, 167, 108, 0.06);
}

.cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
  flex-shrink: 0;
  overflow: hidden;
  background: #1F1D1A;
}

.cover image {
  width: 100%;
  height: 100%;
  display: block;
}

.work-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.work-title {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-latin,
.job-latin {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-latin);
  font-style: italic;
  font-size: var(--fs-22);
  color: var(--color-text-latin);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-match {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-20);
  letter-spacing: 0.04em;
  color: var(--brass-600);
}

.work-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  gap: var(--space-2);
}

.shelf-tag {
  font-size: var(--fs-20);
  padding: 4rpx 12rpx;
  border-radius: 2rpx;
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
  background: rgba(107, 101, 96, 0.2);
}

.shelf-tag.on {
  color: var(--color-success);
  background: rgba(82, 183, 136, 0.12);
}

.shelf-tag.pending,
.shelf-tag.pending_make {
  color: var(--color-warning);
  background: rgba(233, 162, 59, 0.14);
}

.shelf-tag.rejected {
  color: var(--color-error-on-tint);
  background: rgba(214, 64, 69, 0.12);
}

.shelf-tag.framing {
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.14);
}

.shelf-tag.packing {
  color: var(--color-info-on-tint);
  background: rgba(91, 143, 185, 0.14);
}

.shelf-tag.shipped {
  color: var(--color-success);
  background: rgba(82, 183, 136, 0.12);
}

.filter-row.wrap {
  flex-wrap: wrap;
}

.filter-row.wrap .filter-chip {
  flex: 0 0 auto;
  min-width: 22%;
  padding: var(--space-2) var(--space-3);
}

.job-card {
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.job-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.job-no {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: var(--color-text-secondary, #A09A90);
}

.job-title {
  display: block;
  margin-top: var(--space-2);
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  color: #F3ECDD;
}

.job-meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.job-next {
  margin-top: var(--space-4);
}


.detail-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: var(--space-3) var(--space-4) calc(var(--space-6) + env(safe-area-inset-bottom));
}

.detail-handle {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto var(--space-4);
  border-radius: 2rpx;
  background: var(--brass-800);
}

.detail-cover {
  width: 100%;
  height: 280rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
}

.detail-cover image {
  width: 100%;
  height: 100%;
  display: block;
}

.detail-title {
  display: block;
  margin-top: var(--space-4);
  font-size: var(--fs-34);
  font-weight: 500;
  color: var(--color-text-primary);
}

.detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-2);
}

.detail-hint {
  display: block;
  margin-top: var(--space-3);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.detail-facts {
  margin-top: var(--space-3);
  padding: var(--space-3);
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: 4rpx;
}

.detail-fact {
  display: flex;
  gap: var(--space-3);
  padding: 8rpx 0;
}

.detail-fact + .detail-fact {
  border-top: 1rpx solid var(--color-border);
}

.fact-k {
  width: 140rpx;
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.fact-v {
  flex: 1;
  font-size: var(--fs-24);
  color: var(--color-text-body);
  line-height: 1.45;
}

.detail-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.detail-shelf {
  margin-top: var(--space-3);
}

.work-price {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--color-text-primary);
}

.work-action-row {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.action-btn {
  flex: 1;
  min-height: 80rpx;
}

.action-btn.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.workbench-btn-ghost.is-disabled,
.workbench-btn-outline.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.workbench-btn-outline.action-btn {
  flex: 1;
  width: auto;
}

.workbench-btn-ghost.action-btn {
  flex: 1;
  width: auto;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .sk-cover,
  .sk-line {
    animation: none;
  }
}
