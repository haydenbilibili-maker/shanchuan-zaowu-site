@import '../../utils/workbench-nav.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.is-busy .btn-primary,
.page.is-busy .btn-brass-outline,
.page.is-busy .btn-ghost {
  opacity: 0.72;
}

/* —— boot / skel —— */
.page-boot {
  padding: var(--space-8) 0;
}

.boot-en,
.hero .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
}

.boot-cn,
.hero .cn {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  color: var(--color-text-primary);
  margin-top: 8rpx;
}

.skel-line {
  margin-top: var(--space-3);
  height: 20rpx;
  width: 70%;
  border-radius: 4rpx;
  background: var(--color-bg-elevated);
}

.skel-line.short { width: 42%; }
.skel-line.wide { width: 88%; height: 36rpx; }

.skel-block {
  margin-top: var(--space-4);
  height: 160rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
}

/* —— hero —— */
.hero {
  padding: var(--space-5) 0 var(--space-3);
}

.lead {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* —— composer 一构图 —— */
.composer {
  margin-bottom: var(--space-5);
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  border: 1px solid var(--brass-800);
  background: var(--color-bg-card);
}

.type-scroll {
  width: 100%;
  margin-bottom: var(--space-3);
}

.type-track {
  display: inline-flex;
  padding-bottom: 2rpx;
}

.type-card {
  flex-shrink: 0;
  min-width: 148rpx;
  margin-right: 12rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  box-sizing: border-box;
}

.type-press { opacity: 0.85; }

.type-card.on {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.1);
}

.type-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.type-card.on .type-name { color: var(--brass-400); }

.type-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  font-family: var(--font-mono);
  color: var(--color-text-secondary, #A09A90);
}

.type-card.on .type-meta { color: var(--brass-600); }

.filter-sheet { margin-bottom: var(--space-2); }

.field-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.field-row picker { flex: 1; min-width: 0; }

.picker-chip {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg);
}

.picker-k {
  font-size: 18rpx;
  letter-spacing: 0.08em;
  color: var(--color-text-secondary, #A09A90);
}

.picker-v {
  font-size: 24rpx;
  color: var(--color-text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notes-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  margin-bottom: 8rpx;
}

.notes-toggle-t {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.notes-chevron {
  font-size: 22rpx;
  color: var(--brass-600);
}

.notes-input {
  width: 100%;
  min-height: 120rpx;
  margin-bottom: var(--space-3);
  padding: var(--space-3);
  box-sizing: border-box;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.5;
}

.example-scroll {
  width: 100%;
  margin-bottom: var(--space-4);
}

.example-track {
  display: inline-flex;
}

.chip {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-sm);
  border: 1px solid var(--brass-800);
  font-size: 22rpx;
  color: var(--brass-400);
}

.chip-press { opacity: 0.8; }

.cta-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cta-row {
  display: flex;
  gap: 12rpx;
}

.cta-row .flex { flex: 1; min-width: 0; }

.btn-primary,
.btn-brass-outline,
.btn-ghost {
  margin: 0;
  line-height: 1.35;
  padding: 22rpx var(--space-3);
  font-size: 26rpx;
}

.btn-primary {
  background: var(--brass-400);
  color: var(--color-bg);
  border: none;
  border-radius: var(--radius-md);
  font-weight: 500;
  font-size: 28rpx;
}

.btn-brass-outline {
  background: transparent;
  color: var(--brass-400);
  border: 1px solid var(--brass-400);
  border-radius: var(--radius-md);
}

.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}

.btn-primary::after,
.btn-brass-outline::after,
.btn-ghost::after { border: none; }

.status-line { margin-top: var(--space-3); }

.status-bar {
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-bg-elevated);
  overflow: hidden;
}

.status-fill {
  height: 100%;
  background: var(--brass-400);
  transition: width 0.25s ease;
}

.status-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.error-box {
  margin-top: var(--space-3);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  border: 1px solid rgba(214, 64, 69, 0.3);
  background: rgba(214, 64, 69, 0.06);
  display: flex;
  gap: var(--space-3);
}

.error-text {
  flex: 1;
  font-size: 24rpx;
  color: #C97A7D;
  line-height: 1.45;
}

.error-retry {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brass-400);
}

/* —— result —— */
.group { margin-bottom: var(--space-5); }

.group-head.tight { margin-bottom: var(--space-3); }

.group-en {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--color-text-secondary, #A09A90);
}

.group-cn {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.empty-plate {
  padding: var(--space-5);
  border-radius: var(--radius-lg);
  border: 1px dashed var(--color-border);
  background: transparent;
}

.empty-plate.soft { padding: var(--space-3) 0; border: none; }

.empty-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.empty-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.plate-card.skel {
  padding: var(--space-5);
  border-radius: var(--radius-lg);
  border: 1px solid var(--brass-800);
  background: var(--color-bg-card);
}

/* 铜牌概念卡 */
.plate-card {
  position: relative;
  border-radius: var(--radius-lg);
  border: 1px solid var(--brass-800);
  background: var(--color-bg-card);
  overflow: hidden;
}

.plate-rail {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, var(--brass-400) 0%, var(--brass-700) 100%);
}

.plate-body {
  padding: var(--space-4) var(--space-4) var(--space-4) calc(var(--space-4) + 8rpx);
}

.plate-en {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600);
}

.plate-name {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  line-height: 1.3;
  color: var(--color-text-primary);
  word-break: break-word;
}

.plate-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 16rpx;
  margin-top: var(--space-3);
}

.plate-price {
  font-family: var(--font-mono);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--brass-400);
}

.plate-pos,
.plate-margin {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.plate-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: var(--space-3);
}

.ptag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1px solid var(--brass-800);
  color: var(--brass-600);
}

.plate-sec {
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1px solid var(--color-border);
}

.plate-lab {
  display: block;
  margin-bottom: 10rpx;
  font-size: 20rpx;
  letter-spacing: 0.1em;
  color: var(--brass-600);
}

.plate-bullet {
  margin-bottom: 8rpx;
  padding-left: 16rpx;
  border-left: 2rpx solid var(--brass-800);
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--color-text-body);
}

.plate-copy {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--color-text-body);
  word-break: break-word;
}

.plate-copy.dim {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
}

.plate-split {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1px solid var(--color-border);
}

.plate-col {
  flex: 1;
  min-width: 0;
}

.plate-mini {
  display: block;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-text-body);
}

.plate-mini.warn { color: var(--color-text-secondary); }

.plate-actions {
  margin-top: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 变体对比 */
.variant-scroll {
  width: 100%;
  margin-bottom: var(--space-3);
}

.variant-track { display: inline-flex; }

.variant-chip {
  flex-shrink: 0;
  width: 200rpx;
  margin-right: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
}

.variant-chip.on {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.08);
}

.variant-chip.pending { opacity: 0.55; }

.variant-idx {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.08em;
  color: var(--brass-600);
}

.variant-name {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* —— history drawer —— */
.history-drawer {
  margin-bottom: var(--space-6);
  padding-top: var(--space-3);
  border-top: 1px solid var(--color-border);
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: var(--space-2) 0 var(--space-3);
}

.filter-tabs {
  display: flex;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.filter-tab {
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.filter-tab.on { color: var(--brass-400); }

.search-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.search-input {
  flex: 1;
  padding: 14rpx 20rpx;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  font-size: 24rpx;
  color: var(--color-text-body);
}

.search-clear {
  font-size: 22rpx;
  color: var(--brass-400);
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--color-border);
}

.history-press { opacity: 0.85; }

.history-main { flex: 1; min-width: 0; }

.history-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.history-ops {
  display: flex;
  gap: var(--space-3);
  flex-shrink: 0;
}

.fav-btn { font-size: 22rpx; color: var(--brass-400); }
.del-btn { font-size: 22rpx; color: var(--color-text-secondary, #A09A90); }
