@import '../../utils/workbench-nav.wxss';

/* 2026-10-18 视觉对齐（产品负责人点名「继续子页面重构」；与标本师工作台首页同口径，只改样式）：
   眉标等宽 + 宋体主标 + 渐隐金线分区头；类型 / 参数 / 变体为方角发丝签、选中金线环；
   生成结果「铜牌概念卡」改为**浅纸标本签**（铜钉 + 内发丝框 + 墨色），签内按钮随纸面换墨铜线。 */

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.is-busy .btn-primary,
.page.is-busy .btn-brass-outline,
.page.is-busy .btn-ghost {
  opacity: 0.72;
}

/* —— boot / skel —— */
.page-boot {
  padding: var(--space-8) 0;
}

.boot-en,
.hero .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.boot-cn,
.hero .cn {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.skel-line {
  margin-top: var(--space-3);
  height: 20rpx;
  width: 70%;
  border-radius: 4rpx;
  background: var(--color-bg-elevated);
}

.skel-line.short { width: 42%; }
.skel-line.wide { width: 88%; height: 36rpx; }

.skel-block {
  margin-top: var(--space-4);
  height: 160rpx;
  border-radius: 4rpx;
  background: var(--color-bg-elevated);
}

/* —— hero —— */
.hero {
  padding: var(--space-5) 0 var(--space-3);
}

.lead {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

/* —— composer 一构图 —— */
.composer {
  margin-bottom: var(--space-5);
  padding: var(--space-4);
  border-radius: 4rpx;
  border: 1rpx solid var(--brass-800);
  background: var(--color-bg-card);
}

.type-scroll {
  width: 100%;
  margin-bottom: var(--space-3);
}

.type-track {
  display: inline-flex;
  padding-bottom: 2rpx;
}

.type-card {
  flex-shrink: 0;
  min-width: 148rpx;
  margin-right: 12rpx;
  padding: 18rpx 22rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
  box-sizing: border-box;
}

.type-press { opacity: 0.85; }

.type-card.on {
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass);
}

.type-name {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  color: #F3ECDD;
}

.type-card.on .type-name { color: var(--brass-200); }

.type-meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-18);
  font-family: var(--font-mono);
  color: var(--color-text-secondary, #A09A90);
}

.type-card.on .type-meta { color: var(--brass-300); }

.filter-sheet { margin-bottom: var(--space-2); }

.field-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.field-row picker { flex: 1; min-width: 0; }

.picker-chip {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 18rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
}

.picker-k {
  font-family: var(--font-mono);
  font-size: var(--fs-16);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.picker-v {
  font-size: var(--fs-24);
  color: var(--color-text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notes-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  margin-bottom: 8rpx;
}

.notes-toggle-t {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.notes-chevron {
  font-size: var(--fs-22);
  color: var(--brass-600);
}

.notes-input {
  width: 100%;
  min-height: 120rpx;
  margin-bottom: var(--space-3);
  padding: var(--space-3);
  box-sizing: border-box;
  border-radius: 4rpx;
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  font-size: var(--fs-26);
  color: var(--color-text-body);
  line-height: 1.5;
}

.example-scroll {
  width: 100%;
  margin-bottom: var(--space-4);
}

.example-track {
  display: inline-flex;
}

.chip {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.32);
  font-size: var(--fs-22);
  color: var(--brass-200);
}

.chip-press { opacity: 0.8; }

.cta-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cta-row {
  display: flex;
  gap: 12rpx;
}

.cta-row .flex { flex: 1; min-width: 0; }

.btn-primary,
.btn-brass-outline,
.btn-ghost {
  margin: 0;
  line-height: 1.35;
  padding: 22rpx var(--space-3);
  font-size: var(--fs-26);
}

.btn-primary {
  background: var(--brass-400);
  color: var(--color-bg);
  border: none;
  border-radius: 4rpx;
  font-weight: 500;
  font-size: var(--fs-28);
}

.btn-brass-outline {
  background: transparent;
  color: var(--brass-400);
  border: 1rpx solid var(--brass-400);
  border-radius: 4rpx;
}

.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
  border-radius: 4rpx;
}

.btn-primary::after,
.btn-brass-outline::after,
.btn-ghost::after { border: none; }

.status-line { margin-top: var(--space-3); }

.status-bar {
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-bg-elevated);
  overflow: hidden;
}

.status-fill {
  height: 100%;
  background: var(--brass-400);
  transition: width var(--dur-base) var(--ease-standard);
}

.status-text {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.error-box {
  margin-top: var(--space-3);
  padding: var(--space-3);
  border-radius: 4rpx;
  border: 1px solid rgba(214, 64, 69, 0.3);
  background: rgba(214, 64, 69, 0.06);
  display: flex;
  gap: var(--space-3);
}

.error-text {
  flex: 1;
  font-size: var(--fs-24);
  color: #C97A7D;
  line-height: 1.45;
}

.error-retry {
  flex-shrink: 0;
  font-size: var(--fs-24);
  color: var(--brass-400);
}

/* —— result —— */
.group { margin-bottom: var(--space-5); }

.group-head.tight {
  margin-bottom: var(--space-3);
  padding-bottom: 14rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

.group-en {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.group-cn {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.empty-plate {
  padding: var(--space-5);
  border-radius: 4rpx;
  border: 1rpx dashed rgba(196, 167, 108, 0.24);
  background: transparent;
}

.empty-plate.soft { padding: var(--space-3) 0; border: none; }

.empty-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
}

.empty-desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.plate-card.skel {
  padding: var(--space-5);
  border-radius: 4rpx;
  border: 1rpx solid var(--brass-800);
  background: var(--color-bg-card);
}

/* 铜牌概念卡 */
/* 概念卡 = 浅纸标本签（原深色铜牌卡 + 左侧金条） */
.plate-card {
  position: relative;
  overflow: hidden;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.42);
  color: #2E2618;
}

.plate-card::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.plate-card::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border-radius: 50%;
  background: #B08D57;
}

.plate-rail {
  display: none;
}

.plate-body {
  position: relative;
  z-index: 1;
  padding: 44rpx 36rpx 32rpx;
}

.plate-en {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: #8B6F47;
}

.plate-name {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  font-weight: 600;
  line-height: 1.3;
  color: #2E2618;
  word-break: break-word;
}

.plate-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 16rpx;
  margin-top: var(--space-3);
}

.plate-price {
  font-family: var(--font-mono);
  font-size: var(--fs-34);
  font-weight: 600;
  color: #5A4527;
}

.plate-pos,
.plate-margin {
  font-size: var(--fs-22);
  color: #5A4E3A;
}

.plate-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: var(--space-3);
}

.ptag {
  font-size: var(--fs-20);
  padding: 4rpx 12rpx;
  border-radius: 2rpx;
  border: 1rpx solid rgba(139, 111, 71, 0.5);
  color: #6B5435;
}

.plate-sec {
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1rpx solid rgba(46, 38, 24, 0.14);
}

.plate-lab {
  display: block;
  margin-bottom: 10rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: #8B6F47;
}

.plate-bullet {
  margin-bottom: 8rpx;
  padding-left: 16rpx;
  border-left: 2rpx solid rgba(139, 111, 71, 0.45);
  font-size: var(--fs-26);
  line-height: 1.5;
  color: #2E2618;
}

.plate-copy {
  display: block;
  font-size: var(--fs-26);
  line-height: 1.6;
  color: #2E2618;
  word-break: break-word;
}

.plate-copy.dim {
  margin-top: 8rpx;
  color: #5A4E3A;
}

.plate-split {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1rpx solid rgba(46, 38, 24, 0.14);
}

.plate-col {
  flex: 1;
  min-width: 0;
}

.plate-mini {
  display: block;
  margin-bottom: 6rpx;
  font-size: var(--fs-22);
  line-height: 1.45;
  color: #2E2618;
}

.plate-mini.warn {
  color: #5A4E3A;
}

.plate-actions {
  margin-top: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 签内按钮随纸面：主按钮保持实心金，描边 / 幽灵换墨铜线 */
.plate-card .btn-brass-outline {
  color: #5A4527;
  border-color: #8B6F47;
}

.plate-card .btn-ghost {
  color: #5A4E3A;
  border-color: rgba(46, 38, 24, 0.28);
}

/* 变体对比 */
.variant-scroll {
  width: 100%;
  margin-bottom: var(--space-3);
}

.variant-track { display: inline-flex; }

.variant-chip {
  flex-shrink: 0;
  width: 200rpx;
  margin-right: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 4rpx;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
}

.variant-chip.on {
  box-shadow: var(--ring-brass);
  border-color: transparent;
  background: rgba(196, 167, 108, 0.08);
}

.variant-chip.pending { opacity: 0.55; }

.variant-idx {
  display: block;
  font-size: var(--fs-18);
  letter-spacing: 0.08em;
  color: var(--brass-600);
}

.variant-name {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-24);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* —— history drawer —— */
.history-drawer {
  margin-bottom: var(--space-6);
  padding-top: var(--space-3);
  border-top: 1px solid var(--color-border);
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: var(--space-2) 0 var(--space-3);
}

.filter-tabs {
  display: flex;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.filter-tab {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.filter-tab.on { color: var(--brass-400); }

.search-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.search-input {
  flex: 1;
  padding: 14rpx 20rpx;
  border-radius: 4rpx;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  font-size: var(--fs-24);
  color: var(--color-text-body);
}

.search-clear {
  font-size: var(--fs-22);
  color: var(--brass-400);
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--color-border);
}

.history-press { opacity: 0.85; }

.history-main { flex: 1; min-width: 0; }

.history-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.history-ops {
  display: flex;
  gap: var(--space-3);
  flex-shrink: 0;
}

.fav-btn { font-size: var(--fs-22); color: var(--brass-400); }
.del-btn { font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); }
