@import '../index.wxss';
@import '../../utils/workbench-nav.wxss';

/* 2026-10-18 视觉对齐（产品负责人点名「继续子页面重构」；与标本师工作台首页同口径，只改样式）：
   分区头随 ../index.wxss（眉标 + 宋体 + 渐隐金线）；卡片 / 头像行方角发丝；选项签选中为金线环（实心金留给底栏保存）；
   「对外展示 / 伴宠资质」关闭态的黄色是员工端提醒语义，保留。表单零件 workbench-* 由共享件管，不动。 */

.page {
  /* 双按钮底栏：padding + 88rpx 按钮 + safe-area */
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.profile-sticky-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  background: var(--color-bg);
}

.header .title {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.header .sub {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.visibility-card {
  margin-bottom: var(--space-5);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 4rpx;
}

.visibility-card.is-on {
  border-color: var(--brass-800);
}

.visibility-card.is-off {
  border-color: rgba(233, 162, 59, 0.45);
}

.visibility-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.visibility-copy {
  flex: 1;
  min-width: 0;
}

.visibility-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  color: #F3ECDD;
}

.visibility-status {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-300);
}

.visibility-card.is-off .visibility-status {
  color: var(--color-warning);
}

.visibility-desc {
  display: block;
  margin-top: var(--space-3);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.field-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2);
}

/* 需求 14：伴宠工单资质卡片。沿用「对外展示」卡片的语义色，但收在 group 内不额外占底距 */
.qualify-card {
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 4rpx;
}

.qualify-card.is-on {
  border-color: var(--brass-800);
}

.qualify-card.is-off {
  border-color: rgba(233, 162, 59, 0.45);
}

.qualify-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.qualify-copy {
  flex: 1;
  min-width: 0;
}

.qualify-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  color: #F3ECDD;
}

.qualify-status {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-300);
}

.qualify-card.is-off .qualify-status {
  color: var(--color-warning);
}

.qualify-desc {
  display: block;
  margin-top: var(--space-3);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.field-head .workbench-field-label {
  margin-bottom: var(--space-2);
}

.char-count {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.workbench-input.is-focus,
.workbench-textarea.is-focus {
  border-color: var(--brass-400);
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 24, 20, 0.55);
  border-radius: 4rpx;
}

.avatar-mask text {
  font-size: var(--fs-22);
  color: var(--brass-200);
}

.avatar-row.is-busy {
  opacity: 0.72;
}

.avatar-row.is-error {
  border-color: var(--color-warning);
}

.type-row {
  display: flex;
  gap: var(--space-2);
}

.type-chip {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.24);
}

/* 选中 = 金线环（原实心金，与底栏「保存」抢主次） */
.type-chip.is-on {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass);
}

.years-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.years-step {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-family: var(--font-mono);
  font-size: var(--fs-34);
  color: var(--brass-200);
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.4);
}

.years-input {
  flex: 1;
  text-align: center;
}

.workbench-picker-text.is-ph {
  color: var(--color-text-muted);
}

.cover-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-top: var(--space-3);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 4rpx;
}

.cover-row.is-busy {
  opacity: 0.72;
}

.cover-row.is-error {
  border-color: var(--color-warning);
}

.cover-wrap {
  position: relative;
  width: 240rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 4rpx;
  overflow: hidden;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--brass-800);
}

.cover-img,
.cover-empty {
  width: 100%;
  height: 100%;
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-empty text {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.gallery-block {
  margin-top: var(--space-4);
}

.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.gallery-cell,
.gallery-add {
  width: 210rpx;
  height: 210rpx;
  border-radius: 4rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.gallery-cell {
  position: relative;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
}

.gallery-img {
  width: 100%;
  height: 100%;
}

.gallery-del {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: var(--fs-20);
  color: var(--color-text-body);
  background: rgba(26, 24, 20, 0.72);
}

.gallery-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--brass-800);
  background: var(--color-bg-card);
}

.gallery-add.is-disabled {
  opacity: 0.5;
}

.gallery-plus {
  font-size: var(--fs-48);
  line-height: 1;
  color: var(--brass-400);
}

.gallery-add-hint {
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.tag-chip {
  padding: 8rpx 20rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: 2rpx;
}

.tag-chip.is-on {
  color: var(--brass-400);
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
}

.avatar-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  min-height: 200rpx;
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: 4rpx;
}

.avatar-row-press {
  border-color: var(--brass-400);
  background: var(--color-bg-elevated);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  border: 1rpx solid var(--brass-800);
  background: var(--color-bg-elevated);
}

.avatar-meta {
  flex: 1;
}

.avatar-label {
  font-size: var(--fs-28);
  color: var(--color-text-primary);
}

.avatar-hint {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.avatar-chevron {
  flex-shrink: 0;
  font-size: var(--fs-40);
  color: var(--brass-400);
}

