@import '../utils/ops-museum.wxss';

/* 出货单 · 逐行核对与算价（蓝图裁决 24）
   沿用 ops-museum 的暗色博物馆基调；此处只加本页结构类 */

.se-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 220rpx;
  box-sizing: border-box;
  background: var(--color-bg-base, #1a1814);
}

.se-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 8rpx 20rpx;
}

.se-title {
  font-size: var(--fs-40);
  font-weight: 600;
  color: var(--color-text-primary, #f2ece1);
}

.se-sub {
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #a09a90);
  line-height: 1.5;
}

.se-card {
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(77, 64, 26, 0.5);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.se-rate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.se-rate-label {
  font-size: var(--fs-28);
  color: var(--color-text-primary, #f2ece1);
}

.se-rate-input {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.se-input {
  background: rgba(0, 0, 0, 0.28);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  border-radius: var(--radius-sm);
  color: var(--color-text-primary, #f2ece1);
  font-size: var(--fs-28);
  padding: 8rpx 14rpx;
  text-align: center;
}

.se-input-rate {
  width: 120rpx;
}

.se-input-line-rate {
  width: 110rpx;
}

.se-rate-unit {
  font-size: var(--fs-26);
  color: var(--color-text-secondary, #a09a90);
}

.se-hint {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #a09a90);
}

.se-tip {
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.se-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}

.se-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}

.se-lines {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.se-line {
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(77, 64, 26, 0.5);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}

/* 未核价行整卡红边 —— 一眼看出是哪几行还没定 */
.se-line.is-unmatched {
  border-color: rgba(196, 92, 74, 0.66);
}

.se-line-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(77, 64, 26, 0.34);
}

.se-line-no {
  font-size: var(--fs-24);
  color: #c4a76c;
}

.se-line-name {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--color-text-primary, #f2ece1);
  word-break: break-all;
}

.se-del {
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(196, 92, 74, 0.46);
  border-radius: var(--radius-sm);
}

.se-del text {
  font-size: var(--fs-22);
  color: #e3a99e;
}

.se-field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
}

.se-field-label {
  width: 120rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #a09a90);
}

.se-field-pick {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: rgba(0, 0, 0, 0.26);
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: var(--radius-sm);
}

.se-pick-text {
  font-size: var(--fs-26);
  color: var(--color-text-primary, #f2ece1);
}

.se-pick-text.is-empty {
  color: #b8796c;
}

.se-pick-arrow {
  font-size: var(--fs-22);
  color: #c4a76c;
}

.se-field-cost {
  width: 150rpx;
  text-align: right;
  font-size: var(--fs-24);
  color: #c4a76c;
}

.se-labor-ctl {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.se-switch {
  transform: scale(0.72);
}

.se-labor-hint {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #a09a90);
}

.se-line-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(77, 64, 26, 0.34);
}

.se-qty {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.se-qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  border-radius: var(--radius-sm);
  color: #e8dcc0;
  font-size: var(--fs-30);
}

.se-qty-input {
  width: 96rpx;
  text-align: center;
  font-size: var(--fs-28);
  color: var(--color-text-primary, #f2ece1);
}

.se-line-total {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.se-line-total-label {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #a09a90);
}

.se-line-total-value {
  font-size: var(--fs-34);
  font-weight: 600;
  color: #e8dcc0;
}

.se-line-total-value.is-pending {
  font-size: var(--fs-26);
  color: #e3a99e;
}

.se-note {
  margin-top: 12rpx;
  font-size: var(--fs-22);
  color: #e3a99e;
  line-height: 1.5;
}

.se-note-ok {
  color: var(--color-text-secondary, #a09a90);
}

/* 底部常驻合计：滚动时也能看到总额 */
.se-summary {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 128rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 18rpx 28rpx;
  background: rgba(20, 18, 15, 0.96);
  border-top: 1rpx solid rgba(196, 167, 108, 0.34);
  z-index: 20;
}

.se-sum-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.se-sum-label {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #a09a90);
}

.se-sum-value {
  font-size: var(--fs-26);
  color: var(--color-text-primary, #f2ece1);
}

.se-sum-total .se-sum-value {
  font-size: var(--fs-34);
  font-weight: 600;
  color: #c4a76c;
}

.se-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx 28rpx;
  background: rgba(20, 18, 15, 0.98);
  z-index: 21;
}

.se-btn {
  flex: 1;
  font-size: var(--fs-26);
  border-radius: var(--radius-md);
  line-height: 2.6;
}

.se-btn-ghost {
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  color: #e8dcc0;
}

.se-btn-main {
  background: linear-gradient(135deg, #c4a76c, #a8874c);
  color: #221e17;
  border: none;
}

.se-btn-main.is-disabled {
  background: rgba(196, 167, 108, 0.42);
  color: #3a3428;
}

/* 选择器弹层 */

.se-sheet {
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.se-sheet-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx 12rpx;
}

.se-sheet-title {
  font-size: var(--fs-28);
  color: var(--color-text-primary, #f2ece1);
}

.se-sheet-close text {
  font-size: var(--fs-24);
  color: #c4a76c;
}

.se-search {
  flex-shrink: 0;
  padding: 0 28rpx 14rpx;
}

.se-search-input {
  background: rgba(0, 0, 0, 0.34);
  border: 1rpx solid rgba(196, 167, 108, 0.34);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  font-size: var(--fs-26);
  color: var(--color-text-primary, #f2ece1);
}

/* 高度由内联 sheetBodyPx 决定；flex: 1 + 无 min-height 会按内容撑开而滑不动 */
.se-sheet-body {
  flex: 0 1 auto;
  min-height: 0;
  padding: 0 20rpx 28rpx;
  box-sizing: border-box;
}

.se-loading,
.se-empty {
  padding: 48rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.se-loading text,
.se-empty text {
  font-size: var(--fs-26);
  color: var(--color-text-secondary, #a09a90);
}

.se-empty-hint {
  font-size: var(--fs-22);
  color: #7d786f;
}

.se-group {
  margin-bottom: 14rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(77, 64, 26, 0.44);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.se-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx;
}

.se-group-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.se-group-name {
  font-size: var(--fs-28);
  color: var(--color-text-primary, #f2ece1);
}

.se-group-meta {
  font-size: var(--fs-20);
  color: #7d786f;
}

.se-group-count {
  font-size: var(--fs-22);
  color: #c4a76c;
}

.se-group-hint {
  padding: 0 22rpx 18rpx;
}

.se-group-hint text {
  font-size: var(--fs-20);
  color: #7d786f;
}

.se-options {
  padding: 0 14rpx 14rpx;
}

.se-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  margin-top: 8rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.26);
  border-radius: var(--radius-sm);
}

.se-option-name {
  flex: 1;
  font-size: var(--fs-26);
  color: var(--color-text-primary, #f2ece1);
}

.se-option-price {
  font-size: var(--fs-24);
  color: #c4a76c;
}

.se-option-tag {
  font-size: var(--fs-20);
  color: #221e17;
  background: #c4a76c;
  border-radius: var(--radius-sm);
  padding: 2rpx 8rpx;
}
