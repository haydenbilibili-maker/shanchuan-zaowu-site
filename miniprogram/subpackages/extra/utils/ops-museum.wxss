/**
 * 出货单 / 库存 次页共用 Museum Mode 片段
 * 页头、汇总、筛选、列表卡、粘贴面板、数量徽章、空态骨架
 */
@import './workbench-nav.wxss';

page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-body, #D5D1C8);
}

.ops-page {
  min-height: 100vh;
}

.ops-container {
  padding: 0 var(--space-4, 32rpx) 140rpx;
  box-sizing: border-box;
}

/* ---------- 页头 ---------- */
.ops-header {
  padding: var(--space-5, 40rpx) 0 var(--space-3, 24rpx);
}

.ops-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600, #8A7530);
  text-transform: uppercase;
}

.ops-title {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand, Georgia, serif);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
  line-height: 1.25;
}

.ops-note {
  display: block;
  margin-top: var(--space-2, 16rpx);
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.55;
}

/* ---------- 汇总卡 ---------- */
.ops-summary {
  margin-bottom: var(--space-3, 24rpx);
  padding: 28rpx 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-lg, 24rpx);
}

.ops-summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ops-summary-label {
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
  line-height: 1.4;
}

.ops-summary-value {
  font-family: var(--font-mono, monospace);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--brass-400, #C4A76C);
  line-height: 1.1;
}

.ops-summary-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--brass-300, #D4BC85);
}

.ops-summary-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
}

.ops-summary-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--brass-700, #6B5A24);
  line-height: 1.4;
}

.ops-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ops-chip {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--brass-300, #D4BC85);
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
}

/* ---------- 搜索 / 筛选 ---------- */
.ops-search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ops-search-input {
  flex: 1;
  min-height: 72rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(77, 64, 26, 0.4);
  color: var(--color-text-primary);
  font-size: 26rpx;
}

.ops-ph {
  color: var(--color-text-muted, #6B6560);
}

.ops-search-clear {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  padding: 8rpx 4rpx;
}

.ops-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.ops-filter-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(77, 64, 26, 0.5);
  background: var(--color-bg-elevated, #262320);
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.ops-filter-chip.brass {
  color: var(--brass-400, #C4A76C);
  border-color: rgba(196, 167, 108, 0.45);
}

.ops-filter-chip.clear {
  color: var(--brass-400, #C4A76C);
}

.ops-btn-add {
  margin-left: auto;
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  font-size: 24rpx;
  font-weight: 500;
}

.ops-btn-add:active {
  background: var(--brass-500, #A8903C);
}

/* ---------- 列表卡 ---------- */
.ops-card {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-lg, 24rpx);
}

.ops-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ops-card-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.35;
}

.ops-card-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.ops-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: var(--color-text-secondary);
  background: rgba(38, 35, 32, 0.95);
  flex-shrink: 0;
}

.ops-status.brass {
  color: var(--gold);
  background: rgba(196, 167, 108, 0.15);
}

.ops-status.warn {
  color: #E9A23B;
  background: rgba(233, 162, 59, 0.15);
}

.ops-status.ok {
  color: #52B788;
  background: rgba(82, 183, 136, 0.15);
}

.ops-status.muted {
  color: var(--color-text-muted);
}

.ops-source {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  color: var(--color-text-secondary);
  background: rgba(38, 35, 32, 0.95);
}

.ops-source.feishu {
  color: #5B8FB9;
  background: rgba(91, 143, 185, 0.15);
}

.ops-source.erp {
  color: var(--gold);
  background: rgba(196, 167, 108, 0.12);
}

.ops-meta-inline {
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
}

.ops-amount {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-family: var(--font-mono, monospace);
  font-weight: 600;
  color: var(--brass-400, #C4A76C);
}

.ops-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.45;
}

.ops-card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

/* ---------- 数量徽章 ---------- */
.ops-qty-badge {
  min-width: 64rpx;
  padding: 8rpx 14rpx;
  box-sizing: border-box;
  text-align: center;
  border-radius: 10rpx;
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  font-family: var(--font-mono, monospace);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brass-400, #C4A76C);
  line-height: 1.2;
  flex-shrink: 0;
}

.ops-qty-badge.lg {
  min-width: 72rpx;
  padding: 10rpx 16rpx;
  font-size: 28rpx;
}

/* ---------- 分组折叠 ---------- */
.ops-group {
  margin-bottom: 16rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(77, 64, 26, 0.5);
  border-radius: var(--radius-lg, 24rpx);
  overflow: hidden;
}

.ops-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}

.ops-group-head:active {
  background: rgba(196, 167, 108, 0.04);
}

.ops-group-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.ops-group-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.ops-group-chevron {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  width: 32rpx;
  text-align: center;
}

.ops-group-body {
  border-top: 1rpx solid rgba(77, 64, 26, 0.35);
  padding: 4rpx 12rpx 12rpx;
}

.ops-line-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid rgba(38, 35, 32, 0.85);
}

.ops-line-row:last-child {
  border-bottom: none;
}

.ops-line-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.35;
}

.ops-line-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
}

/* ---------- 空态 / 骨架 ---------- */
.ops-skeleton {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ops-sk-card {
  padding: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(38, 35, 32, 0.66);
  border-radius: 16rpx;
}

.ops-sk-line {
  height: 24rpx;
  width: 42%;
  margin-top: 16rpx;
  border-radius: 8rpx;
  background: var(--color-bg-elevated, #262320);
  animation: ops-sk-pulse 1.2s ease-in-out infinite;
}

.ops-sk-line.wide {
  width: 72%;
  margin-top: 0;
  height: 32rpx;
}

.ops-sk-line.mid {
  width: 58%;
}

@keyframes ops-sk-pulse {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 0.85;
  }
}

.ops-empty {
  padding: 64rpx 28rpx;
  text-align: center;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx dashed rgba(77, 64, 26, 0.5);
  border-radius: var(--radius-lg, 24rpx);
}

.ops-empty-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary, #FFFFFF);
}

.ops-empty-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.5;
}

.ops-boot {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted, #6B6560);
  font-size: 26rpx;
}

/* ---------- Sheet 面板 ---------- */
.ops-mask {
  position: fixed;
  inset: 0;
  background: rgba(26, 24, 20, 0.78);
  z-index: 90;
}

.ops-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  background: var(--color-bg-card, #1F1D1A);
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid rgba(77, 64, 26, 0.55);
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ops-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
  flex-shrink: 0;
}

.ops-sheet-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.ops-sheet-close {
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
  padding: 8rpx;
}

.ops-sheet-body {
  flex: 1;
  max-height: 76vh;
  padding: 8rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.ops-paste-card {
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(77, 64, 26, 0.55);
  border-radius: 16rpx;
}

.ops-paste-hint {
  display: block;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.5;
}

.ops-paste-area {
  width: 100%;
  min-height: 240rpx;
  max-height: 360rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: var(--color-bg, #1A1814);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  color: var(--color-text-primary);
  font-size: 24rpx;
  line-height: 1.55;
}

.ops-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.ops-btn-secondary {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  color: var(--brass-400, #C4A76C);
  font-size: 26rpx;
  background: transparent;
}

.ops-btn-secondary:active {
  background: rgba(196, 167, 108, 0.08);
}

.ops-btn-primary {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid var(--brass-400, #C4A76C);
}

.ops-btn-primary:active {
  background: var(--brass-500, #A8903C);
}

.ops-btn-primary.disabled,
.ops-btn-secondary.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.ops-chip-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.ops-chip-btn.brass {
  background: rgba(196, 167, 108, 0.12);
}

.ops-chip-btn.danger {
  border-color: rgba(214, 64, 69, 0.4);
  color: #D64045;
}

/* ---------- 解析问题行 ---------- */
.ops-issue-block {
  margin-bottom: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(214, 64, 69, 0.08);
  border: 1rpx solid rgba(214, 64, 69, 0.35);
}

.ops-issue-block.warn {
  background: rgba(233, 162, 59, 0.08);
  border-color: rgba(233, 162, 59, 0.35);
}

.ops-issue-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.ops-issue-label {
  font-size: 22rpx;
  color: #D64045;
}

.ops-issue-block.warn .ops-issue-label {
  color: #E9A23B;
}

.ops-issue-apply {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.ops-issue-input {
  width: 100%;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: var(--color-bg, #1A1814);
  border: 1rpx solid rgba(214, 64, 69, 0.4);
  color: var(--color-text-primary);
  font-size: 24rpx;
}

.ops-issue-block.warn .ops-issue-input {
  border-color: rgba(233, 162, 59, 0.4);
}

.ops-issue-msg {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.4;
}

/* ---------- 预览 ---------- */
.ops-preview-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 0 16rpx;
}

.ops-preview-label {
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}

.ops-preview-input {
  flex: 1;
  min-width: 0;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: var(--color-bg, #1A1814);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  color: var(--color-text-body);
  font-size: 24rpx;
}

.ops-preview-qty-input {
  width: 100rpx;
  padding: 10rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(196, 167, 108, 0.12);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  color: var(--brass-400, #C4A76C);
  font-size: 24rpx;
  text-align: center;
  font-family: var(--font-mono, monospace);
}

.ops-writeback {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(82, 183, 136, 0.1);
  border: 1rpx solid rgba(82, 183, 136, 0.35);
}

.ops-writeback.err {
  background: rgba(214, 64, 69, 0.1);
  border-color: rgba(214, 64, 69, 0.35);
}

.ops-writeback-text {
  font-size: 24rpx;
  color: #52B788;
  line-height: 1.45;
}

.ops-writeback.err .ops-writeback-text {
  color: #D64045;
}

.ops-section-label {
  display: block;
  margin: 28rpx 0 14rpx;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--brass-600, #8A7530);
}

.ops-scope-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.ops-scope-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(77, 64, 26, 0.5);
  color: var(--color-text-secondary, #A09A90);
  font-size: 26rpx;
  background: var(--color-bg-card, #1F1D1A);
}

.ops-scope-tab.on {
  color: var(--color-bg, #1A1814);
  background: var(--brass-400, #C4A76C);
  border-color: var(--brass-400, #C4A76C);
  font-weight: 500;
}

.ops-scope-tab.disabled {
  opacity: 0.45;
  color: var(--color-text-muted, #6B6560);
}

.ops-snap-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(38, 35, 32, 0.9);
}

.ops-snap-row.active {
  background: rgba(196, 167, 108, 0.06);
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 12rpx;
}

.ops-snap-date {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.ops-snap-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.ops-snap-time {
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
  white-space: nowrap;
}
