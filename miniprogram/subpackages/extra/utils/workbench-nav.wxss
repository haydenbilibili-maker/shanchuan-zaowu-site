/* 自定义顶栏工作台：固定左上角回退，与 nav-spacer 对齐 */
.nav-spacer {
  width: 100%;
  flex-shrink: 0;
}

/* ---------- 页脚主 CTA ---------- */
.workbench-footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  padding: var(--space-4);
  padding-bottom: calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

/* 超管配置页：主保存 + 并排次要操作，避免内容被底栏遮挡 */
.workbench-page-foot-spacer {
  height: calc(280rpx + env(safe-area-inset-bottom));
}

.workbench-footer-secondary {
  display: flex;
  align-items: stretch;
  gap: var(--space-3);
  margin-top: var(--space-3);
}

.workbench-footer-secondary > .workbench-btn-outline,
.workbench-footer-secondary > .workbench-btn-ghost {
  flex: 1;
  min-width: 0;
}

.workbench-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
  min-height: 72rpx;
}

.workbench-section-head .section-title {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}

.workbench-section-head-action {
  flex-shrink: 0;
}

.workbench-btn-primary {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: var(--space-3) var(--space-5);
  background: var(--brass-400);
  color: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-align: center;
}

.workbench-btn-primary:active {
  background: var(--brass-500);
}

.workbench-btn-primary.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.workbench-btn-outline {
  flex: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: var(--space-3) var(--space-4);
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--brass-400);
  text-align: center;
}

.workbench-btn-outline:active {
  background: rgba(196, 167, 108, 0.08);
}

.workbench-btn-ghost {
  flex: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: var(--space-3) var(--space-4);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.workbench-btn-ghost:active {
  background: var(--color-bg-elevated);
}

.workbench-btn-outline.sm {
  flex: none;
  min-height: 64rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
}

.workbench-btn-danger {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: var(--space-3) var(--space-5);
  background: var(--color-error);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-error);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1.2;
  text-align: center;
}

.workbench-btn-danger:active {
  opacity: 0.92;
}

.workbench-btn-danger.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

/* ---------- 弹窗双按钮底栏（Museum Mode） ---------- */
.workbench-modal-foot {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  gap: var(--space-3);
  padding: var(--space-4);
  padding-bottom: calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  box-sizing: border-box;
}

.workbench-modal-foot > .workbench-btn-primary,
.workbench-modal-foot > .workbench-btn-outline,
.workbench-modal-foot > .workbench-btn-danger {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  height: auto;
  margin: 0;
  padding: var(--space-3) var(--space-4);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1.2;
  border-radius: var(--radius-md);
}

.workbench-modal-foot > .workbench-btn-outline {
  border-color: var(--brass-400);
  color: var(--brass-400);
  font-size: 28rpx;
}

/* ---------- 表单 ---------- */
.workbench-field {
  margin-bottom: var(--space-4);
}

.workbench-field-label {
  display: block;
  margin-bottom: var(--space-2);
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.workbench-input {
  min-height: 88rpx;
  padding: var(--space-3) var(--space-4);
  box-sizing: border-box;
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.workbench-textarea {
  width: 100%;
  min-height: 176rpx;
  padding: var(--space-3) var(--space-4);
  box-sizing: border-box;
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.workbench-textarea.tall {
  min-height: 260rpx;
}

.workbench-ph {
  color: var(--color-text-muted);
}

.workbench-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: var(--space-3) var(--space-4);
  box-sizing: border-box;
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
}

.workbench-picker-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.workbench-picker-chevron {
  margin-left: var(--space-2);
  font-size: 36rpx;
  line-height: 1;
  color: var(--brass-400);
}

/* ---------- 空态 / 加载 ---------- */
.workbench-state {
  padding: var(--space-6) var(--space-4);
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  border: 1rpx dashed var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
}

.workbench-state.loading {
  border-style: solid;
  color: var(--color-text-muted);
}

/* 通用按压态（hover-class="wb-press"）：真机 :active 不稳，可点的按钮 / 标签 / 卡片统一用它 */
.wb-press {
  opacity: 0.72;
}
