/* 会员等级调整 — Museum Mode（对齐 CRM / 荣誉馆长：搜索优先、可操作流程） */
page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.container {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  padding: var(--space-5) 0 var(--space-2);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.brand-group .cn {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.hint-card {
  margin-bottom: var(--space-4);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
}

.hint-card.info {
  background: rgba(91, 143, 185, 0.1);
  border: 1rpx solid rgba(91, 143, 185, 0.28);
}

.hint-text {
  font-size: var(--fs-22);
  color: var(--color-info);
  line-height: 1.5;
}

.section {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.section.compact {
  padding-bottom: var(--space-3);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

.section-title {
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--color-text-primary);
}

.section-meta,
.section-action {
  font-size: var(--fs-22);
  color: var(--brass-400);
}

.search-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: var(--fs-26);
}

.search-btn {
  flex-shrink: 0;
  min-width: 112rpx;
}

.field-placeholder {
  color: var(--color-text-muted);
}

.empty-find {
  text-align: center;
  padding: var(--space-5) var(--space-3);
}

.empty-find.soft {
  background: transparent;
  border-style: dashed;
}

.empty-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.empty-desc {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.member-card {
  padding: var(--space-3) 0;
  border-top: 1rpx solid rgba(38, 35, 32, 0.6);
}

.member-card:first-of-type {
  border-top: none;
  padding-top: 0;
}

.member-top {
  display: flex;
  gap: var(--space-3);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-bg-elevated);
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--brass-800);
}

.avatar.placeholder text {
  color: var(--brass-400);
  font-size: var(--fs-28);
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.member-name {
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  font-weight: 500;
}

.tag {
  font-size: var(--fs-20);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  background: rgba(160, 154, 144, 0.15);
  color: var(--color-text-secondary);
}

.tag.honor {
  background: rgba(233, 162, 59, 0.15);
  color: var(--color-warning);
}

.tag.exact {
  background: rgba(214, 64, 69, 0.15);
  color: var(--color-error-on-tint);
}

.tag.floor {
  background: rgba(82, 183, 136, 0.15);
  color: var(--color-success);
}

.mono {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.level-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.level-pill,
.discount-pill {
  font-size: var(--fs-22);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.12);
  color: var(--brass-400);
}

.discount-pill {
  background: rgba(45, 90, 63, 0.2);
  color: var(--color-success);
}

.member-natural {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.member-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.member-actions .act {
  min-width: 160rpx;
}

/* 横向档位速览 */
.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: var(--space-2);
  padding-bottom: 4rpx;
}

.level-chip {
  display: inline-flex;
  flex-direction: column;
  min-width: 180rpx;
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.chip-lv {
  font-size: var(--fs-20);
  letter-spacing: 0.06em;
  color: var(--brass-400);
}

.chip-name {
  margin-top: 4rpx;
  font-size: var(--fs-24);
  color: var(--color-text-primary);
  white-space: nowrap;
}

.chip-meta {
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  font-family: var(--font-mono);
  white-space: nowrap;
}

.tip {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.ops-row {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-top: 1rpx solid rgba(38, 35, 32, 0.6);
}

.ops-row:first-of-type {
  border-top: none;
  padding-top: 0;
}

.ops-action {
  display: block;
  font-size: var(--fs-24);
  color: var(--brass-400);
}

.ops-action.add {
  color: var(--color-success);
}

.ops-action.remove {
  color: var(--color-info);
}

.ops-change,
.ops-who,
.ops-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.ops-right {
  text-align: right;
  flex-shrink: 0;
}

.empty,
.loading-hint {
  padding: var(--space-4) 0;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.btn-primary,
.btn-danger,
.btn-outline {
  min-height: 64rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  box-sizing: border-box;
}

.btn-primary {
  background: var(--brass-400);
  color: var(--color-bg);
}

.btn-primary.disabled,
.btn-danger.disabled {
  opacity: 0.5;
}

.btn-danger {
  background: transparent;
  border: 1rpx solid var(--color-error);
  color: var(--color-error);
}

.btn-outline {
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  color: var(--brass-400);
}

/* modal */


.modal-sheet {
  position: relative;
  width: 100%;
  height: 86vh;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.modal-head {
  padding: var(--space-4) var(--space-4) var(--space-2);
}

.modal-title {
  display: block;
  font-size: var(--fs-32);
  font-weight: 500;
  color: var(--color-text-primary);
}

.modal-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.modal-sub.warn {
  color: var(--color-warning);
}

.modal-body {
  flex-shrink: 0;
  width: 100%;
  height: calc(86vh - 220rpx);
  max-height: calc(86vh - 220rpx);
  min-height: 160rpx;
  padding: 0 var(--space-4);
  box-sizing: border-box;
}

.field {
  margin-bottom: var(--space-4);
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.field-input {
  width: 100%;
  min-height: 72rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: var(--fs-26);
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: var(--space-3);
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: var(--fs-26);
  box-sizing: border-box;
}

.pick-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.pick-card {
  padding: var(--space-3);
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.pick-card.on {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
}

.pick-lv {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.06em;
  color: var(--brass-400);
}

.pick-name {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  font-weight: 500;
}

.pick-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  font-family: var(--font-mono);
}

.mode-row {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.mode-chip {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  color: var(--color-text-secondary);
  font-size: var(--fs-24);
}

.mode-chip.on {
  border-color: var(--brass-400);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
}

.modal-foot {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4) var(--space-4);
}

.modal-foot .btn-outline,
.modal-foot .btn-primary,
.modal-foot .btn-danger {
  flex: 1;
  min-height: 80rpx;
}
