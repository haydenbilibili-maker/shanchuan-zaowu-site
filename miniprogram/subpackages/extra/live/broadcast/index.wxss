@import '../../utils/workbench-nav.wxss';

.page-scroll {
  width: 100%;
  background: #1A1814;
  box-sizing: border-box;
}

.page-inner {
  box-sizing: border-box;
  padding: 0 0 48rpx;
  color: #D5D1C8;
  min-height: 100%;
}

.header {
  padding: 40rpx 32rpx 16rpx;
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: #8A7530;
  text-transform: uppercase;
}

.brand-group .cn {
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  font-size: 40rpx;
  color: #FFFFFF;
  margin-top: 6rpx;
}

.header-note {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #6B6560;
  line-height: 1.5;
}

.sim-banner {
  margin: 16rpx 32rpx 0;
  padding: 20rpx 24rpx;
  background: #262320;
  border: 1px solid #4D401A;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #E9A23B;
  line-height: 1.5;
}

.status-card {
  margin: 16rpx 32rpx 0;
  padding: 24rpx;
  background: #1F1D1A;
  border: 1px solid #262320;
  border-radius: 16rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  gap: 16rpx;
}

.status-label {
  font-size: 22rpx;
  color: #6B6560;
  flex-shrink: 0;
}

.status-val {
  font-size: 24rpx;
  color: #D5D1C8;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.status-val.ok { color: #52B788; }
.status-val.warn { color: #E9A23B; }
.status-val.live { color: #C4A76C; }

.status-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.5;
}

.stage {
  position: relative;
  margin: 16rpx 32rpx 0;
  height: 420rpx;
  background: #1F1D1A;
  border: 1px solid #4D401A;
  border-radius: 24rpx;
  overflow: hidden;
}

.stage.on-air {
  height: 520rpx;
}

.pusher,
.pusher-fallback {
  width: 100%;
  height: 100%;
}

.pusher-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 48rpx;
  text-align: center;
}

.fallback-title { color: #FFFFFF; font-size: 30rpx; }
.fallback-text { color: #A09A90; font-size: 24rpx; }

.stage-top {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  z-index: 2;
  pointer-events: none;
}

.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 16rpx;
  border: 1px solid #4D401A;
  border-radius: 8rpx;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: #A09A90;
  background: rgba(26, 24, 20, 0.72);
}

.live-badge.on { color: #C4A76C; }

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #6B6560;
}

.live-badge.on .dot {
  background: #D64045;
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.conn-pill {
  max-width: 55%;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: rgba(26, 24, 20, 0.72);
  color: #A09A90;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conn-pill.ok { color: #52B788; }
.conn-pill.warn { color: #E9A23B; }
.conn-pill.err { color: #D64045; }

.panel {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 28rpx 32rpx;
  background: #1F1D1A;
  border: 1px solid #262320;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.label {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  margin-bottom: 10rpx;
}

.input {
  background: #262320;
  border: 1px solid #4D401A;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.ph { color: #6B6560; }

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 24rpx;
}

.toggle-row.compact { padding: 8rpx 0 20rpx; }

.toggle-label { font-size: 26rpx; color: #D5D1C8; }
.toggle-val { font-size: 26rpx; color: #C4A76C; }

.overlay-title {
  display: block;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.overlay-notice {
  display: block;
  color: #A09A90;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.actions-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.actions-row.wrap {
  flex-wrap: wrap;
}

.actions-row .flex-grow {
  flex: 1.4;
  width: auto;
  min-width: 0;
}

.panel-pad {
  margin: 16rpx 32rpx 0;
}

.workbench-state.error {
  border-color: rgba(214, 64, 69, 0.35);
}

.state-retry,
.state-cta {
  display: inline-flex;
  margin-top: 24rpx;
}

.state-cta {
  width: 100%;
}

.status-end-btn {
  display: flex;
  margin-top: 16rpx;
  border-color: rgba(214, 64, 69, 0.5);
  color: #D64045;
}

.end-outline {
  display: flex;
  margin-top: 20rpx;
  border-color: rgba(214, 64, 69, 0.5);
  color: #D64045;
}

.sync-notice {
  margin-bottom: 16rpx;
}

.ghost-light {
  flex: 1;
  text-align: center;
  padding: 22rpx 12rpx;
  border: 1px solid #C4A76C;
  color: #C4A76C;
  border-radius: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.cta-inline {
  flex: 1.5;
  text-align: center;
  padding: 22rpx 12rpx;
  background: #C4A76C;
  color: #1A1814;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.cta-inline.disabled { opacity: 0.45; }

.danger {
  flex: 1.3;
  text-align: center;
  padding: 22rpx 12rpx;
  background: #D64045;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.ghost {
  margin-top: 20rpx;
  text-align: center;
  padding: 20rpx;
  border: 1px solid #D64045;
  color: #D64045;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.ghost.compact {
  margin-top: 16rpx;
  padding: 16rpx;
  font-size: 22rpx;
}

.ghost-light.full {
  display: block;
  margin-bottom: 16rpx;
  flex: none;
}

.bitrate-bar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  z-index: 2;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(26, 24, 20, 0.72);
  border: 1px solid #4D401A;
  font-size: 20rpx;
  color: #C4A76C;
  letter-spacing: 0.02em;
  pointer-events: none;
}

.cover-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.cover-thumb,
.cover-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  border: 1px solid #4D401A;
  background: #262320;
  flex-shrink: 0;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #6B6560;
}

.cover-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
}

.schedule-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
  align-items: center;
}

.picker-chip {
  min-width: 160rpx;
  padding: 14rpx 20rpx;
  background: #262320;
  border: 1px solid #4D401A;
  border-radius: 12rpx;
  color: #D5D1C8;
  font-size: 24rpx;
  text-align: center;
}

.schedule-hint {
  display: block;
  font-size: 22rpx;
  color: #8B6F47;
  margin-bottom: 16rpx;
}

.ghost-light.mini {
  flex: none;
  padding: 12rpx 20rpx;
  font-size: 22rpx;
}

.actions-row.wrap {
  flex-wrap: wrap;
}

.overlay-stats {
  display: block;
  color: #C4A76C;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.host-msg {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1px solid #262320;
}

.host-msg-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.host-msg-author {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #C4A76C;
}

.host-msg-text {
  flex: 1;
  font-size: 22rpx;
  color: #D5D1C8;
  word-break: break-all;
}

.bottom-spacer {
  height: 48rpx;
}

.shelf-host-list { margin-bottom: 16rpx; }
.shelf-host-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1px solid #262320;
}
.shelf-host-row.spot { border-color: #4D401A; }
.shelf-host-cover {
  width: 88rpx; height: 88rpx;
  border-radius: 10rpx;
  background: #262320;
  flex-shrink: 0;
}
.shelf-host-info { flex: 1; min-width: 0; }
.shelf-host-name {
  display: block;
  font-size: 24rpx; color: #FFFFFF;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.shelf-host-price { font-size: 22rpx; color: #C4A76C; }
.shelf-host-warn { display: block; margin-top: 4rpx; font-size: 20rpx; color: #E9A23B; }
.shelf-host-cover.ph {
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #6B6560;
}
.shelf-host-actions { display: flex; flex-direction: column; gap: 8rpx; }
.shelf-toolbar { display: flex; flex-direction: column; gap: 12rpx; }
.ghost-light.full.danger { border-color: rgba(214, 64, 69, 0.5); color: #D64045; }

.picker-mask {
  position: fixed; inset: 0;
  background: rgba(26, 24, 20, 0.55);
  z-index: 50;
}
.picker-sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  z-index: 51;
  max-height: 70vh;
  background: #1F1D1A;
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid #4D401A;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.picker-hd {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16rpx;
}
.picker-title { font-size: 30rpx; color: #FFFFFF; font-weight: 500; }
.picker-close { font-size: 26rpx; color: #C4A76C; }
.picker-search {
  display: flex; gap: 12rpx; align-items: center; margin-bottom: 12rpx;
}
.picker-input {
  flex: 1;
  background: #262320;
  border: 1px solid #4D401A;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}
.picker-list { height: 52vh; max-height: 52vh; min-height: 160rpx; width: 100%; box-sizing: border-box; }
.picker-row {
  display: flex; gap: 16rpx; align-items: center;
  padding: 14rpx 0;
  border-bottom: 1px solid #262320;
}
.picker-cover {
  width: 80rpx; height: 80rpx; border-radius: 10rpx; background: #262320; flex-shrink: 0;
}
.picker-info { flex: 1; min-width: 0; }
.picker-name {
  display: block; font-size: 24rpx; color: #FFFFFF;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.picker-meta { font-size: 20rpx; color: #A09A90; }
.picker-empty { padding: 40rpx 0; text-align: center; color: #6B6560; font-size: 24rpx; }
.ghost-light.mini.disabled { opacity: 0.4; pointer-events: none; }

.spotlight-switch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.shelf-host-row.sold { opacity: 0.55; }
.shelf-host-row.spot {
  background: rgba(77, 64, 26, 0.28);
  border-radius: 12rpx;
  padding: 10rpx 8rpx;
}
