@import '../../utils/workbench-nav.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) 0;
  box-sizing: border-box;
}

.page-footer-spacer {
  height: calc(240rpx + env(safe-area-inset-bottom));
}

.header {
  padding: var(--space-5) 0 var(--space-4);
}

.brand-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
}

.brand-group .cn {
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
}

.header-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-3);
}

.greeting {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.preview-chip,
.mode-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.preview-chip {
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}

.preview-chip text {
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: var(--brass-600);
}

.mode-chip {
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.mode-chip text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.on-air-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(214, 64, 69, 0.45);
  border-radius: var(--radius-sm);
}

.on-air-text {
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--color-error);
}

.header-note {
  display: block;
  margin-top: var(--space-3);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.header-voice {
  margin-top: var(--space-3);
}

.header-legend {
  margin-top: var(--space-3);
}

.flow-strip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: var(--space-4);
  padding: 14rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.2);
}

.flow-step-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 6rpx;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
}

.flow-step-btn.hot {
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.12);
}

.flow-step-btn.on-air {
  border-color: rgba(214, 64, 69, 0.4);
  background: rgba(214, 64, 69, 0.1);
}

.flow-press {
  opacity: 0.85;
}

.flow-num {
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: var(--brass-400);
}

.flow-label {
  font-size: 22rpx;
  color: var(--color-text-primary);
}

.flow-sep {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--brass-600);
  opacity: 0.7;
}

.next-card {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
}

.next-card-head {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.next-en {
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600);
}

.next-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.next-body {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.next-cta {
  display: inline-flex;
  margin-top: var(--space-3);
}

.group {
  margin-bottom: var(--space-4);
}

.group-head {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.group-en {
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600);
}

.group-cn {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.warn-banner {
  margin-bottom: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: rgba(233, 162, 59, 0.08);
  border: 1rpx solid rgba(233, 162, 59, 0.35);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: var(--color-warning);
  line-height: 1.45;
}

.workbench-state.error {
  border-color: rgba(214, 64, 69, 0.35);
  color: var(--color-text-body);
}

.workbench-state.dashed {
  border-style: dashed;
  margin-bottom: 0;
}

.state-retry {
  display: inline-flex;
  margin-top: var(--space-4);
}

.status-card {
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx 28rpx 36rpx;
  margin-bottom: 0;
  position: relative;
  overflow: hidden;
}

.status-card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: var(--brass-800);
}

.status-card.is-live {
  border-color: rgba(214, 64, 69, 0.32);
}

.status-card.is-live .status-card-accent {
  background: var(--color-error);
}

.status-card.is-warn {
  border-color: rgba(233, 162, 59, 0.35);
}

.status-card.is-warn .status-card-accent {
  background: var(--color-warning);
}

.status-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.status-card-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.status-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.status-card-empty {
  display: block;
  margin-bottom: var(--space-3);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.status-card-sub {
  display: block;
  margin-top: var(--space-2);
  font-size: 24rpx;
  color: var(--brass-400);
}

.light-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.light-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.warn-banner-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.warn-banner-head text {
  flex: 1;
  min-width: 0;
}

.light-item .signal-light.on {
  background: var(--color-success, #52B788);
  box-shadow: 0 0 8rpx rgba(82, 183, 136, 0.45);
}

.metric-row {
  display: flex;
  gap: var(--space-2);
}

.metric-row.compact {
  margin-top: var(--space-2);
}

.metric {
  flex: 1;
  min-width: 0;
  padding: var(--space-2) var(--space-2);
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.metric.mini {
  flex: 1;
}

.metric-val {
  display: block;
  font-family: var(--font-mono);
  font-size: 30rpx;
  color: var(--brass-400);
}

.metric-val.metric-sm {
  font-size: 22rpx;
  line-height: 1.35;
}

.metric-lbl {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 500;
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
}

.status-chip.chip-live {
  border-color: rgba(214, 64, 69, 0.45);
  color: var(--color-error);
}

.status-chip.chip-idle {
  border-color: var(--brass-800);
  color: var(--brass-400);
}

.status-chip.chip-ended {
  color: var(--color-text-secondary, #A09A90);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
}

.section-head.tight {
  margin-bottom: var(--space-2);
}

.section-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.module-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: 0;
}

.module-card {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.module-card.primary-card {
  border-color: rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.06);
}

.module-card.muted-card {
  opacity: 0.92;
}

.module-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.module-card-body {
  flex: 1;
  min-width: 0;
}

.module-chevron {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
  color: var(--brass-400);
  opacity: 0.85;
}

.module-card-press {
  border-color: var(--brass-800);
  background: var(--color-bg-elevated);
}

.module-overline {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--color-text-secondary, #A09A90);
}

.module-title {
  display: block;
  margin-top: var(--space-1);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.module-desc {
  display: block;
  margin-top: var(--space-1);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.shelf-card,
.talk-card,
.notice-card {
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-4);
}

.talk-card.is-focus {
  border-color: var(--brass-400);
}

.shelf-preview {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.shelf-head-actions {
  display: flex;
  gap: var(--space-2);
}

.shelf-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
}

.shelf-row.is-spot {
  border-color: var(--brass-800);
}

.shelf-row-main {
  flex: 1;
  min-width: 0;
}

.shelf-chip-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.shelf-chip-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--brass-400);
}

.shelf-chip-warn {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-warning);
}

.shelf-row-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.ghost-mini {
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  color: var(--brass-400);
  text-align: center;
}

.ghost-mini.danger {
  border-color: rgba(214, 64, 69, 0.45);
  color: var(--color-error);
}

.ghost-mini.is-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.warn-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.warn-action {
  display: inline-flex;
  margin-top: var(--space-2);
}

.warn-action.danger {
  border-color: rgba(214, 64, 69, 0.45);
  color: var(--color-error);
}

.copy-hint {
  display: block;
  margin-bottom: var(--space-2);
  font-size: 22rpx;
  color: var(--color-success);
}

.talk-segs {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.talk-seg {
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.talk-seg.is-spot {
  border-color: var(--brass-800);
}

.talk-seg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
}

.talk-seg-title {
  font-size: 24rpx;
  color: var(--brass-400);
}

.talk-seg-body {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.5;
  white-space: pre-wrap;
}

.session-summary {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--brass-400);
}

.notice-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
}

.notice-input {
  width: 100%;
}

.notice-save {
  margin-top: var(--space-3);
}

.session-list {
  margin-bottom: var(--space-2);
}

.session-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-2);
}

.session-row-press {
  border-color: var(--brass-800);
  background: var(--color-bg-elevated);
}

.session-main {
  flex: 1;
  min-width: 0;
}

.session-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.session-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.session-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

.foot-note {
  margin: var(--space-2) 0 var(--space-4);
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.footer-secondary {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-3);
}

.footer-end {
  border-color: rgba(214, 64, 69, 0.5);
  color: var(--color-error);
}

.workbench-btn-outline.is-disabled,
.workbench-btn-primary.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.page-boot {
  padding: var(--space-6) 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.page-boot .boot-en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
}

.page-boot .boot-cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.page-boot .boot-hint {
  margin-top: var(--space-4);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
