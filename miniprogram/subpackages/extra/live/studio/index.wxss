@import '../../utils/workbench-nav.wxss';

/* 主播工作台（2026-10-18 视觉对齐，产品负责人点名；只改本页样式，workbench-nav 共享件不动）
   眉标 + 宋体分区题；三步流程 = 等宽编号 + 下划线；「下一步」= 浅纸指引签；主播职责 / 挂品 / 历史场次 = 发丝线行；
   看板仍是一块（数据密集），方角 + 发丝框，指标改发丝分隔。员工端语义色保留：红 = 在播 / 结束，黄 = 未配置警示。 */

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.page {
  min-height: 100vh;
  padding: 0 var(--space-4) 0;
  box-sizing: border-box;
}

.page-footer-spacer {
  height: calc(240rpx + env(safe-area-inset-bottom));
}

.header {
  padding: var(--space-5) 0 var(--space-4);
}

.brand-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-group .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.brand-group .cn {
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.header-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-3);
}

.greeting {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.preview-chip,
.mode-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 2rpx;
}

.preview-chip {
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}

.preview-chip text {
  font-size: var(--fs-20);
  letter-spacing: 0.06em;
  color: var(--brass-600);
}

.mode-chip {
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.mode-chip text {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.on-air-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(214, 64, 69, 0.45);
  border-radius: 2rpx;
}

.on-air-text {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--color-error);
}

.header-note {
  display: block;
  margin-top: var(--space-3);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.header-voice {
  margin-top: var(--space-3);
}

.header-legend {
  margin-top: var(--space-3);
}

/* 三步流程：等宽编号 + 下划线（原金底圆角条），在播步骤下划线转红 */
.flow-strip {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  margin-bottom: var(--space-5);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.flow-step-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 6rpx 16rpx;
  border-bottom: 3rpx solid transparent;
  margin-bottom: -1rpx;
}

.flow-step-btn.hot {
  border-bottom-color: var(--brass-400);
}

.flow-step-btn.on-air {
  border-bottom-color: var(--color-error);
}

.flow-press {
  opacity: 0.85;
}

.flow-num {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.1em;
  color: var(--brass-300);
}

.flow-label {
  font-size: var(--fs-26);
  color: var(--color-text-secondary, #A09A90);
}

.flow-step-btn.hot .flow-label,
.flow-step-btn.on-air .flow-label { color: #F3ECDD; font-family: var(--font-brand); font-weight: 600; }

.flow-sep {
  flex-shrink: 0;
  align-self: center;
  font-size: var(--fs-26);
  color: rgba(196, 167, 108, 0.45);
}

/* 「下一步」= 浅纸指引签（铜钉 + 内发丝框 + 墨色），全页最该先看的一句 */
.next-card {
  position: relative;
  margin-bottom: var(--space-5);
  padding: 40rpx 32rpx 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.42);
}

.next-card::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.next-card::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border-radius: 50%;
  background: #B08D57;
}

.next-card-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: var(--space-2);
}

.next-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: #8B6F47;
}

.next-title {
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #2E2618;
}

.next-body {
  display: block;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: #5A4E3A;
}

.next-cta {
  position: relative;
  z-index: 1;
  display: inline-flex;
  margin-top: var(--space-3);
  border-color: #8B6F47;
  border-radius: 4rpx;
  background: transparent;
  color: #5A4527;
}

.group {
  margin-bottom: var(--space-5);
}

/* 分区头 = 等宽眉标 + 宋体主标 + 渐隐金线（与全站 mu-head 同口径） */
.group-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: var(--space-3);
  padding-bottom: 16rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

.group-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.group-cn {
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.warn-banner {
  margin-bottom: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: rgba(233, 162, 59, 0.08);
  border: 1rpx solid rgba(233, 162, 59, 0.35);
  border-radius: 4rpx;
  font-size: var(--fs-24);
  color: var(--color-warning);
  line-height: 1.45;
}

.workbench-state.error {
  border-color: rgba(214, 64, 69, 0.35);
  color: var(--color-text-body);
}

.workbench-state.dashed {
  border-style: dashed;
  margin-bottom: 0;
}

.state-retry {
  display: inline-flex;
  margin-top: var(--space-4);
}

.status-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 0;
  padding: 28rpx 32rpx 28rpx 36rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
  border: 1rpx solid rgba(196, 167, 108, 0.24);
}

.status-card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: var(--brass-800);
}

.status-card.is-live {
  border-color: rgba(214, 64, 69, 0.32);
}

.status-card.is-live .status-card-accent {
  background: var(--color-error);
}

.status-card.is-warn {
  border-color: rgba(233, 162, 59, 0.35);
}

.status-card.is-warn .status-card-accent {
  background: var(--color-warning);
}

.status-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.status-card-label {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.status-card-title {
  display: block;
  margin-bottom: var(--space-2);
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  color: #F3ECDD;
}

.status-card-empty {
  display: block;
  margin-bottom: var(--space-3);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.status-card-sub {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-24);
  color: var(--brass-400);
}

.light-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
}

.light-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.warn-banner-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.warn-banner-head text {
  flex: 1;
  min-width: 0;
}

.light-item .signal-light.on {
  background: var(--color-success, #52B788);
  box-shadow: 0 0 8rpx rgba(82, 183, 136, 0.45);
}

/* 指标：发丝分隔四格（原四块圆角灰底） */
.metric-row {
  display: flex;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.metric-row.compact {
  margin-top: 0;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 18rpx 0 14rpx 16rpx;
  border-left: 1rpx solid rgba(196, 167, 108, 0.14);
  box-sizing: border-box;
}

.metric:first-child { padding-left: 0; border-left: none; }

.metric.mini {
  flex: 1;
}

.metric-val {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-32);
  color: var(--brass-200);
}

.metric-val.metric-sm {
  font-size: var(--fs-22);
  line-height: 1.35;
}

.metric-lbl {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 2rpx;
  font-size: var(--fs-22);
  border: 1rpx solid rgba(160, 154, 144, 0.3);
  color: var(--color-text-secondary);
  background: transparent;
}

.status-chip.chip-live {
  border-color: rgba(214, 64, 69, 0.45);
  color: var(--color-error);
}

.status-chip.chip-idle {
  border-color: rgba(196, 167, 108, 0.45);
  color: var(--brass-200);
}

.status-chip.chip-ended {
  color: var(--color-text-secondary, #A09A90);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
}

.section-head.tight {
  margin-bottom: var(--space-2);
}

.section-title {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
}

/* 主播职责：发丝线行（原六张大圆角卡），开播控制台一行淡金底 */
.module-list {
  display: flex;
  flex-direction: column;
  margin-bottom: 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.module-card {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.module-card.primary-card {
  background: rgba(196, 167, 108, 0.07);
}

.module-card.muted-card {
  opacity: 0.88;
}

.module-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  opacity: 0.9;
}

.module-card-body {
  flex: 1;
  min-width: 0;
}

.module-chevron {
  flex-shrink: 0;
  font-size: var(--fs-36);
  line-height: 1;
  color: var(--brass-300);
}

.module-card-press {
  background: rgba(196, 167, 108, 0.1);
}

.module-overline {
  font-family: var(--font-mono);
  font-size: var(--fs-16);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.module-title {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.module-desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  line-height: 1.45;
  color: var(--color-text-secondary);
}

.shelf-card,
.talk-card,
.notice-card {
  margin-bottom: var(--space-5);
  padding: var(--space-4);
  border-radius: 4rpx;
  background: #1F1D1A;
  border: 1rpx solid rgba(196, 167, 108, 0.2);
}

.talk-card.is-focus {
  border-color: var(--brass-400);
}

.shelf-preview {
  display: flex;
  flex-direction: column;
}

.shelf-head-actions {
  display: flex;
  gap: var(--space-2);
}

.shelf-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.shelf-row.is-spot {
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.1), transparent 70%);
  box-shadow: inset 3rpx 0 0 var(--brass-400);
  padding-left: 16rpx;
}

.shelf-row-main {
  flex: 1;
  min-width: 0;
}

.shelf-chip-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  color: #F3ECDD;
}

.shelf-chip-meta {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--brass-200);
}

.shelf-chip-warn {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-warning);
}

.shelf-row-actions {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  flex-shrink: 0;
  align-self: center;
}

.ghost-mini {
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 2rpx;
  font-size: var(--fs-20);
  text-align: center;
  color: var(--brass-200);
}

.ghost-mini.danger {
  border-color: rgba(214, 64, 69, 0.45);
  color: var(--color-error);
}

.ghost-mini.is-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.warn-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.warn-action {
  display: inline-flex;
  margin-top: var(--space-2);
}

.warn-action.danger {
  border-color: rgba(214, 64, 69, 0.45);
  color: var(--color-error);
}

.copy-hint {
  display: block;
  margin-bottom: var(--space-2);
  font-size: var(--fs-22);
  color: var(--color-success);
}

.talk-segs {
  display: flex;
  flex-direction: column;
}

.talk-seg {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.talk-seg.is-spot {
  border-bottom-color: rgba(196, 167, 108, 0.4);
}

.talk-seg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
}

.talk-seg-title {
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  color: var(--brass-200);
}

.talk-seg-body {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-26);
  color: var(--color-text-body);
  line-height: 1.5;
  white-space: pre-wrap;
}

.session-summary {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--brass-400);
}

.notice-label {
  display: block;
  margin-bottom: var(--space-2);
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.notice-input {
  width: 100%;
}

.notice-save {
  margin-top: var(--space-3);
}

.session-list {
  margin-bottom: var(--space-2);
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.session-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-3);
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.session-row-press {
  background: rgba(196, 167, 108, 0.06);
}

.session-main {
  flex: 1;
  min-width: 0;
}

.session-title {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.session-meta {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.session-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

.foot-note {
  margin: var(--space-2) 0 var(--space-4);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.footer-secondary {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-3);
}

.footer-end {
  border-color: rgba(214, 64, 69, 0.5);
  color: var(--color-error);
}

.workbench-btn-outline.is-disabled,
.workbench-btn-primary.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.page-boot {
  padding: var(--space-6) 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.page-boot .boot-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.page-boot .boot-cn {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.page-boot .boot-hint {
  margin-top: var(--space-4);
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 4rpx;
  font-size: var(--fs-24);
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
