/* 投资观测台（2026-10-18 视觉对齐，产品负责人「继续逐个工作台优化」；与股东观测台同口径，只改样式）
   眉标等宽 + 宋体主标；区间页签选中由实心金改金线环（筛选不该是一屏最亮的东西）；卡片 / 指标格方角；数值暖白。
   信号灯与股权结构条、状态圆点保持圆；.mini-cell 的 calc 宽度在 check:rpx-zero-slack 白名单里，不动。 */
page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-body, #D5D1C8);
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  width: 100%;
  max-width: 100%;
  padding: 0 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
}

/* —— Boot / 骨架 —— */
.page-boot {
  padding: 120rpx 0 0;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.boot-mark {
  width: 48rpx;
  height: 4rpx;
  margin-bottom: 20rpx;
  background: var(--brass-400, #C4A76C);
  border-radius: 9999px;
}

.boot-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.boot-cn {
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.boot-hint {
  margin-top: 20rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.boot-skel {
  margin-top: 48rpx;
}

.reveal {
  opacity: 0;
  transition: opacity var(--dur-slow) var(--ease-standard);
}

.entered .reveal { opacity: 1; }
.entered .r1 { transition-delay: 0.02s; }
.entered .r2 { transition-delay: 0.05s; }
.entered .r3 { transition-delay: 0.08s; }
.entered .r4 { transition-delay: 0.11s; }
.entered .r5 { transition-delay: 0.14s; }
.entered .r6 { transition-delay: 0.17s; }
.entered .r7 { transition-delay: 0.2s; }
.entered .r8 { transition-delay: 0.23s; }
.entered .r9 { transition-delay: 0.26s; }

/* —— Header —— */
.header {
  padding: 36rpx 0 16rpx;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.brand-group { width: 100%; min-width: 0; }

.brand-group .en {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
  padding-left: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brand-group .cn {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
  word-break: break-word;
}

.header-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
}

.greeting {
  flex: 1 1 auto;
  min-width: 0;
  font-size: var(--fs-26);
  font-weight: 500;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.readonly-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border: 1rpx solid var(--brass-800, #4D401A);
  border-radius: 2rpx;
  background: rgba(196, 167, 108, 0.06);
}

.readonly-text {
  font-size: var(--fs-20);
  letter-spacing: 0.04em;
  color: var(--brass-400, #C4A76C);
}

/* —— 周期 —— */
.range-bar {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.range-tab {
  flex: 1 1 0;
  min-width: 0;
  text-align: center;
  padding: 14rpx 4rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.24);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  box-sizing: border-box;
  transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
}

/* 区间选中：金线环（原实心金块） */
.range-tab.on {
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass);
  color: var(--brass-200);
  font-weight: 500;
}

.month-bar {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.month-chip {
  flex: 1 1 0;
  min-width: 0;
  text-align: center;
  padding: 12rpx 8rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  box-sizing: border-box;
}

.month-chip.on {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass);
}

.month-chip.pick {
  flex: 1.4 1 0;
}

/* —— 研判 —— */
.verdict-card {
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid var(--brass-800, #4D401A);
  border-radius: 4rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.verdict-card.pulse .verdict-title {
  animation: num-soft 0.42s ease;
}

.verdict-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.verdict-left {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  flex: 1 1 auto;
  min-width: 0;
}

.verdict-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1 1 auto;
}

.verdict-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.verdict-title {
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  color: #F3ECDD;
  line-height: 1.35;
  word-break: break-word;
}

.verdict-title.up { color: var(--color-success, #52B788); }
.verdict-title.warn { color: var(--color-warning, #E9A23B); }
.verdict-title.down { color: var(--color-error, #D64045); }
.verdict-title.flat { color: #F3ECDD; }

.verdict-badge {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 2rpx;
  font-size: var(--fs-22);
  font-family: var(--font-mono);
  border: 1px solid var(--color-border, #26232066);
  color: var(--color-text-secondary, #A09A90);
}

.verdict-badge.up {
  color: var(--color-success, #52B788);
  border-color: rgba(82, 183, 136, 0.35);
  background: rgba(82, 183, 136, 0.08);
}

.verdict-badge.warn {
  color: var(--color-warning, #E9A23B);
  border-color: rgba(233, 162, 59, 0.35);
  background: rgba(233, 162, 59, 0.08);
}

.verdict-badge.down {
  color: var(--color-error-on-tint);
  border-color: rgba(214, 64, 69, 0.35);
  background: rgba(214, 64, 69, 0.08);
}

.verdict-insight {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-24);
  line-height: 1.55;
  color: var(--color-text-body, #D5D1C8);
  word-break: break-word;
}

.summary-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.sum-chip {
  padding: 4rpx 12rpx;
  border-radius: 2rpx;
  font-size: var(--fs-20);
  font-family: var(--font-mono);
  border: 1px solid transparent;
}

.sum-chip.ok {
  color: var(--color-success, #52B788);
  background: rgba(82, 183, 136, 0.1);
  border-color: rgba(82, 183, 136, 0.28);
}

.sum-chip.warn {
  color: var(--color-warning, #E9A23B);
  background: rgba(233, 162, 59, 0.1);
  border-color: rgba(233, 162, 59, 0.28);
}

.sum-chip.danger {
  color: var(--color-error-on-tint);
  background: rgba(214, 64, 69, 0.1);
  border-color: rgba(214, 64, 69, 0.28);
}

.verdict-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.verdict-meta {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  font-family: var(--font-mono);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-toggle {
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
  flex-shrink: 0;
}

.legend-box {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1px solid var(--color-border, #26232066);
}

.legend-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.legend-text {
  font-size: var(--fs-22);
  color: var(--color-text-body, #D5D1C8);
}

.legend-hint {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
  word-break: break-word;
}

/* —— 信号灯板 —— */
.card {
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border, #26232066);
  border-radius: 4rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.card-top,
.sec-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
}

.card-title {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
  flex: 1 1 auto;
  min-width: 0;
}

.card-meta {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  font-family: var(--font-mono);
}

.card-meta.accent { color: var(--brass-400, #C4A76C); }

.sec-right {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  flex: 0 1 auto;
  max-width: 72%;
  min-width: 0;
}

.sec-chevron {
  font-size: var(--fs-20);
  color: var(--brass-400, #C4A76C);
  flex-shrink: 0;
}

.sec-head + .mini-grid,
.sec-head + .trend-bars,
.sec-head + .chart-empty,
.sec-head + .hint,
.sec-head + .subhead,
.card .mini-grid,
.card .trend-bars,
.card .hint,
.card .share-row,
.card .subhead {
  margin-top: 18rpx;
}

.signal-board { margin-bottom: 28rpx; }
.signal-board .card-top { margin-bottom: 16rpx; }

.signal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
}

.signal-item {
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 14rpx 16rpx 18rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(38, 35, 32, 0.95);
  box-sizing: border-box;
  overflow: hidden;
}

.signal-item-hover {
  background: rgba(196, 167, 108, 0.08);
  border-color: rgba(77, 64, 26, 0.75);
}

.signal-rail {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
}

.signal-rail--ok { background: var(--color-success, #52B788); }
.signal-rail--warn { background: var(--color-warning, #E9A23B); }
.signal-rail--danger { background: var(--color-error, #D64045); }
.signal-rail--muted { background: var(--color-text-muted, #6B6560); }

.signal-board .signal-item .signal-light {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-top: 6rpx;
}

.signal-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
}

.signal-name {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal-val {
  font-size: var(--fs-26);
  font-family: var(--font-mono);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal-val.up { color: var(--color-success, #52B788); }
.signal-val.warn { color: var(--color-warning, #E9A23B); }
.signal-val.down { color: var(--color-error, #D64045); }
.signal-val.flat { color: var(--color-text-secondary, #A09A90); }

.signal-status {
  font-size: var(--fs-18);
  color: var(--color-text-secondary, #A09A90);
}

/* —— 分组 / Hero —— */
.group {
  margin-bottom: 36rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 分区头 = 等宽眉标 + 宋体主标 + 渐隐金线（与全站 mu-head 同口径） */
.group-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 20rpx;
  padding-bottom: 14rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

.group-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.group-cn {
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.hero-card {
  background: linear-gradient(135deg, var(--brass-500, #A8903C) 0%, var(--brass-400, #C4A76C) 100%);
  border-radius: 4rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.hero-card.pulse .hero-value {
  animation: num-soft 0.42s ease;
}

.hero-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hero-label {
  font-size: var(--fs-22);
  letter-spacing: 0.04em;
  color: rgba(255, 255, 255, 0.72);
}

.hero-delta {
  font-size: var(--fs-20);
  color: rgba(255, 255, 255, 0.7);
}

.hero-value {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-48);
  font-weight: 600;
  color: #F3ECDD;
  letter-spacing: 0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-split {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.18);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.hero-split-cell {
  min-width: 0;
  text-align: center;
}

.hero-split-l {
  display: block;
  font-size: var(--fs-18);
  color: rgba(255, 255, 255, 0.65);
}

.hero-split-v {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kpi-meta {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 20rpx;
  width: 100%;
}

.kpi-meta-cell {
  min-width: 0;
  padding: 16rpx 8rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border, #26232066);
  border-radius: 4rpx;
  text-align: center;
  box-sizing: border-box;
}

.kpi-l {
  display: block;
  font-size: var(--fs-18);
  color: var(--color-text-secondary, #A09A90);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kpi-v {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-24);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kpi-v.accent { color: var(--brass-400, #C4A76C); }

/* —— 占比条 —— */
.share-row { margin-bottom: 16rpx; }
.share-row:last-child { margin-bottom: 0; }

.share-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.share-l {
  font-size: var(--fs-24);
  color: var(--color-text-body, #D5D1C8);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-p {
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
  font-family: var(--font-mono);
  flex-shrink: 0;
}

.share-track {
  height: 8rpx;
  border-radius: 9999px;
  background: var(--color-bg-elevated, #262320);
  overflow: hidden;
}

.share-fill {
  height: 100%;
  border-radius: 9999px;
  background: linear-gradient(90deg, var(--brass-500, #A8903C), var(--brass-400, #C4A76C));
  transition: width var(--dur-slow) var(--ease-standard);
}

.share-fill.forest {
  background: linear-gradient(90deg, #1B4332, var(--color-forest, #2D5A3F));
}

.share-fill.gold {
  background: linear-gradient(90deg, #8A7530, #D4BC85);
}

.share-fill.brass {
  background: linear-gradient(90deg, var(--brass-500, #A8903C), var(--brass-400, #C4A76C));
}

.share-val {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  font-family: var(--font-mono);
}

.subhead {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
}

.subhead.spaced {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1px solid var(--color-border, #26232066);
}

/* —— Mini grid / charts —— */
.mini-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  width: 100%;
}

.mini-grid.three .mini-cell {
  flex: 1 1 calc(33.33% - 8rpx);
  min-width: 0;
}

.mini-cell {
  flex: 1 1 calc(50% - 8rpx);
  min-width: 0;
  text-align: center;
  padding: 12rpx 6rpx;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 2rpx;
  box-sizing: border-box;
}

.mini-v {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-v.accent { color: var(--brass-400, #C4A76C); }

.mini-l {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}

.legend-inline {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.legend-inline-t {
  font-size: var(--fs-18);
  color: var(--color-text-secondary, #A09A90);
  margin-right: 6rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 9999px;
}

.dot.brass { background: var(--brass-400, #C4A76C); }
.dot.forest { background: var(--color-forest, #2D5A3F); }

.trend-bars {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 4rpx;
  height: 148px;
  padding-top: 4px;
  box-sizing: border-box;
  overflow: hidden;
  width: 100%;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1 1 0;
  min-width: 0;
  height: 100%;
  justify-content: flex-end;
}

.bar-val-slot {
  flex-shrink: 0;
  height: 26rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.bar-val {
  color: var(--brass-400, #C4A76C);
  font-family: var(--font-mono);
  white-space: nowrap;
  line-height: 1;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bar-track {
  flex: 1;
  min-height: 40rpx;
  max-width: 100%;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 2rpx;
  display: flex;
  flex-direction: column-reverse;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  min-height: 0;
  transition: height var(--dur-slow) cubic-bezier(0.22, 0.61, 0.36, 1);
}

.bar-fill.gold {
  background: linear-gradient(180deg, #D4BC85, var(--color-primary));
}

.bar-fill.forest {
  background: linear-gradient(180deg, #3D7A55, #2D5A3F);
}

.bar-lbl {
  flex-shrink: 0;
  margin-top: 6rpx;
  color: var(--color-text-secondary, #A09A90);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.chart-empty {
  display: block;
  padding: 28rpx 0 12rpx;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.hint {
  display: block;
  margin-top: 14rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.4;
  word-break: break-word;
}

/* —— Skeleton —— */
.skel-card {
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border, #26232066);
  border-radius: 4rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.skel-line {
  height: 24rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, var(--color-bg-elevated) 0%, #33302C 50%, var(--color-bg-elevated) 100%);
  background-size: 200% 100%;
  animation: shimmer 1.2s ease-in-out infinite;
  margin-bottom: 16rpx;
}

.skel-line.w40 { width: 40%; }
.skel-line.w50 { width: 50%; }
.skel-line.w60 { width: 60%; }
.skel-line.w70 { width: 70%; }
.skel-line.w80 { width: 80%; }
.skel-line.tall { height: 44rpx; }

.skel-row {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.skel-block {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, var(--color-bg-elevated) 0%, #33302C 50%, var(--color-bg-elevated) 100%);
  background-size: 200% 100%;
  animation: shimmer 1.2s ease-in-out infinite;
}

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

@keyframes num-soft {
  0% { opacity: 0.45; }
  100% { opacity: 1; }
}

.empty-card {
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border, #26232066);
  border-radius: 4rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.empty-title {
  display: block;
  font-size: var(--fs-28);
  color: #F3ECDD;
}

.empty-desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

.notes-card {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(77, 64, 26, 0.55);
  border-radius: 4rpx;
  box-sizing: border-box;
}

.notes-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.notes-title {
  font-size: var(--fs-22);
  font-weight: 500;
  letter-spacing: 0.12em;
  color: var(--brass-400, #C4A76C);
}

.notes-toggle {
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
}

.note-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(38, 35, 32, 0.85);
}

.note-row:first-of-type {
  margin-top: 12rpx;
}

.note-mark {
  flex-shrink: 0;
  width: 20rpx;
  margin-top: 2rpx;
  font-size: var(--fs-28);
  line-height: 1.2;
  color: var(--brass-600, #8A7530);
  text-align: center;
}

.note-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: var(--color-text-secondary, #A09A90);
  word-break: break-word;
}

.footer-note {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.footer-note-kicker {
  font-size: var(--fs-18);
  letter-spacing: 0.18em;
  color: var(--brass-600, #8A7530);
}

.footer-note-main {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.footer-note-sub {
  max-width: 560rpx;
  font-size: var(--fs-20);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

.verdict-left .signal-light,
.signal-board .signal-light,
.readonly-chip .signal-light,
.legend-row .signal-light {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .skel-line,
  .skel-block {
    animation: none;
  }
}
