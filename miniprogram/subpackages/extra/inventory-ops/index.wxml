<view class="ops-boot" wx:if="{{!ready}}">柜门缓缓开启…</view>

<view class="ops-page" wx:if="{{ready}}">
  <view class="ops-container">
    <view class="ops-header compact">
      <text class="ops-eyebrow">INVENTORY · OPS</text>
      <view class="ops-title-row">
        <text class="ops-title">库存管理</text>
        <text class="ops-meta-chip" wx:if="{{dashLoading || loading}}">刷新中</text>
      </view>
      <text class="ops-note">观测台看盘 · 成品与原材料分柜明细。{{viewMode === 'overview' ? '双集合聚合信号灯。' : (activeTab === 'finished' ? finishedNote : rawNote)}}</text>
    </view>

    <view class="ops-tabs">
      <view class="ops-tab {{viewMode === 'overview' ? 'on' : ''}}" data-mode="overview" bindtap="switchView">总览</view>
      <view class="ops-tab {{viewMode === 'detail' ? 'on' : ''}}" data-mode="detail" bindtap="switchView">明细</view>
    </view>

    <view class="ops-tip is-{{tipTone}}" wx:if="{{tipText}}"><text>{{tipText}}</text></view>

    <!-- ========== 总览 ========== -->
    <block wx:if="{{viewMode === 'overview'}}">
      <view class="ops-source-toggle" bindtap="toggleSource">
        <text class="ops-source-label">{{sourceOpen ? '收起数据说明' : '数据说明'}}</text>
        <text class="ops-source-chevron">{{sourceOpen ? '▴' : '▾'}}</text>
      </view>
      <view class="ops-source-panel" wx:if="{{sourceOpen}}">
        <text class="ops-note">{{sourceNote}}</text>
      </view>

      <view class="ops-skeleton" wx:if="{{dashLoading && !kpis && !dashError}}">
        <view class="ui-sk-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="ui-sk-line wide"></view>
          <view class="ui-sk-line"></view>
        </view>
      </view>

      <view class="ops-empty is-error" wx:elif="{{dashError && !kpis}}">
        <text class="ops-empty-title">观测台未能展开</text>
        <text class="ops-empty-sub">{{dashError}}</text>
        <view class="ops-btn-secondary inv-retry" bindtap="loadDashboard">重试</view>
      </view>

      <view class="ops-tip is-warn" wx:elif="{{dashError && kpis}}">
        <text>刷新失败：{{dashError}}（仍显示上次数据）</text>
      </view>

      <block wx:if="{{kpis}}">
        <view class="verdict-card" wx:if="{{verdict}}">
          <view class="verdict-top">
            <view class="verdict-left">
              <view class="signal-light lg {{verdict.className}}"></view>
              <view class="verdict-copy">
                <text class="verdict-en">INVENTORY · HEALTH</text>
                <text class="verdict-title {{verdict.tone}}">{{verdict.title}}</text>
              </view>
            </view>
            <view class="verdict-badge {{verdict.tone}}">{{verdict.label}}</view>
          </view>
          <text class="verdict-insight">{{verdict.insight}}</text>
          <view class="summary-chips" wx:if="{{signalBoard.summary.ok || signalBoard.summary.warn || signalBoard.summary.danger}}">
            <text class="sum-chip ok" wx:if="{{signalBoard.summary.ok}}">正常 {{signalBoard.summary.ok}}</text>
            <text class="sum-chip warn" wx:if="{{signalBoard.summary.warn}}">关注 {{signalBoard.summary.warn}}</text>
            <text class="sum-chip danger" wx:if="{{signalBoard.summary.danger}}">告警 {{signalBoard.summary.danger}}</text>
          </view>
          <view class="verdict-foot">
            <text class="verdict-meta">{{verdict.updatedAt ? '更新 ' + verdict.updatedAt : '下拉可刷新'}}</text>
            <text class="legend-toggle" bindtap="toggleLegend">{{legendOpen ? '收起图例' : '信号图例'}}</text>
          </view>
          <view class="legend-box" wx:if="{{legendOpen}}">
            <view class="legend-row"><view class="signal-light blink"></view><text class="legend-text">绿 · 正常</text></view>
            <view class="legend-row"><view class="signal-light warn"></view><text class="legend-text">黄 · 需关注</text></view>
            <view class="legend-row"><view class="signal-light danger"></view><text class="legend-text">红 · 告警</text></view>
            <view class="legend-row"><view class="signal-light lamp-muted"></view><text class="legend-text">灰 · 样本不足</text></view>
            <text class="legend-hint">{{signalBoard.rulesNote}}</text>
          </view>
        </view>

        <view class="card signal-board" wx:if="{{signalBoard.items.length}}">
          <view class="card-top">
            <text class="card-title">库存信号灯</text>
            <text class="card-meta">六盏</text>
          </view>
          <view class="signal-grid">
            <view class="signal-item" wx:for="{{signalBoard.items}}" wx:key="id">
              <view class="signal-rail signal-rail--{{item.status}}"></view>
              <view class="signal-light {{item.lampClass}}"></view>
              <view class="signal-copy">
                <text class="signal-name">{{item.name}}</text>
                <text class="signal-val {{item.tone}}">{{item.value}}</text>
                <text class="signal-status">{{item.statusLabel}}</text>
                <text class="signal-reason" wx:if="{{item.reason}}">{{item.reason}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="kpi-section">
          <text class="ops-section-label">核心指标</text>
          <view class="kpi-grid">
            <view class="dash-card accent-brass">
              <view class="dash-accent"></view>
              <text class="dash-label">成品 SKU</text>
              <text class="dash-value brass">{{kpis.finishedSku}}</text>
            </view>
            <view class="dash-card">
              <text class="dash-label">成品件数</text>
              <text class="dash-value">{{kpis.finishedQty}}</text>
            </view>
            <view class="dash-card">
              <text class="dash-label">原材料 SKU</text>
              <text class="dash-value">{{kpis.rawSku}}</text>
            </view>
            <view class="dash-card">
              <text class="dash-label">原料价值</text>
              <text class="dash-value brass">¥{{kpis.rawStockValueText}}</text>
            </view>
          </view>
          <view class="hero-split">
            <view class="hero-split-cell">
              <text class="hero-split-l">零库存占比</text>
              <text class="hero-split-v flat">{{kpis.zeroPctText}}</text>
            </view>
            <view class="hero-split-cell">
              <text class="hero-split-l">原材料预警</text>
              <text class="hero-split-v {{kpis.lowStockCount ? 'warn' : 'flat'}}">{{kpis.lowStockCount}}</text>
            </view>
            <view class="hero-split-cell">
              <text class="hero-split-l">盘点新鲜度</text>
              <text class="hero-split-v flat">{{kpis.ageText}}</text>
            </view>
          </view>
        </view>

        <view class="card structure-card" wx:if="{{structure.length}}">
          <view class="card-top">
            <text class="card-title">成品 vs 原材料</text>
            <text class="card-meta">SKU 结构</text>
          </view>
          <view class="structure-track">
            <view
              class="structure-seg tone-{{item.tone}}"
              wx:for="{{structure}}"
              wx:key="key"
              style="width: {{item.widthPct}}%;"
            ></view>
          </view>
          <view class="structure-legend">
            <view class="structure-row" wx:for="{{structure}}" wx:key="key">
              <view class="structure-dot tone-{{item.tone}}"></view>
              <text class="structure-label">{{item.label}}</text>
              <text class="structure-pct">{{item.pct}}%</text>
              <text class="structure-amt">{{item.amountText}}</text>
            </view>
          </view>
        </view>

        <view class="card" wx:if="{{charts.byFinishedGroup.length}}">
          <view class="card-top">
            <text class="card-title">成品分组</text>
            <text class="card-meta">件数</text>
          </view>
          <view class="bar-stack">
            <view class="bar-item" wx:for="{{charts.byFinishedGroup}}" wx:key="key">
              <view class="bar-meta">
                <text class="bar-label">{{item.label}}</text>
                <text class="bar-val">{{item.qty}} 件</text>
              </view>
              <view class="bar-track">
                <view class="bar-fill" style="width: {{item.pct}}%;"></view>
              </view>
            </view>
          </view>
        </view>

        <view class="card" wx:if="{{charts.byRawCategory.length}}">
          <view class="card-top">
            <text class="card-title">原材料分类</text>
            <text class="card-meta">价值</text>
          </view>
          <view class="bar-stack">
            <view class="bar-item" wx:for="{{charts.byRawCategory}}" wx:key="key">
              <view class="bar-meta">
                <text class="bar-label">{{item.label}}</text>
                <text class="bar-val">¥{{item.amountText}}</text>
              </view>
              <view class="bar-track">
                <view class="bar-fill alt" style="width: {{item.pct}}%;"></view>
              </view>
            </view>
          </view>
        </view>

        <view class="detail-toggle" bindtap="toggleDetail">
          <text class="detail-toggle-main">{{detailOpen ? '收起排行 · 预警明细' : '展开排行 · 预警明细'}}</text>
          <text class="detail-toggle-sub">不影响上方核心指标</text>
        </view>

        <view class="detail-panel" wx:if="{{detailOpen}}">
          <view class="detail-block">
            <view class="detail-block-head" data-key="finished" bindtap="toggleSection">
              <view class="detail-block-titles">
                <text class="detail-block-en">FINISHED TOP</text>
                <text class="detail-block-cn">成品件数排行</text>
              </view>
              <text class="detail-block-chevron">{{sectionOpen.finished ? '收起' : '展开'}}</text>
            </view>
            <view class="bar-stack" wx:if="{{sectionOpen.finished}}">
              <view class="bar-item" wx:for="{{charts.topFinishedView}}" wx:key="key">
                <view class="bar-meta">
                  <text class="bar-label">{{item.label}}</text>
                  <text class="bar-val">{{item.qty}} 件</text>
                </view>
                <view class="bar-track">
                  <view class="bar-fill" style="width: {{item.pct}}%;"></view>
                </view>
              </view>
              <view
                class="list-more"
                wx:if="{{charts.topFinishedMore > 0 || listMore.finished}}"
                data-key="finished"
                bindtap="toggleListMore"
              >
                <text>{{listMore.finished ? '收起' : '查看更多 · ' + charts.topFinishedMore}}</text>
              </view>
            </view>
          </view>

          <view class="detail-block">
            <view class="detail-block-head" data-key="raw" bindtap="toggleSection">
              <view class="detail-block-titles">
                <text class="detail-block-en">RAW TOP</text>
                <text class="detail-block-cn">原材料价值排行</text>
              </view>
              <text class="detail-block-chevron">{{sectionOpen.raw ? '收起' : '展开'}}</text>
            </view>
            <view class="bar-stack" wx:if="{{sectionOpen.raw}}">
              <view class="bar-item" wx:for="{{charts.topRawView}}" wx:key="key">
                <view class="bar-meta">
                  <text class="bar-label">{{item.label}}</text>
                  <text class="bar-val alt">¥{{item.amountText}}</text>
                </view>
                <view class="bar-track">
                  <view class="bar-fill alt" style="width: {{item.pct}}%;"></view>
                </view>
              </view>
              <view
                class="list-more"
                wx:if="{{charts.topRawMore > 0 || listMore.raw}}"
                data-key="raw"
                bindtap="toggleListMore"
              >
                <text>{{listMore.raw ? '收起' : '查看更多 · ' + charts.topRawMore}}</text>
              </view>
            </view>
          </view>

          <view class="detail-block" wx:if="{{charts.lowStockItems.length}}">
            <view class="detail-block-head" data-key="low" bindtap="toggleSection">
              <view class="detail-block-titles">
                <text class="detail-block-en">LOW STOCK</text>
                <text class="detail-block-cn">原材料预警清单</text>
              </view>
              <text class="detail-block-chevron">{{sectionOpen.low ? '收起' : '展开'}}</text>
            </view>
            <view class="metric-list" wx:if="{{sectionOpen.low}}">
              <view class="metric-row is-alert" wx:for="{{charts.lowStockItems}}" wx:key="key">
                <text class="metric-label">{{item.label}}{{item.category ? ' · ' + item.category : ''}}</text>
                <text class="metric-value down">{{item.qty}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="ops-goto-list" data-tab="finished" bindtap="switchTab">
          <text>前往明细 · 成品 / 原材料录入</text>
        </view>
      </block>
    </block>

    <!-- ========== 明细 ========== -->
    <block wx:if="{{viewMode === 'detail'}}">
      <view class="ops-scope-tabs">
        <view class="ops-scope-tab {{activeTab === 'finished' ? 'on' : ''}}" data-tab="finished" bindtap="switchTab">成品库存</view>
        <view class="ops-scope-tab {{activeTab === 'raw' ? 'on' : ''}}" data-tab="raw" bindtap="switchTab">原材料</view>
      </view>

      <!-- Tab：成品库存 -->
      <block wx:if="{{activeTab === 'finished'}}">
        <view class="ops-summary" wx:if="{{!loading || groups.length}}">
          <view class="ops-summary-top">
            <text class="ops-summary-label">{{summary.fromSnapshot ? '历史快照' : '当前台账'}} · {{summary.inventoryDate || '—'}}</text>
            <text class="ops-summary-value">{{summary.totalQty || 0}}<text class="ops-summary-unit">件</text></text>
          </view>
          <text class="ops-summary-meta">
            {{summary.skuCount || summary.count || 0}} SKU · {{summary.groupCount || groups.length || 0}} 分组{{sourceLabel ? ' · ' + sourceLabel : ''}}
          </text>
          <text class="ops-summary-hint" wx:if="{{metaNote}}">{{metaNote}}</text>
        </view>

        <view class="ops-search-row">
          <input
            class="ops-search-input"
            value="{{keyword}}"
            bindinput="onKeywordInput"
            placeholder="搜品名"
            placeholder-class="ops-ph"
            confirm-type="search"
          />
          <view class="ops-search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">清除</view>
        </view>

        <view class="ops-filter-row">
          <picker mode="selector" range="{{dateFilterNames}}" value="{{dateFilterIndex}}" bindchange="onDateFilter">
            <view class="ops-filter-chip">{{dateFilterNames[dateFilterIndex]}}</view>
          </picker>
          <picker mode="selector" range="{{groupFilterNames}}" value="{{groupFilterIndex}}" bindchange="onGroupFilter">
            <view class="ops-filter-chip">{{groupFilterNames[groupFilterIndex]}}</view>
          </picker>
          <view class="ops-btn-add" bindtap="openPaste">粘贴入库</view>
        </view>

        <view class="ops-skeleton" wx:if="{{loading && !groups.length && !finishedListError}}">
          <view class="ui-sk-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
            <view class="ui-sk-line wide"></view>
            <view class="ui-sk-line"></view>
          </view>
        </view>

        <view class="ops-empty is-error" wx:elif="{{finishedListError && !groups.length}}">
          <text class="ops-empty-title">成品列表未能取回</text>
          <text class="ops-empty-sub">{{tipText || '请下拉刷新重试'}}</text>
          <view class="ops-btn-secondary inv-retry" bindtap="loadFinishedList">重试</view>
        </view>

        <view class="ops-empty" wx:elif="{{!loading && !groups.length}}">
          <text class="ops-empty-title">柜中暂无成品台账</text>
          <text class="ops-empty-sub">点「粘贴入库」粘贴群公告格式盘点文本</text>
        </view>

        <block wx:for="{{groups}}" wx:key="key" wx:for-index="gIdx">
          <view class="ops-group">
            <view class="ops-group-head" data-idx="{{gIdx}}" bindtap="toggleGroupCollapse">
              <text class="ops-group-title">{{item.name}} · {{item.skuCount}}SKU</text>
              <view class="ops-group-side">
                <text class="ops-qty-badge">{{item.totalQty}}</text>
                <text class="ops-group-chevron">{{item.collapsed ? '▸' : '▾'}}</text>
              </view>
            </view>
            <view class="ops-group-body" wx:if="{{!item.collapsed}}">
              <view class="ops-line-row" wx:for="{{item.items}}" wx:key="_id" wx:for-item="sku">
                <view class="ops-line-name">
                  {{sku.skuName || sku.itemName}}
                  <text class="ops-line-sub" wx:if="{{sku.framingSpec || sku.spec}}">{{sku.framingSpec || sku.spec}}</text>
                  <text class="ops-line-sub" wx:if="{{sku.inventoryDate}}">盘点 {{sku.inventoryDate}}</text>
                </view>
                <text class="ops-qty-badge">{{sku.qty}}</text>
              </view>
            </view>
          </view>
        </block>

        <view wx:if="{{snapshots.length}}">
          <text class="ops-section-label">历史快照</text>
          <view
            class="ops-snap-row {{item.inventoryDate === dateFilter ? 'active' : ''}}"
            wx:for="{{snapshots}}"
            wx:key="_id"
            data-id="{{item._id}}"
            data-date="{{item.inventoryDate}}"
            bindtap="openSnapshot"
          >
            <view>
              <text class="ops-snap-date">{{item.inventoryDate}}</text>
              <text class="ops-snap-meta">{{item.lineCount}} SKU · {{item.totalQty}} 件</text>
            </view>
            <text class="ops-snap-time">{{item.createdAtText}}</text>
          </view>
        </view>
      </block>

      <!-- Tab：原材料 -->
      <block wx:if="{{activeTab === 'raw'}}">
        <view class="ops-summary" wx:if="{{!loading || rawList.length}}">
          <view class="ops-summary-top">
            <text class="ops-summary-label">库存总价值</text>
            <text class="ops-summary-value">{{rawSummary.stockValueText}}</text>
          </view>
          <text class="ops-summary-meta">
            {{rawSummary.count}} SKU · {{rawSummary.totalQty}} 件{{rawSummary.lowStockCount ? ' · 预警 ' + rawSummary.lowStockCount : ''}}
          </text>
        </view>

        <view class="ops-search-row">
          <input
            class="ops-search-input"
            value="{{keyword}}"
            bindinput="onKeywordInput"
            placeholder="搜品名 / 规格 / 编号"
            placeholder-class="ops-ph"
            confirm-type="search"
          />
          <view class="ops-search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">清除</view>
        </view>

        <view class="ops-filter-row">
          <picker mode="selector" range="{{rawCategoryNames}}" value="{{rawCategoryIndex}}" bindchange="onRawCategory">
            <view class="ops-filter-chip">{{rawCategoryNames[rawCategoryIndex]}}</view>
          </picker>
          <view class="ops-btn-add" bindtap="openRawForm">录入</view>
        </view>

        <view class="ops-skeleton" wx:if="{{loading && !rawList.length && !rawListError}}">
          <view class="ui-sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
            <view class="ui-sk-line wide"></view>
            <view class="ui-sk-line"></view>
          </view>
        </view>

        <view class="ops-empty is-error" wx:elif="{{rawListError && !rawList.length}}">
          <text class="ops-empty-title">原材料列表未能取回</text>
          <text class="ops-empty-sub">{{tipText || '请下拉刷新重试'}}</text>
          <view class="ops-btn-secondary inv-retry" bindtap="loadRawList">重试</view>
        </view>

        <view class="ops-empty" wx:elif="{{!loading && !rawList.length}}">
          <text class="ops-empty-title">暂无原材料台账</text>
          <text class="ops-empty-sub">点「录入」或经 ERP 飞书同步「库存管理」表写入</text>
        </view>

        <block wx:for="{{rawList}}" wx:key="_id">
          <view class="ops-card" data-id="{{item._id}}" bindtap="openRawEdit">
            <view class="ops-card-top">
              <text class="ops-card-title">{{item.itemName}}</text>
              <text class="ops-qty-badge {{item.lowStock ? 'warn' : ''}}">{{item.qty}}</text>
            </view>
            <view class="ops-card-tags">
              <text class="ops-meta-inline" wx:if="{{item.category}}">{{item.category}}</text>
              <text class="ops-meta-inline" wx:if="{{item.spec}}">{{item.spec}}</text>
              <text class="ops-meta-inline" wx:if="{{item.stockValue}}">¥{{item.stockValue}}</text>
            </view>
            <text class="ops-meta" wx:if="{{item.locationText}}">存放 {{item.locationText}}</text>
          </view>
        </block>
      </block>
    </block>
  </view>
</view>

<!-- 成品：粘贴入库 -->
<view class="ops-mask" wx:if="{{showPaste}}" bindtap="closePaste"></view>
<view class="ops-sheet" wx:if="{{showPaste}}">
  <view class="ops-sheet-head">
    <text class="ops-sheet-title">粘贴群公告入库 · 成品</text>
    <text class="ops-sheet-close" bindtap="closePaste">关闭</text>
  </view>
  <scroll-view scroll-y class="ops-sheet-body">
    <view class="ops-paste-card">
      <text class="ops-paste-hint">可忽略「群公告」；含「库存」作来源；日期行 YYYY年M月D日；明细「品名+数量+个」；⬇️ 结尾为分组行。</text>
      <textarea
        class="ops-paste-area"
        value="{{pasteText}}"
        bindinput="onPasteInput"
        placeholder="粘贴群公告盘点文本…"
        placeholder-class="ops-ph"
        maxlength="-1"
      />
      <view class="ops-actions">
        <view class="ops-btn-secondary" bindtap="runPreview">解析预览</view>
        <view class="ops-btn-primary {{committing ? 'disabled' : ''}}" bindtap="confirmCommit">
          {{committing ? '写入中…' : (commitPending ? '再点确认覆盖' : '确认覆盖写入')}}
        </view>
      </view>
    </view>

    <view class="ops-issue-block" wx:if="{{previewError}}">
      <text class="ops-issue-label">{{commitPending ? '待确认' : '提示'}}</text>
      <text class="ops-issue-msg">{{previewError}}</text>
    </view>

    <view wx:if="{{preview}}">
      <view class="ops-preview-bar">
        <text class="ops-preview-label">盘点日</text>
        <text class="ops-filter-chip brass">{{preview.inventoryDate}}</text>
      </view>
      <text class="ops-summary-meta" style="margin-bottom: 16rpx;">
        {{preview.sourceLabel}} · {{preview.lineCount}} SKU · {{preview.totalQty}} 件 · {{preview.groupCount}} 分组
      </text>
      <view class="ops-chips" wx:if="{{preview.groups.length}}" style="margin-bottom: 16rpx;">
        <text class="ops-chip" wx:for="{{preview.groups}}" wx:key="name">{{item.name}} {{item.count}}品 / {{item.totalQty}}个</text>
      </view>
      <block wx:for="{{preview.groupBlocks}}" wx:key="key" wx:for-index="gIdx">
        <view class="ops-group">
          <view class="ops-group-head" data-idx="{{gIdx}}" bindtap="togglePreviewGroup">
            <text class="ops-group-title">{{item.name}} · {{item.skuCount}}SKU</text>
            <view class="ops-group-side">
              <text class="ops-qty-badge">{{item.totalQty}}</text>
              <text class="ops-group-chevron">{{item.collapsed ? '▸' : '▾'}}</text>
            </view>
          </view>
          <view class="ops-group-body" wx:if="{{!item.collapsed}}">
            <view class="ops-line-row" wx:for="{{item.items}}" wx:key="lineNo" wx:for-item="sku">
              <text class="ops-line-name">{{sku.skuName}}</text>
              <text class="ops-qty-badge">{{sku.qty}}</text>
            </view>
          </view>
        </view>
      </block>
      <text class="ops-meta" wx:if="{{preview.skippedCount}}">跳过 {{preview.skippedCount}} 行（公告头等）</text>
    </view>

    <text class="ops-meta" style="margin-top: 24rpx;">写入模式：按盘点日全量覆盖当前成品台账，历史快照保留在 studio_inventory_snapshots。</text>
  </scroll-view>
</view>

<!-- 原材料：录入/编辑 -->
<view class="ops-mask" wx:if="{{showRawForm}}" bindtap="closeRawForm"></view>
<view class="ops-sheet" wx:if="{{showRawForm}}">
  <view class="ops-sheet-head">
    <text class="ops-sheet-title">{{rawEditingId ? '编辑原材料' : '录入原材料'}}</text>
    <text class="ops-sheet-close" bindtap="closeRawForm">关闭</text>
  </view>
  <scroll-view scroll-y class="ops-sheet-body">
    <view class="ops-tip is-warn" wx:if="{{formTip}}"><text>{{formTip}}</text></view>
    <view class="ops-field">
      <text class="ops-field-label">物品名称</text>
      <input class="ops-field-input" value="{{rawForm.itemName}}" bindinput="onRawForm" data-key="itemName" />
    </view>
    <view class="ops-field">
      <text class="ops-field-label">规格型号</text>
      <input class="ops-field-input" value="{{rawForm.spec}}" bindinput="onRawForm" data-key="spec" />
    </view>
    <view class="ops-field">
      <text class="ops-field-label">分类</text>
      <picker mode="selector" range="{{formCategoryNames}}" value="{{formCategoryIndex}}" bindchange="onFormCategory">
        <view class="ops-filter-chip">{{formCategoryNames[formCategoryIndex]}}</view>
      </picker>
    </view>
    <view class="ops-field">
      <text class="ops-field-label">当前库存</text>
      <input class="ops-field-input" type="number" value="{{rawForm.qty}}" bindinput="onRawForm" data-key="qty" />
    </view>
    <view class="ops-field">
      <text class="ops-field-label">单价</text>
      <input class="ops-field-input" type="digit" value="{{rawForm.unitPrice}}" bindinput="onRawForm" data-key="unitPrice" />
    </view>
    <view class="ops-field">
      <text class="ops-field-label">存放位置</text>
      <input class="ops-field-input" value="{{rawForm.locationText}}" bindinput="onRawForm" data-key="locationText" />
    </view>
    <view class="ops-field">
      <text class="ops-field-label">备注</text>
      <input class="ops-field-input" value="{{rawForm.note}}" bindinput="onRawForm" data-key="note" />
    </view>
    <view class="ops-actions" style="margin-top: 24rpx;">
      <view class="ops-btn-secondary" bindtap="closeRawForm">取消</view>
      <view class="ops-btn-primary {{saving ? 'disabled' : ''}}" bindtap="saveRawForm">保存</view>
    </view>
  </scroll-view>
</view>
