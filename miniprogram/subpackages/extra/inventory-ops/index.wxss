@import '../utils/ops-museum.wxss';
@import '../utils/ops-dashboard.wxss';

.ops-container {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.ops-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  line-height: 1.5;
}
.ops-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.ops-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.ops-empty.is-error {
  border-style: solid;
  border-color: rgba(196, 92, 74, 0.4);
}
.inv-retry {
  margin: 24rpx auto 0;
  max-width: 280rpx;
}

.ops-field {
  margin-bottom: 24rpx;
}

.ops-field-label {
  display: block;
  font-size: 22rpx;
  color: #a09a90;
  margin-bottom: 8rpx;
}

.ops-field-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: #1f1d1a;
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-md);
  color: #ffffff;
  font-size: 28rpx;
}

.ops-qty-badge.warn {
  color: #e9a23b;
  border-color: rgba(233, 162, 59, 0.45);
}
