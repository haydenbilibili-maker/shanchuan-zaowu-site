@import '../utils/ops-museum.wxss';
@import '../utils/ops-dashboard.wxss';

.ops-container {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.ops-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  line-height: 1.5;
}
.ops-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.ops-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.ops-empty.is-error {
  border-style: solid;
  border-color: rgba(196, 92, 74, 0.4);
}
.inv-retry {
  margin: 24rpx auto 0;
  max-width: 280rpx;
}

.ops-field {
  margin-bottom: 24rpx;
}

.ops-field-label {
  display: block;
  font-size: var(--fs-22);
  color: #a09a90;
  margin-bottom: 8rpx;
}

.ops-field-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: #1f1d1a;
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-md);
  color: #ffffff;
  font-size: var(--fs-28);
}

.ops-qty-badge.warn {
  color: #e9a23b;
  border-color: rgba(233, 162, 59, 0.45);
}

/* ═══ 2026-11-27 出入库流水：盘点差异 / 单品流水 / 唯一件 ═══ */
.inv-btn-ghost { background: transparent; box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.45); color: var(--brass-300, #D4BC85); }
.inv-sn { color: var(--brass-300, #D4BC85); }
.inv-diff { margin: 20rpx 0; padding: 20rpx 24rpx; border-radius: var(--r-thumb-sm, 8rpx); background: rgba(196, 167, 108, 0.06); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2); }
.inv-diff-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 8rpx 0 12rpx; }
.inv-diff-chip { padding: 6rpx 16rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); background: rgba(255, 255, 255, 0.04); }
.inv-diff-chip.is-add { color: #9cc29a; background: rgba(127, 169, 122, 0.12); }
.inv-diff-chip.is-cut { color: #e3a99e; background: rgba(227, 169, 158, 0.12); }
.inv-diff-chip.is-chg { color: var(--brass-200, #E0CFA3); background: rgba(196, 167, 108, 0.12); }
.inv-diff-warn { display: block; margin-bottom: 10rpx; color: #e3a99e; }
.inv-diff-delta { flex-shrink: 0; font-family: var(--font-mono, monospace); font-size: var(--fs-22); color: var(--brass-200, #E0CFA3); }
.inv-diff-delta.is-cut { color: #e3a99e; }
.inv-move { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid rgba(196, 167, 108, 0.1); }
.inv-move-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.inv-move-type { align-self: flex-start; padding: 2rpx 12rpx; border-radius: 6rpx; font-size: var(--fs-20); color: var(--brass-200, #E0CFA3); background: rgba(196, 167, 108, 0.12); }
.inv-move-type.is-out { color: #e3a99e; background: rgba(227, 169, 158, 0.12); }
.inv-move-type.is-in, .inv-move-type.is-return { color: #9cc29a; background: rgba(127, 169, 122, 0.12); }
.inv-move-note { font-size: var(--fs-24); color: #D5D1C8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.inv-move-meta { font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); }
.inv-move-side { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.inv-move-delta { font-family: var(--font-mono, monospace); font-size: var(--fs-28); font-weight: 600; }
.inv-move-delta.is-in { color: #9cc29a; }
.inv-move-delta.is-out { color: #e3a99e; }
.inv-move-after { font-family: var(--font-mono, monospace); font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); }
.inv-moves-empty { padding: 24rpx 0; }
.inv-adjust { margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx dashed rgba(196, 167, 108, 0.24); }
