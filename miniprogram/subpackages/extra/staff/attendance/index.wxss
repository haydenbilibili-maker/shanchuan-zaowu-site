@import "../scene.wxss";

.container {
  min-height: 100vh;
  padding: var(--space-4);
  box-sizing: border-box;
}

.status-strip.leave {
  border-color: rgba(91, 143, 185, 0.45);
}

.status-strip-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.leave-entry {
  margin-top: var(--space-3);
  text-align: center;
}

/* ================================================================
   仪式感：本周打孔卡（2026-10-18）
   纸面卡（与入馆券同一张纸）+ 打穿的孔露出底色；准时 = 墨孔，迟到 / 早退 = 朱圈孔；今天一格有金线框。
   打卡成功时今天对应的孔放大落定（0.5s 一次性），减弱动效下直接落定。
   ================================================================ */
.punch-card {
  margin-bottom: var(--space-3);
  padding: 20rpx 20rpx 16rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(46, 38, 24, 0.22), 0 8rpx 20rpx rgba(0, 0, 0, 0.35);
}
.punch-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.punch-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: #8B6F47;
}
.punch-sum {
  font-size: var(--fs-20);
  color: #5E5444;
}
.punch-row {
  display: flex;
  gap: 8rpx;
}
.punch-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0 8rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(46, 38, 24, 0.12);
}
.punch-cell.today { box-shadow: inset 0 0 0 2rpx #B08D57; }
.punch-cell.future { opacity: 0.45; }
.punch-dow {
  font-family: var(--font-brand);
  font-size: var(--fs-22);
  color: #2E2618;
}
.punch-day {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  color: #8A7F6C;
}
.punch-hole {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx dashed rgba(46, 38, 24, 0.28);
}
.punch-hole.ok,
.punch-hole.warn {
  border: none;
  background: #1A1814;
  box-shadow: inset 0 3rpx 4rpx rgba(0, 0, 0, 0.7), 0 1rpx 0 rgba(255, 255, 255, 0.6);
}
.punch-hole.warn { box-shadow: 0 0 0 3rpx rgba(168, 53, 42, 0.75), inset 0 3rpx 4rpx rgba(0, 0, 0, 0.7); }
.punch-hole.just { animation: punch-in 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) both; }
@keyframes punch-in {
  0% { transform: scale(0.2); opacity: 0.2; }
  55% { transform: scale(1.35); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .punch-hole.just { animation: none; }
}
