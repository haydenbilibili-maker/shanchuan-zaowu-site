<view class="container" wx:if="{{ready}}">
  <view class="section">
    <text class="section-note">仅展示本人工资条；若为空，请联系店长或超管录入。</text>
    <view class="list">
      <view class="row" wx:for="{{list}}" wx:key="_id" bindtap="openDetail" data-id="{{item._id}}" hover-class="record-press" hover-stay-time="80">
        <view class="row-main">
          <text class="row-title">{{item.month}}</text>
          <text class="row-sub">实发 ¥{{item.net}}</text>
        </view>
        <text class="scene-tile-arrow">明细</text>
      </view>
    </view>
    <view class="empty" wx:if="{{list.length === 0 && !loading}}">暂无工资条记录</view>
  </view>
</view>

<view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail">
  <view class="modal" catchtap="noop">
    <text class="modal-title">工资条 · {{detail.month}}</text>
    <view class="scene-card" style="margin-top:24rpx;">
      <view class="row">
        <text class="row-sub">基本工资</text>
        <text class="amount-row">¥{{detail.base}}</text>
      </view>
      <view class="row">
        <text class="row-sub">奖金 / 补贴</text>
        <text class="amount-row">¥{{detail.bonus}}</text>
      </view>
      <view class="row">
        <text class="row-sub">扣款</text>
        <text class="amount-row">¥{{detail.deduction}}</text>
      </view>
      <view class="row">
        <text class="row-sub">实发</text>
        <text class="amount-row gold">¥{{detail.net}}</text>
      </view>
      <text class="section-note" wx:if="{{detail.remark}}">{{detail.remark}}</text>
    </view>
    <view class="btn-primary" bindtap="closeDetail">关闭</view>
  </view>
</view>
