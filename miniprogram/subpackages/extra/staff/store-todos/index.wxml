<view class="page-boot" wx:if="{{!ready}}">
  <text class="boot-en">CHECKLIST</text>
  <text class="boot-cn">早晚门店清单</text>
  <text class="boot-hint">校验权限中…</text>
</view>

<view class="container" wx:elif="{{ready}}">
  <picker class="store-picker" mode="selector" range="{{storeNames}}" value="{{storeIndex}}" bindchange="onStoreChange">
    <view class="picker-inner">
      <text class="picker-label">门店</text>
      <text class="picker-value">{{storeName}}</text>
      <text class="picker-arrow">切换</text>
    </view>
  </picker>

  <view class="seg-row">
    <view class="seg-item {{shift==='morning'?'on':''}}" bindtap="setShift" data-shift="morning">早班清单</view>
    <view class="seg-item {{shift==='evening'?'on':''}}" bindtap="setShift" data-shift="evening">晚班清单</view>
  </view>

  <view class="scene-card">
    <view class="status-strip {{shiftStatus}}">
      <text class="status-strip-title">{{shift === 'evening' ? '晚班' : '早班'}} · {{shiftStatusLabel}}</text>
      <text class="status-strip-hint">{{storeName}} · {{dateKey}} · {{progress.done}} / {{progress.total}}</text>
    </view>
    <text class="last-feedback" wx:if="{{lastSave}}">{{lastSave}}</text>
    <view class="check-row" wx:for="{{items}}" wx:key="id" bindtap="toggleItem" data-id="{{item.id}}" hover-class="record-press" hover-stay-time="80">
      <view class="check-box {{item.checked ? 'on' : ''}}"></view>
      <view class="check-label">
        <text>{{item.label}}</text>
        <text class="check-meta" wx:if="{{item.checkedAtText}}">完成于 {{item.checkedAtText}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!items.length}}">本班次暂无清单项，请下拉刷新或联系店长</view>
    <view class="btn-primary {{saving ? 'disabled' : ''}}" hover-class="btn-primary-press" hover-stay-time="100" bindtap="saveTodo">{{saving ? '保存中…' : '保存清单'}}</view>
  </view>
</view>
