@import "../scene.wxss";

.container {
  min-height: 100vh;
  padding: var(--space-4);
  box-sizing: border-box;
}

/* ================================================================
   仪式感：开馆 / 闭馆（2026-10-18）
   早班勾完：两扇深色铜边门板从中缝向两侧推开，露出暖金光与「今日开馆」；
   晚班勾完：一盏铜灯从亮到熄，「闭馆 · 今日辛苦了」。
   is-live = 本页亲手勾完才播（1.1s 一次性）；进页时已完成则直接停在终态；减弱动效下同样直接终态。
   ================================================================ */
.ceremony {
  position: relative;
  overflow: hidden;
  margin-bottom: var(--space-3);
  padding: 36rpx 24rpx 32rpx;
  border-radius: 4rpx;
  text-align: center;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
}
.ceremony.open {
  background: radial-gradient(ellipse at 50% 40%, rgba(232, 201, 140, 0.32), rgba(26, 24, 20, 0) 70%), #211D16;
}
.ceremony.close {
  background: #17150F;
}
.cer-en {
  position: relative;
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.cer-cn {
  position: relative;
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}
.cer-sub {
  position: relative;
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

/* 门板：终态停在两侧之外 */
.cer-door {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 50%;
  z-index: 2;
  background: linear-gradient(90deg, #2A251C, #1E1A14);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.4);
  opacity: 0;
}
.cer-door.left { left: 0; transform: translateX(-100%); }
.cer-door.right { right: 0; transform: translateX(100%); }
.ceremony.is-live .cer-door { opacity: 1; animation-duration: 1.1s; animation-timing-function: cubic-bezier(0.6, 0, 0.2, 1); animation-fill-mode: both; }
.ceremony.is-live .cer-door.left { animation-name: cer-door-left; }
.ceremony.is-live .cer-door.right { animation-name: cer-door-right; }
@keyframes cer-door-left { 0%, 20% { transform: translateX(0); } 100% { transform: translateX(-100%); } }
@keyframes cer-door-right { 0%, 20% { transform: translateX(0); } 100% { transform: translateX(100%); } }

/* 铜灯：终态 = 熄（只余一圈暗铜） */
.cer-lamp {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: #3A3226;
  box-shadow: 0 0 0 2rpx rgba(196, 167, 108, 0.35);
}
.ceremony.is-live .cer-lamp { animation: cer-lamp-off 1.1s ease-in both; }
@keyframes cer-lamp-off {
  0%, 25% { background: #F2D58E; box-shadow: 0 0 0 2rpx rgba(196, 167, 108, 0.6), 0 0 48rpx 16rpx rgba(242, 213, 142, 0.55); }
  100% { background: #3A3226; box-shadow: 0 0 0 2rpx rgba(196, 167, 108, 0.35), 0 0 0 0 rgba(242, 213, 142, 0); }
}
@media (prefers-reduced-motion: reduce) {
  .ceremony.is-live .cer-door,
  .ceremony.is-live .cer-lamp { animation: none; }
  .ceremony.is-live .cer-door { opacity: 0; }
}
