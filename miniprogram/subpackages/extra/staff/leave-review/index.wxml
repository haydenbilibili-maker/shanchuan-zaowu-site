<view class="page-boot" wx:if="{{!ready}}">
  <text class="boot-en">LEAVE REVIEW</text>
  <text class="boot-cn">请假审批</text>
  <text class="boot-hint">校验权限中…</text>
</view>

<view class="container" wx:elif="{{ready}}">
  <view class="section">
    <text class="section-note">店员 / 标本师 / 主播请假由店长处理；店长本人请假仅超管可见并审批。</text>
    <text class="last-feedback" wx:if="{{lastReview}}">{{lastReview}}</text>
  </view>

  <view class="section" wx:if="{{list.length}}">
    <view class="card" wx:for="{{list}}" wx:key="_id">
      <view class="card-head">
        <view class="name-row">
          <view class="signal-light {{item.lampClass}}"></view>
          <text class="name">{{item.staffName || '同事'}}</text>
        </view>
        <text class="amount">{{item.leaveTypeLabel}}</text>
      </view>
      <text class="meta">{{item.rangeText}} · {{item.durationLabel}}</text>
      <text class="meta soft" wx:if="{{item.storeName}}">{{item.storeName}} · {{item.createTimeText}}</text>
      <text class="remark" wx:if="{{item.reason}}">{{item.reason}}</text>
      <view class="actions">
        <view class="btn reject {{reviewingId ? 'disabled' : ''}}" hover-class="btn-outline-press" hover-stay-time="100" data-id="{{item._id}}" bindtap="review" data-decision="rejected">驳回</view>
        <view class="btn approve {{reviewingId ? 'disabled' : ''}}" hover-class="btn-primary-press" hover-stay-time="100" data-id="{{item._id}}" bindtap="review" data-decision="approved">{{reviewingId === item._id ? '处理中…' : '通过'}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text>{{loading ? '加载中…' : '暂无待审批请假'}}</text>
    <text class="section-note" wx:if="{{!loading}}">新申请提交后会出现在这里；处理完成后本页会自动刷新</text>
  </view>
</view>
