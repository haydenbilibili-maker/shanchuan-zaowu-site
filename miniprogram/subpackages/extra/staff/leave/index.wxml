<view class="page-boot" wx:if="{{!ready}}">
  <text class="boot-en">LEAVE</text>
  <text class="boot-cn">请假申请</text>
  <text class="boot-hint">校验权限中…</text>
</view>

<view class="container" wx:elif="{{ready}}">
  <view class="section">
    <picker class="store-picker" mode="selector" range="{{storeNames}}" value="{{storeIndex}}" bindchange="onStoreChange">
      <view class="picker-inner">
        <text class="picker-label">关联门店</text>
        <text class="picker-value">{{storeName}}</text>
        <text class="picker-arrow">切换</text>
      </view>
    </picker>

    <view class="field">
      <text class="field-label">请假类型</text>
      <picker mode="selector" range="{{leaveTypeLabels}}" value="{{leaveTypeIndex}}" bindchange="onLeaveTypeChange">
        <view class="input">{{leaveTypeLabels[leaveTypeIndex]}}</view>
      </picker>
    </view>

    <view class="field-row">
      <view class="field half">
        <text class="field-label">开始日期</text>
        <picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="onDateChange">
          <view class="input">{{form.startDate}}</view>
        </picker>
      </view>
      <view class="field half">
        <text class="field-label">开始时间</text>
        <picker mode="time" value="{{form.startTime}}" data-field="startTime" bindchange="onTimeChange">
          <view class="input">{{form.startTime}}</view>
        </picker>
      </view>
    </view>

    <view class="field-row">
      <view class="field half">
        <text class="field-label">结束日期</text>
        <picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="onDateChange">
          <view class="input">{{form.endDate}}</view>
        </picker>
      </view>
      <view class="field half">
        <text class="field-label">结束时间</text>
        <picker mode="time" value="{{form.endTime}}" data-field="endTime" bindchange="onTimeChange">
          <view class="input">{{form.endTime}}</view>
        </picker>
      </view>
    </view>

    <view class="duration-box">
      <text class="duration-label">预计时长</text>
      <text class="duration-value">{{durationPreview}}</text>
    </view>

    <view class="field">
      <text class="field-label">事由</text>
      <input class="input" maxlength="200" placeholder="简要说明（最多 200 字）" placeholder-class="ph"
             value="{{form.reason}}" bindinput="onInput" data-field="reason" />
    </view>

    <view class="btn-primary {{submitting ? 'disabled' : ''}}" hover-class="btn-primary-press" hover-stay-time="100" bindtap="submit">{{submitting ? '提交中…' : '提交请假'}}</view>
    <text class="section-note">店员 / 标本师 / 主播由店长审批；店长本人请假由超管审批；超管提交直通通过。</text>
  </view>

  <view class="section">
    <view class="section-title"><text class="st-cn">我的请假</text></view>
    <view class="list">
      <view class="record" wx:for="{{list}}" wx:key="_id">
        <view class="rec-top">
          <view class="rec-title-row">
            <view class="signal-light {{item.lampClass}}"></view>
            <text class="rec-member">{{item.leaveTypeLabel || '请假'}} · {{item.durationLabel || ''}}</text>
          </view>
          <text class="tag-status {{item.status}}">{{item.statusLabel}}</text>
        </view>
        <text class="rec-meta">{{item.startKey}} ~ {{item.endKey}}{{item.reason ? ' · ' + item.reason : ''}}</text>
        <text class="rec-meta soft">{{item.timeText}}</text>
        <view hover-class="tap-press" hover-stay-time="80"
          class="btn-ghost sm"
          wx:if="{{item.status === 'pending'}}"
          data-id="{{item._id}}"
          bindtap="cancelLeave"
        >撤销申请</view>
      </view>
    </view>
    <view class="empty" wx:if="{{list.length === 0}}">
      <text>还没有请假记录</text>
      <text class="section-note">通过后，对应日期在考勤页将标记为「请假」，不计异常缺勤</text>
    </view>
  </view>
</view>

<!-- 全站样式化弹窗宿主（utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
