@import "./scene.wxss";

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.container {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 工作台首屏扫码 CTA：复用 field .scan-cta，略抬视觉权重 */
.hub-scan-cta {
  margin-top: var(--space-2);
  margin-bottom: var(--space-2);
}

.hub-scan-cta .scan-cta-btn {
  letter-spacing: 0.08em;
}

/* ================================================================
   2026-10-18 店员工作台视觉对齐（产品负责人「继续逐个工作台优化」）
   只覆盖本页：scene.wxss / field/index.wxss 是子页与核销页共用件，不动。
   等宽眉标 + 宋体主标；门店 = 发丝线行；场景 = 方角发丝账格 + 方印图标；
   全屏唯一实心金 = 「扫顾客会员码」；角标退为金线环方签。
   员工端信号灯图例语义保留（绿 / 黄 / 红 / 灰）。
   ================================================================ */
.page-boot { align-items: flex-start; }
.page-boot .boot-en,
.scene-header .brand-group .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.page-boot .boot-cn,
.scene-header .brand-group .cn {
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.scene-header .role-badge {
  padding: 6rpx 16rpx;
  border: none;
  border-radius: 2rpx;
  box-shadow: var(--ring-brass-soft);
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: var(--brass-200);
}

.scene-header .header-legend { margin-top: var(--space-3); }

/* 默认门店：发丝线行（原深色圆角卡） */
.scene-header .store-picker { margin-top: var(--space-4); }
.scene-header .picker-inner {
  padding: 26rpx 4rpx;
  background: transparent;
  border: none;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: 0;
}
.scene-header .picker-label {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-300);
}
.scene-header .picker-value {
  font-family: var(--font-brand);
  font-weight: 600;
  color: #F3ECDD;
}
.scene-header .picker-arrow {
  margin-left: var(--space-2);
  color: var(--brass-200);
}

/* 全屏唯一实心金 */
.hub-scan-cta .scan-cta-btn {
  border-radius: 4rpx;
  font-weight: 600;
  color: #1A1814;
}

/* 分区头 = 等宽眉标 + 宋体主标 + 渐隐金线（与标本师 / 观测台同口径；不再「现场服务 / ON-SITE」同行并列） */
.scene-group .group-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: var(--space-3);
  padding-bottom: 16rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}
.group-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.group-cn {
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

/* 场景格：方角发丝账格（原 brass-800 描边大圆角卡） */
.link-row { gap: 16rpx; }
.link-row .link-btn {
  position: relative;
  padding: 26rpx 24rpx 28rpx;
  border: none;
  border-radius: 4rpx;
  background: rgba(243, 236, 221, 0.02);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.18);
}
.link-row .link-btn:active { background: rgba(196, 167, 108, 0.06); }
.link-btn .icon-box {
  width: 64rpx;
  height: 64rpx;
  background: transparent;
  border: none;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.35);
}
.link-btn .menu-icon-img { width: 36rpx; height: 36rpx; }
.link-btn .lb-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}
.link-btn .lb-cn {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #F3ECDD;
}
.link-btn .lb-desc { padding-right: 28rpx; }
.lb-arrow {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  font-size: var(--fs-32);
  line-height: 1;
  color: var(--brass-300);
}

/* 角标：金线环方签（原实心金药丸，和扫码主按钮抢「唯一实心金」） */
.link-btn .scene-badge {
  top: -10rpx;
  right: -10rpx;
  border-radius: 2rpx;
  background: #1A1814;
  box-shadow: var(--ring-brass);
  color: var(--brass-200);
}

/* 场景格按压态（:active 在部分真机不触发，以 hover-class 为准） */
.link-row .link-btn-press {
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass-soft);
}
.link-btn-press .lb-arrow { color: var(--brass-200); }

.scene-empty {
  padding: var(--space-4);
  border: 1rpx dashed rgba(196, 167, 108, 0.24);
  border-radius: 4rpx;
}

.footer .cr-cn { letter-spacing: 0.2em; }
.footer .cr-en { font-family: var(--font-mono); color: var(--brass-300); opacity: 0.7; }
