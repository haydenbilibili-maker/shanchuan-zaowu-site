@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-body, #D5D1C8);
}

.page { min-height: 100vh; }

.container {
  padding: 0 var(--space-4, 32rpx) 120rpx;
  box-sizing: border-box;
}

.header { padding: var(--space-5, 40rpx) 0 var(--space-2, 16rpx); }
.brand-group { display: flex; flex-direction: column; }
.brand-group .en {
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-600, #8A7530);
  text-transform: uppercase;
}
.brand-group .cn {
  font-family: var(--font-brand, Georgia, serif);
  font-size: var(--fs-40);
  color: var(--color-text-primary, #FFFFFF);
  margin-top: 6rpx;
}
.header-note {
  display: block;
  margin-top: var(--space-2, 16rpx);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}
.header-actions { margin-top: 16rpx; }
.link-chip {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 20rpx;
}
.filter-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.8);
  background: var(--color-bg-elevated, #262320);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}
.btn-add {
  margin-left: auto;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-md);
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  font-size: var(--fs-24);
  font-weight: 500;
}

.formula-card {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
}
.formula-title {
  display: block;
  font-size: var(--fs-24);
  color: var(--brass-400, #C4A76C);
  margin-bottom: 8rpx;
}
.formula-line {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
  margin-top: 4rpx;
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.skeleton-list .ui-sk-card { margin-top: 0; }
.skeleton-list .ui-sk-line.mid { width: 58%; }

.empty-tip {
  padding: 48rpx 24rpx;
  text-align: center;
}
.empty-tip.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
}
.empty-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-primary, #FFFFFF);
}
.empty-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}
.btn-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
  font-size: var(--fs-24);
  color: #e8dcc0;
}
.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(38, 35, 32, 0.66);
  border-radius: var(--radius-md);
}
.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.card-title {
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  font-weight: 500;
}
.status-tag {
  font-size: var(--fs-20);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
  background: rgba(38, 35, 32, 0.9);
  flex-shrink: 0;
}
.status-tag.brass { color: var(--color-primary); background: rgba(196, 167, 108, 0.15); }
.status-tag.muted { color: var(--color-text-secondary); }

.signal-light {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.signal-light.lamp-forest { background: var(--color-success); }
.signal-light.lamp-muted {
  background: transparent;
  border: 2rpx solid var(--color-text-muted);
  box-sizing: border-box;
}
.signal-light.hollow { background: transparent; }

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.45;
}

.ratio-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}
/* 两列留余量：原 2×(50% - 6rpx) + 12rpx = 恰好 100%（错题本 E26） */
.ratio-cell {
  box-sizing: border-box;
  width: 48.5%;
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(77, 64, 26, 0.35);
  box-sizing: border-box;
}
.ratio-label {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}
.ratio-value {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-mono, monospace);
  font-size: var(--fs-28);
  color: var(--brass-400, #C4A76C);
}

.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.chip-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
}
.chip-btn.danger {
  border-color: rgba(214, 64, 69, 0.4);
  color: #D64045;
}
.chip-btn.success {
  border-color: rgba(82, 183, 136, 0.4);
  color: var(--color-success);
}

.sheet {
  max-height: 86vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}
.sheet-title {
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  font-weight: 500;
}
.sheet-close {
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}
.sheet-body {
  max-height: 72vh;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}
.field { margin-bottom: 20rpx; }
.field-row { display: flex; gap: 16rpx; }
.field.half { flex: 1; min-width: 0; }
.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}
.field-hint {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.45;
}
.field-hint.warn { color: #E9A23B; }
.input {
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(38, 35, 32, 0.8);
  color: var(--color-text-primary);
  font-size: var(--fs-26);
}
.picker-like { line-height: 1.4; }
.ph { color: var(--color-text-muted); }
.openid-text {
  font-family: var(--font-mono, monospace);
  font-size: var(--fs-26);
  color: var(--color-text-body, #D5D1C8);
}

.phone-toolbar {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.phone-input { flex: 1; }
.lookup-btn {
  padding: 16rpx 22rpx;
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.18);
  color: var(--brass-400, #C4A76C);
  font-size: var(--fs-24);
  flex-shrink: 0;
}
.lookup-btn.disabled { opacity: 0.5; }

.match-card {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
}
.match-badge {
  font-size: var(--fs-20);
  color: var(--brass-400, #C4A76C);
  margin-right: 10rpx;
}
.match-name {
  font-size: var(--fs-26);
  color: var(--color-text-primary);
}
.match-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}
.candidate-list { margin-top: 12rpx; }
.candidate-row {
  padding: 16rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(38, 35, 32, 0.8);
}

.store-check-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.store-check {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  background: var(--color-bg-elevated, #262320);
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}
.store-check.on {
  border-color: rgba(196, 167, 108, 0.55);
  color: var(--brass-400, #C4A76C);
  background: rgba(196, 167, 108, 0.12);
}

.btn.primary {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  font-size: var(--fs-28);
  font-weight: 500;
}
.btn.primary.disabled { opacity: 0.55; }

.workbench-state.loading {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary, #A09A90);
  font-size: var(--fs-26);
}

/* ================================================================
   2026-10-18 股东配置视觉对齐（超管二级页，产品负责人「继续」）
   等宽眉标 + 宋体；股东 = 方角发丝档案卡，四格比例 = 发丝账格；口径说明 = 左金线注记；
   胶囊签全部改方签；实心金只留「新增股东」与抽屉里的「保存」。
   输入框补定高 + border-box：原来只靠 padding 撑高，半宽两栏里会贴边、真机行高不稳。
   比例格保持 48.5% + space-between（错题本 E26，不用 50% − gap）。
   ================================================================ */
.brand-group .en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.brand-group .cn {
  margin-top: 8rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}
.link-chip {
  padding: 8rpx 18rpx;
  border: none;
  border-radius: 2rpx;
  box-shadow: var(--ring-brass-soft);
  color: var(--brass-200);
}

.filter-row { margin-top: 8rpx; }
.filter-chip {
  padding: 12rpx 20rpx;
  border: none;
  border-radius: 2rpx;
  background: transparent;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
  color: var(--brass-200);
}
.btn-add {
  padding: 14rpx 28rpx;
  border-radius: 4rpx;
  font-weight: 600;
  color: #1A1814;
}

/* 口径说明：左金线注记（原深色圆角卡） */
.formula-card {
  margin: 8rpx 0 32rpx;
  padding: 4rpx 0 4rpx 24rpx;
  background: transparent;
  border: none;
  border-left: 2rpx solid rgba(196, 167, 108, 0.55);
  border-radius: 0;
}
.formula-title {
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--brass-200);
}

/* 股东档案卡 */
.card {
  padding: 28rpx 28rpx 24rpx;
  background: rgba(243, 236, 221, 0.02);
  border: 1rpx solid rgba(196, 167, 108, 0.16);
  border-radius: 4rpx;
}
.card-title {
  font-family: var(--font-brand);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
}
.status-tag {
  border-radius: 2rpx;
  background: transparent;
  box-shadow: inset 0 0 0 1rpx rgba(185, 173, 150, 0.35);
}
.status-tag.brass {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.06);
  box-shadow: var(--ring-brass-soft);
}
.ratio-cell {
  border-radius: 2rpx;
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.14);
}
.ratio-label { letter-spacing: 0.04em; }
.ratio-value { color: var(--brass-200); }
.card-actions {
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.1);
}
.chip-btn {
  padding: 10rpx 24rpx;
  border-radius: 2rpx;
}

.empty-tip.is-error,
.match-card { border-radius: 4rpx; }
.btn-retry,
.page-tip,
.candidate-row,
.lookup-btn { border-radius: 2rpx; }

/* 编辑抽屉 */
.sheet-title {
  font-family: var(--font-brand);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #F3ECDD;
}
.sheet-close { color: var(--brass-200); }
.field-label { letter-spacing: 0.04em; }
.input {
  display: block;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 20rpx;
  line-height: normal;
  box-sizing: border-box;
  border-radius: 2rpx;
  background: rgba(243, 236, 221, 0.03);
  border: 1rpx solid rgba(196, 167, 108, 0.22);
}
.picker-like {
  display: flex;
  align-items: center;
}
.phone-toolbar { align-items: stretch; }
.lookup-btn {
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  background: transparent;
  box-shadow: var(--ring-brass-soft);
  color: var(--brass-200);
}
.store-check {
  border-radius: 2rpx;
  border-color: rgba(196, 167, 108, 0.18);
  background: transparent;
}
.store-check.on {
  background: rgba(196, 167, 108, 0.08);
  border-color: rgba(196, 167, 108, 0.55);
  color: var(--brass-200);
}
.btn.primary {
  border-radius: 4rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #1A1814;
}
