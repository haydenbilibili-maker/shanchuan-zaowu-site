@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-body, #D5D1C8);
}

.page { min-height: 100vh; }

.container {
  padding: 0 var(--space-4, 32rpx) 120rpx;
  box-sizing: border-box;
}

.header { padding: var(--space-5, 40rpx) 0 var(--space-2, 16rpx); }
.brand-group { display: flex; flex-direction: column; }
.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600, #8A7530);
  text-transform: uppercase;
}
.brand-group .cn {
  font-family: var(--font-brand, Georgia, serif);
  font-size: 40rpx;
  color: var(--color-text-primary, #FFFFFF);
  margin-top: 6rpx;
}
.header-note {
  display: block;
  margin-top: var(--space-2, 16rpx);
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}
.header-actions { margin-top: 16rpx; }
.link-chip {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 20rpx;
}
.filter-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.8);
  background: var(--color-bg-elevated, #262320);
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}
.btn-add {
  margin-left: auto;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-md);
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  font-size: 24rpx;
  font-weight: 500;
}

.formula-card {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
}
.formula-title {
  display: block;
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
  margin-bottom: 8rpx;
}
.formula-line {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
  margin-top: 4rpx;
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.skeleton-list .ui-sk-card { margin-top: 0; }
.skeleton-list .ui-sk-line.mid { width: 58%; }

.empty-tip {
  padding: 48rpx 24rpx;
  text-align: center;
}
.empty-tip.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
}
.empty-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary, #FFFFFF);
}
.empty-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}
.btn-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e8dcc0;
}
.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(38, 35, 32, 0.66);
  border-radius: var(--radius-md);
}
.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.card-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}
.status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
  background: rgba(38, 35, 32, 0.9);
  flex-shrink: 0;
}
.status-tag.brass { color: var(--gold); background: rgba(196, 167, 108, 0.15); }
.status-tag.muted { color: var(--color-text-secondary); }

.signal-light {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.signal-light.lamp-forest { background: #52B788; }
.signal-light.lamp-muted {
  background: transparent;
  border: 2rpx solid var(--color-text-muted);
  box-sizing: border-box;
}
.signal-light.hollow { background: transparent; }

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.45;
}

.ratio-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}
/* 两列留余量：原 2×(50% - 6rpx) + 12rpx = 恰好 100%（错题本 E26） */
.ratio-cell {
  box-sizing: border-box;
  width: 48.5%;
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(77, 64, 26, 0.35);
  box-sizing: border-box;
}
.ratio-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
}
.ratio-value {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-mono, monospace);
  font-size: 28rpx;
  color: var(--brass-400, #C4A76C);
}

.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.chip-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}
.chip-btn.danger {
  border-color: rgba(214, 64, 69, 0.4);
  color: #D64045;
}
.chip-btn.success {
  border-color: rgba(82, 183, 136, 0.4);
  color: #52B788;
}

.sheet {
  max-height: 86vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}
.sheet-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}
.sheet-close {
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}
.sheet-body {
  max-height: 72vh;
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}
.field { margin-bottom: 20rpx; }
.field-row { display: flex; gap: 16rpx; }
.field.half { flex: 1; min-width: 0; }
.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}
.field-hint {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.45;
}
.field-hint.warn { color: #E9A23B; }
.input {
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(38, 35, 32, 0.8);
  color: var(--color-text-primary);
  font-size: 26rpx;
}
.picker-like { line-height: 1.4; }
.ph { color: var(--color-text-muted); }
.openid-text {
  font-family: var(--font-mono, monospace);
  font-size: 26rpx;
  color: var(--color-text-body, #D5D1C8);
}

.phone-toolbar {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.phone-input { flex: 1; }
.lookup-btn {
  padding: 16rpx 22rpx;
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.18);
  color: var(--brass-400, #C4A76C);
  font-size: 24rpx;
  flex-shrink: 0;
}
.lookup-btn.disabled { opacity: 0.5; }

.match-card {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
}
.match-badge {
  font-size: 20rpx;
  color: var(--brass-400, #C4A76C);
  margin-right: 10rpx;
}
.match-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
}
.match-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}
.candidate-list { margin-top: 12rpx; }
.candidate-row {
  padding: 16rpx;
  margin-bottom: 8rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(38, 35, 32, 0.8);
}

.store-check-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.store-check {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  background: var(--color-bg-elevated, #262320);
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}
.store-check.on {
  border-color: rgba(196, 167, 108, 0.55);
  color: var(--brass-400, #C4A76C);
  background: rgba(196, 167, 108, 0.12);
}

.btn.primary {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  font-size: 28rpx;
  font-weight: 500;
}
.btn.primary.disabled { opacity: 0.55; }

.workbench-state.loading {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary, #A09A90);
  font-size: 26rpx;
}
