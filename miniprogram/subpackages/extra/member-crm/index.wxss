/* 会员 CRM — Museum Mode（对齐荣誉馆长） */
page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.container {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  padding: var(--space-5) 0 var(--space-2);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.brand-group .cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.hint-card {
  margin-bottom: var(--space-4);
  padding: var(--space-3) var(--space-4);
  background: rgba(233, 162, 59, 0.1);
  border: 1rpx solid rgba(233, 162, 59, 0.28);
  border-radius: var(--radius-md);
}

.hint-card.info {
  background: rgba(91, 143, 185, 0.1);
  border-color: rgba(91, 143, 185, 0.28);
}

.hint-card.info .hint-text {
  color: var(--color-info);
}

.hint-text {
  font-size: 22rpx;
  color: var(--color-warning);
  line-height: 1.5;
}

.filter-section {
  margin-bottom: var(--space-3);
}

.search-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: 26rpx;
}

.btn-outline {
  padding: 0 var(--space-3);
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-md);
  color: var(--brass-400);
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.btn-outline.mini {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 var(--space-2);
  font-size: 22rpx;
}

.search-btn {
  flex-shrink: 0;
  min-width: 96rpx;
}

.btn-primary {
  padding: 0 var(--space-4);
  height: 72rpx;
  line-height: 72rpx;
  background: var(--brass-400);
  color: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

.btn-primary.disabled {
  opacity: 0.5;
}

.seg-scroll {
  width: 100%;
  margin-bottom: var(--space-3);
  white-space: nowrap;
}

.seg-row {
  display: inline-flex;
  gap: var(--space-2);
  padding-bottom: 4rpx;
}

.seg-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
}

.seg-pill.on {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
}

.seg-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.seg-count {
  font-size: 22rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.section {
  margin-bottom: var(--space-4);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: var(--space-3);
  gap: var(--space-2);
}

.section-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.section-meta {
  flex: 1;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  text-align: right;
  line-height: 1.4;
}

/* ===== 会员列表 · 铜牌铭牌 ===== */
.member-plate {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--space-3);
  padding: 28rpx 28rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid #4D401A;
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.member-plate-pressed {
  background: var(--color-bg-elevated);
}

.plate-beat-identity {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}

.plate-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-bg-elevated);
  border: 1rpx solid #4D401A;
  box-sizing: border-box;
}

.plate-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-brand);
  font-size: 40rpx;
  font-weight: 500;
  color: var(--gold);
}

.plate-identity-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 4rpx;
}

.plate-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.plate-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-youxin-fill {
  flex-shrink: 0;
  height: 56rpx;
  min-width: 96rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--gold);
  color: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.btn-youxin-fill.compact {
  height: 52rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.btn-youxin-fill-pressed {
  background: #A8903C;
}

.plate-ribbon {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 16rpx;
  min-width: 0;
}

.plate-ribbon-seg {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.plate-segment {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plate-honor-chip {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: var(--color-bg);
  background: var(--gold);
  border-radius: var(--radius-sm);
  letter-spacing: 0.04em;
}

.plate-level-inline {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  max-width: 100%;
  min-width: 0;
  flex-shrink: 1;
}

.plate-level-lv {
  flex-shrink: 0;
  font-size: 24rpx;
  font-family: var(--font-mono);
  color: var(--gold);
  font-weight: 500;
}

.plate-level-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.plate-hairline {
  height: 4rpx;
  margin: 22rpx 0 0;
  background: rgba(77, 64, 26, 0.85);
  border-radius: 2rpx;
}

.spec-plate {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-sm);
  background: rgba(250, 246, 237, 0.03);
}

.spec-row {
  display: flex;
  align-items: center;
  min-height: 52rpx;
}

.spec-row + .spec-row {
  margin-top: 4rpx;
}

.spec-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.spec-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  font-family: var(--font-mono);
  color: var(--color-text-body);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-value.muted {
  color: var(--color-text-muted);
}

.spec-value-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.spec-value-wrap .spec-value {
  flex: 1;
}

.spec-copy {
  flex-shrink: 0;
  min-height: 48rpx;
  line-height: 48rpx;
  padding: 0 4rpx;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 0.04em;
}

.spec-copy-pressed {
  opacity: 0.72;
}

.plate-sparse-line {
  display: block;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(38, 35, 32, 0.9);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  letter-spacing: 0.02em;
}

.plate-metrics {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(38, 35, 32, 0.9);
}

.plate-metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.plate-metric-cap {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.1em;
}

.plate-metric-val {
  font-size: 28rpx;
  font-family: var(--font-mono);
  color: var(--color-text-body);
  font-variant-numeric: tabular-nums;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plate-metric-val.accent {
  color: var(--gold);
}

.signal-lamp.signal-sm {
  width: 8rpx;
  height: 8rpx;
}

.user-segment-row,
.d-segment-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.segment-name {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal-lamp {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-text-muted);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.signal-lamp.signal-idle {
  background: var(--color-text-muted);
  opacity: 0.85;
}

.signal-lamp.signal-active {
  background: #2D5A3F;
  box-shadow: 0 0 0 2rpx rgba(45, 90, 63, 0.35);
}

.signal-lamp.signal-brass {
  background: var(--gold);
  box-shadow: 0 0 0 2rpx rgba(196, 167, 108, 0.35);
}

.signal-lamp.signal-warning {
  background: #E9A23B;
  box-shadow: 0 0 0 2rpx rgba(233, 162, 59, 0.35);
}

.signal-lamp.signal-danger {
  background: var(--color-error);
  box-shadow: 0 0 0 2rpx rgba(214, 64, 69, 0.35);
}

.signal-lamp.is-pulse {
  animation: signal-pulse 1.8s ease-in-out infinite;
}

@keyframes signal-pulse {
  0%,
  100% {
    opacity: 0.55;
    transform: scale(0.88);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
  flex-shrink: 0;
}

.avatar.lg {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 1rpx solid #4D401A;
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-elevated);
  color: var(--gold);
  font-family: var(--font-brand);
  font-size: 36rpx;
  font-weight: 500;
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.empty-find.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: 16rpx;
}

.loading-hint,
.empty-find {
  padding: var(--space-6) var(--space-4);
  text-align: center;
}

.loading-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}

.empty-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.empty-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

/* drawer */

/* 弹层形态取 app.wxss 的 ui-pop-*（docs/弹层视觉规范_2026-10-13.md｜第 3 批 e）；
   这里只留本页尺寸与三段布局，底色 / 圆角 / 发丝边 / 进动画由零件提供。 */
.drawer {
  width: 100%;
  height: 88vh;
  max-height: 88vh;
  padding: var(--space-4) var(--space-4) 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.drawer-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
  flex-shrink: 0;
}

.drawer-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.drawer-close {
  font-size: 24rpx;
  color: var(--brass-400);
}

.drawer-body {
  flex-shrink: 0;
  width: 100%;
  height: calc(88vh - 220rpx);
  max-height: calc(88vh - 220rpx);
  min-height: 160rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.d-hero {
  margin-bottom: var(--space-5);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
}

.d-hero-top {
  display: flex;
  gap: var(--space-3);
  align-items: flex-start;
}

.d-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.d-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.d-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.d-level-chip {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-family: var(--font-mono);
  color: var(--brass-400);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-sm);
}

.d-level-chip.honor {
  color: var(--color-bg);
  background: var(--brass-400);
  border-color: var(--brass-400);
}

.d-hero-metrics {
  display: flex;
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1rpx solid rgba(77, 64, 26, 0.55);
}

.d-hero-metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.d-hero-cap {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.06em;
}

.d-hero-val {
  font-size: 26rpx;
  font-family: var(--font-mono);
  color: var(--color-text-body);
  font-variant-numeric: tabular-nums;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.d-hero-val.gold {
  color: var(--brass-400);
  font-weight: 600;
}

.info-rows {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
}

.info-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.info-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-body);
}

.info-value.mono {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.info-value.muted {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.stat-cell {
  width: calc(33.33% - 12rpx);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-2);
  box-sizing: border-box;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.stat-val {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.stat-val.mono-time {
  font-family: var(--font-mono);
  font-size: 22rpx;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-body);
}

.stat-val.gold {
  color: var(--brass-400);
  font-family: var(--font-mono);
}

.block {
  margin-bottom: var(--space-5);
  padding-bottom: var(--space-4);
  border-bottom: 1rpx solid rgba(38, 35, 32, 0.95);
}

.block.block-last {
  border-bottom: none;
  margin-bottom: 0;
}

.block-title {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.06em;
  margin-bottom: var(--space-3);
}

.block-body {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.55;
}

.block-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 12rpx;
}

.interest-tag {
  font-size: 22rpx;
  line-height: 1.4;
  color: #D4BC85;
  background: rgba(196, 167, 108, 0.12);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
}

.interest-tag.soft {
  color: var(--color-text-body);
  background: var(--color-bg-elevated);
  border-color: rgba(38, 35, 32, 0.9);
}

.tag-expand {
  margin-top: var(--space-3);
  font-size: 22rpx;
  color: var(--brass-400);
  letter-spacing: 0.04em;
}

.order-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.order-card-pressed {
  background: var(--color-bg-elevated);
}

.order-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.order-no {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-primary);
  font-family: var(--font-mono);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-400);
  font-weight: 500;
}

.order-card-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2);
}

.order-price {
  font-size: 26rpx;
  font-family: var(--font-mono);
  color: var(--brass-400);
  font-weight: 600;
}

.order-time {
  font-size: 22rpx;
  font-family: var(--font-mono);
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.drawer-footer-spacer {
  height: 24rpx;
}

.drawer-footer {
  flex-shrink: 0;
  padding: var(--space-3) 0 calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(26, 24, 20, 0) 0%, var(--color-bg) 28%);
}

.drawer-cta {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

/* modal */

.modal {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  margin-bottom: var(--space-2);
}

.modal-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
  margin-bottom: var(--space-3);
}

.modal-input {
  height: 80rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: 28rpx;
  margin-bottom: var(--space-4);
}

.modal-actions {
  display: flex;
  gap: var(--space-3);
}

.modal-actions .btn-outline,
.modal-actions .btn-primary {
  flex: 1;
}

.drawer-head-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.d-phone-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.d-phone-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.d-phone-val {
  font-size: 20rpx;
  font-family: var(--font-mono);
  color: var(--brass-300);
}

.d-phone-muted {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.youxin-modal .modal-title {
  margin-bottom: 0;
}

.youxin-head {
  margin-bottom: var(--space-2);
}

.youxin-sub {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  margin-top: 4rpx;
}

.youxin-portrait {
  margin-bottom: var(--space-3);
  padding: var(--space-2) var(--space-3);
  background: rgba(38, 35, 32, 0.55);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.youxin-portrait-line {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-body);
  line-height: 1.45;
}

.youxin-portrait-line.muted {
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.modal-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: 26rpx;
  margin-bottom: var(--space-3);
  box-sizing: border-box;
}

.youxin-ai-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.youxin-campaign-hint {
  font-size: 20rpx;
  color: var(--brass-600);
  letter-spacing: 0.08em;
}

.btn-outline.disabled,
.btn-primary.disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* ===== 数据概览（对齐藏品库 pstats） ===== */
.overview-panel {
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-4);
}

.overview-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.overview-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.overview-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
}

.overview-refresh {
  font-size: 22rpx;
  color: var(--brass-400);
  padding: 8rpx 0 0;
  flex-shrink: 0;
}

.sub-tab-row {
  display: flex;
  margin-bottom: var(--space-3);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 8rpx;
  border: 1rpx solid var(--color-border);
}

.sub-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.sub-tab.active {
  background: var(--color-bg-elevated);
  color: var(--brass-400);
}

.overview-loading {
  padding: var(--space-5) 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}

.overview-hint {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
  margin-bottom: var(--space-3);
}

.ov-cards {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.ov-card {
  width: calc(33.33% - 12rpx);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-2);
  box-sizing: border-box;
}

.ov-card.wide {
  width: calc(66.66% - 8rpx);
}

.ov-val {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  font-family: var(--font-mono);
  line-height: 1.2;
}

.ov-val.accent { color: var(--brass-400); }
.ov-val.muted { color: var(--color-text-secondary); }

.ov-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
}

.ov-section { margin-bottom: var(--space-2); }

.ov-sec-title {
  display: block;
  font-size: 22rpx;
  color: var(--brass-400);
  letter-spacing: 0.06em;
  margin-bottom: var(--space-2);
}

.ov-bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.ov-bar-label {
  width: 160rpx;
  font-size: 22rpx;
  color: var(--color-text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}

.ov-bar-track {
  flex: 1;
  height: 12rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.ov-bar-track.slim {
  height: 8rpx;
  margin: 8rpx 0 6rpx;
}

.ov-bar-fill {
  height: 100%;
  background: var(--brass-400);
  border-radius: var(--radius-full);
  min-width: 4rpx;
}

.ov-bar-count {
  width: 56rpx;
  text-align: right;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  font-family: var(--font-mono);
}

.ov-rank-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.ov-rank-no {
  width: 36rpx;
  font-size: 24rpx;
  color: var(--brass-400);
  font-family: var(--font-mono);
  font-weight: 600;
  padding-top: 8rpx;
  flex-shrink: 0;
}

.ov-rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
  flex-shrink: 0;
}

.ov-rank-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brass-400);
  font-family: var(--font-brand);
  font-size: 26rpx;
}

.ov-rank-main {
  flex: 1;
  min-width: 0;
}

.ov-rank-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ov-rank-name {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 55%;
}

.ov-rank-seg {
  font-size: 18rpx;
  /* 2026-09-21 分子级审计：#6B6560 在 --color-bg-elevated 上仅 2.72（AA 需 4.5）→ secondary（5.60） */
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
}

.ov-rank-seg.hv {
  color: var(--brass-300);
  background: rgba(196, 167, 108, 0.14);
}

.ov-rank-meta {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
}

.ov-empty {
  padding: var(--space-4) 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

/* ===== 会员注销（超管）===== */
.drawer-cta-row { display: flex; gap: 16rpx; align-items: center; }
.drawer-cta-row .drawer-cta { flex: 1; }

.danger-outline { border: 1rpx solid var(--color-error); color: var(--color-error); background: transparent; }
.btn-primary.btn-danger { background: var(--color-error); border-color: var(--color-error); color: #fff; }

.cancel-state-bar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx;
  background: rgba(214, 64, 69, 0.10);
  border: 1rpx solid rgba(214, 64, 69, 0.35);
}
.cancel-state-txt { font-size: 24rpx; color: #D64045; }

.cancel-modal { max-height: 84vh; }
.danger-title { color: #D64045; }
.cancel-target {
  margin: 8rpx 0 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx;
  background: var(--color-bg-card, rgba(255,255,255,0.04));
  border: 1rpx solid var(--color-border, rgba(196,167,108,0.2));
  display: flex; flex-direction: column;
}
.cancel-target-name { font-size: 30rpx; color: var(--color-text-primary, #E8E4DC); }
.cancel-target-sub { margin-top: 6rpx; font-size: 22rpx; color: var(--color-text-secondary, #A8A29A); }

.cancel-modes { display: flex; flex-direction: column; gap: 12rpx; margin: 10rpx 0 18rpx; }
.cancel-mode {
  padding: 16rpx 20rpx; border-radius: 12rpx;
  border: 1rpx solid var(--color-border, rgba(196,167,108,0.25));
  display: flex; flex-direction: column;
}
.cancel-mode.active { border-color: var(--gold, #C4A76C); background: rgba(196,167,108,0.10); }
.cancel-mode.danger-mode.active { border-color: #D64045; background: rgba(214,64,69,0.12); }
.cancel-mode-name { font-size: 26rpx; color: var(--color-text-primary, #E8E4DC); }
.cancel-mode.danger-mode .cancel-mode-name { color: #D64045; }
.cancel-mode-desc { margin-top: 6rpx; font-size: var(--fs-20); line-height: 1.5; color: var(--color-text-secondary, #A8A29A); }

.cancel-verify-title { margin-top: 6rpx; color: var(--gold, #C4A76C); }
.cancel-verify-hint { display: block; margin: 10rpx 0 6rpx; font-size: 22rpx; color: var(--color-text-secondary, #A8A29A); }

/* 已注销标记（列表项） */
.cancel-badge {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--color-error-on-tint);
  border: 1rpx solid rgba(214, 64, 69, 0.5);
  background: rgba(214, 64, 69, 0.10);
}
.cancel-badge.is-anon {
  color: var(--color-text-secondary, #A09A90);
  border-color: rgba(138, 132, 124, 0.5);
  background: rgba(138, 132, 124, 0.12);
}

