/* pages/detail/wiki-detail.wxss */
/* 继承 app.wxss */
page { background: #1A1814; color: #fff; }

/* 1. Header */
.hero-area { position: relative; height: 600rpx; width: 100%; }
.hero-img { width: 100%; height: 100%; }
.hero-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, transparent 40%, #1A1814 100%); }
.hero-text { position: absolute; bottom: 60rpx; left: 40rpx; right: 40rpx; z-index: 2; }

.latin-lg { font-family: "Times New Roman", serif; color: var(--gold); font-style: italic; font-size: 36rpx; display: block; margin-bottom: 10rpx; opacity: 0.9; }
.name-lg { font-size: 64rpx; color: #fff; font-weight: 900; display: block; text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.8); line-height: 1.1; }
.taxonomy-row { display: flex; align-items: center; margin-top: 20rpx; font-family: var(--font-din); font-size: 22rpx; color: #aaa; letter-spacing: 2rpx; text-transform: uppercase; }
.divider { margin: 0 10rpx; color: #444; }

.back-btn { 
  position: fixed; left: 30rpx; width: 72rpx; height: 72rpx; 
  background: rgba(0,0,0,0.4); backdrop-filter: blur(10px);
  border-radius: 50%; border: 1px solid rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; color: #fff; z-index: 100;
}

/* 2. 正文 */
.article-body { padding: 40rpx; background: #1A1814; min-height: 400rpx; }

.gallery-scroll { white-space: nowrap; margin-bottom: 50rpx; height: 240rpx; }
.g-img { width: 360rpx; height: 240rpx; border-radius: 12rpx; margin-right: 24rpx; display: inline-block; border: 1px solid #333; background: #111; }

.rich-text-container { color: #ccc; font-size: 30rpx; line-height: 1.8; text-align: justify; letter-spacing: 1rpx; }

/* 3. 关联藏品卡片 */
.commerce-float {
  margin: 40rpx 30rpx; padding: 30rpx;
  background: #1F1D1A; border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 20rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.5);
}
.commerce-title { margin-bottom: 30rpx; border-bottom: 1px solid #222; padding-bottom: 16rpx; display: flex; align-items: baseline; justify-content: space-between; }
.commerce-title text:first-child { font-family: var(--font-din); color: var(--gold); font-weight: bold; letter-spacing: 2rpx; font-size: 24rpx; }
.commerce-title .sub { color: #666; font-size: 22rpx; font-weight: bold; }

.product-card-mini { display: flex; align-items: center; margin-bottom: 24rpx; background: #1a1a1a; padding: 16rpx; border-radius: 12rpx; }
.product-card-mini:last-child { margin-bottom: 0; }
.p-thumb { width: 100rpx; height: 100rpx; border-radius: 8rpx; background: #1A1814; margin-right: 24rpx; border: 1px solid #333; flex-shrink: 0; }
.p-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.p-name { color: #fff; font-size: 26rpx; font-weight: bold; margin-bottom: 4rpx; }
.p-latin { color: #666; font-size: 20rpx; font-style: italic; margin-bottom: 6rpx; font-family: "Times New Roman"; }
.p-price { color: var(--gold); font-family: var(--font-din); font-size: 28rpx; font-weight: bold; }
.btn-buy { 
  background: #222; color: #ccc; font-size: 22rpx; padding: 8rpx 24rpx; 
  border-radius: 30rpx; border: 1px solid #444; font-weight: bold;
}

/* 在原 CSS 基础上追加 */
.intro-text {
  font-size: 32rpx; font-weight: 300; color: var(--gold); font-style: italic;
  margin-bottom: 40rpx; padding: 0 20rpx; border-left: 2rpx solid #444;
  line-height: 1.6;
}