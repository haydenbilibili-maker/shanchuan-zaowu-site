@import "../play-shared/ritual-play.wxss";

/* ══ 今日一签 · 标本签视觉（2026-10-15 质感第 5 轮）══════════════════════════
   蓝图 docs/马上有心愿签_重设计蓝图_2026-10-13.md §9「二期：今日一签页改标本签视觉」：
   入口来自「马上有 · 心愿签」底栏，两页必须是同一套语言 —— 博物黑、纸质标本签、发丝金、
   唯一实心金；**不再用铜铸签筒 / 门楣铆钉 / 朱红穗 / 舞台光晕**（蓝图 §1：庙会与金属元素是「老土」的根源）。
   只改本页样式（覆盖共享 ritual-play.wxss，其余玩法不受影响）；结构类名、事件、数据一律不动。 */

.rp-page {
  --paper: #F3ECDD;
  --paper-2: #E8DFCB;
  --ink: #2E2618;
  background: #151412;
}

/* ── 页头：眉标 + 主标（与心愿签「THE WALL / 心愿签墙」同口径），不再是一块铆钉铜匾 ── */
.rp-hero {
  padding: 28rpx 4rpx 24rpx;
  margin: var(--space-2) 0 24rpx;
  border: none;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: 0;
  background: none;
  box-shadow: none;
}

.rp-hero::before,
.rp-hero::after {
  display: none;
}

/* 字标：发丝方印（金字、透明底），不再是实心铜币 */
.rp-hero-mark {
  width: 64rpx;
  height: 64rpx;
  line-height: 62rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 500;
  color: var(--brass-300);
  background: none;
  border: 1rpx solid rgba(196, 167, 108, 0.6);
  border-radius: 4rpx;
  box-shadow: none;
}

.rp-hero.is-done .rp-hero-mark {
  background: rgba(196, 167, 108, 0.12);
  box-shadow: none;
}

.rp-hero-name {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 500;
  letter-spacing: 0.2em;
  color: var(--color-text-primary);
}

.rp-hero-state {
  color: var(--color-text-secondary);
}

.rp-hero.is-done .rp-hero-state {
  color: var(--brass-300);
}

/* ── 入口：一只玻璃标本瓶，里面插着纸签 ───────────────────────────
   展台 = 发丝框展柜 + 左上展签字 + 一道搁板线（原：双环光晕托盘 + 发光底脚） */
.rp-stage {
  min-height: 420rpx;
  padding: 72rpx 0 56rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(180deg, rgba(243, 236, 221, 0.025) 0%, transparent 60%);
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  box-shadow: none;
}

.rp-stage::before {
  content: 'DAILY LOT · 今日一签';
  left: 24rpx;
  top: 20rpx;
  width: auto;
  height: auto;
  margin: 0;
  border-radius: 0;
  background: none;
  box-shadow: none;
  font-family: var(--font-mono);
  font-size: var(--fs-16);
  letter-spacing: 0.3em;
  color: var(--brass-400);
}

.rp-stage.is-pending::before {
  animation: none;
}

/* 搁板：一道发丝线，瓶子站在上面 */
.rp-stage::after {
  bottom: 54rpx;
  width: 360rpx;
  height: 1rpx;
  margin-left: -180rpx;
  border-radius: 0;
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108, 0.5), transparent);
  box-shadow: none;
}

.rp-tube {
  position: relative;
  width: 168rpx;
  height: 230rpx;
  filter: drop-shadow(0 16rpx 18rpx rgba(0, 0, 0, 0.4));
}

/* 瓶身：透明玻璃（两侧折光 + 一道竖高光），签从玻璃里透出来 */
.rp-tube-body {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 168rpx;
  height: 188rpx;
  border-radius: 18rpx 18rpx 30rpx 30rpx;
  background: linear-gradient(90deg,
    rgba(250, 246, 237, 0.12) 0%,
    rgba(250, 246, 237, 0.03) 16%,
    rgba(250, 246, 237, 0) 50%,
    rgba(250, 246, 237, 0.03) 84%,
    rgba(250, 246, 237, 0.1) 100%);
  border: 1rpx solid rgba(250, 246, 237, 0.28);
  box-shadow: inset 0 -12rpx 20rpx rgba(0, 0, 0, 0.28);
  z-index: 3;
}

.rp-tube-body::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 22rpx;
  width: 6rpx;
  height: 112rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, rgba(250, 246, 237, 0.42), rgba(250, 246, 237, 0));
}

/* 瓶上贴一张小标本签：瓶子读成「馆藏」，不是庙里的签筒 */
.rp-tube-body::after {
  content: '今 日 一 签';
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-family: var(--font-brand);
  font-size: var(--fs-16);
  letter-spacing: 0.12em;
  color: var(--ink);
  background: linear-gradient(170deg, var(--paper), var(--paper-2));
  border: 1rpx solid rgba(138, 117, 48, 0.35);
  border-radius: 2rpx;
}

/* 瓶口：玻璃口沿（在签条之后，签从口里探出来） */
.rp-tube-mouth {
  position: absolute;
  left: -4rpx;
  top: 28rpx;
  width: 176rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.32);
  border: 1rpx solid rgba(250, 246, 237, 0.3);
  border-top: 2rpx solid rgba(250, 246, 237, 0.45);
  box-shadow: none;
  z-index: 0;
}

/* 签条：纸色（不是铜色），长到瓶底附近 —— 隔着玻璃也看得见 */
.rp-stick {
  position: absolute;
  left: 72rpx;
  top: 10rpx;
  width: 24rpx;
  height: 190rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(138, 117, 48, 0.28);
  opacity: 0.94;
  transform: translateY(-10rpx);
  z-index: 2;
}

.rp-stick.is-side {
  width: 16rpx;
  height: 160rpx;
  opacity: 0.6;
  transform: translateY(8rpx);
  z-index: 1;
}

.rp-stick.is-l { left: 48rpx; }
.rp-stick.is-r { left: 104rpx; }

/* 进行态：瓶在摇、签在升 —— 只在这里挂动画（入口静止） */
.rp-stage.is-pending .rp-tube {
  animation: rp-tube-shake 0.26s ease-in-out infinite;
}

.rp-stage.is-pending .rp-stick:not(.is-side) {
  animation: rp-stick-up 1000ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

.rp-stage.is-pending .rp-stick.is-side {
  animation: rp-stick-side 0.26s ease-in-out infinite;
}

@keyframes rp-tube-shake {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}

/* 先往下一沉（摇的蓄力）再升起：升出瓶口的那一截就是「抽中」 */
@keyframes rp-stick-up {
  0% { opacity: 0.94; transform: translateY(-10rpx); }
  18% { transform: translateY(2rpx); }
  100% { opacity: 1; transform: translateY(-84rpx); }
}

@keyframes rp-stick-side {
  0%, 100% { transform: translateY(8rpx) rotate(-2deg); }
  50% { transform: translateY(4rpx) rotate(2deg); }
}

.rp-hint {
  color: var(--color-text-secondary);
}

.rp-spin-text {
  color: var(--color-text-body);
}

/* ── 唯一实心金：与心愿签「写一张心愿签」同一颗胶囊钮 ── */
.rp-cta.is-primary,
.rp-act.is-primary {
  height: 92rpx;
  border-radius: 46rpx;
  color: #1A1814;
  font-size: var(--fs-30);
  letter-spacing: 0.12em;
  background: linear-gradient(155deg, #E6D3A1, var(--color-primary) 55%, #A8903C);
  border: none;
  box-shadow: none;
}

.rp-act.is-share {
  height: 88rpx;
  border-radius: 44rpx;
  color: var(--color-text-body);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  box-shadow: none;
}

/* ── 结果纸面：一张心愿标本签（与心愿签详情同一张纸）─────────────
   浅纸 + 内发丝框 + 顶上一枚铜别针；原竹签的横格线 / 竹节内阴影 / 朱红穗 / 旋转朱印全部退场。 */
.rp-paper {
  margin-top: 26rpx;
  padding: 40rpx 44rpx 40rpx;
  background: linear-gradient(170deg, var(--paper), var(--paper-2));
  border: none;
  border-radius: var(--radius-sm);
  color: var(--ink);
  box-shadow: 0 36rpx 80rpx rgba(0, 0, 0, 0.5);
}

.rp-paper::before {
  content: '';
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: auto;
  height: auto;
  margin: 0;
  background: none;
  border: 1rpx solid rgba(138, 117, 48, 0.35);
  border-radius: 0;
  box-shadow: none;
  pointer-events: none;
}

.rp-paper::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #F4ECD4, #A8903C 70%);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.4);
}

.rp-paper-grip-bar {
  background: rgba(138, 117, 48, 0.3);
}

.rp-paper-grip::after {
  color: #7C6E55;
}

/* 字标：发丝方印（铜字），不旋转、不着朱红 */
.rp-paper-mark {
  top: 30rpx;
  right: 32rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  transform: none;
  font-family: var(--font-brand);
  font-size: var(--fs-22);
  color: var(--brass-600);
  background: none;
  border: 1rpx solid rgba(138, 117, 48, 0.55);
  border-radius: 2rpx;
  box-shadow: none;
}

.rp-paper-overline {
  font-family: var(--font-brand);
  font-size: var(--fs-22);
  letter-spacing: 0.3em;
  color: #5A4A28;
}

.rp-paper-title {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  letter-spacing: 0.04em;
  margin-top: 0;
  text-align: center;
  color: var(--ink);
}

/* 宜 | 忌：标本签的两栏字段（上下发丝线 + 中间一道竖线），不再是两块底色格子 */
.rp-yi-ji {
  display: flex;
  align-items: stretch;
  margin-top: 28rpx;
  padding: 22rpx 0;
  gap: 0;
  border-top: 1rpx solid rgba(138, 117, 48, 0.3);
  border-bottom: 1rpx solid rgba(138, 117, 48, 0.3);
}

.rp-yi-ji .rp-paper-title,
.rp-yi-ji .rp-paper-sub {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  padding: 6rpx 10rpx;
  text-align: center;
  background: none;
  border: none;
  border-radius: 0;
  line-height: 1.25;
}

.rp-yi-ji .rp-paper-sub {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  letter-spacing: 0.04em;
  /* 忌：墨里带一点赭红，靠字色分宜忌（不铺底色块） */
  color: #6A3226;
}

.rp-yi-ji-rule {
  flex-shrink: 0;
  width: 1rpx;
  margin: 4rpx 0;
  background: rgba(138, 117, 48, 0.32);
}

.rp-paper-sub {
  padding-top: 10rpx;
  color: #5A4A28;
  border-top: 1rpx solid rgba(138, 117, 48, 0.24);
}

/* 签文：手写体（心愿签上写字的那支笔），居中 */
.rp-line {
  margin-top: 28rpx;
  font-family: var(--font-hand);
  font-size: var(--fs-34);
  line-height: 1.5;
  text-align: center;
  color: var(--ink);
}

.rp-note {
  margin-top: 24rpx;
  padding-top: 18rpx;
  text-align: center;
  color: #7C6E55;
  border-top: 1rpx solid rgba(138, 117, 48, 0.3);
}

/* 「带回墙上」：发丝框附注行，印记改发丝方印 */
.rp-return {
  margin-top: 28rpx;
  border-color: rgba(196, 167, 108, 0.3);
  border-radius: var(--radius-sm);
  background: none;
  box-shadow: none;
}

.rp-return-seal {
  width: 40rpx;
  height: 40rpx;
  border-radius: 4rpx;
  background: none;
  border: 1rpx solid rgba(196, 167, 108, 0.6);
  box-shadow: none;
}

.rp-return-seal-t {
  font-weight: 500;
  color: var(--brass-300);
}

.rp-return-text {
  color: var(--color-text-body);
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .rp-stage.is-pending .rp-tube,
  .rp-stage.is-pending .rp-stick.is-side {
    animation: none;
  }
}
