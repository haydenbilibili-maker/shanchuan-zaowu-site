/**
 * 玩法页共享样式（PRD v1.4 §11.4：玩法各开一页）。
 *
 * ═══════════════════════════════════════════════════════════════════
 * 2026-09-26「厅内展签」彻底焕新（v2 · 对齐祈福墙主页「厅·墙·签」）
 * 2026-09-26 晚「展厅骨架 v3」：门楣铆钉 / 展台托脚 / CTA 双线铜Rim / 回墙条更醒目
 *   —— 各玩法页只在自己的器物与纸面材质上不同，骨架同源。
 * ═══════════════════════════════════════════════════════════════════
 *
 * 为什么是一个共享 wxss 而不是多份：各玩法页**只该在"自己的表达"上不同**
 * （入口形态、进行态动画、结果纸面），布局骨架、动作按钮、推荐行、留档、补资料引导
 * 应当是同一套 —— 复制多份必然各自漂移（本仓错题本反复出现的形态）。
 */

.rp-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 var(--space-4) var(--space-6);
  /* 与祈福墙主页「厅顶灯龛」同气质 */
  background:
    radial-gradient(90% 42% at 50% -6%, rgba(212, 188, 133, 0.28), transparent 55%),
    radial-gradient(70% 36% at 12% 42%, rgba(196, 167, 108, 0.08), transparent 50%),
    radial-gradient(60% 40% at 88% 92%, rgba(122, 92, 44, 0.12), transparent 55%),
    linear-gradient(180deg, #12100E 0%, #0C0B09 48%, #0A0908 100%);
  animation: rp-page-in 520ms cubic-bezier(0.22, 0.82, 0.28, 1) both;
}

@keyframes rp-page-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ── 页头：展厅门楣（铜铸字标 + 匾名 + 四角铆钉） ───────────────── */
.rp-hero {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 30rpx 24rpx 26rpx;
  margin: var(--space-2) 0 14rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-xl);
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.08) 0%, transparent 40%),
    linear-gradient(165deg, rgba(212, 188, 133, 0.16) 0%, rgba(196, 167, 108, 0.03) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.12),
    0 12rpx 28rpx rgba(0, 0, 0, 0.26);
}

/* 四角铆钉：门楣读成「匾」而不是灰条 */
.rp-hero::after {
  content: '';
  position: absolute;
  inset: 10rpx;
  border-radius: calc(var(--radius-xl) - 4rpx);
  pointer-events: none;
  background:
    radial-gradient(circle at 8rpx 8rpx, rgba(196, 167, 108, 0.75) 0 3rpx, transparent 4rpx),
    radial-gradient(circle at calc(100% - 8rpx) 8rpx, rgba(196, 167, 108, 0.75) 0 3rpx, transparent 4rpx),
    radial-gradient(circle at 8rpx calc(100% - 8rpx), rgba(196, 167, 108, 0.55) 0 3rpx, transparent 4rpx),
    radial-gradient(circle at calc(100% - 8rpx) calc(100% - 8rpx), rgba(196, 167, 108, 0.55) 0 3rpx, transparent 4rpx);
  opacity: 0.9;
}

.rp-hero::before {
  content: '';
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108, 0.5), transparent);
  pointer-events: none;
  z-index: 1;
}

.rp-hero-mark {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  font-size: var(--fs-30);
  line-height: 76rpx;
  text-align: center;
  font-weight: 700;
  color: #2A220E;
  background: linear-gradient(145deg, #F0E2B8 0%, var(--brass-300) 42%, var(--brass-500) 78%, #8A7038 100%);
  border-radius: 50%;
  border: 1rpx solid rgba(107, 90, 36, 0.45);
  box-shadow:
    inset 0 2rpx 0 rgba(250, 246, 237, 0.55),
    0 6rpx 14rpx rgba(0, 0, 0, 0.28);
}

/* 今天已玩：字标外环 + 状态句再提亮（各页 wxml 挂 is-done） */
.rp-hero.is-done .rp-hero-mark {
  box-shadow:
    0 0 0 4rpx rgba(196, 167, 108, 0.42),
    inset 0 2rpx 0 rgba(250, 246, 237, 0.55);
}

.rp-hero.is-done .rp-hero-state {
  color: var(--brass-50);
}

.rp-hero-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.rp-hero-name {
  display: block;
  font-size: var(--fs-34);
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--brass-50);
}

.rp-hero-state {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-20);
  letter-spacing: 0.04em;
  color: rgba(224, 207, 163, 0.72);
}

/* ── 进行态 / 入口：托盘展台 + 底脚 ──────────────────────────────── */
.rp-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 380rpx;
  margin-top: 10rpx;
  padding: var(--space-3) 0 36rpx;
  border-radius: var(--radius-xl);
  background:
    radial-gradient(ellipse 70% 55% at 50% 52%, rgba(196, 167, 108, 0.12) 0%, transparent 70%);
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  box-shadow: inset 0 0 40rpx rgba(0, 0, 0, 0.2);
}

/* 舞台光晕：双环托盘 */
.rp-stage::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 48%;
  width: 360rpx;
  height: 360rpx;
  margin: -180rpx 0 0 -180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 188, 133, 0.22) 0%, rgba(196, 167, 108, 0.05) 42%, transparent 72%);
  box-shadow: 0 0 0 2rpx rgba(196, 167, 108, 0.14);
  pointer-events: none;
  z-index: 0;
}

.rp-stage::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  width: 200rpx;
  height: 10rpx;
  margin-left: -100rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, rgba(196, 167, 108, 0.45) 0%, transparent 72%);
  box-shadow: 0 0 0 1rpx rgba(196, 167, 108, 0.18);
  pointer-events: none;
  z-index: 0;
}

.rp-stage > view {
  position: relative;
  z-index: 1;
}

.rp-stage.is-pending::before {
  animation: rp-stage-glow 1.1s ease-in-out infinite;
}

@keyframes rp-stage-glow {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.08); }
}

.rp-hint {
  display: block;
  margin-top: var(--space-3);
  font-size: var(--fs-22);
  line-height: 1.6;
  text-align: center;
  letter-spacing: 0.04em;
  color: rgba(224, 207, 163, 0.72);
}

.rp-spin-text {
  display: block;
  margin-top: var(--space-3);
  font-size: var(--fs-24);
  letter-spacing: 0.14em;
  text-align: center;
  color: var(--brass-50);
  animation: rp-spin-pulse 1.2s ease-in-out infinite;
}

@keyframes rp-spin-pulse {
  0%, 100% { opacity: 0.72; }
  50% { opacity: 1; }
}

/* ── 主按钮（开始一次玩法）· 双线铜 Rim ─────────────────────────── */
.rp-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  margin-top: var(--space-3);
  font-size: var(--fs-26);
  font-weight: 600;
  border-radius: var(--radius-lg);
}

.rp-cta.is-primary {
  color: #2A220E;
  letter-spacing: 0.1em;
  background: linear-gradient(155deg, #F0E2B8 0%, var(--brass-300) 42%, var(--brass-500) 100%);
  border: 2rpx solid rgba(224, 207, 163, 0.62);
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.55),
    inset 0 0 0 3rpx rgba(122, 92, 44, 0.12),
    0 14rpx 28rpx rgba(0, 0, 0, 0.32);
}

.rp-cta.is-pending {
  color: var(--brass-200);
  letter-spacing: 0.08em;
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.48);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.12);
}

.rp-press {
  opacity: 0.86;
}

/* ── 结果：展签骨架（浅纸上的深字；各页纸面材质在页面 wxss） ── */
.rp-paper {
  position: relative;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 40rpx 32rpx 36rpx;
  border-radius: var(--radius-lg);
  box-shadow:
    0 0 0 1rpx rgba(250, 246, 237, 0.08),
    0 18rpx 42rpx rgba(0, 0, 0, 0.36);
  /* 入场用 opacity/margin，避开与 sheetDragY 的 transform 打架 */
  animation: rp-paper-in 480ms cubic-bezier(0.22, 0.82, 0.28, 1) both;
}

@keyframes rp-paper-in {
  from {
    opacity: 0;
    margin-top: 42rpx;
  }
  to {
    opacity: 1;
    margin-top: 18rpx;
  }
}

.rp-paper-grip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 36rpx;
  margin: -22rpx 0 12rpx;
}

.rp-paper-grip-bar {
  width: 84rpx;
  height: 6rpx;
  background: rgba(58, 50, 38, 0.3);
  border-radius: 999rpx;
}

.rp-paper-grip::after {
  content: '下拉收起';
  position: absolute;
  top: 28rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: var(--fs-16);
  letter-spacing: 0.14em;
  color: rgba(58, 50, 38, 0.42);
  pointer-events: none;
}

.rp-paper-mark {
  position: absolute;
  top: 26rpx;
  right: 28rpx;
  width: 58rpx;
  height: 58rpx;
  font-size: var(--fs-24);
  line-height: 58rpx;
  text-align: center;
  color: #7A2E24;
  border: 2rpx solid rgba(122, 46, 36, 0.55);
  border-radius: 8rpx;
}

.rp-paper-overline {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: rgba(58, 50, 38, 0.66);
  padding-right: 72rpx;
}

.rp-paper-title {
  display: block;
  margin-top: 14rpx;
  font-size: var(--fs-40);
  line-height: 1.28;
  color: #2A2418;
}

.rp-paper-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  color: rgba(58, 50, 38, 0.78);
}

.rp-line {
  display: block;
  margin-top: 18rpx;
  font-size: var(--fs-26);
  line-height: 1.68;
  color: #3A3226;
}

.rp-note {
  display: block;
  margin-top: 22rpx;
  padding-top: 18rpx;
  font-size: var(--fs-20);
  line-height: 1.58;
  color: rgba(58, 50, 38, 0.62);
  border-top: 1rpx solid rgba(42, 36, 24, 0.16);
}

/* ── 结果页动作（主 CTA 最上；分享同宽 + transparent） ─────────── */
.rp-return {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(165deg, rgba(212, 188, 133, 0.16) 0%, rgba(196, 167, 108, 0.04) 100%);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.08);
}

.rp-return-seal {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #F0E2B8 0%, var(--brass-400) 55%, var(--brass-600) 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.45);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.5);
}

.rp-return-seal-t {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: var(--fs-22);
  font-weight: 700;
  color: #2A220E;
}

.rp-return-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: rgba(224, 207, 163, 0.82);
}

.rp-acts {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  gap: 14rpx;
  margin-top: 16rpx;
}

.rp-act {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  height: 88rpx;
  font-size: var(--fs-26);
  font-weight: 600;
  border-radius: var(--radius-lg);
}

button.rp-act {
  display: flex !important;
  width: 100% !important;
  min-width: 100% !important;
  max-width: 100% !important;
  align-self: stretch !important;
  box-sizing: border-box !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1.3;
}

button.rp-act::after {
  border: none;
}

.rp-act.is-primary {
  color: #2A220E;
  letter-spacing: 0.08em;
  background: linear-gradient(155deg, #F0E2B8 0%, var(--brass-300) 42%, var(--brass-500) 100%);
  border: 1rpx solid rgba(224, 207, 163, 0.5);
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.55),
    0 12rpx 26rpx rgba(0, 0, 0, 0.28);
}

.rp-act.is-share {
  color: var(--brass-100);
  letter-spacing: 0.06em;
  font-weight: 500;
  /* 守卫钉住：次动作必须 transparent */
  background: transparent;
  border: 2rpx solid rgba(196, 167, 108, 0.58);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.12);
}

/* ── 祈运弱推：厅侧附注卡 ─────────────────────────────────────── */
.rp-reco {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 88rpx;
  box-sizing: border-box;
  margin-top: 34rpx;
  padding: 22rpx 20rpx 22rpx 18rpx;
  background:
    linear-gradient(165deg, rgba(212, 188, 133, 0.14) 0%, rgba(196, 167, 108, 0.04) 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.48);
  border-left: 6rpx solid rgba(212, 188, 133, 0.72);
  border-radius: var(--radius-lg);
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.22);
}

.rp-reco .rp-reco-thumb.is-live {
  border-color: rgba(196, 167, 108, 0.55);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.24);
}

.rp-reco-thumb {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  overflow: hidden;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  background: #1A1712;
  box-sizing: border-box;
}

.rp-reco-img {
  display: block;
  width: 100%;
  height: 100%;
}

.rp-reco-thumb-ph {
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 50% 42%, rgba(196, 167, 108, 0.28) 0%, rgba(196, 167, 108, 0.08) 55%, transparent 72%),
    linear-gradient(160deg, #2A241C 0%, #18150F 100%);
}

.rp-reco-copy {
  flex: 1;
  min-width: 0;
}

.rp-reco-label {
  display: block;
  font-size: var(--fs-18);
  letter-spacing: 0.08em;
  color: rgba(212, 188, 133, 0.9);
}

.rp-reco-why {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-18);
  letter-spacing: 0.04em;
  color: rgba(224, 207, 163, 0.55);
}

.rp-reco-title {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--fs-26);
  font-weight: 600;
  color: #F2EDE3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rp-reco-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-muted, #8A857C);
}

.rp-reco-skel {
  height: 34rpx;
  margin-top: 6rpx;
  border-radius: var(--radius-sm);
}

.rp-reco-go {
  flex-shrink: 0;
  margin-left: 4rpx;
  padding: 14rpx 20rpx;
  font-size: var(--fs-20);
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #2A220E;
  background: linear-gradient(150deg, #F0E2B8 0%, var(--brass-400) 48%, var(--brass-600) 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.4);
  border-radius: 999rpx;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.45);
}

/* ── 缺资料 ─────────────────────────────────────────────────── */
.rp-need {
  margin-top: var(--space-3);
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-xl);
  background: linear-gradient(165deg, rgba(196, 167, 108, 0.12) 0%, rgba(196, 167, 108, 0.04) 100%);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.06);
}

.rp-need-text {
  display: block;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-body);
}

.rp-need-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 22rpx;
  font-size: var(--fs-24);
  font-weight: 600;
  border-radius: var(--radius-lg);
}

.rp-need-cta.is-primary {
  color: #2A220E;
  background: linear-gradient(155deg, #F0E2B8 0%, var(--brass-300) 42%, var(--brass-500) 100%);
  border: 1rpx solid rgba(224, 207, 163, 0.5);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.45);
}

/* ── 「换一个」：不改 12/16 格布局结构 ──────────────────────────── */
.rp-variants {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 40rpx;
  padding: 22rpx 4rpx 4rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.22);
}

.rp-variant {
  padding: 30rpx 20rpx;
  min-width: 88rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: var(--fs-20);
  letter-spacing: 0.02em;
  color: rgba(224, 207, 163, 0.62);
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.05);
}

.rp-variant.is-on {
  color: #2A220E;
  font-weight: 700;
  background: linear-gradient(150deg, #F0E2B8 0%, var(--brass-400) 55%, var(--brass-500) 100%);
  border-color: var(--brass-300);
  box-shadow:
    0 0 0 3rpx rgba(196, 167, 108, 0.24);
}

/* ── 留档 ──────────────────────────────────────────────────── */
.rp-archive {
  margin-top: 32rpx;
  padding: 0 4rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.16);
}

.rp-archive-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  box-sizing: border-box;
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: var(--brass-100);
  padding: 22rpx 0;
  margin: 0;
  border-bottom: 1rpx solid transparent;
}

.rp-archive-toggle::after {
  content: '▾';
  flex-shrink: 0;
  margin-left: var(--space-2);
  font-size: var(--fs-18);
  color: rgba(196, 167, 108, 0.7);
  transition: transform 0.18s ease;
}

.rp-archive.is-open .rp-archive-toggle {
  border-bottom-color: rgba(196, 167, 108, 0.22);
}

.rp-archive.is-open .rp-archive-toggle::after {
  transform: rotate(180deg);
}

.rp-archive-list {
  margin-top: var(--space-2);
  padding: 4rpx 0 0;
}

.rp-archive-row {
  display: flex;
  gap: var(--space-2);
  padding: 18rpx 0;
  font-size: var(--fs-20);
  color: var(--color-text-muted, #8A857C);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.rp-archive-day {
  flex-shrink: 0;
  min-width: 11em;
  color: rgba(224, 207, 163, 0.68);
  font-family: var(--font-mono);
  font-size: var(--fs-18);
}

.rp-archive-what {
  flex: 1;
  min-width: 0;
  color: rgba(239, 230, 210, 0.88);
  line-height: 1.45;
}

.rp-archive-empty {
  display: block;
  margin-top: var(--space-2);
  padding: 18rpx 0 8rpx;
  font-size: var(--fs-20);
  text-align: center;
  color: rgba(224, 207, 163, 0.55);
}

/* ── 底部合规小字 ──────────────────────────────────────────── */
.rp-foot {
  display: block;
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  font-size: var(--fs-18);
  line-height: 1.6;
  letter-spacing: 0.04em;
  text-align: center;
  color: rgba(138, 133, 124, 0.78);
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}
