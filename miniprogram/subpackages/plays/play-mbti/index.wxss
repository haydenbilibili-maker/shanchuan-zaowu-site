@import "../play-shared/ritual-play.wxss";

/* ── MBTI 贴士：一根双极轴 ──────────────────────────────────────
   入口不是"一枚瓦片"：两端各一个极点，中间一枚游标；游标滑到哪侧就给哪侧的话。 */
.rp-axis {
  position: relative;
  width: 400rpx;
  height: 168rpx;
  filter: drop-shadow(0 10rpx 18rpx rgba(0, 0, 0, 0.3));
}

.rp-axis-line {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.28) 0%, rgba(212, 188, 133, 0.95) 50%, rgba(196, 167, 108, 0.28) 100%);
  border-radius: 2rpx;
}

.rp-axis-end {
  position: absolute;
  top: 62rpx;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.78);
  border-radius: 50%;
}

.rp-axis-end.is-left { left: 0; }
.rp-axis-end.is-right { right: 0; }

.rp-axis-knob {
  position: absolute;
  left: 176rpx;
  top: 58rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #F0E2B8 0%, var(--brass-400) 100%);
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.4);
}

/* 进行态：游标从中间滑向左极再回右侧停住（"对齐"的感觉） */
.rp-stage.is-pending .rp-axis-knob {
  animation: rp-knob-align 900ms cubic-bezier(0.3, 0.7, 0.3, 1) forwards;
}

@keyframes rp-knob-align {
  0% { transform: translateX(0); }
  38% { transform: translateX(-132rpx); }
  72% { transform: translateX(132rpx); }
  100% { transform: translateX(0); }
}

/* ── 结果纸面：一张类型卡（浅纸 + 顶部小轴 + 角饰）· v3 型号牌 ───── */
.rp-paper {
  position: relative;
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.7) 0%, transparent 22%),
    linear-gradient(180deg, #F9F3E6 0%, #E6DCC6 100%);
  border: 2rpx solid rgba(122, 92, 44, 0.44);
  border-radius: var(--radius-xl);
  box-shadow:
    0 20rpx 44rpx rgba(0, 0, 0, 0.36),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.65),
    inset 0 0 0 7rpx rgba(122, 92, 44, 0.06);
}

/* 四角金属饰：型号牌感（不改 16 格布局） */
.rp-paper::before,
.rp-paper::after {
  content: '';
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid rgba(122, 92, 44, 0.45);
  pointer-events: none;
}

.rp-paper::before {
  left: 14rpx;
  top: 14rpx;
  border-right: none;
  border-bottom: none;
}

.rp-paper::after {
  right: 14rpx;
  bottom: 14rpx;
  border-left: none;
  border-top: none;
}

/* 印章：钤印感（浅纸朱红） */
.rp-paper-mark {
  transform: rotate(7deg);
  color: #7A2E24;
  background: rgba(122, 46, 36, 0.07);
  border: 2rpx solid rgba(122, 46, 36, 0.62);
  box-shadow: inset 0 0 0 1rpx rgba(122, 46, 36, 0.28);
  font-family: var(--font-brand);
  letter-spacing: 0.06em;
}

.rp-axis-mini {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 40rpx;
  margin-top: 18rpx;
  gap: var(--space-1);
  margin-bottom: 6rpx;
  padding: 0 12rpx;
}

.rp-axis-mini-line {
  flex: 1;
  height: 3rpx;
  background: linear-gradient(90deg, rgba(58, 50, 38, 0.22) 0%, rgba(122, 46, 36, 0.55) 50%, rgba(58, 50, 38, 0.22) 100%);
  border-radius: 2rpx;
}

.rp-axis-mini-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.18);
}

.rp-axis-mini-dot.is-left {
  background: rgba(58, 50, 38, 0.5);
}

.rp-axis-mini-dot.is-right {
  background: rgba(122, 46, 36, 0.72);
}

.rp-paper-title {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  letter-spacing: 0.1em;
  text-align: center;
  margin-top: 18rpx;
  font-weight: 700;
}

.rp-line {
  text-align: center;
  margin-top: 18rpx;
  padding: 0 6rpx;
}

/* 轴两端极点：左铜 / 右朱，一眼两极（不改 16 格） */
.rp-axis-end {
  background: rgba(196, 167, 108, 0.12);
  box-shadow: 0 0 0 4rpx rgba(196, 167, 108, 0.1);
}

.rp-axis-end.is-left {
  background: rgba(196, 167, 108, 0.22);
  border-color: var(--brass-300);
  box-shadow: 0 0 0 5rpx rgba(196, 167, 108, 0.14);
}

.rp-axis-end.is-right {
  background: rgba(122, 46, 36, 0.28);
  border-color: rgba(122, 46, 36, 0.72);
  box-shadow: 0 0 0 5rpx rgba(122, 46, 36, 0.12);
}

.rp-axis-knob {
  border: 2rpx solid rgba(250, 246, 237, 0.35);
  /* 游标更像「可滑的钮」 */
  box-shadow:
    0 4rpx 10rpx rgba(0, 0, 0, 0.35),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.45);
}

/* 入口态：轴心下加极短说明带，不改布局骨架 */
.rp-stage .rp-axis::after {
  content: '';
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 18rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108, 0.35), transparent);
  pointer-events: none;
}

/* 结果小轴：右端朱点更醒目，呼应入口两极 */
.rp-axis-mini-dot.is-right {
  background: rgba(122, 46, 36, 0.82);
  box-shadow: 0 0 0 3rpx rgba(122, 46, 36, 0.12);
}

