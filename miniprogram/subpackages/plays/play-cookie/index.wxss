@import "../play-shared/ritual-play.wxss";

/* ── 拆签饼：一枚对半合拢的签饼 ───────────────────────────────────
   入口是"一件可以掰开的东西"：两半之间有一道缝，掰开才有纸条。 */
.rp-shell {
  position: relative;
  width: 260rpx;
  height: 200rpx;
  filter: drop-shadow(0 12rpx 20rpx rgba(0, 0, 0, 0.32));
}

.rp-shell-half {
  position: absolute;
  top: 22rpx;
  width: 126rpx;
  height: 156rpx;
  background: linear-gradient(160deg, #F0E2B8 0%, var(--brass-400) 55%, var(--brass-600) 100%);
  box-shadow:
    inset 0 4rpx 0 rgba(250, 246, 237, 0.45),
    0 8rpx 18rpx rgba(0, 0, 0, 0.26);
}

.rp-shell-half.is-left {
  left: 0;
  border-radius: 78rpx 10rpx 10rpx 78rpx;
}

.rp-shell-half.is-right {
  right: 0;
  border-radius: 10rpx 78rpx 78rpx 10rpx;
}

/* 饼面芝麻点：读成「可掰的饼」而不是铜胶囊 */
.rp-shell-half.is-left::before,
.rp-shell-half.is-right::before {
  content: '';
  position: absolute;
  inset: 22rpx 18rpx;
  border-radius: inherit;
  opacity: 0.55;
  pointer-events: none;
  background-image:
    radial-gradient(circle at 28% 32%, rgba(48, 40, 16, 0.35) 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 62% 48%, rgba(48, 40, 16, 0.3) 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 44% 68%, rgba(48, 40, 16, 0.28) 0 1.5rpx, transparent 2.5rpx),
    radial-gradient(circle at 72% 28%, rgba(48, 40, 16, 0.25) 0 2rpx, transparent 3rpx);
}

/* 缝：合拢时那道折痕（加宽，掰开前更醒目） */
.rp-shell-half.is-left::after,
.rp-shell-half.is-right::after {
  content: "";
  position: absolute;
  top: 14rpx;
  width: 3rpx;
  height: 112rpx;
  background: rgba(48, 40, 16, 0.62);
  box-shadow: 0 0 0 1rpx rgba(250, 246, 237, 0.12);
}

.rp-shell-half.is-left::after { right: 0; }
.rp-shell-half.is-right::after { left: 0; }

.rp-shell-slip {
  position: absolute;
  left: 96rpx;
  top: 50rpx;
  width: 68rpx;
  height: 104rpx;
  background: linear-gradient(180deg, #FAF6ED 0%, var(--brass-50) 100%);
  border: 1rpx solid rgba(122, 92, 44, 0.3);
  border-radius: 4rpx;
  opacity: 0.94;
  transform: translateY(-46rpx) scaleY(0.48);
  transform-origin: bottom center;
  z-index: 2;
}

.rp-shell-half {
  z-index: 1;
}

/* 进行态：两半分开、纸条露出来 */
.rp-stage.is-pending .rp-shell-half.is-left {
  animation: rp-shell-left 800ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

.rp-stage.is-pending .rp-shell-half.is-right {
  animation: rp-shell-right 800ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

.rp-stage.is-pending .rp-shell-slip {
  animation: rp-slip-out 800ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

@keyframes rp-shell-left {
  0% { transform: translateX(0) rotate(0deg); }
  100% { transform: translateX(-26rpx) rotate(-9deg); }
}

@keyframes rp-shell-right {
  0% { transform: translateX(0) rotate(0deg); }
  100% { transform: translateX(26rpx) rotate(9deg); }
}

@keyframes rp-slip-out {
  0% { opacity: 0.92; transform: translateY(-42rpx) scaleY(0.48); }
  100% { opacity: 1; transform: translateY(0) scaleY(1); }
}

/* ── 结果纸面：一张窄纸条（签条一句 + 轻建议一句）· v3 抽条 ──────── */
.rp-paper {
  position: relative;
  padding: 36rpx 28rpx 32rpx;
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.55) 0%, transparent 28%),
    linear-gradient(180deg, #F7F0E0 0%, #E6D9BE 100%);
  border: 1rpx solid rgba(122, 92, 44, 0.4);
  /* 窄纸条感：左右略收，相对签的宽纸更像「抽出来的那条」 */
  margin-left: 32rpx;
  margin-right: 32rpx;
  border-radius: 2rpx 2rpx 12rpx 12rpx;
  box-shadow:
    inset 0 16rpx 24rpx rgba(250, 246, 237, 0.42),
    inset 0 -1rpx 0 rgba(122, 92, 44, 0.12),
    0 16rpx 36rpx rgba(0, 0, 0, 0.32);
}

/* 撕口齿：一眼「抽出来的纸条」 */
.rp-paper::before {
  content: '';
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 0;
  height: 8rpx;
  background:
    radial-gradient(circle at 10% 0, transparent 4rpx, rgba(122, 92, 44, 0.18) 4.5rpx) 0 0 / 18rpx 8rpx repeat-x;
  opacity: 0.85;
  pointer-events: none;
}

/* 印章：钤印感（与签页同手法，字标不同） */
.rp-paper-mark {
  transform: rotate(8deg);
  color: #7A2E24;
  background: rgba(122, 46, 36, 0.07);
  border: 2rpx solid rgba(122, 46, 36, 0.62);
  box-shadow: inset 0 0 0 1rpx rgba(122, 46, 36, 0.28);
  font-family: var(--font-brand);
  letter-spacing: 0.06em;
}

.rp-paper-title {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: rgba(58, 50, 38, 0.62);
}

.rp-cookie-line {
  display: block;
  margin-top: 18rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  line-height: 1.42;
  color: #2A2418;
  letter-spacing: 0.06em;
  text-align: center;
}

.rp-cookie-advice {
  display: block;
  margin-top: 22rpx;
  padding: 16rpx 16rpx 16rpx 20rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: rgba(58, 50, 38, 0.82);
  border-left: 6rpx solid rgba(122, 92, 44, 0.58);
  background: rgba(122, 92, 44, 0.07);
  border-radius: 0 8rpx 8rpx 0;
}

/* 纸条把手比竹签更细，强化「抽条」而非「卷轴」 */
.rp-paper-grip-bar {
  width: 64rpx;
  height: 4rpx;
  background: rgba(58, 50, 38, 0.22);
}
