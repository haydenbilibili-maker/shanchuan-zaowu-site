@import "../play-shared/ritual-play.wxss";

/* ── 铜钱签：一枚方孔钱 ───────────────────────────────────────────
   入口是"一件会转定的器物"：外圆内方，转定才有一句。 */
.rp-coin {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  filter: drop-shadow(0 14rpx 24rpx rgba(0, 0, 0, 0.4));
}

.rp-coin-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    radial-gradient(circle at 32% 28%, rgba(250, 246, 237, 0.45) 0%, transparent 42%),
    radial-gradient(circle at 70% 72%, rgba(90, 60, 20, 0.35) 0%, transparent 50%),
    linear-gradient(145deg, #F0E2B8 0%, var(--brass-300) 38%, var(--brass-500) 72%, #7A6030 100%);
  box-shadow:
    inset 0 0 0 10rpx rgba(122, 92, 44, 0.28),
    inset 0 4rpx 0 rgba(250, 246, 237, 0.35),
    inset 0 -6rpx 14rpx rgba(0, 0, 0, 0.28);
}

.rp-coin-rim {
  position: absolute;
  inset: 14rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(90, 70, 30, 0.35);
  pointer-events: none;
}

.rp-coin-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 52rpx;
  height: 52rpx;
  margin: -26rpx 0 0 -26rpx;
  background: #0C0B09;
  border: 2rpx solid rgba(90, 70, 30, 0.55);
  box-shadow:
    inset 0 0 0 2rpx rgba(196, 167, 108, 0.25),
    0 0 0 3rpx rgba(122, 92, 44, 0.35);
  z-index: 2;
}

.rp-coin-char {
  position: absolute;
  left: 0;
  right: 0;
  top: 28rpx;
  text-align: center;
  z-index: 1;
}

.rp-coin-char::before {
  content: '钱';
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 700;
  letter-spacing: 0.12em;
  color: rgba(42, 34, 14, 0.72);
}

/* 进行态：翻转 + 微旋后落定 */
.rp-stage.is-pending .rp-coin {
  animation: rp-coin-spin 960ms cubic-bezier(0.22, 0.7, 0.28, 1) forwards;
}

@keyframes rp-coin-spin {
  0% { transform: rotateY(0deg) rotate(-8deg) scale(0.92); }
  45% { transform: rotateY(180deg) rotate(12deg) scale(1.06); }
  100% { transform: rotateY(360deg) rotate(-2deg) scale(1); }
}

/* ── 结果纸面：拓印笺（暖铜浅纸 + 面文大印）────────────────────── */
.rp-paper {
  background:
    radial-gradient(70% 50% at 50% 18%, rgba(196, 167, 108, 0.16) 0%, transparent 60%),
    linear-gradient(180deg, rgba(250, 246, 237, 0.55) 0%, transparent 26%),
    linear-gradient(165deg, #F6EED8 0%, #E8D9B4 55%, #DCC89A 100%);
  border: 2rpx solid rgba(122, 92, 44, 0.48);
  border-radius: var(--radius-md);
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.55),
    inset 0 0 0 8rpx rgba(122, 92, 44, 0.05),
    0 18rpx 40rpx rgba(0, 0, 0, 0.34);
  padding: 40rpx 34rpx 36rpx;
  text-align: center;
}

.rp-paper-mark {
  transform: rotate(10deg);
  color: #6A4A1C;
  background: rgba(122, 92, 44, 0.1);
  border: 2rpx solid rgba(122, 92, 44, 0.62);
  box-shadow: inset 0 0 0 1rpx rgba(122, 92, 44, 0.28);
  font-family: var(--font-brand);
  letter-spacing: 0.06em;
}

.rp-paper-overline {
  text-align: left;
}

.rp-coin-face {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 18rpx auto 8rpx;
}

.rp-coin-face-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #F0E2B8 0%, var(--brass-400) 55%, #8A7038 100%);
  box-shadow:
    inset 0 0 0 6rpx rgba(122, 92, 44, 0.22),
    0 6rpx 14rpx rgba(0, 0, 0, 0.18);
}

.rp-coin-face-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -14rpx;
  background: rgba(250, 246, 237, 0.92);
  border: 1rpx solid rgba(122, 92, 44, 0.35);
  z-index: 2;
}

.rp-coin-face-char {
  position: absolute;
  left: 0;
  right: 0;
  top: 14rpx;
  text-align: center;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #2A220E;
  z-index: 1;
}

.rp-paper-sub {
  margin-top: 4rpx;
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: rgba(58, 50, 38, 0.62);
  text-align: center;
}

.rp-coin-line {
  display: block;
  margin-top: 20rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  line-height: 1.5;
  letter-spacing: 0.04em;
  color: #2A2418;
}

.rp-coin-advice {
  display: block;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: rgba(58, 50, 38, 0.82);
  background: rgba(122, 92, 44, 0.08);
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(122, 92, 44, 0.16);
  text-align: left;
}

.rp-paper-grip-bar {
  background: rgba(122, 92, 44, 0.35);
}

.rp-note {
  text-align: left;
  border-top-color: rgba(122, 92, 44, 0.22);
}
