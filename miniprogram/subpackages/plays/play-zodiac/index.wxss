@import "../play-shared/ritual-play.wxss";

/* ── 星座签：一轮星盘 ────────────────────────────────────────────
   12 个格位（数据来自资料页那份常量，页面只画 12 个点）+ 一根指针；
   进行态 = 盘转、指针扫过一周。 */
.rp-wheel {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  filter: drop-shadow(0 14rpx 24rpx rgba(0, 0, 0, 0.4));
}

.rp-wheel-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 280rpx;
  height: 280rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.62);
  border-radius: 50%;
  background:
    repeating-conic-gradient(
      from -0.8deg,
      rgba(212, 188, 133, 0.65) 0deg 1.6deg,
      transparent 1.6deg 30deg
    );
  box-shadow:
    0 0 0 10rpx rgba(196, 167, 108, 0.1),
    0 10rpx 26rpx rgba(0, 0, 0, 0.4);
}

.rp-wheel-ring::after {
  content: '';
  position: absolute;
  inset: 36rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.32);
  border-radius: 50%;
  pointer-events: none;
}

.rp-wheel-hub {
  position: absolute;
  left: 126rpx;
  top: 126rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, var(--brass-100) 0%, var(--brass-500) 70%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
  z-index: 2;
}

.rp-dot {
  position: absolute;
  left: 132rpx;
  top: 132rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brass-50);
  box-shadow: 0 0 0 2rpx rgba(196, 167, 108, 0.4), 0 0 12rpx rgba(233, 190, 110, 0.6);
  transform-origin: 8rpx 8rpx;
}

.rp-wheel-needle {
  position: absolute;
  left: 137rpx;
  top: 36rpx;
  width: 5rpx;
  height: 130rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #FAF6ED 0%, var(--brass-400) 100%);
  transform-origin: 2.5rpx 104rpx;
  z-index: 1;
  box-shadow: none;
}

/* 针尖：一点铜滴，扫过时更像「指」 */
.rp-wheel-needle::before {
  content: '';
  position: absolute;
  left: -3rpx;
  top: -6rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brass-100);
  box-shadow: 0 0 8rpx rgba(233, 190, 110, 0.65);
}

/* 进行态：盘转 + 指针扫过 */
.rp-stage.is-pending .rp-wheel {
  animation: rp-wheel-spin 1100ms cubic-bezier(0.25, 0.7, 0.3, 1) forwards;
}

.rp-stage.is-pending .rp-wheel-needle {
  animation: rp-needle-sweep 1100ms cubic-bezier(0.25, 0.7, 0.3, 1) forwards;
}

@keyframes rp-wheel-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(180deg); }
}

@keyframes rp-needle-sweep {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(540deg); }
}

/* ── 结果纸面：一格星签（深色签面 + 铜字 + 星点）· v3 夜签 ──────── */
.rp-paper {
  position: relative;
  background:
    radial-gradient(2rpx 2rpx at 18% 22%, rgba(250, 246, 237, 0.55), transparent),
    radial-gradient(1.5rpx 1.5rpx at 72% 18%, rgba(224, 207, 163, 0.45), transparent),
    radial-gradient(2rpx 2rpx at 84% 48%, rgba(250, 246, 237, 0.4), transparent),
    radial-gradient(1.5rpx 1.5rpx at 28% 68%, rgba(196, 167, 108, 0.5), transparent),
    radial-gradient(80% 50% at 50% 0%, rgba(196, 167, 108, 0.18) 0%, transparent 55%),
    linear-gradient(180deg, #2A261F 0%, #161410 100%);
  border: 2rpx solid rgba(196, 167, 108, 0.52);
  border-radius: var(--radius-xl);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.08),
    0 20rpx 44rpx rgba(0, 0, 0, 0.42);
}

.rp-paper-overline {
  color: rgba(224, 207, 163, 0.8);
  letter-spacing: 0.12em;
}

.rp-paper-title {
  font-family: var(--font-brand);
  font-size: var(--fs-44);
  color: var(--brass-50);
  letter-spacing: 0.08em;
  margin-top: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid rgba(196, 167, 108, 0.28);
}

/* 深色签面上的印章：铜钤 + 微旋（shared 暗红是为浅纸定的） */
.rp-paper-mark {
  transform: rotate(-8deg);
  color: var(--brass-100);
  background: rgba(196, 167, 108, 0.12);
  border: 2rpx solid rgba(196, 167, 108, 0.68);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
  font-family: var(--font-brand);
  letter-spacing: 0.06em;
}

.rp-line {
  color: rgba(239, 230, 210, 0.92);
  margin-top: 16rpx;
}

.rp-note {
  color: rgba(224, 207, 163, 0.62);
  border-top-color: rgba(196, 167, 108, 0.22);
}

.rp-paper-grip-bar {
  background: rgba(224, 207, 163, 0.35);
}

.rp-paper-grip::after {
  color: rgba(224, 207, 163, 0.45);
}

/* 结果态下「换一个」：深页上芯片略提亮，选中仍实心铜 */
.rp-variant {
  color: rgba(239, 230, 210, 0.78);
  border-color: rgba(196, 167, 108, 0.32);
  background: rgba(196, 167, 108, 0.05);
}
