@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-body, #D5D1C8);
}

.page { min-height: 100vh; }

.container {
  padding: 0 var(--space-4, 32rpx) 80rpx;
  box-sizing: border-box;
}

.header { padding: var(--space-5, 40rpx) 0 var(--space-2, 16rpx); }
.brand-group { display: flex; flex-direction: column; }
.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600, #8A7530);
  text-transform: uppercase;
}
.brand-group .cn {
  font-family: var(--font-brand, Georgia, serif);
  font-size: 40rpx;
  color: var(--color-text-primary, #FFFFFF);
  margin-top: 6rpx;
}
.header-note {
  display: block;
  margin-top: var(--space-2, 16rpx);
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.5;
}

.preview {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: 16rpx;
}
.preview-label {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--brass-600, #8A7530);
  margin-bottom: 8rpx;
}
.preview-body {
  display: block;
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
  line-height: 1.5;
}
.preview-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  background: rgba(38, 35, 32, 0.8);
}

.section {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid rgba(38, 35, 32, 0.66);
  border-radius: 16rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.section-head .section-title { margin-bottom: 0; }

.section-sub {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 8rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--color-text-body);
}

.input.sm {
  width: 160rpx;
  height: 64rpx;
  padding: 0 16rpx;
  text-align: right;
  background: var(--color-bg-elevated);
  border-radius: 12rpx;
  color: var(--color-text-primary);
  font-size: 26rpx;
}

.form-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
}

.btn.primary {
  background: var(--gold);
  color: var(--color-bg);
}

.btn.ghost {
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  color: var(--gold);
}

.btn.disabled { opacity: 0.4; pointer-events: none; }

.tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.tabs {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  padding-bottom: 8rpx;
}

.tab {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.8);
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.tab.on {
  border-color: #4D401A;
  color: var(--gold);
  background: rgba(196, 167, 108, 0.08);
}

.intent-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(38, 35, 32, 0.8);
}

.intent-card:last-child { border-bottom: none; }

.intent-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.intent-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.35;
}

.intent-meta {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.intent-meta.overdue {
  color: #E9A23B;
}

.intent-actions {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
}

.chip-btn {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  color: var(--gold);
  font-size: 22rpx;
}

.chip-btn.danger {
  border-color: rgba(214, 64, 69, 0.55);
  color: #D64045;
}

.empty-tip {
  padding: 48rpx 16rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.empty-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.status-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.status-tag.brass {
  color: var(--gold);
  background: rgba(196, 167, 108, 0.12);
}

.status-tag.ok {
  color: #52B788;
  background: rgba(82, 183, 136, 0.12);
}

.status-tag.warn {
  color: #E9A23B;
  background: rgba(233, 162, 59, 0.12);
}

.status-tag.danger {
  color: #D64045;
  background: rgba(214, 64, 69, 0.12);
}

.status-tag.muted {
  color: var(--color-text-secondary);
  background: rgba(160, 154, 144, 0.12);
}
