<!-- 工作室账单 —— 门店 → 工作室货款
     超管：确认收款 / 撤回 / 作废；店长：标记已付款（只能本门店）
     服务端对每步独立判定；本页只不画按不动的按钮 -->
<view class="sb-page" wx:if="{{ready}}">
  <view class="sb-header">
    <text class="sb-title">工作室账单</text>
    <text class="sb-sub">{{noteText}}</text>
  </view>

  <view class="sb-summary">
    <view class="sb-sum-cell">
      <text class="sb-sum-label">未收款合计</text>
      <text class="sb-sum-value">{{outstandingText}}</text>
    </view>
    <view class="sb-sum-cell sb-sum-cell-right">
      <text class="sb-sum-label">{{list.length}} 张账单</text>
      <text class="sb-sum-hint">含「已付待确认」</text>
    </view>
  </view>

  <view class="sb-filters">
    <view
      class="sb-filter {{filter === item.value ? 'is-on' : ''}}"
      wx:for="{{filters}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onFilter"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="sb-tip is-{{tipTone}}" wx:if="{{tipText}}"><text>{{tipText}}</text></view>

  <view class="sb-loading" wx:if="{{busy && !list.length}}"><text>加载中…</text></view>
  <view class="sb-empty" wx:elif="{{!list.length}}">
    <text>没有账单</text>
    <text class="sb-empty-hint">超管可在出货单页勾选未结单据生成账单</text>
  </view>

  <view class="sb-list" wx:else>
    <view class="sb-card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="openBill">
      <view class="sb-card-head">
        <text class="sb-card-no">{{item.billNo}}</text>
        <text class="sb-tag is-{{item.tone}}">{{item.statusLabel}}</text>
      </view>
      <view class="sb-card-body">
        <text class="sb-card-store">{{item.storeName}}</text>
        <text class="sb-card-amount">{{item.totalText}}</text>
      </view>
      <view class="sb-card-foot">
        <text class="sb-card-meta">{{item.shipmentCount}} 张单 · {{item.totalQty}} 件</text>
        <text class="sb-card-meta">{{item.periodText}}</text>
      </view>
      <view class="sb-card-foot" wx:if="{{item.paidMarkedByName}}">
        <text class="sb-card-meta">门店标记：{{item.paidMarkedByName}}</text>
        <text class="sb-card-meta" wx:if="{{item.settledByName}}">收款：{{item.settledByName}}</text>
      </view>
    </view>
  </view>

  <!-- 详情 + 动作 -->
  <view class="sb-mask" wx:if="{{showDetail}}" bindtap="closeDetail"></view>
  <view class="sb-sheet" wx:if="{{showDetail && detail}}">
    <view class="sb-sheet-head">
      <text class="sb-sheet-title">{{detail.billNo}} · {{detail.storeName}}</text>
      <view class="sb-sheet-close" bindtap="closeDetail"><text>关闭</text></view>
    </view>

    <scroll-view class="sb-sheet-body" scroll-y>
      <view class="sb-detail-amount">
        <text class="sb-detail-label">应付货款</text>
        <text class="sb-detail-value">{{detail.totalText}}</text>
      </view>
      <view class="sb-detail-split">
        <view class="sb-split-cell"><text class="sb-split-label">材料</text><text class="sb-split-value">{{detail.materialText}}</text></view>
        <view class="sb-split-cell"><text class="sb-split-label">包装</text><text class="sb-split-value">{{detail.packagingText}}</text></view>
        <view class="sb-split-cell"><text class="sb-split-label">手工</text><text class="sb-split-value">{{detail.laborText}}</text></view>
      </view>
      <view class="sb-detail-meta">
        <text>账期 {{detail.periodText}}</text>
        <text wx:if="{{detail.laborRatePct !== null}}">本单手工费率 {{detail.laborRatePct}}%</text>
        <text>状态 {{detail.statusLabel}}</text>
        <text wx:if="{{detail.paidMarkedByName}}">门店标记人 {{detail.paidMarkedByName}}</text>
        <text wx:if="{{detail.paidNote}}">门店备注 {{detail.paidNote}}</text>
        <text wx:if="{{detail.settledByName}}">确认收款人 {{detail.settledByName}}</text>
      </view>

      <view class="sb-section-title"><text>纳入的出货单（{{detailFields.length}}）</text></view>
      <view class="sb-ship" wx:for="{{detailFields}}" wx:key="_id">
        <text class="sb-ship-no">{{item.shipmentNo}}</text>
        <text class="sb-ship-date">{{item.shipmentDate}}</text>
        <text class="sb-ship-qty">{{item.qtyText}}</text>
        <text class="sb-ship-amount">{{item.amountText}}</text>
      </view>
    </scroll-view>

    <view class="sb-actions">
      <!-- 店长（付款方）：标记已付款 -->
      <button
        wx:if="{{detail.canMarkPaid}}"
        class="sb-btn sb-btn-main"
        bindtap="onMarkPaid"
        disabled="{{busy}}"
      >标记已付款</button>

      <!-- 超管（收款方）：确认收款 / 撤回 / 作废 -->
      <button
        wx:if="{{isSuper && detail.canConfirmSettle}}"
        class="sb-btn sb-btn-main"
        bindtap="onConfirmSettle"
        disabled="{{busy}}"
      >确认收款（订单终结）</button>
      <button
        wx:if="{{isSuper && detail.status === 'paid_pending'}}"
        class="sb-btn sb-btn-ghost"
        bindtap="onWithdrawPaid"
        disabled="{{busy}}"
      >撤回「已付款」</button>
      <button
        wx:if="{{isSuper && detail.canVoid}}"
        class="sb-btn sb-btn-ghost"
        bindtap="onVoid"
        disabled="{{busy}}"
      >作废账单</button>

      <view class="sb-noop" wx:if="{{detail.status === 'settled'}}">
        <text>该账单已结清，相关出货单已终结</text>
      </view>
    </view>
  </view>
</view>
