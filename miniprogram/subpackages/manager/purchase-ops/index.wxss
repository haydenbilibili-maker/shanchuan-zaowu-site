@import '../utils/ops-museum.wxss';
@import '../utils/ops-dashboard.wxss';

.ops-field {
  margin-bottom: 24rpx;
}

.ops-field-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.ops-field-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  border-radius: 16rpx;
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
}

.batch-hint {
  font-size: 22rpx;
  color: var(--brass-300, #d4bc85);
}

.chip-btn {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #a09a90);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
}

.chip-btn.brass {
  color: var(--color-bg, #1a1814);
  background: var(--brass-400, #c4a76c);
  border-color: var(--brass-400, #c4a76c);
}

.ops-card.selected {
  border-color: var(--brass-400, #c4a76c);
}

.sync-body .sync-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.sync-body .sync-value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-family: var(--font-mono, monospace);
}

.sync-body .sync-msg,
.sync-body .sync-note {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.sync-body .ops-btn-primary {
  margin-top: 28rpx;
}
