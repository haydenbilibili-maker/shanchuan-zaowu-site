<view class="ops-boot" wx:if="{{!ready}}">柜门缓缓开启…</view>

<view class="ops-page" wx:if="{{ready}}">
  <view class="ops-container">
    <view class="ops-header compact">
      <text class="ops-eyebrow">AI · IDENTIFY MONITOR</text>
      <view class="ops-title-row">
        <text class="ops-title">AI 鉴定监测</text>
        <text class="ops-meta-chip" wx:if="{{loading || overviewLoading}}">刷新中</text>
      </view>
      <text class="ops-note">用户每次拍照鉴定的照片、识别结论与耗时。查看列表与详情会留存访问记录。</text>
    </view>

    <view class="ops-tip is-{{tipTone}}" wx:if="{{tipText}}">
      <text>{{tipText}}</text>
    </view>

    <view class="im-kpis" wx:if="{{overview}}">
      <view class="im-kpi">
        <text class="im-kpi-value">{{overview.todayTotal}}</text>
        <text class="im-kpi-label">今日次数</text>
      </view>
      <view class="im-kpi">
        <text class="im-kpi-value">{{overview.todayUsers}}</text>
        <text class="im-kpi-label">今日人数</text>
      </view>
      <view class="im-kpi">
        <text class="im-kpi-value">{{overview.weekSuccessRate}}</text>
        <text class="im-kpi-label">7 日成功率</text>
      </view>
      <view class="im-kpi">
        <text class="im-kpi-value">{{overview.weekTotal}}</text>
        <text class="im-kpi-label">7 日次数</text>
      </view>
      <view class="im-kpi">
        <text class="im-kpi-value">{{overview.weekUsers}}</text>
        <text class="im-kpi-label">7 日人数</text>
      </view>
      <view class="im-kpi">
        <text class="im-kpi-value">{{overview.total}}</text>
        <text class="im-kpi-label">累计</text>
      </view>
    </view>
    <view class="ops-skeleton" wx:elif="{{overviewLoading}}">
      <view class="ops-sk-card"><view class="ops-sk-line wide"></view><view class="ops-sk-line"></view></view>
    </view>
    <text class="im-since" wx:if="{{liveSinceText}}">逐次记录（含失败与复用）始于 {{liveSinceText}}；此前仅保留成功新建的鉴定{{overview.historyTotal ? '（' + overview.historyTotal + ' 条）' : ''}}。记录保留 180 天，到期自动删除。</text>
    <text class="im-since" wx:elif="{{overview}}">记录保留 180 天，到期自动删除。</text>

    <view class="im-filters">
      <view class="ops-filter-row">
        <view
          wx:for="{{rangeOptions}}"
          wx:key="id"
          class="ops-filter-chip {{range === item.id ? 'brass' : ''}}"
          data-id="{{item.id}}"
          bindtap="onRange"
        >{{item.label}}</view>
      </view>
      <view class="im-date-row">
        <picker mode="date" value="{{dateFrom}}" end="{{dateTo}}" bindchange="onDateFrom">
          <view class="im-date {{range === 'custom' ? 'on' : ''}}">{{dateFrom || '开始日期'}}</view>
        </picker>
        <text class="im-date-sep">至</text>
        <picker mode="date" value="{{dateTo}}" start="{{dateFrom}}" bindchange="onDateTo">
          <view class="im-date {{range === 'custom' ? 'on' : ''}}">{{dateTo || '结束日期'}}</view>
        </picker>
      </view>
      <view class="ops-filter-row">
        <view
          wx:for="{{statusOptions}}"
          wx:key="id"
          class="ops-filter-chip {{status === item.id ? 'brass' : ''}}"
          data-id="{{item.id}}"
          bindtap="onStatus"
        >{{item.label}}</view>
      </view>
      <view class="ops-search-row">
        <input
          class="ops-search-input"
          placeholder="用户：手机号 / 昵称"
          placeholder-class="ops-ph"
          value="{{userInput}}"
          confirm-type="search"
          bindinput="onUserInput"
          bindconfirm="onUserSearch"
        />
        <view class="ops-chip-btn brass" bindtap="onUserSearch">筛选</view>
      </view>
      <view class="im-user-chip" wx:if="{{userFilter}}" bindtap="onClearUser">
        <text>只看：{{userFilterLabel}}</text>
        <text class="im-user-chip-x">清除</text>
      </view>
    </view>

    <view class="ops-skeleton" wx:if="{{loading && !list.length}}">
      <view class="ops-sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="ops-sk-line wide"></view>
        <view class="ops-sk-line"></view>
      </view>
    </view>

    <view class="ops-empty is-error" wx:elif="{{loadError}}">
      <text class="ops-empty-title">鉴定记录未能取回</text>
      <text class="ops-empty-sub">{{loadError}}</text>
      <view class="ops-btn-secondary im-retry" bindtap="loadList" data-reset="1">重试</view>
    </view>

    <view class="ops-empty" wx:elif="{{!list.length}}">
      <text class="ops-empty-title">这个范围内还没有鉴定</text>
      <text class="ops-empty-sub">新的鉴定会从上线起逐次记录（含失败与复用）。换个日期范围，或清除用户筛选再看。记录保留 180 天。</text>
    </view>

    <block wx:else>
      <text class="im-count">共 {{total}} 次</text>
      <view class="im-row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
        <view class="im-thumb-wrap">
          <image
            wx:if="{{item.thumb}}"
            class="im-thumb"
            src="{{item.thumb}}"
            mode="aspectFill"
            lazy-load
            data-idx="{{index}}"
            binderror="onThumbError"
          />
          <view class="im-thumb im-thumb-empty" wx:else><text>无图</text></view>
        </view>
        <view class="im-row-main">
          <view class="im-row-top">
            <text class="im-row-title">{{item.title}}</text>
            <text class="ops-status {{item.statusTone}}">{{item.statusLabel}}</text>
          </view>
          <text class="im-row-sub" wx:if="{{item.latin || item.confidence}}">{{item.latin}}{{item.latin && item.confidence ? ' · ' : ''}}{{item.confidence ? '置信 ' + item.confidence : ''}}</text>
          <text class="im-row-err" wx:if="{{item.errorMsg}}">{{item.errorMsg}}</text>
          <text
            class="im-row-user"
            catchtap="onFilterByUser"
            data-openid="{{item.openid}}"
            data-label="{{item.userText}}"
          >{{item.userText}}</text>
          <text class="im-row-meta">{{item.timeText}}{{item.entryLabel ? ' · ' + item.entryLabel : ''}}{{item.isHistory ? ' · 上线前' : ''}}</text>
        </view>
      </view>
      <view class="im-more" wx:if="{{hasMore}}">{{loadingMore ? '正在加载…' : '上滑加载更多'}}</view>
      <view class="im-more" wx:else>已到底</view>
    </block>
  </view>
</view>

<view class="im-mask" wx:if="{{detail}}" bindtap="closeDetail" catchtouchmove="noop"></view>
<view class="im-sheet" wx:if="{{detail}}">
  <view class="im-sheet-head">
    <text class="im-sheet-title">鉴定详情</text>
    <text class="im-sheet-close" bindtap="closeDetail">关闭</text>
  </view>
  <scroll-view scroll-y class="im-sheet-body">
    <view class="ops-skeleton" wx:if="{{detailLoading}}">
      <view class="ops-sk-card"><view class="ops-sk-line wide"></view><view class="ops-sk-line"></view></view>
    </view>
    <view class="ops-empty is-error" wx:elif="{{detailError}}">
      <text class="ops-empty-title">详情未能取回</text>
      <text class="ops-empty-sub">{{detailError}}</text>
    </view>
    <block wx:else>
      <image wx:if="{{detail.imageUrl}}" class="im-hero" src="{{detail.imageUrl}}" mode="aspectFit" bindtap="previewImage" />
      <view class="im-hero im-thumb-empty" wx:else><text>照片不可用</text></view>
      <text class="im-hint" wx:if="{{detail.imageUrl}}">点图可放大查看</text>

      <view class="im-block">
        <view class="im-row-top">
          <text class="im-detail-title">{{detail.title}}</text>
          <text class="ops-status {{detail.statusTone}}">{{detail.statusLabel}}</text>
        </view>
        <text class="im-row-sub" wx:if="{{detail.latin || detail.english}}">{{detail.latin}}{{detail.latin && detail.english ? ' · ' : ''}}{{detail.english}}</text>
        <text class="im-row-sub" wx:if="{{detail.confidence}}">置信度 {{detail.confidence}}</text>
        <text class="im-note" wx:if="{{detail.reuseText}}">{{detail.reuseText}}</text>
        <text class="im-row-err" wx:if="{{detail.errorMsg}}">失败原因：{{detail.errorMsg}}</text>
      </view>

      <view class="im-block">
        <view class="im-kv"><text class="im-k">用户</text><text class="im-v link" bindtap="onFilterByUser" data-openid="{{detail.openid}}" data-label="{{detail.userText}}">{{detail.userText}}</text></view>
        <view class="im-kv"><text class="im-k">时间</text><text class="im-v">{{detail.timeText}}</text></view>
        <view class="im-kv"><text class="im-k">耗时</text><text class="im-v">{{detail.durationText}}</text></view>
        <view class="im-kv"><text class="im-k">入口</text><text class="im-v">{{detail.entryLabel}}</text></view>
        <view class="im-kv"><text class="im-k">类别提示</text><text class="im-v">{{detail.categoryHint}}</text></view>
        <view class="im-kv"><text class="im-k">模型</text><text class="im-v">{{detail.modelText}}</text></view>
        <view class="im-kv" wx:if="{{detail.flags}}"><text class="im-k">后续</text><text class="im-v">{{detail.flags.isBookmarked ? '已入图鉴' : '未入图鉴'}} · {{detail.flags.isShared ? '已分享' : '未分享'}}{{detail.flags.reuseCount ? ' · 再次鉴定 ' + detail.flags.reuseCount + ' 次' : ''}}</text></view>
        <text class="im-note" wx:if="{{detail.isHistory}}">上线前的记录：只有成功结果，没有耗时与模型信息。</text>
      </view>

      <view class="im-block" wx:if="{{detail.brief || detail.taxonomy.length || detail.alternatives.length}}">
        <text class="im-block-title">识别结论</text>
        <text class="im-para" wx:if="{{detail.brief}}">{{detail.brief}}</text>
        <view class="im-taxa" wx:if="{{detail.taxonomy.length}}">
          <text class="ops-chip" wx:for="{{detail.taxonomy}}" wx:key="label">{{item.label}} {{item.value}}</text>
        </view>
        <text class="im-row-sub" wx:if="{{detail.alternatives.length}}">备选：<text wx:for="{{detail.alternatives}}" wx:key="*this">{{index ? '、' : ''}}{{item}}</text></text>
      </view>

      <view class="im-block" wx:if="{{detail.aiSections.length}}">
        <text class="im-block-title">完整解读</text>
        <view class="im-sec" wx:for="{{detail.aiSections}}" wx:key="label">
          <text class="im-sec-label">{{item.label}}</text>
          <text class="im-para">{{item.text}}</text>
        </view>
      </view>

      <view class="im-block" wx:if="{{detail.products.length}}">
        <text class="im-block-title">匹配藏品</text>
        <view class="im-prod" wx:for="{{detail.products}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct">
          <image wx:if="{{item.cover}}" class="im-prod-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <view class="im-prod-img im-thumb-empty" wx:else></view>
          <text class="im-prod-title">{{item.title}}</text>
          <text class="im-prod-price">{{item.priceText}}</text>
        </view>
      </view>

      <view class="im-block" wx:if="{{detail.feedback.length}}">
        <text class="im-block-title">用户纠错</text>
        <view class="im-sec" wx:for="{{detail.feedback}}" wx:key="timeText">
          <text class="im-sec-label">改为「{{item.name}}」 · {{item.timeText}}</text>
          <text class="im-para" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
