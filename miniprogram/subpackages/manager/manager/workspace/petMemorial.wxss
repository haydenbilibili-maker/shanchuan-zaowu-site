/* 工单 → 伴宠（petMemorialCards.wxml / petMemorialSheet.wxml）
   按钮统一：高 76rpx、圆角 16rpx、间距 16rpx；文字一律不折行（white-space: nowrap），
   靠 flex 等分铺满、放不下时整颗换到下一行（min-width），不靠压窄按钮。 */

.pm-card .card-top { align-items: center; }
.pm-status { flex-shrink: 0; font-size: var(--fs-24); font-weight: 600; white-space: nowrap; padding: 4rpx 16rpx; border-radius: 999rpx; border: 1rpx solid rgba(196, 167, 108, 0.45); color: var(--color-primary); }
.pm-status.tone-wait { border-color: rgba(255, 255, 255, 0.16); color: var(--color-text-body, #D5D1C8); }
.pm-status.tone-doing { border-color: rgba(196, 167, 108, 0.3); color: var(--color-text-body, #D5D1C8); }
.pm-status.tone-done { border-color: rgba(255, 255, 255, 0.12); color: var(--color-text-secondary, #A09A90); }
.pm-status.tone-closed { border-color: rgba(255, 255, 255, 0.12); color: var(--color-text-secondary, #A09A90); }
.pm-card.is-closed { border-color: rgba(255, 255, 255, 0.03); }

.pm-divider { display: flex; align-items: center; margin: 12rpx 0 24rpx; font-size: var(--fs-24); color: var(--color-text-secondary, #A09A90); }
.pm-divider::before, .pm-divider::after { content: ''; flex: 1; height: 1rpx; background: rgba(255, 255, 255, 0.08); }
.pm-divider text { padding: 0 20rpx; letter-spacing: 4rpx; }

.pm-note { margin-top: 16rpx; padding: 20rpx 24rpx; border-radius: var(--radius-md); background: rgba(196, 167, 108, 0.08); border: 1rpx solid rgba(196, 167, 108, 0.2); }
.pm-note.is-decline { background: rgba(255, 255, 255, 0.04); border-color: rgba(255, 255, 255, 0.1); }
.pm-note-k { display: block; font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); margin-bottom: 8rpx; }
.pm-note-v { display: block; font-size: var(--fs-26); line-height: 1.6; color: var(--color-text-body, #D5D1C8); white-space: pre-wrap; word-break: break-all; }

.pm-meta { display: flex; align-items: center; justify-content: space-between; margin: 20rpx 0 4rpx; padding: 16rpx 20rpx; border-radius: var(--radius-md); background: #222; }
.pm-time { font-size: var(--fs-24); color: var(--color-text-secondary, #A09A90); }
.pm-tool { flex-shrink: 0; font-size: var(--fs-24); color: var(--color-text-secondary, #A09A90); white-space: nowrap; padding: 8rpx 0 8rpx 24rpx; }

.pm-actions { margin-top: 20rpx; }
.pm-act-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; }
.pm-actions .pm-act-row + .pm-btn { margin-top: 16rpx; }
.pm-btn {
  box-sizing: border-box; height: 76rpx; padding: 0 20rpx; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-26); font-weight: 600; letter-spacing: 1rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pm-act-row .pm-btn { flex: 1 1 0; min-width: 168rpx; }
.pm-btn.main { background: var(--color-primary); color: var(--color-bg); border: 1rpx solid var(--color-primary); }
.pm-btn.sub { background: transparent; color: var(--color-primary); border: 1rpx solid rgba(196, 167, 108, 0.5); }
.pm-btn.quiet { background: transparent; color: var(--color-text-secondary, #A09A90); border: 1rpx solid rgba(255, 255, 255, 0.14); }
.pm-btn.is-busy { opacity: 0.6; }
.pm-wait { flex: 2 1 0; min-width: 200rpx; font-size: var(--fs-24); color: var(--color-text-secondary, #A09A90); white-space: nowrap; }

.pm-sheet-body { padding: 24rpx 32rpx 8rpx; }
.pm-sheet-order { display: block; font-size: var(--fs-24); color: var(--color-text-secondary, #A09A90); margin-bottom: 24rpx; }
.pm-sheet-label { display: block; font-size: var(--fs-24); color: var(--color-text-secondary, #A09A90); margin-bottom: 16rpx; }
.pm-chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.pm-chip { max-width: 100%; box-sizing: border-box; padding: 12rpx 22rpx; border-radius: 999rpx; font-size: var(--fs-24); line-height: 1.4; color: var(--color-text-body, #D5D1C8); background: rgba(255, 255, 255, 0.04); border: 1rpx solid rgba(196, 167, 108, 0.3); }
.pm-sheet-input { box-sizing: border-box; width: 100%; height: 200rpx; padding: 20rpx 24rpx; border-radius: var(--radius-md); background: #222; border: 1rpx solid rgba(255, 255, 255, 0.08); font-size: var(--fs-28); line-height: 1.6; color: #fff; }
.pm-sheet-input.has-error { border-color: rgba(196, 167, 108, 0.8); }
.pm-sheet-ph { color: var(--color-text-secondary, #A09A90); }
.pm-sheet-foot-line { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 12rpx; min-height: 36rpx; }
.pm-sheet-hint, .pm-sheet-error { flex: 1; font-size: var(--fs-22); line-height: 1.5; padding-right: 16rpx; }
.pm-sheet-hint { color: var(--color-text-secondary, #A09A90); }
.pm-sheet-error { color: var(--color-primary); }
.pm-sheet-count { flex-shrink: 0; font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); }
.pm-sheet-actions { display: flex; gap: 16rpx; }
.pm-sheet-actions .pm-btn { flex: 1 1 0; }
.pm-sheet-actions .pm-btn.main { flex: 2 1 0; }
