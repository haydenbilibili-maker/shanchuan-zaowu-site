/* 活动课程看板（2026-09-28）：_subviews.wxml 的 [Tab 7] 与「活动编辑面板」 */
.act-head{display:flex;align-items:flex-end;justify-content:space-between;margin:8rpx 0 24rpx}
.act-head-l,.act-main,.act-stale-txt,.act-f,.act-kpi,.act-stat,.act-state{display:flex;flex-direction:column}
.act-en{font-size:var(--fs-20);letter-spacing:4rpx;color:var(--color-primary)}
.act-cn{font-size:var(--fs-40);font-weight:600;color:#fff;margin-top:6rpx}
.act-new{padding:16rpx 28rpx;border-radius:999rpx;background:var(--color-primary);color:#1A1814;font-size:var(--fs-26);font-weight:600}
.act-new:active,.act-state-btn:active,.act-op:active,.act-stale-btn:active{opacity:.75}
.act-skel{height:260rpx;margin-bottom:20rpx;border-radius:var(--radius-lg);background:var(--color-bg-card)}
.act-state{align-items:center;padding:72rpx 32rpx;margin-bottom:20rpx;border-radius:var(--radius-lg);border:1px dashed #3A352E}
.act-state-t{font-size:var(--fs-30);color:var(--color-text-body)}
.act-state-d,.act-stale-d,.act-kpi-l,.act-stat-l,.act-wk,.act-line,.act-note,.act-f-l{font-size:var(--fs-22);color:var(--color-text-secondary)}
.act-state-d{margin-top:12rpx;text-align:center;line-height:1.6}
.act-state-btn{margin-top:32rpx;padding:16rpx 48rpx;border-radius:999rpx;border:1rpx solid var(--color-primary);color:var(--color-primary);font-size:var(--fs-26)}
.act-kpis{display:flex;gap:16rpx;margin-bottom:20rpx}
.act-kpi,.act-tabs,.act-card{background:var(--color-bg-card);border:1px solid var(--color-bg-elevated)}
.act-kpi{flex:1;padding:22rpx 24rpx;border-radius:18rpx}
.act-kpi-n{font-family:var(--font-mono);font-size:var(--fs-44);color:var(--color-primary);line-height:1.1}
.act-kpi-l,.act-stale-d{margin-top:8rpx}
.act-stale{display:flex;align-items:center;gap:20rpx;padding:22rpx 24rpx;margin-bottom:20rpx;border-radius:var(--radius-md);background:rgba(214,64,69,.1);border:1px solid rgba(214,64,69,.35)}
.act-stale-txt{flex:1;min-width:0}
.act-stale-t,.act-warn,.act-f-err,.act-err{color:#F2B8B5}
.act-stale-t{font-size:var(--fs-26)}
.act-stale-btn{flex-shrink:0;padding:12rpx 24rpx;border-radius:999rpx;border:1px solid #E07A76;color:#F2B8B5;font-size:var(--fs-24)}
.act-stale-btn.is-confirm,.act-op.is-confirm{background:#B8323A;border-color:#B8323A;color:#fff}
.act-tabs{display:flex;padding:6rpx;margin-bottom:20rpx;border-radius:16rpx}
.act-tab{flex:1;text-align:center;padding:16rpx 0;border-radius:var(--radius-md);font-size:var(--fs-24);color:var(--color-text-secondary);white-space:nowrap}
.act-tab.on{background:var(--color-bg-elevated);color:var(--color-primary);font-weight:600}
.act-card{padding:24rpx;margin-bottom:20rpx;border-radius:20rpx}
.act-card.is-ended{opacity:.72}
.act-card-top,.act-stats,.act-ops,.act-f2,.act-seg{display:flex;gap:20rpx}
.act-date{flex-shrink:0;width:104rpx;height:112rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:var(--radius-md);border:1px solid #4D401A}
.act-date.is-today{background:var(--color-primary);border-color:var(--color-primary)}
.act-md{font-family:var(--font-mono);font-size:var(--fs-30);color:#fff}
.act-wk{margin-top:6rpx}
.act-date.is-today .act-md,.act-date.is-today .act-wk{color:#1A1814}
.act-main{flex:1;min-width:0}
.act-title,.act-line{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.act-title{font-size:var(--fs-30);font-weight:600;color:#fff}
.act-meta{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;margin-top:10rpx}
.act-status,.act-chip{font-size:var(--fs-20);padding:4rpx 12rpx;border-radius:8rpx}
.act-status.is-live{background:rgba(82,183,136,.16);color:#7FD1A8}
.act-status.is-paused{background:rgba(196,167,108,.16);color:#D4BC85}
.act-status.is-ended{background:#2E2B27;color:#A09A90}
.act-chip{border:1px solid #3A352E;color:var(--color-text-secondary)}
.act-when{font-size:var(--fs-22);color:var(--color-primary)}
.act-line{margin-top:10rpx}
.act-cover{flex-shrink:0;width:112rpx;height:112rpx;border-radius:14rpx}
.act-stats{gap:0;margin-top:22rpx;padding-top:20rpx;border-top:1px solid var(--color-bg-elevated)}
.act-stat{flex:1;align-items:center}
.act-stat-n{font-family:var(--font-mono);font-size:var(--fs-30);color:#fff}
.act-stat-n.is-gold{color:var(--color-primary)}
.act-stat-l{margin-top:6rpx}
.act-bar{height:6rpx;margin-top:18rpx;border-radius:var(--radius-sm);background:var(--color-bg-elevated);overflow:hidden}
.act-bar-in{height:100%;background:var(--color-primary)}
.act-warn{display:block;margin-top:16rpx;padding:12rpx 16rpx;border-radius:var(--radius-sm);font-size:var(--fs-22);line-height:1.5;background:rgba(214,64,69,.1)}
.act-ops{gap:12rpx;margin-top:20rpx}
.act-op{flex:1;text-align:center;padding:14rpx 0;border-radius:var(--radius-md);border:1px solid #3A352E;font-size:var(--fs-24);color:var(--color-text-body);white-space:nowrap}
.act-op.is-danger{color:#E8908C}
.act-op.is-confirm{flex:2.4}
.act-note{display:block;margin:8rpx 8rpx 40rpx;line-height:1.6}
.act-f{flex:1;min-width:0;margin-bottom:28rpx}
.act-f-l{font-size:var(--fs-24);margin-bottom:12rpx}
.act-in{display:flex;align-items:center;box-sizing:border-box;height:88rpx;padding:0 24rpx;border-radius:var(--radius-md);background:#222;border:1px solid #333;color:#fff;font-size:var(--fs-28)}
.act-in.is-ph,.act-cover-ph{color:#8A847A}
.act-in.is-err{border-color:#D64045}
.act-f-err{font-size:var(--fs-22);margin-top:10rpx}
.act-err{display:block;margin-bottom:24rpx;padding:16rpx 20rpx;border-radius:var(--radius-md);font-size:var(--fs-22);background:rgba(214,64,69,.12)}
.act-seg{gap:16rpx}
.act-seg-i{flex:1;text-align:center;padding:20rpx 0;border-radius:var(--radius-md);border:1px solid #333;color:var(--color-text-body);font-size:var(--fs-26)}
.act-seg-i.on{border-color:var(--color-primary);color:var(--color-primary);background:rgba(196,167,108,.1)}
.act-cover-pick{height:220rpx;border-radius:var(--radius-md);border:1px dashed #444;display:flex;align-items:center;justify-content:center;overflow:hidden}
.act-cover-pick image{width:100%;height:100%}
.act-cover-ph{font-size:var(--fs-26)}
.btn-full.is-busy{opacity:.6}
