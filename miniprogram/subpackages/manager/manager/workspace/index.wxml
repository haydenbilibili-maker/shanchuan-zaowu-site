<!-- 店长/超管功能模块：系统导航栏 + 原生返回（对标 member-crm） -->
<view class="container workspace-leaf">
  <view class="workbench-boot" wx:if="{{!workspaceReady}}">
    <text class="workbench-boot-cn">加载中…</text>
  </view>
  <block wx:elif="{{workspaceReady && curTab !== 0}}">
    <include src="_subviews.wxml" />
  </block>
</view>

<!-- 统一主视觉轻提示宿主：放最外层容器之外，避免被任何 filter/transform 影响定位 -->
<!-- 祈运标签上限提示（toggleProductBlessTag）就走它，见 managerPageConfig.showAppToast -->
<app-toast
  show="{{toastShow}}"
  overline="{{toastOverline}}"
  title="{{toastTitle}}"
  desc="{{toastDesc}}"
  duration="{{toastDuration}}"
  bind:close="onToastClose"
/>

<!-- 录入日报重复提示（submitRevenue → askLedgerDuplicate）：覆盖已有 / 仍要新增 / 取消 -->
<app-modal id="appModal" />
