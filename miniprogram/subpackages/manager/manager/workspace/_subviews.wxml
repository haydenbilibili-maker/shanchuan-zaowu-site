            <view class="m-row middle"><text class="tag-f">{{item.type==='virtual'?'虚拟':'实物'}}</text><text class="tag-f profit">库存：{{item.stock}}</text></view>
            <view class="m-row bottom"><text class="m-price" style="font-size:26rpx;">{{item.cost}} 积分</text><view class="del-btn" bindtap="deleteReward" data-id="{{item._id}}"><image class="del-btn-icon" src="/assets/icons/delete.png" mode="aspectFit" /></view></view>
          </view>
        </view>
      </block>
      <view class="add-btn-block" bindtap="openRewardModal">+ 新增藏品</view>
