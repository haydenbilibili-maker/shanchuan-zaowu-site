      <view class="sub-tab-row om-tab-row">
        <view class="sub-tab {{subTab===0?'active':''}}" bindtap="switchSubTab" data-idx="0">待发货 ({{orders.length}})</view>
        <view class="sub-tab {{subTab===1?'active':''}}" bindtap="switchSubTab" data-idx="1">已发货 ({{shippedOrders.length}})</view>
        <view class="sub-tab {{subTab===2?'active':''}}" bindtap="switchSubTab" data-idx="2">已完成 ({{completedOrders.length}})</view>
        <view class="sub-tab {{subTab===3?'active':''}}" bindtap="switchSubTab" data-idx="3">售后 ({{refunds.length}})</view>
        <view class="sub-tab {{subTab===4?'active':''}}" bindtap="switchSubTab" data-idx="4">待支付 ({{pendingPayOrders.length}})</view>
      </view>
    </scroll-view>

    <view class="om-toolbar">
      <view class="om-search">
        <input
          class="om-search-input"
          value="{{omQuery}}"
          bindinput="onOmQueryInput"
          confirm-type="search"
          placeholder="单号 / 收货人 / 手机 / 运单"
          placeholder-class="om-search-ph"
        />
        <view class="om-search-clear" wx:if="{{omQuery}}" catchtap="clearOmQuery">清除</view>
      </view>
      <view class="om-days-row">
        <view class="om-days-chip {{omDays===0?'on':''}}" bindtap="setOmDays" data-days="0">全部</view>
        <view class="om-days-chip {{omDays===7?'on':''}}" bindtap="setOmDays" data-days="7">近7日</view>
        <view class="om-days-chip {{omDays===30?'on':''}}" bindtap="setOmDays" data-days="30">近30日</view>
      </view>
      <text class="om-search-hint" wx:if="{{omSearchHint}}">{{omSearchHint}}</text>
      <view
        class="om-batch-btn {{omPendingCopyCount ? '' : 'disabled'}}"
        wx:if="{{subTab===0}}"
        bindtap="copyAllPendingAddresses"
      >复制全部待发地址{{omPendingCopyCount ? ' · ' + omPendingCopyCount : ''}}</view>
    </view>

    <view class="om-loading" wx:if="{{(subTab===0 && ordersLoading && !orders.length) || (subTab===1 && shippedOrdersLoading && !shippedOrders.length) || (subTab===2 && completedOrdersLoading && !completedOrders.length) || (subTab===3 && refundsLoading && !refunds.length) || (subTab===4 && pendingPayOrdersLoading && !pendingPayOrders.length)}}">
      <view class="om-skel"></view>
      <view class="om-skel short"></view>
      <text class="om-loading-text">加载订单中…</text>
    </view>

    <block wx:elif="{{subTab===0}}">
      <block wx:for="{{ordersView}}" wx:key="_id">
        <view class="om-card">
          <view class="om-card-head">
            <view class="om-head-main">
              <text class="om-no">NO. {{item.orderNo}}</text>
              <text class="om-time" wx:if="{{item.formatTime}}">{{item.formatTime}}</text>
            </view>
            <view class="om-status-wrap">
              <text class="om-status {{item.giftAwaitingAddress || item.isDepositOrder ? 'warn' : ''}}">{{item.statusLabel || '已支付'}}</text>
              <text class="gift-tag" wx:if="{{item.isGiftOrder}}">礼赠{{item.giftDeliveryLabel ? '·' + item.giftDeliveryLabel : ''}}</text>
              <text class="gift-tag" wx:elif="{{item.isStorePickup}}">门店自取</text>
              <text class="gift-tag" wx:elif="{{item.depositTag}}">{{item.depositTag}}</text>
            </view>
          </view>
          <view class="om-buyer" wx:if="{{item.buyer}}">
            <image
              wx:if="{{item.buyer.hasAvatar}}"
              class="om-buyer-avatar"
              src="{{item.buyer.avatarUrl}}"
              mode="aspectFill"
            ></image>
            <view class="om-buyer-avatar om-buyer-avatar-ph" wx:else>
              <text>{{item.buyer.avatarInitial}}</text>
            </view>
            <view class="om-buyer-body">
              <text class="om-buyer-label">下单会员</text>
              <text class="om-buyer-name">{{item.buyer.nickName}}</text>
              <text class="om-buyer-phone">{{item.buyer.hasPhone ? item.buyer.phoneMasked : '未留手机'}}</text>
            </view>
            <view
              class="om-buyer-msg"
              wx:if="{{menu.support && item.buyer.openid}}"
              catchtap="openYouxinForBuyer"
              data-openid="{{item.buyer.openid}}"
              data-nick="{{item.buyer.nickName}}"
              hover-class="om-buyer-msg-press"
              hover-stay-time="80"
            >私信</view>
          </view>
          <view class="om-sku-list" wx:if="{{item.skuList.length}}">
