  <block wx:if="{{curTab===15}}">
    <view class="cfg-page shipping-cfg">
      <view class="cfg-header">
        <view class="cfg-brand">
          <text class="cfg-en">SHIPPING RULES</text>
          <text class="cfg-cn">运费规则</text>
        </view>
        <text class="cfg-header-note">包邮门槛与基础运费 · 与下单计价同源 · 仅超管</text>
      </view>

      <view class="card cfg-card" wx:if="{{shippingLoading}}">
        <text class="cfg-hint">同步配置中…</text>
      </view>
      <block wx:else>
        <view class="card cfg-card cfg-summary">
          <view class="cfg-section-head">
            <text class="cfg-section-title">当前摘要</text>
            <text class="cfg-status-tag {{shippingFromDefault ? '' : 'on'}}">{{shippingFromDefault ? '代码默认' : '云端生效'}}</text>
          </view>
          <text class="cfg-summary-text">{{shippingRuleText || '尚未生成摘要'}}</text>
          <text class="cfg-meta-line" wx:if="{{shippingFromDefault}}">当前为代码默认，保存后写入 shipping_rules</text>
        </view>

        <view class="card cfg-card cfg-edit">
          <view class="cfg-section-head">
            <text class="cfg-section-title">规则编辑</text>
          </view>

          <view class="cfg-field-block">
            <text class="cfg-label-top">规则名</text>
            <input class="cfg-field cfg-field-full" value="{{shippingForm.name}}" data-field="name" bindinput="onShippingFieldInput" placeholder="规则名称" placeholder-class="cfg-placeholder"/>
          </view>
          <view class="cfg-field-block">
            <text class="cfg-label-top">承运商</text>
            <input class="cfg-field cfg-field-full" value="{{shippingForm.defaultCarrier}}" data-field="defaultCarrier" bindinput="onShippingFieldInput" placeholder="如：顺丰速运" placeholder-class="cfg-placeholder"/>
          </view>

          <view class="cfg-row">
            <text class="cfg-label">基础运费（元）</text>
            <input class="cfg-field cfg-field-num" type="digit" value="{{shippingForm.flatFee}}" data-field="flatFee" bindinput="onShippingFieldInput" placeholder="0.00" placeholder-class="cfg-placeholder"/>
          </view>
          <view class="cfg-row">
            <text class="cfg-label">饰品包邮门槛</text>
            <input class="cfg-field cfg-field-num" type="digit" value="{{shippingForm.accessoryFreeThreshold}}" data-field="accessoryFreeThreshold" bindinput="onShippingFieldInput" placeholder="0.00" placeholder-class="cfg-placeholder"/>
          </view>
          <view class="cfg-row">
            <text class="cfg-label">藏品包邮门槛</text>
            <input class="cfg-field cfg-field-num" type="digit" value="{{shippingForm.specimenFreeThreshold}}" data-field="specimenFreeThreshold" bindinput="onShippingFieldInput" placeholder="0.00" placeholder-class="cfg-placeholder"/>
          </view>
          <view class="cfg-row">
            <text class="cfg-label">混合车策略</text>
            <picker class="cfg-picker-wrap" mode="selector" range="{{shippingMixLabels}}" value="{{shippingMixIndex}}" bindchange="onShippingMixChange">
              <view class="cfg-picker">
                <text class="cfg-picker-val">{{shippingMixLabels[shippingMixIndex]}}</text>
                <text class="cfg-picker-chev">›</text>
              </view>
            </picker>
          </view>
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label">限时免邮</text>
              <text class="cfg-switch-hint {{shippingForm.campaignEnabled ? 'on' : ''}}">{{shippingForm.campaignEnabled ? '已开启' : '已关闭'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{shippingForm.campaignEnabled}}" color="#C4A76C" bindchange="onShippingCampaignToggle"/>
          </view>
          <view class="cfg-field-block" wx:if="{{shippingForm.campaignEnabled}}">
            <text class="cfg-label-top">活动文案</text>
            <input class="cfg-field cfg-field-full" value="{{shippingForm.campaignLabel}}" data-field="campaignLabel" bindinput="onShippingFieldInput" placeholder="当前全场免邮" placeholder-class="cfg-placeholder"/>
          </view>

          <view class="cfg-cta {{shippingSaving ? 'disabled' : ''}}" bindtap="saveShippingRules">{{shippingSaving ? '保存中…' : '保存规则'}}</view>
        </view>
      </block>
    </view>
  </block>

