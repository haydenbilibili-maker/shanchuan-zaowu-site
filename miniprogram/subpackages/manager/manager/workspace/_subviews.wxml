          </view>
          <view class="om-addr" wx:if="{{item.giftAwaitingAddress}}">
            <image class="om-addr-icon" src="/subpackages/manager/assets/icons/location.png" mode="aspectFit"></image>
            <view class="om-addr-body">
              <text class="om-addr-title">待 TA 留下地址</text>
              <text class="om-addr-sub">地址提交前不可发货</text>
            </view>
          </view>
          <view class="om-addr om-addr-copyable" wx:elif="{{item.address}}" catchtap="copyOrderAddress" data-id="{{item._id}}" data-scope="orders" hover-class="om-addr-press" hover-stay-time="80">
            <image class="om-addr-icon" src="/subpackages/manager/assets/icons/location.png" mode="aspectFit"></image>
            <view class="om-addr-body">
              <text class="om-addr-title">{{item.address.name}} {{item.address.phone}}</text>
              <text class="om-addr-sub">{{item.addressLine || item.address.detail}}</text>
            </view>
            <text class="om-addr-copy">复制</text>
          </view>
          <view class="om-note">
            <view class="om-note-head">
              <text class="om-note-label">订单备注</text>
              <text class="om-note-hint">随发货私信发给会员</text>
            </view>
            <view class="om-note-row">
              <input
                class="om-note-input"
                value="{{item.managerNote}}"
                maxlength="100"
                placeholder="如：附赠养护卡 · 易碎请轻放"
                placeholder-class="om-note-ph"
                confirm-type="done"
                bindinput="onOrderNoteInput"
                data-id="{{item._id}}"
              />
              <view
                class="om-note-save {{item.noteSaving ? 'disabled' : ''}}"
                catchtap="saveOrderNote"
                data-id="{{item._id}}"
                hover-class="om-note-save-press"
                hover-stay-time="80"
              >{{item.noteSaving ? '保存中' : '保存'}}</view>
            </view>
            <text class="om-note-saved" wx:if="{{item.savedNote}}">已保存：{{item.savedNote}}</text>
          </view>
          <view class="om-foot">
            <view class="om-foot-left">
              <text class="om-amount-label">实付</text>
              <text class="om-amount">{{item.amountText}}</text>
              <text class="om-count-hint">共 {{item.totalCount}} 件</text>
            </view>
            <view class="om-foot-actions" wx:if="{{item.canCompletePickup}}">
              <view class="om-btn ship" bindtap="completeStorePickup" data-id="{{item._id}}" data-orderno="{{item.orderNo}}" data-code="{{item.pickupCode}}">确认自取</view>
            </view>
            <view class="om-foot-actions" wx:elif="{{item.canShip}}">
              <view class="om-btn ghost" catchtap="copyShipLabel" data-id="{{item._id}}" data-scope="orders">面单文案</view>
              <view class="om-btn ship" bindtap="openShipModal" data-id="{{item._id}}" data-orderno="{{item.orderNo}}">确认发货</view>
            </view>
            <view class="om-foot-actions" wx:elif="{{item.isStorePickup}}">
              <view class="om-btn ship disabled">门店自取</view>
            </view>
            <view class="om-foot-actions" wx:else>
              <view class="om-btn ship disabled">待填址禁发货</view>
            </view>
          </view>
        </view>
      </block>
      <view class="om-empty" wx:if="{{!ordersLoading && !ordersView.length}}">
        <text class="om-empty-title">{{omQuery ? '无匹配待发货订单' : '暂无待发货订单'}}</text>
        <text class="om-empty-desc">{{omQuery ? '试试换个单号或手机号' : '下拉刷新可同步最新订单'}}</text>
