                <view class="sku-price-stock">
                  <input class="sku-field sku-input half" type="digit" placeholder="价格" placeholder-class="sku-ph" value="{{item.price}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="price"/>
                  <input class="sku-field sku-input half" type="number" placeholder="库存" placeholder-class="sku-ph" value="{{item.stock}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="stock"/>
                </view>
                <view class="sku-size-row" wx:if="{{item.sizeFormMode==='diameter'}}">
                  <input class="sku-field sku-input half" type="digit" placeholder="直径 (cm)" placeholder-class="sku-ph" value="{{item.sizeL}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeL"/>
                </view>
                <view class="sku-size-row" wx:elif="{{item.sizeFormMode==='diameter_height'}}">
                  <input class="sku-field sku-input half" type="digit" placeholder="直径 (cm)" placeholder-class="sku-ph" value="{{item.sizeL}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeL"/>
                  <input class="sku-field sku-input half" type="digit" placeholder="高度 (cm)" placeholder-class="sku-ph" value="{{item.sizeH}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeH"/>
