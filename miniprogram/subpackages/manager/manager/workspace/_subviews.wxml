        <text>{{isEditing ? '编辑' : '新建'}}养护指南</text>
        <view class="close-btn" bindtap="closeCareGuideModal">✕</view>
      </view>
      <scroll-view scroll-y class="modal-body">
        <view class="form-group">
          <view class="form-row">
            <text>品类</text>
            <picker mode="selector" range="{{careCategoryOptions}}" bindchange="bindCareGuideCategoryChange">
              <view class="picker-s">{{tempCareGuide.category || 'GENERAL'}}</view>
            </picker>
          </view>
          <view class="form-row"><text>标题</text><input value="{{tempCareGuide.title || ''}}" bindinput="bindCareGuideInput" data-field="title" placeholder="如：蝴蝶昆虫 · 框画与展柜藏品"/></view>
          <view class="form-row"><text>英文副标</text><input value="{{tempCareGuide.overline || ''}}" bindinput="bindCareGuideInput" data-field="overline" placeholder="INSECTA"/></view>
          <view class="form-row"><text>guideId</text><input value="{{tempCareGuide.guideId || ''}}" bindinput="bindCareGuideInput" data-field="guideId" placeholder="留空自动生成"/></view>
          <view class="form-row form-row-col"><text>养护摘要</text><textarea class="textarea" value="{{tempCareGuide.summary || ''}}" bindinput="bindCareGuideInput" data-field="summary" placeholder="一句话摘要" style="height:120rpx"/></view>
          <view class="form-row form-row-col"><text>免责声明</text><textarea class="textarea" value="{{tempCareGuide.disclaimer || ''}}" bindinput="bindCareGuideInput" data-field="disclaimer" placeholder="可选" style="height:100rpx"/></view>
          <view class="form-row">
            <text>状态</text>
            <radio-group class="radio-row" bindchange="bindCareGuideStatusChange">
              <radio color="#C4A76C" value="active" checked="{{tempCareGuide.status==='active'}}"/>启用
              <radio color="#C4A76C" value="draft" checked="{{tempCareGuide.status==='draft'}}"/>草稿
            </radio-group>
          </view>
          <view class="form-label">内容板块 JSON</view>
          <text class="form-hint">数组格式：[{"key":"environment","title":"适宜环境","body":"…","tips":["…"]}]</text>
          <textarea class="textarea mono" value="{{tempCareGuide.sectionsJson || ''}}" bindinput="bindCareGuideInput" data-field="sectionsJson" placeholder="[]" style="height:360rpx; font-family:monospace; font-size:22rpx;"/>
        </view>
      </scroll-view>
      <view class="modal-foot"><view class="btn-full" bindtap="submitCareGuide">保存</view></view>
    </view>
  </view>

  <!-- 评价回复弹窗（居中对话框，避免键盘顶起误触顶部返回） -->
  <view
    class="modal-mask comment-reply-mask"
    wx:if="{{showCommentReplyModal}}"
    catchtap="closeCommentReplyModal"
    catchtouchmove="noop"
  >
    <view class="comment-reply-panel" catchtap="noop">
      <view class="modal-head"><text>回复评价</text><view class="close-btn" catchtap="closeCommentReplyModal">✕</view></view>
      <view class="modal-body">
        <textarea
          class="textarea comment-reply-input"
          placeholder="输入商家回复…"
          value="{{tempCommentReply.content}}"
          bindinput="bindCommentReplyInput"
          adjust-position="{{false}}"
          hold-keyboard="{{true}}"
          confirm-type="done"
          maxlength="500"
          show-confirm-bar="{{true}}"
        ></textarea>
      </view>
      <view class="modal-foot"><view class="btn-full" catchtap="submitCommentReply">提交回复</view></view>
    </view>
  </view>

  <!-- 山海有信：推送确认 -->
  <view class="modal-mask" wx:if="{{showPushConfirm}}" catchtap="closePushConfirm">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-head"><text>确认发送</text><view class="close-btn" catchtap="closePushConfirm">✕</view></view>
      <view class="modal-body">
        <text class="p-name">将向约 {{pushEstimate}} 位藏家发送公告</text>
        <text class="addr-detail" style="margin-top:16rpx;display:block;">{{pushForm.title}}</text>
        <text class="addr-detail">{{pushForm.content}}</text>
      </view>
      <view class="modal-foot"><view class="btn-full" catchtap="submitPush">确认发送</view></view>
    </view>
  </view>

  <!-- 门店编辑 -->
  <view class="modal-mask" wx:if="{{showStoreEditModal}}" catchtap="closeStoreEditModal">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-head"><text>编辑门店 · {{tempStoreEdit.name}}</text><view class="close-btn" catchtap="closeStoreEditModal">✕</view></view>
      <scroll-view scroll-y class="modal-body">
        <view class="form-row"><text>名称</text><input value="{{tempStoreEdit.name}}" bindinput="bindStoreEditInput" data-field="name" placeholder="门店名称"/></view>
        <view class="form-row"><text>电话</text><input value="{{tempStoreEdit.phone}}" bindinput="bindStoreEditInput" data-field="phone" placeholder="联系电话"/></view>
        <view class="form-row"><text>楼层/铺位</text><input value="{{tempStoreEdit.floor}}" bindinput="bindStoreEditInput" data-field="floor" placeholder="如：山坡 X-06-1"/></view>
        <view class="form-row"><text>地址</text><textarea class="textarea" value="{{tempStoreEdit.address}}" bindinput="bindStoreEditInput" data-field="address" placeholder="完整地址" style="height:100rpx"/></view>
        <view class="form-row"><text>营业开始</text><input value="{{tempStoreEdit.hoursOpen}}" bindinput="bindStoreEditInput" data-field="hoursOpen" placeholder="10:00"/></view>
        <view class="form-row"><text>营业结束</text><input value="{{tempStoreEdit.hoursClose}}" bindinput="bindStoreEditInput" data-field="hoursClose" placeholder="22:00"/></view>
        <view class="form-row form-row-switch">
          <text>营业状态</text>
          <view class="form-switch-wrap">
            <text class="form-switch-hint">{{tempStoreEdit.status==='active'?'营业中':'已停用'}}</text>
            <switch checked="{{tempStoreEdit.status==='active'}}" color="#C4A76C" bindchange="onStoreStatusToggle"/>
          </view>
        </view>
        <view class="form-row"><text>一句话</text><input value="{{tempStoreEdit.heroTagline}}" bindinput="bindStoreEditInput" data-field="heroTagline" placeholder="英雄区短句"/></view>
        <view class="form-row"><text>简介</text><textarea class="textarea" value="{{tempStoreEdit.intro}}" bindinput="bindStoreEditInput" data-field="intro" style="height:120rpx"/></view>
        <view class="form-row"><text>到店提示</text><textarea class="textarea" value="{{tempStoreEdit.visitTipsText}}" bindinput="bindStoreEditInput" data-field="visitTipsText" placeholder="每行一条" style="height:160rpx"/></view>
      </scroll-view>
      <view class="modal-foot"><view class="btn-full" bindtap="saveStoreEdit">保存</view></view>
    </view>
  </view>

  <!-- 山海有信：留言回复 -->
  <view class="modal-mask" wx:if="{{showTicketReplyModal}}" catchtap="closeTicketReplyModal">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-head"><text>回复 · {{tempTicketReply.topicLabel}}</text><view class="close-btn" catchtap="closeTicketReplyModal">✕</view></view>
      <scroll-view scroll-y class="modal-body">
        <textarea class="textarea" maxlength="500" value="{{tempTicketReply.content}}" bindinput="bindTicketReplyInput" placeholder="回复内容将推送到用户山海有信" style="height:200rpx"/>
      </scroll-view>
      <view class="modal-foot"><view class="btn-full" bindtap="submitTicketReply">发送回复</view></view>
    </view>
  </view>
