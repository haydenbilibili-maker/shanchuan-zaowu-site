           <image wx:if="{{tempFramer.avatar}}" src="{{tempFramer.avatar}}" mode="aspectFill"></image>
           <view wx:else class="placeholder">上传头像</view>
        </view>
        <view class="form-group">
          <view class="form-row"><text>姓名</text><input value="{{tempFramer.name}}" bindinput="bindFInput" data-field="name" placeholder="对外展示名" /></view>
          <view class="form-label">类型</view>
          <radio-group class="radio-row" bindchange="bindFTypeChange">
             <label class="radio-label"><radio color="#C4A76C" value="store" checked="{{tempFramer.type==='store'}}"/>门店标本师</label>
             <label class="radio-label"><radio color="#C4A76C" value="partner" checked="{{tempFramer.type==='partner'}}"/>特邀合作</label>
          </radio-group>
          <view class="form-row switch-row" wx:if="{{isEditing}}">
            <text>对外上架</text>
            <switch color="#C4A76C" checked="{{tempFramer.active}}" bindchange="bindFActiveChange" />
          </view>
          <view class="form-label">简介</view>
          <textarea class="textarea" value="{{tempFramer.bio}}" bindinput="bindFInput" data-field="bio" style="height:160rpx" placeholder="访客可见的简短介绍"/>
          <view class="form-row"><text>定制加价</text><input type="digit" value="{{tempFramer.priceDelta}}" bindinput="bindFInput" data-field="priceDelta" placeholder="0"/></view>
          <view class="form-row"><text>额外交期（天）</text><input type="number" value="{{tempFramer.extraDays}}" bindinput="bindFInput" data-field="extraDays" placeholder="0"/></view>

          <view class="framer-modal-ops" wx:if="{{isEditing}}">
