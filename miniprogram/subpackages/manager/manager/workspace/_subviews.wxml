            <switch class="cfg-switch" checked="{{contentFlags.showSpecimenCustom}}" data-field="showSpecimenCustom" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">伴宠记忆入口</text>
              <text class="cfg-switch-hint {{contentFlags.showPetMemorial ? 'on' : ''}}">{{contentFlags.showPetMemorial ? '展示中' : '已隐藏'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{contentFlags.showPetMemorial}}" data-field="showPetMemorial" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">馆内直播入口</text>
              <text class="cfg-switch-hint {{contentFlags.showLive ? 'on' : ''}}">{{contentFlags.showLive ? '展示中' : '已隐藏'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{contentFlags.showLive}}" data-field="showLive" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">我的钱包入口</text>
              <text class="cfg-switch-hint {{contentFlags.showStoredValue ? 'on' : ''}}">{{contentFlags.showStoredValue ? '展示中' : '已隐藏'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{contentFlags.showStoredValue}}" data-field="showStoredValue" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">AI 标本鉴定</text>
              <text class="cfg-switch-hint {{contentFlags.showAiIdentify ? 'on' : ''}}">{{contentFlags.showAiIdentify ? '展示中' : '已隐藏'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{contentFlags.showAiIdentify}}" data-field="showAiIdentify" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">这有店展示</text>
              <text class="cfg-switch-hint {{contentFlags.showStore ? 'on' : ''}}">{{contentFlags.showStore ? '展示中' : '已隐藏'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{contentFlags.showStore}}" data-field="showStore" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">到店自取</text>
              <text class="cfg-switch-hint {{contentFlags.showStorePickup ? 'on' : ''}}">{{contentFlags.showStorePickup ? '展示中' : '已隐藏'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{contentFlags.showStorePickup}}" data-field="showStorePickup" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">礼赠入口</text>
              <text class="cfg-switch-hint {{contentFlags.showGift ? 'on' : ''}}">{{contentFlags.showGift ? '展示中' : '已隐藏'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{contentFlags.showGift}}" data-field="showGift" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <!-- 需求 28：马上有祈福弹幕。UGC 新能力 → 缺配置默认关；关闭后 C 端入口消失且不发请求 -->
          <view class="cfg-row cfg-row-switch">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">马上有祈福</text>
              <text class="cfg-switch-hint {{contentFlags.showMaShangYou ? 'on' : ''}}">{{contentFlags.showMaShangYou ? '展示中' : '已隐藏'}}</text>
            </view>
            <switch class="cfg-switch" checked="{{contentFlags.showMaShangYou}}" data-field="showMaShangYou" color="#C4A76C" bindchange="onContentFlagToggle"/>
          </view>
          <!-- 需求 28：弹幕治理入口。不接审核 → 必须能在此复核全部内容（含已隐藏） -->
          <view class="cfg-row cfg-row-link" bindtap="goWishWallManage">
            <view class="cfg-label-block">
              <text class="cfg-label cfg-label-wide">祈福墙内容管理</text>
              <text class="cfg-switch-hint">查看全部弹幕 · 隐藏 / 恢复 / 置顶 / 删除</text>
            </view>
            <text class="cfg-chevron">›</text>
          </view>
        </view>
        <!-- 未保存提示：开关是「先改本地、点保存才写云端」，没有这句超管会以为已经生效 -->
        <view class="cfg-dirty" wx:if="{{contentFlagsDirty}}">有未保存的改动 —— 点下方「保存开关」后 C 端才会生效</view>
        <view class="cfg-cta {{contentFlagsSaving ? 'disabled' : ''}}" bindtap="saveContentDisplayFlags">{{contentFlagsSaving ? '保存中…' : '保存开关'}}</view>
      </view>
    </block>
  </block>

</view>


<!-- ==================== 4. 弹窗与反馈系统 ==================== -->

<!-- 核销成功全屏动画 -->
<view class="verify-success-modal {{showVerifySuccess ? 'active' : ''}}">
  <view class="vs-content">
    <view class="vs-stamp-anim"><text>已核销</text></view>
    <text class="vs-tip">欢迎入馆参观</text>
    <view class="btn-small gold" bindtap="closeVerifyModal">完成</view>
  </view>
</view>

<!-- 会员码核验结果 -->
<view class="modal-mask" wx:if="{{showMemberPassResult}}" bindtap="closeMemberPassResult">
  <view class="modal-panel member-pass-panel" catchtap="true">
    <view class="modal-head">
      <text>会员核验</text>
      <view class="close-btn" bindtap="closeMemberPassResult">✕</view>
    </view>
    <view class="modal-body member-pass-body">
      <view class="mp-status-row">
        <view class="signal-light {{memberPassResult.valid ? 'blink' : ''}}"></view>
        <view class="mp-status {{memberPassResult.valid ? 'ok' : 'bad'}}">
          {{memberPassResult.valid ? '核验通过' : (memberPassResult.expired ? '已过期' : '未通过')}}
        </view>
      </view>
      <text class="mp-msg">{{memberPassResult.msg}}</text>
      <view class="mp-row" wx:if="{{memberPassResult.memberNo}}">
        <text class="mp-label">会员编号</text>
        <text class="mp-value mono">{{memberPassResult.memberNo}}</text>
      </view>
      <view class="mp-row" wx:if="{{memberPassResult.nickName}}">
        <text class="mp-label">称呼</text>
        <text class="mp-value">{{memberPassResult.nickName}}</text>
      </view>
      <view class="mp-row" wx:if="{{memberPassResult.levelName}}">
        <text class="mp-label">等级</text>
        <text class="mp-value">{{memberPassResult.levelName}}</text>
      </view>
      <view class="mp-row" wx:if="{{memberPassResult.valid && memberPassResult.discountText}}">
        <text class="mp-label">折扣</text>
        <text class="mp-value">{{memberPassResult.discountText}}</text>
      </view>
      <view class="mp-perks" wx:if="{{memberPassResult.valid && memberPassResult.perks.length}}">
        <text class="mp-label">当前权益</text>
        <view class="mp-perk-grid">
          <view class="mp-perk-chip" wx:for="{{memberPassResult.perks}}" wx:key="label">
            <image class="mp-perk-icon icon-gold" src="{{item.icon}}" mode="aspectFit"></image>
            <text class="mp-perk-text">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="modal-foot">
      <view class="btn-full" bindtap="closeMemberPassResult">完成</view>
    </view>
  </view>
</view>

<!-- 伴宠报价弹窗 -->
<view class="modal-mask" wx:if="{{showPetQuoteModal}}">
  <view class="modal-panel">
    <view class="modal-head"><text>伴宠报价</text><view class="close-btn" bindtap="closePetQuoteModal">✕</view></view>
    <scroll-view scroll-y class="modal-body">
      <view class="form-group">
        <view class="form-row"><text>金额（元）</text><input type="digit" value="{{tempPetQuote.amount}}" bindinput="bindPetQuoteInput" data-field="amount" placeholder="如 5800"/></view>
        <view class="form-row"><text>有效期</text><picker mode="date" bindchange="onPetQuoteDateChange"><view class="picker">{{tempPetQuote.validUntil || '选填'}}</view></picker></view>
        <view class="form-row"><text>说明</text><textarea class="textarea" value="{{tempPetQuote.note}}" bindinput="bindPetQuoteInput" data-field="note" placeholder="工艺说明、周期等" style="height:120rpx"/></view>
      </view>
    </scroll-view>
    <view class="modal-foot"><view class="btn-full" bindtap="submitPetQuote">发送报价</view></view>
  </view>
</view>

<!-- 营收录入弹窗 -->
<view class="modal-mask" wx:if="{{showRevenueModal}}">
  <view class="modal-panel">
    <view class="modal-head"><text>录入营收 · {{ledgerStoreName}}</text><view class="close-btn" bindtap="closeModal">✕</view></view>
    <scroll-view scroll-y class="modal-body">
      <view class="smart-box"><textarea placeholder="粘贴营收信息自动解析（入账门店以顶部选中为准）…" bindinput="parseRevenueText" value="{{tempRevenue.rawText}}"></textarea></view>
      <view class="form-group">
         <view class="form-row"><text>日期</text><picker mode="date" bindchange="bindRevInput" data-field="date"><view class="picker">{{tempRevenue.date}}</view></picker></view>
         <view class="form-row"><text>刷卡｜POS</text><input type="digit" value="{{tempRevenue.pos}}" bindinput="bindRevInput" data-field="pos"/></view>
         <view class="form-row"><text>遗留线上｜账本</text><input type="digit" value="{{tempRevenue.online}}" bindinput="bindRevInput" data-field="online" placeholder="勿填小程序GMV；计入门店净额"/></view>
         <view class="form-row"><text>现金余额｜在手</text><input type="digit" value="{{tempRevenue.cashBalance}}" bindinput="bindRevInput" data-field="cashBalance" placeholder="现存现金，非当日收入"/></view>
         <view class="form-row"><text>退款｜REFUND</text><input type="digit" value="{{tempRevenue.refund}}" bindinput="bindRevInput" data-field="refund" style="color:#ff4d4f"/></view>
      </view>
    </scroll-view>
    <view class="modal-foot"><view class="btn-full" bindtap="submitRevenue">确认小钱钱入账</view></view>
  </view>
</view>

<!-- 轮播图编辑弹窗 -->
<view class="modal-mask" wx:if="{{showBannerModal}}">
  <view class="modal-panel">
    <view class="modal-head"><text>编辑海报</text><view class="close-btn" bindtap="closeModal">✕</view></view>
    <scroll-view scroll-y class="modal-body">
      <view class="upload-area" bindtap="chooseBannerImage">
         <image wx:if="{{tempBanner.image}}" src="{{tempBanner.image}}" mode="aspectFill"></image>
         <view wx:else class="placeholder">上传图片</view>
      </view>
      <view class="form-group">
         <view class="form-row"><text>标题</text><input value="{{tempBanner.title}}" bindinput="bindBInput" data-field="title"/></view>
         <view class="form-row"><text>副标题</text><input value="{{tempBanner.subtitle}}" bindinput="bindBInput" data-field="subtitle"/></view>
         <view class="form-row"><text>按钮文案</text><input value="{{tempBanner.btnText}}" bindinput="bindBInput" data-field="btnText"/></view>
         <view class="form-row"><text>排序</text><input type="number" value="{{tempBanner.sort}}" bindinput="bindBInput" data-field="sort"/></view>
         <view class="form-row switch-row">
           <text>首页展示</text>
           <switch color="#C4A76C" checked="{{tempBanner.enabled}}" bindchange="bindBEnabledChange"/>
         </view>
         <view class="form-row" wx:if="{{tempBanner.type==='product' || tempBanner.type==='category'}}"><text>目标ID</text><input value="{{tempBanner.target}}" bindinput="bindBInput" data-field="target" placeholder="藏品ID或分类关键词"/></view>
         <view class="form-label">跳转类型</view>
         <radio-group class="radio-row" bindchange="bindBTypeChange">
           <radio color="#C4A76C" value="product" checked="{{tempBanner.type==='product'}}"/>藏品
           <radio color="#C4A76C" value="category" checked="{{tempBanner.type==='category'}}"/>分类
           <radio color="#C4A76C" value="booking" checked="{{tempBanner.type==='booking'}}"/>预约
           <radio color="#C4A76C" value="scheme" checked="{{tempBanner.type==='scheme'}}"/>功能页
         </radio-group>
         <block wx:if="{{tempBanner.type==='scheme'}}">
           <view class="form-label">常用入口</view>
           <picker mode="selector" range="{{schemePresets}}" range-key="label" value="{{schemePresetIndex}}" bindchange="onBannerSchemePreset">
             <view class="form-row picker-row"><text>{{schemePresets[schemePresetIndex].label}}</text><text class="picker-arrow">›</text></view>
           </picker>
           <view class="form-row"><text>路径</text><input value="{{tempBanner.target}}" bindinput="bindBSchemePath" data-field="target" placeholder="/subpackages/business/order-claim/index"/></view>
         </block>
      </view>
    </scroll-view>
    <view class="modal-foot"><view class="btn-full" bindtap="submitBanner">保存发布</view></view>
  </view>
</view>

<!-- 藏品录入弹窗 -->
<view class="modal-mask" wx:if="{{showProductModal}}">
    <view class="modal-panel product-entry-panel">
      <view class="modal-head"><text>{{isEditing?'编辑':'录入'}}藏品</text><view class="close-btn" bindtap="closeModal">✕</view></view>
      <view class="product-form-tabs">
        <view class="pft {{productFormTab==='basic'?'on':''}}" bindtap="setProductFormTab" data-tab="basic">基础</view>
        <view class="pft {{productFormTab==='sku'?'on':''}}" bindtap="setProductFormTab" data-tab="sku">规格</view>
        <view class="pft {{productFormTab==='flags'?'on':''}}" bindtap="setProductFormTab" data-tab="flags">标识</view>
        <view class="pft {{productFormTab==='archive'?'on':''}}" bindtap="setProductFormTab" data-tab="archive">档案</view>
        <view class="pft {{productFormTab==='detail'?'on':''}}" bindtap="setProductFormTab" data-tab="detail">详情</view>
        <view class="pft {{productFormTab==='promo'?'on':''}}" wx:if="{{!artisanEmbed}}" bindtap="setProductFormTab" data-tab="promo">营销</view>
      </view>
      <scroll-view scroll-y enable-flex class="modal-body product-entry-body">

        <block wx:if="{{productFormTab==='basic'}}">
        <view class="product-tab-pane">
        <view class="form-label">轮播图（首张为封面，最多 12 张）</view>
        <view class="detail-images-grid">
          <view class="detail-img-item product-gallery-item" wx:for="{{tempProduct.images}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill"></image>
            <text class="cover-badge" wx:if="{{index===0}}">封面</text>
            <view class="gallery-actions">
              <text class="g-act" wx:if="{{index!==0}}" catchtap="setProductCoverImage" data-index="{{index}}">封面</text>
              <text class="g-act" wx:if="{{index>0}}" catchtap="moveProductImage" data-index="{{index}}" data-delta="-1">←</text>
              <text class="g-act" wx:if="{{index < tempProduct.images.length - 1}}" catchtap="moveProductImage" data-index="{{index}}" data-delta="1">→</text>
              <text class="g-act danger" catchtap="removeProductImage" data-index="{{index}}">×</text>
            </view>
          </view>
          <view class="detail-img-add" bindtap="chooseProductImages" wx:if="{{!tempProduct.images || tempProduct.images.length < 12}}">
            <text>+ 添加</text>
          </view>
        </view>

        <view class="form-group">
          <view class="form-row ai-row">
            <text>名称</text>
            <view class="ai-field-wrap">
              <input value="{{tempProduct.title}}" bindinput="bindPInput" data-field="title" placeholder="请输入藏品名称"/>
              <!-- 双层命名：title 是标准名（检索/识别/对账），主题名是文艺名（详情/礼赠做主视觉） -->
              <input value="{{tempProduct.themeName}}" bindinput="bindPInput" data-field="themeName" placeholder="主题名（2–8 字，如「时间的守卫者」）"/>
              <input value="{{tempProduct.themeNote}}" bindinput="bindPInput" data-field="themeNote" placeholder="一句话点题（选填，如「钟面朝前，时间向后」）"/>
              <view class="ai-btn {{aiAssisting ? 'disabled' : ''}}" bindtap="assistProductFillAll">一键补齐</view>
            </view>
          </view>
          <text class="latin-hint">根据名称补齐分类、描述、保护物种、科学分类、拉丁学名与标签</text>

          <view class="form-row">
             <text>分类</text>
             <view class="picker-group">
               <picker mode="selector" range="{{rootNames}}" value="{{tempProduct.rootCategoryIndex >= 0 ? tempProduct.rootCategoryIndex : 0}}" bindchange="bindRootCatChange">
                 <view class="picker-s">{{tempProduct.rootCategoryName || '所属馆'}}</view>
               </picker>
               <text class="picker-sep">›</text>
               <picker mode="selector" range="{{subNames}}" value="{{tempProduct.subCategoryIndex >= 0 ? tempProduct.subCategoryIndex : 0}}" bindchange="bindSubCatChange" disabled="{{subNames.length===0}}">
                 <view class="picker-s {{subNames.length===0?'disabled':''}}">{{tempProduct.category || '具体分类'}}</view>
               </picker>
             </view>
          </view>

          <view class="form-row tag-editor-row">
            <text>标签</text>
            <view class="tag-editor">
              <view class="tag-chips" wx:if="{{tempProduct.tags.length}}">
                <view class="tag-chip" wx:for="{{tempProduct.tags}}" wx:for-item="tagItem" wx:key="*this">
                  <text class="tag-chip-text">{{tagItem}}</text>
                  <view class="tag-chip-x" catchtap="removeProductTag" data-tag="{{tagItem}}">×</view>
                </view>
              </view>
              <view class="tag-add-row">
                <input class="tag-draft-input" value="{{tempProduct.tagDraft}}" bindinput="bindPInput" data-field="tagDraft" bindconfirm="addProductTag" placeholder="回车添加，最多 10 个"/>
                <view class="tag-add-btn" bindtap="addProductTag">添加</view>
              </view>
            </view>
          </view>
          <text class="latin-hint">用于首页推荐、搜索关联与用户画像；一键补齐会自动打上</text>

          <view class="form-row-pair">
            <view class="form-row half" wx:if="{{!artisanEmbed}}"><text>进货价</text><input type="digit" value="{{tempProduct.costPrice}}" bindinput="bindPInput" data-field="costPrice" placeholder="0.00"/></view>
            <view class="form-row {{artisanEmbed ? '' : 'half'}}"><text>销售价</text><input type="digit" value="{{tempProduct.price}}" bindinput="bindPInput" data-field="price" placeholder="0.00"/></view>
          </view>
          <view class="form-row"><text>库存</text><input type="number" value="{{tempProduct.stock}}" bindinput="bindPInput" data-field="stock" placeholder="1" disabled="{{tempProduct.hasSku}}"/></view>
          <text class="latin-hint" wx:if="{{!tempProduct.hasSku}}">库存为 1 时默认标记孤品；手动关掉后不再强开</text>
          <text class="latin-hint" wx:else>多规格开启后，总库存由各规格汇总</text>

          <view class="form-row" wx:if="{{productChannelEligible}}">
            <text>渠道</text>
            <picker mode="selector" range="{{channelLabels}}" value="{{channelIndex}}" bindchange="bindChannelChange">
              <view class="picker-s">{{channelLabels[channelIndex] || '未标注'}}</view>
            </picker>
          </view>
          <view class="form-row" wx:if="{{productCraftEligible}}">
            <text>装裱方式</text>
            <picker mode="selector" range="{{craftLabels}}" value="{{craftTypeIndex}}" bindchange="bindCraftTypeChange">
              <view class="picker-s">{{craftLabels[craftTypeIndex] || '未标注'}}</view>
            </picker>
          </view>
          <view class="form-row" wx:if="{{productCraftEligible}}">
            <text>制作工艺</text>
            <picker mode="selector" range="{{craftProcessLabels}}" value="{{craftProcessIndex}}" bindchange="bindCraftProcessChange">
              <view class="picker-s">{{craftProcessLabels[craftProcessIndex] || '未标注'}}</view>
            </picker>
          </view>
        </view>
        </view>
        </block>

        <block wx:if="{{productFormTab==='sku'}}">
        <view class="product-tab-pane">
        <view class="form-group">
          <view class="form-row"><text>多规格</text><switch checked="{{tempProduct.hasSku}}" color="#C4A76C" bindchange="bindPHasSku" style="transform:scale(0.7)"/></view>
          <block wx:if="{{tempProduct.hasSku}}">
            <view class="sku-builder">
              <text class="sku-section-title">维度生成</text>
              <view class="sku-dim-row" wx:for="{{skuDimBuilder}}" wx:key="index">
                <input class="sku-field sku-dim-name" placeholder="维度名" placeholder-class="sku-ph" value="{{item.name}}" bindinput="bindSkuDimInput" data-index="{{index}}" data-field="name"/>
                <input class="sku-field sku-dim-vals" placeholder="取值，逗号分隔" placeholder-class="sku-ph" value="{{item.valuesStr}}" bindinput="bindSkuDimInput" data-index="{{index}}" data-field="valuesStr"/>
                <view class="sku-dim-del" wx:if="{{skuDimBuilder.length>1}}" bindtap="removeSkuDimRow" data-index="{{index}}">删</view>
              </view>
              <view class="sku-builder-actions">
                <view class="sku-tool-btn" bindtap="addSkuDimRow">+ 维度</view>
                <view class="sku-tool-btn primary" bindtap="generateSkusFromDims">生成规格组合</view>
              </view>
              <text class="latin-hint">例：尺寸=30cm,40cm；装裱=金框,木框 → 自动组合</text>
            </view>

            <view class="sku-bulk-panel">
              <text class="sku-section-title">批量工具</text>
              <view class="sku-bulk-bar">
                <input class="sku-field sku-bulk-input" type="digit" placeholder="统一价" placeholder-class="sku-ph" value="{{skuBulkPrice}}" bindinput="bindSkuBulkInput" data-field="price"/>
                <input class="sku-field sku-bulk-input" type="number" placeholder="统一库存" placeholder-class="sku-ph" value="{{skuBulkStock}}" bindinput="bindSkuBulkInput" data-field="stock"/>
                <view class="sku-tool-btn" bindtap="applySkuBulkFields">应用到全部</view>
              </view>
              <view class="sku-bulk-bar tools">
                <view class="sku-tool-btn" bindtap="autoFillSkuCodes">补 SKU 编码</view>
                <view class="sku-tool-btn" bindtap="applyCoverToEmptySkus">缺图用封面</view>
                <view class="sku-tool-btn" bindtap="addSkuRowsBatch">+3 行</view>
              </view>
            </view>

            <view class="sku-block compact" wx:for="{{tempProduct.skus}}" wx:key="id">
              <view class="sku-card-head">
