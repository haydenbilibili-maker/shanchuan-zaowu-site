                <text>上传合法收藏证书</text>
              </view>
            </view>
            <view class="cert-actions" wx:if="{{tempProduct.tempCertificate || tempProduct.collectionCertificate}}">
              <text class="cert-reupload" bindtap="chooseCertificateImage">重新上传</text>
              <text class="cert-remove" bindtap="removeCertificateImage">删除</text>
            </view>
            <text class="cert-hint">三有或保护类藏品须上传主管部门颁发的收藏/许可证明文件</text>
          </block>
        </view>
        </view>
        </block>

