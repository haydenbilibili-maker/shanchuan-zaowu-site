      <view class="cfg-shortcut" wx:if="{{menu.shipmentOps}}" bindtap="goShipmentOps">出货单 ›</view>
      <view class="cfg-shortcut" wx:if="{{menu.inventoryOps || menu.rawInventoryOps}}" bindtap="goInventoryOps">库存管理 ›</view>
    </view>
    <block wx:if="{{subTabReward===0}}">
