              data-key="{{item.key}}"
              bindtap="onYouxinSegmentTap"
              style="--seg-tone: {{item.tone}}"
            >
              <text class="youxin-seg-name">{{item.name}}</text>
            </view>
          </view>
          <text class="msg-estimate" wx:if="{{pushPreviewNote}}">{{pushPreviewNote}}</text>
          <text class="msg-estimate">预估触达 {{pushEstimate}} 人（CRM 同源采样）</text>
        </view>

        <view class="youxin-filter-row">
          <view class="youxin-filter">
            <text>荣誉馆长</text>
            <switch checked="{{pushForm.honoraryOnly}}" color="#C4A76C" data-field="honoraryOnly" bindchange="onYouxinFilterToggle"/>
          </view>
          <view class="youxin-filter">
            <text>近 30 日活跃</text>
            <switch checked="{{pushForm.activeOnly}}" color="#C4A76C" data-field="activeOnly" bindchange="onYouxinFilterToggle"/>
          </view>
          <view class="youxin-filter">
            <text>高价值分群</text>
            <switch checked="{{pushForm.highValueOnly}}" color="#C4A76C" data-field="highValueOnly" bindchange="onYouxinFilterToggle"/>
          </view>
        </view>

        <view class="push-field-block">
          <text class="push-label">权益/藏品提示（AI 可选）</text>
          <input
            class="push-title-input"
            maxlength="80"
            value="{{pushForm.offerHint}}"
            bindinput="bindYouxinOfferHint"
            placeholder="如：养护指南上新、门店标本展"
            placeholder-class="input-placeholder"
          />
        </view>

        <view class="btn-row" style="margin-bottom: 24rpx;">
          <view class="btn verify {{pushAiLoading?'disabled':''}}" bindtap="generateYouxinCopy">AI 撰写文案</view>
        </view>

        <view class="card card-museum-preview" wx:if="{{pushForm.title || pushForm.content}}">
          <text class="museum-preview-kicker">预览 · 藏家收件箱</text>
          <text class="museum-preview-title">{{pushForm.title || '标题'}}</text>
          <text class="museum-preview-body">{{pushForm.content || '正文'}}</text>
        </view>

        <view class="push-field-block">
          <text class="push-label">标题</text>
          <input
            class="push-title-input"
            maxlength="30"
            value="{{pushForm.title}}"
            bindinput="bindPushInput"
            data-field="title"
            placeholder="不超过 30 字"
            placeholder-class="input-placeholder"
            hold-keyboard="{{true}}"
          />
        </view>

        <view class="push-field-block">
          <text class="push-label">正文</text>
          <textarea
            class="push-content-input"
            maxlength="200"
            value="{{pushForm.content}}"
            bindinput="bindPushInput"
            data-field="content"
            placeholder="活动/公告说明，不超过 200 字"
            placeholder-class="input-placeholder"
            hold-keyboard="{{true}}"
            show-confirm-bar="{{true}}"
            adjust-position="{{true}}"
            cursor-spacing="80"
            fixed="{{false}}"
          />
        </view>

        <view class="form-row ship-form-row">
          <text>分类</text>
          <picker mode="selector" range="{{['活动','系统']}}" bindchange="onPushCategoryChange">
            <view class="picker-s">{{pushForm.category==='activity'?'活动':'系统'}}</view>
          </picker>
        </view>
        <view class="form-row ship-form-row">
          <text>跳转</text>
          <input
            class="push-title-input"
            value="{{pushForm.actionUrl}}"
            bindinput="bindPushInput"
            data-field="actionUrl"
            placeholder="小程序路径，可留空"
            placeholder-class="input-placeholder"
            hold-keyboard="{{true}}"
          />
        </view>
        <view class="form-row ship-form-row">
          <text>范围</text>
          <radio-group class="radio-row push-radio-row" bindchange="onPushScopeChange">
            <label class="radio-label"><radio value="segment" checked="{{pushForm.scope==='segment'}}" color="#C4A76C"/>RFM 分群</label>
            <label class="radio-label"><radio value="single" checked="{{pushForm.scope==='single'}}" color="#C4A76C"/>指定用户</label>
            <label class="radio-label"><radio value="all" checked="{{pushForm.scope==='all'}}" color="#C4A76C"/>全局</label>
          </radio-group>
        </view>
        <view class="form-row ship-form-row" wx:if="{{pushForm.scope==='single'}}">
          <text>openid</text>
          <input
            class="push-title-input"
            value="{{pushForm.targetOpenid}}"
            bindinput="bindPushInput"
            data-field="targetOpenid"
            placeholder="用户 openid"
            placeholder-class="input-placeholder"
            hold-keyboard="{{true}}"
          />
        </view>
        <text class="msg-estimate" wx:if="{{pushForm.scope==='single' && omYouxinBuyerHint}}">下单会员 · {{omYouxinBuyerHint}}</text>
        <view class="msg-estimate" wx:if="{{pushForm.scope==='all'}}">预估触达约 {{pushEstimate}} 人 · 24h 内限 20 次全局推送</view>
        <view class="msg-estimate" wx:if="{{pushForm.scope==='segment'}}">分群单次最多 500 人 · 24h 内限 30 次分群推送</view>
        <view class="btn-row">
          <view class="btn verify" bindtap="seedMessageTemplates">初始化模板</view>
          <view class="btn ship" bindtap="openPushConfirm">预览并发送</view>
        </view>
      </view>
    </block>

    <block wx:if="{{subTabMessage===1}}">
      <view class="panel-title" style="padding: 0 8rpx 16rpx; color:#888; font-size:24rpx;">运营推送记录</view>
      <block wx:for="{{pushCampaigns}}" wx:key="_id">
        <view class="card">
          <view class="card-top">
            <text class="no">{{item.title}}</text>
            <text class="status used">{{item.scopeLabel}}{{item.campaignTypeLabel ? ' · '+item.campaignTypeLabel : ''}}</text>
          </view>
          <text class="p-name">{{item.content}}</text>
          <text class="addr-detail">{{item.formatTime}} · {{item.statsText}}{{item.statusLabel ? ' · ' + item.statusLabel : ''}}</text>
        </view>
      </block>
      <view class="panel-title" wx:if="{{autoMessageLogs.length}}" style="padding: 24rpx 8rpx 16rpx; color:#888; font-size:24rpx;">系统自动通知（近期）</view>
      <block wx:for="{{autoMessageLogs}}" wx:key="_id">
        <view class="card card-dim">
          <view class="card-top">
            <text class="no">{{item.title}}</text>
            <text class="status">{{item.typeLabel}}</text>
          </view>
          <text class="p-name">{{item.content}}</text>
          <text class="addr-detail">{{item.formatTime}} · {{item.recipientMask}}</text>
        </view>
      </block>
      <view class="empty-tip" wx:if="{{pushCampaigns.length===0 && autoMessageLogs.length===0}}">暂无发送记录</view>
    </block>

    <block wx:if="{{subTabMessage===2}}">
      <block wx:for="{{supportTickets}}" wx:key="_id">
        <view class="card">
          <view class="card-top">
            <text class="no">{{item.topicLabel}}</text>
            <text class="status">{{item.openidMask}}</text>
          </view>
          <text class="p-name">{{item.message}}</text>
          <text class="addr-detail">{{item.formatTime}}</text>
          <view class="btn-row">
            <view class="btn ship" bindtap="openTicketReplyModal" data-item="{{item}}">回复并通知</view>
          </view>
        </view>
      </block>
      <view class="empty-tip" wx:if="{{supportTickets.length===0}}">暂无待回复留言</view>
    </block>
  </block>

  <!-- [Tab 12] 门店管理 -->
  <block wx:if="{{curTab===12}}">
    <view class="panel-title cfg-panel-title">门店管理 · Stores</view>

    <!-- 双店切换：主店 / 工坊 -->
    <view class="store-switch" wx:if="{{adminStores.length}}">
      <view
        class="store-switch-item {{selectedStoreId===item.storeId?'on':''}}"
        wx:for="{{adminStores}}"
        wx:key="storeId"
        bindtap="switchStoreTab"
        data-store-id="{{item.storeId}}"
      >
        <text class="ss-label">{{item.roleLabel || item.name}}</text>
        <text class="ss-sub">{{item.locationLabel || item.floor}}</text>
      </view>
    </view>

    <view class="card cfg-card" wx:if="{{storeTabLoading}}">
      <text class="cfg-hint">加载门店配置中…</text>
    </view>

    <block wx:elif="{{activeStore}}">
      <!-- 今日签到（当前店） -->
      <view class="card visit-stats-card store-visit-card">
        <view class="card-top">
          <text class="no">今日到店签到</text>
          <text class="status gold">本店 {{activeStore.visitCount || 0}} · 合计 {{storeVisitStats.total || 0}}</text>
        </view>
        <text class="cfg-hint" style="margin:0;">财务账本口径固定主店，与此处切换无关。</text>
      </view>

      <!-- 门店概况 -->
      <view class="card cfg-card store-profile-card">
        <view class="card-top">
          <view class="store-title-block">
            <text class="store-name">{{activeStore.name}}</text>
            <text class="store-en" wx:if="{{activeStore.nameEn}}">{{activeStore.nameEn}}</text>
          </view>
          <text class="status {{activeStore.status==='active'?'gold':'muted'}}">{{activeStore.statusLabel}}</text>
        </view>

        <text class="store-tagline" wx:if="{{activeStore.heroTagline}}">{{activeStore.heroTagline}}</text>

        <view class="store-meta-rows">
          <view class="store-meta-row">
            <text class="sm-k">定位</text>
            <text class="sm-v">{{activeStore.roleLabel}} · {{activeStore.locationLabel || activeStore.floor || '—'}}</text>
          </view>
          <view class="store-meta-row">
            <text class="sm-k">地址</text>
            <text class="sm-v">{{activeStore.address || '—'}}</text>
          </view>
          <view class="store-meta-row">
            <text class="sm-k">电话</text>
            <text class="sm-v">{{activeStore.phone || '—'}}</text>
          </view>
          <view class="store-meta-row">
            <text class="sm-k">营业</text>
            <text class="sm-v">{{activeStore.hoursText}}</text>
          </view>
        </view>

        <text class="store-intro" wx:if="{{activeStore.intro}}">{{activeStore.intro}}</text>

        <view class="store-features" wx:if="{{activeStore.features.length}}">
          <text class="store-feature" wx:for="{{activeStore.features}}" wx:key="*this" wx:for-item="feat">{{feat}}</text>
        </view>

        <view class="store-tips" wx:if="{{activeStore.visitTips.length}}">
          <text class="store-tips-title">到店提示</text>
          <text class="store-tip-line" wx:for="{{activeStore.visitTips}}" wx:key="*this" wx:for-item="tip">· {{tip}}</text>
        </view>

        <view class="btn-row store-actions">
          <view class="btn ship" bindtap="openStoreEditModal" data-item="{{activeStore}}">编辑基础信息</view>
        </view>
      </view>

      <!-- 印记码 / 导览点（按当前店过滤） -->
      <view class="card cfg-card atlas-card">
        <view class="card-top">
          <text class="no">图鉴印记 · ATLAS</text>
          <text class="status">{{atlasSpots.length}} 处</text>
        </view>
        <text class="cfg-hint">与山海图鉴共用印记码（如 ATLAS:s1）。做成二维码贴在柜位；客人扫码后会翻开对应页。点按一行即可复制。</text>
        <block wx:if="{{atlasSpots.length}}">
          <view
            class="atlas-row"
            wx:for="{{atlasSpots}}"
            wx:key="id"
            bindtap="copyAtlasCode"
            data-code="{{item.code}}"
          >
            <view class="atlas-row-main">
              <text class="atlas-label">{{item.label}}</text>
              <text class="atlas-hint">{{item.hint}}</text>
            </view>
            <text class="atlas-code">{{item.code}}</text>
          </view>
        </block>
        <text class="cfg-hint" wx:else style="margin:0;">当前门店暂无印记点</text>
      </view>
    </block>

    <!-- 仅真正无数据时显示空态；有兜底或印记列表时不误显 -->
    <view class="empty-tip" wx:elif="{{!storeTabLoading && adminStores.length===0}}">暂无门店配置</view>
  </block>

  <!-- [Tab 13] 超管数据报表 -->
  <block wx:if="{{curTab===13}}">
    <view class="cfg-page report-page">
      <view class="cfg-header">
        <view class="cfg-brand">
          <text class="cfg-en">ANALYTICS · REPORT</text>
          <text class="cfg-cn">数据报表</text>
        </view>
        <text class="cfg-header-note">东八区营业日 · 线上净额 + 双店账本 · 下拉刷新</text>
      </view>

      <view class="card cfg-card report-filter-card">
        <view class="card-top">
          <text class="no">统计周期</text>
          <text class="status gold" wx:if="{{analyticsReport.rangeLabel}}">{{analyticsReport.rangeLabel}}</text>
        </view>
        <view class="btn-row report-day-row">
          <view class="btn ship {{analyticsRangeType==='days' && analyticsDays===7?'active':''}}" bindtap="setAnalyticsDays" data-days="7">近7日</view>
          <view class="btn ship {{analyticsRangeType==='days' && analyticsDays===30?'active':''}}" bindtap="setAnalyticsDays" data-days="30">近30日</view>
          <view class="btn ship {{analyticsRangeType==='days' && analyticsDays===90?'active':''}}" bindtap="setAnalyticsDays" data-days="90">近90日</view>
          <view class="btn ship {{analyticsRangeType==='month'?'active':''}}" bindtap="setAnalyticsMonthMode">自然月</view>
        </view>
        <view class="btn-row report-month-row" wx:if="{{analyticsRangeType==='month'}}">
          <view class="btn ship {{analyticsMonth===analyticsMonthCurrent?'active':''}}" bindtap="setAnalyticsMonthPreset" data-preset="current">本月</view>
          <view class="btn ship {{analyticsMonth===analyticsMonthPrev?'active':''}}" bindtap="setAnalyticsMonthPreset" data-preset="prev">上月</view>
          <picker mode="date" fields="month" value="{{analyticsMonth}}" end="{{analyticsMonthMax}}" bindchange="onAnalyticsMonthPick">
            <view class="btn ship report-month-pick {{analyticsMonth!==analyticsMonthCurrent && analyticsMonth!==analyticsMonthPrev?'active':''}}">{{analyticsMonthLabel}} ▾</view>
          </picker>
        </view>
        <view class="report-notes-toggle" wx:if="{{analyticsReport.notes.length}}" bindtap="toggleAnalyticsNotes">
          <text class="report-notes-label">{{analyticsNotesOpen ? '收起口径说明' : '查看口径说明'}} · {{analyticsReport.notes.length}}</text>
        </view>
        <block wx:if="{{analyticsNotesOpen && analyticsReport.notes.length}}">
          <text class="addr-detail report-note" wx:for="{{analyticsReport.notes}}" wx:key="*this">{{item}}</text>
        </block>
      </view>

      <view class="card cfg-card report-loading" wx:if="{{analyticsLoading}}">
        <text class="cfg-hint">同步经营数据…</text>
      </view>

      <view class="card cfg-card report-error" wx:elif="{{analyticsError}}">
        <text class="cfg-hint">{{analyticsError}}</text>
        <view class="btn ship active" style="margin-top:24rpx;" bindtap="loadAnalyticsDashboard">重试</view>
      </view>

      <block wx:elif="{{!analyticsLoading}}">
        <!-- 数据信号灯（仅超管） -->
        <view class="card cfg-card report-signal-board" wx:if="{{isSuperAdmin && analyticsReport.signals.items.length}}">
          <view class="report-signal-top">
            <view class="report-signal-brand">
              <text class="report-signal-en">TRAFFIC LIGHTS</text>
              <text class="report-signal-cn">数据信号灯</text>
            </view>
            <view class="report-signal-summary">
              <text class="report-signal-chip ok" wx:if="{{analyticsReport.signals.summary.ok}}">正常 {{analyticsReport.signals.summary.ok}}</text>
              <text class="report-signal-chip warn" wx:if="{{analyticsReport.signals.summary.warn}}">关注 {{analyticsReport.signals.summary.warn}}</text>
              <text class="report-signal-chip danger" wx:if="{{analyticsReport.signals.summary.danger}}">告警 {{analyticsReport.signals.summary.danger}}</text>
            </view>
          </view>
          <view class="report-signal-grid">
            <view class="report-signal-item" wx:for="{{analyticsReport.signals.items}}" wx:key="id">
              <view class="report-signal-rail report-signal-rail--{{item.status}}"></view>
              <view class="signal-light {{item.lampClass}}"></view>
              <view class="report-signal-copy">
                <text class="report-signal-name">{{item.name}}</text>
                <text class="report-signal-value report-signal-value--{{item.status}}">{{item.value}}</text>
                <text class="report-signal-status">{{item.statusLabel}}</text>
                <text class="report-signal-reason" wx:if="{{item.reason}}">{{item.reason}}</text>
              </view>
            </view>
          </view>
          <text class="week-split-hint" wx:if="{{analyticsReport.signals.rulesNote}}">{{analyticsReport.signals.rulesNote}}</text>
        </view>

        <!-- 总览 KPI -->
        <view class="card cfg-card report-hero">
          <view class="report-hero-top">
            <text class="report-hero-en">COMBINED REVENUE</text>
            <text class="report-hero-label">综合营收</text>
          </view>
          <text class="report-hero-value">¥{{analyticsReport.headline.grandTotalFmt || '0.00'}}</text>
          <view class="stock-mini-row report-hero-row">
            <view class="stock-mini-cell">
              <text class="stock-mini-v accent">¥{{analyticsReport.headline.netOnlineFmt || '0.00'}}</text>
              <text class="stock-mini-l">线上净额</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">¥{{analyticsReport.headline.offlineLedgerFmt || '0.00'}}</text>
              <text class="stock-mini-l">门店账本（双店）</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">¥{{analyticsReport.headline.refundAmountFmt || '0.00'}}</text>
              <text class="stock-mini-l">周期退款</text>
            </view>
          </view>
          <view class="report-ledger-split" wx:if="{{analyticsReport.ledgerByStore.length}}">
            <text class="report-ledger-title">门店账本分列</text>
            <view class="report-share-row" wx:for="{{analyticsReport.ledgerByStore}}" wx:key="storeId">
              <view class="report-share-head">
                <text class="report-share-l">{{item.name}}</text>
                <text class="report-share-p">{{item.pct}}%</text>
              </view>
              <view class="report-share-track">
                <view class="report-share-fill {{index === 0 ? 'brass' : 'forest'}}" style="{{item.barStyle}}"></view>
              </view>
              <text class="report-share-val">¥{{item.valueFmt}}</text>
            </view>
          </view>
          <view class="stock-mini-row" style="margin-top:16rpx;">
            <view class="stock-mini-cell">
              <text class="stock-mini-v">{{analyticsReport.headline.paidOrders || 0}}</text>
              <text class="stock-mini-l">已付单</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">{{analyticsReport.headline.aovFmt || '—'}}</text>
              <text class="stock-mini-l">客单价</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">{{analyticsReport.headline.avgDau || 0}}</text>
              <text class="stock-mini-l">日均 DAU</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v accent">{{analyticsReport.headline.newUsers || 0}}</text>
              <text class="stock-mini-l">新增用户</text>
            </view>
          </view>
          <view class="report-channel" wx:if="{{analyticsReport.channelMix.length}}">
            <view class="report-share-row" wx:for="{{analyticsReport.channelMix}}" wx:key="key">
              <view class="report-share-head">
                <text class="report-share-l">{{item.label}}</text>
                <text class="report-share-p">{{item.pct}}%</text>
              </view>
              <view class="report-share-track">
                <view class="report-share-fill {{item.tone}}" style="{{item.barStyle}}"></view>
              </view>
              <text class="report-share-val">¥{{item.valueFmt}}</text>
            </view>
          </view>
          <text class="week-split-hint" wx:if="{{analyticsReport.empty}}">该周期暂无已付订单与门店入账</text>
        </view>

        <!-- 营收趋势：线上净额 + 门店 -->
        <view class="section-title">营收趋势</view>
        <view class="card">
          <view class="card-top">
            <text class="no">综合 / 日</text>
            <view class="legend-row report-legend">
              <view class="dot gold"></view><text>线上净额</text>
              <view class="dot forest"></view><text>门店</text>
            </view>
          </view>
          <view class="trend-bars report-bars" style="{{chartLayout.trendBarsStyle}}" wx:if="{{analyticsReport.charts.revenue.length}}">
            <block wx:for="{{analyticsReport.charts.revenue}}" wx:key="dateKey">
              <view class="bar-col">
                <view class="bar-val-slot"><text class="bar-val" style="{{chartLayout.valFontStyle}}" wx:if="{{item.showVal}}">{{item.valShort}}</text></view>
                <view class="bar-track" style="{{chartLayout.barTrackStyle}}">
                  <view class="bar-fill gold" style="{{item.styleOnline}}"></view>
                  <view class="bar-fill forest" style="{{item.styleOffline}}"></view>
                </view>
                <text class="bar-lbl" style="{{chartLayout.lblFontStyle}}">{{item.day}}</text>
              </view>
            </block>
          </view>
          <text class="chart-empty-hint" wx:else>该周期暂无营收趋势</text>
          <text class="week-split-hint" wx:if="{{analyticsReport.chartHint}}">{{analyticsReport.chartHint}}</text>
        </view>

        <!-- 订单结构 -->
        <view class="section-title">订单与结构</view>
        <view class="card visit-stats-card">
          <view class="card-top"><text class="no">周期合计</text></view>
          <view class="stock-mini-row">
            <view class="stock-mini-cell">
              <text class="stock-mini-v accent">{{analyticsReport.orders.totals.orders || 0}}</text>
              <text class="stock-mini-l">下单</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">{{analyticsReport.orders.totals.paid || 0}}</text>
              <text class="stock-mini-l">已支付</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">{{analyticsReport.orders.totals.unpaid || 0}}</text>
              <text class="stock-mini-l">未支付</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">{{analyticsReport.orders.totals.refunded || 0}}</text>
              <text class="stock-mini-l">退款单</text>
            </view>
          </view>
          <view class="stock-mini-row" style="margin-top:16rpx;">
            <view class="stock-mini-cell">
              <text class="stock-mini-v accent">¥{{analyticsReport.orders.totals.gmvPaidFmt || '0.00'}}</text>
              <text class="stock-mini-l">毛 GMV</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">¥{{analyticsReport.orders.totals.netOnlineFmt || '0.00'}}</text>
              <text class="stock-mini-l">线上净额</text>
            </view>
            <view class="stock-mini-cell">
              <text class="stock-mini-v">{{analyticsReport.orders.totals.aovFmt || '—'}}</text>
              <text class="stock-mini-l">客单价</text>
            </view>
          </view>
          <text class="week-split-hint" wx:if="{{analyticsReport.orders.truncated}}">订单为采样统计，见口径说明</text>
