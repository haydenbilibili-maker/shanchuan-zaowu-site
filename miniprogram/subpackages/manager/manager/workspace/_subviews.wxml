          </view>
          <view class="om-sku-list" wx:if="{{item.skuList.length}}">
            <block wx:for="{{item.skuList}}" wx:for-item="prod" wx:for-index="pIdx" wx:key="key">
              <view class="om-sku-row" wx:if="{{item.skuExpanded || pIdx < 3}}">
                <image class="om-sku-thumb" src="{{prod.image}}" mode="aspectFill"></image>
                <view class="om-sku-body">
                  <text class="om-sku-title">{{prod.title}}</text>
                  <text class="om-sku-spec" wx:if="{{prod.skuLabel}}">{{prod.skuLabel}}</text>
                  <view class="om-sku-meta">
                    <text class="om-sku-qty">×{{prod.count}}</text>
                    <text class="om-sku-price" wx:if="{{prod.lineText || prod.priceText}}">{{prod.lineText || prod.priceText}}</text>
                  </view>
                </view>
              </view>
            </block>
            <view class="om-sku-more" wx:if="{{item.skuOverflow}}" catchtap="toggleOrderSkuExpand" data-id="{{item._id}}" data-scope="refunds">{{item.skuExpanded ? '收起藏品' : ('展开其余 ' + item.skuHiddenCount + ' 件')}}</view>
          </view>
          <view class="om-refund-box">
            <text class="om-refund-amt">{{item.refundAmountHint || ('退款 ' + item.amountText)}}</text>
            <text class="om-refund-rule" wx:if="{{item.refundPolicyLabel}}">规则：{{item.refundPolicyLabel}}</text>
            <text class="om-refund-note" wx:if="{{item.refundNote}}">原因：{{item.refundNote}}</text>
            <view class="om-miss-video" wx:if="{{item.missingUnboxVideo}}">缺开箱影像</view>
            <view class="om-evidence" wx:if="{{item.hasEvidenceMedia}}">
              <video
                wx:if="{{item.unboxVideoUrl}}"
                class="om-evidence-video"
                src="{{item.unboxVideoUrl}}"
                controls
                object-fit="contain"
                show-center-play-btn
              ></video>
              <view class="om-evidence-imgs" wx:if="{{item.evidenceImageUrls.length}}">
                <image
                  wx:for="{{item.evidenceImageUrls}}"
                  wx:for-item="img"
                  wx:for-index="imgIdx"
                  wx:key="*this"
                  class="om-evidence-img"
                  src="{{img}}"
                  mode="aspectFill"
                  catchtap="previewRefundEvidenceImage"
                  data-id="{{item._id}}"
                  data-idx="{{imgIdx}}"
                ></image>
              </view>
            </view>
          </view>
          <view class="om-addr om-addr-copyable" wx:if="{{item.address && item.addressCopyText}}" catchtap="copyOrderAddress" data-id="{{item._id}}" data-scope="refunds" hover-class="om-addr-press" hover-stay-time="80">
            <image class="om-addr-icon" src="/subpackages/manager/assets/icons/location.png" mode="aspectFit"></image>
            <view class="om-addr-body">
              <text class="om-addr-title">{{item.address.name}} {{item.address.phone}}</text>
              <text class="om-addr-sub">{{item.addressLine || item.address.detail}}</text>
            </view>
            <text class="om-addr-copy">复制</text>
          </view>
          <view class="om-foot">
            <view class="om-foot-left">
              <text class="om-amount-label">原单</text>
              <text class="om-amount">{{item.amountText}}</text>
              <text class="om-count-hint">共 {{item.totalCount}} 件</text>
            </view>
            <view class="om-foot-actions" wx:if="{{item.status==='refunding' || item.status==='aftersales' || item.status==='expired_refunding'}}">
              <view class="om-btn ghost" wx:if="{{item.storeReturnPending}}" bindtap="confirmPickupReturn" data-id="{{item._id}}">确认收回藏品</view>
              <view class="om-btn refund" wx:else bindtap="handleRefund" data-id="{{item._id}}">{{item.status==='expired_refunding' ? '执行过期退款' : '同意退款'}}</view>
            </view>
            <text class="om-return-hint" wx:if="{{item.storeReturnPending}}">门店自取逆向：确认已收到顾客送回门店的藏品后才能退款</text>
          </view>
        </view>
      </block>
      <view class="om-empty" wx:if="{{!refundsLoading && !refundsView.length}}">
        <text class="om-empty-title">{{omQuery ? '无匹配售后单' : '暂无售后申请'}}</text>
        <text class="om-empty-desc">{{omQuery ? '试试换个单号或手机号' : '下拉刷新可同步最新售后'}}</text>
      </view>
    </block>

    <block wx:elif="{{subTab===4}}">
      <!-- 待支付 / 待确认：支付回调异常时的人工补履约入口，仅超管可操作 -->
      <block wx:for="{{pendingPayOrdersView}}" wx:key="_id">
        <view class="om-card">
          <view class="om-card-head">
            <view class="om-head-main">
              <text class="om-no">NO. {{item.orderNo}}</text>
              <text class="om-time" wx:if="{{item.formatTime}}">{{item.formatTime}}</text>
            </view>
            <view class="om-status-wrap">
              <text class="om-status warn">{{item.statusLabel || '待支付 / 待确认'}}</text>
              <text class="gift-tag" wx:if="{{item.isGiftOrder}}">礼赠</text>
            </view>
          </view>
          <view class="om-buyer" wx:if="{{item.buyer}}">
            <image
              wx:if="{{item.buyer.hasAvatar}}"
              class="om-buyer-avatar"
              src="{{item.buyer.avatarUrl}}"
              mode="aspectFill"
            ></image>
            <view class="om-buyer-avatar om-buyer-avatar-ph" wx:else>
              <text>{{item.buyer.avatarInitial}}</text>
            </view>
            <view class="om-buyer-body">
              <text class="om-buyer-label">下单会员</text>
              <text class="om-buyer-name">{{item.buyer.nickName}}</text>
              <text class="om-buyer-phone">{{item.buyer.hasPhone ? item.buyer.phoneMasked : '未留手机'}}</text>
            </view>
            <view
              class="om-buyer-msg"
              wx:if="{{menu.support && item.buyer.openid}}"
              catchtap="openYouxinForBuyer"
              data-openid="{{item.buyer.openid}}"
              data-nick="{{item.buyer.nickName}}"
              hover-class="om-buyer-msg-press"
              hover-stay-time="80"
            >私信</view>
          </view>
          <view class="om-sku-list" wx:if="{{item.skuList.length}}">
            <block wx:for="{{item.skuList}}" wx:for-item="prod" wx:for-index="pIdx" wx:key="key">
              <view class="om-sku-row" wx:if="{{item.skuExpanded || pIdx < 3}}">
                <image class="om-sku-thumb" src="{{prod.image}}" mode="aspectFill"></image>
                <view class="om-sku-body">
                  <text class="om-sku-title">{{prod.title}}</text>
                  <text class="om-sku-spec" wx:if="{{prod.skuLabel}}">{{prod.skuLabel}}</text>
                  <view class="om-sku-meta">
                    <text class="om-sku-qty">×{{prod.count}}</text>
                    <text class="om-sku-price" wx:if="{{prod.lineText || prod.priceText}}">{{prod.lineText || prod.priceText}}</text>
                  </view>
                </view>
              </view>
            </block>
            <view class="om-sku-more" wx:if="{{item.skuOverflow}}" catchtap="toggleOrderSkuExpand" data-id="{{item._id}}" data-scope="pendingPayOrders">{{item.skuExpanded ? '收起藏品' : ('展开其余 ' + item.skuHiddenCount + ' 件')}}</view>
          </view>
          <view class="om-sku-empty" wx:else><text>暂无藏品明细</text></view>
          <view class="om-addr om-addr-copyable" wx:if="{{item.address}}" catchtap="copyOrderAddress" data-id="{{item._id}}" data-scope="pendingPayOrders" hover-class="om-addr-press" hover-stay-time="80">
            <image class="om-addr-icon" src="/subpackages/manager/assets/icons/location.png" mode="aspectFit"></image>
            <view class="om-addr-body">
              <text class="om-addr-title">{{item.address.name}} {{item.address.phone}}</text>
              <text class="om-addr-sub">{{item.addressLine || item.address.detail}}</text>
            </view>
            <text class="om-addr-copy">复制</text>
          </view>
          <view class="om-foot">
            <view class="om-foot-left">
              <text class="om-amount-label">应付</text>
              <text class="om-amount">{{item.amountText}}</text>
              <text class="om-count-hint">共 {{item.totalCount}} 件</text>
            </view>
            <view class="om-foot-actions" wx:if="{{workspaceRole==='super_admin'}}">
              <view class="om-btn ship" bindtap="fulfillPaidOrder" data-id="{{item._id}}">补履约</view>
            </view>
            <view class="om-foot-actions" wx:else>
              <view class="om-btn ship disabled">仅超管可补履约</view>
            </view>
          </view>
        </view>
      </block>
      <view class="om-empty" wx:if="{{!pendingPayOrdersLoading && !pendingPayOrdersView.length}}">
        <text class="om-empty-title">{{omQuery ? '无匹配待支付订单' : '暂无待支付 / 待确认订单'}}</text>
        <text class="om-empty-desc">{{omQuery ? '试试换个单号或手机号' : '支付回调异常时，超管可在此补履约（先核对微信商户平台流水）'}}</text>
      </view>
    </block>

    <view
      class="om-load-more"
      wx:if="{{(subTab===0 && ordersHasMore) || (subTab===1 && shippedOrdersHasMore) || (subTab===2 && completedOrdersHasMore) || (subTab===3 && refundsHasMore) || (subTab===4 && pendingPayOrdersHasMore)}}"
      bindtap="loadMoreOmOrders"
    >{{omLoadingMore ? '加载中…' : '加载更多'}}</view>
  </block>

  <!-- [Tab 3] 核销验票 -->
  <block wx:if="{{curTab===3}}">
    <view class="section-header verify-live-head">
      <view class="signal-light {{bookings.length > 0 ? 'blink' : ''}}"></view>
      <text>今日预约 ({{bookings.length}})</text>
    </view>
    <view class="scan-hint">扫描顾客会员码核验权益，或扫描预约票核销入场</view>
    <block wx:for="{{bookings}}" wx:key="_id">
      <view class="verify-card">
        <view class="vc-left"><text class="vc-time">{{item.time}}</text><text class="vc-status">待核销</text></view>
        <view class="vc-mid"><text class="vc-name">{{item.title}}</text><text class="vc-desc">{{item.people}}人 · {{item.name}}<text wx:if="{{item.storeName}}"> · {{item.storeName}}</text><text wx:if="{{item.customMeta}}"> · 含定制方案</text></text></view>
        <view class="vc-btn" bindtap="verifyBooking" data-id="{{item._id}}">确认</view>
      </view>
    </block>
    <view class="fab-add scan" bindtap="handleScan"><image class="fab-scan-icon" src="/assets/icons/qrcode.png" mode="aspectFit" /></view>
  </block>

  <!-- [Tab 4] 店铺装修 -->
  <block wx:if="{{curTab===4}}">
    <view class="section-title">预约页头图</view>
    <view class="manage-card hero-edit-card">
      <image src="{{bookingHero || defaultBookingHero}}" mode="aspectFill" class="hero-preview"></image>
      <view class="card-actions right">
        <view class="btn-small gold" bindtap="changeBookingHero">更换图片</view>
      </view>
    </view>
    <view class="section-title">轮播图配置</view>
    <view class="banner-list">
      <block wx:for="{{banners}}" wx:key="_id">
        <view class="banner-item">
          <image class="b-thumb" src="{{item.image}}" mode="aspectFill"></image>
          <view class="b-info">
            <text class="b-title">{{item.title}}</text>
            <text class="b-sub">{{item.subtitle || '无副标题'}}</text>
            <view class="b-tag">跳转： {{item.type}} · {{item.enabled === false ? '已关闭' : '展示中'}}</view>
          </view>
          <view class="b-actions">
             <view class="action-btn edit" bindtap="openBannerModal" data-id="{{item._id}}">✎</view>
             <view class="action-btn del" bindtap="deleteBanner" data-id="{{item._id}}">✕</view>
          </view>
        </view>
      </block>
    </view>
    <view class="fab-add" bindtap="openBannerModal">+</view>
  </block>

  <!-- [Tab 5] 标本师管理 -->
  <block wx:if="{{curTab===5}}">
    <view class="framer-admin-header">
      <view class="framer-admin-brand">
        <text class="framer-admin-en">ARTISANS</text>
        <text class="framer-admin-cn">标本师管理</text>
      </view>
      <view class="add-btn-gold" bindtap="openFramerModal"><text class="plus">+</text><text>新增</text></view>
    </view>

    <view class="framer-stats" wx:if="{{framerAdminStats.total}}">
      <view class="framer-stat">
        <text class="framer-stat-n">{{framerAdminStats.total}}</text>
        <text class="framer-stat-l">档案</text>
      </view>
      <view class="framer-stat-div"></view>
      <view class="framer-stat">
        <text class="framer-stat-n">{{framerAdminStats.active}}</text>
        <text class="framer-stat-l">上架</text>
      </view>
      <view class="framer-stat-div"></view>
      <view class="framer-stat">
        <text class="framer-stat-n">{{framerAdminStats.bound}}</text>
        <text class="framer-stat-l">已绑员工</text>
      </view>
      <view class="framer-stat-div"></view>
      <view class="framer-stat {{framerAdminStats.duplicateNames ? 'warn' : ''}}">
        <text class="framer-stat-n">{{framerAdminStats.duplicateNames}}</text>
        <text class="framer-stat-l">同名组</text>
      </view>
    </view>

    <view class="framer-search-row">
      <input
        class="framer-search-input"
        value="{{framerQuery}}"
        bindinput="onFramerQueryInput"
        placeholder="搜姓名 / 员工"
        placeholder-class="framer-search-ph"
        confirm-type="search"
      />
      <view class="framer-search-clear" wx:if="{{framerQuery}}" bindtap="clearFramerQuery">清除</view>
    </view>

    <view class="framer-filter-row">
      <view class="framer-chip {{framerTypeFilter==='all'?'on':''}}" bindtap="setFramerTypeFilter" data-value="all">全部</view>
      <view class="framer-chip {{framerTypeFilter==='store'?'on':''}}" bindtap="setFramerTypeFilter" data-value="store">门店</view>
      <view class="framer-chip {{framerTypeFilter==='partner'?'on':''}}" bindtap="setFramerTypeFilter" data-value="partner">特邀</view>
      <view class="framer-chip-gap"></view>
      <view class="framer-chip {{framerStatusFilter==='all'?'on':''}}" bindtap="setFramerStatusFilter" data-value="all">状态</view>
      <view class="framer-chip {{framerStatusFilter==='active'?'on':''}}" bindtap="setFramerStatusFilter" data-value="active">上架</view>
      <view class="framer-chip {{framerStatusFilter==='off'?'on':''}}" bindtap="setFramerStatusFilter" data-value="off">下架</view>
      <view class="framer-chip {{framerDupOnly?'on warn':''}}" bindtap="toggleFramerDupOnly">重复</view>
    </view>

    <view class="empty-tip" wx:if="{{framerLoading}}">加载中…</view>
    <view class="empty-tip" wx:elif="{{!framersView.length}}">{{framerQuery || framerDupOnly || framerTypeFilter!=='all' || framerStatusFilter!=='all' ? '无匹配标本师' : '暂无标本师档案'}}</view>

    <block wx:for="{{framersView}}" wx:key="_id">
      <view class="framer-card {{item.active ? '' : 'off'}} {{item.isDuplicate ? 'dup' : ''}}">
        <image
          class="f-avatar"
          src="{{item.avatar || '/assets/icons/user.png'}}"
          mode="aspectFill"
          bindtap="openFramerPublic"
          data-id="{{item._id}}"
        ></image>
        <view class="f-main">
          <view class="f-title-row">
            <text class="f-name">{{item.name}}</text>
            <text class="f-tag type">{{item.typeLabel || '门店'}}</text>
            <text class="f-tag {{item.active ? 'on' : 'off'}}">{{item.statusLabel || (item.active ? '上架' : '下架')}}</text>
            <text class="f-tag canon" wx:if="{{item.isCanonical}}">权威</text>
            <text class="f-tag dup" wx:if="{{item.isDuplicate}}">同名×{{item.duplicateCount}}</text>
          </view>
          <view class="f-meta-row">
            <text class="f-meta">作品 {{item.worksCount || 0}}</text>
            <text class="f-meta-dot">·</text>
            <text class="f-meta" wx:if="{{item.staffBound}}">已绑 {{item.staffName || ('…' + item.staffOpenidTail)}}</text>
            <text class="f-meta muted" wx:else>未绑员工</text>
          </view>
          <view class="f-actions">
            <view class="f-act" catchtap="openFramerPublic" data-id="{{item._id}}">公开档案</view>
            <view class="f-act" catchtap="openFramerModal" data-id="{{item._id}}">编辑</view>
            <view class="f-act" catchtap="openFramerBindSheet" data-id="{{item._id}}">{{item.staffBound ? '换绑' : '绑员工'}}</view>
            <view
              class="f-act"
              catchtap="toggleFramerActive"
              data-id="{{item._id}}"
              data-active="{{item.active ? '1' : '0'}}"
            >{{item.active ? '下架' : '上架'}}</view>
            <view
              class="f-act accent"
              wx:if="{{item.staffBound && !item.isCanonical}}"
              catchtap="pinFramerCanonical"
              data-id="{{item._id}}"
            >设权威</view>
            <view
              class="f-act warn"
              wx:if="{{item.isDuplicate && item.staffBound}}"
              catchtap="resolveFramerDuplicates"
              data-id="{{item._id}}"
            >处理重复</view>
          </view>
        </view>
      </view>
    </block>
  </block>

  <!-- [Tab 14] 标本师合作申请 -->
  <block wx:if="{{curTab===14}}">
    <view class="sub-tab-row">
      <view class="sub-tab {{framerRecruitFilter==='pending'?'active':''}}" bindtap="switchFramerRecruitFilter" data-status="pending">待跟进</view>
      <view class="sub-tab {{framerRecruitFilter==='contacted'?'active':''}}" bindtap="switchFramerRecruitFilter" data-status="contacted">已联系</view>
      <view class="sub-tab {{framerRecruitFilter==='accepted'?'active':''}}" bindtap="switchFramerRecruitFilter" data-status="accepted">已通过</view>
      <view class="sub-tab {{framerRecruitFilter==='rejected'?'active':''}}" bindtap="switchFramerRecruitFilter" data-status="rejected">未通过</view>
      <view class="sub-tab {{framerRecruitFilter==='all'?'active':''}}" bindtap="switchFramerRecruitFilter" data-status="all">全部</view>
    </view>
    <block wx:for="{{framerRecruitApps}}" wx:key="_id">
      <view class="card">
        <view class="card-top">
          <text class="no">{{item.contactName}}</text>
          <text class="status used">{{item.statusLabel}}</text>
        </view>
        <view class="products">
          <text class="p-name">{{item.phone}}<text wx:if="{{item.wechat}}"> · 微信 {{item.wechat}}</text></text>
          <text class="p-name" wx:if="{{item.city}}">城市：{{item.city}}</text>
          <text class="p-name" wx:if="{{item.categoryText}}">品类：{{item.categoryText}}</text>
          <text class="p-name" wx:if="{{item.intentText}}">意向：{{item.intentText}}</text>
          <text class="p-name" wx:if="{{item.experience}}">经验：{{item.experience}}</text>
          <text class="p-name" wx:if="{{item.note}}">备注：{{item.note}}</text>
        </view>
        <view class="address-box"><text class="addr-detail">{{item.formatTime}}</text></view>
        <view class="btn-row">
          <view class="btn verify" bindtap="copyFramerRecruitText" data-item="{{item}}">复制详情</view>
          <view class="btn ship" wx:if="{{item.status==='pending'}}" bindtap="updateFramerRecruitStatus" data-id="{{item._id}}" data-status="contacted">标记已联系</view>
          <view class="btn ship" wx:if="{{item.status!=='accepted'}}" bindtap="updateFramerRecruitStatus" data-id="{{item._id}}" data-status="accepted">通过</view>
          <view class="btn ship" wx:if="{{item.status!=='rejected'}}" bindtap="updateFramerRecruitStatus" data-id="{{item._id}}" data-status="rejected">未通过</view>
        </view>
      </view>
    </block>
    <view class="empty-tip" wx:if="{{framerRecruitApps.length===0}}">暂无合作申请</view>
  </block>

  <!-- [Tab 6] 权益会员 -->
  <block wx:if="{{curTab===6}}">
    <view class="sub-tab-row">
      <view class="sub-tab {{subTabReward===0?'active':''}}" bindtap="switchSubTabReward" data-idx="0">积分藏品</view>
