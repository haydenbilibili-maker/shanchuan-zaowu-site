                  <text class="om-sku-title">{{prod.title}}</text>
                  <text class="om-sku-spec" wx:if="{{prod.skuLabel}}">{{prod.skuLabel}}</text>
                  <view class="om-sku-meta">
                    <text class="om-sku-qty">×{{prod.count}}</text>
                    <text class="om-sku-price" wx:if="{{prod.lineText || prod.priceText}}">{{prod.lineText || prod.priceText}}</text>
                  </view>
                </view>
