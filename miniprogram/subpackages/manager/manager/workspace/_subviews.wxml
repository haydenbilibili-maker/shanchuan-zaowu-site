                  <input class="sku-field sku-input third" type="digit" placeholder="长" placeholder-class="sku-ph" value="{{item.sizeL}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeL"/>
                  <input class="sku-field sku-input third" type="digit" placeholder="宽" placeholder-class="sku-ph" value="{{item.sizeW}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeW"/>
                  <input class="sku-field sku-input third" type="digit" placeholder="厚度" placeholder-class="sku-ph" value="{{item.sizeH}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeH"/>
                </view>
                <view class="sku-size-row" wx:else>
                  <input class="sku-field sku-input third" type="digit" placeholder="长" placeholder-class="sku-ph" value="{{item.sizeL}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeL"/>
                  <input class="sku-field sku-input third" type="digit" placeholder="宽" placeholder-class="sku-ph" value="{{item.sizeW}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeW"/>
                  <input class="sku-field sku-input third" type="digit" placeholder="高" placeholder-class="sku-ph" value="{{item.sizeH}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeH"/>
                </view>
                <input class="sku-field sku-input full" placeholder="尺寸展示文案（可空，如：直径 20 厘米）" placeholder-class="sku-ph" value="{{item.sizeText}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="sizeText"/>
              </view>
              <view class="sku-images-row">
