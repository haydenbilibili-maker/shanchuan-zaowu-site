<!-- ==================== 3. 子视图：功能模块 ==================== -->
<view class="content-area sub-view sub-view-enter" wx:if="{{curTab !== 0}}">
  
  <!-- 🟢 [Tab 8] 营收录入 (仅此处微调类名以适配新CSS) -->
  <block wx:if="{{curTab===8}}">
    <view class="ledger-header">
       <view class="lh-left"><text class="lh-en">FINANCIAL</text><text class="lh-cn">财务月报</text></view>
       <view class="ledger-actions">
         <view class="add-btn-ghost" wx:if="{{isSuperAdmin}}" bindtap="reconcileMpOrders"><text>商城对账</text></view>
         <view class="add-btn-gold" bindtap="openRevenueModal"><text class="plus">+</text> <text>记一笔</text></view>
       </view>
    </view>
    <view class="ledger-month-bar">
      <picker mode="date" fields="month" value="{{ledgerMonth}}" bindchange="onLedgerMonthChange">
        <view class="ledger-month-picker">
          <text class="lmp-en">MONTH</text>
          <text class="lmp-value">{{ledgerMonthLabel}}</text>
          <text class="lmp-arrow">▾</text>
        </view>
      </picker>
      <text class="ledger-month-hint">切换月份可查看该月全部日流水</text>
    </view>
    <scroll-view scroll-x class="ledger-store-tabs" wx:if="{{ledgerStoreOptions.length}}">
      <view class="ledger-store-tabs-inner">
        <view
          class="ledger-store-tab {{ledgerStoreId === item.storeId ? 'on' : ''}}"
          wx:for="{{ledgerStoreOptions}}"
          wx:key="storeId"
          data-id="{{item.storeId}}"
          bindtap="onLedgerStoreChange"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <!-- 当月财务总览（对齐 Admin 月报：Σ NET + 渠道拆分 + 订单 KPI） -->
    <view class="ledger-overview" wx:if="{{ledgerOverviewReady && !ledgerOverview.empty}}">
      <view class="lo-hero">
        <text class="lo-en">MONTHLY NET</text>
        <view class="lo-net-row">
          <text class="lo-net">¥{{ledgerOverview.netFmt}}</text>
          <view
            class="signal-light lo-sync-lamp {{ledgerSyncLampClass}}"
            catchtap="onLedgerSyncLampTap"
            catchlongpress="onLedgerSyncLampTap"
            aria-role="button"
            aria-label="{{ledgerSyncTip}}"
          ></view>
        </view>
        <text class="lo-meta">{{ledgerMonthLabel}} · 有营业 {{ledgerOverview.daysWithData}} 天 · 日均营收 ¥{{ledgerOverview.dailyRevFmt}}</text>
      </view>
      <view class="lo-metrics">
        <view class="lo-m">
          <text class="lo-m-l">刷卡｜POS</text>
          <text class="lo-m-v">¥{{ledgerOverview.posFmt}}</text>
        </view>
        <view class="lo-m">
          <text class="lo-m-l">现金余额｜在手</text>
          <text class="lo-m-v">¥{{ledgerOverview.cashBalanceFmt}}</text>
        </view>
        <view class="lo-m">
          <text class="lo-m-l">小程序｜GMV</text>
          <text class="lo-m-v">¥{{ledgerOverview.mpOnlineFmt}}</text>
        </view>
        <view class="lo-m warn">
          <text class="lo-m-l">小程序退款</text>
          <text class="lo-m-v">-¥{{ledgerOverview.mpRefundFmt}}</text>
        </view>
        <view class="lo-m pledge">
          <text class="lo-m-l">应捐｜1%</text>
          <text class="lo-m-v">¥{{ledgerOverview.pledgeDueFmt}}</text>
        </view>
        <view class="lo-m warn">
          <text class="lo-m-l">退款｜门店</text>
          <text class="lo-m-v">-¥{{ledgerOverview.refundFmt}}</text>
        </view>
      </view>
      <text class="lo-meta lo-pledge-hint">应捐 = 小程序净GMV（GMV−退款）×1%，不含 POS / 现金 / 遗留线上</text>
      <text class="lo-meta" wx:if="{{ledgerOverview.legacyOnlineHint}}" style="margin-top:8rpx;">{{ledgerOverview.legacyOnlineHint}}</text>

      <!-- 商场月累计超额抽成（与 ERP 财务核算 / 股东观测台同源） -->
      <view class="lo-mall" wx:if="{{ledgerOverview.mall}}">
        <view class="lo-kpi-title"><text class="lo-pt-cn">商场抽成</text><text class="lo-pt-en">｜MALL FEE</text></view>
        <view class="lo-mall-grid">
          <view class="lo-mall-cell">
            <text class="lo-mall-l">抽成阈值</text>
            <text class="lo-mall-v">¥{{ledgerOverview.mall.thresholdFmt}}</text>
          </view>
          <view class="lo-mall-cell">
            <text class="lo-mall-l">已达额度</text>
            <text class="lo-mall-v">¥{{ledgerOverview.mall.reachedFmt}}</text>
          </view>
          <view class="lo-mall-cell">
            <text class="lo-mall-l">超额金额</text>
            <text class="lo-mall-v">¥{{ledgerOverview.mall.excessFmt}}</text>
          </view>
          <view class="lo-mall-cell highlight">
            <text class="lo-mall-l">抽成金额</text>
            <text class="lo-mall-v brass">¥{{ledgerOverview.mall.feeFmt}}</text>
          </view>
        </view>
        <text class="lo-meta lo-mall-hint">{{ledgerOverview.mall.formulaNote}}</text>
      </view>

      <view class="lo-kpi">
        <view class="lo-kpi-title"><text class="lo-pt-cn">订单经营</text><text class="lo-pt-en">｜ORDERS</text></view>
        <view class="lo-kpi-grid">
          <view class="lo-kpi-item">
            <text class="lo-kpi-l">总订单数</text>
            <text class="lo-kpi-v">{{ledgerOverview.totalOrderCountFmt}}</text>
            <text class="lo-kpi-u">单</text>
          </view>
          <view class="lo-kpi-item">
            <text class="lo-kpi-l">客单价｜AOV</text>
            <text class="lo-kpi-v {{ledgerOverview.hasOrderData ? '' : 'muted'}}">{{ledgerOverview.hasOrderData ? '¥' : ''}}{{ledgerOverview.avgOrderPriceFmt}}</text>
            <text class="lo-kpi-u">营收/单</text>
          </view>
          <view class="lo-kpi-item">
            <text class="lo-kpi-l">日均订单</text>
            <text class="lo-kpi-v">{{ledgerOverview.dailyOrdersFmt}}</text>
            <text class="lo-kpi-u">单/营业日</text>
          </view>
          <view class="lo-kpi-item">
            <text class="lo-kpi-l">日均营收</text>
            <text class="lo-kpi-v">¥{{ledgerOverview.dailyRevFmt}}</text>
            <text class="lo-kpi-u">元/营业日</text>
          </view>
        </view>
        <text class="lo-kpi-hint">{{ledgerOverview.orderHint}}</text>
      </view>
      <view class="lo-panel">
        <view class="lo-ptitle"><text class="lo-pt-cn">日净额趋势</text><text class="lo-pt-en">｜TREND</text></view>
        <view class="lo-trend">
          <block wx:for="{{ledgerOverview.trend}}" wx:key="date">
            <view class="lo-bar-col">
              <view class="lo-bar-track">
                <view class="lo-bar-fill" style="{{item.barStyle}}"></view>
              </view>
              <text class="lo-bar-lbl">{{item.label}}</text>
            </view>
          </block>
        </view>
      </view>
      <view class="lo-panel">
        <view class="lo-ptitle"><text class="lo-pt-cn">渠道占比</text><text class="lo-pt-en">｜CHANNEL</text></view>
        <view class="lo-channel-row">
          <view class="lo-donut-wrap">
            <view class="lo-donut" style="{{ledgerOverview.donutStyle}}"></view>
            <view class="lo-donut-legend">
              <view class="lo-leg"><view class="lo-dot brass"></view><text>刷卡</text></view>
              <view class="lo-leg"><view class="lo-dot forest"></view><text>小程序</text></view>
            </view>
          </view>
          <view class="lo-shares">
            <block wx:for="{{ledgerOverview.channels}}" wx:key="key">
              <view class="lo-share">
                <view class="lo-share-head">
                  <text class="lo-share-l">{{item.label}}</text>
                  <text class="lo-share-p">{{item.pct}}%</text>
                </view>
                <view class="lo-share-track">
                  <view class="lo-share-fill {{item.color}}" style="{{item.barStyle}}"></view>
                </view>
                <text class="lo-share-val">¥{{item.valueFmt}}</text>
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>
    <view class="ledger-overview lo-empty" wx:elif="{{ledgerOverviewReady}}">
      <view class="lo-net-row lo-empty-row">
        <text class="lo-empty-en">NO DATA</text>
        <view
          class="signal-light lo-sync-lamp {{ledgerSyncLampClass}}"
          catchtap="onLedgerSyncLampTap"
          catchlongpress="onLedgerSyncLampTap"
        ></view>
      </view>
      <text class="lo-empty-cn">本月暂无入账，总览与图表待数据就绪后展示</text>
    </view>

    <view class="revenue-list">
       <block wx:for="{{revenues}}" wx:key="_id">
          <view class="bill-card">
             <view class="bill-edge top"></view>
             <view class="bill-body">
                <view class="bill-main">
                   <view class="bm-left"><text class="bm-day">{{item.day}}</text><text class="bm-date">{{item.date}}</text></view>
                   <view class="bm-right"><text class="bm-lbl">净额｜NET</text><text class="bm-val">¥{{item.totalFmt}}</text></view>
                </view>
                <view class="bill-detail">
                   <view class="bd-item"><text>刷卡｜POS</text><text>¥{{item.posFmt}}</text></view>
                   <view class="bd-item"><text>现金余额｜在手</text><text>¥{{item.cashBalanceFmt}}</text></view>
                   <view class="bd-item"><text>遗留线上｜账本</text><text>¥{{item.onlineFmt}}</text></view>
                   <!-- 这里加上了 warn 类 -->
                   <view class="bd-item warn"><text>退款｜REFUND</text><text>-¥{{item.refundFmt}}</text></view>
                </view>
                <view class="bill-detail mp-row">
                   <view class="bd-item"><text>小程序GMV</text><text>¥{{item.mpOnlineFmt}}</text></view>
                   <view class="bd-item warn"><text>小程序退款</text><text>-¥{{item.mpRefundFmt}}</text></view>
                </view>
                <view class="bill-detail mp-row pledge-row">
                   <view class="bd-item pledge"><text>应捐｜1%</text><text>¥{{item.pledgeDueFmt}}</text></view>
                   <view class="bd-item muted"><text>净GMV</text><text>¥{{item.mpNetFmt}}</text></view>
                </view>
                <view class="bill-del" bindtap="deleteRevenue" data-id="{{item._id}}" data-date="{{item.date}}"><image class="del-btn-icon" src="/assets/icons/delete.png" mode="aspectFit" /></view>
             </view>
             <view class="bill-edge bottom"></view>
          </view>
       </block>
       <view class="empty-ledger" wx:if="{{revenues.length===0}}">
          <view class="book-icon"><image class="book-icon-img" src="/assets/icons/list.png" mode="aspectFit" /></view><text>暂无入账记录</text>
       </view>
    </view>
  </block>

  <!-- [Tab 1] 藏品库：明细 / 库存概览 / 分类管理 -->
  <block wx:if="{{curTab===1}}">
    <view class="sub-tab-row product-lib-tabs" wx:if="{{!artisanEmbed}}">
      <view class="sub-tab {{productLibTab==='list'?'active':''}}" bindtap="switchProductLibTab" data-tab="list">藏品明细</view>
      <view class="sub-tab {{productLibTab==='stats'?'active':''}}" bindtap="switchProductLibTab" data-tab="stats">库存概览</view>
      <view class="sub-tab {{productLibTab==='category'?'active':''}}" bindtap="switchProductLibTab" data-tab="category">分类管理</view>
    </view>
    <view class="artisan-embed-hint" wx:if="{{artisanEmbed && productLibTab==='list'}}">
      <text class="artisan-embed-title">本人藏品</text>
      <text class="artisan-embed-sub">仅展示与编辑你创建或关联的藏品</text>
    </view>

    <!-- 藏品明细 -->
    <block wx:if="{{productLibTab==='list'}}">
      <view class="product-toolbar" wx:if="{{!artisanEmbed && expiredSeckillCount > 0}}">
        <view class="cat-manage-btn" bindtap="clearExpiredSeckill">清过期秒杀({{expiredSeckillCount}})</view>
      </view>
      <view class="search-box">
        <input placeholder="搜索藏品…" placeholder-class="ph" bindinput="onSearchInput" value="{{searchVal}}"/>
      </view>
      <view class="product-sort-row">
        <view
          class="ps-chip {{productSort===item.key || (item.isPrice && (productSort==='price_asc' || productSort==='price_desc')) ? 'on' : ''}}"
          wx:for="{{productSortOptions}}"
          wx:key="key"
          bindtap="setProductSort"
          data-key="{{item.key}}"
        >{{item.isPrice ? productPriceSortLabel : item.label}}</view>
      </view>
      <view class="product-filter-row" wx:if="{{!artisanEmbed}}">
        <view class="pf-chip {{productArchiveFilter==='all' && productPromoFilter==='all'?'on':''}}" bindtap="setProductArchiveFilter" data-val="all">全部</view>
        <view class="pf-chip {{productArchiveFilter==='archive'?'on':''}}" bindtap="setProductArchiveFilter" data-val="archive">在档</view>
        <view class="pf-chip {{productArchiveFilter==='oneOfAKind'?'on':''}}" bindtap="setProductArchiveFilter" data-val="oneOfAKind">孤品</view>
        <view class="pf-chip {{productPromoFilter==='seckill'?'on':''}}" bindtap="setProductPromoFilter" data-val="seckill">秒杀中</view>
        <view class="pf-chip {{productPromoFilter==='seckill_expired'?'on':''}}" bindtap="setProductPromoFilter" data-val="seckill_expired">秒杀过期</view>
        <view class="pf-chip {{productPromoFilter==='group'?'on':''}}" bindtap="setProductPromoFilter" data-val="group">拼团</view>
      </view>
      <block wx:for="{{products}}" wx:key="_id">
        <view class="product-row {{item.isOffShelf ? 'disabled' : ''}}">
          <view class="p-cover">
            <image class="p-img" src="{{item.images[0]}}" mode="aspectFill"></image>
            <view class="p-wm {{item.shelfWmClass}}" wx:if="{{item.shelfWm}}">
              <text class="p-wm-text">{{item.shelfWm}}</text>
            </view>
          </view>
          <view class="p-info">
            <view class="p-top"><text class="p-name">{{item.title}}</text><view class="p-edit" bindtap="openProductModal" data-item="{{item}}">✎</view></view>
            <view class="p-tags">
              <text class="mini-tag" wx:if="{{item.inArchive}}">在档</text>
              <text class="mini-tag warn" wx:if="{{item.isOneOfAKind}}">孤品</text>
              <text class="mini-tag danger" wx:if="{{item.seckill.enabled}}">秒杀</text>
              <text class="mini-tag warn" wx:if="{{item.groupBuying.enabled}}">拼团</text>
              <text class="mini-tag" wx:if="{{item.hasSku}}">多规格</text>
              <text class="mini-tag" wx:if="{{item.craftProcessLabel}}">{{item.craftProcessLabel}}</text>
              <text class="mini-tag" wx:if="{{item.craftTypeLabel}}">{{item.craftTypeLabel}}</text>
              <text class="mini-tag" wx:if="{{item.framerId && item.framerName}}" bindtap="openFramerPublic" data-id="{{item.framerId}}">{{item.framerName}}</text>
            </view>
            <view class="p-mid" wx:if="{{!artisanEmbed}}"><text class="tag">进：{{item.costPrice||0}}</text><text class="tag profit">毛利：{{item.profitRate}}%</text><text class="tag">售：{{item.soldCountDisplay}}</text></view>
            <view class="p-mid" wx:else>
              <text class="tag">{{item.shelfWm || (item.isOffShelf ? '未上架' : '已上架')}}</text>
              <text class="tag" wx:if="{{item.framerName}}">{{item.framerName}}</text>
            </view>
            <view class="p-bot"><text class="p-price">¥{{item.price}}</text><switch wx:if="{{!artisanEmbed}}" checked="{{!item.isOffShelf}}" color="#C4A76C" bindchange="toggleShelf" data-id="{{item._id}}" style="transform:scale(0.6)"/></view>
          </view>
        </view>
      </block>
      <view class="product-list-footer">
        <text class="product-list-meta" wx:if="{{productTotal}}">已加载 {{products.length}} / {{productTotal}}</text>
        <view class="product-load-more" wx:if="{{productHasMore}}" bindtap="loadMoreProducts">
          {{productLoadingMore ? '加载中…' : '加载更多'}}
        </view>
        <text class="product-list-end" wx:elif="{{products.length && !productListLoading}}">已显示全部</text>
        <text class="product-list-end" wx:elif="{{!productListLoading && !products.length}}">暂无藏品</text>
      </view>
      <view class="fab-add" bindtap="openProductModal">+</view>
    </block>

    <!-- 库存概览（原藏品概览） -->
    <block wx:if="{{productLibTab==='stats'}}">
      <view class="pstats-panel">
        <view class="pstats-head">
          <view class="pstats-title-wrap">
            <text class="pstats-title">库存概览</text>
            <text class="pstats-sub" wx:if="{{productStats}}">扫描 {{productStats.scanned}} 件{{productStats.truncated ? '（已截断）' : ''}}</text>
          </view>
          <view class="pstats-head-actions">
            <view class="pstats-chip {{productStatsTrendDays===7?'on':''}}" bindtap="setProductStatsTrend" data-days="7">7日</view>
            <view class="pstats-chip {{productStatsTrendDays===30?'on':''}}" bindtap="setProductStatsTrend" data-days="30">30日</view>
            <view class="pstats-refresh" bindtap="loadProductStats">刷新</view>
          </view>
        </view>

        <view class="pstats-loading" wx:if="{{productStatsLoading && !productStats}}">统计加载中…</view>
        <block wx:elif="{{productStats}}">
          <!-- 预估积压货款：当前在库全量 costPrice×stock；7/30 日仅影响近期占比 -->
          <view class="pstats-cost-hero">
            <view class="pstats-cost-hero-top">
              <text class="pstats-cost-eyebrow">预估 · 在库全量</text>
              <text class="pstats-cost-hint">成本价 × 库存</text>
            </view>
            <text class="pstats-cost-amount">¥{{productStats.cost.displayOverstock || '0'}}</text>
            <text class="pstats-cost-title">预估积压货款</text>
            <view class="pstats-cost-meta">
              <text>近{{productStats.trendDays}}日录入成本 ¥{{productStats.cost.displayRecent || '0'}}（{{productStats.cost.recentRatio || 0}}%）</text>
              <text wx:if="{{productStats.cost.missingCostItems}}">未填成本 {{productStats.cost.missingCostItems}} 件 / {{productStats.cost.missingCostStock}} 件库存未计入</text>
              <text wx:else>已填成本藏品均已计入</text>
            </view>
          </view>

          <view class="pstats-cards">
            <view class="pstats-card">
              <text class="ps-val">{{productStats.counts.total}}</text>
              <text class="ps-lbl">在库</text>
            </view>
            <view class="pstats-card">
              <text class="ps-val accent">{{productStats.counts.onShelf}}</text>
              <text class="ps-lbl">上架</text>
            </view>
            <view class="pstats-card">
              <text class="ps-val muted">{{productStats.counts.offShelf}}</text>
              <text class="ps-lbl">下架</text>
            </view>
            <view class="pstats-card">
              <text class="ps-val">{{productStats.counts.inArchive}}</text>
              <text class="ps-lbl">在档</text>
            </view>
            <view class="pstats-card">
              <text class="ps-val warn">{{productStats.counts.oneOfAKind}}</text>
              <text class="ps-lbl">孤品</text>
            </view>
            <view class="pstats-card">
              <text class="ps-val">{{productStats.counts.hasSku}}</text>
              <text class="ps-lbl">多规格</text>
            </view>
          </view>

          <view class="pstats-meta-row">
            <text>库存合计 {{productStats.counts.stockTotal}}</text>
            <text>销量合计 {{productStats.salesTotal}}</text>
            <text>近{{productStats.trendDays}}日新增 {{productStats.addedInRange}}</text>
          </view>

          <view class="pstats-section">
            <text class="pstats-sec-title">一级分类分布</text>
            <view class="pstats-bar-row" wx:for="{{productStats.categoryRoot}}" wx:key="key">
              <text class="pstats-bar-label">{{item.key}}</text>
              <view class="pstats-bar-track"><view class="pstats-bar-fill" style="width: {{item.pct}}%;"></view></view>
              <text class="pstats-bar-count">{{item.count}}</text>
            </view>
            <view class="pstats-empty" wx:if="{{!productStats.categoryRoot.length}}">暂无分类数据</view>
          </view>

          <view class="pstats-section">
            <text class="pstats-sec-title">二级分类 Top</text>
            <view class="pstats-bar-row" wx:for="{{productStats.categorySub}}" wx:key="key">
              <text class="pstats-bar-label sm">{{item.key}}</text>
              <view class="pstats-bar-track"><view class="pstats-bar-fill sub" style="width: {{item.pct}}%;"></view></view>
              <text class="pstats-bar-count">{{item.count}}</text>
            </view>
          </view>

          <view class="pstats-section">
            <text class="pstats-sec-title">近{{productStats.trendDays}}日录入</text>
            <view class="pstats-trend">
              <view class="pstats-trend-col" wx:for="{{productStats.trend}}" wx:key="key">
                <view class="pstats-trend-bar-wrap">
                  <view class="pstats-trend-bar" style="height: {{item.pct}}%;"></view>
                </view>
                <text class="pstats-trend-count">{{item.count || ''}}</text>
                <text class="pstats-trend-label">{{item.label}}</text>
              </view>
            </view>
          </view>

          <view class="pstats-section" wx:if="{{productStats.salesTop.length}}">
            <text class="pstats-sec-title">销量 Top</text>
            <view class="pstats-sales-row" wx:for="{{productStats.salesTop}}" wx:key="_id">
              <text class="pstats-sales-rank">{{index + 1}}</text>
              <image class="pstats-sales-img" wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"/>
              <view class="pstats-sales-info">
                <text class="pstats-sales-title">{{item.title}}</text>
                <text class="pstats-sales-meta">{{item.rootCategoryName}} · ¥{{item.price}}</text>
              </view>
              <text class="pstats-sales-sold">{{item.soldCount}}</text>
            </view>
          </view>
        </block>
        <view class="pstats-empty" wx:elif="{{!productStatsLoading}}">暂无统计，点刷新重试</view>
      </view>
    </block>

    <!-- 分类管理（原弹窗能力内嵌） -->
    <block wx:if="{{productLibTab==='category'}}">
      <view class="cat-manage-inline">
        <view class="cat-manage-actions">
          <view class="cat-sync-btn" bindtap="syncCategoriesFromSeed">同步标准分类</view>
          <view class="cat-sync-btn cat-sync-btn-ghost" bindtap="fillL2LatinNames">补齐拉丁名</view>
          <view class="cat-sync-btn cat-sync-btn-ghost" bindtap="repairProductCategoryLinks">修复藏品关联</view>
        </view>
        <view class="cat-manage-tip">展示云库已启用一二级。点「关联」查看已挂件数并可一键补挂；「修复藏品关联」把指向旧 id / 短名的藏品迁到当前二级。</view>

        <view class="cat-tree" wx:if="{{categoryManageTree.length}}">
          <block wx:for="{{categoryManageTree}}" wx:key="_id">
            <view class="cat-root-row">
              <view class="cat-root-main">
                <text class="cat-l1">{{item.name}}</text>
                <text class="cat-en">{{item.enName}}</text>
              </view>
              <view class="cat-del" bindtap="deleteCategory" data-id="{{item._id}}" data-level="1">删除</view>
            </view>
            <view class="cat-sub-row" wx:for="{{item.children}}" wx:for-item="sub" wx:key="_id">
              <view class="cat-sub-main">
                <text class="cat-sub-name">└ {{sub.name}}</text>
                <text class="cat-count">{{sub.productCount || 0}} 件</text>
                <text class="cat-tax" wx:if="{{sub.latinName || sub.latin || sub.enName}}">{{sub.latinName || sub.latin || sub.enName}}</text>
              </view>
              <view class="cat-sub-ops">
                <view class="cat-action-btn" bindtap="openCatLinkModal" data-id="{{sub._id}}" data-name="{{sub.name}}">关联</view>
                <view class="cat-del" bindtap="deleteCategory" data-id="{{sub._id}}" data-level="2">删除</view>
              </view>
            </view>
            <view class="cat-empty-subs" wx:if="{{!item.children.length}}">暂无已启用的二级分类</view>
          </block>
        </view>
        <view class="empty-tip" wx:else>暂无分类，可在下方添加</view>

        <view class="cat-add-section">
          <view class="form-section-label">新增分类</view>
          <view class="form-row">
            <text>层级</text>
            <radio-group class="radio-row" bindchange="bindCatLevelChange">
              <label class="radio-label"><radio color="#C4A76C" value="1" checked="{{newCatLevel === 1}}"/>一级</label>
              <label class="radio-label"><radio color="#C4A76C" value="2" checked="{{newCatLevel === 2}}"/>二级</label>
            </radio-group>
          </view>
          <view class="form-row" wx:if="{{newCatLevel === 2}}">
            <text>所属馆</text>
            <picker range="{{catManageRootNames}}" bindchange="bindCatParentChange">
              <view class="picker-s">{{catManageRootNames[newCatParentIndex] || '选择一级分类'}}</view>
            </picker>
          </view>
          <view class="form-row"><text>名称</text><input placeholder="中文名，如：蝴蝶" value="{{newCatName}}" bindinput="bindCatInput" data-field="name"/></view>
          <view class="form-row"><text>英文</text><input placeholder="如：BUTTERFLY" value="{{newCatEn}}" bindinput="bindCatInput" data-field="en"/></view>
          <view class="btn-full cat-add-submit" bindtap="submitCategory">添加分类</view>
        </view>
      </view>
    </block>
  </block>

  <!-- [Tab 2] 订单管理 -->
