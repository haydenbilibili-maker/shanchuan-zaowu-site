            <view class="om-sku-more" wx:if="{{item.skuOverflow}}" catchtap="toggleOrderSkuExpand" data-id="{{item._id}}" data-scope="orders">{{item.skuExpanded ? '收起藏品' : ('展开其余 ' + item.skuHiddenCount + ' 件')}}</view>
