/* 工作台功能入口（2026-09-30 全局改版）：待办条 + 分区卡片 + 统一磁贴 + 合并磁贴二级面板 */

.grid-item.hub-nav {
  background: transparent;
  border: 0;
  padding: 0;
  justify-content: flex-start;
}

/* ── 待办条 ── */
.hub-todo {
  background: #2B2519;
  border: 1rpx solid rgba(196, 167, 108, 0.32);
  border-radius: 24rpx;
  padding: 22rpx 24rpx 12rpx;
  margin-bottom: 24rpx;
}
.hub-todo-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 14rpx;
}
.hub-todo-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #C4A76C;
  letter-spacing: 4rpx;
}
.hub-todo-num {
  margin-left: 16rpx;
  font-family: var(--font-din);
  font-size: 44rpx;
  font-weight: bold;
  color: #F3E9D2;
}
.hub-todo-chips {
  display: flex;
  flex-wrap: wrap;
}
.hub-todo-chip {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  margin: 0 14rpx 12rpx 0;
  border-radius: 28rpx;
  background: #3A3223;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
}
.hub-todo-chip-label {
  font-size: 24rpx;
  color: #F0E6D2;
}
.hub-todo-chip-count {
  margin-left: 10rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #E8C77A;
}
.hub-todo--clear {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
}
.hub-todo-ok {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #B9AD96;
}

/* ── 分区卡片 ── */
.hub-sec {
  background: #211E19;
  border: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: 24rpx;
  padding: 22rpx 18rpx 18rpx;
  margin-bottom: 20rpx;
}
.hub-sec-head {
  display: flex;
  align-items: center;
  margin: 0 4rpx 18rpx;
}
.hub-sec-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: #C4A76C;
  margin-right: 14rpx;
}
.hub-sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #EADFC8;
  letter-spacing: 2rpx;
}

/* 四列：fr 分配剩余宽度，不存在「百分比 + 间距恰好 100%」的真机取整换行（错题本 E26） */
.hub-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx 12rpx;
}

/* ── 统一磁贴 ── */
.hub-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  min-height: 160rpx;
  padding: 18rpx 4rpx 12rpx;
  background: #2A261F;
  border: 1rpx solid rgba(196, 167, 108, 0.12);
  border-radius: 20rpx;
}
.hub-ico {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 与旧菜单同一枚金色单色滤镜（真机已验证）：素材色不一，统一成金线图标 */
.hub-ico-img {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}
.hub-tile > text {
  display: block;
  max-width: 100%;
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #F0E6D2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-tile-sub {
  max-width: 100%;
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.35;
  color: #B9AD96;
  text-align: center;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
/* 合并磁贴：右上角金色折角箭头，表示点开有多项 */
.hub-tile.is-group::after {
  content: '';
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 10rpx;
  height: 10rpx;
  border-top: 3rpx solid #C4A76C;
  border-right: 3rpx solid #C4A76C;
  transform: rotate(45deg);
}
.hub-badge {
  position: absolute;
  top: -6rpx;
  right: -20rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
  line-height: 28rpx;
  text-align: center;
  border: 2rpx solid #2A261F;
}
.hub-badge--live {
  letter-spacing: 1rpx;
  font-size: 18rpx;
}
.hub-press {
  background-color: #3A3328 !important;
}

/* ── 合并磁贴二级面板 ── */
.hub-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.62);
}
.hub-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  background: #221F1A;
  border-top: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.hub-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.hub-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #EADFC8;
}
.hub-sheet-close {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 26rpx;
  color: #C4A76C;
}
.hub-sheet-item {
  display: flex;
  align-items: center;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
  border-radius: 12rpx;
}
.hub-sheet-item:last-child {
  border-bottom: 0;
}
.hub-sheet-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.hub-sheet-name {
  font-size: 30rpx;
  color: #F0E6D2;
}
.hub-sheet-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B9AD96;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-sheet-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-left: 16rpx;
  border-radius: 18rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}
.hub-sheet-arrow {
  margin-left: 16rpx;
  font-size: 36rpx;
  color: #9A8F7C;
}
