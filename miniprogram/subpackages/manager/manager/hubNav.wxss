/* 工作台功能入口（2026-09-30 全局改版；2026-10-01 展示改版）：待办卡 + 我的常用（首屏）+ 「全部功能」5 列便当式流排 + 合并磁贴二级面板。
   按压态一律用 app.wxss 的 tap-press / tap-press-soft；说明字不低于 secondary（#B9AD96 在深底约 8:1）。 */

.grid-item.hub-nav {
  background: transparent;
  border: 0;
  padding: 0;
  justify-content: flex-start;
}

/* ── 区块标题：英文小标题在上、中文主标在下 ── */
.hub-titles {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.hub-en {
  display: block;
  font-size: 18rpx;
  line-height: 24rpx;
  letter-spacing: 4rpx;
  color: #C4A76C;
}
.hub-cn {
  display: block;
  margin-top: 2rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #F3E9D2;
}

/* ── 待办卡 ── */
.hub-todo {
  background: linear-gradient(135deg, #3B301C 0%, #261F15 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 24rpx;
  padding: 22rpx 20rpx 20rpx;
  margin-bottom: 24rpx;
}
.hub-todo-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx;
}
.hub-todo-total {
  display: flex;
  align-items: baseline;
}
.hub-todo-num {
  font-family: var(--font-din, 'DIN Alternate'), -apple-system, sans-serif;
  font-size: 60rpx;
  line-height: 1;
  font-weight: bold;
  color: #F3E2B8;
}
.hub-todo-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #B9AD96;
}
/* 四格等分：fr 分配剩余宽度，不存在「百分比 + 间距恰好 100%」的真机取整换行（错题本 E26） */
.hub-todo-cells {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}
.hub-todo-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 112rpx;
  padding: 14rpx 6rpx;
  border-radius: 16rpx;
  background: rgba(20, 18, 14, 0.5);
  border: 1rpx solid rgba(196, 167, 108, 0.3);
}
.hub-todo-cell-num {
  font-family: var(--font-din, 'DIN Alternate'), -apple-system, sans-serif;
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: bold;
  color: #E8C77A;
}
.hub-todo-cell-label {
  max-width: 100%;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #F0E6D2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-todo-cell-new {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 18rpx;
}
.hub-todo--clear {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #211E19;
  border-color: rgba(196, 167, 108, 0.2);
  padding: 18rpx 24rpx;
}
.hub-todo-ok {
  font-size: 24rpx;
  color: #B9AD96;
}

/* ── 我的常用（首屏核心） ── */
.hub-fav {
  background: #262017;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 24rpx;
  padding: 20rpx 16rpx 12rpx;
  margin-bottom: 28rpx;
}
.hub-fav-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  margin-bottom: 12rpx;
}
.hub-fav-edit {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  font-size: 24rpx;
  color: #E0C58A;
}
.hub-grid--fav {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
.hub-fav-empty {
  padding: 28rpx 8rpx;
  font-size: 24rpx;
  color: #B9AD96;
  text-align: center;
}

/* ── 全部功能：5 列便当式流排。分区卡占「可见入口数」列（span-N），dense 让小分区并排补位 ── */
.hub-cat-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx;
}
.hub-cat-count {
  font-size: 22rpx;
  color: #B9AD96;
}
.hub-cat-hint {
  display: block;
  margin: 8rpx 4rpx 16rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #B9AD96;
}
.hub-cat-hint.is-tip {
  color: #E8C77A;
}
.hub-anchors {
  display: flex;
  margin-bottom: 16rpx;
}
.hub-anchor {
  flex: 1 1 0;
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #2A251D;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  font-size: 22rpx;
  color: #F0E6D2;
  white-space: nowrap;
}
.hub-anchor + .hub-anchor {
  margin-left: 8rpx;
}
.hub-anchor-n {
  margin-left: 4rpx;
  font-size: 18rpx;
  color: #C4A76C;
}
.hub-cat-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  grid-auto-flow: row dense;
  gap: 12rpx;
}
.hub-sec {
  min-width: 0;
  padding: 14rpx 0 6rpx;
  background: #211E19;
  border: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: 20rpx;
}
.hub-sec.span-1 { grid-column: span 1; }
.hub-sec.span-2 { grid-column: span 2; }
.hub-sec.span-3 { grid-column: span 3; }
.hub-sec.span-4 { grid-column: span 4; }
.hub-sec.span-5 { grid-column: span 5; }
.hub-sec-head {
  display: flex;
  align-items: center;
  height: 32rpx;
  padding: 0 6rpx 0 12rpx;
  margin-bottom: 4rpx;
}
.hub-sec-head::before {
  content: '';
  flex-shrink: 0;
  width: 4rpx;
  height: 22rpx;
  border-radius: 2rpx;
  background: #C4A76C;
  margin-right: 8rpx;
}
.hub-sec-title {
  min-width: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #EADFC8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 分区内列数 = 分区所占列数、列距同外层 12rpx，磁贴与全局 5 列网格对齐（同宽） */
.hub-grid {
  display: grid;
  column-gap: 12rpx;
  row-gap: 4rpx;
}
.hub-grid.cols-1 { grid-template-columns: minmax(0, 1fr); }
.hub-grid.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.hub-grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.hub-grid.cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.hub-grid.cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }

/* ── 统一磁贴：常用区与全部功能同一规格（尺寸只在这里定义，不许按区 / 按入口另设） ── */
.hub-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  height: 128rpx;
  padding-top: 10rpx;
  border-radius: 16rpx;
}
.hub-ico {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 与旧菜单同一枚金色单色滤镜（真机已验证）：素材色不一，统一成金线图标 */
.hub-ico-img {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}
.hub-tile > text {
  display: block;
  max-width: 100%;
  margin-top: 10rpx;
  padding: 0 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 500;
  color: #F0E6D2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 点开有多项（二级面板）：图标双圈。常用区与全部功能同一表达，不再用折角箭头 / 副标题 */
.hub-tile.is-group .hub-ico,
.hub-ico.is-stack {
  border: 2rpx solid rgba(196, 167, 108, 0.6);
  box-shadow: 0 0 0 5rpx rgba(196, 167, 108, 0.16);
}
/* 已在常用：图标左上金点 */
.hub-pin {
  position: absolute;
  top: 8rpx;
  left: 50%;
  margin-left: -40rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E8C77A;
  border: 2rpx solid #211E19;
}
.hub-badge {
  position: absolute;
  top: -6rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: bold;
  line-height: 26rpx;
  text-align: center;
  border: 2rpx solid #211E19;
}
.hub-badge--live {
  letter-spacing: 1rpx;
  font-size: 16rpx;
}

/* 首屏骨架：待办格 + 两行常用（行 / 卡片来自 app.wxss 的 ui-sk-*，这里只放尺寸） */
.ui-sk-line.wb-sk-todo { width: 22%; height: 96rpx; margin-top: 0; border-radius: 16rpx; }
.wb-sk-tiles + .wb-sk-tiles { margin-top: 16rpx; }

/* ── 合并磁贴二级面板 ── */
.hub-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.62);
}
.hub-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  background: #221F1A;
  border-top: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.hub-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.hub-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #EADFC8;
}
.hub-sheet-close {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 26rpx;
  color: #C4A76C;
}
.hub-sheet-item {
  display: flex;
  align-items: center;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
  border-radius: 12rpx;
}
.hub-sheet-item:last-child {
  border-bottom: 0;
}
.hub-sheet-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.hub-sheet-name {
  font-size: 30rpx;
  color: #F0E6D2;
}
.hub-sheet-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B9AD96;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-sheet-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-left: 16rpx;
  border-radius: 18rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}
.hub-sheet-arrow {
  margin-left: 16rpx;
  font-size: 36rpx;
  color: #9A8F7C;
}

/* ── 常用编辑面板 ── */
.hub-fav-sheet {
  display: flex;
  flex-direction: column;
  max-height: 82vh;
}
.hub-fav-scroll {
  flex: 1;
  min-height: 0;
  max-height: 62vh;
  overflow-y: auto;
}
.hub-fav-sel {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}
.hub-fav-sel-ico {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}
.hub-fav-sel-name {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  font-size: 28rpx;
  color: #F0E6D2;
}
.hub-fav-op {
  margin-left: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  font-size: 22rpx;
  color: #E0C58A;
}
.hub-fav-op.is-off {
  opacity: 0.3;
  pointer-events: none;
}
.hub-fav-op.is-remove {
  color: #F0A89E;
  border-color: rgba(240, 168, 158, 0.4);
}
.hub-fav-sel-empty,
.hub-fav-full {
  padding: 20rpx 8rpx;
  font-size: 22rpx;
  color: #B9AD96;
}
.hub-fav-group {
  margin-top: 22rpx;
}
.hub-fav-group-title {
  display: block;
  margin: 0 8rpx 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #C4A76C;
}
.hub-fav-chips {
  display: flex;
  flex-wrap: wrap;
}
.hub-fav-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 20rpx;
  border-radius: 26rpx;
  background: #2E281E;
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  font-size: 24rpx;
  color: #F0E6D2;
}
.hub-fav-chip.is-added {
  background: #4A3D25;
  border-color: #C4A76C;
  color: #F3E2B8;
}
.hub-fav-chip.is-off {
  opacity: 0.4;
}
.hub-fav-actions {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
}
.hub-fav-btn {
  width: 48.5%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}
.hub-fav-btn.is-ghost {
  background: #2E281E;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  color: #E0C58A;
}
.hub-fav-btn.is-primary {
  background: #C4A76C;
  color: #1A1814;
}
