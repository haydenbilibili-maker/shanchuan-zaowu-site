/* 工作台功能入口（2026-09-30 全局改版；2026-10-01 展示改版·方案 A）：搜索（超管）+ 待处理横条 + 我的常用（首屏）
   + 「全部功能」分区列表（可折叠）+ 二级面板底部 sheet。只有一种标记：红色数字角标。
   按压态一律用 app.wxss 的 tap-press；说明字不低于 secondary（#B9AD96 在深底约 8:1）。 */

.grid-item.hub-nav {
  background: transparent;
  border: 0;
  padding: 0;
  justify-content: flex-start;
}

/* ── 区块标题：英文小标题在上、中文主标在下 ── */
.hub-titles {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.hub-en {
  display: block;
  font-size: 18rpx;
  line-height: 24rpx;
  letter-spacing: 4rpx;
  color: #C4A76C;
}
.hub-cn {
  display: block;
  margin-top: 2rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #F3E9D2;
}

/* ── 唯一的标记：红色数字角标（常用图标右上角 / 列表行右侧 / 待处理横条同一枚） ── */
.hub-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 9rpx;
  border-radius: 17rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
}
.hub-badge--live {
  letter-spacing: 1rpx;
  font-size: 16rpx;
}

/* ── 功能搜索（超管） ── */
.hub-search {
  margin-bottom: 24rpx;
}
.hub-search-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 12rpx 0 28rpx;
  border-radius: 40rpx;
  background: #26221B;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
}
.hub-search-ico {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}
.hub-search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin-left: 16rpx;
  background: transparent;
  font-size: 26rpx;
  color: #F0E6D2;
}
.hub-search-ph {
  color: #B9AD96;
}
.hub-search-clear {
  flex-shrink: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #E0C58A;
}
.hub-found {
  margin-top: 16rpx;
}
.hub-found-empty {
  padding: 32rpx 24rpx;
  font-size: 24rpx;
  color: #B9AD96;
  text-align: center;
}

/* ── 待处理横条：一排「名称 + 红色数字」，多了横向滑动 ── */
.hub-todo {
  background: linear-gradient(135deg, #3B301C 0%, #261F15 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 24rpx;
  padding: 22rpx 0 22rpx 24rpx;
  margin-bottom: 24rpx;
}
.hub-todo-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-right: 24rpx;
}
.hub-todo-sum {
  font-size: 24rpx;
  color: #B9AD96;
}
.hub-todo-strip {
  margin-top: 18rpx;
  white-space: nowrap;
}
.hub-todo-chip {
  display: inline-flex;
  align-items: center;
  height: 72rpx;
  padding: 0 18rpx 0 24rpx;
  margin-right: 14rpx;
  border-radius: 36rpx;
  background: rgba(20, 18, 14, 0.5);
  border: 1rpx solid rgba(196, 167, 108, 0.32);
}
.hub-todo-label {
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #F0E6D2;
}
.hub-todo--clear {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #211E19;
  border-color: rgba(196, 167, 108, 0.2);
  padding: 18rpx 24rpx;
}
.hub-todo-ok {
  font-size: 24rpx;
  color: #B9AD96;
}

/* ── 我的常用（首屏核心）：4 列大图标，「编辑」是唯一的增删入口 ── */
.hub-fav {
  background: #262017;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 24rpx;
  padding: 22rpx 16rpx 12rpx;
  margin-bottom: 28rpx;
}
.hub-fav-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 12rpx;
}
.hub-fav-edit {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  font-size: 24rpx;
  color: #E0C58A;
}
.hub-grid--fav {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  row-gap: 4rpx;
}
.hub-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  height: 156rpx;
  padding-top: 12rpx;
  border-radius: 16rpx;
}
.hub-tile .hub-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
}
.hub-tile .hub-ico-img {
  width: 46rpx;
  height: 46rpx;
}
.hub-tile .hub-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  border: 2rpx solid #262017;
}
.hub-tile > text {
  display: block;
  max-width: 100%;
  margin-top: 12rpx;
  padding: 0 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #F0E6D2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-fav-empty {
  padding: 28rpx 8rpx;
  font-size: 24rpx;
  color: #B9AD96;
  text-align: center;
}

/* ── 图标底座（常用 / 列表 / 搜索结果共用；与旧菜单同一枚金色单色滤镜，真机已验证） ── */
.hub-ico {
  position: relative;
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: rgba(196, 167, 108, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hub-ico-img {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}

/* ── 全部功能：整块手风琴（Museum 暗色）；组头 = 色条 + 徽章 + 图标芯片；列表嵌在同卡内 ── */
.hub-cat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4rpx 8rpx 16rpx;
}
.hub-cat-title {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #D8CCB4;
}
.hub-cat-count {
  font-size: 22rpx;
  color: #B9AD96;
}
.hub-cat-body {
  background: #1E1B17;
  border: 1rpx solid rgba(196, 167, 108, 0.18);
  border-radius: 28rpx;
  overflow: hidden;
}
.hub-grp {
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  position: relative;
}
.hub-grp + .hub-grp {
  border-top: 1rpx solid rgba(196, 167, 108, 0.1);
}
.hub-grp-accent {
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #C4A76C;
  opacity: 0.55;
}
.hub-grp--orders .hub-grp-accent { background: #C4A76C; opacity: 0.9; }
.hub-grp--biz .hub-grp-accent { background: #8F9A6E; opacity: 0.85; }
.hub-grp--goods .hub-grp-accent { background: #B08968; opacity: 0.85; }
.hub-grp--members .hub-grp-accent { background: #A67C52; opacity: 0.9; }
.hub-grp--studio .hub-grp-accent { background: #6E8B7A; opacity: 0.85; }
.hub-grp--org .hub-grp-accent { background: #9A8B6E; opacity: 0.85; }
.hub-grp--system .hub-grp-accent { background: #7A6E62; opacity: 0.9; }
.hub-grp.is-open {
  background: rgba(196, 167, 108, 0.045);
}
.hub-grp-head {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 18rpx 22rpx 18rpx 28rpx;
  box-sizing: border-box;
}
.hub-grp-mark {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(196, 167, 108, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hub-grp--orders .hub-grp-mark { background: rgba(196, 167, 108, 0.22); }
.hub-grp--biz .hub-grp-mark { background: rgba(143, 154, 110, 0.22); }
.hub-grp--goods .hub-grp-mark { background: rgba(176, 137, 104, 0.22); }
.hub-grp--members .hub-grp-mark { background: rgba(166, 124, 82, 0.22); }
.hub-grp--studio .hub-grp-mark { background: rgba(110, 139, 122, 0.22); }
.hub-grp--org .hub-grp-mark { background: rgba(154, 139, 110, 0.22); }
.hub-grp--system .hub-grp-mark { background: rgba(122, 110, 98, 0.28); }
.hub-grp-mark-img {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}
.hub-grp-meta {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.hub-grp-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.hub-grp-title {
  flex-shrink: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #F0E6D2;
  line-height: 36rpx;
}
.hub-grp-n {
  flex-shrink: 0;
  padding: 0 10rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  background: rgba(196, 167, 108, 0.12);
  font-size: 20rpx;
  color: #B9AD96;
}
.hub-grp-title-row .hub-badge {
  flex-shrink: 0;
}
.hub-grp-chips {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.hub-grp-chip {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(196, 167, 108, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hub-grp-chip-img {
  width: 24rpx;
  height: 24rpx;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}
.hub-grp-more {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #B9AD96;
  line-height: 44rpx;
}
.hub-grp-state {
  font-size: 20rpx;
  color: #B9AD96;
  line-height: 28rpx;
}
/* 折叠箭头：朝下 = 收起，朝上 = 展开 */
.hub-grp-arrow {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin: -6rpx 4rpx 0 16rpx;
  border-right: 3rpx solid #C4A76C;
  border-bottom: 3rpx solid #C4A76C;
  transform: rotate(45deg);
  opacity: 0.75;
}
.hub-grp-arrow.is-open {
  margin-top: 8rpx;
  transform: rotate(-135deg);
}
.hub-list {
  border-top: 1rpx solid rgba(196, 167, 108, 0.1);
  padding: 4rpx 0 10rpx;
  background: rgba(0, 0, 0, 0.12);
}
.hub-found {
  border: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: 24rpx;
  background: #211E19;
  overflow: hidden;
}
.hub-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx 0 28rpx;
}
.hub-row + .hub-row {
  border-top: 1rpx solid rgba(196, 167, 108, 0.07);
}
.hub-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}
.hub-row-name {
  font-size: 26rpx;
  line-height: 34rpx;
  color: #F0E6D2;
}
.hub-row-desc {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #B9AD96;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-row .hub-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
}
.hub-row-go {
  flex-shrink: 0;
  margin-left: 10rpx;
  font-size: 30rpx;
  color: #9A8F7C;
}
.hub-list .hub-ico {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
}
.hub-list .hub-ico-img {
  width: 28rpx;
  height: 28rpx;
}

/* 首屏骨架：待处理横条 + 两行常用（行 / 卡片来自 app.wxss 的 ui-sk-*，这里只放尺寸） */
.ui-sk-line.wb-sk-todo { width: 26%; height: 64rpx; margin-top: 0; border-radius: 32rpx; }
.wb-sk-tiles + .wb-sk-tiles { margin-top: 16rpx; }

/* ── 合并磁贴二级面板 ── */
.hub-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.62);
}
.hub-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  background: #221F1A;
  border-top: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.hub-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.hub-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #EADFC8;
}
.hub-sheet-close {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: 26rpx;
  color: #C4A76C;
}
.hub-sheet-item {
  display: flex;
  align-items: center;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
  border-radius: 12rpx;
}
.hub-sheet-item:last-child {
  border-bottom: 0;
}
.hub-sheet-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.hub-sheet-name {
  font-size: 30rpx;
  color: #F0E6D2;
}
.hub-sheet-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B9AD96;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-sheet-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-left: 16rpx;
  border-radius: 18rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}
.hub-sheet-arrow {
  margin-left: 16rpx;
  font-size: 36rpx;
  color: #9A8F7C;
}

/* ── 常用编辑面板 ── */
.hub-fav-sheet {
  display: flex;
  flex-direction: column;
  max-height: 82vh;
}
.hub-fav-scroll {
  flex: 1;
  min-height: 0;
  max-height: 62vh;
  overflow-y: auto;
}
.hub-fav-sel {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}
.hub-fav-sel-ico {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}
.hub-fav-sel-name {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  font-size: 28rpx;
  color: #F0E6D2;
}
.hub-fav-op {
  margin-left: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  font-size: 22rpx;
  color: #E0C58A;
}
.hub-fav-op.is-off {
  opacity: 0.3;
  pointer-events: none;
}
.hub-fav-op.is-remove {
  color: #F0A89E;
  border-color: rgba(240, 168, 158, 0.4);
}
.hub-fav-sel-empty,
.hub-fav-full {
  padding: 20rpx 8rpx;
  font-size: 22rpx;
  color: #B9AD96;
}
.hub-fav-group {
  margin-top: 22rpx;
}
.hub-fav-group-title {
  display: block;
  margin: 0 8rpx 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #C4A76C;
}
.hub-fav-chips {
  display: flex;
  flex-wrap: wrap;
}
.hub-fav-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 20rpx;
  border-radius: 26rpx;
  background: #2E281E;
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  font-size: 24rpx;
  color: #F0E6D2;
}
.hub-fav-chip.is-added {
  background: #4A3D25;
  border-color: #C4A76C;
  color: #F3E2B8;
}
.hub-fav-chip.is-off {
  opacity: 0.4;
}
.hub-fav-actions {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
}
.hub-fav-btn {
  width: 48.5%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}
.hub-fav-btn.is-ghost {
  background: #2E281E;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  color: #E0C58A;
}
.hub-fav-btn.is-primary {
  background: #C4A76C;
  color: #1A1814;
}
