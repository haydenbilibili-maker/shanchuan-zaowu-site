/* 工作台功能入口（2026-09-30 全局改版；2026-10-01 展示改版·方案 A）：搜索（超管）+ 待处理横条 + 我的常用（首屏）
   + 「全部功能」按大分类扁平宫格（可收起，每个磁贴点一下直达，2026-10-10 起没有点开再选的折叠磁贴）。标记只有红色数字角标一种。
   按压态一律用 app.wxss 的 tap-press；说明字不低于 secondary（#B9AD96 在深底约 8:1）。 */

.grid-item.hub-nav {
  background: transparent;
  border: 0;
  padding: 0;
  justify-content: flex-start;
}

/* ── 区块标题：英文小标题在上、中文主标在下 ── */
.hub-titles {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
/* 全站分区标题口径（app.wxss .mu-head，2026-10-13 工作台 R6 对齐） */
.hub-en {
  display: block;
  font-size: var(--fs-18);
  line-height: 26rpx;
  letter-spacing: .32em;
  font-family: var(--font-mono);
  color: var(--color-primary);
}
.hub-cn {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-36);
  line-height: 48rpx;
  font-weight: 500;
  font-family: var(--font-brand);
  letter-spacing: .12em;
  color: #F3E9D2;
}

/* ── 唯一的标记：红色数字角标（常用图标右上角 / 列表行右侧 / 待处理横条同一枚） ── */
.hub-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 9rpx;
  border-radius: 17rpx;
  background: #C0392B;
  color: #FFFFFF;
  font-size: var(--fs-20);
  font-weight: bold;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
}
.hub-badge--live {
  letter-spacing: 1rpx;
  font-size: var(--fs-16);
}

/* ── 功能搜索（超管） ── */
.hub-search {
  margin-bottom: 24rpx;
}
.hub-search-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 12rpx 0 28rpx;
  border-radius: 40rpx;
  background: #26221B;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
}
.hub-search-ico {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}
.hub-search-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin-left: 16rpx;
  background: transparent;
  font-size: var(--fs-26);
  color: #F0E6D2;
}
.hub-search-ph {
  color: #B9AD96;
}
.hub-search-clear {
  flex-shrink: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  font-size: var(--fs-24);
  color: #E0C58A;
}
.hub-found {
  margin-top: 16rpx;
}
.hub-found-empty {
  padding: 32rpx 24rpx;
  font-size: var(--fs-24);
  color: #B9AD96;
  text-align: center;
}

/* ── 待处理横条：一排「名称 + 红色数字」，多了横向滑动 ── */
.hub-todo {
  background: linear-gradient(135deg, #3B301C 0%, #261F15 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: var(--radius-lg);
  padding: 22rpx 0 22rpx 24rpx;
  margin-bottom: 24rpx;
}
.hub-todo-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-right: 24rpx;
}
.hub-todo-sum {
  font-size: var(--fs-24);
  color: #B9AD96;
}
.hub-todo-strip {
  margin-top: 18rpx;
  white-space: nowrap;
}
.hub-todo-chip {
  display: inline-flex;
  align-items: center;
  height: 72rpx;
  padding: 0 18rpx 0 24rpx;
  margin-right: 14rpx;
  border-radius: 36rpx;
  background: rgba(20, 18, 14, 0.5);
  border: 1rpx solid rgba(196, 167, 108, 0.32);
}
.hub-todo-label {
  margin-right: 12rpx;
  font-size: var(--fs-26);
  color: #F0E6D2;
}
.hub-todo--clear {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #211E19;
  border-color: rgba(196, 167, 108, 0.2);
  padding: 18rpx 24rpx;
}
.hub-todo-ok {
  font-size: var(--fs-24);
  color: #B9AD96;
}

/* ── 我的常用（首屏核心）：4 列大图标，「编辑」是唯一的增删入口 ── */
.hub-fav {
  background: #262017;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: var(--radius-lg);
  padding: 22rpx 16rpx 12rpx;
  margin-bottom: 28rpx;
}
.hub-fav-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 12rpx;
}
.hub-fav-edit {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  font-size: var(--fs-24);
  color: #E0C58A;
}
.hub-grid--fav {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  row-gap: 4rpx;
}
.hub-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  height: 156rpx;
  padding-top: 12rpx;
  border-radius: var(--radius-md);
}
.hub-tile .hub-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
}
.hub-tile .hub-ico-img {
  width: 46rpx;
  height: 46rpx;
}
.hub-tile .hub-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  border: 2rpx solid #262017;
}
.hub-tile > text {
  display: block;
  max-width: 100%;
  margin-top: 12rpx;
  padding: 0 4rpx;
  font-size: var(--fs-24);
  line-height: 34rpx;
  color: #F0E6D2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-fav-empty {
  padding: 28rpx 8rpx;
  font-size: var(--fs-24);
  color: #B9AD96;
  text-align: center;
}

/* ── 图标底座（常用 / 列表 / 搜索结果共用；与旧菜单同一枚金色单色滤镜，真机已验证） ── */
.hub-ico {
  position: relative;
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hub-ico-img {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

/* ── 全部功能：按大分类的扁平宫格（09-30 首版样式）；分类标题行点按收起 / 展开，默认全部展开 ── */
.hub-cat-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx;
  margin-bottom: 18rpx;
}
.hub-cat-side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.hub-cat-count {
  font-size: var(--fs-22);
  color: #B9AD96;
}
.hub-cat-toggle {
  margin-left: 16rpx;
  height: 52rpx;
  line-height: 50rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  font-size: var(--fs-22);
  color: #E0C58A;
}
.hub-grp {
  background: #211E19;
  border: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: var(--radius-lg);
  padding: 0 18rpx;
  margin-bottom: 20rpx;
}
.hub-grp-head {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 6rpx 0 4rpx;
}
.hub-grp-head::before { content: none; }  /* 去竖条（2026-10-12 拍板：分区标题无竖条） */
.hub-grp-title {
  flex-shrink: 0;
  font-size: var(--fs-30);
  font-weight: 500;
  font-family: var(--font-brand);
  color: #EADFC8;
  letter-spacing: .08em;
}
.hub-grp-fold {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  justify-content: flex-end;
}
.hub-grp-n {
  font-size: var(--fs-22);
  color: #B9AD96;
}
.hub-grp-fold .hub-badge {
  margin-left: 12rpx;
}
/* 箭头：朝上 = 已展开（点按收起），朝下 = 已收起（点按展开） */
.hub-grp-arrow {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin: 8rpx 4rpx 0 auto;
  border-right: 3rpx solid var(--color-primary);
  border-bottom: 3rpx solid var(--color-primary);
  transform: rotate(-135deg);
  transition: transform var(--dur-fast) var(--ease-out-soft);
}
.hub-grp-fold + .hub-grp-arrow {
  margin-left: 18rpx;
}
.hub-grp-arrow.is-collapsed {
  margin-top: -6rpx;
  transform: rotate(45deg);
}

/* 四列：fr 分配剩余宽度，不存在「百分比 + 间距恰好 100%」的真机取整换行（错题本 E26） */
.hub-grid--cat {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx 12rpx;
  padding-bottom: 18rpx;
  animation: hub-cat-in 0.18s ease-out;
}
@keyframes hub-cat-in {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.hub-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  min-height: 160rpx;
  padding: 18rpx 4rpx 12rpx;
  background: #2A261F;
  border: 1rpx solid rgba(196, 167, 108, 0.12);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}
.hub-cell .hub-ico {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.hub-cell .hub-ico-img {
  width: 46rpx;
  height: 46rpx;
}
.hub-cell .hub-badge {
  position: absolute;
  top: -6rpx;
  right: -20rpx;
  border: 2rpx solid #2A261F;
}
.hub-cell-name {
  display: block;
  max-width: 100%;
  margin-top: 14rpx;
  font-size: var(--fs-24);
  line-height: 34rpx;
  font-weight: 500;
  color: #F0E6D2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-cell-sub {
  display: block;
  max-width: 100%;
  margin-top: 4rpx;
  font-size: var(--fs-18);
  line-height: 26rpx;
  color: #B9AD96;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 搜索结果（超管）：列表行 */
.hub-found {
  border: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: var(--radius-lg);
  background: #211E19;
  overflow: hidden;
}
.hub-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 20rpx 0 24rpx;
}
.hub-row + .hub-row {
  border-top: 1rpx solid rgba(196, 167, 108, 0.1);
}
.hub-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}
.hub-row-name {
  font-size: var(--fs-28);
  line-height: 38rpx;
  color: #F0E6D2;
}
.hub-row-desc {
  margin-top: 4rpx;
  font-size: var(--fs-22);
  line-height: 30rpx;
  color: #B9AD96;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hub-row .hub-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
}
.hub-row-go {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: var(--fs-34);
  color: #9A8F7C;
}

/* 首屏骨架：待处理横条 + 两行常用（行 / 卡片来自 app.wxss 的 ui-sk-*，这里只放尺寸） */
.ui-sk-line.wb-sk-todo { width: 26%; height: 64rpx; margin-top: 0; border-radius: 32rpx; }
.wb-sk-tiles + .wb-sk-tiles { margin-top: 16rpx; }

/* ── 底部面板外壳（常用编辑面板在用） ── */
.hub-sheet {
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.hub-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.hub-sheet-title {
  font-size: var(--fs-32);
  font-weight: 600;
  color: #EADFC8;
}
.hub-sheet-close {
  padding: 8rpx 0 8rpx 24rpx;
  font-size: var(--fs-26);
  color: var(--color-primary);
}
/* ── 常用编辑面板 ── */
.hub-fav-sheet {
  display: flex;
  flex-direction: column;
  max-height: 82vh;
}
.hub-fav-scroll {
  flex: 1;
  min-height: 0;
  max-height: 62vh;
  overflow-y: auto;
}
.hub-fav-sel {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}
.hub-fav-sel-ico {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}
.hub-fav-sel-name {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  font-size: var(--fs-28);
  color: #F0E6D2;
}
.hub-fav-op {
  margin-left: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  font-size: var(--fs-22);
  color: #E0C58A;
}
.hub-fav-op.is-off {
  opacity: 0.3;
  pointer-events: none;
}
.hub-fav-op.is-remove {
  color: #F0A89E;
  border-color: rgba(240, 168, 158, 0.4);
}
.hub-fav-sel-empty,
.hub-fav-full {
  padding: 20rpx 8rpx;
  font-size: var(--fs-22);
  color: #B9AD96;
}
.hub-fav-group {
  margin-top: 22rpx;
}
.hub-fav-group-title {
  display: block;
  margin: 0 8rpx 12rpx;
  font-size: var(--fs-24);
  font-weight: 600;
  color: var(--color-primary);
}
.hub-fav-chips {
  display: flex;
  flex-wrap: wrap;
}
.hub-fav-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 20rpx;
  border-radius: 26rpx;
  background: #2E281E;
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  font-size: var(--fs-24);
  color: #F0E6D2;
}
.hub-fav-chip.is-added {
  background: #4A3D25;
  border-color: var(--color-primary);
  color: #F3E2B8;
}
.hub-fav-chip.is-off {
  opacity: 0.4;
}
.hub-fav-actions {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
}
.hub-fav-btn {
  width: 48.5%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: var(--fs-28);
  font-weight: 600;
}
.hub-fav-btn.is-ghost {
  background: #2E281E;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  color: #E0C58A;
}
.hub-fav-btn.is-primary {
  background: var(--color-primary);
  color: #1A1814;
}
