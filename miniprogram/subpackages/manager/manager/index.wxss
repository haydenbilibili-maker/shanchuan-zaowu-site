.book-icon-img { width: 40rpx; height: 40rpx; opacity: 0.55; }

/* --- [Tab 2] 订单管理 --- */
.sub-tab-row { display: flex; margin-bottom: 30rpx; background: var(--color-bg-card); border-radius: 16rpx; padding: 8rpx; border: 1px solid var(--color-bg-elevated); }

.content-seed-bar {
  display: flex;
