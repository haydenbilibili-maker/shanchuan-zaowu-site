.ledger-overview.lo-empty {
  text-align: center;
  padding: 40rpx 28rpx;
}
.lo-empty-en {
  display: block;
  font-family: var(--font-din);
  font-size: 20rpx;
  color: var(--gold, #C4A76C);
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
}
.lo-empty-cn {
  font-size: 24rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.5;
}

/* 票据卡片容器 */
.bill-card { 
  margin-bottom: 40rpx; 
  position: relative; 
  filter: drop-shadow(0 20rpx 40rpx rgba(0,0,0,0.6));
  transition: transform 0.2s;
}
.bill-card:active { transform: scale(0.98); }

/* 票据主体 (米白纸质) */
.bill-body { 
  background: #f0f0eb; /* 米白 */
  padding: 40rpx; 
  position: relative; z-index: 2; color: #1a1a1a;
  /* 纸张纹理 */
  background-image: url("data:image/svg+xml,%3Csvg width='4' height='4' viewBox='0 0 4 4' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 3h1v1H1V3zm2-2h1v1H3V1z' fill='%23d0d0d0' fill-opacity='0.4' fill-rule='evenodd'/%3E%3C/svg%3E");
}

/* 顶部锯齿 */
.bill-edge { height: 16rpx; width: 100%; background: #f0f0eb; position: relative; z-index: 2; }
.bill-edge.top { 
  background-image: radial-gradient(circle at 16rpx 0, transparent 14rpx, #f0f0eb 15rpx); 
  background-size: 32rpx 16rpx; background-repeat: repeat-x; 
}
/* 底部锯齿 */
.bill-edge.bottom { 
  background-image: radial-gradient(circle at 16rpx 16rpx, transparent 14rpx, #f0f0eb 15rpx); 
  background-size: 32rpx 16rpx; background-repeat: repeat-x; 
}

/* 主要信息行 */
.bill-main { 
  display: flex; justify-content: space-between; align-items: center; 
  margin-bottom: 30rpx; padding-bottom: 24rpx; 
  border-bottom: 3rpx dashed #bbb; 
}

.bm-left { display: flex; flex-direction: column; }
.bm-day { font-size: 60rpx; font-weight: 900; font-family: var(--font-din); color: var(--color-bg); line-height: 1; letter-spacing: -2rpx; }
.bm-date { font-size: 20rpx; color: #666; font-family: var(--font-din); margin-top: 6rpx; font-weight: bold; letter-spacing: 1rpx; }

.bm-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  /* 避开右上角绝对定位的删除按钮，避免「净额｜NET」与图标重叠 */
  padding-right: 72rpx;
  box-sizing: border-box;
  max-width: 70%;
}
.bm-lbl { font-size: 16rpx; color: #888; font-weight: bold; letter-spacing: 2rpx; text-transform: uppercase; margin-bottom: 4rpx; }
.bm-val { font-size: 48rpx; font-weight: 900; color: #b88a4d; font-family: var(--font-din); letter-spacing: 1rpx; }

/* 明细网格 */
.bill-detail { 
  display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; 
  background: rgba(0,0,0,0.03); padding: 20rpx; border-radius: 8rpx;
}

.bd-item { display: flex; flex-direction: column; }
.bd-item text:first-child {
  color: #888;
  font-size: 16rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
  letter-spacing: 0.5rpx;
}
.bd-item text:last-child { font-family: var(--font-din); font-weight: bold; font-size: 28rpx; color: #333; }

/* 特殊状态颜色 */
.bd-item.warn text:last-child { color: #d32f2f; } /* 退款红色 */
.bd-item.pledge text:last-child { color: #8A7530; }
.bd-item.muted text:last-child { color: #666; font-weight: 600; }
.pledge-row { opacity: 0.95; }

/* 删除按钮：固定票据卡右上角，不压住净额标签/金额 */
.bill-del { 
  position: absolute; top: 20rpx; right: 16rpx; 
  width: 60rpx; height: 60rpx; 
  display: flex; align-items: center; justify-content: center;
  color: #aaa; font-size: 28rpx; 
  border-radius: 50%; transition: all 0.2s;
  z-index: 3;
}
.bill-del:active { background: rgba(0,0,0,0.1); color: #ff4d4f; }

/* 空状态 */
.empty-ledger { 
  text-align: center; padding-top: 120rpx; opacity: 0.5; 
  display: flex; flex-direction: column; align-items: center;
}
.book-icon { font-size: 64rpx; margin-bottom: 20rpx; filter: grayscale(1); opacity: 0.5; }
.empty-ledger text { font-size: 24rpx; color: #666; letter-spacing: 2rpx; }


/* ==================== 4. 弹窗与反馈 (ActionSheet 风格) ==================== */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(10px); z-index: 200; display: flex; align-items: flex-end; opacity: 0; animation: fadeIn 0.3s forwards; }
.modal-panel { width: 100%; background: #1a1a1a; border-radius: 30rpx 30rpx 0 0; padding-bottom: env(safe-area-inset-bottom); max-height: 80vh; display: flex; flex-direction: column; transform: translateY(100%); animation: slideUpPanel 0.3s forwards; }

@keyframes slideUpPanel { to { transform: translateY(0); } }

.modal-head { padding: 30rpx; text-align: center; font-size: 30rpx; font-weight: bold; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.05); position: relative; background: #1f1f1f; border-radius: 30rpx 30rpx 0 0; }
.close-btn { position: absolute; right: 30rpx; top: 30rpx; color: #888; font-size: 36rpx; padding: 0 20rpx; }

/* 旧段保留结构；高度以下方「弹窗系统」.modal-body 为准 */
.modal-body { padding: 30rpx; }
.form-group { display: flex; flex-direction: column; gap: 20rpx; }
.form-row { display: flex; justify-content: space-between; align-items: center; background: #222; padding: 24rpx; border-radius: 12rpx; border: 1px solid rgba(255,255,255,0.03); }
.form-row text { font-size: 26rpx; color: #aaa; width: 140rpx; }
.form-row input, .picker { flex: 1; text-align: right; font-size: 28rpx; color: #fff; line-height: normal; height: 100%; min-height: 48rpx; }
.form-label { font-size: 24rpx; color: #888; margin: 20rpx 0 10rpx; padding-left: 10rpx; }

.picker-s {
  background: var(--color-bg); border: 1px solid #333; color: #ccc;
  padding: 10rpx 20rpx; border-radius: 8rpx; font-size: 24rpx; text-align: center;
  min-width: 140rpx;
}
.picker-s.disabled { opacity: 0.3; }


.radio-row { display: flex; gap: 30rpx; padding: 20rpx; background: #222; border-radius: 12rpx; }
.upload-area { height: 300rpx; background: #222; border: 2rpx dashed #444; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 30rpx; overflow: hidden; position: relative; }
.upload-area.round { width: 200rpx; height: 200rpx; border-radius: 50%; margin: 0 auto 30rpx; }
.placeholder { color: #666; font-size: 26rpx; }
.upload-area image { width: 100%; height: 100%; object-fit: cover; }
.smart-box textarea { width: 100%; height: 160rpx; background: #222; padding: 20rpx; border-radius: 12rpx; font-size: 26rpx; color: #fff; margin-bottom: 30rpx; border: 1px solid rgba(255,255,255,0.05); }
.modal-foot { padding: 20rpx 30rpx 40rpx; border-top: 1px solid rgba(255,255,255,0.05); }
.btn-full { background: var(--gold); color: var(--color-bg); font-weight: bold; height: 90rpx; display: flex; align-items: center; justify-content: center; border-radius: 45rpx; font-size: 30rpx; letter-spacing: 2rpx; box-shadow: none; }

/* 核销成功全屏动画 */
.verify-success-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 300; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
.verify-success-modal.active { opacity: 1; pointer-events: auto; }
.vs-content { display: flex; flex-direction: column; align-items: center; transform: scale(0.8); transition: transform 0.3s; }
.active .vs-content { transform: scale(1); }
.vs-stamp-anim { width: 300rpx; height: 300rpx; border: 12rpx double var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 60rpx; font-weight: 900; transform: rotate(-15deg); margin-bottom: 60rpx; box-shadow: none; }
.vs-tip { font-size: 36rpx; color: #fff; margin-bottom: 80rpx; letter-spacing: 4rpx; font-weight: bold; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

/* 🟢 全局输入框样式强化 */
.input, .picker-box, .textarea {
  background: var(--color-bg) !important; /* 深黑底 */
  border: 1px solid rgba(255, 255, 255, 0.15) !important;
  color: #fff !important;
  border-radius: 12rpx !important;
  transition: border-color 0.3s ease;
  font-family: "PingFang SC", sans-serif;
}

.input:focus, .textarea:focus {
  border-color: var(--gold) !important;
  box-shadow: none;
}

.placeholder { color: rgba(255, 255, 255, 0.3); }

/* ==================== 弹窗系统 (UI 统一优化) ==================== */
.modal-mask { 
  position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
  background: rgba(0,0,0,0.85); backdrop-filter: blur(10px); 
  z-index: 200; display: flex; align-items: flex-end; 
  opacity: 0; animation: fadeIn 0.3s forwards; 
}

.modal-panel { 
  width: 100%; background: #1a1a1a; 
  border-radius: 32rpx 32rpx 0 0; 
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); 
  max-height: 85vh; display: flex; flex-direction: column; 
  box-shadow: 0 -10rpx 40rpx rgba(0,0,0,0.5);
}

/* 标题栏 */
.modal-head { 
  padding: 36rpx; text-align: center; 
  font-size: 32rpx; font-weight: bold; color: #fff; 
  border-bottom: 1px solid rgba(255,255,255,0.05); position: relative; 
  background: #1f1f1f; border-radius: 32rpx 32rpx 0 0;
}
.close-btn { 
  position: absolute; right: 30rpx; top: 36rpx; 
  color: #888; font-size: 36rpx; padding: 0 20rpx; 
}

/* 通用弹层中部：scroll-view 必须有明确高度，否则内容撑开被 max-height 裁切且无法滚动 */
.modal-body {
  flex-shrink: 0;
  width: 100%;
  /* 预留 head(~110rpx) + foot(~150rpx) + safe-area；勿用 flex:1+height:0（部分 iPhone 会塌） */
  height: calc(85vh - 280rpx - constant(safe-area-inset-bottom));
  height: calc(85vh - 280rpx - env(safe-area-inset-bottom));
  max-height: calc(85vh - 280rpx - constant(safe-area-inset-bottom));
  max-height: calc(85vh - 280rpx - env(safe-area-inset-bottom));
  min-height: 200rpx;
  padding: 40rpx;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 🟢 统一表单样式 */
.form-group { display: flex; flex-direction: column; gap: 24rpx; }

.form-row { 
  display: flex; justify-content: space-between; align-items: center; 
  background: #222; padding: 0 24rpx; height: 96rpx; 
  border-radius: 16rpx; border: 1px solid rgba(255,255,255,0.05); 
}

.form-row text { font-size: 28rpx; color: #aaa; width: 160rpx; }

/* 输入框统一（line-height:normal 避免继承 page 1.6 导致裁切/变形） */
.input, .picker { 
  flex: 1; text-align: right; font-size: 28rpx; color: #fff; height: 100%;
  line-height: normal; min-height: 48rpx;
}
.input-placeholder { color: #555; }

/* 文本域 */
.textarea { 
  width: 100%; height: 200rpx; background: #222; 
  padding: 24rpx; border-radius: 16rpx; 
  font-size: 28rpx; color: #fff; 
  border: 1px solid rgba(255,255,255,0.05); 
  margin-bottom: 24rpx;
}

.sku-editor {
  display: flex;
  align-items: center;
