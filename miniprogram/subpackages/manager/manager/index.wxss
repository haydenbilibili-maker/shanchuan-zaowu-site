.visit-stats-name { font-size: 26rpx; color: #ccc; }
.visit-stats-count { font-family: var(--font-din); font-size: 28rpx; color: var(--gold); font-weight: bold; }
.report-note { display: block; margin-top: 10rpx; line-height: 1.5; color: var(--color-text-secondary); font-size: 22rpx; }
.report-bars { margin-top: 8rpx; }

/* ==================== Tab 13 数据报表 ==================== */
.report-page { padding-bottom: 48rpx; }
.report-signal-board {
  border: 1px solid var(--brass-800, #4D401A);
