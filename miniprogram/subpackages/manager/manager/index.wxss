  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1;
}
.kpi-mini-unit { font-size: 20rpx; color: var(--color-text-muted); }
.kpi-mini-row { display: flex; gap: 16rpx; }
.kpi-mini-cell {
  flex: 1;
  padding: 12rpx 14rpx;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.04);
  border-radius: 12rpx;
}
.kpi-mini-l { display: block; font-size: 18rpx; color: var(--color-text-muted); margin-bottom: 4rpx; }
.kpi-mini-v {
  display: block;
  font-family: var(--font-din);
  font-size: 26rpx;
  color: var(--color-text-body);
  font-weight: 600;
}

/* 库存速览 */
.stock-mini { display: flex; flex-direction: column; gap: 18rpx; flex: 1; }
.stock-mini-row { display: flex; gap: 8rpx; }
.stock-mini-cell { flex: 1; text-align: center; }
.stock-mini-v {
  display: block;
  font-family: var(--font-din);
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 700;
  line-height: 1.2;
}
.stock-mini-v.accent { color: var(--gold); }
.stock-mini-l { display: block; margin-top: 4rpx; font-size: 18rpx; color: var(--color-text-muted); }
.stock-cat { display: flex; flex-direction: column; gap: 10rpx; }
.stock-cat-row { display: flex; align-items: center; gap: 10rpx; }
.stock-cat-n {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 18rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stock-cat-track {
  flex: 1;
  height: 8rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 9999px;
  overflow: hidden;
}
.stock-cat-fill {
  height: 100%;
  background: var(--gold);
  border-radius: 9999px;
  min-width: 0;
}
.stock-cat-c {
  width: 48rpx;
  text-align: right;
  font-size: 18rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-din);
}

/* 近7日渠道拆分 */
.week-split { display: flex; flex-direction: column; gap: 10rpx; flex: 1; justify-content: center; }
.week-split-row { display: flex; justify-content: space-between; align-items: baseline; }
.week-split-l { font-size: 20rpx; color: var(--color-text-secondary); }
.week-split-v {
  font-family: var(--font-din);
  font-size: 26rpx;
  color: var(--color-text-body);
  font-weight: 600;
}
.week-share-track {
  height: 10rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 9999px;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.week-share-fill { height: 100%; border-radius: 9999px; min-width: 0; }
.week-share-fill.gold { background: var(--gold); }
.week-share-fill.forest { background: #2D5A3F; }
.week-split-hint { margin-top: 8rpx; font-size: 18rpx; color: #4A4540; }

.footer-logo { text-align: center; color: #333; font-size: 20rpx; margin-top: 60rpx; letter-spacing: 4rpx; font-family: var(--font-din); }

/* ==================== 3. 子页面样式 (Sub Views) ==================== */
/* 同页 curTab 切换：轻量淡入，与 navigateTo 独立页的系统滑入区分但各自统一 */
.sub-view { padding: 16rpx 30rpx 30rpx; }
.sub-view-enter {
  animation: subViewFadeIn 0.22s ease-out;
}
@keyframes subViewFadeIn {
  from { opacity: 0.35; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.section-title { font-size: 28rpx; font-weight: bold; color: #ddd; margin: 40rpx 0 20rpx; border-left: 6rpx solid var(--gold); padding-left: 16rpx; }

/* 通用添加按钮 - 优化可见性 */
.fab-add { 
  position: fixed; 
  bottom: calc(60rpx + env(safe-area-inset-bottom)); 
  right: 40rpx; 
  width: 100rpx; 
  height: 100rpx; 
  border-radius: 50%; 
  background: linear-gradient(135deg, #A8903C 0%, var(--gold) 100%);
  color: var(--color-bg); 
  font-size: 60rpx; 
  font-weight: 900;
  display: flex; 
  align-items: center; 
  justify-content: center; 
  box-shadow: 
    0 8rpx 24rpx rgba(196, 167, 108,0.6),
    0 0 0 4rpx rgba(196, 167, 108,0.2),
    0 0 40rpx rgba(196, 167, 108,0.5);
  z-index: 90; 
  padding-bottom: 8rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
  animation: fab-pulse 2s ease-in-out infinite;
}
.fab-add.scan { font-size: 40rpx; padding: 0; display: flex; align-items: center; justify-content: center; }
.fab-scan-icon { width: 44rpx; height: 44rpx; }
@keyframes fab-pulse {
  0%, 100% {
    box-shadow: 
      0 8rpx 24rpx rgba(196, 167, 108,0.6),
      0 0 0 4rpx rgba(196, 167, 108,0.2),
      0 0 40rpx rgba(196, 167, 108,0.5);
  }
  50% {
    box-shadow: 
      0 8rpx 32rpx rgba(196, 167, 108,0.8),
      0 0 0 6rpx rgba(196, 167, 108,0.3),
      0 0 60rpx rgba(196, 167, 108,0.7);
  }
}

/* --- [Tab 1] 藏品管理 --- */
.search-box { margin-bottom: 30rpx; }
.search-box input { background: var(--color-bg-card); height: 80rpx; min-height: 80rpx; line-height: normal; border-radius: 40rpx; padding: 0 30rpx; color: #fff; border: 1px solid rgba(255,255,255,0.1); font-size: 26rpx; box-sizing: border-box; }

.product-row { display: flex; background: var(--color-bg-card); padding: 20rpx; border-radius: 16rpx; margin-bottom: 20rpx; align-items: center; border: 1px solid rgba(255,255,255,0.05); }
.product-row.disabled { opacity: 0.88; border-style: dashed; }
.product-row.disabled .p-img { opacity: 0.55; filter: grayscale(1); }
.p-cover { position: relative; width: 120rpx; height: 120rpx; margin-right: 24rpx; flex-shrink: 0; }
.p-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: var(--color-bg); border: 1px solid rgba(255,255,255,0.1); object-fit: cover; display: block; }
.p-wm {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
  border-radius: 12rpx;
}
.p-wm-text {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  transform: rotate(-28deg);
  white-space: nowrap;
  opacity: 0.72;
  text-shadow: 0 1rpx 2rpx rgba(26, 24, 20, 0.55);
}
.p-wm.pending .p-wm-text { color: #E0CFA3; opacity: 0.78; }
.p-wm.rejected .p-wm-text { color: #D64045; opacity: 0.82; }
.p-wm.approved .p-wm-text { color: rgba(196, 167, 108, 0.85); opacity: 0.55; }
.p-info { flex: 1; display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.p-top { display: flex; justify-content: space-between; align-items: flex-start; }
.p-name { font-size: 28rpx; font-weight: bold; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.p-edit { color: #aaa; padding: 4rpx 12rpx; border: 1px solid #444; border-radius: 8rpx; font-size: 22rpx; }
.p-mid { display: flex; gap: 12rpx; }
.tag { display: inline-flex; align-items: center; align-self: flex-start; width: auto; font-size: 20rpx; color: #888; background: rgba(255,255,255,0.05); padding: 4rpx 10rpx; border-radius: 6rpx; font-family: var(--font-din); white-space: nowrap; box-sizing: border-box; }
.tag.profit { color: #52B788; background: rgba(76,175,80,0.1); }
.p-bot { display: flex; justify-content: space-between; align-items: center; }
.p-price { color: var(--gold); font-weight: bold; font-family: var(--font-din); font-size: 30rpx; }

/* --- [Tab 7] 活动课程 & [Tab 6] 权益商品 (核心修复) --- */
.grid-list { display: flex; flex-direction: column; gap: 24rpx; }

/* 复用并修正 .manage-card */
