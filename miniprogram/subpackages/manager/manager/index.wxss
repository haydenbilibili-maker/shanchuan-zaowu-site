  margin-bottom: 12rpx;
}
.museum-preview-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}
.museum-preview-body {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--color-text-body);
}
.card-dim { opacity: 0.92; border-color: rgba(196, 167, 108, 0.15); }
.msg-estimate { font-size: 22rpx; color: var(--gold); padding: 8rpx 4rpx 16rpx; opacity: 0.85; }
.radio-label { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #ccc; margin-right: 24rpx; }

/* 发货弹窗（样式主定义见上方 .ship-modal-*；此处仅兜底覆盖旧 form-row 高度） */
.ship-modal-panel .modal-body { padding-bottom: 16rpx; }
.ship-modal-panel .ship-section { height: auto; }

/* 标本养护 CMS */
.care-guide-card .m-info.full { width: 100%; }
.care-summary-line {
  flex: 1;
  font-size: 24rpx !important;
  color: #999 !important;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.care-guide-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.preview-btn {
  font-size: 22rpx;
  color: var(--gold);
  padding: 8rpx 16rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 8rpx;
}
.empty-hint {
  text-align: center;
  padding: 48rpx 32rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.55;
}
.form-hint {
  display: block;
  font-size: 20rpx;
  color: #666;
  margin: -8rpx 0 12rpx;
  padding-left: 8rpx;
  line-height: 1.5;
}
.textarea.mono { font-family: monospace; }

/* ==================== Tab 15/16 运费规则 · 内容展示开关 ==================== */
/* 对齐 welcome-gift / booking-rules / wallet-config 的 Museum 配置页规范 */
.cfg-panel-title { padding: 8rpx 8rpx 24rpx; }

.cfg-page {
  padding: 0 8rpx;
  box-sizing: border-box;
}

.cfg-header {
  padding: var(--space-4) 8rpx var(--space-2);
}

.cfg-brand {
  display: flex;
  flex-direction: column;
}

.cfg-en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.cfg-cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.cfg-header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.cfg-shortcut-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: 0 8rpx var(--space-3);
}
.cfg-shortcut {
  padding: 12rpx 22rpx;
  border-radius: 9999px;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  color: var(--brass-400);
  font-size: 22rpx;
  letter-spacing: 0.02em;
  background: rgba(196, 167, 108, 0.08);
}
.cfg-shortcut:active { background: rgba(196, 167, 108, 0.16); }

.cfg-card {
  padding: var(--space-4);
  margin-bottom: var(--space-4);
}

.cfg-summary {
  border-color: rgba(196, 167, 108, 0.22);
  background: linear-gradient(180deg, #24201b 0%, var(--color-bg-card) 100%);
}

.cfg-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.cfg-section-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.cfg-status-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-muted);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
}

.cfg-status-tag.on {
  color: var(--brass-400);
  border-color: rgba(196, 167, 108, 0.45);
}

.cfg-summary-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.55;
  letter-spacing: 0.02em;
}

.cfg-meta-line {
  display: block;
  margin-top: var(--space-2);
  font-size: 22rpx;
  color: var(--brass-400);
  line-height: 1.45;
}

.cfg-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin: 0 0 var(--space-3);
}

.cfg-edit .card-top { margin-bottom: var(--space-3); }

.cfg-field-block {
  margin-bottom: var(--space-3);
}

.cfg-field-block:last-child {
  margin-bottom: 0;
}

/* 运费规则 tab15：按装裱方式收费的勾选清单 */
.cfg-check-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.cfg-check {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 0 var(--space-3);
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
}

.cfg-check-box {
  transform: scale(0.82);
  flex-shrink: 0;
}

.cfg-check-label {
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.4;
}

.cfg-label-top {
  display: block;
  margin-bottom: var(--space-2);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.cfg-rows {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.cfg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  min-height: 88rpx;
  padding: var(--space-2) var(--space-4);
  margin-bottom: var(--space-3);
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
}

.cfg-row:last-child {
  margin-bottom: 0;
}

.cfg-rows .cfg-row {
  margin-bottom: 0;
}

.cfg-row-switch {
  min-height: 96rpx;
}

.cfg-label {
  flex-shrink: 0;
  width: 220rpx;
  max-width: none;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.35;
  white-space: nowrap;
  margin: 0;
  padding: 0;
}

.cfg-label-wide {
  width: auto;
  max-width: none;
  font-size: 28rpx;
  color: var(--color-text-body);
}

.cfg-label-block {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.cfg-label-block .cfg-label {
  width: auto;
}

.cfg-switch-hint {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.2;
}

.cfg-switch-hint.on { color: var(--brass-400); }

.cfg-switch {
  flex-shrink: 0;
  transform: scale(0.92);
  transform-origin: center right;
}

.cfg-field {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 var(--space-2);
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: 26rpx;
  text-align: left;
  line-height: normal;
}

.cfg-field-full {
  width: 100%;
  flex: none;
  background: var(--color-bg);
  border-color: rgba(196, 167, 108, 0.28);
}

.cfg-field-num {
  flex: 0 0 200rpx;
  width: 200rpx;
  text-align: right;
  font-family: var(--font-mono), 'JetBrains Mono', monospace;
  letter-spacing: 0.02em;
  background: var(--color-bg);
  border-color: rgba(196, 167, 108, 0.28);
}

.cfg-placeholder { color: var(--color-text-muted); }

.cfg-picker-wrap {
  flex: 1;
  min-width: 0;
}

.cfg-picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-height: 64rpx;
}

.cfg-picker-val {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
  color: var(--color-text-primary);
  font-size: 26rpx;
}

.cfg-picker-chev {
  flex-shrink: 0;
  color: var(--brass-400);
  font-size: 32rpx;
  line-height: 1;
  opacity: 0.85;
}

.cfg-cta {
  margin-top: var(--space-4);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brass-400);
  color: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.cfg-cta:active { background: var(--brass-500); }

.cfg-cta.disabled {
  opacity: 0.55;
  pointer-events: none;
}

/* 未保存提示：开关先改本地、点保存才写云端 */
.cfg-dirty {
  margin-top: var(--space-3);
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--brass-400, #C4A76C);
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-md, 12rpx);
}
/* ===== 藏品库统计 ===== */
.pstats-panel {
  background: var(--color-bg-card);
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin: 0 0 24rpx;
}
.pstats-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.pstats-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}
.pstats-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}
.pstats-head-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
  justify-content: flex-end;
}
.pstats-chip {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  border: 1px solid rgba(38, 35, 32, 0.9);
  background: var(--color-bg-elevated);
  padding: 6rpx 16rpx;
  border-radius: 9999px;
}
.pstats-chip.on {
  color: var(--color-bg);
  background: var(--gold);
  border-color: var(--gold);
}
.pstats-refresh {
  font-size: 20rpx;
  color: var(--gold);
  padding: 6rpx 12rpx;
}
.pstats-loading,
.pstats-empty {
  font-size: 24rpx;
  color: var(--color-text-muted);
  padding: 24rpx 0;
  text-align: center;
}
.pstats-cost-hero {
  background: linear-gradient(135deg, #A8903C 0%, var(--gold) 100%);
  border-radius: 16rpx;
  padding: 24rpx 28rpx 22rpx;
  margin-bottom: 16rpx;
}
.pstats-cost-hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.pstats-cost-eyebrow,
.pstats-cost-hint {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 0.06em;
}
.pstats-cost-amount {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.15;
}
.pstats-cost-title {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.04em;
}
.pstats-cost-meta {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.22);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.pstats-cost-meta text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.4;
}
.pstats-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.pstats-card {
  width: calc(33.33% - 8rpx);
  background: var(--color-bg-elevated);
  border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
  box-sizing: border-box;
}
.ps-val {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
}
.ps-val.accent { color: var(--gold); }
.ps-val.muted { color: var(--color-text-secondary); }
.ps-val.warn { color: #E9A23B; }
.ps-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.04em;
}
.pstats-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.pstats-section { margin-bottom: 24rpx; }
.pstats-sec-title {
  display: block;
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 0.06em;
  margin-bottom: 12rpx;
}
.pstats-bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.pstats-bar-label {
  width: 140rpx;
  font-size: 22rpx;
  color: var(--color-text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}
.pstats-bar-label.sm { width: 220rpx; font-size: 20rpx; }
.pstats-bar-track {
  flex: 1;
  height: 12rpx;
  background: var(--color-bg-elevated);
  border-radius: 9999px;
  overflow: hidden;
}
.pstats-bar-fill {
  height: 100%;
  background: var(--gold);
  border-radius: 9999px;
  min-width: 4rpx;
}
.pstats-bar-fill.sub { background: #8A7530; }
.pstats-bar-count {
  width: 56rpx;
  text-align: right;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  font-family: 'JetBrains Mono', monospace;
}
.pstats-trend {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 180rpx;
  padding-top: 8rpx;
  overflow-x: auto;
}
.pstats-trend-col {
  flex: 1;
  min-width: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}
.pstats-trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.pstats-trend-bar {
  width: 70%;
  max-width: 24rpx;
  min-height: 4rpx;
  background: linear-gradient(180deg, var(--gold) 0%, #8A7530 100%);
  border-radius: 6rpx 6rpx 0 0;
}
.pstats-trend-count {
  font-size: 16rpx;
  color: var(--color-text-secondary);
  height: 24rpx;
  line-height: 24rpx;
}
.pstats-trend-label {
  font-size: 16rpx;
  color: var(--color-text-muted);
  transform: scale(0.9);
}
.pstats-sales-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(38, 35, 32, 0.8);
}
.pstats-sales-rank {
  width: 32rpx;
  font-size: 22rpx;
  color: var(--gold);
  font-family: 'JetBrains Mono', monospace;
}
.pstats-sales-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: var(--color-bg-elevated);
}
.pstats-sales-info { flex: 1; min-width: 0; }
.pstats-sales-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pstats-sales-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}
.pstats-sales-sold {
  font-size: 26rpx;
  color: var(--gold);
  font-family: 'JetBrains Mono', monospace;
  font-weight: 600;
}

/* ===== 藏品录入分段 ===== */
/* Header + Tabs + Footer 固定；中间内容区定高滚动，切换 Tab 外框高度不变 */
.product-entry-panel {
  background: var(--color-bg-card);
  /* border-box：88vh 含底栏 safe-area，避免内容把脚栏挤出可视区被 overflow 裁切 */
  box-sizing: border-box;
  height: 88vh;
  max-height: 88vh;
  /* 安全区改由 .product-entry-foot 承担，避免与定高内容区双重占位/裁切 */
  padding-bottom: 0;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.product-entry-panel .modal-head {
  flex-shrink: 0;
}
.product-form-tabs {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  padding: 0 24rpx 16rpx;
  overflow-x: auto;
  border-bottom: 1px solid rgba(38, 35, 32, 0.9);
}
.pft {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 10rpx 20rpx;
  border-radius: 9999px;
  background: var(--color-bg-elevated);
  border: 1px solid transparent;
}
.pft.on {
  color: var(--color-bg);
  background: var(--gold);
  border-color: var(--gold);
}
.product-entry-body {
  /* 父级 88vh；预留 head+tabs+foot+safe-area。仍勿用 height:0，部分 iPhone scroll-view 会塌 */
  flex-shrink: 0;
  width: 100%;
  height: calc(88vh - 360rpx - constant(safe-area-inset-bottom));
  height: calc(88vh - 360rpx - env(safe-area-inset-bottom));
  max-height: calc(88vh - 360rpx - constant(safe-area-inset-bottom));
  max-height: calc(88vh - 360rpx - env(safe-area-inset-bottom));
  min-height: 200rpx;
  box-sizing: border-box;
}
.product-tab-pane {
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.product-entry-body .form-group {
  flex: 1;
}
/* 标识等开关行：标签单行、统一行高 */
.product-entry-body .form-row {
  height: 96rpx;
  min-height: 96rpx;
  overflow: hidden;
}
.product-entry-body .form-row.ai-row {
  height: auto;
  min-height: 96rpx;
  overflow: visible;
  padding: 16rpx 24rpx;
  align-items: flex-start;
}
.product-entry-body .form-row.tag-editor-row {
  height: auto;
  min-height: 96rpx;
  overflow: visible;
  align-items: flex-start;
  padding: 16rpx 24rpx;
}
.tag-editor {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}
.tag-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  width: 100%;
}
.tag-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(196, 167, 108, 0.12);
  border: 1px solid #4D401A;
}
.gift-scene-chip {
  background: transparent;
  border: 1px solid rgba(196, 167, 108, 0.35);
}
.gift-scene-chip .tag-chip-text {
  color: var(--color-text-secondary);
}
.gift-scene-chip.on {
  background: rgba(196, 167, 108, 0.14);
  border-color: var(--gold);
}
.gift-scene-chip.on .tag-chip-text {
  color: var(--gold);
}
.tag-chip-text {
  font-size: 22rpx;
  color: var(--gold);
  width: auto !important;
  margin: 0 !important;
}
.tag-chip-x {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding: 0 4rpx;
}
.tag-add-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
}
.tag-draft-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #fff;
}
.tag-add-btn {
  font-size: 22rpx;
  color: var(--gold);
  border: 1px solid var(--gold);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.product-entry-body .form-row > text {
  width: auto;
  flex: 0 0 auto;
  white-space: nowrap;
  margin-right: 16rpx;
}
.product-entry-foot {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  /* 覆盖 .modal-foot：底栏自身吃掉 home indicator，安卓/iOS 按钮完整可见 */
  padding: 20rpx 40rpx calc(24rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}
.product-entry-foot .flex-1 { flex: 1; }
.product-entry-foot .btn-ghost.sm {
  padding: 0 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 24rpx;
  white-space: nowrap;
}
/* 删除藏品（仅超管）：高风险操作，红色描边弱化填充 */
.product-entry-foot .btn-danger.sm {
  padding: 0 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 24rpx;
  white-space: nowrap;
  text-align: center;
  border-radius: 16rpx;
  border: 1px solid rgba(214, 64, 69, 0.6);
  color: #D64045;
  background: rgba(214, 64, 69, 0.08);
}
.product-entry-foot .btn-danger-press {
  background: rgba(214, 64, 69, 0.18);
}
.product-entry-foot .btn-full {
  height: 80rpx;
  flex-shrink: 0;
}
.form-row-pair {
  display: flex;
  gap: 16rpx;
}
.form-row.half {
  flex: 1;
  min-width: 0;
}
.picker-sep { color: var(--color-text-muted); }
.size-inputs {
  display: flex;
  gap: 10rpx;
  flex: 1;
  justify-content: flex-end;
}
.size-input {
  text-align: center;
  border-bottom: 1px solid #4D401A;
  border-radius: 0;
  width: 100rpx;
  color: var(--color-text-body);
}

/* ===== 多规格提效（疏朗排版 + 防裁切热区） ===== */
.sku-section-title,
.sku-builder-title {
  display: block;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 0.04em;
  margin-bottom: 16rpx;
}
.sku-ph {
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: normal;
}
.sku-field {
  box-sizing: border-box;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  line-height: normal;
  color: var(--color-text-primary);
  background: var(--color-bg);
  border: 1px solid #4D401A;
  border-radius: 12rpx;
}
.sku-builder {
  background: var(--color-bg-elevated);
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.sku-dim-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.sku-dim-name {
  width: 160rpx;
  flex-shrink: 0;
}
.sku-dim-vals {
  flex: 1;
  min-width: 0;
}
.sku-dim-del {
  flex-shrink: 0;
  min-width: 64rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: #D64045;
  font-size: 24rpx;
  padding: 0 8rpx;
}
.sku-builder-actions,
.sku-bulk-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 16rpx;
}
.sku-builder-actions { margin-bottom: 8rpx; }
.sku-bulk-panel {
  background: var(--color-bg-elevated);
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.sku-bulk-bar:last-child { margin-bottom: 0; }
.sku-bulk-input {
  flex: 1;
  min-width: 160rpx;
  width: auto;
}
.sku-bulk-bar > .sku-tool-btn {
  flex-shrink: 0;
}
.sku-tool-btn {
  box-sizing: border-box;
  min-height: 72rpx;
  height: 72rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--gold);
  border: 1px solid rgba(196, 167, 108, 0.45);
  background: transparent;
  border-radius: 12rpx;
  white-space: nowrap;
}
.sku-tool-btn.primary {
  background: rgba(196, 167, 108, 0.18);
  border-color: var(--gold);
  color: #E0CFA3;
}
.sku-bulk-bar.tools .sku-tool-btn {
  flex: 1;
  min-width: 0;
}
.sku-block.compact {
  background: var(--color-bg-card);
  border: 1px solid rgba(77, 64, 26, 0.5);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-bottom: 1px solid rgba(77, 64, 26, 0.5);
}
.sku-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.sku-idx {
  font-size: 24rpx;
  color: var(--gold);
  font-family: 'JetBrains Mono', monospace;
}
.sku-del {
  min-height: 56rpx;
  padding: 8rpx 16rpx;
  display: inline-flex;
  align-items: center;
  color: #D64045;
  font-size: 24rpx;
}
.sku-editor.stacked {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: transparent;
  padding: 0;
  margin-bottom: 16rpx;
}
.sku-editor.stacked .sku-input.full {
  width: 100%;
}
.sku-price-stock {
  display: flex;
  gap: 14rpx;
}
.sku-size-row {
  display: flex;
  gap: 14rpx;
}
.sku-editor.stacked .sku-input.half {
  flex: 1;
  min-width: 0;
}
.sku-editor.stacked .sku-input.third {
  flex: 1;
  min-width: 0;
}
.sku-images-row {
  margin-top: 4rpx;
  gap: 16rpx;
}
.sku-img-item,
.sku-img-add {
  width: 136rpx;
  height: 136rpx;
}
.btn-add-sku {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--gold);
  font-size: 26rpx;
  padding: 20rpx;
  border: 1px dashed rgba(196, 167, 108, 0.45);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: rgba(196, 167, 108, 0.06);
}
.sku-off-hint,
.tab-empty-hint {
  flex: 1;
  min-height: 360rpx;
  margin-top: 8rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
  background: var(--color-bg-elevated);
  border: 1px dashed rgba(77, 64, 26, 0.55);
  border-radius: 16rpx;
  box-sizing: border-box;
}
.sku-off-hint text,
.tab-empty-hint text {
  display: block;
}
.tab-empty-title {
  font-size: 28rpx;
  color: var(--gold);
  letter-spacing: 0.04em;
  margin-bottom: 4rpx;
}

/* 内容种子：正文长度与摘要（导入后据此确认内容确实被替换） */
.seed-len { color: var(--gold, #C4A76C); }
.seed-brief { display: block; }
.seed-brief-text {
  display: -webkit-box;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-muted, #8A847C);
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 需求 28：内容开关面板里的「跳转类」行（祈福墙内容管理） */
.cfg-row-link {
  cursor: pointer;
}

.cfg-chevron {
  flex-shrink: 0;
  font-size: 32rpx;
  color: var(--brass-400);
}
