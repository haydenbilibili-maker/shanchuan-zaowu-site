.visit-stats-card { margin-bottom: 24rpx; }
.visit-stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
