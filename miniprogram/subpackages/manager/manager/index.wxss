  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.report-signal-en {
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600, #8A7530);
}
.report-signal-cn {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary, #FFFFFF);
}
.report-signal-summary {
  display: flex;
