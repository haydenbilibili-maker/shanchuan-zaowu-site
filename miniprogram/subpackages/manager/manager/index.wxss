}

.card { background: var(--color-bg-card); border-radius: 20rpx; padding: 30rpx; margin-bottom: 30rpx; border: 1px solid rgba(255,255,255,0.05); }
.card-top { display: flex; justify-content: space-between; margin-bottom: 20rpx; border-bottom: 1px dashed rgba(255,255,255,0.1); padding-bottom: 16rpx; }
.no { font-family: var(--font-din); color: #888; font-size: 24rpx; letter-spacing: 1rpx; }
