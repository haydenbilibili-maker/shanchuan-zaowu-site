}
.card-museum-preview {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: var(--color-bg-card);
  border: 1px solid #4D401A;
  border-radius: 24rpx;
}
.museum-preview-kicker {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
