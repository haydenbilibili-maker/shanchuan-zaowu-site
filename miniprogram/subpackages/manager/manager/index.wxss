/* pages/manager/index.wxss */
/* 继承 app.wxss */
@import "../../../styles/badges.wxss";

/*
  page-container 曾注入 page { position/top }，导致 fixed 导航与内容错位、无法滚动。
  强制复位，保证 navSpacer + 自定义导航布局稳定。
*/
page {
  position: relative !important;
  top: 0 !important;
  background: var(--color-bg);
  color: #e0e0e0;
  padding-bottom: 120rpx;
  overflow-x: hidden;
}
view, text, image, input, textarea, button { box-sizing: border-box; }

.container { width: 100%; min-height: 100vh; position: relative; }

.workbench-boot {
  padding: 120rpx var(--space-4) var(--space-6);
  text-align: center;
}
.workbench-boot-cn {
  font-size: 28rpx;
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.06em;
}

/* ==================== 1. 自定义顶部导航 ==================== */
.status-bar-placeholder {
  position: fixed; top: 0; left: 0; width: 100%; z-index: 100;
  background: var(--color-bg);
}
.custom-navbar {
  position: fixed; left: 0; width: 100%; z-index: 100;
  display: flex; align-items: center; justify-content: center;
  background: rgba(26, 24, 20, 0.96); backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(38, 35, 32, 0.6);
}
.nav-spacer { width: 100%; flex-shrink: 0; }
.nav-left {
  position: absolute;
  left: 8rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  z-index: 2;
}
.nav-back {
  min-width: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
}
.nav-back-press {
  background: rgba(196, 167, 108, 0.08);
  border-color: var(--color-border, rgba(38, 35, 32, 0.4));
}
.back-icon {
  font-size: 34rpx;
  line-height: 1;
  color: var(--brass-400, #C4A76C);
}
.back-text {
  margin-left: 6rpx;
  font-size: 26rpx;
  line-height: 1;
  color: var(--brass-400, #C4A76C);
  font-weight: 500;
  letter-spacing: 0.02em;
}
.app-name {
  padding-left: 22rpx;
  font-family: var(--font-din);
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 2rpx;
  font-weight: 500;
}
.nav-title { font-size: 32rpx; font-weight: bold; color: #fff; }

/* ==================== 2. 看板 (Dashboard) ==================== */
/* 顶部仅保留少量呼吸感；左右/底仍用 space-4 节奏 */
.dashboard-view { padding: 16rpx 30rpx 30rpx; }

.dashboard-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16rpx; }
/* 左侧：问候 + 工作台名。必须 min-width:0（flex 子项默认 min-width:auto），
   否则长昵称（如「令狐冲大哥」）会把容器撑到超过可用宽度，"GOOD MORNING，xx" 折成两行。
   配合右下的 .welcome nowrap+ellipsis：宁可在问候语尾部省略，也不换行、不挤压右侧通知/日期。 */
.header-left { flex: 1 1 auto; min-width: 0; }
/* 右侧：工作通知声音 chip（#29）+ 日期徽标。不允许被左侧挤扁 */
.header-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.welcome { font-size: 24rpx; color: var(--gold); letter-spacing: 2rpx; font-weight: bold; text-transform: uppercase; display: block; margin-bottom: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.sub-welcome { font-size: 48rpx; color: #fff; font-weight: 900; white-space: nowrap; }
.date-badge { font-family: var(--font-din); color: #666; font-size: 24rpx; border: 1px solid rgba(255,255,255,0.1); padding: 6rpx 16rpx; border-radius: 30rpx; }

/* 金卡 KPI */
.kpi-card {
  background: linear-gradient(135deg, #4a3b18, #1a160a);
  border: 1px solid rgba(196, 167, 108,0.3); border-radius: 24rpx; padding: 40rpx;
  margin-bottom: 30rpx; position: relative; overflow: hidden;
  box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.5);
}
.kpi-card::before {
  content: ''; position: absolute; top: -50%; right: -50%; width: 200%; height: 200%;
  background: radial-gradient(circle, rgba(196, 167, 108,0.1) 0%, transparent 60%); pointer-events: none;
}
.card-row { display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 2; }
.card-label { font-size: 22rpx; color: rgba(255,255,255,0.6); font-weight: bold; letter-spacing: 1rpx; }
.card-icon { font-size: 32rpx; filter: grayscale(1); opacity: 0.7; }
.card-icon-img { width: 36rpx; height: 36rpx; opacity: 0.85; }
.card-value-lg { font-family: var(--font-din); font-size: 80rpx; font-weight: bold; color: #fff; margin: 10rpx 0; display: block; position: relative; z-index: 2; }

/* 经营信号板（全局 .signal-light；此处仅布局） */
.ops-signal-board {
  background: var(--color-bg-card);
  border: 1px solid var(--color-bg-elevated);
  border-radius: 24rpx;
  padding: 18rpx 22rpx 14rpx;
  margin-bottom: 16rpx;
}
.ops-signal-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
  gap: 16rpx;
}
.ops-signal-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.ops-signal-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.3;
}
.ops-signal-top-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}
.ops-legend-toggle {
  font-size: 22rpx;
  color: var(--gold);
  padding: 8rpx 0;
  line-height: 1.3;
}
.ops-signal-fold {
  font-size: 22rpx;
  color: var(--gold);
  padding: 8rpx 0;
  line-height: 1.3;
}
.ops-signal-board.is-collapsed {
  padding-bottom: 14rpx;
}
.ops-signal-summary {
  margin-top: 10rpx;
}
.ops-signal-summary-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
  line-height: 1.3;
}
.ops-signal-summary-ok {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}
.ops-signal-summary-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.ops-signal-summary-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 9999px;
  background: rgba(38, 35, 32, 0.85);
  border: 1px solid var(--color-bg-elevated);
}
.ops-signal-summary-text {
  font-size: 20rpx;
  color: var(--color-text-body);
  line-height: 1.3;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ops-signal-group {
  margin-top: 12rpx;
}
.ops-signal-group + .ops-signal-group {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1px solid var(--color-bg-elevated);
}
.ops-signal-group-title {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--color-text-muted);
  letter-spacing: 0.08em;
  margin-bottom: 8rpx;
  line-height: 1.3;
}
.ops-signal-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
}
.ops-signal-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 42%;
  flex: 1 1 40%;
  min-height: 40rpx;
  box-sizing: border-box;
}
.ops-signal-tap {
  padding: 2rpx 0;
}
.ops-signal-press {
  opacity: 0.72;
}
.ops-signal-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.35;
  flex: 1;
  min-width: 0;
}
.ops-signal-label--down {
  color: #D64045;
}
.ops-signal-label--up {
  color: #52B788;
}
.ops-signal-board .signal-light {
  margin-top: 1rpx;
}
.ops-signal-legend {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1px solid var(--color-bg-elevated);
  gap: 10rpx 20rpx;
}

/* 信息流跑马灯（标题行下方 · GMV 上方，单行低打扰） */
.ops-info-feed {
  margin-bottom: 20rpx;
}
.ops-info-feed--header {
  margin: -4rpx 0 20rpx;
}
.ops-info-feed-rail {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--color-bg-card);
  border: 1px solid #4D401A;
  border-radius: 16rpx;
  padding: 10rpx 16rpx;
  min-height: 56rpx;
  box-sizing: border-box;
}
.ops-info-feed--header .ops-info-feed-rail {
  min-height: 52rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
}
.ops-info-feed-tag {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--gold);
  line-height: 1.2;
  padding-right: 12rpx;
  border-right: 1px solid #4D401A;
}
.ops-info-feed-viewport {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.ops-info-feed-track {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  will-change: transform;
}
.ops-info-feed-track.is-marquee {
  animation-name: ops-info-feed-marquee;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}
@keyframes ops-info-feed-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
/* 每段至少约等于可视区宽度：单条短文案时 -50% 仍能无缝「从右侧再入」，避免静止或双份贴脸 */
.ops-info-feed-segment {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  padding-right: 64rpx;
  min-width: 560rpx;
}
.ops-info-feed-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 9999px;
  background: rgba(38, 35, 32, 0.85);
  border: 1px solid var(--color-bg-elevated);
}
.ops-info-feed--header .ops-info-feed-chip {
  padding: 4rpx 12rpx;
}
.ops-info-feed-text {
  font-size: 22rpx;
  color: var(--color-text-body);
  line-height: 1.3;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ops-info-feed--header .ops-info-feed-text {
  font-size: 20rpx;
  max-width: 360rpx;
}
.trend-meta-signal {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.stock-signal-wrap {
  display: flex;
  align-items: center;
}

.card-row.bottom { margin-top: 8rpx; }
.sub-metric { display: flex; flex-direction: column; }
.sub-metric .lbl { font-size: 18rpx; color: var(--gold); opacity: 0.8; margin-bottom: 4rpx; }
.sub-metric .val { font-family: var(--font-din); font-size: 32rpx; color: #fff; font-weight: bold; }
.v-line { width: 1px; height: 40rpx; background: rgba(255,255,255,0.1); }

/* 网格布局：CSS Grid 稳定 2-1-2，避免 flex+calc(50%-rpx) 在半卡固有宽度下误换行成单列 */
.dashboard-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
}
.dashboard-grid.dash-grid--stack {
  grid-template-columns: 1fr;
}
.grid-item {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 30rpx;
  width: auto;
  min-width: 0;
  max-width: 100%;
  border: 1px solid rgba(255,255,255,0.05);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
}
.full-width {
  grid-column: 1 / -1;
  width: auto;
}

.panel-title { font-size: 22rpx; color: #888; font-weight: bold; margin-bottom: 20rpx; letter-spacing: 1rpx; border-left: 4rpx solid var(--gold); padding-left: 12rpx; }

/* 快捷菜单 */
.menu-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx; }
.menu-btn { display: flex; flex-direction: column; align-items: center; }
.icon-box {
  width: 90rpx;
  height: 90rpx;
  background: var(--color-bg-elevated);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  position: relative;
  border: 1px solid rgba(77, 64, 26, 0.35);
}
/* 与 app.wxss .icon-gold 同源：任意 PNG → Brass-400 #C4A76C */
.menu-icon-img {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  filter: brightness(0) saturate(100%) invert(72%) sepia(28%) saturate(380%) hue-rotate(358deg) brightness(96%) contrast(88%);
}
.icon-letter {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gold);
  letter-spacing: 0.08em;
  font-family: var(--font-din);
  line-height: 1;
}
.menu-btn > text { font-size: 22rpx; color: #ccc; }
/* 待办计数：视觉走 .badge-info；此处只负责定位。直播状态仍用 .badge.live-onair */
.menu-badge-pos {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  z-index: 1;
}
.badge { position: absolute; top: -6rpx; right: -6rpx; background: var(--color-error, #D64045); color: #fff; font-size: 18rpx; padding: 2rpx 10rpx; border-radius: 20rpx; font-family: var(--font-din); }
.badge.live-onair {
  background: var(--color-error, #D64045);
  letter-spacing: 0.06em;
  font-size: 16rpx;
  padding: 2rpx 8rpx;
}

/* 门店现场入口（跳转独立页，不再往这个巨型页加 Tab） */
.panel-title.sub { margin-top: 32rpx; }

/* 店长工作台首屏：扫顾客会员码主 CTA（黄铜，视觉权重最高） */
.hub-scan-cta {
  margin: 0 0 28rpx;
}
.hub-scan-btn {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gold);
  color: var(--color-bg);
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
}
.hub-scan-btn-press {
  background: #A8903C !important;
}
.hub-scan-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  color: var(--color-text-secondary);
  letter-spacing: 0.02em;
}

.link-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.link-btn {
  flex: 1 1 calc(50% - 20rpx);
  min-width: 280rpx;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 16rpx;
  background: rgba(196, 167, 108, 0.06);
}
.link-btn:active { background: rgba(196, 167, 108, 0.14); }
.link-btn-head-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.link-badge {
  min-width: 32rpx;
  padding: 0 10rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 9999px;
  background: #D64045;
  color: #fff;
  font-size: 20rpx;
  font-family: var(--font-din);
  text-align: center;
}
.lb-cn { font-size: 28rpx; color: var(--gold); font-weight: 500; }
.lb-en {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 图表微件 */
.chart-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  overflow: hidden;
}
.chart-box--stacked {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.chart-box--stacked .legend { width: 100%; }
.donut {
  width: var(--donut-size, 96rpx);
  height: var(--donut-size, 96rpx);
  border-radius: 50%;
  flex-shrink: 0;
  -webkit-mask: radial-gradient(transparent 55%, var(--color-bg) 60%);
  mask: radial-gradient(transparent 55%, var(--color-bg) 60%);
}
.chart-box--stacked .donut {
  width: var(--donut-size, 112rpx);
  height: var(--donut-size, 112rpx);
}
.legend { flex: 1; min-width: 0; }
.legend-row { display: flex; align-items: center; font-size: 20rpx; color: var(--color-text-secondary); margin-bottom: 6rpx; font-family: var(--font-din); }
.dot { width: 8rpx; height: 8rpx; border-radius: 2rpx; margin-right: 10rpx; flex-shrink: 0; }
.dot.gold { background: var(--gold, #C4A76C); }
.dot.forest { background: #52B788; }
.dot.green { background: #52B788; }

.chart-empty {
  flex: 1;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
}
.chart-empty-hint { font-size: 18rpx; color: #4A4540; }
.trend-empty { min-height: 160rpx; }

.panel-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.panel-title.flat { margin-bottom: 0; }
.trend-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}
.trend-meta-item {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-din);
}
.trend-meta-item.up { color: #52B788; }
.trend-meta-item.down { color: #D64045; }
.trend-meta-item.flat { color: var(--color-text-secondary); }
.trend-meta-sep { color: #4A4540; font-size: 18rpx; }
.trend-meta--narrow .trend-meta-item { font-size: 16rpx; }
.trend-meta--narrow .trend-meta-sep { font-size: 16rpx; }

.trend-bars {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 6rpx;
  height: 172rpx;
  padding-top: 10rpx;
  box-sizing: border-box;
  overflow: hidden;
  width: 100%;
}
.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1 1 0;
  min-width: 0;
  height: 100%;
  justify-content: flex-end;
}
.bar-val-slot {
  flex-shrink: 0;
  height: 28rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.bar-val {
  font-size: 16rpx;
  color: var(--gold);
  font-family: var(--font-din);
  white-space: nowrap;
  line-height: 1;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}
.bar-track {
  flex: 1;
  min-height: 48rpx;
  width: 18rpx;
  max-width: 100%;
  background: rgba(255,255,255,0.04);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column-reverse;
  overflow: hidden;
}
.bar-fill { width: 100%; transition: height 0.45s ease; min-height: 0; }
.bar-fill.gold { background: linear-gradient(180deg, #D4BC85, var(--gold)); }
.bar-fill.forest { background: #2D5A3F; }
.bar-fill.green { background: #2D5A3F; }
.bar-lbl {
  flex-shrink: 0;
  font-size: 16rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
  font-family: var(--font-din);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  line-height: 1.1;
}

.trend-legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1px solid rgba(255,255,255,0.04);
}
.trend-legend .legend-row { margin-bottom: 0; }
.trend-week-sum {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--gold);
  font-family: var(--font-din);
  font-weight: 600;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 300px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .panel-title-row { flex-wrap: wrap; }
  .trend-meta { justify-content: flex-start; width: 100%; }
}

/* 本月订单 KPI 卡 */
.kpi-mini { display: flex; flex-direction: column; gap: 20rpx; flex: 1; }
.kpi-mini-main { display: flex; align-items: baseline; gap: 10rpx; }
.kpi-mini-val {
