  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--gold);
  padding: 8rpx 4rpx;
}
.om-batch-btn {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--gold);
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 14rpx;
  background: rgba(196, 167, 108, 0.06);
}
.om-batch-btn.disabled {
  color: var(--color-text-muted);
  border-color: var(--color-bg-elevated);
  background: var(--color-bg-card);
  pointer-events: none;
}
.om-days-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.om-days-chip {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  border: 1px solid #33302C;
  border-radius: 999rpx;
  background: var(--color-bg-card);
}
.om-days-chip.on {
  color: var(--color-bg);
  background: var(--gold);
  border-color: var(--gold);
  font-weight: 500;
}
.om-search-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.om-load-more {
  margin: 8rpx 0 40rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--gold);
  border: 1px dashed rgba(196, 167, 108, 0.35);
  border-radius: 16rpx;
  background: rgba(196, 167, 108, 0.05);
}
.om-btn.ghost {
  background: transparent;
  color: var(--gold);
  border: 1px solid rgba(196, 167, 108, 0.45);
  min-width: 140rpx;
}
.om-foot-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  align-items: center;
}
/* 门店自取逆向：待收回提示 */
.om-return-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-warning);
}

.om-skel {
  height: 24rpx;
  margin: 0 auto 16rpx;
  width: 60%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--color-bg-elevated) 0%, #33302C 50%, var(--color-bg-elevated) 100%);
  background-size: 200% 100%;
}
.om-skel.short { width: 40%; }
.om-loading-text {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}
.om-refund-note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-body);
  line-height: 1.45;
}
.om-miss-video {
  display: inline-block;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--color-text-primary);
  background: #D64045;
  border-radius: 8rpx;
}
.om-evidence {
  margin-top: 16rpx;
}
.om-evidence-video {
  width: 100%;
  height: 320rpx;
  margin-bottom: 12rpx;
  background: #151310;
  border-radius: 12rpx;
}
.om-evidence-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.om-evidence-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 10rpx;
  border: 1px solid #4D401A;
}

/* 发货抽屉：区块布局（勿用固定高度 form-row，避免快递名溢出叠字） */
.ship-modal-panel {
  background: var(--color-bg);
}
.ship-modal-body {
  padding-top: 28rpx;
  padding-bottom: 16rpx;
}
.ship-order-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 28rpx;
  line-height: 1.5;
}
.ship-order-no {
  color: var(--gold);
  font-weight: 600;
  font-family: var(--font-mono, monospace);
}
.ship-section {
  background: var(--color-bg-card);
  border: 1px solid var(--color-bg-elevated);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.ship-section-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.04em;
  margin-bottom: 16rpx;
}
.ship-carrier-scroll {
  width: 100%;
  height: 84rpx;
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.ship-carrier-chips {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  gap: 12rpx;
  height: 84rpx;
  padding: 0 2rpx;
}
.ship-carrier-chip {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--color-text-body);
  border: 1px solid #33302C;
  border-radius: 12rpx;
  background: var(--color-bg-elevated);
}
.ship-carrier-chip.on {
  color: var(--color-bg);
  background: var(--gold);
  border-color: var(--gold);
  font-weight: 600;
}
.ship-carrier-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1px solid #33302C;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-primary);
  text-align: left;
}
.ship-tracking-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ship-tracking-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--color-bg-elevated);
  border: 1px solid #33302C;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: left !important;
}
.ship-action-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--gold);
  background: rgba(196, 167, 108, 0.1);
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 12rpx;
  white-space: nowrap;
}
.ship-action-btn:active {
  opacity: 0.8;
  background: rgba(196, 167, 108, 0.2);
}
.ship-modal-foot {
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.ship-submit-btn {
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  letter-spacing: 0.06em;
}

/* --- [Tab 3] 核销验票 --- */
.verify-card { background: var(--color-bg-card); padding: 30rpx; border-radius: 16rpx; display: flex; align-items: center; margin-bottom: 20rpx; border-left: 6rpx solid var(--gold); box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2); }
.vc-left { display: flex; flex-direction: column; margin-right: 30rpx; align-items: center; width: 120rpx; border-right: 1px dashed #333; padding-right: 20rpx; }
.vc-time { font-family: var(--font-din); font-size: 36rpx; font-weight: bold; color: #fff; }
.vc-status { font-size: 20rpx; color: var(--gold); margin-top: 4rpx; font-weight: bold; }
.vc-mid { flex: 1; display: flex; flex-direction: column; }
.vc-name { font-size: 30rpx; font-weight: bold; color: #fff; margin-bottom: 6rpx; }
.vc-desc { font-size: 22rpx; color: #888; }
.vc-btn { background: #52B788; color: #fff; font-size: 26rpx; padding: 12rpx 36rpx; border-radius: 40rpx; font-weight: bold; }
.scan-hint { font-size: 22rpx; color: var(--color-text-secondary); margin: -8rpx 0 24rpx; line-height: 1.5; }
.verify-live-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.member-pass-panel { max-height: 76vh; }
.member-pass-body { padding: 24rpx 32rpx 12rpx; display: flex; flex-direction: column; gap: 16rpx; }
.mp-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mp-status { font-size: 32rpx; font-weight: 600; letter-spacing: 0.04em; }
.mp-status.ok { color: #52B788; }
.mp-status.bad { color: #E9A23B; }
.mp-msg { font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.5; }
.mp-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; }
.mp-label { font-size: 22rpx; color: var(--color-text-muted); flex-shrink: 0; }
.mp-value { font-size: 26rpx; color: var(--color-text-body); text-align: right; }
.mp-value.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.06em; color: var(--gold); }
.mp-perks { display: flex; flex-direction: column; gap: 12rpx; padding-top: 8rpx; border-top: 1px solid var(--color-bg-elevated); }
.mp-perk-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.mp-perk-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx 10rpx 12rpx;
  background: var(--color-bg-card);
  border: 1px solid var(--color-bg-elevated);
  border-radius: 12rpx;
}
.mp-perk-icon { width: 28rpx; height: 28rpx; }
.mp-perk-text { font-size: 22rpx; color: var(--gold); letter-spacing: 0.04em; }

/* --- [Tab 4] 店铺装修 (Banner) --- */
.hero-edit-card { display: flex; flex-direction: column; background: var(--color-bg-card); border-radius: 16rpx; padding: 20rpx; overflow: hidden; margin-bottom: 40rpx; }
.hero-preview { width: 100%; height: 300rpx; border-radius: 12rpx; margin-bottom: 20rpx; background: var(--color-bg); }
.card-actions { display: flex; justify-content: flex-end; }
.btn-small { font-size: 24rpx; padding: 10rpx 30rpx; border-radius: 30rpx; font-weight: bold; }
.btn-small.gold { background: var(--gold); color: var(--color-bg); }

.banner-list { display: flex; flex-direction: column; gap: 24rpx; }
.banner-item { display: flex; background: var(--color-bg-card); padding: 20rpx; border-radius: 16rpx; align-items: center; border: 1px solid rgba(255,255,255,0.05); }
.b-thumb { width: 160rpx; height: 90rpx; border-radius: 8rpx; background: var(--color-bg); margin-right: 24rpx; object-fit: cover; }
.b-info { flex: 1; display: flex; flex-direction: column; }
.b-title { font-size: 28rpx; color: #fff; font-weight: bold; margin-bottom: 4rpx; }
.b-sub { font-size: 20rpx; color: #888; margin-bottom: 8rpx; }
.b-tag { font-size: 18rpx; color: var(--gold); background: rgba(196, 167, 108,0.1); padding: 2rpx 8rpx; border-radius: 4rpx; align-self: flex-start; }
.b-actions { display: flex; gap: 20rpx; }
.action-btn { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.05); border-radius: 50%; font-size: 24rpx; }
.action-btn.edit { color: #ccc; }
.action-btn.del { color: #ff4d4f; }

/* --- [Tab 5] 标本师管理 --- */
.framer-admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 24rpx;
  padding: 0 4rpx;
  gap: 16rpx;
}
.framer-admin-brand { display: flex; flex-direction: column; min-width: 0; }
.framer-admin-en {
  font-family: var(--font-din, monospace);
  font-size: 18rpx;
  color: var(--gold, #C4A76C);
  letter-spacing: 3rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}
.framer-admin-cn {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.framer-stats {
  display: flex;
  align-items: stretch;
  margin: 0 0 24rpx;
  padding: 20rpx 12rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border-highlight, #4D401A);
  border-radius: var(--radius-md, 16rpx);
}
.framer-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 0 8rpx;
}
.framer-stat-n {
  font-family: var(--font-din, monospace);
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}
.framer-stat.warn .framer-stat-n { color: #E9A23B; }
.framer-stat-l {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 1rpx;
}
.framer-stat-div {
  width: 1px;
  align-self: stretch;
  background: rgba(77, 64, 26, 0.45);
  flex-shrink: 0;
}

.framer-search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.framer-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: 16rpx;
  color: #fff;
  font-size: 26rpx;
}
.framer-search-ph { color: var(--color-text-muted); }
.framer-search-clear {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--gold, #C4A76C);
  padding: 12rpx 8rpx;
}

.framer-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 24rpx;
}
.framer-chip-gap {
  width: 8rpx;
  height: 1px;
  flex-shrink: 0;
}
.framer-chip {
  padding: 10rpx 18rpx;
  border-radius: 9999px;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  line-height: 1.2;
}
.framer-chip.on {
  color: var(--color-bg);
  background: var(--gold, #C4A76C);
  border-color: var(--gold, #C4A76C);
  font-weight: 600;
}
.framer-chip.on.warn {
  color: var(--color-bg);
  background: #E9A23B;
  border-color: #E9A23B;
}

.framer-card {
  display: flex;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  align-items: flex-start;
  border: 1px solid rgba(255, 255, 255, 0.05);
  gap: 20rpx;
}
.framer-card.off { opacity: 0.72; }
.framer-card.dup {
  border-color: rgba(233, 162, 59, 0.45);
}
.f-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg);
  flex-shrink: 0;
  border: 2rpx solid #333;
}
.f-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.f-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 10rpx;
  min-width: 0;
}
.f-name {
  font-size: 30rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1.3;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.f-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.2;
  letter-spacing: 0.5rpx;
}
.f-tag.type {
  color: var(--gold);
  background: rgba(196, 167, 108, 0.12);
}
.f-tag.on {
  color: #52B788;
  background: rgba(82, 183, 136, 0.12);
}
.f-tag.off {
  color: var(--color-text-secondary);
  background: rgba(160, 154, 144, 0.12);
}
.f-tag.canon {
  color: var(--color-bg);
  background: var(--gold);
  font-weight: 600;
}
.f-tag.dup {
  color: #E9A23B;
  background: rgba(233, 162, 59, 0.14);
}
.f-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx 8rpx;
  min-width: 0;
}
.f-meta {
  font-size: 22rpx;
  color: var(--color-text-body);
  line-height: 1.35;
}
.f-meta.muted { color: var(--color-text-muted); }
.f-meta-dot { color: var(--color-text-muted); font-size: 22rpx; }
.f-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}
.f-act {
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-body);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  line-height: 1.2;
}
.f-act.accent {
  color: var(--gold);
  border-color: rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.1);
}
.f-act.warn {
  color: #E9A23B;
  border-color: rgba(233, 162, 59, 0.4);
  background: rgba(233, 162, 59, 0.1);
}

.framer-modal-ops {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.45);
}
.framer-modal-ops-title {
  display: block;
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.framer-bind-line { margin-bottom: 14rpx; }
.framer-bind-label {
  font-size: 24rpx;
  color: var(--color-text-body);
  line-height: 1.4;
}
.framer-bind-label.muted { color: var(--color-text-muted); }
.framer-modal-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.framer-modal-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #E9A23B;
  line-height: 1.45;
}
.radio-label {
  margin-right: 24rpx;
  font-size: 26rpx;
  color: var(--color-text-body);
}
.switch-row {
  align-items: center;
}
.framer-bind-panel .modal-body { max-height: 55vh; }
.framer-bind-search { padding: 0 28rpx 16rpx; }
.framer-bind-scroll { padding-top: 0; }
.framer-bind-item {
  padding: 22rpx 8rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}
.framer-bind-name {
  display: block;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.framer-bind-meta {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* --- [Tab 6] 权益会员 (按钮块) --- */
.add-btn-block { background: var(--color-bg-card); border: 2rpx dashed #444; color: #888; font-size: 28rpx; font-weight: bold; text-align: center; padding: 30rpx; border-radius: 16rpx; margin-top: 30rpx; }

/* --- [Tab 8] 营收录入 (高级财务报表风) --- */

.ledger-header { 
  display: flex; justify-content: space-between; align-items: center; 
  margin-bottom: 40rpx; padding: 0 10rpx;
}
.lh-en { 
  font-family: var(--font-din); font-size: 20rpx; color: var(--gold); 
  letter-spacing: 4rpx; display: block; margin-bottom: 6rpx; font-weight: bold;
}
.lh-cn { font-size: 36rpx; font-weight: 900; color: #fff; letter-spacing: 2rpx; }

.ledger-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.add-btn-ghost {
  border: 1px solid rgba(196, 167, 108, 0.35);
  color: var(--color-text-secondary, #A09A90);
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
}
.add-btn-gold { 
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.1)); 
  border: 1px solid rgba(196, 167, 108,0.4); 
  color: var(--gold); 
  padding: 12rpx 30rpx; border-radius: 40rpx; 
  font-size: 24rpx; font-weight: bold; display: flex; align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.plus { font-size: 32rpx; margin-right: 8rpx; line-height: 1; }
.mp-row { margin-top: 12rpx; opacity: 0.85; }

.ledger-month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: -16rpx 10rpx 32rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border-highlight, #4D401A);
  border-radius: var(--radius-md, 16rpx);
}
.ledger-month-picker {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.lmp-en {
  font-family: var(--font-din);
  font-size: 18rpx;
  color: var(--gold, #C4A76C);
  letter-spacing: 2rpx;
  font-weight: bold;
}
.lmp-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}
.lmp-arrow {
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
  margin-left: 4rpx;
}
.ledger-month-hint {
