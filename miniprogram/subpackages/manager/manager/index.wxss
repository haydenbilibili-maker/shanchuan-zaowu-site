}
.report-signal-chip.warn {
  color: var(--color-warning, #E9A23B);
  border-color: rgba(233, 162, 59, 0.35);
}
.report-signal-chip.danger {
  color: var(--color-error, #D64045);
  border-color: rgba(214, 64, 69, 0.35);
}
.report-signal-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -8rpx 0;
}
.report-signal-item {
  position: relative;
  box-sizing: border-box;
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  border-radius: var(--radius-md, 16rpx);
  border: 1px solid var(--color-border, #26232066);
  background: var(--color-bg-elevated, #262320);
