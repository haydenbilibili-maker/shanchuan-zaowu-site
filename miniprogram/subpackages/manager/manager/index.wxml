             <text class="week-split-l">线上（小程序）</text>
             <text class="week-split-v">¥{{trendMeta.weekOnlineFmt}}</text>
          </view>
          <view class="week-share-track">
             <view class="week-share-fill gold" style="{{trendMeta.weekOnlineBar}}"></view>
          </view>
          <view class="week-split-row">
             <text class="week-split-l">门店（账本）</text>
             <text class="week-split-v">¥{{trendMeta.weekOfflineFmt}}</text>
          </view>
          <view class="week-share-track">
             <view class="week-share-fill forest" style="{{trendMeta.weekOfflineBar}}"></view>
          </view>
          <text class="week-split-hint">线上 = 小程序已付 GMV · 门店 = 账本净额（不含小程序订单）</text>
       </view>
       <view class="chart-empty" wx:else>
          <text>近 7 日暂无拆分</text>
       </view>
    </view>

  </view>
  
  <view class="footer-logo">
    <text class="footer-en">NATURE'S ADMIN</text>
    <text class="footer-cn">山海造物 · 管理工作台</text>
  </view>
</view>

<!-- 常用编辑面板：已选可上移 / 下移 / 移除，下方按分区加入；保存才生效 -->
<view class="hub-sheet-mask" wx:if="{{hubFavEdit.open}}" bindtap="closeFavEditor" catchtouchmove="noop"></view>
<view class="hub-sheet hub-fav-sheet" wx:if="{{hubFavEdit.open}}">
  <view class="hub-sheet-head">
    <text class="hub-sheet-title">编辑常用 · {{hubFavEdit.count}}/{{hubFavEdit.max}}</text>
    <view class="hub-sheet-close" bindtap="closeFavEditor" hover-class="tap-press" hover-stay-time="80">取消</view>
  </view>
  <scroll-view class="hub-fav-scroll" scroll-y>
    <view class="hub-fav-sel-empty" wx:if="{{!hubFavEdit.selected.length}}"><text>尚未选择，点下方入口加入</text></view>
    <view class="hub-fav-sel" wx:for="{{hubFavEdit.selected}}" wx:key="id">
      <image class="hub-fav-sel-ico" src="{{item.icon}}" mode="aspectFit" />
      <text class="hub-fav-sel-name">{{item.label}}</text>
      <view class="hub-fav-op {{item.first ? 'is-off' : ''}}" bindtap="onFavMove" data-id="{{item.id}}" data-dir="up" hover-class="tap-press" hover-stay-time="80">上移</view>
      <view class="hub-fav-op {{item.last ? 'is-off' : ''}}" bindtap="onFavMove" data-id="{{item.id}}" data-dir="down" hover-class="tap-press" hover-stay-time="80">下移</view>
      <view class="hub-fav-op is-remove" bindtap="onFavToggle" data-id="{{item.id}}" hover-class="tap-press" hover-stay-time="80">移除</view>
    </view>
    <view class="hub-fav-full" wx:if="{{hubFavEdit.full}}"><text>已满 {{hubFavEdit.max}} 个，移除后才能再加入</text></view>
    <view class="hub-fav-group" wx:for="{{hubFavEdit.groups}}" wx:for-item="g" wx:key="id">
      <text class="hub-fav-group-title">{{g.title}}</text>
      <view class="hub-fav-chips">
        <view
          class="hub-fav-chip {{item.added ? 'is-added' : ''}} {{!item.added && hubFavEdit.full ? 'is-off' : ''}}"
          wx:for="{{g.items}}"
          wx:key="id"
          bindtap="onFavToggle"
          data-id="{{item.id}}"
          hover-class="tap-press"
          hover-stay-time="80"
        >
          <text>{{item.added ? '✓ ' : '+ '}}{{item.label}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
  <view class="hub-fav-actions">
    <view class="hub-fav-btn is-ghost" bindtap="onFavReset" hover-class="tap-press" hover-stay-time="80">恢复默认</view>
    <view class="hub-fav-btn is-primary" bindtap="onFavSave" hover-class="tap-press" hover-stay-time="80">保存</view>
  </view>
</view>

<!-- 合并磁贴的二级面板：只列有权限的子项；点按后收起并走原入口 -->
<view class="hub-sheet-mask" wx:if="{{hubSheet.open}}" bindtap="closeHubGroup" catchtouchmove="noop"></view>
<view class="hub-sheet" wx:if="{{hubSheet.open}}" catchtouchmove="noop">
  <view class="hub-sheet-head">
    <text class="hub-sheet-title">{{hubSheet.title}}</text>
    <view class="hub-sheet-close" bindtap="closeHubGroup" hover-class="tap-press" hover-stay-time="80">收起</view>
  </view>
  <view
    class="hub-sheet-item"
    wx:for="{{hubSheet.items}}"
    wx:key="id"
    bindtap="onHubGroupItem"
    data-id="{{item.id}}"
    hover-class="tap-press-soft"
    hover-stay-time="80"
  >
    <view class="hub-sheet-main">
      <text class="hub-sheet-name">{{item.label}}</text>
      <text class="hub-sheet-desc">{{item.desc}}</text>
    </view>
    <text class="hub-sheet-badge" wx:if="{{item.badge > 0}}">{{item.badgeText}}</text>
    <text class="hub-sheet-arrow">›</text>
  </view>
</view>

</view>
