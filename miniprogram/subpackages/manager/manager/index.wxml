             </view>
             <view class="kpi-mini-cell">
                <text class="kpi-mini-l">到店核销</text>
                <text class="kpi-mini-v">{{stats.visitCountFmt}}</text>
             </view>
          </view>
          <text class="week-split-hint" wx:if="{{stats.ordersEmpty}}">本月尚无已支付线上单</text>
       </view>
    </view>

    <!-- 7 日营收趋势（相对峰值缩放 + 日均/环比） -->
