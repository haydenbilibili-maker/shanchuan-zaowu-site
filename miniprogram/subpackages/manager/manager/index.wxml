                <text class="kpi-mini-v">{{stats.avgOrderFmt}}</text>
             </view>
             <view class="kpi-mini-cell">
                <text class="kpi-mini-l">到店核销</text>
                <text class="kpi-mini-v">{{stats.visitCountFmt}}</text>
             </view>
          </view>
          <text class="week-split-hint" wx:if="{{stats.ordersEmpty}}">本月尚无已支付线上单</text>
       </view>
    </view>

    <!-- 7 日营收趋势（相对峰值缩放 + 日均/环比） -->
    <view class="grid-item full-width" wx:if="{{menu.dashboardKpi}}">
       <view class="panel-title-row">
          <view class="panel-title flat"><text class="panel-en">TREND</text><text class="panel-cn">营收趋势</text></view>
          <view class="trend-meta {{chartLayout.narrow ? 'trend-meta--narrow' : ''}}" wx:if="{{!stats.ratioEmpty}}">
             <text class="trend-meta-item">日均 ¥{{stats.dailyAvgFmt}}</text>
             <text class="trend-meta-sep">·</text>
             <view class="trend-meta-item {{stats.momClass}} trend-meta-signal">
               <view class="signal-light {{opsSignals.mom}}"></view>
               <text>环比 {{stats.momLabel}}</text>
             </view>
          </view>
       </view>
       <!-- 今日 · 较昨日（2026-10-18 方向池 ★★）：同一份 7 日数据现算 -->
       <view class="trend-today" wx:if="{{!trendMeta.empty && trendMeta.todayFmt}}">
          <text class="trend-today-k">今日</text>
          <text class="trend-today-v">¥{{trendMeta.todayFmt}}</text>
          <text class="trend-today-d {{trendMeta.dayDeltaClass}}" wx:if="{{trendMeta.dayDeltaText}}">{{trendMeta.dayDeltaText}}</text>
       </view>
       <view class="trend-bars" id="dash-trend-bars" style="{{chartLayout.trendBarsStyle}}" wx:if="{{!trendMeta.empty}}">
          <block wx:for="{{trendData}}" wx:key="dateKey">
             <view class="bar-col">
                <view class="bar-val-slot">
                   <text class="bar-val" style="{{chartLayout.valFontStyle}}" wx:if="{{item.showVal}}">{{item.valShort}}</text>
                </view>
                <view class="bar-track" style="{{chartLayout.barTrackStyle}}">
                   <view class="bar-fill gold" style="{{item.styleOnline}}"></view>
                   <view class="bar-fill forest" style="{{item.styleOffline}}"></view>
                </view>
                <text class="bar-lbl" style="{{chartLayout.lblFontStyle}}">{{item.day}}</text>
             </view>
          </block>
       </view>
       <view class="chart-empty trend-empty" wx:else>
          <text>{{trendMeta.error ? '趋势加载失败' : '近 7 日暂无入账'}}</text>
          <text class="chart-empty-hint">下拉刷新重试</text>
       </view>
       <view class="trend-legend" wx:if="{{!trendMeta.empty}}">
          <view class="legend-row"><view class="dot gold"></view><text>小程序GMV</text></view>
          <view class="legend-row"><view class="dot forest"></view><text>门店账本</text></view>
          <text class="trend-week-sum">近7日 ¥{{trendMeta.weekTotalFmt}}</text>
       </view>
    </view>

    <!-- 库存速览 + 近7日渠道拆分 -->
    <view class="grid-item" wx:if="{{menu.dashboardKpi && menu.products}}">
       <view class="panel-title-row">
          <view class="panel-title flat"><text class="panel-en">STOCK</text><text class="panel-cn">库存</text></view>
          <view class="stock-signal-wrap" wx:if="{{opsSignals.stock}}">
            <view class="signal-light {{opsSignals.stock}}"></view>
          </view>
       </view>
       <view class="stock-mini" wx:if="{{dashStock.ready && !dashStock.empty}}">
          <view class="stock-mini-row">
             <view class="stock-mini-cell">
                <text class="stock-mini-v accent">{{dashStock.onShelf}}</text>
                <text class="stock-mini-l">在架</text>
             </view>
             <view class="stock-mini-cell">
                <text class="stock-mini-v">{{dashStock.offShelf}}</text>
                <text class="stock-mini-l">下架</text>
             </view>
             <view class="stock-mini-cell">
                <text class="stock-mini-v">{{dashStock.stockTotal}}</text>
                <text class="stock-mini-l">库存件</text>
             </view>
          </view>
          <view class="stock-cat" wx:if="{{dashStock.topCats.length}}">
             <view class="stock-cat-row" wx:for="{{dashStock.topCats}}" wx:key="key">
                <text class="stock-cat-n">{{item.name}}</text>
                <view class="stock-cat-track"><view class="stock-cat-fill" style="{{item.barStyle}}"></view></view>
                <text class="stock-cat-c">{{item.count}}</text>
             </view>
          </view>
       </view>
       <view class="chart-empty" wx:elif="{{dashStock.error}}">
          <text>库存加载失败</text>
          <text class="chart-empty-hint">点此重试或下拉刷新</text>
          <view hover-class="tap-press" hover-stay-time="80" class="dash-retry" catchtap="loadDashboardStock">重试</view>
       </view>
       <view class="chart-empty" wx:else>
          <text>{{dashStock.loading ? '统计中…' : '暂无库存数据'}}</text>
       </view>
    </view>

    <view class="grid-item {{menu.products ? '' : 'full-width'}}" wx:if="{{menu.dashboardKpi}}">
       <view class="panel-title"><text class="panel-en">WEEK</text><text class="panel-cn">近 7 日</text></view>
       <view class="week-split" wx:if="{{!trendMeta.empty}}">
          <view class="week-split-row">
             <text class="week-split-l">线上（小程序）</text>
             <text class="week-split-v">¥{{trendMeta.weekOnlineFmt}}</text>
          </view>
          <view class="week-share-track">
             <view class="week-share-fill gold" style="{{trendMeta.weekOnlineBar}}"></view>
          </view>
          <view class="week-split-row">
             <text class="week-split-l">门店（账本）</text>
             <text class="week-split-v">¥{{trendMeta.weekOfflineFmt}}</text>
          </view>
          <view class="week-share-track">
             <view class="week-share-fill forest" style="{{trendMeta.weekOfflineBar}}"></view>
          </view>
          <text class="week-split-hint">线上 = 小程序已付 GMV · 门店 = 账本净额（不含小程序订单）</text>
       </view>
       <view class="chart-empty" wx:else>
          <text>近 7 日暂无拆分</text>
       </view>
    </view>

  </view>
  
  <view class="footer-logo">
    <text class="footer-en">NATURE'S ADMIN</text>
    <text class="footer-cn">山海造物 · 管理工作台</text>
  </view>
</view>

<!-- 常用编辑面板：已选可上移 / 下移 / 移除，下方按分区加入；保存才生效 -->
<view class="ui-pop-mask" wx:if="{{hubFavEdit.open}}" bindtap="closeFavEditor" catchtouchmove="true">
  <view class="ui-pop-sheet hub-sheet hub-fav-sheet" wx:if="{{hubFavEdit.open}}" catchtap="true">
    <view class="ui-pop-grip"></view>
    <view class="hub-sheet-head">
      <text class="hub-sheet-title">编辑常用 · {{hubFavEdit.count}}/{{hubFavEdit.max}}</text>
      <view class="hub-sheet-close" bindtap="closeFavEditor" hover-class="tap-press" hover-stay-time="80">取消</view>
    </view>
    <scroll-view class="hub-fav-scroll" scroll-y>
      <view class="hub-fav-sel-empty" wx:if="{{!hubFavEdit.selected.length}}"><text>尚未选择，点下方入口加入</text></view>
      <view class="hub-fav-sel" wx:for="{{hubFavEdit.selected}}" wx:key="id">
        <image class="hub-fav-sel-ico" src="{{item.icon}}" mode="aspectFit" />
        <text class="hub-fav-sel-name">{{item.label}}</text>
        <view class="hub-fav-op {{item.first ? 'is-off' : ''}}" bindtap="onFavMove" data-id="{{item.id}}" data-dir="up" hover-class="tap-press" hover-stay-time="80">上移</view>
        <view class="hub-fav-op {{item.last ? 'is-off' : ''}}" bindtap="onFavMove" data-id="{{item.id}}" data-dir="down" hover-class="tap-press" hover-stay-time="80">下移</view>
        <view class="hub-fav-op is-remove" bindtap="onFavToggle" data-id="{{item.id}}" hover-class="tap-press" hover-stay-time="80">移除</view>
      </view>
      <view class="hub-fav-full" wx:if="{{hubFavEdit.full}}"><text>已满 {{hubFavEdit.max}} 个，移除后才能再加入</text></view>
      <view class="hub-fav-group" wx:for="{{hubFavEdit.groups}}" wx:for-item="g" wx:key="id">
        <text class="hub-fav-group-title">{{g.title}}</text>
        <view class="hub-fav-chips">
          <view
            class="hub-fav-chip {{item.added ? 'is-added' : ''}} {{!item.added && hubFavEdit.full ? 'is-off' : ''}}"
            wx:for="{{g.items}}"
            wx:key="id"
            bindtap="onFavToggle"
            data-id="{{item.id}}"
            hover-class="tap-press"
            hover-stay-time="80"
          >
            <text>{{item.added ? '✓ ' : '+ '}}{{item.label}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="hub-fav-actions">
      <view class="hub-fav-btn is-ghost" bindtap="onFavReset" hover-class="tap-press" hover-stay-time="80">恢复默认</view>
      <view class="hub-fav-btn is-primary" bindtap="onFavSave" hover-class="tap-press" hover-stay-time="80">保存</view>
    </view>
  </view>
</view>

</view>

<!-- 全站样式化弹窗宿主（utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
