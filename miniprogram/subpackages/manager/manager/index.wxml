<!--pages/manager/index.wxml-->
<!--
  返回策略（布局优先）：
  - 不用 page-container：真机会锁纵向滚动、改写 page 定位，导致顶栏遮挡与难滑
  - page.json disableSwipeBack + page-edge-back 自绘左缘（不 catch，不挡滚动）
  - 功能模块已拆至 manager/workspace（系统导航）；hub 仅看板 + leaveWorkbench
-->
<view class="container">
  <page-edge-back bind:back="onWorkspaceBack" disabled="{{showCommentReplyModal}}" />

<!-- ==================== 1. 全局导航栏 (Custom Navbar) ==================== -->
<!-- 状态栏遮罩：fixed，不占文档流，避免与 nav-spacer 重复叠加 statusBarHeight -->
<view class="status-bar-placeholder" style="height: {{navTop}}px;"></view>

<!-- 导航栏本体：贴合胶囊高度，固定在状态栏下方 -->
<view class="custom-navbar" style="top: {{navTop}}px; height: {{navBarHeight}}px;">
  <!-- 根视图：离开工作台 → 真实上一页（与左滑一致） -->
  <nav-back
    wx:if="{{!showCommentReplyModal}}"
    ext-class="nav-left nav-back"
    bind:back="leaveWorkbench"
  />
  <view class="nav-left" wx:else></view>

  <!-- 中间区域：页面标题 -->
  <view class="nav-title">经营概况</view>
</view>

<!-- 仅一处占位：statusBar + navBar，内容紧贴自定义导航下方 -->
<view class="nav-spacer" style="height: {{navSpacerHeight}}px;"></view>

<!-- 首屏骨架：形状对齐问候行 / 待办卡 / 扫码主按钮 / 两行常用磁贴，数据回来后原位替换，不跳版 -->
<view class="workbench-boot wb-sk" wx:if="{{!workspaceReady}}" aria-label="工作台加载中">
  <view class="ui-sk-line title"></view>
  <view class="ui-sk-line wb-sk-sub"></view>
  <view class="ui-sk-card">
    <view class="ui-sk-line wb-sk-sub"></view>
    <view class="wb-sk-tiles">
      <view class="ui-sk-line wb-sk-todo" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
    </view>
  </view>
  <view class="ui-sk-line bar wb-sk-cta"></view>
  <view class="ui-sk-card">
    <view class="ui-sk-line wb-sk-sub"></view>
    <view class="wb-sk-tiles">
      <view class="ui-sk-line wb-sk-tile" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
    </view>
    <view class="wb-sk-tiles">
      <view class="ui-sk-line wb-sk-tile" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
    </view>
  </view>
</view>

<!-- ==================== 2. 主视图：经营看板 (Dashboard) ==================== -->
<view class="content-area dashboard-view" wx:if="{{curTab === 0 && workspaceReady && !artisanEmbed}}">
  
  <!-- 头部问候与日期 -->
  <view class="dashboard-header">
    <view class="header-left">
      <text class="welcome">{{greeting}}{{staffName ? '，' + staffName : ''}}</text>
      <text class="sub-welcome">{{isSuperAdmin ? '超管工作台' : '店长工作台'}}</text>
    </view>
    <view class="header-right">
       <!-- 工作通知声音（#29）：点=开关，长按=试听 -->
       <work-notice-voice />
       <text class="date-badge">{{todayDate}}</text>
    </view>
  </view>

  <view class="page-tip is-{{hubTipTone}}" wx:if="{{hubTipText}}"><text>{{hubTipText}}</text></view>

  <!-- 信息流跑马灯：标题下 / GMV 上；仅有待办/异常时展示，不挤标题行 -->
  <view class="ops-info-feed ops-info-feed--header" wx:if="{{opsInfoFeed.length}}">
    <view class="ops-info-feed-rail">
      <text class="ops-info-feed-tag">信息流</text>
      <view class="ops-info-feed-viewport">
        <view
          class="ops-info-feed-track {{opsInfoFeedAnimSec ? 'is-marquee' : ''}}"
          style="{{opsInfoFeedAnimStyle}}"
        >
          <view
            class="ops-info-feed-segment"
            wx:for="{{opsInfoFeedSets}}"
            wx:for-item="seg"
            wx:for-index="segIdx"
            wx:key="segIdx"
          >
            <view
              class="ops-info-feed-chip"
              wx:for="{{seg}}"
              wx:key="id"
              bindtap="goOpsSignal"
              data-target="{{item.target}}"
              hover-class="ops-signal-press"
              hover-stay-time="80"
            >
              <view class="signal-light {{item.lamp}}"></view>
              <text class="ops-info-feed-text">{{item.text}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 待办卡（2026-10-01 待办优先）：分区磁贴上的每一种计数角标都在这里汇总（hubNav.HUB_TODOS，check:hub-entries 守），点按走原入口 -->
  <view class="hub-todo" wx:if="{{hubTodo.items.length}}">
    <view class="hub-todo-head">
      <view class="hub-titles">
        <text class="hub-en">TO DO</text>
        <text class="hub-cn">待处理</text>
      </view>
      <view class="hub-todo-total">
        <text class="hub-todo-num">{{hubTodo.totalText}}</text>
        <text class="hub-todo-unit">件</text>
      </view>
    </view>
    <view class="hub-todo-cells">
      <view
        class="hub-todo-cell"
        wx:for="{{hubTodo.items}}"
        wx:key="id"
        bindtap="onHubTodo"
        data-id="{{item.id}}"
        hover-class="tap-press-soft"
        hover-stay-time="80"
      >
        <text class="hub-todo-cell-num">{{item.count}}</text>
        <text class="hub-todo-cell-label">{{item.label}}</text>
        <text class="hub-todo-cell-new" wx:if="{{item.extra}}">{{item.extra}}</text>
      </view>
    </view>
  </view>
  <view class="hub-todo hub-todo--clear" wx:elif="{{hubTodo.any}}">
    <view class="hub-titles">
      <text class="hub-en">TO DO</text>
      <text class="hub-cn">待处理</text>
    </view>
    <text class="hub-todo-ok">已全部处理</text>
  </view>

  <!-- 首屏主 CTA：扫顾客会员码（立刻开相机，成功后再进 field 核销） -->
  <view class="hub-scan-cta" wx:if="{{menu.verify || menu.grantPoints || menu.staffConsole}}">
    <view
      class="hub-scan-btn"
      hover-class="hub-scan-btn-press"
      hover-stay-time="120"
      bindtap="goScanMember"
    >扫顾客会员码</view>
    <text class="hub-scan-hint">核验权益 · 预约票 · 门店礼券 · 礼赠自提</text>
  </view>

  <!-- 我的常用（首屏核心）：按 hubNav.HUB_ENTRIES 渲染、只含有权限入口；「编辑」增删排序，或在下方「全部功能」长按入口加入 / 移出（上限 8，本地保存） -->
  <view class="hub-fav">
    <view class="hub-fav-head">
      <view class="hub-titles">
        <text class="hub-en">PINNED</text>
        <text class="hub-cn">我的常用</text>
      </view>
      <view class="hub-fav-edit" bindtap="openFavEditor" hover-class="tap-press" hover-stay-time="80">编辑</view>
    </view>
    <view class="hub-grid hub-grid--fav" wx:if="{{hubFav.length}}">
      <view
        class="hub-tile hub-fav-tile"
        wx:for="{{hubFav}}"
        wx:key="id"
        bindtap="onHubFav"
        data-id="{{item.id}}"
        hover-class="tap-press"
        hover-stay-time="80"
      >
        <view class="hub-ico {{item.group ? 'is-stack' : ''}}">
          <image class="hub-ico-img" src="{{item.icon}}" mode="aspectFit" />
          <view class="hub-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
        </view>
        <text>{{item.label}}</text>
      </view>
    </view>
    <view class="hub-fav-empty" wx:else bindtap="openFavEditor" hover-class="tap-press-soft" hover-stay-time="80">
      <text>还没有常用入口：点「编辑」挑选，或在下方「全部功能」长按入口加入</text>
    </view>
  </view>

  <!-- 核心指标卡片 (金卡) -->
  <view class="kpi-card gold-card" wx:if="{{menu.dashboardKpi}}">
     <view class="card-row top">
       <view class="card-titles">
         <text class="card-eyebrow">GMV · THIS MONTH</text>
         <text class="card-label">本月营收</text>
       </view>
       <image class="card-icon-img" src="/assets/icons/medal_gold.png" mode="aspectFit" />
     </view>
     <view wx:if="{{analyticsError}}" class="kpi-error-row">
       <text class="kpi-error-text">经营数据未能刷新：{{analyticsError}}</text>
       <text class="kpi-error-retry" catchtap="loadAnalyticsDashboard">重试</text>
     </view>
     <text class="card-value-lg">¥{{stats.displayGrand || '0'}}</text>
     <view class="card-row bottom">
        <view class="sub-metric"><text class="lbl">小程序｜GMV</text><text class="val">¥{{stats.onlineTotal}}</text></view>
        <view class="v-line"></view>
        <view class="sub-metric"><text class="lbl">门店｜账本</text><text class="val">¥{{stats.offlineTotal}}</text><text class="split" wx:if="{{stats.offlineSplitText}}">{{stats.offlineSplitText}}</text></view>
     </view>
  </view>

  <!-- 经营信号（可折叠；展开态对齐截图分区 + 图例） -->
  <view class="ops-signal-board {{opsSignalExpanded ? 'is-open' : 'is-collapsed'}}" wx:if="{{menu.dashboardKpi}}">
    <view class="ops-signal-top" bindtap="toggleOpsSignalBoard" hover-class="ops-signal-press" hover-stay-time="80">
      <view class="ops-signal-title-row">
        <text class="ops-signal-title">经营信号</text>
        <view class="signal-light {{opsSignalSummary.worstLamp}}" wx:if="{{!opsSignalExpanded}}"></view>
      </view>
      <view class="ops-signal-top-actions">
        <text
          class="ops-legend-toggle"
          wx:if="{{opsSignalExpanded}}"
          catchtap="toggleOpsLegend"
        >{{opsLegendOpen ? '收起图例' : '图例'}}</text>
        <text class="ops-signal-fold">{{opsSignalExpanded ? '收起' : '展开'}}</text>
      </view>
    </view>

    <!-- 收起态：精简摘要 -->
    <view class="ops-signal-summary" wx:if="{{!opsSignalExpanded}}">
      <block wx:if="{{opsSignalSummary.attentionCount}}">
        <text class="ops-signal-summary-label">{{opsSignalSummary.label}}</text>
        <view class="ops-signal-summary-chips">
          <view
            class="ops-signal-summary-chip"
            wx:for="{{opsSignalSummary.chips}}"
            wx:key="id"
            catchtap="goOpsSignal"
            data-target="{{item.target}}"
            hover-class="ops-signal-press"
            hover-stay-time="80"
          >
            <view class="signal-light {{item.lamp}}"></view>
            <text class="ops-signal-summary-text">{{item.text}}</text>
          </view>
        </view>
      </block>
      <text class="ops-signal-summary-ok" wx:else>全部健康</text>
    </view>

    <!-- 展开态：完整分区 -->
    <block wx:if="{{opsSignalExpanded}}">
      <view class="ops-signal-group" wx:if="{{menu.orders}}">
        <text class="ops-signal-group-title">履约</text>
        <view class="ops-signal-grid">
          <view class="ops-signal-item ops-signal-tap" bindtap="goOpsSignal" data-target="pending" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.orders}}"></view>
            <text class="ops-signal-label">待发订单 · {{orders.length}}</text>
          </view>
          <view class="ops-signal-item ops-signal-tap" bindtap="goOpsSignal" data-target="shipped" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.shipped}}"></view>
            <text class="ops-signal-label">已发订单 · {{opsOrderCounts.shipped}}</text>
          </view>
          <view class="ops-signal-item ops-signal-tap" bindtap="goOpsSignal" data-target="received" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.received}}"></view>
            <text class="ops-signal-label">已签收 · {{opsOrderCounts.received}}</text>
          </view>
        </view>
      </view>

      <view class="ops-signal-group" wx:if="{{menu.orders || menu.support || menu.workOrders || menu.framerRecruit || menu.giftOps || menu.giftManage}}">
        <text class="ops-signal-group-title">风险与待办</text>
        <view class="ops-signal-grid">
          <view class="ops-signal-item ops-signal-tap" wx:if="{{menu.orders}}" bindtap="goOpsSignal" data-target="aftersale" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.aftersale}}"></view>
            <text class="ops-signal-label">售后 · {{opsOrderCounts.aftersale}}</text>
          </view>
          <view class="ops-signal-item ops-signal-tap" wx:if="{{menu.orders}}" bindtap="goOpsSignal" data-target="refunded" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.refunded}}"></view>
            <text class="ops-signal-label">退款订单数 · {{opsOrderCounts.refunded}}</text>
          </view>
          <view class="ops-signal-item ops-signal-tap" wx:if="{{menu.support}}" bindtap="goOpsSignal" data-target="support" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.support}}"></view>
            <text class="ops-signal-label">有信待回 · {{supportTickets.length}}</text>
          </view>
          <view class="ops-signal-item ops-signal-tap" wx:if="{{menu.workOrders}}" bindtap="goOpsSignal" data-target="workOrders" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.workOrders}}"></view>
            <text class="ops-signal-label">工单 · {{customOrders.length}}</text>
          </view>
          <view class="ops-signal-item ops-signal-tap" wx:if="{{menu.framerRecruit}}" bindtap="goOpsSignal" data-target="recruit" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.recruit}}"></view>
            <text class="ops-signal-label">合作申请 · {{framerRecruitApps.length}}</text>
          </view>
          <view class="ops-signal-item ops-signal-tap" wx:if="{{menu.giftOps || menu.giftManage}}" bindtap="goOpsSignal" data-target="gift" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.gift}}"></view>
            <text class="ops-signal-label">礼赠待办 · {{giftTodoCount}}</text>
          </view>
        </view>
      </view>

      <view class="ops-signal-group" wx:if="{{menu.dashboardKpi || menu.products}}">
        <text class="ops-signal-group-title">经营</text>
        <view class="ops-signal-grid">
          <view class="ops-signal-item ops-signal-tap" wx:if="{{menu.dashboardKpi}}" bindtap="goOpsSignal" data-target="mom" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.mom}}"></view>
            <text class="ops-signal-label ops-signal-label--{{stats.momClass}}">营收环比 · {{stats.momLabel}}</text>
          </view>
          <view class="ops-signal-item ops-signal-tap" wx:if="{{menu.products}}" bindtap="goOpsSignal" data-target="stock" hover-class="ops-signal-press" hover-stay-time="80">
            <view class="signal-light {{opsSignals.stock}}"></view>
            <text class="ops-signal-label">库存 · {{dashStock.ready ? (dashStock.empty ? '暂无' : '在架 ' + dashStock.onShelf) : (dashStock.error ? '失败' : '…')}}</text>
          </view>
        </view>
      </view>

      <view class="ops-signal-legend signal-legend" wx:if="{{opsLegendOpen}}">
        <view class="signal-legend-item"><view class="signal-light blink"></view><text class="signal-legend-text">绿 · 健康 / 清空</text></view>
        <view class="signal-legend-item"><view class="signal-light warn"></view><text class="signal-legend-text">黄 · 待办 / 关注</text></view>
        <view class="signal-legend-item"><view class="signal-light danger"></view><text class="signal-legend-text">红 · 异常 / 下降</text></view>
        <view class="signal-legend-item"><view class="signal-light lamp-muted"></view><text class="signal-legend-text">灰 · 持平 / 空闲</text></view>
        <view class="signal-legend-item"><view class="signal-light lamp-forest"></view><text class="signal-legend-text">深绿 · 已签收</text></view>
      </view>
    </block>
  </view>

  <!-- 瀑布流布局容器：默认 2 列；极窄 stackCols 时单列 -->
  <view class="dashboard-grid {{chartLayout.stackCols ? 'dash-grid--stack' : ''}}">
    
    <!-- 功能入口（2026-09-30 全局改版；2026-10-01 展示改版）：「全部功能」5 列便当式流排 —— 分区只占可见入口数那么多列，小分区并排；
         待办卡与我的常用在扫码主按钮上下（首屏）。分区与合并磁贴的权限口径见 hubNav.js，一致性由 check:hub-entries 守 -->
    <view class="grid-item full-width hub-nav">
      <view class="hub-cat" id="hub-cat">
        <view class="hub-cat-head">
          <view class="hub-titles">
            <text class="hub-en">ALL FUNCTIONS</text>
            <text class="hub-cn">全部功能</text>
          </view>
          <text class="hub-cat-count">{{hubCat.total}} 项</text>
        </view>
        <text class="hub-cat-hint {{hubPinTip ? 'is-tip' : ''}}">{{hubPinTip || '长按入口加入或移出常用 · 双圈图标点开有多项'}}</text>
        <view class="hub-anchors" wx:if="{{hubCat.anchors.length}}">
          <view
            class="hub-anchor"
            wx:for="{{hubCat.anchors}}"
            wx:key="id"
            bindtap="onHubAnchor"
            data-id="{{item.id}}"
            hover-class="tap-press"
            hover-stay-time="80"
          >
            <text>{{item.title}}</text>
            <text class="hub-anchor-n">{{item.count}}</text>
          </view>
        </view>

        <view class="hub-cat-grid">
          <view class="hub-sec span-{{hubSpan.orders}}" wx:if="{{hubSec.orders}}" id="hub-sec-orders">
            <view class="hub-sec-head"><text class="hub-sec-title">订单履约</text></view>
            <view class="hub-grid cols-{{hubSpan.orders}}">
              <view class="hub-tile" hover-class="tap-press" hover-stay-time="80" data-fid="orders" bindlongpress="onHubPin" wx:if="{{menu.orders}}" bindtap="onOrdersMenuTap" data-idx="2" data-title="订单管理">
                <view class="hub-ico">
                  <image class="hub-ico-img" src="/assets/icons/box.png" mode="aspectFit" />
                  <view class="hub-badge" wx:if="{{newOrderUnreadCount > 0}}">{{newOrderUnreadCount > 99 ? '99+' : newOrderUnreadCount}}</view>
                  <view class="hub-badge" wx:elif="{{orders.length > 0}}">{{orders.length > 99 ? '99+' : orders.length}}</view>
                </view>
                <text>订单</text>
                <view class="hub-pin" wx:if="{{hubPinned.orders}}"></view>
              </view>
              <view class="hub-tile" hover-class="tap-press" hover-stay-time="80" data-fid="workOrders" bindlongpress="onHubPin" wx:if="{{menu.workOrders}}" bindtap="switchTab" data-idx="10" data-title="工单">
                <view class="hub-ico">
                  <image class="hub-ico-img" src="/assets/icons/list.png" mode="aspectFit" />
                  <view class="hub-badge" wx:if="{{customOrders.length > 0}}">{{customOrders.length > 99 ? '99+' : customOrders.length}}</view>
                </view>
                <text>工单</text>
                <view class="hub-pin" wx:if="{{hubPinned.workOrders}}"></view>
              </view>
              <view class="hub-tile is-group" hover-class="tap-press" hover-stay-time="80" data-fid="gift" bindlongpress="onHubPin" wx:if="{{menu.giftOps || menu.giftManage}}" bindtap="openHubGroup" data-group="gift">
                <view class="hub-ico">
                  <image class="hub-ico-img" src="/assets/icons/gift.png" mode="aspectFit" />
                  <view class="hub-badge" wx:if="{{giftTodoCount > 0}}">{{giftTodoCount > 99 ? '99+' : giftTodoCount}}</view>
                </view>
                <text>礼赠</text>
                <view class="hub-pin" wx:if="{{hubPinned.gift}}"></view>
              </view>
              <view class="hub-tile" hover-class="tap-press" hover-stay-time="80" data-fid="invoice" bindlongpress="onHubPin" wx:if="{{menu.invoice}}" bindtap="goInvoiceRequests">
                <view class="hub-ico">
                  <image class="hub-ico-img" src="/assets/icons/refund.png" mode="aspectFit" />
                  <view class="hub-badge" wx:if="{{invoicePendingCount > 0}}">{{invoicePendingCount > 99 ? '99+' : invoicePendingCount}}</view>
                </view>
                <text>发票</text>
                <view class="hub-pin" wx:if="{{hubPinned.invoice}}"></view>
              </view>
              <view class="hub-tile" hover-class="tap-press" hover-stay-time="80" data-fid="approvals" bindlongpress="onHubPin" wx:if="{{menu.approvals}}" bindtap="goApprovals">
                <view class="hub-ico">
                  <image class="hub-ico-img" src="/assets/icons/done.png" mode="aspectFit" />
                  <view class="hub-badge" wx:if="{{approvalPendingCount > 0}}">{{approvalPendingCount > 99 ? '99+' : approvalPendingCount}}</view>
                </view>
                <text>审批</text>
                <view class="hub-pin" wx:if="{{hubPinned.approvals}}"></view>
              </view>
              <view class="hub-tile" hover-class="tap-press" hover-stay-time="80" data-fid="deposit" bindlongpress="onHubPin" wx:if="{{menu.depositOps}}" bindtap="goDepositOps">
                <view class="hub-ico"><image class="hub-ico-img" src="/assets/icons/discount.png" mode="aspectFit" /></view>
                <text>孤品定金</text>
                <view class="hub-pin" wx:if="{{hubPinned.deposit}}"></view>
              </view>
            </view>
          </view>

          <view class="hub-sec span-{{hubSpan.biz}}" wx:if="{{hubSec.biz}}" id="hub-sec-biz">
            <view class="hub-sec-head"><text class="hub-sec-title">经营数据</text></view>
            <view class="hub-grid cols-{{hubSpan.biz}}">
              <view class="hub-tile" hover-class="tap-press" hover-stay-time="80" data-fid="ledger" bindlongpress="onHubPin" wx:if="{{menu.ledger}}" bindtap="switchTab" data-idx="8" data-title="营收账本">
                <view class="hub-ico"><image class="hub-ico-img" src="/assets/icons/coin_gold.png" mode="aspectFit" /></view>
                <text>账本</text>
                <view class="hub-pin" wx:if="{{hubPinned.ledger}}"></view>
              </view>
