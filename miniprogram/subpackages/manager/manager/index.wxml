          <view class="donut" style="{{stats.donutStyle}}"></view>
          <view class="legend">
             <view class="legend-row"><view class="dot gold"></view><text>小程序 {{stats.onlineRatio}}%</text></view>
             <view class="legend-row"><view class="dot forest"></view><text>线下 {{stats.offlineRatio}}%</text></view>
          </view>
       </view>
       <view class="chart-empty" wx:else>
          <text>暂无本月营收</text>
          <text class="chart-empty-hint">账本或订单入账后显示占比</text>
       </view>
    </view>

    <view class="grid-item" wx:if="{{menu.dashboardKpi}}">
