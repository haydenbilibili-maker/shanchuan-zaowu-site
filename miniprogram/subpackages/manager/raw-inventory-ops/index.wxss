@import '../utils/ops-museum.wxss';

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.empty-tip.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  margin: 16rpx 0;
}
.empty-title { display: block; font-size: 28rpx; color: #f0c9c0; margin-bottom: 8rpx; }
.empty-sub { display: block; font-size: 22rpx; color: rgba(232, 220, 192, 0.72); line-height: 1.5; }
.btn-retry {
  display: inline-block; margin-top: 24rpx; padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5); border-radius: 999rpx;
  font-size: 24rpx; color: #e8dcc0;
}
