<!-- 客服工作台（2026-11-27 质感升级）：品牌头 + 状态签 + 搜索 + 卡片列表 + 底部弹层详情 -->
<view class="sd-page">
  <view class="sd-head">
    <text class="sd-eyebrow">SUPPORT DESK</text>
    <view class="sd-title-row">
      <text class="sd-title">客服工作台</text>
      <view class="sd-lamp {{rows.length ? 'is-on' : ''}}"></view>
    </view>
    <text class="sd-sub">顾客留言、历史往来与回复 · 回复会发到对方的「山海有信」</text>
  </view>

  <view class="sd-toolbar">
    <view class="sd-tabs">
      <view class="sd-tab {{tab === 'pending' ? 'on' : ''}}" data-tab="pending" bindtap="switchTab" hover-class="tap-press" hover-stay-time="80">待回复</view>
      <view class="sd-tab {{tab === 'replied' ? 'on' : ''}}" data-tab="replied" bindtap="switchTab" hover-class="tap-press" hover-stay-time="80">已回复</view>
      <view class="sd-tab {{tab === 'all' ? 'on' : ''}}" data-tab="all" bindtap="switchTab" hover-class="tap-press" hover-stay-time="80">全部</view>
    </view>
    <view class="sd-search">
      <image class="sd-search-ico" src="/assets/icons/search.png" mode="aspectFit" />
      <input class="sd-search-input" value="{{query}}" bindinput="onSearch" placeholder="搜类型 / 内容 / 订单号 / 会员" placeholder-class="sd-ph" confirm-type="search" />
    </view>
  </view>

  <view class="sd-tip" wx:if="{{hint}}">{{hint}}</view>

  <view class="sd-list" wx:if="{{rows.length}}">
    <view class="sd-row {{openId === item.id ? 'is-open' : ''}}" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onRowTap" hover-class="sd-row-press" hover-stay-time="80">
      <view class="sd-row-top">
        <text class="sd-topic">{{item.topicLabel}}</text>
        <text class="sd-status {{item.status === 'replied' ? 'is-done' : (item.status === 'resolved' ? 'is-ok' : 'is-wait')}}">{{item.statusText}}{{item.replyCount ? ' · ' + item.replyCount + ' 次' : ''}}</text>
      </view>
      <text class="sd-msg">{{item.message || '（没有正文）'}}</text>
      <view class="sd-row-foot">
        <text class="sd-meta">{{item.time}}{{item.orderNo ? ' · 订单 ' + item.orderNo : ''}}</text>
        <text class="sd-who" wx:if="{{item.customer}}">{{item.customer}}{{item.customerCount > 1 ? ' · 第 ' + item.customerCount + ' 次' : ''}}</text>
      </view>
    </view>
  </view>

  <view class="sd-skel" wx:if="{{loading && !rows.length}}">
    <view class="sd-skel-row" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sd-skel-l"></view>
      <view class="sd-skel-l short"></view>
    </view>
  </view>
  <view class="sd-empty" wx:if="{{!loading && !rows.length}}">
    <image class="sd-empty-ico" src="/assets/icons/message.png" mode="aspectFit" />
    <text class="sd-empty-t">{{tab === 'pending' ? '待回复的留言都清完了' : '还没有留言'}}</text>
    <text class="sd-empty-s">{{tab === 'pending' ? '顾客新留言会进「工作信息」，也会通知到你' : '顾客在「联系专员」留言后会出现在这里'}}</text>
  </view>

  <!-- 详情：底部弹层（与其它页统一） -->
  <view class="ui-pop-mask" wx:if="{{detail}}" catchtap="closeDetail" catchtouchmove="true">
    <view class="ui-pop-sheet sd-sheet" catchtap="true">
      <view class="sd-sheet-head">
        <view class="sd-sheet-t">
          <text class="sd-sheet-k">{{detail.topicLabel}}</text>
          <text class="sd-sheet-time">{{detail.time}}</text>
        </view>
        <view class="sd-sheet-close" hover-class="tap-press" hover-stay-time="80" catchtap="closeDetail">✕</view>
      </view>

      <scroll-view scroll-y class="sd-sheet-body">
        <view class="sd-quote">
          <text class="sd-quote-msg" user-select>{{detail.message || '（顾客没有写正文）'}}</text>
          <view class="sd-quote-imgs" wx:if="{{detail.images.length}}">
            <image class="sd-quote-img" wx:for="{{detail.images}}" wx:for-item="url" wx:key="*this" src="{{url}}" mode="aspectFill" data-url="{{url}}" bindtap="previewImage" binderror="onImageError" />
          </view>
          <text class="sd-quote-meta">{{detail.orderNo ? '订单 ' + detail.orderNo + ' · ' : ''}}{{detail.productName ? detail.productName + ' · ' : ''}}{{detail.contactPhone ? detail.contactPhone : ''}}</text>
        </view>

        <view class="sd-block" wx:if="{{customer}}">
          <text class="sd-block-t">这位顾客</text>
          <view class="sd-facts">
            <view class="sd-fact"><text class="sd-fact-n">{{customer.orderCount}}</text><text class="sd-fact-l">单</text></view>
            <view class="sd-fact"><text class="sd-fact-n">{{customer.commentCount}}</text><text class="sd-fact-l">评价</text></view>
            <view class="sd-fact"><text class="sd-fact-n">{{customer.ticketCount}}</text><text class="sd-fact-l">留言</text></view>
          </view>
          <view class="sd-order" wx:for="{{customer.orders}}" wx:key="id" data-id="{{item.id}}" catchtap="openOrderDetail" hover-class="tap-press-soft" hover-stay-time="80">
            <text class="sd-order-t">{{item.title}}</text>
            <text class="sd-order-s">¥{{item.amount}} · {{item.status}}</text>
            <text class="sd-order-go">›</text>
          </view>
        </view>

        <view class="sd-block">
          <text class="sd-block-t">历史回复</text>
          <view class="sd-history" wx:if="{{detail.history.length}}">
            <view class="sd-history-item" wx:for="{{detail.history}}" wx:key="time">
              <text class="sd-history-time">{{item.time}}</text>
              <text class="sd-history-body" user-select>{{item.content}}</text>
            </view>
          </view>
          <text class="sd-hint-line" wx:else>还没有回复过，下面写第一条</text>
        </view>

        <view class="sd-block">
          <text class="sd-block-t">内部备注 <text class="sd-block-s">（顾客看不到）</text></text>
          <view class="sd-note" wx:for="{{notes}}" wx:key="time">
            <text class="sd-note-time">{{item.time}}</text>
            <text class="sd-note-text" user-select>{{item.text}}</text>
          </view>
          <view class="sd-note-row">
            <input class="sd-note-input" value="{{noteText}}" bindinput="onNoteInput" maxlength="300" placeholder="记一笔：已电话联系 / 等顾客补图" placeholder-class="sd-ph" />
            <view class="sd-note-save" catchtap="addNote" hover-class="tap-press" hover-stay-time="80">保存</view>
          </view>
        </view>

        <view class="sd-block">
          <text class="sd-block-t">回复</text>
          <view class="sd-phrases">
            <view class="sd-phrase" wx:for="{{phrases}}" wx:key="*this" data-text="{{item}}" catchtap="pickPhrase" hover-class="tap-press-soft" hover-stay-time="80">{{item}}</view>
          </view>
          <textarea class="sd-input" fixed="{{true}}" cursor-spacing="120" value="{{replyText}}" bindinput="onReplyInput" maxlength="500" placeholder="写回复，发送后顾客会在「山海有信」收到" placeholder-class="sd-ph"></textarea>
          <text class="sd-count">{{replyText.length}}/500</text>
        </view>
      </scroll-view>

      <view class="sd-sheet-foot">
        <view class="sd-resolve" catchtap="markResolved" hover-class="tap-press" hover-stay-time="80">标记已解决</view>
        <view class="sd-send {{sending ? 'is-off' : ''}}" catchtap="sendReply" hover-class="tap-press" hover-stay-time="80">{{sending ? '发送中…' : '发送回复'}}</view>
      </view>
    </view>
  </view>
</view>
