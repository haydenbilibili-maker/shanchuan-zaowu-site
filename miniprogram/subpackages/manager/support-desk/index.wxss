/* 客服工作台（2026-11-27 质感升级）：品牌头 / 状态签 / 卡片列表 / 底部弹层 */
.sd-page { min-height: 100vh; background: #1A1814; padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sd-head { padding: 4rpx 4rpx 18rpx; display: flex; flex-direction: column; gap: 6rpx; }
.sd-eyebrow { font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .26em; color: var(--brass-300); }
.sd-title-row { display: flex; align-items: center; gap: 14rpx; }
.sd-title { font-family: var(--font-brand); font-size: var(--fs-40); color: var(--mat-paper-tone); letter-spacing: .04em; }
.sd-lamp { width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(196, 167, 108, 0.35); }
.sd-lamp.is-on { background: var(--color-success, #52B788); box-shadow: 0 0 8rpx rgba(82, 183, 136, 0.45); }
.sd-sub { font-size: var(--fs-20); line-height: 1.5; color: var(--mat-ink-soft); }

.sd-toolbar { display: flex; flex-direction: column; gap: 12rpx; padding-bottom: 16rpx; }
.sd-tabs { display: flex; gap: 10rpx; padding: 0 2rpx; }
.sd-tab { padding: 8rpx 22rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-22); color: var(--mat-ink-soft); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.2); }
.sd-tab.on { color: var(--mat-ink); background: var(--mat-brass); box-shadow: none; font-weight: 600; }
.sd-search { display: flex; align-items: center; gap: 10rpx; height: 72rpx; padding: 0 20rpx; border-radius: var(--r-pill, 999rpx); background: rgba(0, 0, 0, 0.22); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.16); }
.sd-search-ico { width: 26rpx; height: 26rpx; opacity: 0.7; filter: brightness(0) saturate(100%) invert(78%) sepia(18%) saturate(500%) hue-rotate(2deg); }
.sd-search-input { flex: 1; min-width: 0; font-size: var(--fs-22); color: var(--mat-paper-tone); }
.sd-ph { color: rgba(160, 154, 144, 0.8); }
.sd-tip { margin: 0 2rpx 12rpx; padding: 12rpx 16rpx; border-radius: var(--radius-sm, 8rpx); font-size: var(--fs-20); color: var(--brass-200); background: rgba(196, 167, 108, 0.08); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.24); }

.sd-list { display: flex; flex-direction: column; gap: 14rpx; }
.sd-row { padding: 22rpx 22rpx 18rpx; border-radius: var(--radius-md); background: rgba(196, 167, 108, 0.04); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.18); }
.sd-row-press { opacity: 0.9; transform: scale(0.995); }
.sd-row.is-open { box-shadow: inset 0 0 0 2rpx rgba(196, 167, 108, 0.5); }
.sd-row-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.sd-topic { font-size: var(--fs-20); color: var(--brass-200); padding: 2rpx 12rpx; border-radius: var(--r-thumb-sm, 4rpx); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3); }
.sd-status { font-size: var(--fs-18); }
.sd-status.is-wait { color: var(--color-warning, #E9A23B); }
.sd-status.is-done { color: var(--mat-ink-soft); }
.sd-status.is-ok { color: var(--color-success, #52B788); }
.sd-msg { display: block; margin-top: 12rpx; font-family: var(--font-brand); font-size: var(--fs-26); line-height: 1.5; color: var(--mat-paper-tone); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sd-row-foot { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; }
.sd-meta { font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-who { font-size: var(--fs-18); color: var(--brass-200); }

.sd-skel { display: flex; flex-direction: column; gap: 14rpx; }
.sd-skel-row { padding: 22rpx; border-radius: var(--radius-md); background: rgba(196, 167, 108, 0.04); }
.sd-skel-l { height: 26rpx; width: 70%; border-radius: 6rpx; background: linear-gradient(90deg, rgba(196, 167, 108, 0.06), rgba(196, 167, 108, 0.16), rgba(196, 167, 108, 0.06)); background-size: 200% 100%; animation: sd-shine 1.4s ease infinite; }
.sd-skel-l + .sd-skel-l { margin-top: 12rpx; }
.sd-skel-l.short { width: 40%; }
@keyframes sd-shine { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.sd-empty { padding: 90rpx 40rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; text-align: center; }
.sd-empty-ico { width: 72rpx; height: 72rpx; opacity: 0.55; filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%); }
.sd-empty-t { font-family: var(--font-brand); font-size: var(--fs-28); color: var(--mat-paper-tone); }
.sd-empty-s { font-size: var(--fs-20); line-height: 1.5; color: var(--mat-ink-soft); }

/* 底部弹层 */
.sd-sheet {
  /* 2026-11-27 修复「底部一坨」：只给 max-height 时 flex 子项没有确定高度，
     正文会把底部操作条顶到中间、互相压住 → 给弹层定高，正文 height:0 吃剩余空间 */
  display: flex;
  flex-direction: column;
  height: 86vh;
  max-height: 86vh;
  overflow: hidden;
}
.sd-sheet-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 24rpx 28rpx 14rpx; }
.sd-sheet-t { display: flex; flex-direction: column; gap: 2rpx; min-width: 0; }
.sd-sheet-k { font-family: var(--font-brand); font-size: var(--fs-30); color: var(--mat-paper-tone); }
.sd-sheet-time { font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-sheet-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--mat-ink-soft); font-size: var(--fs-28); }
.sd-sheet-body { flex: 1 1 0; height: 0; min-height: 0; padding: 0 28rpx 12rpx; box-sizing: border-box; }
.sd-quote { padding: 20rpx; border-radius: var(--radius-md); background: rgba(196, 167, 108, 0.09); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.26); }
.sd-quote-msg { font-size: var(--fs-26); line-height: 1.6; color: var(--mat-paper-tone); white-space: pre-wrap; }
.sd-quote-imgs { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.sd-quote-img { width: 140rpx; height: 140rpx; border-radius: var(--r-thumb-sm, 8rpx); }
.sd-quote-meta { display: block; margin-top: 10rpx; font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-block { margin-top: 22rpx; }
.sd-block-t { font-family: var(--font-brand); font-size: var(--fs-24); color: var(--mat-paper-tone); }
.sd-block-s { font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-facts { display: flex; gap: 12rpx; margin-top: 12rpx; }
.sd-fact { flex: 1; display: flex; align-items: baseline; justify-content: center; gap: 4rpx; padding: 12rpx 0; border-radius: var(--radius-sm, 8rpx); background: rgba(0, 0, 0, 0.18); }
.sd-fact-n { font-family: var(--font-mono); font-size: var(--fs-28); color: var(--brass-200); }
.sd-fact-l { font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-order { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; border-bottom: 1rpx solid rgba(196, 167, 108, 0.1); }
.sd-order-t { flex: 1; min-width: 0; font-size: var(--fs-22); color: var(--mat-paper-tone); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sd-order-s { font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-order-go { color: var(--brass-300); }
.sd-history { margin-top: 10rpx; }
.sd-history-item { padding: 12rpx 0; border-top: 1rpx solid rgba(196, 167, 108, 0.1); display: flex; flex-direction: column; gap: 4rpx; }
.sd-history-time { font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-history-body { font-size: var(--fs-22); line-height: 1.6; color: var(--mat-paper-tone); white-space: pre-wrap; }
.sd-hint-line { display: block; margin-top: 8rpx; font-size: var(--fs-20); color: var(--mat-ink-soft); }
.sd-note { margin-top: 8rpx; display: flex; flex-direction: column; gap: 2rpx; }
.sd-note-time { font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-note-text { font-size: var(--fs-22); line-height: 1.5; color: var(--mat-paper-tone); }
.sd-note-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.sd-note-input { flex: 1; height: 68rpx; padding: 0 18rpx; border-radius: var(--r-pill, 999rpx); background: rgba(0, 0, 0, 0.22); font-size: var(--fs-20); color: var(--mat-paper-tone); box-sizing: border-box; }
.sd-note-save { flex-shrink: 0; padding: 12rpx 22rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-20); color: var(--mat-ink); background: var(--mat-brass); }
.sd-phrases { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.sd-phrase { padding: 8rpx 18rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-20); color: var(--brass-200); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.26); }
.sd-input { width: 100%; margin-top: 12rpx; min-height: 160rpx; padding: 16rpx; box-sizing: border-box; border-radius: var(--r-control, 12rpx); background: rgba(0, 0, 0, 0.22); font-size: var(--fs-22); line-height: 1.5; color: var(--mat-paper-tone); }
.sd-count { display: block; margin-top: 6rpx; text-align: right; font-size: var(--fs-18); color: var(--mat-ink-soft); }
.sd-sheet-foot {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(196, 167, 108, 0.16);
  background: var(--pop-surface, #232019);
}
.sd-resolve { flex-shrink: 0; padding: 0 22rpx; height: 76rpx; line-height: 76rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-22); color: var(--brass-200); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3); }
.sd-send { flex: 1; height: 76rpx; line-height: 76rpx; text-align: center; border-radius: var(--r-pill, 999rpx); background: var(--mat-brass); color: var(--mat-ink); font-size: var(--fs-24); font-weight: 600; }
.sd-send.is-off { opacity: 0.6; }

@media (prefers-reduced-motion: reduce) {
  .sd-skel-l { animation: none; }
}
