<view class="page-boot" wx:if="{{!ready}}">
  <text class="boot-en">REVIEW</text>
  <text class="boot-cn">报销审批</text>
  <text class="boot-hint">校验权限中…</text>
</view>

<view class="container" wx:elif="{{ready}}">
  <view class="section">
    <text class="section-note">店员提交的报销由店长处理；超管亦可审批。</text>
    <text class="last-feedback" wx:if="{{lastReview}}">{{lastReview}}</text>
  </view>

  <view class="section" wx:if="{{list.length}}">
    <view class="card" wx:for="{{list}}" wx:key="_id">
      <view class="card-head">
        <text class="name">{{item.staffName || '店员'}}</text>
        <text class="amount">¥{{item.amountDisplay}}</text>
      </view>
      <text class="meta">{{item.category}} · {{item.createTimeText}}</text>
      <text class="remark" wx:if="{{item.remark}}">{{item.remark}}</text>
      <view class="actions">
        <view class="btn reject {{reviewingId ? 'disabled' : ''}}" data-id="{{item._id}}" bindtap="review" data-decision="rejected">驳回</view>
        <view class="btn approve {{reviewingId ? 'disabled' : ''}}" data-id="{{item._id}}" bindtap="review" data-decision="approved">通过</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text>{{loading ? '加载中…' : '暂无待审批报销'}}</text>
    <text class="section-note" wx:if="{{!loading}}">新申请提交后会出现在这里；处理完成后本页会自动刷新</text>
  </view>
</view>
