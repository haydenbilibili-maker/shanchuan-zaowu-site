<view class="container" wx:if="{{ready}}">
  <view class="header">
    <view class="brand-group">
      <text class="en">GIFT FULFILLMENT</text>
      <text class="cn">礼赠履约</text>
    </view>
    <text class="header-note">待填址不可发货 · 自提请扫妥投码</text>
  </view>

  <view class="toolbar">
    <view class="count-row">
      <view
        class="count-chip {{bucket === item.key ? 'on' : ''}} {{(item.key !== 'done' && counts[item.key] > 0) ? 'has' : ''}}"
        wx:for="{{buckets}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="switchBucket"
        hover-class="chip-press"
        hover-stay-time="70"
      >
        <text class="count-val">{{counts[item.key] || 0}}</text>
        <text class="count-lbl">{{item.label}}</text>
      </view>
    </view>

    <view class="search-bar">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜单号 / 藏品 / 收件人"
        placeholder-class="search-ph"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onKeywordConfirm"
      />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">清除</view>
    </view>
    <text class="sample-note" wx:if="{{note}}">{{note}}</text>
    <text class="filter-note" wx:if="{{keyword && !loading}}">本栏匹配 {{displayList.length}} / {{list.length}} 笔</text>
  </view>

  <view class="state-block" wx:if="{{loading && !list.length}}">
    <text class="muted">正在翻柜…</text>
  </view>

  <view class="state-block" wx:elif="{{loadError && !list.length}}">
    <text class="state-title">未能载入</text>
    <text class="muted">{{loadError}}</text>
    <view class="btn-secondary" bindtap="retryLoad">再试一次</view>
  </view>

  <view class="state-block" wx:elif="{{!loading && !list.length}}">
    <text class="state-title">{{emptyTitle}}</text>
    <text class="muted">{{emptyHint}}</text>
    <view class="btn-secondary" wx:if="{{bucket === 'pickup_verify'}}" bindtap="goVerify">去核销台</view>
  </view>

  <view class="state-block" wx:elif="{{!loading && list.length && !displayList.length}}">
    <text class="state-title">没有匹配单</text>
    <text class="muted">试试换关键词，或清除筛选</text>
    <view class="btn-secondary" bindtap="clearKeyword">清除筛选</view>
  </view>

  <view class="list" wx:else>
    <view
      class="card {{expandedId === item.orderId ? 'open' : ''}} {{item.urgencyClass}}"
      wx:for="{{displayList}}"
      wx:key="orderId"
      data-id="{{item.orderId}}"
      bindtap="toggleExpand"
      hover-class="card-press"
      hover-stay-time="70"
    >
      <view class="card-top">
        <view class="card-titles">
          <view class="badge-row">
            <text class="badge {{item.deliveryTone}}">{{item.deliveryLabel}}</text>
            <text class="badge urgency" wx:if="{{item.urgencyLabel}}">{{item.urgencyLabel}}</text>
          </view>
          <text class="card-title">{{item.productTitle}}</text>
          <text class="card-sub" wx:if="{{item.recipientName}}">写给 · {{item.recipientName}}</text>
          <text class="card-sub" wx:elif="{{item.storeName}}">门店 · {{item.storeName}}</text>
        </view>
        <view class="card-side">
          <text class="card-price" wx:if="{{item.totalPrice}}">¥{{item.totalPrice}}</text>
          <text class="expand-hint">{{expandedId === item.orderId ? '收起' : '详情'}}</text>
        </view>
      </view>

      <view class="card-meta">
        <text class="meta">{{item.orderNo || item.orderId}}</text>
        <text class="meta" wx:if="{{item.paidText}}">付 {{item.paidText}}</text>
        <text class="meta warn" wx:if="{{item.expireText && bucket === 'awaiting_address'}}">止 {{item.expireText}}</text>
      </view>

      <!-- 高频操作：无需展开即可点 -->
      <view class="card-actions" wx:if="{{item.canShip || bucket === 'pickup_verify' || item.shipBlockReason}}">
        <text class="block-reason" wx:if="{{item.shipBlockReason && !item.canShip && bucket !== 'pickup_verify'}}">{{item.shipBlockReason}}</text>
        <!-- 2026-09-20 产品负责人：「优化这个位置的 button 排版，使其在一排」。
             原因：两个导出按钮各带一行副标题（A6 尺寸 / 贴纸尺寸）→ 高度与宽度都不一样，
             `.action-row` 的 flex-wrap 就把第 4 个按钮挤到第二行。
             改法：按钮**只留动作、等宽平分一排**；规格说明收到下面**一行共用的 action-hint**。
             ⚠️ 副标题里的贴纸尺寸同时是**错的**（写的还是旧的 90×110mm，
             产品负责人 2026-09-20 已裁定白区为 75×75mm 1:1）—— 一并更正。 -->
        <view class="action-row">
          <view class="mini-btn primary" wx:if="{{item.canShip}}" data-id="{{item.orderId}}" catchtap="goOrderManage">去发货</view>
          <view class="mini-btn primary" wx:if="{{bucket === 'pickup_verify'}}" catchtap="goVerify">去核销</view>
          <view class="mini-btn" data-no="{{item.orderNo}}" catchtap="copyOrderNo">复制单号</view>
          <!-- 印刷用：导出 A6@300dpi 礼笺卡（含题记带）→ **先生成到预览**，看过再决定存/传 -->
          <view class="mini-btn {{exporting ? 'is-off' : ''}}" data-id="{{item.orderId}}" catchtap="onExportGiftCard">
            <text>导出礼笺图</text>
          </view>
          <!-- 印刷用：导出热敏不干胶贴纸版（75×75mm 白区，1:1 近方形版式；复用同一画布与导出实现） -->
          <view class="mini-btn {{exporting ? 'is-off' : ''}}" data-id="{{item.orderId}}" catchtap="onExportGiftSticker">
            <text>导出贴纸图</text>
          </view>
        </view>
        <text class="action-hint">礼笺 A6 105×148mm ／ 贴纸 75×75mm · 先预览再保存</text>
      </view>

      <view class="card-extra" wx:if="{{expandedId === item.orderId}}">
        <text class="extra-line" wx:if="{{item.recipientName}}">写给 · {{item.recipientName}}</text>
        <text class="extra-line" wx:if="{{item.storeName}}">门店 · {{item.storeName}}</text>
        <text class="extra-line" wx:if="{{item.claimCode}}">妥投码 · {{item.claimCode}}</text>
        <block wx:if="{{item.address}}">
          <text class="extra-line">{{item.address.name}} {{item.address.phone}}</text>
          <text class="extra-line">{{item.address.line}}</text>
        </block>
        <text class="extra-line muted" wx:if="{{!item.address && bucket === 'awaiting_address'}}">对方尚未留下地址</text>
        <text class="extra-line warn" wx:if="{{item.shipBlockReason}}">{{item.shipBlockReason}}</text>
        <view class="extra-actions" wx:if="{{!item.canShip && bucket !== 'pickup_verify'}}">
          <view class="mini-btn" data-no="{{item.orderNo}}" catchtap="copyOrderNo">复制单号</view>
        </view>
      </view>
    </view>

    <view class="list-foot" wx:if="{{loading}}">
      <text class="muted">加载中…</text>
    </view>
    <view class="list-foot" wx:elif="{{!hasMore && !keyword}}">
      <text class="muted">共 {{total}} 笔</text>
    </view>
  </view>

  <view class="foot-spacer"></view>
  <view class="foot-bar">
    <view class="workbench-btn-outline foot-btn" bindtap="retryLoad">{{loading ? '刷新中…' : '刷新'}}</view>
    <view class="workbench-btn-outline foot-btn" wx:if="{{bucket === 'pickup_verify'}}" bindtap="goVerify">核销台</view>
  </view>
</view>

<view class="container checking" wx:else>
  <view class="state-block" wx:if="{{loadError}}">
    <text class="state-title">无法进入</text>
    <text class="muted">{{loadError}}</text>
  </view>
  <text class="muted" wx:else>校验权限…</text>
</view>


<!-- 印刷版礼笺卡离屏画布（A6/贴纸两种规格，像素缓冲由 JS 按 PRINT_SPECS 设定） -->
<canvas type="2d" id="giftPrintCanvas" class="print-canvas"></canvas>

<!-- 导出预览层：生成后**先看再动**（印刷类导出最大的风险是印错；原实现一点即存相册并上传） -->
<view class="pp-mask" wx:if="{{printPreview}}" catchtouchmove="noop">
  <view class="pp-panel">
    <view class="pp-head">
      <view class="pp-head-titles">
        <text class="pp-overline">GIFT PRINT · 预览</text>
        <text class="pp-title">{{printPreview.spec === 'sticker' ? '热敏贴纸版' : 'A6 礼笺版'}}</text>
        <text class="pp-spec">{{printPreview.specLabel}}</text>
        <text class="pp-note">{{printPreview.specNote}}</text>
      </view>
      <view class="pp-close" catchtap="closePrintPreview">✕</view>
    </view>

    <scroll-view scroll-y class="pp-body">
      <image class="pp-img" src="{{printPreview.path}}" mode="widthFix" show-menu-by-longpress="{{true}}"></image>
    </scroll-view>

    <view class="pp-file">
      <text class="pp-file-label">文件名（长按复制，云存储里按它找）</text>
      <text class="pp-file-name" data-name="{{printPreview.fileName}}" bindlongpress="copyPrintFileName">{{printPreview.fileName}}</text>
    </view>

    <view class="pp-actions">
      <view class="pp-act {{printPreview.saving ? 'is-busy' : ''}} {{printPreview.saved ? 'is-done' : ''}}"
            catchtap="savePrintToAlbum">{{printPreview.saving ? '保存中…' : (printPreview.saved ? '已存相册 ✓' : '保存到相册')}}</view>
      <view class="pp-act primary {{printPreview.uploading ? 'is-busy' : ''}} {{printPreview.uploaded ? 'is-done' : ''}}"
            catchtap="uploadPrintFile">{{printPreview.uploading ? '上传中…' : (printPreview.uploaded ? '已上传 ✓' : '上传印刷文件')}}</view>
    </view>
    <text class="pp-hint" wx:if="{{printPreview.uploaded}}">失败可单独重试；相册里始终留有原图</text>
    <text class="pp-hint" wx:elif="{{printPreview.saved}}">相册已存；上传用于让专员在云端取件打印</text>
    <text class="pp-hint" wx:else>建议先核对受礼人姓名与正文，再保存/上传</text>
  </view>
</view>

<!-- 最近导出（可追溯：规格 + 文件名，长按复制） -->
<view class="rp-block" wx:if="{{recentPrints.length}}">
  <text class="rp-title">最近导出</text>
  <view class="rp-row" wx:for="{{recentPrints}}" wx:key="fileName" data-name="{{item.fileName}}" bindlongpress="copyPrintFileName">
    <text class="rp-spec">{{item.spec === 'sticker' ? '贴纸' : 'A6'}}</text>
    <text class="rp-name">{{item.fileName}}</text>
  </view>
</view>

<!-- 页内轻提示（AppToast：非阻塞、与主视觉一致） -->
<app-toast
  show="{{toastShow}}"
  overline="{{toastOverline}}"
  title="{{toastTitle}}"
  desc="{{toastDesc}}"
  bind:close="onToastClose"
/>

<!-- 样式化弹窗宿主（相册权限被拒时给「去设置」出口，替代裸 wx.showModal） -->
<app-modal id="appModal" />