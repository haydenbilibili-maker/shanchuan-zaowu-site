@import '../utils/workbench-nav.wxss';

/* 礼赠履约看板 — Museum Mode */
page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.container {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.checking {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 40vh;
}

.header {
  padding: var(--space-5) 0 var(--space-2);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.brand-group .cn {
  font-family: var(--font-brand);
  font-size: 44rpx;
  color: var(--color-text-primary);
  margin-top: 6rpx;
  line-height: 1.2;
}

.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.toolbar {
  margin-bottom: var(--space-3);
}

.count-row {
  display: flex;
  gap: 12rpx;
}

.count-chip {
  flex: 1;
  min-width: 0;
  padding: var(--space-2) 6rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.count-chip.has .count-val {
  color: var(--brass-400);
}

.count-chip.on {
  border-color: var(--brass-400);
  background: var(--color-bg-elevated);
}

.count-chip.on .count-val {
  color: var(--brass-400);
}

.count-chip.on .count-lbl {
  color: var(--color-text-primary);
}

.chip-press {
  opacity: 0.88;
}

.count-val {
  font-family: var(--font-mono);
  font-size: 32rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  line-height: 1.1;
}

.count-lbl {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.02em;
}

.search-bar {
  margin-top: var(--space-3);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 4rpx 8rpx 4rpx 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.search-ph {
  color: var(--color-text-muted);
}

.search-clear {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: var(--brass-400);
}

.sample-note,
.filter-note {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-top: var(--space-2);
  line-height: 1.4;
}

.state-block {
  margin-top: var(--space-5);
  padding: var(--space-5);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  text-align: center;
}

.state-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.muted {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.btn-secondary {
  margin-top: var(--space-2);
  padding: 16rpx 32rpx;
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-md);
  color: var(--brass-400);
  font-size: 26rpx;
}

.card {
  margin-bottom: var(--space-3);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.card.open {
  border-color: var(--brass-800);
}

.card.soon {
  border-color: rgba(233, 162, 59, 0.35);
}

.card.urgent {
  border-color: rgba(233, 162, 59, 0.55);
  background: linear-gradient(180deg, rgba(233, 162, 59, 0.08) 0%, var(--color-bg-card) 40%);
}

.card-press {
  opacity: 0.94;
}

.card-top {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
}

.card-titles {
  flex: 1;
  min-width: 0;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.badge {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  letter-spacing: 0.02em;
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
}

.badge.tone-invite {
  color: var(--color-warning);
  border-color: rgba(233, 162, 59, 0.35);
  background: rgba(233, 162, 59, 0.08);
}

.badge.tone-ship,
.badge.tone-self {
  color: var(--brass-400);
  border-color: var(--brass-800);
  background: rgba(196, 167, 108, 0.08);
}

.badge.tone-pickup {
  color: var(--color-success);
  border-color: rgba(82, 183, 136, 0.35);
  background: rgba(82, 183, 136, 0.08);
}

.badge.urgency {
  color: var(--color-warning);
  border-color: rgba(233, 162, 59, 0.4);
}

.card-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.35;
}

.card-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.card-price {
  font-family: var(--font-mono);
  font-size: 26rpx;
  color: var(--brass-400);
}

.expand-hint {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: var(--space-2);
}

.meta {
  font-size: 20rpx;
  color: var(--color-text-muted);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta.warn {
  color: var(--color-warning);
}

.card-actions {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border);
}

.block-reason {
  display: block;
  margin-bottom: var(--space-2);
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.4;
}

.action-row,
.extra-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.card-extra {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.extra-line {
  font-size: 24rpx;
  color: var(--color-text-body);
  line-height: 1.45;
  word-break: break-all;
}

.extra-line.warn {
  color: var(--color-warning);
}

.extra-line.muted {
  color: var(--color-text-muted);
}

.mini-btn {
  padding: 12rpx 22rpx;
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  color: var(--brass-400);
}

.mini-btn.primary {
  background: var(--brass-400);
  color: var(--color-bg);
  border-color: var(--brass-400);
  font-weight: 500;
}

.list-foot {
  padding: var(--space-4) 0;
  text-align: center;
}

.foot-spacer {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.foot-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.foot-btn {
  flex: 1;
}

/* 印刷版礼笺卡：离屏但**必须参与布局**（canvas 2d 取 node 要求已渲染，display:none 取不到）；
   像素缓冲由 JS 设为 A6@300dpi，元素尺寸与此无关。 */
.print-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 200rpx;
  height: 290rpx;
  pointer-events: none;
}

/* ==================== 导出预览层（2026-09-19 交互升级） ==================== */
/* 为什么加：印刷类导出的最大风险是"印错"（受礼人姓名/正文/规格），
   而原实现点一下就直接存相册并上传——没有回看机会。现在生成后先进这里。 */

.pp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(10, 9, 8, 0.78);
}

.pp-panel {
  width: 100%;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding: var(--space-4);
  padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--brass-500);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.pp-head {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}

.pp-head-titles {
  flex: 1;
  min-width: 0;
}

.pp-overline {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.16em;
  color: var(--brass-500);
}

.pp-title {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
}

.pp-spec {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brass-300);
}

.pp-note {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.pp-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  border-radius: 50%;
}

.pp-body {
  flex: 1;
  min-height: 0;
  margin: var(--space-3) 0;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg);
}

.pp-img {
  width: 100%;
  display: block;
}

.pp-file {
  padding: 12rpx 0;
  border-top: 1rpx dashed var(--color-border);
}

.pp-file-label {
  display: block;
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.pp-file-name {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  font-family: var(--font-mono);
  color: var(--brass-300);
  word-break: break-all;
}

.pp-actions {
  display: flex;
  gap: 12rpx;
  margin-top: var(--space-2);
}

.pp-act {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--brass-400);
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-sm);
}

.pp-act.primary {
  background: linear-gradient(160deg, var(--brass-300) 0%, var(--brass-400) 48%, var(--brass-500) 100%);
  color: var(--color-bg);
  border-color: var(--brass-400);
}

/* 进行中 / 已完成：给可见的状态，而不是只靠一句 toast */
.pp-act.is-busy {
  opacity: 0.6;
}

.pp-act.is-done {
  color: var(--color-text-secondary);
  border-color: var(--color-border);
  background: transparent;
}

.pp-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* ==================== 导出按钮：副标题 + 导出中禁用 ==================== */

.mini-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.mini-btn-sub {
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.mini-btn.is-off {
  opacity: 0.45;
}

/* ==================== 最近导出（可追溯） ==================== */

.rp-block {
  margin: 0 var(--space-4) var(--space-3);
  padding: var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.rp-title {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--brass-500);
}

.rp-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.rp-spec {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  color: var(--brass-400);
  border: 1rpx solid var(--brass-500);
  border-radius: 4rpx;
}

.rp-name {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  font-family: var(--font-mono);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
