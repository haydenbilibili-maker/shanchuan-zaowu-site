@import '../utils/ops-museum.wxss';
@import '../utils/ops-dashboard.wxss';

.ops-container {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.ops-empty.is-error {
  border-style: solid;
  border-color: rgba(196, 92, 74, 0.4);
}

.dash-error-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
  justify-content: center;
}

.dash-error-actions .ops-btn-primary,
.dash-error-actions .ops-btn-secondary {
  flex: 1;
  max-width: 280rpx;
}

.ops-tip {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  line-height: 1.55;
}

.ops-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
