/* 工资条明细（manager 分包）—— 原先 @import ../staff/scene.wxss（连带约 41 KiB 的核销页样式）；
   现只内联本页用到的规则，顺序与原级联一致（核销页 → 现场卡片 → 本页） */

/* —— 来自 staff/field/index.wxss —— */
page {
  background: var(--color-bg);
  color: var(--color-text-body);
  /*
   * 水平边距：对齐 store-points / staff / approvals 的 container
   * 使用 32rpx 硬值兜底——勿单独依赖未定义的 --space-5（曾导致整段 padding 失效贴边）
   */
  --field-gutter: var(--space-4, 32rpx);
}

.page-boot {
  min-height: 100vh;
  padding: var(--space-8, 64rpx) var(--field-gutter);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.boot-en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.boot-cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 8rpx;
}

.boot-hint {
  margin-top: var(--space-3);
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}

.container {
  min-height: 100vh;
  /* 与 store-points / staff/index 一致：左右 32rpx；分拆写法防止 shorthand 被无效变量整段丢弃 */
  padding-top: 0;
  padding-right: 32rpx;
  padding-bottom: var(--space-8, 64rpx);
  padding-left: 32rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: var(--space-3);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.section-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary, #A09A90);
}

.section > .section-note:first-child {
  margin-top: 0;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 0 var(--space-5);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1.2;
  text-align: center;
}

.btn-primary {
  background: var(--brass-400);
  color: var(--color-bg);
  border: 1rpx solid var(--brass-400);
}

.btn-primary:active {
  background: var(--brass-500);
  border-color: var(--brass-500);
}

.list {
  display: flex;
  flex-direction: column;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.row-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.row-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.empty {
  padding: var(--space-4) 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}

.empty .empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}


.modal {
  width: 100%;
  max-width: 620rpx;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  overflow-y: auto;
}



.modal .btn-primary {
  margin-top: var(--space-6);
  width: 100%;
}

.page-tip {
  margin: 12rpx 0 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
}

.empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

/* —— 来自 staff/scene.wxss —— */
.page-boot {
  min-height: 100vh;
  padding: var(--space-8) var(--space-4);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.boot-en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.boot-cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 8rpx;
}

.boot-hint {
  margin-top: var(--space-3);
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}

.scene-card {
  margin-top: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.scene-tile-arrow {
  font-size: 24rpx;
  color: var(--brass-400);
  margin-left: var(--space-3);
}

.amount-row {
  font-family: var(--font-mono);
  font-size: 40rpx;
  color: var(--color-text-primary);
}

/* —— 本页 —— */
.container {
  min-height: 100vh;
  padding: var(--space-4);
  box-sizing: border-box;
}

.amount-row.gold {
  color: var(--brass-400);
}

.amount-row.deduct {
  color: var(--color-text-secondary);
}

.section-head-row,
.row-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-head-row .section-note {
  flex: 1;
  min-width: 0;
}

.row.divider {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx solid var(--color-border);
}

.sales-share-section {
  margin-bottom: var(--space-2);
}

.sales-share-card {
  margin-top: var(--space-3);
}

.sales-share-head {
  margin-bottom: var(--space-3);
}

.sales-share-en {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.sales-share-title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 32rpx;
  color: var(--color-text-primary);
}

.sales-share-note {
  display: block;
  margin-top: var(--space-2);
  line-height: 1.55;
}

.mall-breakdown {
  margin: 4rpx 0 var(--space-2);
  padding: 12rpx 20rpx;
  border-left: 2rpx solid var(--color-border);
}

.mall-breakdown-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.mall-breakdown-main {
  flex: 1;
  min-width: 0;
}

.mall-breakdown-name {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.mall-breakdown-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--color-text-secondary, #A09A90);
}

.mall-breakdown-fee {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.empty.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
}
.empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}
.btn-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e8dcc0;
}


/* 社保明细：个人扣款与公司缴纳分开列 */
.si-head {
  display: block;
  margin-top: var(--space-3);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--brass-400);
}
.amount-row.si-amount {
  font-size: 30rpx;
}
.si-company .si-head {
  margin-top: 0;
}
