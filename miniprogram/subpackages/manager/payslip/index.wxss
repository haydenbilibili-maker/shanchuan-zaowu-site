@import "../staff/scene.wxss";

.container {
  min-height: 100vh;
  padding: var(--space-4);
  box-sizing: border-box;
}

.amount-row.gold {
  color: var(--brass-400);
}

.amount-row.deduct {
  color: var(--color-text-secondary);
}

.section-head-row,
.row-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-head-row .section-note {
  flex: 1;
  min-width: 0;
}

.row.divider {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx solid var(--color-border);
}

.sales-share-section {
  margin-bottom: var(--space-2);
}

.sales-share-card {
  margin-top: var(--space-3);
}

.sales-share-head {
  margin-bottom: var(--space-3);
}

.sales-share-en {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.sales-share-title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 32rpx;
  color: var(--color-text-primary);
}

.sales-share-note {
  display: block;
  margin-top: var(--space-2);
  line-height: 1.55;
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.empty.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
}
.empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
}
.btn-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e8dcc0;
}
