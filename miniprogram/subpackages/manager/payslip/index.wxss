@import "../staff/scene.wxss";

.container {
  min-height: 100vh;
  padding: var(--space-4);
  box-sizing: border-box;
}

.amount-row.gold {
  color: var(--brass-400);
}

.amount-row.deduct {
  color: var(--color-text-secondary);
}

.section-head-row,
.row-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-head-row .section-note {
  flex: 1;
  min-width: 0;
}

.row.divider {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx solid var(--color-border);
}

.sales-share-section {
  margin-bottom: var(--space-2);
}

.sales-share-card {
  margin-top: var(--space-3);
}

.sales-share-head {
  margin-bottom: var(--space-3);
}

.sales-share-en {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.sales-share-title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: 32rpx;
  color: var(--color-text-primary);
}

.sales-share-note {
  display: block;
  margin-top: var(--space-2);
  line-height: 1.55;
}
