@import "../../utils/workbench-nav.wxss";
@import "../../staff-permissions/index.wxss";

.page {
  min-height: 100vh;
}

.picker-row {
  padding: var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  color: var(--color-text-body);
}

.row-sub.muted {
  color: var(--color-text-secondary);
  font-size: var(--fs-22);
}

.section-head-row,
.row-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-head-row .section-note {
  flex: 1;
  min-width: 0;
}

.modal .workbench-modal-foot {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.modal .workbench-modal-foot .workbench-btn-primary,
.modal .workbench-modal-foot .workbench-btn-outline {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
}

/* 社保扣缴：个人扣款预览 + 公司缴纳只展示 */
.si-box {
  padding-top: var(--space-2);
  border-top: 1rpx solid var(--color-border);
}

.si-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--space-2) 0;
}

.si-hint {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.si-hint.is-warn {
  color: #f0c9c0;
}

.si-preview {
  margin-top: var(--space-2);
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.si-line {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: var(--fs-24);
  color: var(--color-text-body);
}

.si-line.is-total {
  margin-top: 6rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--color-border);
  color: var(--brass-400);
}
