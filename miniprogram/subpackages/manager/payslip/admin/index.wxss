@import "../../utils/workbench-nav.wxss";
@import "../../staff-permissions/index.wxss";

.page {
  min-height: 100vh;
}

.picker-row {
  padding: var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-body);
}

.row-sub.muted {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.section-head-row,
.row-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-head-row .section-note {
  flex: 1;
  min-width: 0;
}

.modal .workbench-modal-foot {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}

.modal .workbench-modal-foot .workbench-btn-primary,
.modal .workbench-modal-foot .workbench-btn-outline {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
}
