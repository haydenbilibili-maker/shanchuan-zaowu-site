<view class="page" wx:if="{{ready}}">
  <view class="container">
    <view class="header">
      <view class="brand-group">
        <text class="en">PAYROLL</text>
        <text class="cn">工资维护</text>
      </view>
      <view class="section-head-row">
        <view class="signal-light {{list.length > 0 ? 'lamp-forest' : 'lamp-muted'}}"></view>
        <text class="section-note">超管录入或修正员工月度工资条；保存时会记录操作人。</text>
      </view>
    </view>

    <view class="section">
      <text class="field-label">按员工筛选</text>
      <picker mode="selector" range="{{staffNames}}" value="{{staffIndex}}" bindchange="onStaffFilterChange">
        <view class="picker-row">{{staffNames[staffIndex] || '全部员工'}}</view>
      </picker>
    </view>

    <view class="section">
      <view class="row staff-row" wx:for="{{list}}" wx:key="_id">
        <view class="row-main">
          <view class="row-title-line">
            <view class="signal-light lamp-forest"></view>
            <text class="row-title">{{item.staffName || '员工'}} · {{item.month}}</text>
          </view>
          <text class="row-sub">实发 ¥{{item.net}} · …{{item.staffOpenid ? item.staffOpenid.slice(-6) : ''}}</text>
          <text class="row-sub muted" wx:if="{{item.updatedByName || item.updatedBy}}">最近 {{item.updatedByName || item.updatedBy}}</text>
        </view>
        <view class="staff-actions">
          <view hover-class="wb-press" hover-stay-time="80" class="staff-btn edit" catchtap="openEdit" data-id="{{item._id}}">编辑</view>
          <view hover-class="wb-press" hover-stay-time="80" class="staff-btn danger" catchtap="removeRow" data-id="{{item._id}}">删除</view>
        </view>
      </view>
      <view class="empty" wx:if="{{list.length === 0 && !loading}}">暂无工资条，可点底部「新建工资条」录入</view>
    </view>

    <view class="workbench-page-foot-spacer"></view>
  </view>

  <view class="workbench-footer-bar" wx:if="{{!showEditor}}">
    <view hover-class="wb-press" hover-stay-time="80" class="workbench-btn-primary" bindtap="openCreate">新建工资条</view>
    <view class="workbench-footer-secondary">
      <view hover-class="wb-press" hover-stay-time="80" class="workbench-btn-ghost" bindtap="clearFilter">查看全部</view>
    </view>
  </view>
</view>

<view class="mask" wx:if="{{showEditor}}" bindtap="closeEditor">
  <view class="modal" catchtap="noop">
    <view class="modal-head">
      <text class="modal-title">{{form.id ? '编辑' : '新建'}}工资条</text>
    </view>
    <view class="modal-body">
      <view class="field">
        <text class="field-label">员工</text>
        <picker mode="selector" range="{{staffNames}}" bindchange="onFormStaffPick">
          <view class="input picker-row">{{form.staffName || '选择员工'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">月份 YYYY-MM</text>
        <input class="input" value="{{form.month}}" data-field="month" bindinput="onFormInput" />
      </view>
      <view class="field">
        <text class="field-label">基本工资</text>
        <input class="input" type="digit" value="{{form.base}}" data-field="base" bindinput="onFormInput" />
      </view>
      <view class="field">
        <text class="field-label">奖金 / 补贴</text>
        <input class="input" type="digit" value="{{form.bonus}}" data-field="bonus" bindinput="onFormInput" />
      </view>
      <view class="field">
        <text class="field-label">{{form.siOn ? '其他扣款（考勤等，不含社保）' : '扣款'}}</text>
        <input class="input" type="digit" value="{{form.deduction}}" data-field="deduction" bindinput="onFormInput" />
      </view>
      <view class="field si-box">
        <view class="si-switch-row">
          <text class="field-label">套用社保扣缴标准</text>
          <switch checked="{{form.siOn}}" color="#C4A76C" bindchange="onSiToggle" />
        </view>
        <block wx:if="{{form.siOn}}">
          <text class="si-hint">每月按同一份月度扣缴标准扣{{siPreview.standardLabel ? '（' + siPreview.standardLabel + '）' : ''}}；没有新版标准时沿用上一版</text>
          <view class="si-switch-row" wx:if="{{!siPreview.snapshot || siPreview.snapshot.annualAvailable}}">
            <text class="field-label">含大额医疗互助（全年一次）</text>
            <switch checked="{{form.siIncludeAnnual}}" color="#C4A76C" bindchange="onSiAnnualToggle" />
          </view>
          <text class="si-hint" wx:if="{{siPreview.loading}}">正在计算社保明细…</text>
          <text class="si-hint is-warn" wx:elif="{{siPreview.msg}}">{{siPreview.msg}}</text>
          <view class="si-preview" wx:if="{{siPreview.snapshot}}">
            <view class="si-line" wx:for="{{siPreview.lines}}" wx:key="key">
              <text>{{item.label}}</text>
              <text>{{item.amountFmt}}</text>
            </view>
            <view class="si-line is-total">
              <text>个人社保合计（从工资扣）</text>
              <text>-¥{{siPreview.personalTotalFmt}}</text>
            </view>
            <view class="si-line">
              <text>公司缴纳合计（不扣工资，只展示）</text>
              <text>¥{{siPreview.companyTotalFmt}}</text>
            </view>
            <view class="si-line is-total">
              <text>预计实发</text>
              <text>¥{{siPreview.netFmt}}</text>
            </view>
          </view>
          <text class="si-hint" wx:for="{{siPreview.infos}}" wx:key="*this">{{item}}</text>
          <text class="si-hint is-warn" wx:if="{{form.siLegacyDeduction}}">这张工资条原来的扣款可能已含社保，套用标准时请把「其他扣款」改成不含社保的部分，避免重复扣</text>
        </block>
      </view>
      <view class="field">
        <text class="field-label">备注</text>
        <input class="input" value="{{form.remark}}" data-field="remark" bindinput="onFormInput" maxlength="200" />
      </view>
    </view>
    <view class="workbench-modal-foot">
      <view hover-class="wb-press" hover-stay-time="80" class="workbench-btn-outline" bindtap="closeEditor">取消</view>
      <view hover-class="wb-press" hover-stay-time="80" class="workbench-btn-primary {{saving ? 'is-disabled' : ''}}" bindtap="saveForm">{{saving ? '保存中' : '保存'}}</view>
    </view>
  </view>
</view>

<!-- 全站样式化弹窗宿主（utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
