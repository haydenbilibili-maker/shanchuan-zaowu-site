<!--subpackages/manager/wish-wall/index.wxml-->
<view class="workbench-state loading" wx:if="{{!ready}}">加载中…</view>

<view class="page" wx:if="{{ready}}">
  <view class="header">
    <view class="brand-group">
      <text class="en">WISH WALL</text>
      <text class="cn">祈福墙管理</text>
    </view>
    <text class="header-note">弹幕不接内容审核，治理由本页承载：全部弹幕（含已隐藏）都可在这里查看、隐藏、恢复、置顶或删除。C 端展示由「内容开关 → 马上有祈福」统一控制。</text>
  </view>

  <!-- 需求 28：第一批基础内容。祈福墙上线第一天不能是空墙 —— 空墙没人愿意第一个写 -->
  <view class="seed-card">
    <view class="seed-head">
      <text class="seed-title">基础内容</text>
      <text class="seed-badge" wx:if="{{seedResult}}">{{seedResult.counts.total}} 条已上墙</text>
    </view>
    <text class="seed-desc">用 AI 创作一批「马上有XX」句式铺上墙。未配置 AI 密钥或调用失败时，自动改用人工审校过的基线文案，不会生成不了。上墙后与用户弹幕同一套治理，可在这里隐藏或删除。</text>
    <view class="seed-actions">
      <view class="seed-btn {{seeding ? 'is-disabled' : ''}}" bindtap="seedAi">{{seeding ? '生成中…' : 'AI 生成一批心愿'}}</view>
      <text class="seed-note" wx:if="{{seedResult}}">AI {{seedResult.counts.ai}} 条 · 基线 {{seedResult.counts.baseline}} 条</text>
    </view>
    <text class="seed-warn" wx:if="{{seedResult && seedResult.aiError}}">AI 未生效：{{seedResult.aiError}}</text>
    <view class="seed-chips" wx:if="{{seedResult && seedResult.texts.length}}">
      <text class="seed-chip" wx:for="{{seedResult.texts}}" wx:key="text">{{item.text}}</text>
    </view>
  </view>

  <view class="summary-card">
    <text class="summary-label">展示中</text>
    <view class="summary-value">{{counts.visible}}</view>
    <view class="summary-sub">已隐藏 {{counts.hidden}} 条 · 共 {{counts.visible + counts.hidden}} 条</view>
  </view>

  <view class="filter-row">
    <view
      class="filter-tab {{activeStatus === item.id ? 'active' : ''}}"
      wx:for="{{statusTabs}}"
      wx:key="id"
      bindtap="switchStatus"
      data-status="{{item.id}}"
    >{{item.label}}</view>
  </view>

  <view class="search-row">
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索文案关键词"
      placeholder-class="search-ph"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onKeywordConfirm"
    />
    <view class="search-btn" bindtap="onKeywordConfirm">搜索</view>
  </view>

  <view class="empty" wx:if="{{loading}}">同步中…</view>
  <view class="empty" wx:if="{{!loading && !list.length}}">没有符合条件的弹幕</view>

  <view class="wish-card" wx:for="{{list}}" wx:key="_id">
    <view class="wish-top">
      <text class="wish-status {{item.status === 'hidden' ? 'is-hidden' : ''}}">{{item.statusLabel}}</text>
      <text class="wish-pin" wx:if="{{item.pinned}}">置顶</text>
    </view>
    <text class="wish-text" bindtap="copyText" data-text="{{item.text}}">{{item.text}}</text>
    <text class="wish-meta">{{item.nickname}} · {{item.timeText}}</text>
    <text class="wish-meta" wx:if="{{item.openid}}">openid {{item.openid}}</text>
    <view class="wish-actions">
      <view
        class="btn-ghost"
        wx:if="{{item.status !== 'hidden'}}"
        bindtap="toggleStatus"
        data-id="{{item._id}}"
        data-next="hidden"
      >隐藏</view>
      <view
        class="btn-ghost"
        wx:else
        bindtap="toggleStatus"
        data-id="{{item._id}}"
        data-next="visible"
      >恢复展示</view>
      <view
        class="btn-ghost"
        bindtap="togglePinned"
        data-id="{{item._id}}"
        data-pinned="{{item.pinned}}"
      >{{item.pinned ? '取消置顶' : '置顶'}}</view>
      <view class="btn-danger" bindtap="removeWish" data-id="{{item._id}}">删除</view>
    </view>
  </view>
</view>
