/* 员工名册 — Museum Mode（对齐权限配置页） */
@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.container {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  padding: var(--space-5) 0 var(--space-2);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.brand-group .cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.header-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.04em;
}

.section {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
}

.summary-row {
  display: flex;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.summary-num {
  font-family: var(--font-mono);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.summary-num.on {
  color: var(--color-success);
}

.summary-num.off {
  color: var(--color-text-secondary);
}

.summary-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.summary-actions {
  display: flex;
  gap: var(--space-2);
}

.btn-primary,
.btn-secondary {
  flex: 1;
  text-align: center;
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 500;
}

.btn-primary {
  background: var(--brass-400);
  color: var(--color-bg);
}

.btn-secondary {
  background: transparent;
  border: 1rpx solid var(--brass-400);
  color: var(--brass-400);
  box-sizing: border-box;
}

.filters {
  padding-bottom: var(--space-3);
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: var(--space-2);
  padding-bottom: 4rpx;
}

.status-row {
  display: flex;
  margin-top: var(--space-3);
  flex-wrap: wrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
}

.filter-chip.on {
  border-color: var(--brass-800);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.08);
}

.filter-chip.status.on {
  border-color: var(--color-forest);
  color: var(--color-success);
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

.list-meta {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.staff-row {
  display: flex;
  align-items: stretch;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.staff-row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.staff-title-line {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.signal-light {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.lamp-forest {
  background: var(--color-success);
}

.lamp-muted {
  background: var(--color-text-muted);
}

.lamp-muted.hollow {
  background: transparent;
  border: 2rpx solid var(--color-text-muted);
  box-sizing: border-box;
}

.row-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 0.04em;
}

.tag.active {
  background: rgba(82, 183, 136, 0.14);
  color: var(--color-success);
}

.tag.disabled {
  background: rgba(160, 154, 144, 0.14);
  color: var(--color-text-secondary);
}

.row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-body);
  line-height: 1.4;
}

.row-sub.role {
  color: var(--brass-400);
}

.row-sub.muted {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.staff-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-2);
  flex-shrink: 0;
}

.staff-btn {
  min-width: 96rpx;
  text-align: center;
  padding: 12rpx 18rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-text-body);
}

.staff-btn.edit {
  border-color: var(--brass-800);
  color: var(--brass-400);
}

.staff-btn.danger {
  border-color: rgba(214, 64, 69, 0.45);
  color: var(--color-error);
}

.staff-btn.success {
  border-color: rgba(82, 183, 136, 0.45);
  color: var(--color-success);
}

.empty {
  padding: var(--space-6) 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.empty-tip.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  margin: 16rpx 0;
}
.empty-title {
  display: block;
  font-size: 28rpx;
  color: #f0c9c0;
  margin-bottom: 8rpx;
}
.empty-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(232, 220, 192, 0.72);
  line-height: 1.5;
}
.btn-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e8dcc0;
}
.chip-btn.warn-pending {
  outline: 1rpx solid rgba(196, 92, 74, 0.6);
}
