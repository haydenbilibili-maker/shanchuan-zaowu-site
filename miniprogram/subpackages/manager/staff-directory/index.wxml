<view class="container" wx:if="{{ready}}">

  <view class="header">
    <view class="brand-group">
      <text class="en">TEAM DIRECTORY</text>
      <text class="cn">员工</text>
    </view>
    <text class="header-note">数据源：权限中心 · staff_members</text>
  </view>

  <view class="page-tip is-{{tipTone}}" wx:if="{{tipText}}"><text>{{tipText}}</text></view>

  <view class="section summary">
    <view class="summary-row">
      <view class="summary-item">
        <text class="summary-num">{{counts.all}}</text>
        <text class="summary-label">全部</text>
      </view>
      <view class="summary-item">
        <text class="summary-num on">{{counts.active}}</text>
        <text class="summary-label">生效</text>
      </view>
      <view class="summary-item">
        <text class="summary-num off">{{counts.disabled}}</text>
        <text class="summary-label">停用</text>
      </view>
    </view>
    <view class="summary-actions">
      <view hover-class="wb-press" hover-stay-time="80" class="btn-secondary" bindtap="goPermissions">去权限配置</view>
      <view hover-class="wb-press" hover-stay-time="80" class="btn-primary" bindtap="goPermissions">开通员工</view>
    </view>
  </view>

  <view class="section filters">
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <view hover-class="wb-press" hover-stay-time="80"
          class="filter-chip {{roleFilter === item.key ? 'on' : ''}}"
          wx:for="{{roleFilters}}"
          wx:key="key"
          bindtap="onRoleFilterTap"
          data-key="{{item.key}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>
    <view class="filter-row status-row">
      <view hover-class="wb-press" hover-stay-time="80"
        class="filter-chip status {{statusFilter === item.key ? 'on' : ''}}"
        wx:for="{{statusFilters}}"
        wx:key="key"
        bindtap="onStatusFilterTap"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="section list-section">
    <view class="list-head">
      <text class="section-title">名册</text>
      <text class="list-meta" wx:if="{{loading}}">加载中…</text>
      <text class="list-meta" wx:else>{{staffList.length}} 人</text>
    </view>

    <view class="row staff-row" wx:for="{{staffList}}" wx:key="_id">
      <view hover-class="wb-press" hover-stay-time="80" class="row-main" bindtap="goEditPermissions">
        <view class="staff-title-line">
          <view class="signal-light {{item.status === 'active' ? 'lamp-forest' : 'lamp-muted hollow'}}"></view>
          <text class="row-title">{{item.name || '未命名'}}</text>
          <text class="tag {{item.status}}">{{item.status === 'active' ? '生效' : '停用'}}</text>
        </view>
        <text class="row-sub role">{{item.roleText || '—'}}</text>
        <text class="row-sub">{{item.phoneText}}{{item.staffNo ? ' · 工号 ' + item.staffNo : ''}}</text>
        <text class="row-sub" wx:if="{{item.storeText}}">门店 · {{item.storeText}}</text>
        <text class="row-sub muted">…{{item.openidTail}}</text>
      </view>
      <view class="staff-actions">
        <view hover-class="wb-press" hover-stay-time="80" class="staff-btn edit" catchtap="goEditPermissions">权限</view>
        <view hover-class="wb-press" hover-stay-time="80"
          class="staff-btn danger"
          wx:if="{{item.status === 'active'}}"
          catchtap="disableStaff"
          data-id="{{item._id}}"
        >{{statusPendingId === item._id && statusPendingAction === 'disable' ? '确认停用' : '停用'}}</view>
        <view hover-class="wb-press" hover-stay-time="80"
          class="staff-btn success"
          wx:else
          catchtap="enableStaff"
          data-id="{{item._id}}"
        >{{statusPendingId === item._id && statusPendingAction === 'enable' ? '确认启用' : '启用'}}</view>
      </view>
    </view>

    <view class="empty-tip is-error" wx:if="{{listError && !staffList.length && !loading}}">
      <text class="empty-title">员工列表未能取回</text>
      <text class="empty-sub">{{tipText || '请下拉刷新重试'}}</text>
      <view hover-class="wb-press" hover-stay-time="80" class="btn-retry" bindtap="onRetryList">重试</view>
    </view>
    <view class="empty" wx:elif="{{!loading && !listError && staffList.length === 0}}">{{emptyHint}}</view>
  </view>
</view>
