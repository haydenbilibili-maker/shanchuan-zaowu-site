@import '../utils/ops-museum.wxss';
@import '../utils/ops-dashboard.wxss';

/* 超管「博物君」（2026-11-23）：暗色金调，与 AI 鉴定监测同族 */
.ops-container { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.ops-tip { margin-bottom: 20rpx; padding: 18rpx 20rpx; border-radius: var(--radius-md); font-size: var(--fs-24); line-height: 1.55; }
.ops-tip.is-info { background: rgba(196, 167, 108, 0.14); border: 1rpx solid rgba(196, 167, 108, 0.36); color: #e8dcc0; }
.ops-tip.is-warn { background: rgba(196, 120, 92, 0.14); border: 1rpx solid rgba(196, 120, 92, 0.4); color: #f0d2c4; }

.gm-card { padding: 24rpx; border-radius: var(--radius-md); background: var(--color-bg-card, #1f1d1a); border: 1rpx solid rgba(77, 64, 26, 0.55); }
.gm-switch-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.gm-switch-main { display: flex; align-items: center; gap: 14rpx; }
.gm-lamp { width: 16rpx; height: 16rpx; border-radius: 50%; background: rgba(196, 167, 108, 0.3); }
.gm-lamp.is-on { background: #7FA67A; box-shadow: 0 0 12rpx rgba(127, 166, 122, 0.6); }
.gm-state { font-size: var(--fs-30, 30rpx); color: var(--brass-100, #F1E6CC); font-family: var(--font-brand); letter-spacing: .08em; }
.gm-toggle { flex-shrink: 0; padding: 14rpx 26rpx; border-radius: var(--r-control, 16rpx); font-size: var(--fs-24); color: var(--brass-200, #E3D2AC); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.45); }
.gm-toggle.is-confirm { background: rgba(196, 167, 108, 0.18); }
.gm-toggle.is-confirm.is-danger { background: rgba(196, 120, 92, 0.2); color: #f0d2c4; box-shadow: inset 0 0 0 1rpx rgba(196, 120, 92, 0.55); }
.gm-hint { display: block; margin-top: 14rpx; font-size: var(--fs-22); line-height: 1.55; color: var(--color-text-secondary); }
.gm-limit { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(196, 167, 108, 0.14); }
.gm-limit-k { display: block; margin-bottom: 12rpx; font-size: var(--fs-24); color: var(--brass-200, #E3D2AC); }
.gm-range { margin-top: 28rpx; }

.gm-kpis { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 20rpx; }
.gm-kpi { width: 32%; margin-bottom: 16rpx; padding: 20rpx 8rpx; box-sizing: border-box; border-radius: var(--radius-md); background: var(--color-bg-card, #1f1d1a); border: 1rpx solid rgba(77, 64, 26, 0.55); text-align: center; }
.gm-kpi-v { display: block; font-family: var(--font-mono, monospace); font-size: var(--fs-30, 30rpx); font-weight: 600; color: var(--brass-400, #c4a76c); line-height: 1.3; }
.gm-kpi-k { display: block; margin-top: 6rpx; font-size: var(--fs-20); color: var(--color-text-secondary); }
.gm-totals { display: block; font-size: var(--fs-22); color: var(--color-text-secondary); }

.gm-sec { margin-top: 32rpx; }
.gm-sec-t { display: block; margin-bottom: 14rpx; font-size: var(--fs-26); color: var(--brass-200, #E3D2AC); }
.gm-bar-row { display: flex; flex-wrap: wrap; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid rgba(196, 167, 108, 0.08); }
.gm-bar-day { width: 90rpx; font-family: var(--font-mono, monospace); font-size: var(--fs-22); color: var(--color-text-secondary); }
.gm-bar-track { flex: 1; height: 14rpx; border-radius: var(--r-pill, 999rpx); background: rgba(196, 167, 108, 0.1); overflow: hidden; }
.gm-bar-fill { height: 100%; border-radius: var(--r-pill, 999rpx); background: var(--brass-400, #c4a76c); }
.gm-bar-n { width: 72rpx; text-align: right; font-family: var(--font-mono, monospace); font-size: var(--fs-24); color: var(--brass-100, #F1E6CC); }
.gm-bar-sub { width: 100%; padding-left: 90rpx; margin-top: 4rpx; font-size: var(--fs-20); color: var(--color-text-secondary); }
.gm-li { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid rgba(196, 167, 108, 0.08); }
.gm-li-k { font-size: var(--fs-24); color: var(--brass-100, #F1E6CC); }
.gm-li-v { font-family: var(--font-mono, monospace); font-size: var(--fs-22); color: var(--color-text-secondary); }

.gm-empty { margin-top: 24rpx; padding: 28rpx; text-align: center; font-size: var(--fs-24); color: var(--color-text-secondary); }
.gm-retry { display: inline-block; margin-top: 16rpx; padding: 12rpx 28rpx; border-radius: var(--r-control, 16rpx); color: var(--brass-200, #E3D2AC); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.45); }
.gm-empty-t { display: block; margin-top: 24rpx; text-align: center; font-size: var(--fs-22); color: var(--color-text-secondary); }
.gm-sat { margin-top: 6rpx; color: var(--brass-200, #E3D2AC); }

/* 首页口播 · 馆内通知（2026-11-23） */
.gm-notice { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; padding: 0 18rpx; border-radius: var(--r-control, 16rpx); background: rgba(255, 255, 255, 0.03); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22); }
.gm-notice-in { flex: 1; min-width: 0; height: 76rpx; font-size: var(--fs-24); color: var(--color-text-primary); }
.gm-notice-ph { color: var(--color-text-secondary); }
.gm-notice-n { flex-shrink: 0; font-family: var(--font-mono, monospace); font-size: var(--fs-20); color: var(--color-text-secondary); }
.gm-notice-save { display: inline-block; margin-top: 4rpx; padding: 14rpx 32rpx; border-radius: var(--r-control, 16rpx); font-size: var(--fs-24); color: #1A1814; background: var(--brass-400, #c4a76c); }
.gm-notice-save.is-off { color: var(--color-text-secondary); background: rgba(196, 167, 108, 0.12); }
