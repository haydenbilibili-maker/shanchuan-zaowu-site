/* 门店积分管理 — Museum Mode */
@import '../utils/workbench-nav.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-body);
}

.container {
  min-height: 100vh;
  padding: 0 var(--space-4) calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  padding: var(--space-5) 0 var(--space-2);
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-group .en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-600);
  text-transform: uppercase;
}

.brand-group .cn {
  font-family: var(--font-brand);
  font-size: 40rpx;
  color: var(--color-text-primary);
  margin-top: 6rpx;
}

.store-picker {
  margin-top: var(--space-4);
}

.picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 var(--space-4);
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.picker-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.picker-value {
  flex: 1;
  margin-left: var(--space-3);
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.picker-arrow {
  font-size: 22rpx;
  color: var(--brass-400);
}

/* ---------------- Tab ---------------- */
.tab-bar {
  display: flex;
  margin: var(--space-4) 0 var(--space-3);
  border-bottom: 1rpx solid var(--color-border);
}

.tab {
  flex: 1;
  padding: var(--space-3) 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  position: relative;
}

.tab.active {
  color: var(--brass-400);
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 3rpx;
  background: var(--brass-400);
}

.sub-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: var(--space-3);
}
.sub-tab {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  border-radius: 9999px;
}
.sub-tab.active {
  color: var(--brass-400);
  border-color: var(--brass-800);
  background: rgba(196, 167, 108, 0.08);
}
.claim-thumbs {
  display: flex;
  gap: 12rpx;
  margin: 12rpx 0;
  flex-wrap: wrap;
}
.claim-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: var(--color-bg-elevated);
}

/* ---------------- 区块 ---------------- */
.section {
  margin-bottom: var(--space-4);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.section-title {
  display: block;
  margin-bottom: var(--space-2);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
}

.audit-jump {
  margin-top: var(--space-4);
}

.section-note {
  display: block;
  margin-top: var(--space-2);
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary, #A09A90);
}

/* ---------------- KPI ---------------- */
.kpi-grid {
  display: flex;
  flex-wrap: wrap;
}

.kpi {
  width: 50%;
  padding: var(--space-3) 0;
  display: flex;
  flex-direction: column;
}

.kpi-val {
  font-family: var(--font-mono);
  font-size: 40rpx;
  color: var(--color-text-primary);
}

.kpi-val.gold {
  color: var(--brass-400);
}

.kpi-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
}

.quota-bar {
  margin-top: var(--space-3);
  padding: var(--space-3);
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
}

.quota-text {
  font-size: 24rpx;
  color: var(--brass-300);
}

.rule-current {
  display: block;
  font-size: 28rpx;
  color: var(--brass-400);
}

/* ---------------- 按钮 ----------------
 * 与店员后台对齐：双按钮同高、flex 居中；实心/描边均 1rpx border。
 */
.btn-primary,
.btn-outline,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 0 var(--space-5);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1.2;
  text-align: center;
}

.btn-primary {
  background: var(--brass-400);
  color: var(--color-bg);
  border: 1rpx solid var(--brass-400);
}

.btn-primary:active {
  background: var(--brass-500);
  border-color: var(--brass-500);
}

.btn-outline,
.btn-ghost {
  background: transparent;
  border: 1rpx solid var(--brass-400);
  color: var(--brass-400);
}

.btn-outline:active,
.btn-ghost:active {
  background: rgba(196, 167, 108, 0.08);
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 0 var(--space-5);
  background: var(--color-error);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-error);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.2;
  text-align: center;
}

/* 权限人员：左信息右操作，压矮卡片；右侧仅两键竖排 + 间距防误触 */
.staff-row {
  flex-direction: row;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) 0;
}

.staff-title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.staff-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex-shrink: 0;
  gap: var(--space-2);
}

.staff-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  min-height: 64rpx;
  padding: 0 var(--space-3);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
}

.staff-btn.edit {
  background: transparent;
  border: 1rpx solid var(--brass-400);
  color: var(--brass-400);
}

.staff-btn.edit:active {
  background: rgba(196, 167, 108, 0.12);
}

.staff-btn.danger {
  background: transparent;
  border: 1rpx solid rgba(214, 64, 69, 0.55);
  color: var(--color-error);
}

.staff-btn.danger:active {
  background: rgba(214, 64, 69, 0.12);
}

.staff-btn.success {
  background: transparent;
  border: 1rpx solid rgba(82, 183, 136, 0.55);
  color: var(--color-success);
}

.staff-btn.success:active {
  background: rgba(82, 183, 136, 0.12);
}

.btn-primary.disabled,
.btn-outline.disabled,
.btn-ghost.disabled,
.btn-danger.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.btn-row {
  display: flex;
  align-items: stretch;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.btn-row .btn-primary,
.btn-row .btn-outline,
.btn-row .btn-ghost,
.btn-row .btn-danger {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

/* ---------------- 流水 ---------------- */
.record {
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.record:last-child {
  border-bottom: none;
}

.rec-top,
.rec-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-bottom {
  margin-top: 6rpx;
}

.rec-member {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.rec-points {
  font-family: var(--font-mono);
  font-size: 28rpx;
}

.rec-points.gold {
  color: var(--brass-400);
}

.rec-points.revoked {
  color: var(--color-text-secondary, #A09A90);
  text-decoration: line-through;
}

.rec-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.rec-meta.warn {
  color: var(--color-warning);
}

.rec-remark {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.rec-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: var(--space-3);
}

.btn-primary-mini,
.btn-secondary-mini,
.btn-danger-mini,
.rec-actions .btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 128rpx;
  height: 64rpx;
  padding: 0 28rpx;
  margin: 0;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.btn-primary-mini {
  background: var(--brass-400);
  color: var(--color-bg);
  border: 1rpx solid var(--brass-400);
}

.btn-primary-mini:active {
  background: var(--brass-500);
  border-color: var(--brass-500);
}

.btn-secondary-mini {
  background: transparent;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--brass-800);
}

.btn-secondary-mini:active {
  background: rgba(77, 64, 26, 0.18);
  color: var(--brass-300);
  border-color: var(--brass-700);
}

.btn-danger-mini,
.rec-actions .btn-danger {
  background: transparent;
  color: var(--color-error);
  border: 1rpx solid rgba(214, 64, 69, 0.55);
}

.btn-danger-mini:active,
.rec-actions .btn-danger:active {
  background: rgba(214, 64, 69, 0.12);
}

/* ---------------- 列表 / 表单 ---------------- */
.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--space-3) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.row-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.row-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  line-height: 1.3;
  color: var(--color-success);
  background: rgba(82, 183, 136, 0.1);
}

.tag.disabled {
  color: var(--color-text-muted);
  background: var(--color-bg-elevated);
}

.field {
  margin-bottom: 32rpx;
}

.field.last {
  margin-bottom: 8rpx;
}

.field.compact {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--color-text-secondary);
  letter-spacing: 0.02em;
}

.field-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

.field-hint.warn {
  color: var(--color-warning);
}

.seg-row {
  display: flex;
  gap: 16rpx;
}

.seg-row.wrap {
  flex-wrap: wrap;
}

.seg-item {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.seg-row.wrap .seg-item {
  flex: 0 0 auto;
  padding: 0 24rpx;
  min-width: 140rpx;
}

.seg-item.on {
  color: var(--brass-400);
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.14);
}

.store-check-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.store-check {
  padding: 0 24rpx;
  height: 68rpx;
  line-height: 68rpx;
  border: 1rpx solid rgba(77, 64, 26, 0.4);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  box-sizing: border-box;
}

.store-check.on {
  border-color: var(--brass-400);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.14);
}

.phone-toolbar {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  height: 80rpx;
}

.phone-toolbar .phone-input {
  flex: 1;
  min-width: 0;
  width: auto;
  height: 80rpx;
  min-height: 80rpx;
}

.lookup-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0;
  line-height: 1.2;
  text-align: center;
  font-size: 26rpx;
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.lookup-btn:active {
  background: rgba(196, 167, 108, 0.2);
}

.lookup-btn.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.adv-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx dashed rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
  background: transparent;
  box-sizing: border-box;
}

.adv-toggle-label {
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.adv-toggle-action {
  font-size: 22rpx;
  color: var(--brass-400);
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-full);
}

.adv-toggle + .input {
  margin-top: 14rpx;
}

.match-card,
.candidate {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid var(--brass-400);
  border-radius: var(--radius-md);
}

.candidate-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.candidate {
  border-color: rgba(77, 64, 26, 0.55);
  background: var(--color-bg-elevated);
}

.candidate.on {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
}

.match-badge {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--brass-400);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-full);
}

.match-name {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.match-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.mode-desc {
  margin-top: var(--space-2);
  color: var(--brass-300);
}

.req {
  color: var(--color-error);
}

/* 覆盖 page line-height:1.6；勿用 line-height=height（部分 iOS 微信会倒置/压扁） */
.input {
  display: block;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 24rpx;
  line-height: normal;
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: 28rpx;
  box-sizing: border-box;
}

.rule-save {
  margin-top: var(--space-2);
  margin-bottom: var(--space-3);
}

.ph {
  color: var(--color-text-secondary, #A09A90);
}

.empty {
  padding: var(--space-6) var(--space-2);
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary, #A09A90);
}

/* ---------------- 弹窗 ---------------- */

.modal {
  width: 100%;
  height: auto;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.modal-head {
  flex-shrink: 0;
  padding: 36rpx 36rpx 20rpx;
  border-bottom: 1rpx solid rgba(38, 35, 32, 0.7);
}

.modal-body {
  flex-shrink: 0;
  width: 100%;
  max-height: calc(86vh - 160rpx);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 28rpx 36rpx 16rpx;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  font-family: var(--font-brand);
  font-size: 34rpx;
  color: var(--color-text-primary);
}

.modal-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.module-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
.module-chip {
  padding: 12rpx 22rpx;
  border-radius: 9999px;
  border: 1rpx solid rgba(160,154,144,0.35);
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
  background: transparent;
}
.module-chip.on {
  border-color: var(--brass-400);
  color: var(--brass-400);
  background: rgba(196,167,108,0.08);
}

.page-tip {
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.page-tip.is-info {
  background: rgba(196, 167, 108, 0.14);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  color: #e8dcc0;
}
.page-tip.is-warn {
  background: rgba(196, 92, 74, 0.16);
  border: 1rpx solid rgba(196, 92, 74, 0.5);
  color: #f0c9c0;
}
.loading-hint {
  padding: 32rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
}
.empty.is-error {
  border: 1rpx solid rgba(196, 92, 74, 0.4);
  background: rgba(196, 92, 74, 0.08);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
}
.empty-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary, #fff);
  margin-bottom: 8rpx;
}
.empty-desc, .empty-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}
.btn-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e8dcc0;
}
