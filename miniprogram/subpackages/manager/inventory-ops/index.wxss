@import '../utils/ops-museum.wxss';
@import '../utils/ops-dashboard.wxss';

.ops-field {
  margin-bottom: 24rpx;
}

.ops-field-label {
  display: block;
  font-size: 22rpx;
  color: #a09a90;
  margin-bottom: 8rpx;
}

.ops-field-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: #1f1d1a;
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.ops-qty-badge.warn {
  color: #e9a23b;
  border-color: rgba(233, 162, 59, 0.45);
}
