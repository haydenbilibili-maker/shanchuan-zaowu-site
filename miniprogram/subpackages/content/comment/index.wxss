/* subpackages/feature/comment/index.wxss — Museum Mode */
page {
  background-color: #1A1814;
  color: #D5D1C8;
  overscroll-behavior-x: none;
  overflow-x: hidden;
  height: 100vh;
}

.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

.scroll-container {
  width: 100%;
  flex-shrink: 0;
  height: calc(100vh - 196rpx - env(safe-area-inset-bottom));
  max-height: calc(100vh - 196rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.scroll-container.is-full {
  height: 100vh;
  max-height: 100vh;
}

.content-wrapper {
  padding: 0;
  padding-bottom: 40rpx;
  min-height: 100%;
}

.bottom-spacer {
  height: 24rpx;
}

.gate-card {
  margin: 40rpx 32rpx;
  padding: 48rpx 32rpx;
  background: #1F1D1A;
  border: 1px solid #26232066;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gate-title {
  font-size: var(--fs-30);
  font-weight: 500;
  color: #FFFFFF;
}

.gate-text {
  font-size: var(--fs-26);
  color: #A09A90;
  line-height: 1.6;
}

.header-section {
  padding: 30rpx;
  margin-bottom: 8rpx;
}

.target-info {
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  background: #1F1D1A;
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
}

.target-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: #262320;
}

.target-details {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.target-title {
  font-size: var(--fs-30);
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.target-subtitle {
  font-size: var(--fs-24);
  color: var(--color-primary);
  font-style: italic;
  margin-bottom: 8rpx;
}

.target-hint {
  font-size: var(--fs-22);
  color: #A09A90;
}

.product-pick {
  margin: 0 32rpx 24rpx;
}

.product-pick-scroll {
  white-space: nowrap;
  margin-top: 12rpx;
}

.product-chip {
  display: inline-flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 200rpx;
  max-width: 280rpx;
  padding: 20rpx 24rpx;
  margin-right: 16rpx;
  background: #1F1D1A;
  border: 1px solid #26232066;
  border-radius: var(--radius-md);
  vertical-align: top;
}

.product-chip.active {
  border-color: var(--color-primary);
}

.product-chip.done {
  opacity: 0.72;
}

.chip-title {
  font-size: var(--fs-24);
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-status {
  font-size: var(--fs-20);
  color: #A09A90;
}

/* 「我的评价」查看态 */
.review-card {
  margin: 0 32rpx 40rpx;
  padding: 32rpx;
  background: #1F1D1A;
  border: 1px solid #26232066;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.review-stars {
  display: flex;
  gap: 8rpx;
}

.review-star {
  font-size: var(--fs-36);
  color: #4A4540;
  line-height: 1;
}

.review-star.active {
  color: var(--color-primary);
}

.review-status {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
}

.review-status.is-approved {
  border-color: var(--color-success);
  color: var(--color-success);
}

.review-status.is-hidden {
  border-color: #A09A90;
  color: #A09A90;
}

.review-content {
  font-size: var(--fs-28);
  color: #D5D1C8;
  line-height: 1.7;
  word-break: break-all;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.review-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  background: #262320;
}

.review-time {
  font-size: var(--fs-22);
  color: #A09A90;
}

.review-reply {
  padding: 20rpx 24rpx;
  background: #262320;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.review-reply-label {
  font-size: var(--fs-22);
  color: var(--color-primary);
  letter-spacing: 0.06em;
}

.review-reply-text {
  font-size: var(--fs-26);
  color: #D5D1C8;
  line-height: 1.6;
}

.review-foot {
  padding-top: 24rpx;
  border-top: 1px solid #26232066;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20rpx;
}

.review-note {
  font-size: var(--fs-24);
  color: #A09A90;
  line-height: 1.6;
}

.review-visit {
  padding: 16rpx 32rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  color: var(--color-primary);
  font-size: var(--fs-26);
}

/* 追加评价（2026-11-27）：卡内续笔用虚线分隔；入口与「去藏品页」同一档描边按钮 */
.review-append {
  padding-top: 24rpx;
  border-top: 1rpx dashed #3A3631;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.review-append-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.review-append-label {
  font-size: var(--fs-24);
  color: var(--color-primary);
  letter-spacing: 0.08em;
}

.review-append-cta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx 20rpx;
}

.review-append-btn {
  padding: 16rpx 32rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: #1A1814;
  font-size: var(--fs-26);
  font-weight: 500;
}

.review-append-hint {
  font-size: var(--fs-22);
  color: #A09A90;
}

.append-intro {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: var(--radius-lg);
  background: rgba(196, 167, 108, 0.06);
}

.append-intro-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.append-intro-title {
  font-size: var(--fs-28);
  color: var(--color-primary);
  letter-spacing: 0.06em;
}

.append-intro-sub {
  font-size: var(--fs-22);
  color: #A09A90;
}

.append-intro-cancel {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  font-size: var(--fs-24);
  color: #A09A90;
}

.rating-section,
.content-section,
.image-section {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: #1F1D1A;
  border: 1px solid #26232066;
  border-radius: var(--radius-lg);
}

.section-label {
  display: block;
  font-size: var(--fs-24);
  font-weight: 500;
  color: var(--color-primary);
  margin-bottom: 24rpx;
  letter-spacing: 0.08em;
}

.rating-stars {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  padding: 8rpx 0 12rpx;
}

.star {
  font-size: 56rpx;
  color: #4A4540;
  line-height: 1;
}

.star.active {
  color: var(--color-primary);
}

.rating-hint {
  display: block;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-primary);
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  padding: 24rpx;
  background: #262320;
  border: 1px solid #4D401A66;
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  color: #D5D1C8;
  line-height: 1.7;
  box-sizing: border-box;
}

.input-placeholder {
  color: #6B6560;
}

.char-count {
  display: block;
  text-align: right;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  margin-top: 12rpx;
}

.image-list {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.uploaded-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  border: 1px solid #26232066;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  /* 2026-09-21 分子级审计：原字面量 #D64045 配白字仅 4.489（AA 需 4.5）→ 用令牌（4.74） */
  background: var(--color-error);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: var(--fs-28);
  z-index: 10;
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  border: 1px dashed #C4A76C66;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.upload-icon {
  font-size: var(--fs-40);
  color: var(--color-primary);
  margin-bottom: 6rpx;
  font-weight: 300;
}

.upload-text {
  font-size: var(--fs-22);
  color: #A09A90;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  padding: 16rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #1A1814;
  box-shadow: 0 -1rpx 0 rgba(196, 167, 108, 0.16), 0 -16rpx 32rpx rgba(0, 0, 0, 0.35);
  z-index: 100;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 还差什么 / 可以发布了 */
.submit-hint {
  font-size: var(--fs-22);
  color: #A09A90;
  text-align: center;
  letter-spacing: 0.02em;
}

.submit-hint.is-ready {
  color: var(--brass-300);
}

/* 发布按钮：view 做（避开微信 button 内置 184px 宽），通栏胶囊、铜金实底 */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  border-radius: var(--r-pill, 999rpx);
  background: linear-gradient(180deg, #D2B67A 0%, var(--color-primary) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
  color: #1A1814;
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.16em;
  transition: opacity var(--dur-base, 200ms) var(--ease-standard, ease), transform var(--dur-base, 200ms) var(--ease-standard, ease);
}

.submit-btn-press {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 未就绪：淡显（仍可点，点了按原逻辑提示还差什么） */
.submit-btn.is-wait {
  background: rgba(196, 167, 108, 0.16);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.35);
  color: var(--brass-200);
}

.submit-btn.is-busy {
  background: #262320;
  box-shadow: none;
  color: #A09A90;
}

/* 星星按压 */
.star-press {
  transform: scale(1.12);
}

.star {
  transition: transform 120ms ease, color 120ms ease;
}

.rating-hint.is-idle {
  color: #A09A90;
}

/* 常用说法 */
.phrase-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
  overflow: hidden;
}

.phrase-row {
  display: inline-flex;
  gap: 12rpx;
}

.phrase {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: var(--r-pill, 999rpx);
  font-size: var(--fs-22);
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.06);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3);
}

/* 图片段：标题 + 计数同一行 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-count {
  font-size: var(--fs-22);
  color: #A09A90;
  font-family: var(--font-mono);
}

/* 2026-11-22 交互巡查：可点区域扩到约 72rpx（视觉不变；透明 ::after 外扩，事件冒泡到本元素） */
.delete-btn::after { content: ''; position: absolute; top: -16rpx; right: -16rpx; bottom: -16rpx; left: -16rpx; }
