<!--subpackages/feature/comment/index.wxml-->
<wxs src="../../../utils/latinDisplay.wxs" module="latin" />
<wxs src="./submitState.wxs" module="ss" />
<view class="page-wrapper">
  <scroll-view
    scroll-y
    class="scroll-container {{canReview && !loadingGate ? '' : 'is-full'}}"
    enable-flex="true">

    <view class="content-wrapper">
      <view class="gate-card" wx:if="{{loadingGate}}">
        <text class="gate-text">正在确认评价资格…</text>
      </view>

      <view class="gate-card" wx:elif="{{!canReview && !viewReview}}">
        <text class="gate-title">{{gateCode === 'NEED_ORDER' ? '签收后可评价' : '暂不可评价'}}</text>
        <text class="gate-text">{{gateMsg}}</text>
      </view>

      <block wx:else>
        <view class="header-section">
          <view class="target-info" wx:if="{{targetInfo}}">
            <shan-img ext-class="target-image" src="{{targetInfo.images && targetInfo.images[0] ? targetInfo.images[0] : targetInfo.image}}" mode="aspectFill" />
            <view class="target-details">
              <text class="target-title">{{targetInfo.title || targetInfo.name}}</text>
              <text class="target-subtitle" wx:if="{{latin.display(targetInfo.latinName)}}">{{latin.display(targetInfo.latinName)}}</text>
              <text class="target-hint">{{viewReview ? '这是你写下的感受' : '分享你看到它时的第一印象'}}</text>
            </view>
          </view>
        </view>

        <view class="product-pick" wx:if="{{productOptions.length > 1}}">
          <text class="section-label">选择藏品</text>
          <scroll-view scroll-x class="product-pick-scroll" enable-flex="true">
            <view
              class="product-chip {{targetId === item.productId ? 'active' : ''}} {{item.canReview ? '' : 'done'}}"
              wx:for="{{productOptions}}"
              wx:key="productId"
              bindtap="selectProduct"
              data-id="{{item.productId}}"
              hover-class="tap-press-soft"
              hover-stay-time="80"
            >
              <text class="chip-title">{{item.title}}</text>
              <text class="chip-status">{{item.statusLabel}}</text>
            </view>
          </scroll-view>
        </view>

        <view class="review-card" wx:if="{{viewReview}}">
          <view class="review-head">
            <view class="review-stars">
              <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star">
                <text class="review-star {{viewReview.rating >= star ? 'active' : ''}}">★</text>
              </block>
            </view>
            <text class="review-status is-{{viewReview.status}}">{{viewReview.statusText}}</text>
          </view>
          <text class="review-content" wx:if="{{viewReview.content}}" user-select="{{true}}">{{viewReview.content}}</text>
          <view class="review-images" wx:if="{{viewReview.images.length}}">
            <shan-img ext-class="review-image" wx:for="{{viewReview.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewMyImage" data-index="{{index}}" />
          </view>
          <text class="review-time" wx:if="{{viewReview.timeText}}">提交于 {{viewReview.timeText}}</text>
          <view class="review-reply" wx:if="{{viewReview.merchantReply}}">
            <text class="review-reply-label">山海造物回复</text>
            <text class="review-reply-text">{{viewReview.merchantReply}}</text>
          </view>
          <view class="review-foot">
            <text class="review-note" wx:if="{{viewReview.statusNote}}">{{viewReview.statusNote}}</text>
            <view
              class="review-visit"
              wx:if="{{viewReview.canVisit}}"
              bindtap="goProduct"
              hover-class="tap-press"
              hover-stay-time="80"
            >去藏品页看看 ›</view>
          </view>
        </view>

        <block wx:else>
          <view class="rating-section">
            <text class="section-label">评分</text>
            <view class="rating-stars">
              <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star">
                <text
                  class="star {{rating >= star ? 'active' : ''}}"
                  bindtap="selectRating"
                  data-rating="{{star}}"
                  hover-class="star-press"
                  hover-stay-time="80"
                >★</text>
              </block>
            </view>
            <text class="rating-hint {{rating > 0 ? '' : 'is-idle'}}">
              {{rating === 5 ? '很喜欢' : rating === 4 ? '满意' : rating === 3 ? '还行' : rating === 2 ? '有些失望' : rating === 1 ? '不太满意' : '点星星打分'}}
            </text>
          </view>

          <view class="content-section">
            <text class="section-label">感受</text>
            <textarea
              class="content-input"
              placeholder="颜色、质感、摆放位置……写给同样喜欢它的人听。"
              placeholder-class="input-placeholder"
              value="{{content}}"
              bindinput="onContentInput"
              maxlength="500"
              show-confirm-bar="{{false}}"
            ></textarea>
            <!-- 2026-11-23：常用说法，点一下接到正文后面（不替换已写的） -->
            <scroll-view class="phrase-scroll" scroll-x enable-flex="true" show-scrollbar="{{false}}">
              <view class="phrase-row">
                <text class="phrase" wx:for="{{phrases}}" wx:key="*this" data-text="{{item}}" bindtap="onPhrase" hover-class="tap-press-soft" hover-stay-time="80">{{item}}</text>
              </view>
            </scroll-view>
            <text class="char-count">{{content.length}}/500</text>
          </view>

          <view class="image-section">
            <view class="section-head">
              <text class="section-label">图片（可选）</text>
              <text class="section-count">{{images.length}}/3</text>
            </view>
            <view class="image-upload">
              <view class="image-list">
                <block wx:for="{{images}}" wx:key="*this" wx:for-index="index">
                  <view class="image-item">
                    <shan-img ext-class="uploaded-image" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}" />
                    <view hover-class="tap-press" hover-stay-time="80" class="delete-btn" catchtap="deleteImage" data-index="{{index}}">×</view>
                  </view>
                </block>
                <view class="upload-btn" wx:if="{{images.length < 3}}" bindtap="chooseImage" hover-class="tap-press-soft" hover-stay-time="80">
                  <text class="upload-icon">+</text>
                  <text class="upload-text">添加</text>
                </view>
              </view>
            </view>
          </view>

          <view class="bottom-spacer"></view>
        </block>
      </block>
    </view>
  </scroll-view>

  <!-- 发布条（2026-11-23 产品负责人截图「特别是下方的发布 button」）：
       原用 <button>，微信内置 `button:not([size=mini]) { width: 184px; margin: 0 auto }` 的优先级高于 .submit-btn，
       真机上宽度被压成 184px、贴左。改为 view；上方一行说明还差什么，未就绪时按钮淡显但仍可点（点了按原逻辑提示）。 -->
  <view class="submit-section safe-area" wx:if="{{canReview && !loadingGate}}">
    <text class="submit-hint {{ss.ready(rating, content) ? 'is-ready' : ''}}">{{ss.hint(rating, content, images.length)}}</text>
    <view
      class="submit-btn {{ss.ready(rating, content) ? '' : 'is-wait'}} {{submitting ? 'is-busy' : ''}}"
      bindtap="submitComment"
      hover-class="{{submitting ? '' : 'submit-btn-press'}}"
      hover-stay-time="80"
      aria-role="button"
      aria-label="发布评价"
    >
      <text>{{submitting ? '发布中…' : '发布评价'}}</text>
    </view>
  </view>
</view>
