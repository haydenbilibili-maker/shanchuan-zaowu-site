/* subpackages/feature/collection/detail/detail.wxss */
/* 引入全局变量 (假设 app.wxss 已定义) */

page {
  background-color: #1A1814; /* 全局深色背景 */
  color: #e0e0e0;
  font-family: var(--font-body);
}

/* 1. 自定义导航栏 */
.custom-nav {
  position: fixed; top: 0; left: 0; width: 100%; z-index: 100;
  /* background 由内联样式控制 */
}
.nav-content {
  display: flex; align-items: center; padding: 0 30rpx; position: relative;
}
.back-icon {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(0,0,0,0.3); backdrop-filter: blur(5px);
  display: flex; align-items: center; justify-content: center;
  border: 1px solid rgba(255,255,255,0.1);
}
.icon-arrow { color: #fff; font-size: var(--fs-32); font-weight: bold; padding-bottom: 4rpx; }
.nav-title {
  position: absolute; left: 0; right: 0; text-align: center;
  font-size: var(--fs-30); font-weight: bold; color: #fff; pointer-events: none;
  transition: opacity var(--dur-base) var(--ease-standard);
}

/* 2. 视差头部 */
.parallax-header {
  position: relative; width: 100%; height: 700rpx;
  overflow: hidden; /* 必须隐藏溢出，因为图片会放大 */
}
.header-bg {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  will-change: transform; /* 性能优化 */
}
.header-mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.4) 60%, #1A1814 100%);
}

.header-info {
  position: absolute; bottom: 60rpx; left: 40rpx; right: 40rpx;
  display: flex; flex-direction: column;
  z-index: 2;
}
.tags-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.tag { 
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  font-size: var(--fs-20); color: #C4A76C; background: rgba(196, 167, 108,0.15); 
  padding: 4rpx 12rpx; border-radius: var(--radius-sm); border: 1rpx solid rgba(196, 167, 108,0.3);
  white-space: nowrap;
  box-sizing: border-box;
}

.latin-name { 
  font-family: var(--font-latin); font-style: italic; 
  font-size: var(--fs-36); color: rgba(255,255,255,0.8); margin-bottom: 10rpx;
}
.cn-name { 
  font-size: 64rpx; font-weight: 900; color: #fff; margin-bottom: 20rpx; 
  text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.5);
}
.stats-row { 
  display: flex; 
  align-items: center; 
  gap: 20rpx; 
  font-size: var(--fs-24); 
  color: var(--color-text-secondary); 
  font-family: var(--font-mono); 
}
.stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}


/* 3. 内容主体 */
.content-body {
  position: relative; z-index: 3;
  background: #1A1814; /* 遮住 header 的底部 */
  padding: 0 40rpx;
  min-height: 1000rpx;
}

/* 富文本容器 */
.article-container {
  font-size: var(--fs-30); line-height: 1.8; color: var(--color-text-body);
  margin-bottom: 60rpx;
  text-align: justify;
}
/* 注意：rich-text 内部的 img 样式需在 HTML 字符串中内联，或通过 regex 处理 */

/* 知识画廊 */
.section-block { margin-bottom: 60rpx; }
.section-title { 
  font-size: var(--fs-24); color: var(--color-text-secondary); letter-spacing: 2rpx; margin-bottom: 30rpx; 
  border-left: 4rpx solid #C4A76C; padding-left: 16rpx; font-family: var(--font-mono); font-weight: bold;
}

.gallery-scroll { display: flex; white-space: nowrap; height: 240rpx; }
.gallery-item { 
  display: inline-block; width: 320rpx; height: 240rpx; margin-right: 20rpx; 
  border-radius: var(--radius-md); overflow: hidden; border: 1px solid #333;
}
.gallery-item image { width: 100%; height: 100%; }

/* 4. 关联商品 (玻璃拟态) */
.product-card-glass {
  display: flex; align-items: center; padding: 20rpx; margin-bottom: 24rpx;
  background: rgba(255,255,255,0.03); /* 极淡的白 */
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-md);
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.3);
}
.product-card-glass:active { background: rgba(255,255,255,0.06); }

/* 门控组件的定位参照（见 wxml 注释）。margin/flex-shrink 由图片移到盒上，保持 flex 行为不变。 */
.p-img-box { position: relative; width: 120rpx; height: 120rpx; margin-right: 24rpx; flex-shrink: 0; border-radius: var(--radius-sm); overflow: hidden; background: #111; }
.p-img { width: 100%; height: 100%; }
/* 2026-09-21 分子级审计：同 orders/index.wxss —— flex:1 缺 min-width:0 + 标题无截断 */
.p-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.p-name { font-size: var(--fs-28); font-weight: bold; color: var(--color-text-body); margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.p-price { font-size: var(--fs-32); color: #C4A76C; font-family: var(--font-mono); font-weight: bold; }
/* 加载中 / 加载失败状态（失败可重试，避免永久白屏） */
.cd-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx 120rpx;
}
.cd-state-title {
  font-size: var(--fs-32);
  color: var(--color-text-primary);
}
.cd-state-sub {
  margin-top: 16rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-secondary);
}
.cd-state-btn {
  margin-top: 40rpx;
  padding: 18rpx 56rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brass-400);
  font-size: var(--fs-26);
  color: var(--brass-400);
}
.cd-state-link {
  margin-top: 24rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

/* 行尾进入暗示：替代原实心「查看」胶囊 */
.p-chevron { flex-shrink: 0; margin-left: 16rpx; font-size: var(--fs-34); line-height: 1; color: var(--brass-300); }
