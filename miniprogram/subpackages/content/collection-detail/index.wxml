<!--subpackages/feature/collection/detail/detail.wxml-->
<wxs src="../../../utils/latinDisplay.wxs" module="latin" />
<view class="container">

<!-- 加载失败：给出可操作的重试入口（此前为永久白屏） -->
<view class="cd-state" wx:if="{{loadError}}">
  <text class="cd-state-title">内容加载失败</text>
  <text class="cd-state-sub">{{errorMsg || '请检查网络后重试'}}</text>
  <view class="cd-state-btn" bindtap="retryLoad" hover-class="cd-state-btn-press">重新加载</view>
  <text class="cd-state-link" bindtap="goBack" hover-class="cd-press" hover-stay-time="80">返回上一页</text>
</view>

<!-- 加载中 -->
<view class="cd-state" wx:if="{{isLoading && !loadError}}">
  <text class="cd-state-sub">正在加载…</text>
</view>

<block wx:if="{{!loadError && !isLoading}}">
<!-- 视差头部 (Parallax Header) -->
<view class="parallax-header">
  <!-- 背景图：绑定动态 transform -->
  <image class="header-bg" src="{{wiki.main_image}}" mode="aspectFill" style="{{parallaxStyle}}"></image>
  <view class="header-mask"></view> <!-- 渐变遮罩 -->
  
  <!-- 头部信息 (相对定位，随页面滚动) -->
  <view class="header-info">
    <view class="tags-row">
      <text class="tag" wx:for="{{wiki.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <text class="latin-name" wx:if="{{latin.display(wiki.latin_name)}}">{{latin.display(wiki.latin_name)}}</text>
    <text class="cn-name">{{wiki.cn_name}}</text>
    
    <view class="stats-row" wx:if="{{wiki.stats.views || wiki.stats.likes}}">
      <view class="stat-item">
        <image src="/assets/icons/eye.png" mode="aspectFit" class="icon-gold" style="width: 24rpx; height: 24rpx;"></image>
        <text>{{wiki.stats.views}} 阅读</text>
      </view>
      <view class="stat-item">
        <image src="/assets/icons/heart.png" mode="aspectFit" class="icon-gold" style="width: 24rpx; height: 24rpx;"></image>
        <text>{{wiki.stats.likes}} 收藏</text>
      </view>
    </view>
  </view>
</view>

<!-- 3. 正文内容区 (白色背景容器 / 或深色背景) -->
<view class="content-body">
  
<!-- A. 富文本文章 -->
<view class="article-container">
      <!-- 🟢 替换为 mp-html，支持更丰富的样式和交互 -->
      <mp-html 
        content="{{articleContent}}" 
        tag-style="{{tagStyle}}" 
        container-style="color:#ccc; font-size:15px; line-height:1.8;"
      />
    </view>

  <!-- B. 知识画廊 (横向滚动) -->
  <view class="section-block" wx:if="{{galleryImages.length > 0}}">
    <view class="section-title">VISUAL ARCHIVE / 影像档案</view>
    <scroll-view scroll-x class="gallery-scroll" enable-flex>
      <block wx:for="{{galleryImages}}" wx:key="*this">
        <view class="gallery-item" bindtap="previewGallery" data-src="{{item}}" hover-class="cd-press" hover-stay-time="80">
           <image src="{{item}}" mode="aspectFill"></image>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- C. 关联藏品 (玻璃拟态卡片) -->
  <view class="section-block" wx:if="{{relatedProducts.length > 0}}">
    <view class="section-title">RELATED COLLECTION / 馆藏关联</view>
    <block wx:for="{{relatedProducts}}" wx:key="_id">
      <view class="product-card-glass" bindtap="goToProduct" data-id="{{item._id}}" hover-class="cd-press" hover-stay-time="80">
        <!-- 需求 11：敏感形态模糊 -->
        <!-- ⚠️ 图盒必须自建且**已定位**（.p-img-box）：门控组件 :host 是 position:absolute，
             而 .product-card-glass 是 display:flex 且未定位 → 缺此盒封面会被裁掉。 -->
        <view class="p-img-box">
          <sensitive-blur-gate
            enabled="{{item.sensitiveEnabled}}"
            product-id="{{item._id}}"
            size="card"
          >
            <image class="p-img" src="{{item.image}}" mode="aspectFill"></image>
          </sensitive-blur-gate>
        </view>
        <view class="p-info">
          <text class="p-name">{{item.title}}</text>
          <text class="p-price" wx:if="{{item.price}}">¥{{item.price}}</text>
        </view>
        <view class="p-btn">查看</view>
      </view>
    </block>
  </view>

  <!-- 底部留白 -->
  <view style="height: 100rpx;"></view>

</view>

</block>
</view>