.page {
  min-height: 100vh;
  background: #1A1814;
  color: #D5D1C8;
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}

.title {
  flex: 1;
  text-align: center;
  font-size: var(--fs-30);
  font-weight: 500;
  color: #FFFFFF;
  padding-right: 64rpx;
}

.state-box {
  padding: 120rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.state-kicker {
  font-size: var(--fs-20);
  letter-spacing: 0.18em;
  color: #C4A76C;
  margin-bottom: 16rpx;
}

.state-title {
  font-size: var(--fs-36);
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.state-text {
  font-size: var(--fs-26);
  color: #A09A90;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.signal {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 8rpx 16rpx;
  border: 1px solid #4D401A;
  border-radius: var(--radius-sm);
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: #A09A90;
}

.signal-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C4A76C;
  animation: pulse 1.2s ease-in-out infinite;
}

.ghost-btn {
  padding: 16rpx 40rpx;
  border: 1rpx solid #C4A76C;
  border-radius: var(--radius-md);
  color: #C4A76C;
  font-size: var(--fs-26);
}

.player-wrap {
  position: relative;
  margin: 24rpx 24rpx 0;
  background: #1F1D1A;
  border: 1px solid #262320;
  border-radius: var(--radius-lg);
  overflow: hidden;
  height: 72vh;
}

.player {
  width: 100%;
  height: 100%;
}

.live-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 16rpx;
  background: rgba(26, 24, 20, 0.72);
  border: 1px solid #4D401A;
  border-radius: var(--radius-sm);
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: #A09A90;
  z-index: 2;
}

.live-badge.on { color: #C4A76C; }
.live-badge.dim { color: #6B6560; }

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #6B6560;
}

.live-badge.on .dot {
  background: var(--color-error);
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.stats-bar {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 12rpx;
  z-index: 2;
}

.stat {
  padding: 8rpx 14rpx;
  border-radius: var(--radius-sm);
  background: rgba(26, 24, 20, 0.72);
  border: 1px solid #4D401A;
  font-size: var(--fs-20);
  color: #C4A76C;
}

.stat.muted { color: #A09A90; }

.notice-bar {
  position: absolute;
  top: 88rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  padding: 14rpx 18rpx;
  background: rgba(26, 24, 20, 0.78);
  border: 1px solid #4D401A;
  border-radius: var(--radius-md);
  z-index: 2;
}

.notice-kicker {
  flex-shrink: 0;
  font-size: var(--fs-20);
  color: #C4A76C;
  letter-spacing: 0.08em;
}

.notice-text {
  flex: 1;
  font-size: var(--fs-22);
  color: #D5D1C8;
  line-height: 1.45;
}

.upcoming-cover {
  width: 240rpx;
  height: 240rpx;
  border-radius: var(--radius-md);
  border: 1px solid #4D401A;
  margin-bottom: 28rpx;
  background: #1F1D1A;
}

.share-btn {
  margin-top: 24rpx;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: transparent;
  border: 1rpx solid #C4A76C;
  border-radius: var(--radius-md);
  color: #C4A76C;
  font-size: var(--fs-26);
}

.share-btn::after { border: none; }

.msg-wall {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 220rpx;
  max-height: 200rpx;
  z-index: 2;
  pointer-events: none;
}

.msg-row {
  margin-bottom: 8rpx;
  padding: 8rpx 14rpx;
  background: rgba(26, 24, 20, 0.66);
  border-radius: var(--radius-sm);
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.msg-author {
  flex-shrink: 0;
  font-size: var(--fs-20);
  color: #C4A76C;
}

.msg-text {
  flex: 1;
  font-size: var(--fs-22);
  color: #D5D1C8;
  line-height: 1.4;
  word-break: break-all;
}

.msg-empty {
  font-size: var(--fs-20);
  color: #6B6560;
  padding: 8rpx 4rpx;
}

.composer {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 108rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  z-index: 3;
}

.composer-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  background: rgba(26, 24, 20, 0.85);
  border: 1px solid #4D401A;
  border-radius: var(--radius-md);
  color: #FFFFFF;
  font-size: var(--fs-24);
}

.composer-ph { color: #6B6560; }

.composer-send {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: #C4A76C;
  color: #1A1814;
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  font-weight: 500;
}

.composer-send.disabled { opacity: 0.5; }

.meta {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 168rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  z-index: 2;
  pointer-events: none;
}

.meta-title {
  font-size: var(--fs-32);
  color: #FFFFFF;
  font-weight: 500;
}

.meta-host {
  font-size: var(--fs-22);
  color: #A09A90;
}

.toolbar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  gap: 16rpx;
  z-index: 2;
}

.tool-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #C4A76C;
  color: #1A1814;
  border-radius: var(--radius-md);
  font-size: var(--fs-26);
  font-weight: 500;
}

.tool-btn.secondary {
  background: transparent;
  border: 1rpx solid #C4A76C;
  color: #C4A76C;
}

.tool-btn.secondary.done {
  border-color: #6B6560;
  color: #6B6560;
}

.share-plain {
  margin: 0;
  padding: 18rpx 0;
  line-height: 1.2;
  font-size: var(--fs-26);
  font-weight: 500;
  background: transparent;
  border: 1rpx solid #C4A76C;
  color: #C4A76C;
  border-radius: var(--radius-md);
}

.share-plain::after { border: none; }

.hint {
  padding: 24rpx 32rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  text-align: center;
}

.hint.warn { color: #E9A23B; }
.hint.err { color: #D64045; }

.shelf-fab {
  position: absolute;
  right: 24rpx;
  bottom: 200rpx;
  z-index: 4;
  min-width: 88rpx;
  padding: 12rpx 16rpx;
  background: rgba(26, 24, 20, 0.88);
  border: 1rpx solid #C4A76C;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.shelf-fab-label { font-size: var(--fs-20); color: #C4A76C; letter-spacing: 0.08em; }
.shelf-fab-count { font-size: var(--fs-24); color: #FFFFFF; font-weight: 500; }

.spotlight-chip {
  position: absolute;
  left: 24rpx;
  bottom: 200rpx;
  z-index: 4;
  max-width: 420rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 10rpx 14rpx;
  background: rgba(26, 24, 20, 0.88);
  border: 1px solid #4D401A;
  border-radius: var(--radius-md);
}
.spotlight-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  background: #262320;
  flex-shrink: 0;
}
.spotlight-body { min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.spotlight-kicker { font-size: var(--fs-18); color: #C4A76C; letter-spacing: 0.1em; }
.spotlight-title {
  font-size: var(--fs-22); color: #FFFFFF;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 280rpx;
}
.spotlight-price { font-size: var(--fs-20); color: #C4A76C; }

.shelf-mask {
  z-index: 40;
}
.shelf-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  max-height: 62vh;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
/* 抽屉形态 / 头部取 ui-pop-*（docs/弹层视觉规范_2026-10-13.md）；牌面内已有左右内边距，头部只留给 ✕ 的右侧 */
.shelf-sheet-hd { padding: 28rpx 96rpx 16rpx 0; }
.shelf-sheet-sub { color: #E9A23B; }
.shelf-list { height: 48vh; max-height: 48vh; min-height: 160rpx; width: 100%; box-sizing: border-box; }
.shelf-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px solid #262320;
}
.shelf-row.spot { border-color: #4D401A; }
.shelf-cover {
  width: 112rpx; height: 112rpx;
  border-radius: var(--radius-md);
  background: #262320;
  flex-shrink: 0;
}
.shelf-cover.ph,
.spotlight-cover.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-20);
  color: #6B6560;
}
.shelf-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.shelf-name {
  font-size: var(--fs-26); color: #FFFFFF;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.shelf-meta { font-size: var(--fs-20); color: #C4A76C; }
.shelf-meta.warn { color: #E9A23B; }
.shelf-price { font-size: var(--fs-26); color: #C4A76C; font-weight: 500; }
.shelf-actions { display: flex; flex-direction: column; gap: 10rpx; flex-shrink: 0; }
.shelf-btn {
  min-width: 112rpx;
  text-align: center;
  padding: 10rpx 0;
  border-radius: var(--radius-sm);
  font-size: var(--fs-22);
}
.shelf-btn.ghost { border: 1rpx solid #C4A76C; color: #C4A76C; }
.shelf-btn.solid { background: #C4A76C; color: #1A1814; font-weight: 500; }
.shelf-empty { padding: 48rpx 0; text-align: center; color: #6B6560; font-size: var(--fs-24); }

.ghost-btn.remind {
  margin-top: 20rpx;
  border-color: #8B6F47;
  color: #C4A76C;
}

.orient-tip {
  margin: 0 24rpx 12rpx;
  padding: 14rpx 20rpx;
  background: rgba(38, 35, 32, 0.95);
  border: 1px solid #4D401A;
  border-radius: var(--radius-md);
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: var(--fs-22);
  color: #A09A90;
  z-index: 5;
}
.orient-close { color: #C4A76C; flex-shrink: 0; }

.spotlight-chip.pulse {
  animation: spotlight-glow 1.8s ease-in-out infinite;
  border-color: #C4A76C;
}
.spotlight-chip.sold { opacity: 0.75; border-color: #6B6560; }
@keyframes spotlight-glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(196, 167, 108, 0.0); }
  50% { box-shadow: 0 0 0 6rpx rgba(196, 167, 108, 0.18); }
}

.shelf-mask { z-index: 60; }
.shelf-sheet { z-index: 61; }
.shelf-row.disabled-row { opacity: 0.55; }
.shelf-btn.disabled { opacity: 0.4; pointer-events: none; }
.shelf-row.spot {
  background: rgba(77, 64, 26, 0.35);
  border-radius: var(--radius-md);
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.state-box.replay { padding-top: 64rpx; }
.replay-cover {
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--radius-md);
  border: 1px solid #4D401A;
  margin-bottom: 28rpx;
  background: #1F1D1A;
}
.replay-badge {
  margin-bottom: 28rpx;
  padding: 8rpx 18rpx;
  border: 1px solid #4D401A;
  border-radius: var(--radius-sm);
  font-size: var(--fs-20);
  color: #8B6F47;
  letter-spacing: 0.06em;
}
.remind-hint {
  margin: 0 0 20rpx;
  font-size: var(--fs-22);
  color: #8B6F47;
  line-height: 1.5;
  max-width: 560rpx;
}
.ended-mini {
  margin-top: 40rpx;
  padding: 24rpx;
  width: 80%;
  max-width: 560rpx;
  background: #1F1D1A;
  border: 1px solid #262320;
  border-radius: var(--radius-md);
  text-align: left;
  box-sizing: border-box;
}
.ended-mini-kicker { display: block; font-size: var(--fs-20); color: #8B6F47; margin-bottom: 8rpx; }
.ended-mini-title { display: block; font-size: var(--fs-28); color: #FFFFFF; margin-bottom: 8rpx; }
.ended-mini-hint { display: block; font-size: var(--fs-22); color: #A09A90; }

.notice-bar.pin {
  border-color: #C4A76C;
  background: rgba(26, 24, 20, 0.88);
}
.notice-bar.pin .notice-kicker {
  letter-spacing: 0.08em;
}

.sku-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  max-height: 68vh;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.sku-product {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}
.sku-cover {
  width: 96rpx; height: 96rpx;
  border-radius: var(--radius-md);
  background: #262320;
  flex-shrink: 0;
}
.sku-info { min-width: 0; flex: 1; }
.sku-name {
  display: block;
  font-size: var(--fs-26); color: #FFFFFF;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.sku-price { font-size: var(--fs-26); color: #C4A76C; font-weight: 500; }
.sku-list { height: 36vh; max-height: 36vh; min-height: 120rpx; width: 100%; margin-bottom: 20rpx; box-sizing: border-box; }
.sku-pill {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border: 1px solid #4D401A;
  border-radius: var(--radius-md);
  color: #D5D1C8;
  font-size: var(--fs-24);
}
.sku-pill.active {
  border-color: #C4A76C;
  color: #C4A76C;
  background: rgba(77, 64, 26, 0.28);
}
.sku-pill.sold { opacity: 0.45; }
.sku-pill-meta { font-size: var(--fs-22); color: #A09A90; flex-shrink: 0; font-family: var(--font-mono); }  /* VIS3 纪律 05：金额等宽 */

.sku-confirm { display: block; flex: none; margin-top: 24rpx; }

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .signal-dot,
  .live-badge.on .dot,
  .spotlight-chip.pulse {
    animation: none;
  }
}
