page { background: #1A1814; color: #fff; }

.page-zone { min-height: 100vh; }

.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.03; z-index: 0;
}

.header {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 32rpx 24rpx;
  position: relative; z-index: 10;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.title {
  flex: 1; font-size: var(--fs-32); font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.content {
  height: calc(100vh - 120rpx);
  box-sizing: border-box;
}

.zone-hero {
  position: relative; height: 480rpx; margin-bottom: 32rpx;
}

.zone-swiper, .zone-hero-img { width: 100%; height: 100%; }

.zone-hero-mask {
  position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(to top, rgba(26,24,20,0.95) 0%, rgba(26,24,20,0.1) 60%);
}

.zone-hero-text {
  position: absolute; left: 32rpx; right: 32rpx; bottom: 32rpx; z-index: 2;
}

.swiper-count {
  display: block; font-size: var(--fs-20); color: #A09A90; margin-top: 8rpx;
}

.zone-head { padding: 0 32rpx 12rpx; }

.overline { display: block; font-size: var(--fs-22); letter-spacing: 0.1em; margin-bottom: 12rpx; }

.zone-title { display: block; font-size: var(--fs-40); font-weight: 600; margin-bottom: 12rpx; }

.store-name {
  display: block; font-size: var(--fs-24); color: #A09A90; margin: 0 32rpx 24rpx;
}

.desc {
  display: block; font-size: var(--fs-28); color: #D5D1C8; line-height: 1.65;
  padding: 0 32rpx;
}

.cta-wrap { padding: 48rpx 32rpx 64rpx; }

.btn-primary {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: var(--color-primary); color: #1A1814; border-radius: var(--radius-md); font-size: var(--fs-28); border: none;
}

.btn-primary::after { border: none; }

.section-label {
  display: block; font-size: var(--fs-20); color: #A09A90; letter-spacing: 0.12em;
  margin: 32rpx 32rpx 16rpx;
}

.long-desc-block { padding-bottom: 8rpx; }

.long-desc {
  display: block; font-size: var(--fs-28); color: #D5D1C8; line-height: 1.7;
  padding: 0 32rpx; max-height: 160rpx; overflow: hidden;
}

.long-desc.expanded { max-height: none; }

.long-desc-toggle {
  display: block; font-size: var(--fs-24); color: var(--color-primary);
  padding: 16rpx 32rpx 0;
}

.species-block { padding-bottom: 8rpx; }

.species-plate {
  margin: 0 32rpx 16rpx; padding: 20rpx 24rpx;
  background: rgba(250, 246, 237, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.25);
  border-radius: var(--radius-md);
}

.species-cn {
  display: block; font-size: var(--fs-28); font-weight: 600; color: var(--color-primary);
}

.species-latin {
  display: block; font-size: var(--fs-24); font-style: italic; font-family: var(--font-latin); color: #A09A90; margin-top: 6rpx;
}

.related-block { margin-bottom: 8rpx; }

.product-scroll {
  white-space: nowrap; padding-left: 32rpx; height: 320rpx;
}

.product-card {
  display: inline-flex; flex-direction: column; width: 220rpx;
  margin-right: 20rpx; vertical-align: top;
  background: #1F1D1A; border: 1rpx solid rgba(38, 35, 32, 0.8);
  border-radius: var(--radius-md); overflow: hidden;
}

/* 门控组件的定位参照（见 wxml 注释）。尺寸与原 .product-img 一致，避免布局变化。 */
.product-img-box { position: relative; width: 220rpx; height: 180rpx; overflow: hidden; }
.product-img { width: 100%; height: 100%; }

.product-body { padding: 12rpx 16rpx 16rpx; }

.product-title { font-size: var(--fs-24); color: #fff; display: block; }

.product-latin { font-size: var(--fs-20); color: #A09A90; display: block; margin-top: 4rpx; }

.product-price { font-size: var(--fs-22); color: var(--color-primary); margin-top: 8rpx; display: block; }

.wiki-row {
  display: flex; align-items: center; gap: 16rpx;
  margin: 0 32rpx 16rpx; padding: 16rpx;
  background: #1F1D1A; border-radius: var(--radius-md);
  border: 1rpx solid rgba(38, 35, 32, 0.6);
}

.wiki-thumb { width: 88rpx; height: 88rpx; border-radius: var(--radius-sm); flex-shrink: 0; }

.wiki-meta { flex: 1; min-width: 0; }

.wiki-title { font-size: var(--fs-26); color: #fff; display: block; }

.wiki-brief { font-size: var(--fs-22); color: #A09A90; display: block; margin-top: 4rpx; }

.wiki-arr { color: var(--color-primary); font-size: var(--fs-28); }

.text-cut {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
