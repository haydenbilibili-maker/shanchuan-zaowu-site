/* pages/store/index.wxss — Museum Mode · 极简博物柜 */
page {
  background: var(--color-bg);
  background-color: var(--color-bg);
  color: var(--color-text-primary, #FFFFFF);
  width: 100%;
  overflow-x: hidden;
}

.page-store {
  min-height: 100vh;
  position: relative;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  background-color: var(--color-bg);
}

.grain-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.03;
  z-index: 0;
  background-image: radial-gradient(rgba(196, 167, 108, 0.12) 0.5px, transparent 0.5px);
  background-size: 12rpx 12rpx;
}

@keyframes store-reveal {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes store-spin {
  to { transform: rotate(360deg); }
}

.is-entering { opacity: 0; }

.reveal { animation: store-reveal 0.26s ease both; }
.reveal-0 { animation-delay: 0s; }
.reveal-1 { animation-delay: 0.04s; }
.reveal-2 { animation-delay: 0.08s; }
.reveal-3 { animation-delay: 0.12s; }
.reveal-4 { animation-delay: 0.16s; }
.reveal-5 { animation-delay: 0.2s; }
.reveal-6 { animation-delay: 0.24s; }

@media (prefers-reduced-motion: reduce) {
  .is-entering { opacity: 1; }
  .reveal { animation: none; }
  .loading-pulse { animation: none; opacity: 0.7; }
  .picker-sheet,
  .lbs-sheet,
  .walking-body,
  .tips-list,
  .switcher-chevron,
  .checkin-dock {
    transition: none !important;
  }
}

/* —— 顶栏 —— */
.sticky-top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(26, 24, 20, 0.97);
  border-bottom: 1px solid var(--color-border-highlight, #4D401A);
}

.store-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2, 16rpx);
  padding: var(--space-2, 16rpx) var(--space-4, 32rpx);
}


.switcher-main { flex: 1; min-width: 0; }

.switcher-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 0.08em;
}

.switcher-name {
  display: block;
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 500;
  font-family: var(--font-brand, 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif);
  color: var(--color-text-primary, #FFFFFF);
}

.switcher-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-wood, #8B6F47);
}

.switcher-chevron {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  border-right: 2rpx solid var(--color-text-secondary, #A09A90);
  border-bottom: 2rpx solid var(--color-text-secondary, #A09A90);
  transform: rotate(45deg) translateY(-4rpx);
  transition: transform 0.22s ease;
}

.switcher-chevron.open {
  transform: rotate(225deg) translateY(-2rpx);
}

.store-pills {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  padding: 0 var(--space-4, 32rpx) var(--space-2, 16rpx);
}

.store-pill {
  position: relative;
  display: inline-flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-start;
  padding: 12rpx 20rpx 12rpx 22rpx;
  margin-right: var(--space-2, 16rpx);
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(77, 64, 26, 0.35);
  border-radius: var(--radius-sm, 8rpx);
  vertical-align: top;
}


.store-pill.active {
  border-color: var(--brass-400, #C4A76C);
  background: rgba(196, 167, 108, 0.06);
}

.pill-mark {
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 3rpx;
  background: var(--brass-400, #C4A76C);
  border-radius: 2rpx;
}

.pill-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-body, #D5D1C8);
}

.store-pill.active .pill-name {
  color: var(--color-text-primary, #FFFFFF);
}

.pill-loc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
}

.store-pill.active .pill-loc {
  color: var(--brass-400, #C4A76C);
}

/* —— 选店面板 —— */
/* 选门店：自顶部滑下的下拉面板（常驻节点 + open 类，进出都有过渡）；遮罩取 ui-pop-mask */
.picker-mask { z-index: 210; }

.picker-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 220;
  background: var(--pop-surface);
  border-bottom: 1rpx solid var(--pop-hairline);
  border-radius: 0 0 var(--pop-radius-sheet) var(--pop-radius-sheet);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.42);
  padding: 0 var(--pop-pad-x) 16rpx;
  transform: translateY(-100%);
  transition: transform var(--dur-base) var(--ease-out-soft);
}

.picker-sheet.open { transform: translateY(0); }

.picker-head {
  display: flex;
  flex-direction: column;
  padding: 28rpx 0 8rpx;
}

/* 门店行：发丝分隔，不做方框卡片 */
.picker-item {
  display: flex;
  align-items: center;
  gap: var(--space-3, 24rpx);
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--pop-divider);
}
.picker-item:last-child { border-bottom: none; }


.picker-item.active .picker-name { color: var(--brass-400, #C4A76C); }

.picker-thumb {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm, 8rpx);
  border: 1px solid rgba(77, 64, 26, 0.3);
}

.picker-body { flex: 1; min-width: 0; }

.picker-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
}

.picker-loc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
}

.picker-role {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.picker-current {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  top: 160rpx;
  bottom: 0;
}

/* —— 加载 / 空态 —— */
.loading-wrap,
.empty-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 280rpx var(--space-4, 32rpx);
  gap: var(--space-3, 24rpx);
  text-align: center;
}

.loading-pulse {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(196, 167, 108, 0.18);
  border-top-color: var(--brass-400, #C4A76C);
  animation: store-spin 0.8s linear infinite;
}

.loading-text,
.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.5;
}

.empty-block {
  padding: var(--space-5, 40rpx) var(--space-4, 32rpx);
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid var(--color-border, rgba(38, 35, 32, 0.4));
  border-radius: var(--radius-md, 16rpx);
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-body, #D5D1C8);
}

.empty-block .empty-desc { margin-top: 10rpx; }

.empty-retry {
  margin-top: var(--space-2, 16rpx);
  padding: 18rpx 40rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: var(--radius-md, 16rpx);
  color: var(--brass-400, #C4A76C);
  font-size: 26rpx;
}

.empty-retry-press { background: rgba(196, 167, 108, 0.06); }

/* —— Hero —— */
.hero {
  position: relative;
  height: 420rpx;
}


.hero-img,
.hero-placeholder {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  background: linear-gradient(160deg, var(--color-bg-elevated, #262320) 0%, var(--color-bg, #1A1814) 100%);
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(26, 24, 20, 1) 0%,
    rgba(26, 24, 20, 0.72) 36%,
    rgba(26, 24, 20, 0.18) 70%,
    rgba(26, 24, 20, 0.04) 100%
  );
}

.hero-closed-badge {
  position: absolute;
  top: var(--space-3, 24rpx);
  right: var(--space-4, 32rpx);
  z-index: 2;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: rgba(26, 24, 20, 0.72);
  border: 1px solid rgba(107, 101, 96, 0.4);
  font-size: 20rpx;
  color: var(--color-text-secondary, #A09A90);
}

.hero-text {
  position: absolute;
  left: var(--space-4, 32rpx);
  right: var(--space-4, 32rpx);
  bottom: var(--space-3, 24rpx);
}

.hero-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400, #C4A76C);
  letter-spacing: 0.12em;
}

.hero-title {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 600;
  font-family: var(--font-brand, 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif);
  color: var(--color-text-primary, #FFFFFF);
}

.hero-tagline {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.45;
}

.hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.hero-hours,
.hero-meta-sep {
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.status-label { font-size: 22rpx; }
.status-label.open { color: var(--color-success, #52B788); }
.status-label.closed { color: var(--color-text-secondary, #A09A90); }

.status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot.open { background: var(--color-success, #52B788); }
.status-dot.closed { background: var(--color-text-muted, #6B6560); }

/* —— 预约 —— */
.booking-row {
  padding: var(--space-3, 24rpx) var(--space-4, 32rpx) var(--space-4, 32rpx);
}

.booking-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: transparent;
  border: 1px solid var(--brass-400, #C4A76C);
  border-radius: var(--radius-md, 16rpx);
  color: var(--brass-400, #C4A76C);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.booking-btn-press {
  background: rgba(196, 167, 108, 0.08);
}

.booking-btn.disabled {
  border-color: rgba(107, 101, 96, 0.35);
  color: var(--color-text-muted, #6B6560);
}

.booking-closed-hint {
  display: block;
  margin-top: var(--space-2, 16rpx);
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.5;
}

/* —— 分区标题 —— */
.section {
  padding: 0 var(--space-4, 32rpx) var(--space-5, 40rpx);
}

.section-last { padding-bottom: var(--space-6, 48rpx); }

.visit-section { padding-bottom: var(--space-4, 32rpx); }

.section-head {
  margin-bottom: var(--space-3, 24rpx);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary, #FFFFFF);
  letter-spacing: 0.04em;
}

.section-lead {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-muted, #6B6560);
  line-height: 1.4;
}

/* —— 门店名片 —— */
.store-card {
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(77, 64, 26, 0.42);
  border-radius: var(--radius-lg, 24rpx);
  padding: var(--space-4, 32rpx) var(--space-3, 24rpx);
}

.store-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3, 24rpx);
  margin-bottom: var(--space-3, 24rpx);
}

.store-card-title-wrap { flex: 1; min-width: 0; }

.store-card-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  font-family: var(--font-brand, 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif);
  color: var(--color-text-primary, #FFFFFF);
}

.store-card-floor {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-wood, #8B6F47);
}

.status-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm, 8rpx);
  border: 1px solid var(--color-border, rgba(38, 35, 32, 0.4));
  background: var(--color-bg-elevated, #262320);
  font-size: 22rpx;
}

.status-chip.open { color: var(--color-success, #52B788); border-color: rgba(82, 183, 136, 0.3); }
.status-chip.closed { color: var(--color-text-secondary, #A09A90); }

.plate-intro-wrap { margin-bottom: var(--space-3, 24rpx); }

.plate-intro {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: 26rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.6;
}

.plate-intro.expanded {
  display: block;
  -webkit-line-clamp: unset;
}

.plate-intro-toggle {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.info-map-wrap {
  position: relative;
  height: 200rpx;
  margin-bottom: var(--space-3, 24rpx);
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
  border: 1px solid rgba(77, 64, 26, 0.35);
}

.info-map-press { border-color: rgba(196, 167, 108, 0.45); }

.info-map { width: 100%; height: 100%; }

.info-map-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 16rpx 20rpx;
  background: linear-gradient(to top, rgba(26, 24, 20, 0.45) 0%, transparent 55%);
}

.info-map-cta {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  padding: 6rpx 16rpx;
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-sm, 8rpx);
  background: rgba(26, 24, 20, 0.72);
}

.store-facts {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.fact-row {
  display: flex;
  align-items: center;
  gap: var(--space-2, 16rpx);
  padding: 20rpx;
  background: var(--color-bg-elevated, #262320);
  border: 1px solid var(--color-border, rgba(38, 35, 32, 0.4));
  border-radius: var(--radius-sm, 8rpx);
}

.fact-row-press {
  border-color: rgba(196, 167, 108, 0.28);
  background: rgba(196, 167, 108, 0.04);
}

.fact-main { flex: 1; min-width: 0; }

.fact-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 0.04em;
}

.fact-val {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.45;
}

.fact-val-accent { color: var(--brass-400, #C4A76C); }

.fact-action {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.fact-split {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.fact-half { min-height: 96rpx; align-items: flex-start; }

.visit-tips {
  margin-top: var(--space-3, 24rpx);
  padding-top: var(--space-2, 16rpx);
  border-top: 1px solid var(--color-border, rgba(38, 35, 32, 0.4));
}

.tips-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}


.tips-label {
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.tips-toggle-text {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.tips-list {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.26s ease, opacity 0.22s ease;
}

.tips-list.open {
  max-height: 640rpx;
  opacity: 1;
}

.tips-item { padding: 8rpx 0; }

.tips-text {
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.55;
}

.feature-line {
  margin-top: var(--space-3, 24rpx);
  padding-top: var(--space-2, 16rpx);
  border-top: 1px solid var(--color-border, rgba(38, 35, 32, 0.4));
}

.feature-text {
  font-size: 22rpx;
  color: var(--color-wood, #8B6F47);
  line-height: 1.5;
}

.web-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-3, 24rpx);
  padding-top: var(--space-2, 16rpx);
  border-top: 1px solid var(--color-border, rgba(38, 35, 32, 0.4));
}


.web-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
}

.web-val {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--color-text-body, #D5D1C8);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* —— 签到（位置保持第一轮） —— */
.checkin-inline {
  margin-top: var(--space-3, 24rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 92rpx;
  padding: 20rpx var(--space-4, 32rpx);
  background: var(--brass-400, #C4A76C);
  border: 1px solid var(--brass-400, #C4A76C);
  border-radius: var(--radius-md, 16rpx);
}

.checkin-inline-press {
  background: var(--brass-500, #A8903C);
  border-color: var(--brass-500, #A8903C);
}

.checkin-inline.loading { opacity: 0.72; }

.checkin-inline.done {
  background: var(--color-bg-elevated, #262320);
  border-color: rgba(196, 167, 108, 0.35);
}

.checkin-inline-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-bg, #1A1814);
  letter-spacing: 0.04em;
}

.checkin-inline.done .checkin-inline-label {
  color: var(--brass-400, #C4A76C);
}

.checkin-inline-hint {
  font-size: 20rpx;
  color: rgba(26, 24, 20, 0.55);
}

.checkin-inline.done .checkin-inline-hint {
  color: var(--color-text-muted, #6B6560);
}

.scroll-pad {
  height: calc(160rpx + var(--tabbar-offset, 0px));
}

.checkin-dock {
  position: fixed;
  left: var(--space-4, 32rpx);
  right: var(--space-4, 32rpx);
  bottom: calc(16rpx + var(--tabbar-offset, 0px));
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 92rpx;
  padding: 16rpx 28rpx;
  background: var(--brass-400, #C4A76C);
  border: 1px solid var(--brass-400, #C4A76C);
  border-radius: var(--radius-md, 16rpx);
  opacity: 0;
  pointer-events: none;
  transform: translateY(10rpx);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.checkin-dock.show {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.checkin-dock.loading { opacity: 0.72; }

.checkin-dock.done {
  background: var(--color-bg-elevated, #262320);
  border-color: rgba(196, 167, 108, 0.4);
}

.checkin-dock-press {
  background: var(--brass-500, #A8903C);
  border-color: var(--brass-500, #A8903C);
}

.checkin-dock-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-bg, #1A1814);
  letter-spacing: 0.04em;
}

.checkin-dock.done .checkin-dock-label {
  color: var(--brass-400, #C4A76C);
}

.checkin-dock-store {
  font-size: 20rpx;
  color: rgba(26, 24, 20, 0.55);
}

.checkin-dock.done .checkin-dock-store {
  color: var(--color-text-muted, #6B6560);
}

/* —— 展陈 —— */
.zone-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-2, 16rpx);
}

.zone-card {
  position: relative;
  overflow: hidden;
  min-height: 260rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(77, 64, 26, 0.32);
  border-radius: var(--radius-md, 16rpx);
}

.zone-card-press {
  border-color: rgba(196, 167, 108, 0.4);
  opacity: 0.96;
}

.zone-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.zone-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(26, 24, 20, 0.94) 0%,
    rgba(26, 24, 20, 0.5) 48%,
    rgba(26, 24, 20, 0.12) 100%
  );
}

.zone-content {
  position: relative;
  z-index: 1;
  min-height: 260rpx;
  padding: var(--space-3, 24rpx);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.zone-overline {
  display: block;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  letter-spacing: 0.1em;
  font-weight: 500;
}

.zone-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
}

.zone-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: 22rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.45;
}

/* —— 体验 —— */
.exp-scroll {
  width: 100%;
  box-sizing: border-box;
}

.exp-track {
  display: inline-flex;
  gap: var(--space-2, 16rpx);
  padding-right: 8rpx;
}

.exp-card {
  display: inline-flex;
  flex-direction: column;
  width: 236rpx;
  flex-shrink: 0;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(77, 64, 26, 0.35);
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
}

.exp-card-hover {
  border-color: rgba(196, 167, 108, 0.4);
  opacity: 0.96;
}

.exp-img {
  width: 236rpx;
  height: 236rpx;
  background: var(--color-bg-elevated, #262320);
}

.exp-body { padding: 14rpx 16rpx 18rpx; }

.exp-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-primary, #FFFFFF);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exp-latin {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  font-style: italic;
  font-family: Georgia, 'Times New Roman', serif;
  color: var(--color-text-latin, #C4A76C);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exp-price {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-family: var(--font-mono, 'JetBrains Mono', 'DM Mono', monospace);
  color: var(--color-text-body, #D5D1C8);
}

.exp-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 300rpx;
  font-size: 24rpx;
  color: var(--color-text-muted, #6B6560);
}

/* —— 列表（活动 / 服务） —— */
.list-block {
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(77, 64, 26, 0.32);
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2, 16rpx);
  padding: 26rpx 24rpx;
  border-bottom: 1px solid var(--color-border, rgba(38, 35, 32, 0.4));
}

.list-row:last-child { border-bottom: none; }

.list-row-press { background: rgba(196, 167, 108, 0.04); }

.list-main { flex: 1; min-width: 0; }

.list-tag {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: var(--brass-400, #C4A76C);
}

.list-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary, #FFFFFF);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-title-solo {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-body, #D5D1C8);
}

.list-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}

.list-arr {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
}

/* —— 双店动线 —— */
.walking-plate {
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(77, 64, 26, 0.36);
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
}

.walking-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3, 24rpx);
  padding: 26rpx 24rpx;
}

.walking-head-press { background: rgba(196, 167, 108, 0.04); }

.walking-head-main { flex: 1; min-width: 0; }

.walking-headline {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary, #FFFFFF);
}

.walking-peer {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.walking-toggle-text {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
}

.walking-body {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  padding: 0 24rpx;
  border-top: 1px solid transparent;
  transition: max-height 0.28s ease, opacity 0.24s ease, padding 0.28s ease, border-color 0.24s ease;
}

.walking-body.open {
  max-height: 960rpx;
  opacity: 1;
  padding: 8rpx 24rpx 28rpx;
  border-top-color: var(--color-border, rgba(38, 35, 32, 0.4));
}

.walking-step {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 0;
}

.walking-step-num {
  width: 28rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  font-family: var(--font-mono, 'JetBrains Mono', 'DM Mono', monospace);
}

.walking-step-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.55;
}

.walking-tip {
  display: block;
  padding: 8rpx 0 20rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.5;
}

.walking-peer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: var(--radius-md, 16rpx);
  color: var(--brass-400, #C4A76C);
  font-size: 26rpx;
}

.walking-peer-btn-hover {
  background: rgba(196, 167, 108, 0.06);
}

/* —— LBS —— */
/* 附近门店：浮在底栏上的提示卡（常驻节点 + open 类）；遮罩取 ui-pop-mask */
.lbs-mask { z-index: 200; }

.lbs-sheet {
  position: fixed;
  left: var(--space-4, 32rpx);
  right: var(--space-4, 32rpx);
  bottom: calc(16rpx + var(--tabbar-offset, 0px));
  z-index: 201;
  padding: 40rpx var(--pop-pad-x) 32rpx;
  background: var(--pop-surface);
  border: 1rpx solid var(--pop-hairline);
  border-radius: var(--pop-radius-dialog);
  box-shadow: var(--pop-shadow-dialog);
  transform: translateY(20rpx);
  opacity: 0;
  pointer-events: none;
  transition: transform var(--dur-base) var(--ease-out-soft), opacity var(--dur-base) var(--ease-standard);
}

.lbs-sheet.open {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.lbs-title { display: block; }

.lbs-store-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  font-family: var(--font-brand, 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif);
  color: var(--color-text-primary, #FFFFFF);
}

.lbs-meta {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
}

.lbs-desc {
  display: block;
  margin-bottom: 28rpx;
  font-size: 26rpx;
  color: var(--color-text-body, #D5D1C8);
}

.lbs-actions {
  display: flex;
  gap: var(--space-3, 24rpx);
}

