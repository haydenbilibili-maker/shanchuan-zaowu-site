/* 门店 · 到店指南（2026-10-17 重构）
   顶栏一行 + 下划线店签；Hero 实拍 + 眉标 / 宋体店名；本屏唯一实心金 = 预约参观；
   地图独立成图版，门店名片 = 浅纸标本签（铜钉 + 内发丝框 + 墨色发丝线事实行）；
   「我已到店」金线环；展陈 / 体验图注落到图下；活动 / 服务 / 动线为发丝线行。数据、签到、LBS、选店不变。 */
page {
  background: #1A1814;
  color: var(--color-text-primary, #FFFFFF);
  width: 100%;
  overflow-x: hidden;
}

.page-store {
  min-height: 100vh;
  position: relative;
  width: 100%;
  overflow-x: hidden;
  background: #1A1814;
}

@keyframes store-reveal {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes store-spin {
  to { transform: rotate(360deg); }
}

.is-entering { opacity: 0; }

.reveal { animation: store-reveal 0.26s ease both; }
.reveal-0 { animation-delay: 0s; }
.reveal-1 { animation-delay: 0.04s; }
.reveal-2 { animation-delay: 0.08s; }
.reveal-3 { animation-delay: 0.12s; }
.reveal-4 { animation-delay: 0.16s; }
.reveal-5 { animation-delay: 0.2s; }
.reveal-6 { animation-delay: 0.24s; }

@media (prefers-reduced-motion: reduce) {
  .is-entering { opacity: 1; }
  .reveal { animation: none; }
  .loading-pulse { animation: none; opacity: 0.7; }
  .picker-sheet,
  .lbs-sheet,
  .walking-body,
  .tips-list,
  .switcher-chevron,
  .checkin-dock {
    transition: none !important;
  }
}

/* —— 顶栏：一行店名 + 下划线店签 —— */
.sticky-top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(26, 24, 20, 0.97);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.store-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 32rpx 14rpx;
}

.switcher-main { flex: 1; min-width: 0; }

.switcher-label {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.switcher-name {
  display: inline;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
}

.switcher-sub {
  display: inline;
  margin-left: 16rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.switcher-chevron {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  border-right: 2rpx solid var(--brass-300);
  border-bottom: 2rpx solid var(--brass-300);
  transform: rotate(45deg) translateY(-4rpx);
  transition: transform var(--dur-base) var(--ease-standard);
}

.switcher-chevron.open { transform: rotate(225deg) translateY(-2rpx); }

/* 店签：下划线页签（选中 = 金线 + 暖白字） */
.store-pills {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  padding: 0 32rpx;
}

.store-pill {
  display: inline-flex;
  align-items: baseline;
  gap: 10rpx;
  margin-right: 40rpx;
  padding: 10rpx 0 14rpx;
  border-bottom: 3rpx solid transparent;
  vertical-align: top;
}

.store-pill.active { border-bottom-color: var(--brass-400); }

.pill-name {
  font-size: var(--fs-26);
  color: var(--color-text-secondary, #A09A90);
}

.store-pill.active .pill-name { color: #F3ECDD; font-weight: 500; }

.pill-loc {
  font-size: var(--fs-20);
  color: rgba(160, 154, 144, 0.8);
}

.store-pill.active .pill-loc { color: var(--brass-300); }

/* —— 选店面板 —— */
/* 选门店：自顶部滑下的下拉面板（常驻节点 + open 类，进出都有过渡）；遮罩取 ui-pop-mask */
.picker-mask { z-index: 210; }

.picker-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 220;
  background: var(--pop-surface);
  border-bottom: 1rpx solid var(--pop-hairline);
  border-radius: 0 0 var(--pop-radius-sheet) var(--pop-radius-sheet);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.42);
  padding: 0 var(--pop-pad-x) 16rpx;
  transform: translateY(-100%);
  transition: transform var(--dur-base) var(--ease-out-soft);
}

.picker-sheet.open { transform: translateY(0); }

.picker-head {
  display: flex;
  flex-direction: column;
  padding: 28rpx 0 8rpx;
}

/* 门店行：发丝分隔，不做方框卡片 */
.picker-item {
  display: flex;
  align-items: center;
  gap: var(--space-3, 24rpx);
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--pop-divider);
}
.picker-item:last-child { border-bottom: none; }


.picker-item.active .picker-name { color: var(--brass-400, #C4A76C); }

.picker-thumb {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm, 8rpx);
  border: 1px solid rgba(77, 64, 26, 0.3);
}

.picker-body { flex: 1; min-width: 0; }

.picker-name {
  display: block;
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
}

.picker-loc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-24);
  color: var(--brass-400, #C4A76C);
}

.picker-role {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.picker-current {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
}

.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  top: 160rpx;
  bottom: 0;
}

/* —— 加载 / 空态 —— */
.loading-wrap,
.empty-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 280rpx var(--space-4, 32rpx);
  gap: var(--space-3, 24rpx);
  text-align: center;
}

.loading-pulse {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(196, 167, 108, 0.18);
  border-top-color: var(--brass-400, #C4A76C);
  animation: store-spin 0.8s linear infinite;
}

.loading-text,
.empty-desc {
  font-size: var(--fs-24);
  color: var(--color-text-muted, #6B6560);
  line-height: 1.5;
}

.empty-block {
  padding: 40rpx 32rpx;
  border: 1rpx dashed rgba(196, 167, 108, 0.28);
  border-radius: 4rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: var(--color-text-body, #D5D1C8);
}

.empty-block .empty-desc { margin-top: 10rpx; }

.empty-retry {
  margin-top: 16rpx;
  padding: 18rpx 40rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 4rpx;
  color: var(--brass-300);
  font-size: var(--fs-26);
}

.empty-retry-press { background: rgba(196, 167, 108, 0.06); }

/* —— Hero：实拍 + 眉标 / 宋体店名 —— */
.hero {
  position: relative;
  height: 460rpx;
}

.hero-img,
.hero-placeholder {
  width: 100%;
  height: 100%;
}

.hero-placeholder { background: linear-gradient(160deg, #262320 0%, #1A1814 100%); }

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, #1A1814 0%, rgba(26, 24, 20, 0.7) 38%, rgba(26, 24, 20, 0.12) 72%, rgba(26, 24, 20, 0) 100%);
}

.hero-closed-badge {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  z-index: 2;
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(243, 236, 221, 0.32);
  border-radius: 2rpx;
  background: rgba(26, 24, 20, 0.72);
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.hero-text {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 24rpx;
}

.hero-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-48);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.hero-tagline {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-26);
  line-height: 1.45;
  color: rgba(232, 223, 203, 0.86);
}

.hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.hero-hours,
.hero-meta-sep {
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

/* 营业状态：铜色 = 营业中，灰 = 店休（不用信号绿） */
.status-label { font-size: var(--fs-22); }
.status-label.open { color: var(--brass-300); }
.status-label.closed { color: var(--color-text-secondary, #A09A90); }

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot.open { background: #8B6F47; }
.status-dot.closed { background: rgba(46, 38, 24, 0.3); }

/* —— 预约：本屏唯一实心金 —— */
.booking-row { padding: 24rpx 32rpx 48rpx; }

.booking-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 4rpx;
  background: var(--brass-400);
  color: #1A1814;
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.16em;
}

.booking-btn-press { background: var(--brass-500, #A8903C); }

.booking-btn.disabled {
  background: transparent;
  border: 1rpx solid rgba(160, 154, 144, 0.35);
  color: var(--color-text-secondary, #A09A90);
  font-weight: 400;
}

.booking-closed-hint {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

/* —— 分区 —— */
.section { padding: 0 32rpx 56rpx; }
.section-last { padding-bottom: 48rpx; }
.visit-section { padding-bottom: 48rpx; }

/* —— 地图图版 —— */
.info-map-wrap {
  position: relative;
  height: 220rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: 4rpx;
}

.info-map-press { border-color: rgba(196, 167, 108, 0.6); }

.info-map { width: 100%; height: 100%; }

.info-map-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 16rpx 20rpx;
  background: linear-gradient(to top, rgba(26, 24, 20, 0.5) 0%, transparent 55%);
}

.info-map-cta {
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: 2rpx;
  background: rgba(26, 24, 20, 0.8);
  font-size: var(--fs-22);
  letter-spacing: 0.08em;
  color: var(--brass-300);
}

/* —— 门店名片：浅纸标本签 —— */
.store-card {
  position: relative;
  padding: 44rpx 36rpx 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.42);
  color: #2E2618;
}

.store-card::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.card-pin {
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border-radius: 50%;
  background: #B08D57;
}

.store-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.store-card-title-wrap { flex: 1; min-width: 0; }

.store-card-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: #8B6F47;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.store-card-name {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #2E2618;
}

.store-card-floor {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: #5A4E3A;
}

.status-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.28);
  border-radius: 2rpx;
  font-size: var(--fs-20);
  color: #5A4E3A;
}

.status-chip.open { color: #8B6F47; border-color: rgba(139, 111, 71, 0.5); }

.plate-intro-wrap { margin-bottom: 12rpx; }

.plate-intro {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: var(--fs-26);
  line-height: 1.65;
  color: #3D3424;
}

.plate-intro.expanded {
  display: block;
  -webkit-line-clamp: unset;
}

.plate-intro-toggle {
  display: inline-block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: #8B6F47;
}

/* 事实行：墨色发丝线两栏（标签 / 值 / 动作） */
.store-facts { border-top: 1rpx solid rgba(46, 38, 24, 0.18); }

.fact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(46, 38, 24, 0.12);
}

.fact-row-press { background: rgba(46, 38, 24, 0.04); }

.fact-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 24rpx;
}

.fact-label {
  flex-shrink: 0;
  width: 56rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.08em;
  color: #8A7F6C;
}

.fact-val {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-26);
  line-height: 1.5;
  color: #2E2618;
}

.fact-val-mono { font-family: var(--font-mono); letter-spacing: 0.02em; }

.fact-action {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: #8B6F47;
}

.visit-tips { margin-top: 8rpx; }

.tips-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}

.tips-label {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: #8B6F47;
}

.tips-toggle-text {
  font-size: var(--fs-22);
  color: #8B6F47;
}

.tips-list {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height var(--dur-base) var(--ease-standard), opacity var(--dur-base) var(--ease-standard);
}

.tips-list.open {
  max-height: 640rpx;
  opacity: 1;
}

.tips-item {
  position: relative;
  padding: 6rpx 0 6rpx 24rpx;
}

.tips-item::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 25rpx;
  width: 10rpx;
  height: 1rpx;
  background: #8B6F47;
}

.tips-text {
  font-size: var(--fs-24);
  line-height: 1.6;
  color: #5A4E3A;
}

.feature-line {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(46, 38, 24, 0.12);
}

.feature-text {
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: #8B6F47;
}

/* —— 签到：金线环（实心金让给预约） —— */
.checkin-inline {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 92rpx;
  padding: 18rpx 32rpx;
  border-radius: 4rpx;
  background: rgba(196, 167, 108, 0.06);
  box-shadow: var(--ring-brass);
}

.checkin-inline-press { background: rgba(196, 167, 108, 0.14); }
.checkin-inline.loading { opacity: 0.72; }

.checkin-inline.done {
  background: transparent;
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.3);
}

.checkin-inline-label {
  font-size: var(--fs-28);
  font-weight: 500;
  letter-spacing: 0.12em;
  color: var(--brass-200);
}

.checkin-inline.done .checkin-inline-label { color: var(--color-text-secondary, #A09A90); }

.checkin-inline-hint {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}

.scroll-pad { height: calc(160rpx + var(--tabbar-offset, 0px)); }

.checkin-dock {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(16rpx + var(--tabbar-offset, 0px));
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 92rpx;
  padding: 16rpx 28rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
  box-shadow: var(--ring-brass), 0 12rpx 32rpx rgba(0, 0, 0, 0.5);
  opacity: 0;
  pointer-events: none;
  transform: translateY(10rpx);
  transition: opacity var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
}

.checkin-dock.show {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.checkin-dock.loading { opacity: 0.72; }
.checkin-dock.done { box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.3), 0 12rpx 32rpx rgba(0, 0, 0, 0.5); }
.checkin-dock-press { background: rgba(46, 41, 33, 0.98); }

.checkin-dock-label {
  font-size: var(--fs-28);
  font-weight: 500;
  letter-spacing: 0.12em;
  color: var(--brass-200);
}

.checkin-dock.done .checkin-dock-label { color: var(--color-text-secondary, #A09A90); }

.checkin-dock-store {
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}

/* —— 展陈：图版 + 图下图注 —— */
.zone-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 36rpx 20rpx;
}

.zone-card-press { opacity: 0.86; }

.zone-plate {
  height: 240rpx;
  overflow: hidden;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: 4rpx;
  background: #1F1D1A;
}

.zone-bg { width: 100%; height: 100%; }

.zone-content { padding-top: 16rpx; }

.zone-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.zone-title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
}

.zone-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

/* —— 店内可体验：横排图版 —— */
.exp-scroll {
  width: 100%;
  box-sizing: border-box;
}

.exp-track {
  display: inline-flex;
  gap: 20rpx;
  padding-right: 8rpx;
}

.exp-card {
  display: inline-flex;
  flex-direction: column;
  width: 236rpx;
  flex-shrink: 0;
}

.exp-card-hover { opacity: 0.86; }

.exp-img {
  width: 236rpx;
  height: 236rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: 4rpx;
  box-sizing: border-box;
  background: #1F1D1A;
}

.exp-body { padding-top: 14rpx; }

.exp-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exp-latin {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-latin);
  font-style: italic;
  font-size: var(--fs-20);
  color: var(--color-text-latin, #C4A76C);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exp-price {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-24);
  color: var(--color-text-body, #D5D1C8);
}

.exp-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 300rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}

/* —— 列表（活动 / 服务）：发丝线行 —— */
.list-block { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.list-row-press { background: rgba(196, 167, 108, 0.04); }

.list-main { flex: 1; min-width: 0; }

.list-tag {
  display: block;
  margin-bottom: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.list-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-title-solo {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--color-text-body, #D5D1C8);
}

.list-meta {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.list-arr {
  flex-shrink: 0;
  font-size: var(--fs-24);
  color: var(--brass-300);
}

/* —— 双店动线：发丝线 + 编号步骤 —— */
.walking-plate {
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.walking-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 0;
}

.walking-head-press { background: rgba(196, 167, 108, 0.04); }

.walking-head-main { flex: 1; min-width: 0; }

.walking-headline {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  color: #F3ECDD;
}

.walking-peer {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--brass-300);
}

.walking-toggle-text {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--brass-300);
}

.walking-body {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height var(--dur-base) var(--ease-standard), opacity var(--dur-base) var(--ease-standard), padding var(--dur-base) var(--ease-standard);
}

.walking-body.open {
  max-height: 960rpx;
  opacity: 1;
  padding-bottom: 28rpx;
}

.walking-step {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 14rpx 0;
}

.walking-step-num {
  width: 40rpx;
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--brass-300);
}

.walking-step-text {
  flex: 1;
  font-size: var(--fs-26);
  line-height: 1.6;
  color: var(--color-text-body, #D5D1C8);
}

.walking-tip {
  display: block;
  padding: 8rpx 0 24rpx 60rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

.walking-peer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.45);
  font-size: var(--fs-26);
  letter-spacing: 0.08em;
  color: var(--brass-300);
}

.walking-peer-btn-hover { background: rgba(196, 167, 108, 0.06); }

/* —— LBS —— */
/* 附近门店：浮在底栏上的提示卡（常驻节点 + open 类）；遮罩取 ui-pop-mask */
.lbs-mask { z-index: 200; }

.lbs-sheet {
  position: fixed;
  left: var(--space-4, 32rpx);
  right: var(--space-4, 32rpx);
  bottom: calc(16rpx + var(--tabbar-offset, 0px));
  z-index: 201;
  padding: 40rpx var(--pop-pad-x) 32rpx;
  background: var(--pop-surface);
  border: 1rpx solid var(--pop-hairline);
  border-radius: var(--pop-radius-dialog);
  box-shadow: var(--pop-shadow-dialog);
  transform: translateY(20rpx);
  opacity: 0;
  pointer-events: none;
  transition: transform var(--dur-base) var(--ease-out-soft), opacity var(--dur-base) var(--ease-standard);
}

.lbs-sheet.open {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.lbs-title { display: block; }

.lbs-store-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: var(--fs-34);
  font-weight: 600;
  font-family: var(--font-brand, 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif);
  color: var(--color-text-primary, #FFFFFF);
}

.lbs-meta {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--fs-24);
  color: var(--brass-400, #C4A76C);
}

.lbs-desc {
  display: block;
  margin-bottom: 28rpx;
  font-size: var(--fs-26);
  color: var(--color-text-body, #D5D1C8);
}

.lbs-actions {
  display: flex;
  gap: var(--space-3, 24rpx);
}

