<!-- 钱包枢纽：顶部 hub 条（唯一来源）+ 按 tab 渲染面板 -->
<view class="hub-page">
  <!-- 吸顶一层沿用原各页的 .hub-bar-bleed；宿主没有横向内缩，故不再需要负边距补偿 -->
  <view class="hub-bar-sticky">
    <wallet-hub-bar
      inline="{{true}}"
      active="{{curTab}}"
      title="{{barTitle}}"
      overline="{{barOverline}}"
      coupon-count="{{couponCount}}"
      bind:tabchange="onTabChange"
    ></wallet-hub-bar>
  </view>

  <!-- 面板区占满剩余高度：礼券夹的空态靠 .empty{flex:1} 垂直居中，需要这一层给出确定高度 -->
  <view class="hub-panel">
    <wallet-panel-points wx:if="{{curTab === 'points'}}" id="panel-points"></wallet-panel-points>
    <wallet-panel-coupons
      wx:if="{{curTab === 'coupons'}}"
      id="panel-coupons"
      from="{{from}}"
      bind:couponcount="onCouponCount"
    ></wallet-panel-coupons>
    <wallet-panel-wallet
      wx:if="{{curTab === 'wallet'}}"
      id="panel-wallet"
      bind:couponcount="onCouponCount"
    ></wallet-panel-wallet>
  </view>
</view>
