/* 售后/退款申请 — Museum Mode */

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 96rpx;
  box-sizing: border-box;
  background: var(--color-bg, #1A1814);
}

.fade-in {
  animation: fadeIn 0.35s ease both;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: none; }
}

.hero {
  padding: 20rpx 8rpx 28rpx;
}
.hero-rule {
  width: 48rpx;
  height: 4rpx;
  background: var(--brass-400, #C4A76C);
  margin-bottom: 24rpx;
  border-radius: 2rpx;
}
.hero-en {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: var(--brass-600, #8A7530);
  font-weight: 500;
}
.hero-cn {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.25;
  color: var(--color-text-primary, #FFFFFF);
  font-family: var(--font-brand);
  font-weight: 600;
}
.hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-text-secondary, #A09A90);
}

.panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid var(--color-border, #26232066);
  border-radius: var(--radius-lg, 24rpx);
  box-sizing: border-box;
}
.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.panel-title {
  font-size: 30rpx;
  color: var(--color-text-primary, #FFFFFF);
  font-weight: 500;
}
.panel-req {
  font-size: 22rpx;
  color: var(--color-error, #D64045);
  letter-spacing: 0.04em;
}
.panel-opt {
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
}
.panel-hint {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary, #A09A90);
}

.order-row,
.policy-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 12rpx;
}
.order-row:last-child,
.policy-row:last-child {
  margin-bottom: 0;
}
.order-label,
.policy-label {
  font-size: 24rpx;
  color: var(--color-text-muted, #6B6560);
  flex-shrink: 0;
}
.order-no,
.policy-val {
  font-size: 26rpx;
  color: var(--color-text-body, #D5D1C8);
  text-align: right;
  font-family: var(--font-mono, monospace);
}
.policy-val {
  font-family: var(--font-body);
}

.upload-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.upload-thumb {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
  border: 1rpx solid var(--brass-800, #4D401A);
}
.upload-thumb image {
  width: 100%;
  height: 100%;
}
.upload-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(26, 24, 20, 0.78);
  color: var(--color-text-body);
  font-size: 28rpx;
}
.upload-add {
  width: 168rpx;
  height: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: var(--color-bg-elevated, #262320);
  border: 1rpx dashed var(--brass-700, #6B5A24);
  border-radius: var(--radius-md, 16rpx);
  box-sizing: border-box;
}
.video-add {
  width: 100%;
  height: 200rpx;
}
.upload-plus {
  font-size: 40rpx;
  color: var(--brass-400, #C4A76C);
  line-height: 1;
}
.upload-label {
  font-size: 22rpx;
  color: var(--color-text-secondary, #A09A90);
}
.upload-sub {
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
  margin-top: 4rpx;
}
.thumb-press {
  opacity: 0.85;
  transform: scale(0.98);
}

.video-box {
  border-radius: var(--radius-md, 16rpx);
  overflow: hidden;
  border: 1rpx solid var(--brass-800, #4D401A);
  background: #151310;
}
.video-preview {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #151310;
}
.video-actions {
  display: flex;
  gap: 32rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg-elevated, #262320);
}
.link-btn {
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
}
.link-btn.danger {
  color: var(--color-error, #D64045);
}

.note-area {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid var(--color-border, #26232066);
  border-radius: var(--radius-md, 16rpx);
  color: var(--color-text-body, #D5D1C8);
  font-size: 28rpx;
  line-height: 1.5;
}
.note-ph {
  color: var(--color-text-muted, #6B6560);
}

.btn-submit {
  margin-top: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
  border-radius: var(--radius-md, 16rpx);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.btn-submit.is-loading {
  opacity: 0.7;
}
.btn-press {
  opacity: 0.9;
  transform: scale(0.98);
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  color: var(--color-text-secondary, #A09A90);
  font-size: 26rpx;
}
