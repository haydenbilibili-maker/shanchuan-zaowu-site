.coupon-card .val-box { color: #2E2618; }
.coupon-card .symbol,
.coupon-card .amount {
  color: #2E2618;
  text-shadow: 0 1rpx 0 rgba(255, 252, 244, 0.85), 0 -1rpx 0 rgba(46, 38, 24, 0.25);
}
.coupon-card .condition { color: #5E5444; }
.coupon-card.is-void .c-left { background-color: #2A2722; background-image: none; box-shadow: none; }
