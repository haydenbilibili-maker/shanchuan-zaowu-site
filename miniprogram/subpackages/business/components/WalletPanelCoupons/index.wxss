/* 我的券夹 · Museum Mode */
view, text { box-sizing: border-box; }


/* 组件宿主：铺满宿主页给面板的那块高度（否则 .empty{flex:1} 失去参照、空态不再垂直居中）。
   page{height:100%} 在组件里无效，故这层由 :host 承接。 */
:host {
  display: flex;
  flex-direction: column;
  flex: 1;
  width: 100%;
}

.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  /* 顶栏已移到宿主页（原来靠 .hub-bar-bleed 的 -40rpx 抵消这个上内边距）→ 归零，保持与原来同样的间距 */
  padding: 0 32rpx calc(80rpx + env(safe-area-inset-bottom));
  /* 券页原本 page{color:#D5D1C8}（app.wxss 全局是 #FFFFFF）；组件里该选择器无效，补在容器上 */
  color: #D5D1C8;
}

.header {
  text-align: center;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}
/* 2026-10-17 视觉对齐：页头 = 等宽眉标 + 宋体主标（原拉丁衬线大写金字） */
.title {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.header-cn {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.sub {
  font-size: var(--fs-22);
  color: #A09A90;
  margin-top: 10rpx;
  display: block;
  letter-spacing: 0.06em;
}
/* 临期提醒：只在真有 ≤7 天到期的券时出现 */
/* 临期提醒：只在真有 ≤7 天到期的券时出现（提醒色由警示橙收到暖金，仍只给临期） */
.sub-warn {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-20);
  color: var(--brass-200);
  letter-spacing: 0.04em;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.coupon-card {
  display: flex;
  min-height: 188rpx;
  background: #1F1D1A;
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
}

.c-left {
  width: 188rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108, 0.08);
  flex-shrink: 0;
}
.val-box {
  display: flex;
  align-items: baseline;
  color: var(--color-primary);
}
.symbol {
  font-size: var(--fs-26);
  font-weight: 700;
  margin-right: 2rpx;
}
.amount {
  font-size: var(--fs-48);
  font-weight: 700;
  font-family: var(--font-mono);
  line-height: 1;
  max-width: 168rpx;
  text-align: center;
}
.condition {
  font-size: var(--fs-20);
  color: #6B6560;
  margin-top: 12rpx;
}

.split-line { position: relative; width: 0; height: auto; align-self: stretch; }
.line {
  position: absolute;
  left: -1rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 0;
  border-left: 2rpx dashed #1A1814;
}
.circle {
  position: absolute;
  left: -10rpx;
  width: 20rpx;
  height: 20rpx;
  background: #1A1814;
  border-radius: 50%;
  z-index: 2;
}
.circle.top { top: -10rpx; }
.circle.bottom { bottom: -10rpx; }

.c-right {
  flex: 1;
  min-width: 0;
  padding: 28rpx 24rpx 28rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.c-name {
  font-size: var(--fs-28);
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.c-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}
.c-tag {
  font-size: var(--fs-18);
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  letter-spacing: 0.04em;
  border: 1rpx solid var(--brass-800);
  color: var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
}
.c-tag.store {
  border-color: rgba(45, 90, 63, 0.55);
  color: var(--color-success);
  background: rgba(45, 90, 63, 0.16);
}
.c-tag.online {
  border-color: var(--brass-800);
  color: #D4BC85;
  background: rgba(196, 167, 108, 0.08);
}
.c-tag.all {
  border-color: rgba(91, 143, 185, 0.45);
  color: var(--color-info-on-tint);
  background: rgba(91, 143, 185, 0.12);
}
.c-date {
  font-size: var(--fs-20);
  color: #6B6560;
  font-family: var(--font-mono);
}
/* 第二行：临期标与来源同属「状态」层级，放一起；第一行只留渠道 + 有效期 */
.c-sub-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.c-source {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-18);
  color: #8A7530;
  letter-spacing: 0.04em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  font-size: var(--fs-22);
  line-height: 1;
  color: var(--color-primary);
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.6);
  padding: 14rpx 22rpx;
  border-radius: 4rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}
.c-status.muted {
  background: #262320;
  /* 2026-09-21 分子级审计：#6B6560 在 #262320 上仅 2.72（AA 需 4.5）→ secondary（5.60） */
  color: var(--color-text-secondary);
}
.c-status.clickable:active {
  background: rgba(196, 167, 108, 0.14);
}
/* 主操作按钮：用 hover-class 而不是只靠 :active（部分机型 :active 不触发，点了没反馈） */
.c-status-press {
  background: rgba(196, 167, 108, 0.14);
}
/* 纪律 03「一屏一个主按钮」（2026-10-15）：三张券三颗实心金按钮叠成一列 → 只给临期券实心，其余描边 */
.coupon-card.is-soon .c-status {
  color: var(--color-bg);
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.coupon-card.is-soon .c-status-press,
.coupon-card.is-soon .c-status.clickable:active {
  background: var(--brass-500);
}

.texture {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(196, 167, 108, 0.35) 0.8px, transparent 0.8px);
  background-size: 18rpx 18rpx;
  opacity: 0.06;
  pointer-events: none;
}

.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx 120rpx;
  text-align: center;
}
.empty-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 520rpx;
}
.empty-overline {
  font-size: var(--fs-18);
  letter-spacing: 0.18em;
  color: #6B6560;
  margin-bottom: 16rpx;
}
.empty-title {
  font-size: var(--fs-30);
  color: #D5D1C8;
  line-height: 1.4;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: var(--fs-24);
  color: #A09A90;
  line-height: 1.5;
}
.go-btn {
  margin-top: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  padding: 18rpx 48rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-26);
  letter-spacing: 0.04em;
}
.go-btn:active { opacity: 0.82; }

/* —— 使用方式底栏 —— */
.sheet-mask {
  z-index: 1100;
}

.use-sheet {
  padding: 0 var(--pop-pad-x) 28rpx;
  box-sizing: border-box;
}
.sheet-coupon {
  display: block;
  text-align: center;
  margin: 10rpx 0 28rpx;
  font-size: var(--fs-22);
  color: var(--color-primary);
}
/* 两个渠道：发丝分隔行（不做方框卡片）；推荐渠道标题金色 */
.sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 112rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--pop-divider);
}
.sheet-option.primary .sheet-opt-title { color: var(--brass-400); }
.sheet-option-press {
  opacity: 0.88;
  background: #262320;
}
.sheet-opt-title {
  display: block;
  font-size: var(--fs-28);
  color: #FFFFFF;
  font-weight: 500;
}
.sheet-opt-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: #A09A90;
  line-height: 1.4;
}
.sheet-arrow {
  font-size: var(--fs-36);
  color: var(--color-primary);
  line-height: 1;
}
.sheet-cancel { display: block; flex: none; margin-top: 24rpx; }

/* —— 亮码弹层 —— */
.pass-mask {
  z-index: 1200;
  padding: calc(40rpx + env(safe-area-inset-top)) 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.pass-mask-blocker {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.pass-panel {
  z-index: 1;
  max-width: 600rpx;
  max-height: 100%;
  padding: 32rpx 28rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.pass-head {
  width: 100%;
  position: relative;
  margin-bottom: 20rpx;
}

.pass-coupon-tip {
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--brass-800);
  background: rgba(196, 167, 108, 0.1);
  box-sizing: border-box;
}
.pass-coupon-tip .signal-light {
  margin-top: 8rpx;
  width: 10rpx;
  height: 10rpx;
}

.pass-tip-copy {
  flex: 1;
  min-width: 0;
}
.pass-tip-main {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-primary);
  line-height: 1.4;
}
.pass-tip-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: #A09A90;
}

.pass-qr-stage {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 20rpx;
  background: #F2EDE4;
  border-radius: var(--radius-md);
  border: 1rpx solid #E0CFA3;
  box-sizing: border-box;
}
.pass-qr-frame {
  width: 300rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pass-qr-canvas {
  width: 300rpx;
  height: 300rpx;
}
.pass-qr-empty-wrap,
.pass-qr-empty {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #6B6560;
  font-size: var(--fs-24);
  padding: 24rpx;
}
.pass-qr-retry {
  margin-top: 16rpx;
  color: #8A7530;
  font-size: var(--fs-24);
  padding: 8rpx 16rpx;
}
.pass-qr-plate {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.pass-qr-id {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: #33302C;
  letter-spacing: 0.08em;
}
.pass-qr-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.pass-qr-meta .signal-light {
  width: 10rpx;
  height: 10rpx;
}
.pass-qr-timer {
  font-size: var(--fs-20);
  color: #6B6560;
  font-family: var(--font-mono);
}

.pass-foot {
  margin-top: 24rpx;
  font-size: var(--fs-20);
  color: #A09A90;
  text-align: center;
  letter-spacing: 0.04em;
}
.pass-foot.sub {
  margin-top: 8rpx;
  color: #6B6560;
}

/* —— 核销成功结果卡样式见 components/PassRedeemCard —— */
.pass-panel.is-redeemed {
  border-color: rgba(196, 167, 108, 0.6);
}

.pass-done-btn {
  margin-top: 28rpx;
  width: 100%;
  text-align: center;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: #1A1814;
  font-size: var(--fs-28);
  font-weight: 600;
  letter-spacing: 0.04em;
  box-sizing: border-box;
}

.pass-done-btn-press {
  background: #A8903C;
  opacity: 0.92;
}

.pass-qr-stage.is-spent {
  opacity: 0.42;
  filter: grayscale(0.35);
}

/* ── 需求 7：礼券夹分组（可用 / 占用中 / 已失效）+ 券包堆叠 + 打眼核销 ──
 *
 * 视觉口径：
 *   · 可用券 = 满血（金色描边 + 金色面额 + 实心金按钮）
 *   · 占用中 = 虚线描边（进行时，会回来，不降调、不盖戳）
 *   · 已失效 = 骑缝虚线换打眼孔 + 券面盖斜章 + 整体压到 .8（结束态，不抢注意力）
 *   · 失效券不再渲染状态胶囊 —— 章就是状态，两者并存会在券面右侧打成一片
 */

/* 小组抬头（使用中） */
.group-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 4rpx;
  margin-bottom: 16rpx;
}

.group-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.group-title {
  font-size: var(--fs-24);
  color: var(--color-primary);
  letter-spacing: 0.08em;
}

.group-sub {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.group-foot {
  display: block;
  margin-top: 14rpx;
  padding: 0 4rpx;
  font-size: var(--fs-20);
  line-height: 1.5;
  color: #5A544E;
}

.locked-block {
  margin-top: 34rpx;
}

/* 占用中：虚线描边 = 临时、会被收回 */
.coupon-card.is-locked {
  border-style: dashed;
  border-color: var(--brass-800);
}

/* 已失效：整体压调，但章要清晰可读（不做重度灰度，避免糊成一团） */
.coupon-card.is-void {
  opacity: 0.8;
  background: #1C1A17;
  border-color: #262320;
}

.coupon-card.is-void .c-left {
  background: rgba(196, 167, 108, 0.04);
}

.coupon-card.is-void .amount {
  color: #8A7530;
}

.coupon-card.is-void .c-name {
  color: #A09A90;
}

/* 临期券：只剩描边提示，按钮照常满血（还能用就别吓人） */
/* 临期券：暖金描边加一圈细环（原警示橙），按钮照常满血（还能用就别吓人） */
.coupon-card.is-soon {
  border-color: rgba(212, 188, 133, 0.7);
  box-shadow: 0 0 0 1rpx rgba(212, 188, 133, 0.35);
}

.c-hint {
  flex-shrink: 0;
  font-size: var(--fs-18);
  line-height: 1;
  padding: 6rpx 10rpx;
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.03);
}
/* 提醒色只留给真的临期：每张券都是橙色 = 没有一张显得急 */
/* 提醒色只留给真的临期：每张券都高亮 = 没有一张显得急 */
.coupon-card.is-soon .c-hint {
  color: var(--brass-200);
  border-color: rgba(212, 188, 133, 0.5);
  background: rgba(196, 167, 108, 0.12);
}

/* 骑缝打眼孔：沿骑缝均分的 7 个孔，孔 = 页面底色（真的像被打穿） */
.punch-line {
  position: absolute;
  left: -6rpx;
  top: 30rpx;
  bottom: 30rpx;
  width: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  z-index: 3;
}

.punch-hole {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #12100D;
  box-shadow: inset 0 2rpx 2rpx rgba(0, 0, 0, 0.55), 0 1rpx 0 rgba(196, 167, 108, 0.06);
}

/* 失效券的骑缝虚线让位给打眼孔 */
.coupon-card.is-void .line {
  opacity: 0.35;
}

/* 斜章：盖在券面右侧，与打孔缺口同一套「机械标记」语言 */
.void-stamp {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%) rotate(-11deg);
  padding: 8rpx 16rpx;
  font-size: var(--fs-24);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 4rpx;
  border: 2rpx dashed rgba(196, 167, 108, 0.5);
  border-radius: var(--radius-sm);
  color: rgba(196, 167, 108, 0.78);
  background: rgba(196, 167, 108, 0.05);
  pointer-events: none;
  z-index: 4;
}

.void-stamp.is-expired {
  /* 2026-09-21 分子级审计：原 fg rgba(160,154,144,.72) 叠在 4% 同色底上只有 3.78。
     改为不透明 fg + 不透明底（色相不变，观感几乎不变）→ 8.46。 */
  color: #C4BEB4;
  border-color: rgba(160, 154, 144, 0.4);
  background: #262320;
}

/* 让出章的位置：失效券的文字区右侧留白，避免日期被章压住 */
.coupon-card.is-void .c-right {
  padding-right: 168rpx;
}

/* 券包：把「已核销 / 已过期」收起来，避免与可用券混排抢注意力 */
.pouch {
  margin: 36rpx 0 8rpx;
}

.pouch-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  background: #1F1D1A;
  border: 1rpx solid #262320;
  border-radius: var(--radius-md);
  transition: border-color var(--dur-base) var(--ease-standard);
}

.pouch-head.is-open {
  border-color: #3A342A;
}

.pouch-head-press {
  background: #232120;
}

/* 券包堆叠：三张错位迷你券，最前一张带打眼 —— 一眼看出「这里压着一叠废券」 */
.pouch-stack {
  position: relative;
  width: 68rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.pouch-ticket {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 52rpx;
  height: 36rpx;
  box-sizing: border-box;
  border: 1rpx solid #3A342A;
  border-radius: var(--radius-sm);
  background: #2A2724;
  transform-origin: 50% 100%;
}

.pouch-ticket.t3 {
  transform: translate(8rpx, -12rpx) rotate(7deg);
  opacity: 0.5;
}

.pouch-ticket.t2 {
  transform: translate(4rpx, -6rpx) rotate(-4deg);
  opacity: 0.78;
}

/* 最前一张提亮一档：小尺寸下若和前两张同色，整叠会糊成一块 */
.pouch-ticket.t1 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border-color: #4A4232;
  background: #363128;
}

.pouch-hole {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #12100D;
}

.pouch-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.pouch-title {
  font-size: var(--fs-26);
  color: #D5D1C8;
  letter-spacing: 0.02em;
}

.pouch-sub {
  font-size: var(--fs-22);
  color: #6B6560;
}

/* 折叠箭头：CSS 折角（比字符箭头转动更可控），收起朝下 / 展开朝上 */
.pouch-arrow {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin-right: 6rpx;
  border-right: 2rpx solid #6B6560;
  border-bottom: 2rpx solid #6B6560;
  transform: rotate(45deg) translate(-4rpx, -4rpx);
  transition: transform var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard);
}

.pouch-arrow.open {
  transform: rotate(-135deg) translate(-4rpx, -4rpx);
  border-color: var(--color-primary);
}

.pouch-body {
  animation: pouch-in 0.26s ease both;
}

@keyframes pouch-in {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 展开后的失效券与可用券保持同一排版节奏 */
.pouch-list {
  margin-top: 22rpx;
}

.pouch-foot {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-20);
  letter-spacing: 0.04em;
  color: #4F4A45;
}

/* 无可券可用时的内联出口（避免页面只剩一个券包） */
.inline-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  background: #1F1D1A;
  border: 1rpx dashed #3A342A;
  border-radius: var(--radius-md);
}

.inline-cta-text {
  font-size: var(--fs-24);
  color: #A09A90;
}

.inline-cta-btn {
  flex-shrink: 0;
  font-size: var(--fs-24);
  color: var(--color-primary);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  padding: 12rpx 24rpx;
}

.inline-cta-btn-press {
  opacity: 0.82;
  background: #262320;
}

/* ==========================================================================
   材质真实化 v2（2026-10-18 产品负责人「礼券夹…纸质感的持续加强和真实化」）
   礼券夹 = 皮夹里插着纸券：券身保持深色（夹），面额存根换成米白纸券 —— 纤维 + 受光 + 凸印墨色面额；
   骑缝圆缺 / 虚线照旧（像撕口）。失效 / 占用的规则选择器更具体，仍按原样压调（选择器优先级保证，不另写）。
