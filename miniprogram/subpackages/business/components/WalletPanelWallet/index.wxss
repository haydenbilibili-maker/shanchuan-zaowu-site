@import './styles/user/user-account.wxss';
@import './wallet-leather.wxss';


.sv-wallet-hero {
  margin: 0 0 var(--space-4);
}

/* 卡面内骨架：深底黄铜微光，高度与正式行对齐，避免 Material 灰条 */
.wallet-leather-skel {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.08) 0%,
    rgba(212, 188, 133, 0.2) 46%,
    rgba(196, 167, 108, 0.08) 100%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

.wallet-leather-balance-skel {
  width: 248rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
}

.wallet-leather-member-skel {
  width: 320rpx;
  height: 22rpx;
}

.sv-recharge-lead {
  display: block;
  margin: -8rpx 0 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 档位网格 */
.sv-pkg-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.sv-pkg-tile {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24rpx 22rpx 22rpx;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-elevated);
  box-sizing: border-box;
  min-height: 188rpx;
}

.sv-pkg-tile.is-on {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.1);
}

.sv-pkg-press {
  opacity: 0.85;
}

.sv-pkg-tile-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 12rpx;
  gap: 8rpx;
}

.sv-pkg-level {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--brass-400);
}

.sv-pkg-points {
  font-size: 18rpx;
  color: var(--color-text-secondary);
}

.sv-pkg-amt-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.sv-pkg-tile-yen {
  font-size: 22rpx;
  color: var(--brass-400);
}

.sv-pkg-tile-amt {
  font-family: var(--font-mono);
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.1;
}

.sv-pkg-tile.is-on .sv-pkg-tile-amt {
  color: var(--brass-300);
}

.sv-pkg-tile-name {
  font-size: 22rpx;
  color: var(--color-text-body);
  line-height: 1.35;
  margin-bottom: 6rpx;
}

.sv-pkg-tile-hint {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.sv-selected-hint {
  display: block;
  margin: -8rpx 0 20rpx;
  font-size: 22rpx;
  color: var(--brass-300);
  line-height: 1.55;
}

/* 自定义金额 */
.sv-custom {
  margin-bottom: 24rpx;
}

.sv-custom-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 4rpx 0;
}

.sv-custom-head.is-on .sv-custom-label {
  color: var(--brass-400);
}

.sv-custom-label {
  font-size: 26rpx;
  color: var(--color-text-body);
}

.sv-custom-range {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}

.sv-custom-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-elevated);
  box-sizing: border-box;
}

.sv-custom-input-wrap.is-focus {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.06);
}

.sv-custom-prefix {
  font-family: var(--font-mono);
  font-size: 32rpx;
  color: var(--brass-400);
}

.sv-custom-input {
  flex: 1;
  min-height: 48rpx;
  font-family: var(--font-mono);
  font-size: 36rpx;
  color: var(--color-text-primary);
}

.sv-custom-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-warning);
  line-height: 1.4;
}

.sv-pay-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 16rpx 0 4rpx;
  border-top: 1px solid var(--color-border);
}

.sv-pay-summary-k {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.sv-pay-summary-v {
  font-family: var(--font-mono);
  font-size: 32rpx;
  color: var(--brass-400);
  font-weight: 600;
}

.sv-pay-btn {
  margin-bottom: 12rpx;
}

.sv-pay-btn.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.sv-guest-card {
  margin-top: 8rpx;
}

.sv-guest-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-text-primary);
  margin: 12rpx 0 16rpx;
  line-height: 1.4;
}

.sv-guest-card .sv-muted {
  display: block;
  margin-bottom: 32rpx;
}

.sv-guest-card .sv-pay-btn {
  margin-top: 8rpx;
}

.sv-pay-press {
  opacity: 0.88;
}

.sv-pay-hint,
.sv-muted,
.sv-note-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.sv-pay-hint {
  display: block;
}

/* ── 账单流水：时间轴（月带 / 日组 / 轨道 / 行内降噪） ────────────────
 *
 * 为什么改成时间轴：旧实现是一列平铺行，每行把「类型 / 说明 / 完整日期」竖着堆三行，
 * 20 笔就是 60 行文字墙，且看不出「哪天花了多少」。现在：
 *   · 月带承担月份，日头承担日期与当日净额，行内只留「时分」
 *   · 轨道线把同一天的流水串起来，分组不再靠边框
 *   · 分页未完的那一天不给净额（宁可不给，也不谎报）
 */

.sv-ledger-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.sv-ledger-cap {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}

/* 首屏骨架：与正式行同高，避免「暂无流水」空态闪现 + 布局跳动 */
.sv-ledger-skel {
  padding-top: 8rpx;
}

.sv-ledger-skel-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
}

.sv-ledger-skel-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.sv-ledger-skel-main {
  flex: 1;
  min-width: 0;
}

.sv-ledger-skel-line {
  height: 22rpx;
  border-radius: var(--radius-sm);
}

.sv-ledger-skel-line.is-w1 {
  width: 42%;
}

.sv-ledger-skel-line.is-w2 {
  width: 68%;
  height: 18rpx;
  margin-top: 12rpx;
}

.sv-ledger-skel-amt {
  width: 128rpx;
  height: 26rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

/* 月带 */
.sv-ledger-month {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 26rpx 0 6rpx;
}

.sv-ledger-month:first-child {
  margin-top: 6rpx;
}

.sv-ledger-month-text {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--brass-600);
  letter-spacing: 0.14em;
  font-family: var(--font-mono);
}

.sv-ledger-month-rule {
  flex: 1;
  height: 1px;
  background: rgba(196, 167, 108, 0.16);
}

/* 日头：日期 + 星期在左，当日净额在右。
   ⚠️ padding-right 必须等于 .sv-ledger-row 的右内边距（箭头槽位），
   否则日净额会比逐笔金额多出 26rpx，右边缘对不齐。 */
.sv-ledger-day-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 12rpx 26rpx 4rpx 0;
}

.sv-ledger-day + .sv-ledger-day .sv-ledger-day-head {
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.sv-ledger-day-label {
  font-size: 24rpx;
  color: var(--color-text-body);
}

.sv-ledger-day-week {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.sv-ledger-day-spacer {
  flex: 1;
}

.sv-ledger-day-net {
  font-size: 22rpx;
  font-family: var(--font-mono);
}

.sv-ledger-day-net.is-plus {
  color: var(--brass-300);
}

.sv-ledger-day-net.is-minus {
  color: var(--color-text-secondary);
}

.sv-ledger-day-net.is-flat,
.sv-ledger-day-net.is-open {
  color: var(--color-text-secondary);
}

/* 行：轨道 + 类型/时分 + 金额/余额；行内不再重复日期 */
.sv-ledger-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  /* 右内边距 = 箭头槽位：有箭头与没箭头的行金额右边缘必须对齐，否则金额列会左右跳 */
  padding: 18rpx 26rpx 18rpx 30rpx;
}

.sv-ledger-row-press {
  background: rgba(196, 167, 108, 0.06);
}

.sv-ledger-rail {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 12rpx;
}

.sv-ledger-dot {
  position: absolute;
  left: 0;
  top: 30rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-text-muted);
}

.sv-ledger-dot.is-credit {
  background: var(--brass-400);
}

.sv-ledger-dot.is-debit {
  background: var(--color-text-secondary);
}

.sv-ledger-dot.is-refund {
  background: var(--color-success);
}

/* 轨道线：从圆点下方连到**下一行圆点的上沿**，中途不断开。
   下一行圆点上沿距其行顶 30rpx，而本行底边即下一行行顶 → 向下溢出 30rpx 刚好接上。
   ⚠️ 改 .sv-ledger-dot 的 top 时必须同步改这里，否则轨道会断开或糊到圆点上。
   当天最后一笔、以及全表最后一行不画线（由 isLast 控制），轨道到此为止。 */
.sv-ledger-line {
  position: absolute;
  left: 5rpx;
  top: 46rpx;
  bottom: -30rpx;
  width: 1px;
  background: rgba(196, 167, 108, 0.22);
}

.sv-ledger-main {
  flex: 1;
  min-width: 0;
}

.sv-ledger-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.sv-ledger-type {
  min-width: 0;
  font-size: 26rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 时分右对齐：类型名长短不一时，时间仍是一列 */
.sv-ledger-clock {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 20rpx;
  color: var(--color-text-muted);
  font-family: var(--font-mono);
}

.sv-ledger-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sv-ledger-side {
  /* 固定最小宽度：金额位数一变（如 -¥56.00 vs -¥1286.00）列宽就会跳，
     连带把左边的时分列也推歪。定宽后金额、余额、时分三列都是一条直线。 */
  flex-shrink: 0;
  min-width: 188rpx;
  text-align: right;
}

.sv-ledger-amt {
  display: block;
  font-family: var(--font-mono);
  font-size: 28rpx;
}

.sv-ledger-amt.is-plus {
  color: var(--brass-400);
}

.sv-ledger-amt.is-minus {
  color: var(--color-text-body);
}

.sv-ledger-bal {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}

/* 可点行：右箭头 = 打开关联订单。绝对定位在右侧槽位里（不参与宽度分配），
   行高变化时仍垂直居中，也不会把金额列推来推去 */
.sv-ledger-chevron {
  position: absolute;
  right: 0;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--color-text-muted);
  border-bottom: 2rpx solid var(--color-text-muted);
  transform: translateY(-50%) rotate(-45deg);
}

.sv-ledger-more {
  margin-top: 8rpx;
  padding: 16rpx 0 4rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--brass-400);
}

.sv-ledger-fin {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--color-text-secondary);
}

.sv-flash {
  margin: 0 0 var(--space-4);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--brass-800);
  background: rgba(196, 167, 108, 0.1);
}

.sv-flash-text {
  font-size: 26rpx;
  color: var(--brass-300);
}

.sv-anchor {
  height: 1px;
}

.sv-note {
  margin-top: var(--space-2);
}

.sv-note .account-section-label {
  margin-bottom: 12rpx;
}

.sv-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--brass-400);
}

.sv-link-press {
  opacity: 0.72;
}

.sv-hero {
  margin: 0 0 var(--space-4);
}

/* ── 需求 8：余额卡翻面（正面余额 / 背面支付权益） ────────────────────
   参考积分卡 points/index.wxss 与预约卡 booking/index.wxss 的翻转实现：
   preserve-3d + backface-visibility:hidden + rotateY(180deg)。

   ⚠️ 两点与本页特性相关的取舍：
   1. 用**固定 min-height**（而非积分卡的固定 height）：余额卡内容高度可能随
      会员号/骨架态变化，固定 height 会裁切；两面 absolute 后由 min-height 兜底。
   2. `backface-visibility` 在 iOS 上有透出/闪烁的已知风险 —— 静态判断不作数，
      必须真机验证（AGENTS.md：静态分析 ≠ 事实）。 */

.wallet-flip {
  position: relative;
  margin: 0 0 var(--space-4);
  min-height: 470rpx;
  transform-style: preserve-3d;
  transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.wallet-flip.flipped {
  transform: rotateY(180deg);
}

.wallet-flip-press {
  opacity: 0.94;
}

.wallet-flip__face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

/* 正面沿用皮质卡外观；sv-wallet-hero 的 margin 由外层容器接管 */
.wallet-flip__front {
  z-index: 2;
  margin: 0;
}

/* 背面：略浅一档 + 黄铜描边，翻面可感知（与积分卡背面同一语言） */
.wallet-flip__back {
  transform: rotateY(180deg);
  padding: 40rpx 36rpx 52rpx;
  background:
    radial-gradient(ellipse 108% 92% at 50% 52%, transparent 32%, rgba(26, 24, 20, 0.78) 100%),
    radial-gradient(circle at 50% -10%, #3A342A 0%, #1A1814 72%);
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  display: flex;
  flex-direction: column;
}

.wallet-back-overline {
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.16em;
  color: rgba(196, 167, 108, 0.55);
  margin-bottom: 10rpx;
}

.wallet-back-title {
  font-size: 30rpx;
  color: #D5D1C8;
  margin-bottom: 22rpx;
}

.wallet-back-benefit {
  font-size: 26rpx;
  line-height: 1.6;
  color: #C4A76C;
  margin-bottom: 16rpx;
}

.wallet-back-sub {
  font-size: 22rpx;
  line-height: 1.55;
  color: #8A8378;
}

.wallet-back-empty {
  font-size: 24rpx;
  color: #6B6560;
}

/* 翻面提示：两面底部居中暗字 */
.wallet-flip-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14rpx;
  text-align: center;
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.16em;
  color: rgba(196, 167, 108, 0.5);
}

/* ── 并入钱包枢纽后的「普通内容流」适配（2026-09-17）────────────────────────────
   上面 ./styles/user-account.wxss 是 extra/user/user-account.wxss 的**逐字镜像**（那边还有 6 个页面在用，
   改不得）。它写的是「整页 + 固定头部 + 内部 scroll-view」的口径：
     .account-page  { height:100vh; overflow:hidden }   ← 枢纽里会把滚动锁死、内容溢出被裁
     .account-scroll{ position:fixed; left/right/z-index } ← 定位原本靠 JS 量的 top/height
   枢纽里页头与 tab 由宿主页负责、滚动交给页面本身，故这里只把这两条**局部覆盖**回普通流。
   少这段会出现「内容被裁 + 整页滚不动」，而静态扫描看不出来。 */
.account-page {
  height: auto;
  min-height: 100%;
  overflow: visible;
}
.account-scroll {
  position: static;
  left: auto;
  right: auto;
  top: auto;
  height: auto;
  z-index: auto;
}
