@import './styles/user/user-account.wxss';
@import './wallet-leather.wxss';


.sv-wallet-hero {
  margin: 0 0 var(--space-4);
}

/* 卡面内骨架：深底黄铜微光，高度与正式行对齐，避免 Material 灰条 */
.wallet-leather-skel {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.08) 0%,
    rgba(212, 188, 133, 0.2) 46%,
    rgba(196, 167, 108, 0.08) 100%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

.wallet-leather-balance-skel {
  width: 248rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
}

.wallet-leather-member-skel {
  width: 320rpx;
  height: 22rpx;
}

.sv-recharge-lead {
  display: block;
  margin: -8rpx 0 24rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 档位网格 */
.sv-pkg-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.sv-pkg-tile {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
  background: transparent;
  box-sizing: border-box;
  min-height: 188rpx;
}

.sv-pkg-tile.is-on {
  position: relative;
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass);
}
/* 选中角标（2026-10-15）：决定付多少钱的那一格，只靠一圈描边太弱 —— 右下角一枚金底小勾 */
/* 选中角标（2026-10-15 起保留；2026-10-17 改为暗底铜勾 —— 实心金只留给「充值」按钮） */
.sv-pkg-tile.is-on::after {
  content: '✓';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 32rpx;
  border-radius: 4rpx 0 2rpx 0;
  background: #1A1814;
  box-shadow: inset 1rpx 1rpx 0 rgba(196, 167, 108, 0.55);
  color: var(--brass-200);
  font-size: var(--fs-20);
  line-height: 32rpx;
  text-align: center;
}
/* 档位为奇数时最后一格独占一行（2026-10-15）：三档时第三格不再孤零零缩在左下 */
.sv-pkg-tile:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

.sv-pkg-press {
  opacity: 0.85;
}

.sv-pkg-tile-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 12rpx;
  gap: 8rpx;
}

.sv-pkg-level {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.sv-pkg-points {
  font-size: var(--fs-18);
  color: var(--color-text-secondary);
}

.sv-pkg-amt-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.sv-pkg-tile-yen {
  font-size: var(--fs-22);
  color: var(--brass-400);
}

.sv-pkg-tile-amt {
  font-family: var(--font-mono);
  font-size: var(--fs-40);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.1;
}

.sv-pkg-tile.is-on .sv-pkg-tile-amt {
  color: var(--brass-300);
}

.sv-pkg-tile-name {
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  font-weight: 600;
  color: #F3ECDD;
  line-height: 1.35;
  margin-bottom: 6rpx;
}

.sv-pkg-tile-hint {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.sv-selected-hint {
  display: block;
  margin: -8rpx 0 20rpx;
  font-size: var(--fs-22);
  color: var(--brass-300);
  line-height: 1.55;
}

/* 自定义金额 */
.sv-custom {
  margin-bottom: 24rpx;
}

.sv-custom-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 4rpx 0;
}

.sv-custom-head.is-on .sv-custom-label {
  color: var(--brass-400);
}

.sv-custom-label {
  font-size: var(--fs-26);
  color: var(--color-text-body);
}

.sv-custom-range {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}

/* 自定义金额：下划线输入（与搜索框同口径），聚焦时下划线转金 */
.sv-custom-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.24);
  box-sizing: border-box;
}

.sv-custom-input-wrap.is-focus {
  border-bottom-color: var(--brass-400);
}

.sv-custom-prefix {
  font-family: var(--font-mono);
  font-size: var(--fs-32);
  color: var(--brass-400);
}

.sv-custom-input {
  flex: 1;
  min-height: 48rpx;
  background: transparent;
  font-family: var(--font-mono);
  font-size: var(--fs-36);
  color: var(--color-text-primary);
}

.sv-custom-hint {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-22);
  color: var(--color-warning);
  line-height: 1.4;
}

.sv-pay-summary {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 16rpx 0 4rpx;
  border-top: 1px solid var(--color-border);
}

.sv-pay-summary-k {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.sv-pay-summary-v {
  font-family: var(--font-mono);
  font-size: var(--fs-32);
  color: var(--brass-400);
  font-weight: 600;
}

.sv-pay-btn {
  margin-bottom: 12rpx;
  border-radius: 4rpx;
  letter-spacing: 0.12em;
  font-weight: 600;
}

.sv-pay-btn.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.sv-guest-card {
  margin-top: 8rpx;
}

.sv-guest-title {
  display: block;
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  margin: 12rpx 0 16rpx;
  line-height: 1.4;
}

.sv-guest-card .sv-muted {
  display: block;
  margin-bottom: 32rpx;
}

.sv-guest-card .sv-pay-btn {
  margin-top: 8rpx;
}

.sv-pay-press {
  opacity: 0.88;
}

.sv-pay-hint,
.sv-muted {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.sv-pay-hint {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  text-align: center;
}

/* ── 账单流水（2026-11-22 降噪，产品负责人「下方文字较多，特别是账单流水」）────
 *
 * 旧版（2026-09 时间轴）每笔 = 日头（日期·星期·当日净额）+ 轨道点 + 类型/时分 + 副标题 + 金额/余额，
 * 一笔四五段字；云端副标题又多半是类型说明的复述（「订单消费 / 订单支付扣款 · ORD…」）。现在：
 *   · 月带保留；日头取消，日期并进行内 meta（「今天 14:20」）
 *   · 行 = 一字方印（付/充/退…）+ 类型 + 一行 meta（时间 · 单号尾 6 位）+ 金额
 *   · 不再展示余额与当日净额（余额看卡面；也就不存在「分页未完那天净额谎报」的问题）
 */

.sv-ledger-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.sv-ledger-cap {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}

/* 首屏骨架：与正式行同高，避免「暂无流水」空态闪现 + 布局跳动 */
.sv-ledger-skel {
  padding-top: 8rpx;
}

.sv-ledger-skel-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}

.sv-ledger-skel-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.sv-ledger-skel-main {
  flex: 1;
  min-width: 0;
}

.sv-ledger-skel-line {
  height: 22rpx;
  border-radius: var(--radius-sm);
}

.sv-ledger-skel-line.is-w1 {
  width: 42%;
}

.sv-ledger-skel-line.is-w2 {
  width: 68%;
  height: 18rpx;
  margin-top: 12rpx;
}

.sv-ledger-skel-amt {
  width: 128rpx;
  height: 26rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

/* 月带 */
.sv-ledger-month {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 26rpx 0 6rpx;
}

.sv-ledger-month:first-child {
  margin-top: 6rpx;
}

.sv-ledger-month-text {
  flex-shrink: 0;
  font-size: var(--fs-20);
  color: var(--brass-600);
  letter-spacing: 0.14em;
  font-family: var(--font-mono);
}

.sv-ledger-month-rule {
  flex: 1;
  height: 1px;
  background: rgba(196, 167, 108, 0.16);
}

/* 行：方印 | 类型 + meta | 金额（右侧留箭头槽位，有无箭头金额都对齐） */
.sv-ledger-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 30rpx 20rpx 0;
}

.sv-ledger-row + .sv-ledger-row {
  border-top: 1rpx solid rgba(196, 167, 108, 0.08);
}

.sv-ledger-row-press {
  background: rgba(196, 167, 108, 0.06);
}

/* 一字方印：入账铜底、支出暗底、退款/回账空心铜圈 */
.sv-ledger-glyph {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  color: var(--color-text-body);
  background: rgba(255, 255, 255, 0.04);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
}

.sv-ledger-glyph.is-credit {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.14);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.45);
}

.sv-ledger-glyph.is-refund {
  color: var(--brass-300);
  background: transparent;
  box-shadow: inset 0 0 0 2rpx rgba(196, 167, 108, 0.55);
}

.sv-ledger-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.sv-ledger-type {
  font-size: var(--fs-26);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sv-ledger-meta {
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sv-ledger-clock {
  margin-left: 10rpx;
  font-family: var(--font-mono);
}

/* 金额定宽右对齐：位数变化时整列不跳 */
.sv-ledger-amt {
  flex-shrink: 0;
  min-width: 160rpx;
  text-align: right;
  font-family: var(--font-mono);
  font-size: var(--fs-28);
}

.sv-ledger-amt.is-plus {
  color: var(--brass-300);
}

.sv-ledger-amt.is-minus {
  color: var(--color-text-body);
}

/* 可点行：右箭头 = 打开关联订单。绝对定位在右侧槽位里，不推动金额列 */
.sv-ledger-chevron {
  position: absolute;
  right: 4rpx;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--brass-600);
  border-bottom: 2rpx solid var(--brass-600);
  transform: translateY(-50%) rotate(-45deg);
}

.sv-ledger-more {
  margin-top: 8rpx;
  padding: 16rpx 0 4rpx;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--brass-400);
}

.sv-ledger-fin {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: var(--color-text-secondary);
}

.sv-flash {
  margin: 0 0 var(--space-4);
  padding: 20rpx 24rpx;
  border-radius: 4rpx;
  box-shadow: var(--ring-brass-soft);
  background: rgba(196, 167, 108, 0.08);
}

.sv-flash-text {
  font-size: var(--fs-26);
  color: var(--brass-300);
}

.sv-anchor {
  height: 1px;
}

/* 安全提示页脚（2026-11-22）：一行说明 + 联系专员，不再单立一个分区 */
.sv-foot {
  margin-top: var(--space-5);
  padding-top: var(--space-3);
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  text-align: center;
}

.sv-foot-text {
  display: block;
  font-size: var(--fs-20);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.sv-foot-link {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  font-size: var(--fs-22);
  color: var(--brass-400);
}

.sv-link-press {
  opacity: 0.72;
}

.sv-hero {
  margin: 0 0 var(--space-4);
}

/* ── 需求 8：余额卡翻面（正面余额 / 背面支付权益） ────────────────────
   参考积分卡 points/index.wxss 与预约卡 booking/index.wxss 的翻转实现：
   preserve-3d + backface-visibility:hidden + rotateY(180deg)。

   ⚠️ 两点与本页特性相关的取舍：
   1. 用**固定 min-height**（而非积分卡的固定 height）：余额卡内容高度可能随
      会员号/骨架态变化，固定 height 会裁切；两面 absolute 后由 min-height 兜底。
   2. `backface-visibility` 在 iOS 上有透出/闪烁的已知风险 —— 静态判断不作数，
      必须真机验证（AGENTS.md：静态分析 ≠ 事实）。 */

.wallet-flip {
  position: relative;
  /* 2026-11-22：与积分卡同一规格 —— 距顶栏 32rpx、高 440rpx（原 0 / 470），切 tab 卡面不再跳 */
  margin: var(--space-4) 0 var(--space-4);
  height: 440rpx;
  transform-style: preserve-3d;
  transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.wallet-flip.flipped {
  transform: rotateY(180deg);
}

.wallet-flip-press {
  opacity: 0.94;
}

.wallet-flip__face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

/* 正面沿用皮质卡外观；sv-wallet-hero 的 margin 由外层容器接管 */
.wallet-flip__front {
  z-index: 2;
  margin: 0;
}

/* 2026-11-22 定高 440rpx 后（实测量自预览，相对卡顶）：
   内层撑满卡高 → 缝线框底边落在 426rpx（原内层约 450rpx 高，缝线穿过翻面提示）；
   卡头间距 36 → 24rpx，铭牌文字底约 363rpx；提示 bottom 26rpx → 约 390–414rpx，落在铭牌与缝线之间。
   皮质纹理本身（wallet-leather.wxss，R16-1 指纹锁定）不动。 */
.wallet-flip__front .wallet-leather-card__inner {
  height: 100%;
  box-sizing: border-box;
}
.wallet-flip__front .wallet-leather-card__head {
  margin-bottom: 24rpx;
}
.wallet-flip__front .wallet-flip-hint {
  bottom: 26rpx;
  z-index: 4;
}

/* 背面：略浅一档 + 黄铜描边，翻面可感知（与积分卡背面同一语言） */
.wallet-flip__back {
  transform: rotateY(180deg);
  padding: 40rpx 36rpx 52rpx;
  background:
    radial-gradient(ellipse 108% 92% at 50% 52%, transparent 32%, rgba(26, 24, 20, 0.78) 100%),
    radial-gradient(circle at 50% -10%, #3A342A 0%, #1A1814 72%);
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  display: flex;
  flex-direction: column;
}

.wallet-back-overline {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: rgba(196, 167, 108, 0.55);
  margin-bottom: 10rpx;
}

.wallet-back-title {
  font-size: var(--fs-30);
  color: #D5D1C8;
  margin-bottom: 22rpx;
}

.wallet-back-benefit {
  font-size: var(--fs-26);
  line-height: 1.6;
  color: var(--color-primary);
  margin-bottom: 16rpx;
}

.wallet-back-sub {
  font-size: var(--fs-22);
  line-height: 1.55;
  color: #8A8378;
}

.wallet-back-empty {
  font-size: var(--fs-24);
  color: #6B6560;
}

/* 翻面提示：两面底部居中暗字 */
.wallet-flip-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14rpx;
  text-align: center;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: rgba(196, 167, 108, 0.5);
}

/* ── 并入钱包枢纽后的「普通内容流」适配（2026-09-17）────────────────────────────
   上面 ./styles/user-account.wxss 是 extra/user/user-account.wxss 的**逐字镜像**（那边还有 6 个页面在用，
   改不得）。它写的是「整页 + 固定头部 + 内部 scroll-view」的口径：
     .account-page  { height:100vh; overflow:hidden }   ← 枢纽里会把滚动锁死、内容溢出被裁
     .account-scroll{ position:fixed; left/right/z-index } ← 定位原本靠 JS 量的 top/height
   枢纽里页头与 tab 由宿主页负责、滚动交给页面本身，故这里只把这两条**局部覆盖**回普通流。
   少这段会出现「内容被裁 + 整页滚不动」，而静态扫描看不出来。 */
.account-page {
  height: auto;
  min-height: 100%;
  overflow: visible;
}
.account-scroll {
  position: static;
  left: auto;
  right: auto;
  top: auto;
  height: auto;
  z-index: auto;
}

/* 2026-10-17 视觉对齐（局部覆盖，镜像文件改不得）：分区不再装进圆角深色盒，
   改发丝线分隔 + 宋体分区题（去掉左侧金条）；与山海有信 / 门店页等同一口径。 */
.account-section-card {
  padding: 36rpx 0 8rpx;
  margin-bottom: 16rpx;
  background: transparent;
  border: none;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: 0;
}

.account-section-label {
  margin-bottom: 20rpx;
  font-family: var(--font-brand);
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.account-section-label::before { display: none; }

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .wallet-leather-skel {
    animation: none;
  }
}

/* 我的捐赠入口（2026-11-22）：余额卡下方第一张卡，铜边 + 右侧大号「1%」，比普通分区卡更醒目但不抢余额卡 */
.sv-giving {
  position: relative;
  display: flex;
  align-items: center;
  margin: 24rpx 0 0;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background:
    radial-gradient(90% 120% at 100% 50%, rgba(196, 167, 108, 0.16), transparent 62%),
    var(--color-bg-card, #1F1D1A);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.42);
}
.sv-giving-press { opacity: 0.86; transform: scale(0.99); }
.sv-giving-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.sv-giving-overline {
  font-family: var(--font-latin);
  font-size: var(--fs-18, 18rpx);
  letter-spacing: 0.24em;
  color: var(--brass-400, #C4A76C);
}
.sv-giving-title {
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-30, 30rpx);
  color: var(--color-text-primary, #F5F1E8);
}
.sv-giving-line {
  margin-top: 8rpx;
  font-size: var(--fs-22, 22rpx);
  line-height: 1.6;
  color: var(--color-text-secondary, #A09A90);
}
.sv-giving-amt { font-family: var(--font-mono); color: var(--brass-200, #E0CFA3); }
.sv-giving-side { flex: none; display: flex; align-items: center; margin-left: 20rpx; }
.sv-giving-pct {
  font-family: var(--font-latin);
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1;
  color: rgba(224, 207, 163, 0.9);
}
.sv-giving-chev {
  width: 14rpx;
  height: 14rpx;
  margin-left: 16rpx;
  border-top: 2rpx solid var(--brass-400, #C4A76C);
  border-right: 2rpx solid var(--brass-400, #C4A76C);
  transform: rotate(45deg);
}
