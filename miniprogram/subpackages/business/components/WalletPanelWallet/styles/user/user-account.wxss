@import '../care/care-common.wxss';

/* 账号模块 — 导航与布局 */
.account-page {
  height: 100vh;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
  background: var(--color-bg);
}

.account-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  box-sizing: border-box;
  padding-left: var(--space-4);
  background: rgba(26, 24, 20, 0.96);
  border-bottom: 1px solid var(--color-border);
}

.account-nav::after {
  content: '';
  position: absolute;
  left: var(--space-4);
  right: var(--space-4);
  bottom: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--brass-800), transparent);
  opacity: 0.55;
}

.account-nav-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 44px;
}

.account-nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  box-sizing: border-box;
}

.account-nav-back-icon {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.account-nav-brand {
  flex: 1;
  min-width: 0;
}

.account-nav-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-nav-sub {
  display: block;
  font-size: 18rpx;
  color: var(--brass-400);
  letter-spacing: 0.12em;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-nav-badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  font-family: var(--font-mono);
  color: var(--brass-400);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-full);
  background: rgba(196, 167, 108, 0.06);
}

.account-nav-extra {
  padding: 0 var(--space-4) var(--space-3);
}

.account-scroll {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 2;
  box-sizing: border-box;
  padding: 0 var(--space-4);
}

.account-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: var(--space-3) var(--space-4);
  box-sizing: border-box;
  background: rgba(26, 24, 20, 0.96);
  border-top: 1px solid var(--color-border);
}

.account-footer-safe {
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
}

.account-btn-primary {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brass-400);
  color: var(--color-bg);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-2);
}

.account-btn-primary.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.account-btn-press {
  opacity: 0.88;
  background: var(--brass-500);
}

.account-btn-ghost {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}

.account-btn-phone {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0 0 var(--space-2);
  background: var(--brass-400);
  color: var(--color-bg);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  border: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.account-btn-phone::after { border: none; }

.account-section-card {
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.account-section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--brass-400);
  letter-spacing: 0.1em;
  margin-bottom: var(--space-3);
}

.account-section-label::before {
  content: '';
  width: 6rpx;
  height: 22rpx;
  border-radius: 3rpx;
  background: var(--brass-400);
  opacity: 0.85;
}

.account-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.account-chip {
  padding: 10rpx 22rpx;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: rgba(31, 29, 26, 0.6);
  box-sizing: border-box;
}

.account-chip.active {
  border-color: var(--brass-800);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.08);
}

.account-chip-press {
  transform: scale(0.96);
  opacity: 0.88;
}

.account-field {
  margin-bottom: var(--space-3);
}

.account-field:last-child {
  margin-bottom: 0;
}

.account-field-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.account-field-hint {
  display: block;
  margin: -2rpx 0 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--color-text-secondary);
}

.account-field-hint.field-hint-brass {
  color: rgba(196, 167, 108, 0.92);
}

.account-field-input,
.account-picker-val {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-body);
  font-size: 26rpx;
  box-sizing: border-box;
}

.account-scroll-pad {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

.mbti-scroll {
  width: 100%;
  white-space: nowrap;
}

.mbti-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.mbti-chip {
  flex-shrink: 0;
}
