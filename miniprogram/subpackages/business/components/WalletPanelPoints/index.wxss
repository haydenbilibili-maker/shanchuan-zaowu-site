/* pages/points/index.wxss */
/* 继承 app.wxss */


.container { padding: 0 30rpx; width: 100%; display: flex; flex-direction: column; align-items: center; }

/* 1. 资产卡 · 黑金翻转（正面=积分余额，背面=积分规则；与预约票据卡同一交互） */
.asset-flip {
  position: relative;
  width: 100%; height: 440rpx; margin-top: 30rpx;
  transform-style: preserve-3d;
  transition: transform .8s cubic-bezier(.175, .885, .32, 1.275);
}
.asset-flip.flipped { transform: rotateY(180deg); }
.asset-flip-press { opacity: .94; }

/* 双面通用：绝对定位 + 背面隐藏（金库黑底 + 金色微光） */
.asset-face {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  border-radius: var(--radius-lg); overflow: hidden;
  backface-visibility: hidden;
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, .8);
  background: radial-gradient(circle at 50% -20%, #333 0%, var(--color-bg) 70%);
  border: 1px solid rgba(255, 255, 255, .1);
}
.asset-front { z-index: 2; }
/* 背面：略浅一档 + 黄铜描边，翻面可感知 */
.asset-back {
  transform: rotateY(180deg);
  padding: 44rpx 46rpx 52rpx;
  box-sizing: border-box;
  border-color: rgba(196, 167, 108, .42);
  background: radial-gradient(circle at 50% -10%, #3A342A 0%, #1A1814 72%);
}

/* 翻面提示（两面角落暗字） */
.card-flip-hint {
  position: absolute; left: 0; right: 0; bottom: 14rpx;
  text-align: center;
  font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .16em;
  color: rgba(196, 167, 108, .55);
}

/* 背面：头部 + 规则明细 */
.back-strip {
  position: absolute; top: 30rpx; bottom: 34rpx; left: 26rpx; width: 2rpx;
  background: linear-gradient(to bottom, transparent, var(--brass-400), transparent);
  opacity: .5;
}
.back-head { position: relative; z-index: 2; display: flex; align-items: baseline; justify-content: space-between; }
.back-head-left { display: flex; align-items: baseline; gap: 12rpx; }
.back-en { font-family: var(--font-mono); font-size: var(--fs-20); letter-spacing: .18em; color: var(--color-primary); font-weight: bold; }
.back-cn { font-size: var(--fs-28); letter-spacing: .06em; color: #F2EFE8; }
.back-seal {
  font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .16em;
  color: var(--brass-400); border: 1rpx solid rgba(196, 167, 108, .5);
  padding: 4rpx 12rpx; border-radius: var(--radius-sm); opacity: .85;
}
.back-detail { position: relative; z-index: 2; margin-top: 24rpx; display: flex; flex-direction: column; gap: 12rpx; }

/* 我的累计条（常显，不随卡片翻转） */
.asset-meta {
  width: 100%; margin: 20rpx 0 8rpx; padding: 0 6rpx;
  display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx;
}
.rm-item { font-size: var(--fs-22); color: var(--color-text-secondary); }
.rm-val { font-family: var(--font-mono); font-size: var(--fs-26); color: var(--brass-400); }
.rm-dot { font-size: var(--fs-22); color: var(--color-text-muted); }
.rd-row { display: flex; align-items: flex-start; gap: 16rpx; }
.rd-label { flex-shrink: 0; width: 108rpx; font-size: var(--fs-22); letter-spacing: .04em; color: var(--brass-400); opacity: .85; }
.rd-text { flex: 1; font-size: var(--fs-22); line-height: 1.5; color: var(--color-text-secondary); }

.card-texture {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.1;
  background-image: repeating-linear-gradient(45deg, var(--color-primary) 0, var(--color-primary) 1px, transparent 0, transparent 50%);
  background-size: 20rpx 20rpx;
}

.card-inner {
  position: relative; z-index: 2; height: 100%; padding: 60rpx 50rpx;
  display: flex; flex-direction: column; justify-content: space-between; align-items: center;
}

.card-top { width: 100%; display: flex; justify-content: space-between; align-items: center; }
.brand-group { text-align: center; width: 100%; }
.en { font-family: var(--font-mono); font-size: var(--fs-20); color: var(--color-primary); letter-spacing: 8rpx; font-weight: bold; margin-bottom: 10rpx; display: block; }
.cn { font-size: var(--fs-24); color: var(--color-text-secondary); letter-spacing: 2rpx; }

.level-badge { 
  position: absolute; top: 40rpx; right: 40rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.3); border-radius: 30rpx; 
  padding: 4rpx 16rpx; display: flex; align-items: center; background: rgba(196, 167, 108, 0.05);
}
.level-badge text { font-size: var(--fs-18); color: var(--color-primary); font-weight: bold; }

.card-main { margin-top: 20rpx; text-align: center; }
.symbol { font-size: var(--fs-22); color: var(--brass-400); letter-spacing: 0.18em; display: block; margin-bottom: 8rpx; }
.num { font-size: 100rpx; color: var(--color-text-primary); font-weight: bold; font-family: var(--font-mono), 'DIN', sans-serif; letter-spacing: 4rpx; text-shadow: none; line-height: 1; }
.num.is-pending { color: var(--color-text-secondary); font-size: 72rpx; letter-spacing: 8rpx; }
.unit { font-size: var(--fs-24); color: var(--color-text-secondary); margin-top: 10rpx; display: block; font-family: var(--font-mono); letter-spacing: 2rpx; }

.card-bottom .tips { font-size: var(--fs-20); color: var(--color-text-secondary); }

/* 2. 极简导航 */
/* 2026-10-17 视觉对齐：页签 = 下划线（原圆点 + 光晕 + 竖分隔），与钱包顶栏同口径 */
.tab-navbar {
  width: 100%; display: flex; align-items: stretch;
  margin: 52rpx 0 40rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}
.tab-item {
  flex: 1; min-width: 0;
  padding: 20rpx 0; position: relative;
  font-size: var(--fs-26); color: var(--color-text-secondary); transition: color var(--dur-base) var(--ease-standard);
  text-align: center; white-space: nowrap;
}
.tab-item text { white-space: nowrap; }
.tab-item.active { color: #F3ECDD; font-family: var(--font-brand); font-weight: 600; }
.indicator {
  position: absolute; bottom: -1rpx; left: 24%; right: 24%;
  height: 3rpx; background: var(--brass-400);
}

/* 3. 权益网格 (沉浸式) */
.content-area { width: 100%; }
.section-header { margin-bottom: 40rpx; text-align: center; }
.title-group .en { display: block; font-family: var(--font-mono); font-size: var(--fs-18); color: var(--brass-300); letter-spacing: 0.24em; }
.title-group .cn { display: block; margin-top: 10rpx; font-family: var(--font-brand); font-size: 38rpx; font-weight: 500; letter-spacing: 0.12em; color: #F3ECDD; }

/* 兑换品：图版（发丝框）+ 图下图注；兑换钮为金线环 —— 一屏多颗实心金药丸 → 收口（实心金不给列表项） */
.reward-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 36rpx 20rpx; }
.reward-card {
  display: flex; flex-direction: column; position: relative;
}

.img-box { position: relative; width: 100%; padding-top: 100%; background: #1F1D1A; border-radius: 4rpx; overflow: hidden; box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22); }
.img-box image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.9; object-fit: cover; }
.type-badge {
  position: absolute; top: 14rpx; left: 14rpx; font-family: var(--font-mono); font-size: var(--fs-16);
  color: var(--brass-200); background: rgba(26, 24, 20, 0.78); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.4);
  padding: 4rpx 10rpx; border-radius: 2rpx; letter-spacing: 0.16em;
}
.sold-out-mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.8); color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-24); letter-spacing: 4rpx; font-weight: bold; font-family: var(--font-mono);
}

.info-box { padding: 16rpx 2rpx 0; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.r-title { font-family: var(--font-brand); font-size: var(--fs-26); color: #F3ECDD; font-weight: 600; margin-bottom: 6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.r-desc { font-size: var(--fs-20); color: var(--color-text-secondary); margin-bottom: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.r-footer { display: flex; justify-content: space-between; align-items: center; }
.cost-group .val { font-size: var(--fs-30); color: var(--brass-200); font-weight: 600; font-family: var(--font-mono); }
.cost-group .unit { font-size: var(--fs-18); color: var(--color-text-secondary); margin-left: 4rpx; font-weight: bold; }

.btn-outline {
  font-size: var(--fs-22); color: var(--brass-200); background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass-soft);
  padding: 8rpx 22rpx; border-radius: 4rpx; letter-spacing: 0.08em;
}
.btn-outline.disabled { background: transparent; box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.3); color: var(--color-text-secondary); }

/* 4. 我的兑换 (时间轴风格) */
.my-list { display: flex; flex-direction: column; gap: 40rpx; padding-left: 20rpx; border-left: 1rpx solid rgba(196, 167, 108, 0.22); margin-left: 20rpx; }
.my-card {
  display: flex; position: relative; padding-left: 30rpx;
}
/* 时间轴点 */
.my-card::before {
  content: ''; position: absolute; left: -25rpx; top: 10rpx;
  width: 10rpx; height: 10rpx; background: var(--brass-300); border-radius: 50%;
}

.my-thumb { width: 100rpx; height: 100rpx; border-radius: 4rpx; background: #1F1D1A; margin-right: 24rpx; flex-shrink: 0; border: 1rpx solid rgba(196, 167, 108, 0.22); }
.my-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }

.my-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.my-title { font-family: var(--font-brand); font-size: var(--fs-26); color: #F3ECDD; font-weight: 600; }
.my-meta { font-size: var(--fs-20); color: var(--color-text-secondary); font-family: var(--font-mono); }

.my-action-row { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.status-txt { font-size: var(--fs-20); color: var(--color-text-secondary); }
.btn-small {
  font-size: var(--fs-20); color: var(--brass-200); border: 1rpx solid rgba(196, 167, 108, 0.55);
  padding: 4rpx 16rpx; border-radius: 2rpx;
}
.btn-track {
  font-size: var(--fs-20); color: var(--color-text-secondary); border: 1rpx solid rgba(160, 154, 144, 0.35);
  padding: 4rpx 16rpx; border-radius: 2rpx;
}

.empty-tip { text-align: center; color: var(--color-text-secondary); font-size: var(--fs-24); margin-top: 100rpx; letter-spacing: 2rpx; }
.empty-retry {
  margin: 24rpx auto 0;
  display: inline-block;
  padding: 10rpx 32rpx;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: var(--radius-md);
  font-size: var(--fs-22);
}
.empty-guide {
  margin: 24rpx auto 0;
  display: inline-block;
  padding: 10rpx 32rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  color: var(--color-primary);
  border-radius: var(--radius-md);
  font-size: var(--fs-22);
}
.copyright {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: var(--fs-20);
  margin-top: 80rpx;
  letter-spacing: 0.1em;
}
.copyright .cr-cn { font-weight: 500; color: var(--color-text-muted); }
.copyright .cr-en {
  font-size: var(--fs-18);
  letter-spacing: 0.18em;
  color: #8B6F47;
  font-weight: 600;
}

/* 弹窗复用 */
/* 核销码：仪式卡，形态取 ui-pop-*（原纯黑毛玻璃 + 冷灰 #1a1a1a 牌面 + #333 边） */
.qr-mask { z-index: 1000; }
.qr-content { display: flex; flex-direction: column; align-items: center; }
.qr-live-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.qr-code-img { width: 400rpx; height: 400rpx; margin-top: 24rpx; border: 10rpx solid #fff; border-radius: var(--radius-sm); }
.hint { margin-top: 28rpx; color: var(--color-text-secondary); font-size: var(--fs-22); }
/* 积分明细 */
/* 积分明细（2026-09-18 需求 8：筛选 + 时间轴 + 分页）
   视觉与储值账单的 .sv-ledger-* 同一套语言：月带 / 日头（当日净额）/ 轨道行。
   ⚠️ 只用既有色变量，避免 report:colors:strict 报「新色残留」。 */
.pt-ledger { display: flex; flex-direction: column; }
.pt-ledger-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 0 12rpx;
}
.pt-ledger-filters { display: flex; align-items: center; gap: 12rpx; }
.pt-filter {
  padding: 8rpx 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}
.pt-filter.is-on {
  border-color: var(--brass-600);
  color: var(--color-primary);
}
.pt-ledger-cap {
  flex-shrink: 0;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}
.pt-ledger-sums { display: flex; align-items: center; gap: 18rpx; padding-bottom: 10rpx; }
.pt-sum { font-size: var(--fs-20); font-family: var(--font-mono); }
.pt-sum.is-plus { color: var(--brass-400); }
.pt-sum.is-minus { color: var(--color-text-secondary); }
.pt-sum.is-hint { color: var(--color-text-secondary); font-family: var(--font-brand); }

.pt-ledger-timeline { display: flex; flex-direction: column; }
.pt-ledger-month {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 22rpx 0 6rpx;
}
.pt-ledger-month:first-child { margin-top: 6rpx; }
.pt-ledger-month-text {
  flex-shrink: 0;
  font-size: var(--fs-20);
  color: var(--brass-600);
  letter-spacing: 0.14em;
  font-family: var(--font-mono);
}
.pt-ledger-month-rule { flex: 1; height: 1px; background: rgba(196, 167, 108, 0.16); }

/* 日头：日期 + 星期在左，当日净积分在右 */
.pt-ledger-day-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 12rpx 0 4rpx;
}
.pt-ledger-day + .pt-ledger-day .pt-ledger-day-head {
  border-top: 1px solid var(--color-border);
  margin-top: 12rpx;
  padding-top: 20rpx;
}
.pt-ledger-day-label { font-size: var(--fs-24); color: var(--color-text-body); }
.pt-ledger-day-week { font-size: var(--fs-20); color: var(--color-text-secondary); }
.pt-ledger-day-spacer { flex: 1; }
.pt-ledger-day-net { font-size: var(--fs-22); font-family: var(--font-mono); }
.pt-ledger-day-net.is-plus { color: var(--brass-400); }
.pt-ledger-day-net.is-minus { color: var(--color-text-secondary); }
.pt-ledger-day-net.is-flat,
.pt-ledger-day-net.is-open { color: var(--color-text-secondary); }

/* 行：轨道圆点 + 标题/时分 + 分值/余额；行内不重复日期 */
.pt-ledger-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0 18rpx 30rpx;
}
.pt-ledger-rail { position: absolute; left: 0; top: 0; bottom: 0; width: 12rpx; }
.pt-ledger-dot {
  position: absolute;
  left: 0;
  top: 30rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-text-muted);
}
.pt-ledger-dot.is-plus { background: var(--brass-400); }
.pt-ledger-dot.is-minus { background: var(--color-text-secondary); }
.pt-ledger-dot.is-flat { background: var(--color-text-muted); }
.pt-ledger-main { flex: 1; min-width: 0; }
.pt-ledger-top { display: flex; align-items: baseline; gap: 12rpx; }
.pt-ledger-title {
  min-width: 0;
  font-size: var(--fs-26);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pt-ledger-clock {
  flex-shrink: 0;
  margin-left: auto;
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  font-family: var(--font-mono);
}
.pt-ledger-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 6rpx; }
.pt-ledger-tag { font-size: var(--fs-20); color: var(--color-text-secondary); }
.pt-ledger-pending { font-size: var(--fs-20); color: var(--brass-600); }
.pt-ledger-side { flex-shrink: 0; min-width: 150rpx; text-align: right; }
.pt-ledger-points { display: block; font-family: var(--font-mono); font-size: var(--fs-30); }
.pt-ledger-points.is-plus { color: var(--brass-400); }
.pt-ledger-points.is-minus { color: var(--color-text-secondary); }
.pt-ledger-points.is-flat { color: var(--color-text-secondary); }
.pt-ledger-balance {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}
.pt-ledger-more {
  margin-top: 26rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-primary);
  border-top: 1px solid var(--color-border);
}
.pt-ledger-more-press { opacity: 0.7; }
.pt-ledger-fin {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

/* 订单认领轻量入口（2026-10-17：圆角深色卡 → 发丝线行） */
.claim-entry {
  width: 100%;
  margin: 16rpx 0 8rpx;
  padding: 28rpx 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  box-sizing: border-box;
  transition: background var(--dur-fast) var(--ease-standard);
}
.wallet-entry {
  margin-top: 8rpx;
}
.claim-entry-press {
  background: rgba(196, 167, 108, 0.05);
}
.claim-entry-text { flex: 1; min-width: 0; }
.claim-entry-en {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}
.claim-entry-cn {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-30);
  font-weight: 600;
  color: #F3ECDD;
  font-family: var(--font-brand);
}
.claim-entry-desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  line-height: 1.4;
}
.claim-entry-arr {
  flex-shrink: 0;
  font-size: var(--fs-32);
  color: var(--brass-300);
}

/* 兑换二次确认 */
.ex-mask {
  z-index: 1100;
}
.ex-modal {
  max-width: 620rpx;
}
.ex-body { padding: 4rpx 0 0; }
.ex-name {
  display: block;
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}
.ex-cost {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-28);
  color: var(--brass-400);
  margin-bottom: 16rpx;
}
.ex-line {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-body);
  line-height: 1.6;
}
.ex-usage {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-24);
  line-height: 1.55;
  color: var(--color-text-secondary);
}
.ex-hint {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: var(--color-text-secondary);
}

/* ==========================================================================
   材质真实化 v2（2026-10-18 产品负责人「积分卡…金属质…持续加强和真实化」）
   积分卡 = 黑钛：随机横向拉丝（暖金丝 + 黑丝）+ 斜向镜面带 + 金色倒角（外亮内暗）+ 字压印（上暗下亮）。
   只改正面材质；背面规则卡、翻转交互不动。
   ========================================================================== */
.asset-front {
  background-color: #141210;
  background-image:
    linear-gradient(112deg, transparent 22%, rgba(232, 214, 174, 0.05) 38%, rgba(232, 214, 174, 0.16) 47%, rgba(232, 214, 174, 0.05) 55%, transparent 70%),
