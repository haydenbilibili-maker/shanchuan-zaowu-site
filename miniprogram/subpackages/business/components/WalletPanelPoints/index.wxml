<!--pages/points/index.wxml-->
<view class="container">

  <!-- 2026-09-17：钱包 / 礼券夹 / 积分 三个并列 tab（与礼券夹页同构） -->

  <!-- 1. 顶部资产卡 · 黑金翻转：正面=积分余额（原样式），背面=积分规则 -->
  <view
    class="asset-flip {{cardFlipped ? 'flipped' : ''}}"
    bindtap="toggleCard"
    hover-class="asset-flip-press"
    hover-stay-time="80"
  >
    <!-- 正面：金库风格资产卡 -->
    <view class="asset-face asset-front">
      <view class="card-shine"></view>
      <view class="card-texture"></view>

      <view class="card-inner">
        <view class="card-top">
          <view class="brand-group">
            <text class="en">MY POINTS</text>
            <text class="cn">我的积分 · 资产账户</text>
          </view>
          <view class="level-badge">
            <text class="crown">♛</text>
            <text>{{levelName}}</text>
          </view>
        </view>

        <view class="card-main">
          <text class="symbol">PTS.</text>
          <text class="num {{pointsReady ? '' : 'is-pending'}}">{{pointsText}}</text>
        </view>

        <view class="card-bottom">
          <text class="tips" wx:if="{{pointsError}}" catchtap="retryPoints">积分加载失败，点此重试</text>
          <text class="tips" wx:elif="{{!pointsReady}}">正在核对积分余额</text>
          <text class="tips" wx:else>积分用于兑换限量藏品与特权</text>
        </view>
      </view>

      <text class="card-flip-hint">轻触卡片 · 查看积分规则 ↻</text>
    </view>

    <!-- 背面：积分规则 -->
    <view class="asset-face asset-back">
      <view class="card-texture back"></view>
      <view class="back-strip"></view>

      <view class="back-head">
        <view class="back-head-left">
          <text class="back-en">HOW TO EARN</text>
          <text class="back-cn">积分规则</text>
        </view>
        <text class="back-seal">SSOT</text>
      </view>

      <view class="back-detail">
        <view class="rd-row">
          <text class="rd-label">获取规则</text>
          <text class="rd-text">线上确认收货后、门店消费时，{{earnRuleText}}</text>
        </view>
        <view class="rd-row">
          <text class="rd-label">积分兑换</text>
          <text class="rd-text">{{exchangeRuleText}}</text>
        </view>
        <view class="rd-row">
          <text class="rd-label">成长值</text>
          <text class="rd-text">赠分同时等额累计成长值，用于会员等级成长</text>
        </view>
        <view class="rd-row" wx:if="{{storeRule.roundMode === 'floor'}}">
          <text class="rd-label">取整方式</text>
          <text class="rd-text">不足 ¥{{storeRule.thresholdText}} 的部分不计入</text>
        </view>
        <view class="rd-row" wx:if="{{storeRule.revokeWindowDays}}">
          <text class="rd-label">退还规则</text>
          <text class="rd-text">退货退款由门店在 {{storeRule.revokeWindowDays}} 天内撤销</text>
        </view>
      </view>

      <text class="card-flip-hint">轻触卡片 · 返回积分余额 ↻</text>
    </view>
  </view>

  <!-- 我的累计（常显，不随卡片翻转） -->
  <view class="asset-meta">
    <text class="rm-item">线上消费累计 <text class="rm-val">¥{{onlineSpendTotal}}</text></text>
    <text class="rm-dot">·</text>
    <text class="rm-item">门店消费累计 <text class="rm-val">¥{{storeSpendTotal}}</text></text>
    <block wx:if="{{platformSpendTotal > 0}}">
      <text class="rm-dot">·</text>
      <text class="rm-item">平台订单累计 <text class="rm-val">¥{{platformSpendTotal}}</text></text>
    </block>
    <text class="rm-dot">·</text>
    <text class="rm-item">累计获赠 <text class="rm-val">{{storePointsTotal}}</text> 分</text>
  </view>

  <!-- 订单认领入口（表单已迁至独立页） -->
  <view class="claim-entry" hover-class="claim-entry-press" hover-stay-time="80" bindtap="goOrderClaim">
    <view class="claim-entry-text">
      <text class="claim-entry-en">ORDER CLAIM</text>
      <text class="claim-entry-cn">去订单认领</text>
      <text class="claim-entry-desc">门店小票 / 外部平台订单兑积分</text>
    </view>
    <text class="claim-entry-arr">→</text>
  </view>

  <!-- 2. 极简 Tab 导航 (解决拥挤) -->
  <view class="tab-navbar">
    <view hover-class="tap-press-soft" hover-stay-time="80" class="tab-item {{curTab===0?'active':''}}" bindtap="switchTab" data-idx="0">
      <text>兑换大厅</text>
      <view class="indicator" wx:if="{{curTab===0}}"></view>
    </view>
    <view class="tab-divider"></view>
    <view hover-class="tap-press-soft" hover-stay-time="80" class="tab-item {{curTab===1?'active':''}}" bindtap="switchTab" data-idx="1">
      <text>我的兑换</text>
      <view class="indicator" wx:if="{{curTab===1}}"></view>
    </view>
    <view class="tab-divider"></view>
    <view hover-class="tap-press-soft" hover-stay-time="80" class="tab-item {{curTab===2?'active':''}}" bindtap="switchTab" data-idx="2">
      <text>积分明细</text>
      <view class="indicator" wx:if="{{curTab===2}}"></view>
    </view>
  </view>

  <!-- 3. 内容区域 -->
  <view class="content-area">
    
    <!-- Tab 0: 兑换大厅 -->
    <block wx:if="{{curTab===0}}">
      
      <!-- 🟢 保留并优化的经典标题 -->
      <view class="section-header">
         <view class="line-l"></view>
         <view class="title-group">
           <text class="en">TREASURY ARCHIVES</text>
           <text class="cn">山海造物 · 品牌礼遇</text>
         </view>
         <view class="line-r"></view>
      </view>
      
      <view class="reward-grid">
        <block wx:for="{{rewards}}" wx:key="_id">
          <view hover-class="tap-press-soft" hover-stay-time="80" class="reward-card" bindtap="redeem" 
                data-id="{{item._id}}" data-cost="{{item.cost}}" 
                data-type="{{item.type}}" data-title="{{item.title}}" data-image="{{item.image}}">
            
            <view class="img-box">
              <image src="{{item.image}}" mode="aspectFill" lazy-load></image>
              <!-- 标签优化：更小的衬线体标签 -->
              <view class="type-badge">{{item.type === 'coupon' ? 'COUPON' : (item.type === 'virtual' ? 'DIGITAL' : 'PHYSICAL')}}</view>
              <view class="sold-out-mask" wx:if="{{item.stock <= 0}}">SOLD OUT</view>
            </view>

            <view class="info-box">
              <text class="r-title">{{item.title}}</text>
              <text class="r-desc">{{item.description}}</text>
              
              <view class="r-footer">
                <view class="cost-group">
                  <text class="val">{{item.cost}}</text>
                  <text class="unit">PTS</text>
                </view>
                <!-- 按钮改为更精致的空心按钮 -->
                <view class="btn-outline {{points < item.cost || item.stock <= 0 ? 'disabled' : ''}}">
                  兑换
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
      
      <view class="empty-tip" wx:if="{{rewards.length === 0 && !loading}}">
        <text>{{loadError ? '权益加载失败' : '暂无权益上架'}}</text>
        <view hover-class="tap-press" hover-stay-time="80" class="empty-retry" wx:if="{{loadError}}" bindtap="loadRewards">重新加载</view>
        <view hover-class="tap-press" hover-stay-time="80" class="empty-guide" wx:else bindtap="goOrderClaim">去订单认领攒积分</view>
      </view>
    </block>

<!-- Tab 1: 我的兑换 -->
<block wx:if="{{curTab===1}}">
      <view class="my-list">
        <block wx:for="{{myRewards}}" wx:key="_id">
          <view class="my-card">
            <image class="my-thumb" src="{{item.products[0].image}}" mode="aspectFill"></image>
            <view class="my-info">
              <view class="my-top">
                <text class="my-title">{{item.products[0].title}}</text>
              </view>
              <text class="my-meta">{{item.formatTime}} · 消耗 {{item.costPoints}} 积分</text>
              
              <view class="my-action-row">
                <text class="status-txt gray">兑换成功</text>
                
                <!-- 🟢 差异化按钮 -->
                
                <!-- A. 优惠券：去券夹 -->
                <view hover-class="tap-press" hover-stay-time="80" class="btn-small" 
                      wx:if="{{item.products[0].latin === 'COUPON'}}"
                      catchtap="goToWallet">
                  查看礼券夹
                </view>

                <!-- B. 虚拟商品：核销码 -->
                <view hover-class="tap-press" hover-stay-time="80" class="btn-small" 
                      wx:elif="{{item.products[0].latin === 'VIRTUAL' && item.status === 'unverified'}}"
                      catchtap="showCode" data-id="{{item._id}}" data-title="{{item.products[0].title}}">
                  核销码
                </view>

                <!-- C. 实物商品：看物流 -->
                <view hover-class="tap-press" hover-stay-time="80" class="btn-track" 
                      wx:elif="{{item.products[0].latin === 'GOODS'}}"
                      catchtap="goToOrder" data-id="{{item._id}}">
                  进度
                </view>
              </view>
            </view>
          </view>
        </block>
        <view class="empty-tip" wx:if="{{myRewards.length === 0}}">
          <text>{{myRewardsError ? '兑换记录加载失败' : '暂无兑换记录'}}</text>
          <view hover-class="tap-press" hover-stay-time="80" class="empty-retry" wx:if="{{myRewardsError}}" bindtap="loadMyRewards">重新加载</view>
        </view>
      </view>
    </block>

    <!-- Tab 2: 积分明细（2026-09-18 需求 8：筛选 + 时间轴 + 分页）-->
    <block wx:if="{{curTab===2}}">
      <view class="pt-ledger">
        <!-- 口径 + 筛选：全部 / 获得 / 消耗（服务端过滤，计数才准） -->
        <view class="pt-ledger-head">
          <view class="pt-ledger-filters">
            <view hover-class="tap-press" hover-stay-time="80" class="pt-filter {{recordsFilter===''?'is-on':''}}" bindtap="setRecordsFilter" data-type="">全部</view>
            <view hover-class="tap-press" hover-stay-time="80" class="pt-filter {{recordsFilter==='earn'?'is-on':''}}" bindtap="setRecordsFilter" data-type="earn">获得</view>
            <view hover-class="tap-press" hover-stay-time="80" class="pt-filter {{recordsFilter==='spend'?'is-on':''}}" bindtap="setRecordsFilter" data-type="spend">消耗</view>
          </view>
          <text class="pt-ledger-cap" wx:if="{{recordsCap}}">{{recordsCap}}</text>
        </view>
        <view class="pt-ledger-sums" wx:if="{{records.length}}">
          <text class="pt-sum is-plus">获得 +{{recordsEarn}}</text>
          <text class="pt-sum is-minus" wx:if="{{recordsSpend}}">消耗 −{{recordsSpend}}</text>
          <text class="pt-sum is-hint">仅统计已加载部分</text>
        </view>

        <!-- 时间轴：月带 + 日组（组头为当日净积分） -->
        <view class="pt-ledger-timeline" wx:if="{{records.length}}">
          <block wx:for="{{recordsTimeline}}" wx:key="key">
            <view class="pt-ledger-month" wx:if="{{item.kind === 'month'}}">
              <text class="pt-ledger-month-text">{{item.label}}</text>
              <view class="pt-ledger-month-rule"></view>
            </view>

            <view class="pt-ledger-day" wx:else>
              <view class="pt-ledger-day-head">
                <text class="pt-ledger-day-label">{{item.label}}</text>
                <text class="pt-ledger-day-week" wx:if="{{item.week}}">{{item.week}}</text>
                <view class="pt-ledger-day-spacer"></view>
                <text class="pt-ledger-day-net {{item.netTone}}" wx:if="{{item.netText}}">{{item.netText}}</text>
                <!-- 分页未完的那一天：当日净额算不出来，宁可不给也不谎报 -->
                <text class="pt-ledger-day-net is-open" wx:elif="{{!item.complete}}">未完</text>
              </view>

              <view class="pt-ledger-rows">
                <view class="pt-ledger-row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="_id">
                  <view class="pt-ledger-rail" aria-hidden="true">
                    <view class="pt-ledger-dot {{row.toneClass}}"></view>
                  </view>
                  <view class="pt-ledger-main">
                    <view class="pt-ledger-top">
                      <text class="pt-ledger-title">{{row.title}}</text>
                      <text class="pt-ledger-clock">{{row.clockText}}</text>
                    </view>
                    <view class="pt-ledger-meta">
                      <text class="pt-ledger-tag" wx:if="{{row.typeText}}">{{row.typeText}}</text>
                      <text class="pt-ledger-pending" wx:if="{{row.statusText}}">{{row.statusText}}</text>
                    </view>
                  </view>
                  <view class="pt-ledger-side">
                    <text class="pt-ledger-points {{row.toneClass}}">{{row.pointsText}}</text>
                    <text class="pt-ledger-balance" wx:if="{{row.balanceText}}">{{row.balanceText}}</text>
                  </view>
                </view>
              </view>
            </view>
          </block>
        </view>

        <view class="pt-ledger-more" wx:if="{{recordsHasMore}}" bindtap="loadMoreRecords" hover-class="pt-ledger-more-press">
          {{recordsLoadingMore ? '加载中…' : '加载更多'}}
        </view>
        <text class="pt-ledger-fin" wx:elif="{{records.length && !recordsLoading}}">· 已到最早一笔 ·</text>

        <view class="empty-tip" wx:if="{{records.length === 0 && !recordsLoading}}">
          <text>{{recordsError ? '明细加载失败' : '暂无积分变动'}}</text>
          <view hover-class="tap-press" hover-stay-time="80" class="empty-retry" wx:if="{{recordsError}}" bindtap="loadRecords">重新加载</view>
        </view>
      </view>
    </block>

  </view>

  <view class="copyright">
    <text class="cr-cn">山海造物</text>
    <text class="cr-en">NATURE'S CREATIONS</text>
  </view>

  <!-- 核销码：仪式卡（ui-pop-*，docs/弹层视觉规范_2026-10-13.md） -->
  <view class="ui-pop-mask is-center is-deep qr-mask" wx:if="{{showQrModal}}" bindtap="closeCode" catchtouchmove="true">
    <view class="ui-pop-dialog qr-content" catchtap="true">
      <view class="ui-pop-head is-center">
        <view class="qr-live-row">
          <view class="signal-light blink"></view>
          <text class="ui-pop-kicker">REDEEM CODE</text>
        </view>
        <text class="ui-pop-title">{{currentTitle}}</text>
      </view>
      <view class="ui-pop-close" bindtap="closeCode" hover-class="tap-press" hover-stay-time="80">✕</view>
      <view class="qr-box">
        <canvas type="2d" id="redeemQrCanvas" class="qr-code-img" style="width: 400rpx; height: 400rpx;"></canvas>
      </view>
      <view class="qr-footer">
        <text class="hint">请向店员出示此码核销权益</text>
      </view>
    </view>
  </view>

  <!-- 兑换代金券二次确认 -->
  <view class="ui-pop-mask is-center ex-mask" wx:if="{{showExchangeConfirm}}" bindtap="closeExchangeConfirm" catchtouchmove="true">
    <view class="ui-pop-dialog ex-modal" catchtap="noop">
      <view class="ui-pop-head">
        <text class="ui-pop-kicker">CONFIRM EXCHANGE</text>
        <text class="ui-pop-title">确认兑换礼券</text>
      </view>
      <view class="ex-body" wx:if="{{exchangeTarget}}">
        <text class="ex-name">{{exchangeTarget.title}}</text>
        <text class="ex-cost">消耗 {{exchangeTarget.cost}} 积分</text>
        <text class="ex-line" wx:if="{{exchangeTarget.value}}">面额 ¥{{exchangeTarget.value}}</text>
        <text class="ex-line" wx:if="{{exchangeTarget.minSpend}}">使用门槛：满 ¥{{exchangeTarget.minSpend}} 可用</text>
        <text class="ex-line">有效期：兑换后 {{exchangeTarget.expireDays}} 天内有效</text>
        <text class="ex-usage" wx:if="{{exchangeTarget.usageText}}">{{exchangeTarget.usageText}}</text>
        <text class="ex-hint">{{exchangeConfirmHint}}</text>
      </view>
      <view class="ui-pop-foot">
        <view class="ui-pop-btn is-ghost" bindtap="closeExchangeConfirm" hover-class="tap-press" hover-stay-time="80">取消</view>
        <view class="ui-pop-btn is-primary" bindtap="confirmExchangeCoupon" hover-class="tap-press" hover-stay-time="80">确认兑换</view>
      </view>
    </view>
  </view>

  <coupon-print-mint
    visible="{{showCouponPrint}}"
    title="{{printCoupon.title}}"
    value="{{printCoupon.value}}"
    minSpend="{{printCoupon.minSpend}}"
    expireDate="{{printCoupon.expireDate}}"
    channel="{{printCoupon.channel}}"
    bind:close="closeCouponPrint"
    bind:gowallet="goWalletFromPrint"
  />

</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal；utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
