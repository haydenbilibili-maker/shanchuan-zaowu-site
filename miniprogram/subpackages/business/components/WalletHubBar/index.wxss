/* 组件宿主：自定义组件默认 inline，父容器 align-items:center 时不会被拉伸，
   内部 .whb{width:100%} 会失去参照 → 三个 tab 塌缩重叠（积分页实测踩到）。
   显式声明块级 + 100% 宽，保证任何父容器下都占满一行。 */
:host {
  display: block;
  width: 100%;
}

/* 钱包 | 券夹 分段（WalletHubBar · 钱包枢纽） */
@import "../../../../styles/badges.wxss";

/* 页头：字号与钱包页原 .account-nav-title / -sub 完全一致（34rpx/600 + 18rpx 铜金） */
.whb-head {
  min-height: 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: var(--space-4);
  box-sizing: border-box;
}
.whb-title {
  font-size: 34rpx;
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
}
.whb-overline {
  font-size: 18rpx;
  color: var(--brass-400);
  letter-spacing: 0.12em;
  margin-top: 4rpx;
}

.whb {
  width: 100%;
  padding: 16rpx 0 8rpx;
  background: #1A1814;
  box-sizing: border-box;
}

.whb-seg {
  display: flex;
  align-items: stretch;
  background: #1F1D1A;
  border: 1px solid #262320;
  border-radius: 16rpx;
  overflow: visible;
}

.whb-item {
  flex: 1;
  width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 20rpx 12rpx 24rpx;
  box-sizing: border-box;
}

.whb-item-press {
  opacity: 0.82;
  transform: scale(0.98);
}

.whb-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.whb-cn-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 34rpx;
}

.whb-cn {
  font-size: 28rpx;
  font-weight: 500;
  color: #A09A90;
  letter-spacing: 0.04em;
  line-height: 34rpx;
  text-align: center;
}

.whb-en {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.12em;
  line-height: 1.2;
  text-align: center;
}

.whb-item.is-on .whb-cn {
  color: #C4A76C;
}

.whb-item.is-on .whb-en {
  color: #8A7530;
}

.whb-badge-pos {
  position: absolute;
  top: -10rpx;
  left: 100%;
  margin-left: 2rpx;
  z-index: 2;
}

.whb-ind {
  position: absolute;
  left: 28%;
  right: 28%;
  bottom: 0;
  height: 4rpx;
  background: #C4A76C;
  border-radius: 4rpx 4rpx 0 0;
}

.whb-split {
  width: 1px;
  align-self: stretch;
  margin: 16rpx 0;
  background: #262320;
  flex-shrink: 0;
}
