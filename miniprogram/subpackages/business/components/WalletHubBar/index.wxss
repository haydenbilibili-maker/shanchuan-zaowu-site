/* 组件宿主：自定义组件默认 inline，父容器 align-items:center 时不会被拉伸，
   内部 .whb{width:100%} 会失去参照 → 三个 tab 塌缩重叠（积分页实测踩到）。
   显式声明块级 + 100% 宽，保证任何父容器下都占满一行。 */
:host {
  display: block;
  width: 100%;
}

/* 钱包 | 券夹 分段（WalletHubBar · 钱包枢纽） */
@import "../../../../styles/badges.wxss";

/* 页头：字号与钱包页原 .account-nav-title / -sub 完全一致（34rpx/600 + 18rpx 铜金） */
.whb-head {
  min-height: 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: var(--space-4);
  box-sizing: border-box;
}
.whb-title {
  font-size: var(--fs-34);
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
}
.whb-overline {
  margin-top: 4rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.whb {
  width: 100%;
  padding: 16rpx 0 8rpx;
  background: #1A1814;
  box-sizing: border-box;
}

/* 2026-10-17 视觉对齐：圆角分段框 → 下划线页签（与全站页签同口径：选中 = 暖白宋体 + 金色下划线） */
.whb-seg {
  display: flex;
  align-items: stretch;
  margin: 0 var(--space-4);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  overflow: visible;
}

.whb-item {
  flex: 1;
  width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 20rpx 12rpx 24rpx;
  box-sizing: border-box;
}

.whb-item-press {
  opacity: 0.8;
}

.whb-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.whb-cn-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 34rpx;
}

.whb-cn {
  font-size: var(--fs-28);
  font-weight: 500;
  color: #A09A90;
  letter-spacing: 0.04em;
  line-height: 34rpx;
  text-align: center;
}

.whb-en {
  margin-top: 6rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-16);
  color: rgba(160, 154, 144, 0.8);
  letter-spacing: 0.24em;
  line-height: 1.2;
  text-align: center;
}

.whb-item.is-on .whb-cn {
  color: #F3ECDD;
  font-family: var(--font-brand);
  font-weight: 600;
}

.whb-item.is-on .whb-en {
  color: var(--brass-300);
}

.whb-badge-pos {
  position: absolute;
  top: -10rpx;
  left: 100%;
  margin-left: 2rpx;
  z-index: 2;
}

.whb-ind {
  position: absolute;
  left: 26%;
  right: 26%;
  bottom: -1rpx;
  height: 3rpx;
  background: var(--brass-400);
}

