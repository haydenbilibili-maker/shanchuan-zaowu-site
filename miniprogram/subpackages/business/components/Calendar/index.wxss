/* components/Calendar/index.wxss */
.calendar-container {
  background: linear-gradient(135deg, rgba(0,0,0,0.95), rgba(15,15,15,0.9));
  border: 2px solid rgba(196, 167, 108,0.25);
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx;
  backdrop-filter: blur(12px) saturate(150%);
  box-shadow:
    0 8rpx 24rpx rgba(0,0,0,0.6),
    inset 0 1rpx 3rpx rgba(255,255,255,0.08);
}

/* 月份导航 */
.calendar-header {
  margin-bottom: 32rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  border: 2px solid rgba(196, 167, 108,0.3);
  border-radius: 50%;
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  backdrop-filter: blur(8px);
}

.nav-btn:active {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.3), rgba(196, 167, 108,0.15));
  border-color: rgba(196, 167, 108,0.5);
  transform: scale(0.95);
}

.nav-icon {
  font-size: var(--fs-48);
  color: var(--color-primary);
  font-weight: bold;
  text-shadow: none;
}

.month-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.year {
  font-size: var(--fs-24);
  color: rgba(196, 167, 108,0.7);
  font-family: var(--font-mono);
  letter-spacing: 2rpx;
}

.month {
  font-size: var(--fs-36);
  color: #fff;
  font-weight: 700;
  font-family: var(--font-latin);
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
  letter-spacing: 2rpx;
}

/* 星期标题 */
.week-header {
  display: flex;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108,0.15);
  padding-bottom: 16rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: var(--fs-24);
  color: rgba(196, 167, 108,0.8);
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 日期网格 */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.calendar-day {
  width: calc((100% - 48rpx) / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: var(--radius-md);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  background: rgba(0,0,0,0.3);
  border: 2px solid transparent;
}

.calendar-day.prev,
.calendar-day.next {
  opacity: 0.3;
}

.calendar-day.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.calendar-day.today {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.1));
  border-color: rgba(196, 167, 108,0.4);
}

.calendar-day.selected {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.95), rgba(196, 167, 108,0.85));
  border-color: var(--color-primary);
  box-shadow:
    inset 0 1rpx 3rpx rgba(255,255,255,0.3);
  transform: scale(1.1);
}

.calendar-day.full {
  background: linear-gradient(135deg, rgba(255,0,0,0.2), rgba(255,0,0,0.1));
  border-color: rgba(255,0,0,0.3);
}

.calendar-day:active:not(.disabled) {
  transform: scale(0.95);
}

.day-number {
  font-size: var(--fs-28);
  color: #fff;
  font-weight: 600;
  z-index: 1;
}

.calendar-day.disabled .day-number {
  color: rgba(255,255,255,0.3);
}

.calendar-day.selected .day-number {
  color: var(--color-bg);
  font-weight: 800;
}

.day-status {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
}

.status-dot {
  font-size: var(--fs-16);
  color: rgba(255,0,0,0.8);
  font-weight: 700;
}

.selected-dot {
  color: var(--color-bg);
  font-size: var(--fs-20);
}

/* 图例 */
.calendar-legend {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(196, 167, 108,0.15);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2px solid;
}

.legend-dot.today {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.1));
  border-color: rgba(196, 167, 108,0.4);
}

.legend-dot.available {
  background: rgba(0,0,0,0.3);
  border-color: rgba(196, 167, 108,0.3);
}

.legend-dot.full {
  background: linear-gradient(135deg, rgba(255,0,0,0.2), rgba(255,0,0,0.1));
  border-color: rgba(255,0,0,0.3);
}

.legend-dot.disabled {
  background: rgba(0,0,0,0.3);
  border-color: transparent;
  opacity: 0.4;
}

.legend-text {
  font-size: var(--fs-20);
  color: rgba(255,255,255,0.7);
  letter-spacing: 1rpx;
}

/* 按压态（组件样式隔离，拿不到 app.wxss 的同名类；值与 app.wxss 一致） */
.tap-press { opacity: 0.72; }
.tap-press-soft { opacity: 0.86; }
