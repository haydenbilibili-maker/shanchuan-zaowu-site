  font-size: 28rpx;
  line-height: 1.5;
  text-align: left;
  position: relative;
  z-index: 1;
}
.push-radio-row { flex: 1; justify-content: flex-end; }
.card-dim { opacity: 0.92; border-color: rgba(196, 167, 108, 0.15); }
.msg-estimate { font-size: 22rpx; color: #C4A76C; padding: 8rpx 4rpx 16rpx; opacity: 0.85; }
.radio-label { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #ccc; margin-right: 24rpx; }

/* 发货弹窗 */
.ship-modal-panel .modal-body { padding-bottom: 24rpx; }
.ship-order-hint { font-size: 24rpx; color: #888; margin-bottom: 30rpx; padding-left: 10rpx; }
.ship-order-no { color: #C4A76C; font-weight: bold; }
.ship-form-row { margin-top: 20rpx; align-items: center; }
.ship-form-row > text { flex-shrink: 0; }
.ship-field-input,
.ship-tracking-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  text-align: left !important;
}
.ship-input-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ship-form-row-tracking .ship-input-wrap { width: 100%; }
.icon-btn-scan {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108, 0.12);
  border-radius: 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.35);
}
.icon-btn-scan:active { opacity: 0.75; }
.scan-icon { font-size: 36rpx; line-height: 1; }

/* 标本养护 CMS */
.care-guide-card .m-info.full { width: 100%; }
.care-summary-line {
  flex: 1;
  font-size: 24rpx !important;
  color: #999 !important;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.care-guide-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.preview-btn {
  font-size: 22rpx;
  color: #C4A76C;
  padding: 8rpx 16rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 8rpx;
}
.empty-hint {
  text-align: center;
  padding: 48rpx 32rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.55;
}
.form-hint {
  display: block;
  font-size: 20rpx;
  color: #666;
  margin: -8rpx 0 12rpx;
  padding-left: 8rpx;
  line-height: 1.5;
}
.textarea.mono { font-family: monospace; }