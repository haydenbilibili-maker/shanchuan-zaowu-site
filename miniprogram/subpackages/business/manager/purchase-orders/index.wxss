.page {
  min-height: 100vh;
  background: #f7f5f0;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e8e4dc;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab.on {
  color: #2d6a4f;
  font-weight: 600;
  border-bottom: 4rpx solid #d4af37;
}

.panel {
  padding: 24rpx;
}

.filter-row {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #e8e4dc;
}

.chip.on {
  background: #2d6a4f;
  color: #fff;
  border-color: #2d6a4f;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 44, 44, 0.04);
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ono {
  font-weight: 600;
  font-size: 28rpx;
  color: #2c2c2c;
}

.st {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #eee;
  color: #666;
}

.st-submitted { background: #fff3cd; color: #8a6d00; }
.st-confirmed { background: #d8f3dc; color: #2d6a4f; }
.st-draft { background: #eee; }
.st-cancelled { background: #f8d7da; color: #842029; }

.row-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
}

.row-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.btn-gold {
  background: #faf6eb !important;
  color: #8b6914 !important;
  border: 1rpx solid #d4af37 !important;
}

.btn-gold.solid {
  background: #d4af37 !important;
  color: #fff !important;
}

.hint, .empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.field {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.picker, .input {
  font-size: 28rpx;
  color: #2c2c2c;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
}

.seg {
  margin: 24rpx 0 12rpx;
  font-size: 24rpx;
  color: #999;
  letter-spacing: 2rpx;
}

.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}

.cat-name {
  display: block;
  font-size: 26rpx;
  color: #2c2c2c;
}

.cat-price {
  font-size: 22rpx;
  color: #8b6914;
}

.qty {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.q {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8e4dc;
  font-size: 24rpx;
}

.footer-bar button {
  margin: 0;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 70vh;
  overflow: auto;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.line {
  font-size: 26rpx;
  padding: 8rpx 0;
  color: #444;
}

.btn-close {
  margin-top: 24rpx;
}
