<!-- 藏品录入弹窗 (优化版) -->
<view class="modal-mask" wx:if="{{showProductModal}}">
    <view class="modal-panel">
      <view class="modal-head"><text>{{isEditing?'编辑':'录入'}}藏品</text><view class="close-btn" bindtap="closeModal">✕</view></view>
      <scroll-view scroll-y class="modal-body">
        
        <!-- 🟢 优化后的上传区域 -->
        <view class="upload-area" bindtap="chooseProductImage">
          <image wx:if="{{tempProduct.tempImg}}" src="{{tempProduct.tempImg}}" mode="aspectFill"></image>
          <view wx:else class="placeholder"><text>点击上传封面</text></view>
        </view>

        <view class="form-group">
          <view class="form-row"><text>名称</text><input value="{{tempProduct.title}}" bindinput="bindPInput" data-field="title" placeholder="请输入藏品名称"/></view>
          
          <!-- 级联分类（categories 集合） -->
          <view class="form-row">
             <text>分类</text>
             <view class="picker-group">
               <picker mode="selector" range="{{rootNames}}" value="{{tempProduct.rootCategoryIndex >= 0 ? tempProduct.rootCategoryIndex : 0}}" bindchange="bindRootCatChange">
                 <view class="picker-s">{{tempProduct.rootCategoryName || '所属馆'}}</view>
               </picker>
               <text style="color:#666;">›</text>
               <picker mode="selector" range="{{subNames}}" value="{{tempProduct.subCategoryIndex >= 0 ? tempProduct.subCategoryIndex : 0}}" bindchange="bindSubCatChange" disabled="{{subNames.length===0}}">
                 <view class="picker-s {{subNames.length===0?'disabled':''}}">{{tempProduct.category || '具体分类'}}</view>
               </picker>
             </view>
          </view>

          <view class="form-row"><text>进货价</text><input type="digit" value="{{tempProduct.costPrice}}" bindinput="bindPInput" data-field="costPrice" placeholder="0.00"/></view>
          <view class="form-row"><text>销售价</text><input type="digit" value="{{tempProduct.price}}" bindinput="bindPInput" data-field="price" placeholder="0.00"/></view>
          <view class="form-row"><text>库存</text><input type="number" value="{{tempProduct.stock}}" bindinput="bindPInput" data-field="stock" placeholder="1" disabled="{{tempProduct.hasSku}}"/></view>

          <view class="form-row"><text>多规格</text><switch checked="{{tempProduct.hasSku}}" color="#C4A76C" bindchange="bindPHasSku" style="transform:scale(0.7)"/></view>
          <block wx:if="{{tempProduct.hasSku}}">
            <view class="form-row"><text>规格维度</text><input value="{{tempProduct.skuDimensionsStr}}" bindinput="bindPInput" data-field="skuDimensionsStr" placeholder="如：尺寸,装裱（用逗号分隔）"/></view>
            <view class="sku-editor" wx:for="{{tempProduct.skus}}" wx:key="id">
              <input class="sku-input" placeholder="规格（多维用 / 分隔，如 30cm / 金框）" value="{{item.specLabel}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="specLabel"/>
              <input class="sku-input sm" type="digit" placeholder="价格" value="{{item.price}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="price"/>
              <input class="sku-input sm" type="number" placeholder="库存" value="{{item.stock}}" bindinput="bindSkuInput" data-index="{{index}}" data-field="stock"/>
              <text class="sku-del" bindtap="removeSkuRow" data-index="{{index}}">删</text>
            </view>
            <view class="btn-add-sku" bindtap="addSkuRow">+ 添加规格</view>
          </block>
          
          <view class="form-row"><text>镇店之宝</text><switch checked="{{tempProduct.isTreasure}}" color="#C4A76C" bindchange="bindPTreasure" style="transform:scale(0.7)"/></view>
          <view class="form-row"><text>支持定制</text><switch checked="{{tempProduct.supportsCustom !== false}}" color="#C4A76C" bindchange="bindPSupportsCustom" style="transform:scale(0.7)"/></view>

          <view class="form-section-label">合规标识</view>
          <view class="form-row">
            <text>三有 / 保护物种</text>
            <picker mode="selector" range="{{protectionTypeOptions}}" value="{{protectionTypeIndex}}" bindchange="bindProtectionTypeChange">
              <view class="picker-s">{{protectionTypeOptions[protectionTypeIndex] || '否'}}</view>
            </picker>
          </view>
          <block wx:if="{{tempProduct.protectionType && tempProduct.protectionType !== 'none'}}">
            <view class="form-label cert-required">收藏证书 *（必填）</view>
            <view class="cert-upload-area" bindtap="chooseCertificateImage">
              <image
                wx:if="{{tempProduct.tempCertificate || tempProduct.collectionCertificate}}"
                class="cert-preview"
                src="{{tempProduct.tempCertificate || tempProduct.collectionCertificate}}"
                mode="aspectFit"
              />
              <view wx:else class="cert-placeholder">
                <text class="cert-plus">+</text>
                <text>上传合法收藏证书</text>
              </view>
            </view>
            <view class="cert-actions" wx:if="{{tempProduct.tempCertificate || tempProduct.collectionCertificate}}">
              <text class="cert-reupload" bindtap="chooseCertificateImage">重新上传</text>
              <text class="cert-remove" bindtap="removeCertificateImage">删除</text>
            </view>
            <text class="cert-hint">三有或保护类标本须上传主管部门颁发的收藏/许可证明文件</text>
          </block>

          <view class="form-section-label">标本档案</view>
          <view class="form-row"><text>采集地</text><input value="{{tempProduct.origin}}" bindinput="bindPInput" data-field="origin" placeholder="如：云南西双版纳"/></view>
          <view class="form-row"><text>采集时间</text>
            <picker mode="date" value="{{tempProduct.collectDate}}" bindchange="bindPDateChange">
              <view class="picker-s">{{tempProduct.collectDate || '选择日期'}}</view>
            </picker>
          </view>
          <view class="form-row"><text>装裱师</text>
            <picker mode="selector" range="{{framerNames}}" bindchange="bindPFramerChange">
              <view class="picker-s">{{tempProduct.framerName || '选择装裱师'}}</view>
            </picker>
          </view>
          
          <view class="form-row"><text>尺寸 (cm)</text><view style="display:flex; gap:10rpx; flex:1; justify-content:flex-end;"><input class="input" style="text-align:center; border-bottom:1px solid #444; border-radius:0;" placeholder="长" value="{{tempProduct.sizeL}}" bindinput="bindPInput" data-field="sizeL"/><input class="input" style="text-align:center; border-bottom:1px solid #444; border-radius:0;" placeholder="宽" value="{{tempProduct.sizeW}}" bindinput="bindPInput" data-field="sizeW"/><input class="input" style="text-align:center; border-bottom:1px solid #444; border-radius:0;" placeholder="高" value="{{tempProduct.sizeH}}" bindinput="bindPInput" data-field="sizeH"/></view></view>
          
          <view class="form-row ai-row">
            <text class="{{productLatinRequired ? 'label-required' : ''}}">拉丁学名{{productLatinRequired ? ' *' : ''}}</text>
            <view class="ai-field-wrap">
              <input value="{{tempProduct.latinName}}" bindinput="bindPInput" data-field="latinName" placeholder="{{productLatinRequired ? '必填 · 建议使用 AI 补全' : '文创类可选'}}"/>
              <view class="ai-btn {{aiAssisting ? 'disabled' : ''}}" bindtap="assistProductWithAi">AI 补全</view>
            </view>
          </view>
          <text class="latin-hint" wx:if="{{productLatinRequired}}">标本类藏品须填写标准拉丁学名，可点击 AI 补全</text>

          <view class="form-section-label">科学分类</view>
          <view class="form-row"><text>界</text><input value="{{tempProduct.taxonomy.kingdom}}" bindinput="bindTaxonomyInput" data-field="kingdom" placeholder="如：动物界"/></view>
          <view class="form-row"><text>门</text><input value="{{tempProduct.taxonomy.phylum}}" bindinput="bindTaxonomyInput" data-field="phylum" placeholder="如：节肢动物门"/></view>
          <view class="form-row"><text>纲</text><input value="{{tempProduct.taxonomy.class}}" bindinput="bindTaxonomyInput" data-field="class" placeholder="如：昆虫纲"/></view>
          <view class="form-row"><text>目</text><input value="{{tempProduct.taxonomy.order}}" bindinput="bindTaxonomyInput" data-field="order" placeholder="可选"/></view>
          <view class="form-row"><text>科</text><input value="{{tempProduct.taxonomy.family}}" bindinput="bindTaxonomyInput" data-field="family" placeholder="可选"/></view>
          <view class="form-row"><text>属</text><input value="{{tempProduct.taxonomy.genus}}" bindinput="bindTaxonomyInput" data-field="genus" placeholder="可选"/></view>
          
          <textarea class="textarea" placeholder="请输入藏品描述..." value="{{tempProduct.description}}" bindinput="bindPInput" data-field="description"></textarea>

          <view class="form-label">详情长图（图文详情区展示，最多 9 张）</view>
          <view class="detail-images-grid">
            <view class="detail-img-item" wx:for="{{tempProduct.detailImages}}" wx:key="*this">
              <image src="{{item}}" mode="aspectFill"></image>
              <text class="img-del" catchtap="removeDetailImage" data-index="{{index}}">×</text>
            </view>
            <view class="detail-img-add" bindtap="chooseDetailImages" wx:if="{{!tempProduct.detailImages || tempProduct.detailImages.length < 9}}">
              <text>+ 添加</text>
            </view>
          </view>

          <view class="form-label">详情 HTML（可选，支持富文本）</view>
          <textarea class="textarea" placeholder="可粘贴 HTML 片段..." value="{{tempProduct.detailHtml}}" bindinput="bindPInput" data-field="detailHtml" style="height:200rpx; font-family:monospace; font-size:22rpx;"></textarea>
        </view>
      </scroll-view>
      <view class="modal-foot"><view class="btn-full" bindtap="submitProduct">确认保存</view></view>
    </view>
  </view>

