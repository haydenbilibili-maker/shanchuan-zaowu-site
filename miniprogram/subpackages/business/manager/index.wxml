         <view class="form-group">
            <view class="form-row"><text>等级(Lv)</text><input type="number" value="{{tempVip.level}}" bindinput="bindVInput" data-field="level" /></view>
            <view class="form-row"><text>折扣</text><input type="digit" value="{{tempVip.discount}}" bindinput="bindVInput" data-field="discount" placeholder="0.95"/></view>
            <view class="form-row"><text>名称</text><input value="{{tempVip.name}}" bindinput="bindVInput" data-field="name" /></view>
            <view class="form-row"><text>特权</text><textarea value="{{tempVip.privilegesStr}}" bindinput="bindVInput" data-field="privilegesStr" style="height:160rpx" placeholder="用逗号分隔"/></view>
         </view>
      </view>
      <view class="modal-foot"><view class="btn-full" bindtap="submitVipLevel">保存</view></view>
    </view>
  </view>
  
  <view class="verify-success-modal {{showVerifySuccess ? 'active' : ''}}">
    <view class="vs-content">
      <view class="vs-stamp-anim"><text>已核销</text></view>
      <text class="vs-tip">欢迎入馆参观</text>
      <view class="btn-small gold" bindtap="closeVerifyModal">完成</view>
    </view>
  </view>
  <view class="modal-mask" wx:if="{{showShipModal}}" catchtap="closeModal">
    <view class="modal-panel sm ship-modal-panel" catchtap="noop">
    <view class="modal-head">
      <text>发货信息录入</text>
      <view class="close-btn" catchtap="closeModal">✕</view>
    </view>

    <view class="modal-body">
      <view class="form-group">
        <view class="ship-order-hint">
          当前操作订单：<text class="ship-order-no">{{tempShip.orderNo}}</text>
        </view>
        
        <view class="form-row ship-form-row">
          <text>快递公司</text>
          <input 
            class="input ship-field-input"
            value="{{tempShip.carrier}}" 
            bindinput="bindShipInput" 
            data-field="carrier" 
            placeholder="例如: 顺丰速运"
            placeholder-class="input-placeholder"
            hold-keyboard="{{true}}"
          />
        </view>

        <view class="form-row ship-form-row ship-form-row-tracking">
          <text>物流单号</text>
          <view class="ship-input-wrap">
            <input 
              class="input ship-tracking-input"
              value="{{tempShip.trackingNumber}}" 
              bindinput="bindShipInput" 
              data-field="trackingNumber" 
              placeholder="输入或点击右侧扫码"
              placeholder-class="input-placeholder"
              confirm-type="done"
              hold-keyboard="{{true}}"
            />
            <view class="icon-btn-scan" catchtap="scanTrackingNumber">
              <text class="scan-icon">📷</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="modal-foot">
      <view class="btn-full" catchtap="submitShip">确认发出并通知</view>
    </view>
    </view>
  </view>

  <!-- 🟢 内容管理弹窗（统一专题+文章） -->
  <view class="modal-mask" wx:if="{{showContentModal}}" catchtap="closeModal">
    <view class="modal-panel" catchtap="">
      <view class="modal-head">
        <text>{{isEditing ? '编辑' : '新建'}}{{contentType === 'exhibition' ? '专题' : '文章'}}</text>
        <view class="close-btn" bindtap="closeModal">✕</view>
      </view>
      <scroll-view scroll-y class="modal-body">
        <view class="upload-area" bindtap="chooseContentImage">
          <image wx:if="{{tempContent.coverImage}}" src="{{tempContent.coverImage}}" mode="aspectFill"></image>
          <view wx:else class="placeholder"><text>点击上传封面</text></view>
        </view>
        <view class="form-group">
          <view class="form-row"><text>标题</text><input value="{{tempContent.title || ''}}" bindinput="bindContentInput" data-field="title" placeholder="请输入标题"/></view>

          <!-- 专题：AI 辅助创作 -->
          <block wx:if="{{contentType==='exhibition'}}">
            <view class="form-row">
              <text>创作方向</text>
              <input value="{{tempContent.themeHint || ''}}" bindinput="bindContentInput" data-field="themeHint" placeholder="可选：白垩纪、昆虫结构色、门店探店"/>
            </view>
            <view class="exhibition-ai-bar">
              <text class="exhibition-ai-tip">填写标题后，可一键生成英文副标、摘要与 HTML 正文</text>
              <view class="ai-btn {{aiAssisting ? 'disabled' : ''}}" bindtap="assistExhibitionWithAi">AI 创作</view>
            </view>
          </block>
          
          <!-- 专题特有 -->
          <view class="form-row" wx:if="{{contentType==='exhibition'}}">
            <text>副标/拉丁</text><input value="{{tempContent.latinName || ''}}" bindinput="bindContentInput" data-field="latinName" placeholder="如：THE GOLDEN AGE"/>
          </view>
          
          <!-- 文章特有 -->
          <view class="form-row" wx:if="{{contentType==='article'}}">
            <text>分类</text>
            <picker mode="selector" range="{{['📚 标本知识','🎨 艺术鉴赏','🔧 制作工艺','📖 藏品故事']}}" bindchange="bindContentCategoryChange">
              <view class="picker-s">{{tempContent.category==='knowledge'?'📚 标本知识':tempContent.category==='art'?'🎨 艺术鉴赏':tempContent.category==='craft'?'🔧 制作工艺':'📖 藏品故事'}}</view>
            </picker>
          </view>
          
          <view class="form-row" wx:if="{{contentType==='article'}}">
            <text>作者</text><input value="{{tempContent.author || ''}}" bindinput="bindContentInput" data-field="author" placeholder="默认：山海造物"/>
          </view>
          
          <view class="form-row" wx:if="{{contentType==='article'}}">
            <text>状态</text>
            <radio-group class="radio-row" bindchange="bindContentStatusChange">
              <radio color="#C4A76C" value="published" checked="{{tempContent.status==='published'}}"/>已发布
              <radio color="#C4A76C" value="draft" checked="{{tempContent.status==='draft'}}"/>草稿
            </radio-group>
          </view>
          
          <view class="form-row"><text>摘要</text><textarea class="textarea" value="{{tempContent.brief || ''}}" bindinput="bindContentInput" data-field="brief" placeholder="简短介绍" style="height:120rpx"/></view>
          <view class="form-row"><text>标签</text><input value="{{tempContent.tagsStr || ''}}" bindinput="bindContentInput" data-field="tagsStr" placeholder="用逗号分隔，如：昆虫,历史"/></view>
          <view class="form-row form-row-col" wx:if="{{contentType==='exhibition'}}">
            <text>关联藏品</text>
            <view class="related-products-field">
              <view class="related-list" wx:if="{{relatedProductPreview.length}}">
                <view class="related-item" wx:for="{{relatedProductPreview}}" wx:key="_id">
                  <image class="related-thumb" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}"></image>
                  <view class="related-meta">
                    <text class="related-title">{{item.title}}</text>
                    <text class="related-price" wx:if="{{!item.missing}}">¥{{item.price}}</text>
                    <text class="related-missing" wx:else>商品不存在</text>
                  </view>
                  <view class="related-remove" bindtap="removeRelatedProduct" data-id="{{item._id}}">移除</view>
                </view>
              </view>
              <view class="related-empty" wx:else>未关联商品，馆藏 A 区转化条不会显示</view>
              <view class="btn-pick-product" bindtap="openProductPicker">选择关联商品</view>
            </view>
          </view>
          <view class="form-row" wx:if="{{contentType==='article'}}"><text>视频链接</text><input value="{{tempContent.videoUrl || ''}}" bindinput="bindContentInput" data-field="videoUrl" placeholder="可选：文章视频链接"/></view>
          <view class="form-label">内容 (HTML)</view>
          <textarea class="textarea" value="{{tempContent.content || ''}}" bindinput="bindContentInput" data-field="content" placeholder="在此输入 HTML 内容..." style="height:400rpx; font-family:monospace; font-size:24rpx;"/>
        </view>
      </scroll-view>
      <view class="modal-foot"><view class="btn-full" bindtap="submitContent">保存</view></view>
    </view>
  </view>

  <!-- 关联商品选择器 -->
  <view class="modal-mask picker-mask" wx:if="{{showProductPicker}}" catchtap="closeProductPicker">
    <view class="modal-panel picker-panel" catchtap="">
      <view class="modal-head">
        <text>选择关联藏品</text>
        <view class="close-btn" bindtap="closeProductPicker">✕</view>
      </view>
      <view class="picker-search">
        <input
          value="{{productPickerKeyword}}"
          bindinput="onProductPickerSearch"
          placeholder="搜索商品名称"
          placeholder-class="input-placeholder"
        />
      </view>
      <scroll-view scroll-y class="picker-scroll">
        <view
          class="picker-row {{item.selected ? 'selected' : ''}}"
          wx:for="{{productPickerList}}"
          wx:key="_id"
          bindtap="togglePickerProduct"
          data-id="{{item._id}}"
        >
          <image class="picker-thumb" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}"></image>
          <view class="picker-info">
            <text class="picker-title">{{item.title}}</text>
            <text class="picker-sub">{{item.category}} · ¥{{item.price}}</text>
          </view>
          <view class="picker-check">{{item.selected ? '已选' : '选择'}}</view>
        </view>
        <view class="picker-empty" wx:if="{{!productPickerList.length}}">暂无商品</view>
      </scroll-view>
      <view class="modal-foot">
        <view class="btn-full" bindtap="confirmProductPicker">完成（{{tempContent.relatedProductIds.length || 0}}）</view>
      </view>
    </view>
  </view>

  <!-- 养护指南 CMS 弹窗 -->
  <view class="modal-mask" wx:if="{{showCareGuideModal}}" catchtap="closeCareGuideModal">
    <view class="modal-panel" catchtap="">
      <view class="modal-head">
        <text>{{isEditing ? '编辑' : '新建'}}养护指南</text>
        <view class="close-btn" bindtap="closeCareGuideModal">✕</view>
      </view>
      <scroll-view scroll-y class="modal-body">
        <view class="form-group">
          <view class="form-row">
            <text>品类</text>
            <picker mode="selector" range="{{careCategoryOptions}}" bindchange="bindCareGuideCategoryChange">
              <view class="picker-s">{{tempCareGuide.category || 'GENERAL'}}</view>
            </picker>
          </view>
          <view class="form-row"><text>标题</text><input value="{{tempCareGuide.title || ''}}" bindinput="bindCareGuideInput" data-field="title" placeholder="如：神奇昆虫 · 框画与展柜标本"/></view>
          <view class="form-row"><text>英文副标</text><input value="{{tempCareGuide.overline || ''}}" bindinput="bindCareGuideInput" data-field="overline" placeholder="INSECTA"/></view>
          <view class="form-row"><text>guideId</text><input value="{{tempCareGuide.guideId || ''}}" bindinput="bindCareGuideInput" data-field="guideId" placeholder="留空自动生成"/></view>
          <view class="form-row form-row-col"><text>养护摘要</text><textarea class="textarea" value="{{tempCareGuide.summary || ''}}" bindinput="bindCareGuideInput" data-field="summary" placeholder="一句话摘要" style="height:120rpx"/></view>
          <view class="form-row form-row-col"><text>免责声明</text><textarea class="textarea" value="{{tempCareGuide.disclaimer || ''}}" bindinput="bindCareGuideInput" data-field="disclaimer" placeholder="可选" style="height:100rpx"/></view>
          <view class="form-row">
            <text>状态</text>
            <radio-group class="radio-row" bindchange="bindCareGuideStatusChange">
              <radio color="#C4A76C" value="active" checked="{{tempCareGuide.status==='active'}}"/>启用
              <radio color="#C4A76C" value="draft" checked="{{tempCareGuide.status==='draft'}}"/>草稿
            </radio-group>
          </view>
          <view class="form-label">内容板块 JSON</view>
          <text class="form-hint">数组格式：[{"key":"environment","title":"适宜环境","body":"…","tips":["…"]}]</text>
          <textarea class="textarea mono" value="{{tempCareGuide.sectionsJson || ''}}" bindinput="bindCareGuideInput" data-field="sectionsJson" placeholder="[]" style="height:360rpx; font-family:monospace; font-size:22rpx;"/>
        </view>
      </scroll-view>
      <view class="modal-foot"><view class="btn-full" bindtap="submitCareGuide">保存</view></view>
    </view>
  </view>

  <!-- 评价回复弹窗（居中对话框，避免键盘顶起误触顶部返回） -->
  <view
    class="modal-mask comment-reply-mask"
    wx:if="{{showCommentReplyModal}}"
    catchtap="closeCommentReplyModal"
    catchtouchmove="noop"
  >
    <view class="comment-reply-panel" catchtap="noop">
      <view class="modal-head"><text>回复评价</text><view class="close-btn" catchtap="closeCommentReplyModal">✕</view></view>
      <view class="modal-body">
        <textarea
          class="textarea comment-reply-input"
          placeholder="输入商家回复..."
          value="{{tempCommentReply.content}}"
          bindinput="bindCommentReplyInput"
          adjust-position="{{false}}"
          hold-keyboard="{{true}}"
          confirm-type="done"
          maxlength="500"
          show-confirm-bar="{{true}}"
        ></textarea>
      </view>
      <view class="modal-foot"><view class="btn-full" catchtap="submitCommentReply">提交回复</view></view>
    </view>
  </view>

  <!-- 山海有信：推送确认 -->
  <view class="modal-mask" wx:if="{{showPushConfirm}}" catchtap="closePushConfirm">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-head"><text>确认发送</text><view class="close-btn" catchtap="closePushConfirm">✕</view></view>
      <view class="modal-body">
        <text class="p-name">将向约 {{pushEstimate}} 位藏家发送公告</text>
        <text class="addr-detail" style="margin-top:16rpx;display:block;">{{pushForm.title}}</text>
        <text class="addr-detail">{{pushForm.content}}</text>
      </view>
      <view class="modal-foot"><view class="btn-full" catchtap="submitPush">确认发送</view></view>
    </view>
  </view>

  <!-- 门店编辑 -->
  <view class="modal-mask" wx:if="{{showStoreEditModal}}" catchtap="closeStoreEditModal">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-head"><text>编辑门店 · {{tempStoreEdit.name}}</text><view class="close-btn" catchtap="closeStoreEditModal">✕</view></view>
      <scroll-view scroll-y class="modal-body">
        <view class="form-row"><text>名称</text><input value="{{tempStoreEdit.name}}" bindinput="bindStoreEditInput" data-field="name"/></view>
        <view class="form-row"><text>电话</text><input value="{{tempStoreEdit.phone}}" bindinput="bindStoreEditInput" data-field="phone"/></view>
        <view class="form-row"><text>营业开始</text><input value="{{tempStoreEdit.hoursOpen}}" bindinput="bindStoreEditInput" data-field="hoursOpen"/></view>
        <view class="form-row"><text>营业结束</text><input value="{{tempStoreEdit.hoursClose}}" bindinput="bindStoreEditInput" data-field="hoursClose"/></view>
        <view class="form-row"><text>简介</text><textarea class="textarea" value="{{tempStoreEdit.intro}}" bindinput="bindStoreEditInput" data-field="intro" style="height:120rpx"/></view>
        <view class="form-row"><text>到店提示</text><textarea class="textarea" value="{{tempStoreEdit.visitTipsText}}" bindinput="bindStoreEditInput" data-field="visitTipsText" placeholder="每行一条" style="height:160rpx"/></view>
      </scroll-view>
      <view class="modal-foot"><view class="btn-full" bindtap="saveStoreEdit">保存</view></view>
    </view>
  </view>

  <!-- 山海有信：留言回复 -->
  <view class="modal-mask" wx:if="{{showTicketReplyModal}}" catchtap="closeTicketReplyModal">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-head"><text>回复 · {{tempTicketReply.topicLabel}}</text><view class="close-btn" catchtap="closeTicketReplyModal">✕</view></view>
      <scroll-view scroll-y class="modal-body">
        <textarea class="textarea" maxlength="500" value="{{tempTicketReply.content}}" bindinput="bindTicketReplyInput" placeholder="回复内容将推送到用户山海有信" style="height:200rpx"/>
      </scroll-view>
      <view class="modal-foot"><view class="btn-full" bindtap="submitTicketReply">发送回复</view></view>
    </view>
  </view>
</view>