          <picker range="{{catManageRootNames}}" bindchange="bindCatParentChange">
            <view class="picker-s">{{catManageRootNames[newCatParentIndex] || '选择一级分类'}}</view>
          </picker>
        </view>
        <view class="form-row"><text>名称</text><input placeholder="中文名，如：蝴蝶" value="{{newCatName}}" bindinput="bindCatInput" data-field="name"/></view>
        <view class="form-row"><text>英文</text><input placeholder="如：BUTTERFLY" value="{{newCatEn}}" bindinput="bindCatInput" data-field="en"/></view>
      </view>
    </scroll-view>
    <view class="modal-foot"><view class="btn-full" bindtap="submitCategory">添加分类</view></view>
  </view>
</view>

