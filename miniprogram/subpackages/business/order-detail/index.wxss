/* pages/order-detail/index.wxss */
/* 继承 app.wxss */

page { 
  background-color: #1A1814; 
  color: #ccc; 
  font-family: "PingFang SC", sans-serif; 
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  /* 🟢 取消左右阻尼感，与其它页面保持一致 */
  overscroll-behavior-x: none;
  overflow-x: hidden;
}
view, text, image, button { box-sizing: border-box; }
.container { 
  padding: 30rpx;
  /* 🟢 取消左右阻尼感 */
  overscroll-behavior-x: none;
  overflow-x: hidden;
  width: 100%;
  max-width: 100%;
}

/* === 档案袋容器 === */
.archive-folder {
  background: #1F1D1A; border-radius: 16rpx; padding: 40rpx 30rpx 60rpx;
  position: relative; border: 1px solid rgba(255,255,255,0.1); 
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.6); overflow: hidden;
  opacity: 0; transform: scale(0.95); transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.archive-folder.active { opacity: 1; transform: scale(1); }

/* 顶部纹理 */
.archive-folder::before {
  content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 8rpx;
  background: repeating-linear-gradient(45deg, #333, #333 10rpx, #222 10rpx, #222 20rpx);
}

/* 动画类 */
.slide-in-delay-1 { opacity: 0; animation: slideIn 0.5s forwards 0.2s; }
.slide-in-delay-2 { opacity: 0; animation: slideIn 0.5s forwards 0.4s; }
.slide-in-delay-3 { opacity: 0; animation: slideIn 0.5s forwards 0.6s; }
@keyframes slideIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }

/* 头部 */
.folder-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30rpx; }
.fh-left, .fh-right { display: flex; flex-direction: column; }
.fh-right { align-items: flex-end; }
.fh-label { font-size: 18rpx; color: #666; letter-spacing: 1rpx; margin-bottom: 6rpx; font-weight: bold; }
.fh-label .en-label { 
  font-family: var(--font-din); 
  letter-spacing: 2rpx; 
  opacity: 0.6; 
  margin-right: 8rpx;
  font-size: 16rpx;
}
.fh-val { font-family: 'Courier New', monospace; font-size: 24rpx; color: #eee; letter-spacing: 1rpx; }
.fh-val.copy { text-decoration: underline; color: var(--gold); }
.divider-dashed { width: 100%; height: 0; border-top: 2rpx dashed #444; margin-bottom: 40rpx; }

/* 🟢 2. 物流标签 (航空信封风格) */
.shipping-label {
  background: #f4f4f0; /* 纸张白 */
  color: #333; 
  padding: 30rpx; 
  border-radius: 4rpx;
  margin-bottom: 40rpx; 
  transform: rotate(-1deg); /* 轻微歪斜，增加真实感 */
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.5); 
  position: relative;
  overflow: hidden;
  border: 1px solid #dcdcdc;
}

/* 顶部航空条纹装饰 */
.air-mail-border {
  position: absolute; top: 0; left: 0; right: 0; height: 10rpx;
  background: repeating-linear-gradient(
    45deg, 
    #c0392b, #c0392b 20rpx, 
    #fff 20rpx, #fff 40rpx, 
    #2980b9 40rpx, #2980b9 60rpx, 
    #fff 60rpx, #fff 80rpx
  );
}

.sl-header { 
  display: flex; justify-content: space-between; align-items: center;
  border-bottom: 2rpx solid #333; padding-bottom: 16rpx;
  margin-bottom: 20rpx; margin-top: 10rpx;
}
.sl-header text { font-size: 20rpx; font-weight: 900; letter-spacing: 1rpx; color: #c0392b; }
.sl-header .en-label {
  font-family: var(--font-din);
  letter-spacing: 2rpx;
  opacity: 0.7;
  margin-right: 8rpx;
  font-size: 18rpx;
}

.sl-carrier { display: flex; align-items: center; gap: 10rpx; }
.sl-carrier text { color: #333; font-weight: bold; }
.sl-icon { 
  width: 32rpx; 
  height: 32rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
}
.sl-icon image {
  width: 100%;
  height: 100%;
}

.sl-content { display: flex; flex-direction: column; gap: 16rpx; }

.sl-row { display: flex; align-items: baseline; }
.sl-lbl { 
  width: 140rpx; font-size: 18rpx; color: #888; font-weight: bold; 
  letter-spacing: 0.5rpx; 
}
.sl-lbl .en-label {
  font-family: 'DIN';
  letter-spacing: 1rpx;
  opacity: 0.6;
  margin-right: 4rpx;
  font-size: 16rpx;
}
.sl-val { font-size: 26rpx; color: #1A1814; font-weight: bold; flex: 1; }
.sl-val.code { font-family: 'Courier New', monospace; letter-spacing: 2rpx; text-decoration: underline; }

.sl-user-box { display: flex; align-items: baseline; gap: 10rpx; }
.sl-user { font-weight: 900; font-size: 28rpx; }
.sl-phone { font-family: 'DIN'; color: #555; }

.sl-addr { 
  font-size: 24rpx; line-height: 1.4; color: #333; 
  padding-left: 140rpx; margin-top: -8rpx; 
}

.sl-barcode { 
  font-family: 'Courier New', monospace; font-size: 24rpx; 
  letter-spacing: 4rpx; text-align: right; 
  opacity: 0.6; margin-top: 20rpx; transform: scaleY(0.6);
}

/* 确认收货按钮区域 */
.confirm-btn-area {
  margin-top: 30rpx; border-top: 1px dashed #ccc; padding-top: 20rpx;
  display: flex; justify-content: flex-end;
}
.btn-sign {
  background: #333; color: #C4A76C; 
  padding: 12rpx 30rpx; border-radius: 4rpx;
  display: flex; align-items: center; gap: 10rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
}
.btn-sign text { font-size: 22rpx; font-weight: bold; letter-spacing: 1rpx; }
.btn-arrow { font-family: serif; }

/* 清单 */
.section-title { 
  font-size: 22rpx; color: #ddd; letter-spacing: 1rpx; margin-bottom: 24rpx; 
  display: block; border-left: 6rpx solid var(--gold); padding-left: 12rpx; font-weight: bold;
}
.section-title .en-label {
  font-family: var(--font-din);
  letter-spacing: 2rpx;
  opacity: 0.6;
  margin-right: 8rpx;
  font-size: 20rpx;
}

.manifest-item { 
  display: flex; 
  background: #222; 
  padding: 20rpx; 
  border-radius: 8rpx; 
  margin-bottom: 20rpx; 
  border: 1px solid #333;
}

.m-img { width: 100rpx; height: 100rpx; background: #1A1814; border-radius: 4rpx; margin-right: 20rpx; flex-shrink: 0; border: 1px solid #444; }
.m-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.m-title { font-size: 26rpx; color: #fff; font-weight: bold; }
.m-latin { font-size: 20rpx; color: #666; font-style: italic; font-family: 'Times New Roman'; }
.m-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: #888; font-family: 'Courier New'; }
.m-qty .en-label {
  font-family: 'DIN';
  opacity: 0.5;
  margin-right: 4rpx;
  font-size: 18rpx;
}
.m-price { color: var(--gold); }


/* 财务 */
.finance-section { border-top: 2rpx dashed #444; padding-top: 30rpx; margin-top: 30rpx; }
.f-row { display: flex; justify-content: space-between; font-size: 22rpx; color: #888; margin-bottom: 10rpx; font-family: 'Courier New'; }
.f-row.highlight { color: var(--gold); }
.f-divider { width: 100%; height: 1px; background: #333; margin: 20rpx 0; }
.f-total { display: flex; justify-content: space-between; font-size: 28rpx; font-weight: bold; color: #fff; align-items: center; }
.f-total .en-label {
  font-family: var(--font-din);
  letter-spacing: 2rpx;
  opacity: 0.6;
  margin-right: 8rpx;
  font-size: 24rpx;
}
.gold-txt { color: var(--gold); font-size: 40rpx; font-family: var(--font-din); }

/* 印章 */
.stamp-mark {
  position: absolute; top: 40rpx; right: 40rpx; width: 160rpx; height: 160rpx;
  border-radius: 50%; border: 6rpx double; display: flex; align-items: center; justify-content: center;
  transform: rotate(-20deg) scale(2); opacity: 0; z-index: 10; mix-blend-mode: screen;
}
.stamp-drop { animation: stampIn 0.3s cubic-bezier(0.5, 0, 0.75, 0) forwards 0.5s; }
@keyframes stampIn { to { opacity: 0.8; transform: rotate(-20deg) scale(1); } }

.s-inner { font-size: 24rpx; font-weight: 900; letter-spacing: 2rpx; font-family: 'Courier New'; text-align: center; border-top: 2rpx solid; border-bottom: 2rpx solid; padding: 4rpx 0; }
.stamp-mark.warn { color: var(--gold); border-color: var(--gold); }    
.stamp-mark.active { color: #52B788; border-color: #52B788; }  
.stamp-mark.success { color: var(--gold); border-color: var(--gold); } 
.stamp-mark.error { color: #ff4d4f; border-color: #ff4d4f; }   
.stamp-mark.void { color: #666; border-color: #666; }          

.holes { display: flex; justify-content: space-between; margin-top: 40rpx; padding: 0 40rpx; }
.hole { width: 20rpx; height: 20rpx; background: #1A1814; border-radius: 50%; box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.8); }

/* ==================== 🟢 5. 底部操作栏 (全新排版) ==================== */
.action-footer {
  position: fixed; 
  bottom: 0; 
  left: 0; 
  width: 100%;
  max-width: 100%;
  background: rgba(18, 18, 18, 0.95); 
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255,255,255,0.1);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex; 
  align-items: center; 
  justify-content: center;
  gap: 16rpx;
  z-index: 50;
  box-sizing: border-box;
  overflow: hidden;
}

/* 按钮组 (申请退款、评价商品、联系专员) */
.btn-group { 
  display: flex; 
  gap: 12rpx; 
  width: 100%;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: flex-start;
}

/* 统一按钮样式 */
.btn-text, .btn-main, .hologram-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  border-radius: 12rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  min-width: 0;
}

/* 次要按钮 (申请退款、联系专员、评价商品) */
.btn-text {
  flex: 0 0 auto;
  min-width: 140rpx;
  padding: 0 24rpx;
  color: rgba(255,255,255,0.9);
  border: 1.5px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.03);
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  white-space: nowrap;
  font-size: 24rpx;
  /* 重置 button 默认样式 */
  border-radius: 12rpx;
  outline: none;
  background-color: rgba(255,255,255,0.03);
}

/* 重置 button 标签的默认样式 */
button.btn-text {
  border: 1.5px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.03);
  padding: 0 24rpx;
  margin: 0;
  line-height: 1;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.btn-text::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}

.btn-text:active {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.25);
  transform: scale(0.97);
  box-shadow: 
    0 1rpx 4rpx rgba(0,0,0,0.4),
    inset 0 1rpx 3rpx rgba(255,255,255,0.1);
}

.btn-text:active::before {
  opacity: 1;
}

/* 主按钮 (返回大厅 / 查看证书) */
.btn-main {
  flex: 1;
  min-width: 180rpx;
  background: linear-gradient(135deg, var(--gold), #C4A76C);
  background-size: 200% 100%;
  color: #1A1814;
  border: 2rpx solid rgba(196, 167, 108,0.6);
  box-shadow: 
    0 6rpx 20rpx rgba(196, 167, 108,0.4),
    0 3rpx 10rpx rgba(0,0,0,0.4),
    inset 0 2rpx 4rpx rgba(255,255,255,0.3),
    inset 0 -1rpx 2rpx rgba(0,0,0,0.2);
  animation: btn-golden-shine 3s ease-in-out infinite;
  font-size: 28rpx;
}

@keyframes btn-golden-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.btn-main::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.3), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}

.btn-main:active {
  transform: scale(0.97);
  box-shadow: 
    0 4rpx 12rpx rgba(196, 167, 108,0.5),
    0 2rpx 6rpx rgba(0,0,0,0.5),
    inset 0 2rpx 4rpx rgba(255,255,255,0.4);
}

.btn-main:active::before {
  opacity: 1;
}

/* 证书按钮 */
.hologram-btn {
  flex: 1;
  max-width: 600rpx;
  background: rgba(26,26,26,0.95);
  border: 2rpx solid var(--gold);
  color: var(--gold);
  box-shadow: 
    0 4rpx 16rpx rgba(196, 167, 108,0.2),
    0 0 20rpx rgba(196, 167, 108,0.1),
    inset 0 1rpx 2rpx rgba(196, 167, 108,0.1);
  font-size: 26rpx;
}

.hologram-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}

.hologram-btn:active {
  background: rgba(26,26,26,0.98);
  border-color: rgba(196, 167, 108,0.8);
  transform: scale(0.97);
  box-shadow: 
    0 6rpx 20rpx rgba(196, 167, 108,0.3),
    0 0 24rpx rgba(196, 167, 108,0.15),
    inset 0 1rpx 3rpx rgba(196, 167, 108,0.15);
}

.hologram-btn:active::before {
  opacity: 1;
}

.pending-pay-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}
.pending-pay-actions .flex-grow { flex: 1; }
.pending-pay-actions .btn-text.cancel {
  color: #A09A90;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
}

.received-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  align-items: stretch;
}

.received-actions .flex-grow { flex: 1; min-width: 0; }

.care-section { margin: 32rpx 0; padding: 0 8rpx; }

.care-hint-strip {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx; margin-top: 16rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-left: 4rpx solid #C4A76C;
  border-radius: 12rpx;
}

.care-hint-strip:active { opacity: 0.9; }

.care-hint-main { flex: 1; min-width: 0; }

.care-hint-title {
  display: block; font-size: 28rpx; color: #D5D1C8; font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.care-hint-desc {
  display: block; font-size: 22rpx; color: #A09A90;
  margin-top: 8rpx; line-height: 1.5;
}

.care-hint-tag {
  display: inline-block; margin-top: 10rpx;
  font-size: 20rpx; letter-spacing: 0.04em;
}

.care-hint-cta { font-size: 24rpx; color: #C4A76C; flex-shrink: 0; }

.holo-icon { 
  margin-right: 12rpx; 
  font-size: 32rpx; 
  position: relative;
  z-index: 1;
}

.custom-section { padding: 0 40rpx 24rpx; }
.custom-plate {
  margin-top: 16rpx;
  padding: 24rpx;
  background: rgba(250, 246, 237, 0.08);
  border: 1px solid rgba(196, 167, 108, 0.25);
  border-radius: 16rpx;
}
.custom-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1px dashed rgba(196, 167, 108, 0.15);
}
.custom-line:last-child { border-bottom: none; }
.custom-lbl { font-size: 22rpx; color: #A09A90; }
.custom-val { font-size: 24rpx; color: #D5D1C8; text-align: right; flex: 1; }
.custom-val.latin { font-style: italic; color: #C4A76C; }
.custom-val.gold { color: #C4A76C; }