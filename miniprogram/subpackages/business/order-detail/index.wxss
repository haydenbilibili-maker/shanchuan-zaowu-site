/* pages/order-detail/index.wxss */
/* 继承 app.wxss */

page { 
  background-color: var(--color-bg); 
  color: var(--color-text-body); 
  font-family: "PingFang SC", sans-serif; 
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
  overscroll-behavior-x: none;
  overflow-x: hidden;
}
view, text, image, button { box-sizing: border-box; }
.container { 
  padding: 30rpx;
  /* 🟢 取消左右阻尼感 */
  overscroll-behavior-x: none;
  overflow-x: hidden;
  width: 100%;
  max-width: 100%;
}

.detail-empty {
  padding: 160rpx 32rpx;
  text-align: center;
}
.detail-empty-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-text-body);
  margin-bottom: 12rpx;
}
.detail-empty-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: 40rpx;
}
.detail-empty-cta {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: var(--gold);
  color: var(--color-bg);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 16rpx;
}

/* === 档案袋容器 === */
.archive-folder {
  background: var(--color-bg-card); border-radius: 16rpx; padding: 40rpx 30rpx 60rpx;
  position: relative; border: 1px solid var(--color-bg-elevated); 
  overflow: hidden;
  opacity: 0; transform: scale(0.98); transition: opacity 0.28s ease, transform 0.28s ease;
}
.archive-folder.active { opacity: 1; transform: scale(1); }

/* 顶部纹理 */
.archive-folder::before {
  content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 8rpx;
  background: repeating-linear-gradient(45deg, #333, #333 10rpx, #222 10rpx, #222 20rpx);
}

/* 动画类 */
.slide-in-delay-1 { opacity: 0; animation: slideIn 0.28s forwards 0.08s; }
.slide-in-delay-2 { opacity: 0; animation: slideIn 0.28s forwards 0.14s; }
.slide-in-delay-3 { opacity: 0; animation: slideIn 0.28s forwards 0.2s; }
@keyframes slideIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }

/* 头部：抬高层级，避免戳记压住编号/日期 */
.folder-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 12;
}
.fh-left, .fh-right { display: flex; flex-direction: column; }
.fh-right { align-items: flex-end; max-width: 46%; }
.fh-label { font-size: 18rpx; color: var(--color-text-secondary); letter-spacing: 1rpx; margin-bottom: 6rpx; font-weight: bold; }
.fh-label .en-label { 
  font-family: var(--font-din); 
  letter-spacing: 2rpx; 
  opacity: 0.6; 
  margin-right: 8rpx;
  font-size: 16rpx;
}
.fh-val { font-family: 'Courier New', monospace; font-size: 24rpx; color: var(--color-text-body); letter-spacing: 1rpx; }
.fh-val.copy { text-decoration: underline; color: var(--gold); }
.divider-dashed { width: 100%; height: 0; border-top: 1px dashed rgba(38, 35, 32, 0.7); margin-bottom: 40rpx; }

/* 🟢 2. 物流标签 (航空信封风格) */
.shipping-label {
  background: var(--color-bg-card);
  color: var(--color-text-body); 
  padding: 30rpx; 
  border-radius: 16rpx;
  margin-bottom: 40rpx; 
  position: relative;
  overflow: hidden;
  border: 1px solid #4D401A;
}

.air-mail-border {
  position: absolute; top: 0; left: 0; right: 0; height: 6rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

.sl-header { 
  display: flex; justify-content: space-between; align-items: center;
  border-bottom: 1px solid var(--color-bg-elevated); padding-bottom: 16rpx;
  margin-bottom: 20rpx; margin-top: 10rpx;
}
.sl-header text { font-size: 20rpx; font-weight: 900; letter-spacing: 1rpx; color: var(--gold); }
.sl-header .en-label {
  font-family: var(--font-din);
  letter-spacing: 2rpx;
  opacity: 0.7;
  margin-right: 8rpx;
  font-size: 18rpx;
}

.sl-carrier { display: flex; align-items: center; gap: 10rpx; }
.sl-carrier text { color: var(--color-text-body); font-weight: bold; }
.sl-icon { 
  width: 32rpx; 
  height: 32rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
}
.sl-icon image {
  width: 100%;
  height: 100%;
}

.sl-content { display: flex; flex-direction: column; gap: 16rpx; }

.sl-row { display: flex; align-items: baseline; }
.sl-lbl { 
  width: 140rpx; font-size: 18rpx; color: var(--color-text-secondary); font-weight: bold; 
  letter-spacing: 0.5rpx; 
}
.sl-lbl .en-label {
  font-family: 'DIN';
  letter-spacing: 1rpx;
  opacity: 0.6;
  margin-right: 4rpx;
  font-size: 16rpx;
}
.sl-val { font-size: 26rpx; color: var(--color-text-primary); font-weight: bold; flex: 1; min-width: 0; }
.sl-val.code {
  font-family: 'Courier New', monospace;
  letter-spacing: 1rpx;
  flex: 0 1 auto;
  word-break: break-all;
}
.sl-val.code.muted { color: var(--color-text-muted); font-weight: 500; }

.sl-waybill-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sl-waybill-block .sl-lbl { width: auto; }
.sl-waybill-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.sl-waybill-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.sl-waybill-main-press { opacity: 0.78; }
.sl-copy-icon {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--gold);
  line-height: 1;
  opacity: 0.85;
}

.sl-user-box { display: flex; align-items: baseline; gap: 10rpx; }
.sl-user { font-weight: 900; font-size: 28rpx; }
.sl-phone { font-family: 'DIN'; color: var(--color-text-secondary); }

.sl-addr { 
  font-size: 24rpx; line-height: 1.4; color: var(--color-text-body); 
  padding-left: 140rpx; margin-top: -8rpx; 
}

.btn-track {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 22rpx;
  border: 1px solid var(--gold);
  border-radius: 12rpx;
  background: transparent;
  color: var(--gold);
}
.btn-track text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.btn-track-press {
  background: rgba(196, 167, 108, 0.12);
}
.sl-track-hint {
  display: block;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
  letter-spacing: 0.02em;
}

/* 确认收货：物流区内全宽主 CTA，与查轨迹分离 */
.confirm-btn-area {
  margin-top: 28rpx;
  border-top: 1px dashed rgba(77, 64, 26, 0.55);
  padding-top: 24rpx;
}
.btn-sign {
  width: 100%;
  background: var(--gold);
  color: var(--color-bg);
  padding: 22rpx 30rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.btn-sign:active,
.btn-sign-press { background: #A8903C; }
.btn-sign text { font-size: 28rpx; font-weight: 600; letter-spacing: 0.06em; }
.btn-arrow { font-family: Georgia, serif; font-size: 28rpx; line-height: 1; }

/* 清单 */
.section-title { 
  font-size: 22rpx; color: var(--color-text-body); letter-spacing: 1rpx; margin-bottom: 24rpx; 
  display: block; border-left: 4rpx solid var(--gold); padding-left: 12rpx; font-weight: bold;
}
.section-title .en-label {
  font-family: var(--font-din);
  letter-spacing: 2rpx;
  opacity: 0.6;
  margin-right: 8rpx;
  font-size: 20rpx;
}

.manifest-item { 
  display: flex; 
  background: var(--color-bg); 
  padding: 20rpx; 
  border-radius: 12rpx; 
  margin-bottom: 16rpx; 
  border: 1px solid var(--color-bg-elevated);
  transition: opacity 0.2s ease, background 0.2s ease;
}
.manifest-item:last-child { margin-bottom: 0; }
.manifest-item:active,
.manifest-item-press { opacity: 0.88; background: var(--color-bg-elevated); }
.manifest-empty {
  font-size: 24rpx; color: var(--color-text-muted); text-align: center; padding: 32rpx 0;
}

.m-img { width: 100rpx; height: 100rpx; background: var(--color-bg-elevated); border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; border: 1px solid var(--color-bg-elevated); }
.m-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.m-title { font-size: 26rpx; color: var(--color-text-primary); font-weight: bold; }
.m-latin { font-size: 20rpx; color: var(--gold); font-style: italic; font-family: 'Times New Roman'; }
.m-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: var(--color-text-secondary); font-family: 'Courier New'; }
.m-qty .en-label {
  font-family: 'DIN';
  opacity: 0.5;
  margin-right: 4rpx;
  font-size: 18rpx;
}
.m-price { color: var(--gold); }
.m-price.muted { color: var(--color-text-muted); font-weight: 400; }


/* 财务 */
.finance-section { border-top: 1px dashed rgba(38, 35, 32, 0.7); padding-top: 30rpx; margin-top: 30rpx; }
.f-row { display: flex; justify-content: space-between; font-size: 22rpx; color: var(--color-text-secondary); margin-bottom: 10rpx; font-family: 'Courier New'; }
.f-row.highlight { color: var(--gold); }
.f-divider { width: 100%; height: 1px; background: rgba(38, 35, 32, 0.7); margin: 20rpx 0; }
.f-total { display: flex; justify-content: space-between; font-size: 28rpx; font-weight: bold; color: var(--color-text-primary); align-items: center; }
.f-total .en-label {
  font-family: var(--font-din);
  letter-spacing: 2rpx;
  opacity: 0.6;
  margin-right: 8rpx;
  font-size: 24rpx;
}
.gold-txt { color: var(--gold); font-size: 40rpx; font-family: var(--font-din); }
.shipping-fee-cell {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-size: 28rpx;
}
.shipping-fee-cell.gold-txt { font-size: 28rpx; }
.shipping-fee-strike {
  color: var(--color-text-muted);
  font-size: 24rpx;
  text-decoration: line-through;
  font-family: var(--font-mono), monospace;
}

/* 印章：落在清单区上方，不挡 ARCHIVE/DATE */
.stamp-mark {
  position: absolute;
  top: 200rpx;
  right: 28rpx;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 6rpx double;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-18deg) scale(2);
  opacity: 0;
  z-index: 5;
  mix-blend-mode: screen;
  pointer-events: none;
}
.stamp-drop { animation: stampIn 0.28s ease-out forwards 0.16s; }
@keyframes stampIn { to { opacity: 0.72; transform: rotate(-18deg) scale(1); } }

.s-inner {
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  font-family: 'Courier New';
  text-align: center;
  border-top: 2rpx solid;
  border-bottom: 2rpx solid;
  padding: 6rpx 8rpx;
  line-height: 1.25;
  max-width: 132rpx;
}
.stamp-mark.warn { color: var(--gold); border-color: var(--gold); }    
.stamp-mark.active { color: #52B788; border-color: #52B788; }  
.stamp-mark.success { color: var(--gold); border-color: var(--gold); } 
.stamp-mark.error { color: #ff4d4f; border-color: #ff4d4f; }   
.stamp-mark.void { color: #666; border-color: #666; }          

.holes { display: flex; justify-content: space-between; margin-top: 40rpx; padding: 0 40rpx; }
.hole { width: 20rpx; height: 20rpx; background: var(--color-bg); border-radius: 50%; box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.8); }

/* ==================== 底部操作栏 ==================== */
.action-footer {
  position: fixed; 
  bottom: 0; 
  left: 0; 
  width: 100%;
  max-width: 100%;
  background: rgba(26, 24, 20, 0.96); 
  backdrop-filter: blur(20px);
  border-top: 1px solid var(--color-bg-elevated);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex; 
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 16rpx;
  z-index: 50;
  box-sizing: border-box;
  overflow: hidden;
}
.action-footer--gift {
  padding-top: 16rpx;
}

/* 按钮组 (申请退款、评价商品、联系专员) */
.btn-group { 
  display: flex; 
  gap: 12rpx; 
  width: 100%;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: flex-start;
}

.gift-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

/* 门店自取：凭证入口 = 底部「自取凭证」按钮（与申请退款并列），凭证本体在独立页
   subpackages/business/pickup-pass/index */
.btn-text.brass {
  color: var(--gold);
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.08);
}

/* 门店自取已完成：闭环确认行（正文区，不再占底部操作栏） */
.pickup-done {
  margin-bottom: 40rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(82, 183, 136, 0.35);
  border-left: 4rpx solid rgba(82, 183, 136, 0.75);
  background: rgba(31, 29, 26, 0.9);
}
.pd-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
}
.pd-tick {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid rgba(82, 183, 136, 0.55);
  color: var(--color-success);
  font-size: 24rpx;
}
.pd-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.pd-title {
  font-size: 28rpx;
  letter-spacing: 0.04em;
  color: #F2EFE8;
}
.pd-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}
.gift-await-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}
.gift-await-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.02em;
  text-align: center;
  line-height: 1.4;
}
.btn-gift-primary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gold) !important;
  color: var(--color-bg) !important;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  border-radius: 16rpx;
  border: none !important;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}
.btn-gift-primary::after { border: none; }
.gift-await-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
  align-items: stretch;
}
.btn-gift-secondary,
.btn-gift-ghost {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  letter-spacing: 0.02em;
  box-sizing: border-box;
  white-space: nowrap;
}
.btn-gift-secondary {
  color: var(--gold);
  border: 1px solid rgba(196, 167, 108, 0.55);
  background: transparent;
}
.btn-gift-ghost {
  color: var(--color-text-secondary);
  border: 1px solid rgba(160, 154, 144, 0.28);
  background: rgba(38, 35, 32, 0.5);
  flex: 0 0 30%;
  max-width: 220rpx;
  font-size: 24rpx;
}
.share-native {
  border: none !important;
  padding: 0;
  margin: 0;
  line-height: inherit;
}
.share-native::after { border: none; }

.gift-share-canvas-off {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 500px;
  height: 400px;
  pointer-events: none;
  opacity: 0;
}

/* 统一按钮样式 */
.btn-text, .btn-main, .hologram-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  border-radius: 12rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  transition: background 0.22s ease, transform 0.22s ease, border-color 0.22s ease;
  position: relative;
  overflow: hidden;
  min-width: 0;
}

/* 次要按钮 (申请退款、联系专员、评价商品) */
.btn-text {
  flex: 0 0 auto;
  min-width: 140rpx;
  padding: 0 24rpx;
  color: rgba(255,255,255,0.9);
  border: 1.5px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.03);
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  white-space: nowrap;
  font-size: 24rpx;
  /* 重置 button 默认样式 */
  border-radius: 12rpx;
  outline: none;
  background-color: rgba(255,255,255,0.03);
}

/* 重置 button 标签的默认样式 */
button.btn-text {
  border: 1.5px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.03);
  padding: 0 24rpx;
  margin: 0;
  line-height: 1;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.btn-text::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}

.btn-text:active {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.25);
  transform: scale(0.97);
  box-shadow: 
    0 1rpx 4rpx rgba(0,0,0,0.4),
    inset 0 1rpx 3rpx rgba(255,255,255,0.1);
}

.btn-text:active::before {
  opacity: 1;
}

.comment-after {
  border-color: rgba(196, 167, 108, 0.45);
  color: var(--gold);
}

.comment-after.comment-done {
  border-color: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.55);
}

/* 主按钮 (返回大厅 / 查看证书) */
.btn-main {
  flex: 1;
  min-width: 180rpx;
  background: var(--gold);
  color: var(--color-bg);
  border: none;
  font-size: 28rpx;
  gap: 10rpx;
}

.btn-care-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

@keyframes btn-golden-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.btn-main::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.3), transparent);
  opacity: 0;
  transition: opacity 0.3s;
}

.btn-main:active {
  transform: scale(0.97);
  background: #A8903C;
}

.btn-main:active::before {
  opacity: 1;
}

/* 证书按钮 */
.hologram-btn {
  flex: 1;
  max-width: 600rpx;
  background: var(--color-bg-card);
  border: 1px solid var(--gold);
  color: var(--gold);
  font-size: 26rpx;
}

.hologram-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(196, 167, 108, 0.08);
  opacity: 0;
  transition: opacity 0.3s;
}

.hologram-btn:active,
.hologram-press {
  background: var(--color-bg-elevated);
  transform: scale(0.97);
}

.hologram-btn:active::before {
  opacity: 1;
}
.hologram-btn.is-busy { opacity: 0.6; }

.pending-pay-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}
.pending-pay-actions .flex-grow { flex: 1; }
.pending-pay-actions .btn-text.cancel {
  color: var(--color-text-secondary);
  padding: 24rpx 32rpx;
  font-size: 28rpx;
}

.received-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  align-items: stretch;
}

.received-actions .flex-grow { flex: 1; min-width: 0; }

.care-section { margin: 32rpx 0; padding: 0 8rpx; }

.care-hint-strip {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx; margin-top: 16rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-left: 4rpx solid var(--gold);
  border-radius: 12rpx;
}

.care-hint-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.care-hint-strip:active,
.care-hint-press { opacity: 0.88; }

.care-hint-main { flex: 1; min-width: 0; }

.care-hint-title {
  display: block; font-size: 28rpx; color: var(--color-text-body); font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.care-hint-desc {
  display: block; font-size: 22rpx; color: var(--color-text-secondary);
  margin-top: 8rpx; line-height: 1.5;
}

.care-hint-tag {
  display: inline-block; margin-top: 10rpx;
  font-size: 20rpx; letter-spacing: 0.04em;
}

.care-hint-cta { font-size: 24rpx; color: var(--gold); flex-shrink: 0; }

.holo-icon { 
  margin-right: 12rpx; 
  font-size: 32rpx; 
  position: relative;
  z-index: 1;
}

.custom-section { padding: 0 40rpx 24rpx; }

.aftercare-plate {
  position: relative;
  margin-top: 24rpx;
  background: rgba(31, 29, 26, 0.9);
  border: 1px solid var(--color-bg-elevated);
  border-left: 4rpx solid var(--gold);
  border-radius: 24rpx;
  padding: 28rpx 32rpx 28rpx 28rpx;
  overflow: hidden;
}
.aftercare-plate::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 1px;
  background: rgba(196, 167, 108, 0.35);
}
.aftercare-overline {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
  color: var(--gold);
  margin-bottom: 20rpx;
}
.aftercare-body {
  margin-bottom: 8rpx;
}
.aftercare-para {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 12rpx;
}
.aftercare-para:last-child { margin-bottom: 0; }
.aftercare-warn {
  color: #E9A23B;
  font-weight: 500;
}
.aftercare-em {
  color: var(--gold);
}

.evidence-plate {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid var(--brass-800, #4D401A);
  border-radius: 24rpx;
}
.evidence-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.evidence-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}
.evidence-en {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: #8A7530;
}
.evidence-video {
  width: 100%;
  height: 360rpx;
  margin-bottom: 16rpx;
  background: #151310;
  border-radius: 16rpx;
}
.evidence-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.evidence-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: 12rpx;
  border: 1rpx solid #4D401A;
}
.aftercare-strong {
  font-weight: 600;
}
.aftercare-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 12rpx 20rpx;
  border: 1px solid rgba(196, 167, 108, 0.45);
  border-radius: 16rpx;
  background: transparent;
}
.aftercare-link-label {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.aftercare-link-arrow {
  font-size: 24rpx;
  color: var(--gold);
  line-height: 1;
}
.aftercare-link-press {
  opacity: 0.78;
  background: rgba(196, 167, 108, 0.08);
}
.custom-plate {
  margin-top: 16rpx;
  padding: 24rpx;
  background: rgba(250, 246, 237, 0.08);
  border: 1px solid rgba(196, 167, 108, 0.25);
  border-radius: 16rpx;
}
.custom-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1px dashed rgba(196, 167, 108, 0.15);
}
.custom-line:last-child { border-bottom: none; }
.custom-lbl { font-size: 22rpx; color: var(--color-text-secondary); }
.custom-val { font-size: 24rpx; color: var(--color-text-body); text-align: right; flex: 1; }
.custom-val.latin { font-style: italic; color: var(--gold); }
.custom-val.gold { color: var(--gold); }

/* ── 礼赠档案（2026-09-21）：把"这封信写给谁 / 进展到哪 / 回看入口"收在一张卡里 ── */
.gift-archive { margin: 8rpx 0 24rpx; }
.ga-card {
  margin-top: 16rpx;
  padding: var(--space-4, 32rpx);
  border-radius: var(--radius-md, 16rpx);
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.38);
}
.ga-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.ga-who { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
.ga-label { font-size: 22rpx; color: var(--color-text-muted); flex-shrink: 0; }
.ga-name {
  font-size: 32rpx; color: var(--brass-300); font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.ga-status { font-size: 22rpx; flex-shrink: 0; }
.ga-status.tone-waiting { color: var(--brass-400); }
.ga-status.tone-moving { color: #8FB6D9; }
.ga-status.tone-done { color: #7EDC96; }
.ga-status.tone-muted { color: var(--color-text-muted); }
.ga-note { margin-top: 16rpx; }
.ga-note-quote { font-size: 24rpx; line-height: 1.6; color: var(--color-text-body); }
.ga-meta { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 14rpx; }
.ga-meta-item { font-size: var(--fs-20); color: var(--color-text-muted); }
.ga-entries { display: flex; gap: 16rpx; margin-top: 22rpx; }
.ga-entry {
  flex: 1; min-width: 0; text-align: center;
  padding: 18rpx 12rpx; border-radius: var(--radius-sm, 8rpx);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
}
.ga-entry.primary { background: var(--brass-400); border-color: var(--brass-400); }
.ga-entry.primary .ga-entry-text { color: var(--color-bg); font-weight: 600; }
.ga-entry-press { opacity: 0.86; }
.ga-entry-text { font-size: 24rpx; color: var(--brass-400); }

/* ── 包装实拍（2026-09-21）：发货留档，顾客可回看/放大 ── */
.pack-section { margin-top: 28rpx; }
.pack-grid { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: 18rpx; }
.pack-item {
  width: 188rpx;
  height: 188rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: rgba(38, 35, 32, 0.5);
}
.pack-tip {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--fs-22);
  color: var(--color-text-muted);
}
