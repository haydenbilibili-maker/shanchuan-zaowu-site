/* pages/order-detail/index.wxss */
/* 继承 app.wxss */

page { 
  background-color: var(--color-bg); 
  color: var(--color-text-body); 
  font-family: var(--font-body); 
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
  overscroll-behavior-x: none;
  overflow-x: hidden;
}
view, text, image, button { box-sizing: border-box; }
.container { 
  padding: 30rpx;
  /* 🟢 取消左右阻尼感 */
  overscroll-behavior-x: none;
  overflow-x: hidden;
  width: 100%;
  max-width: 100%;
}

.detail-empty {
  padding: 160rpx 32rpx;
  text-align: center;
}
.detail-empty-title {
  display: block;
  font-size: var(--fs-30);
  color: var(--color-text-body);
  margin-bottom: 12rpx;
}
.detail-empty-desc {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: 40rpx;
}
.detail-empty-cta {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: var(--color-primary);
  color: var(--color-bg);
  font-size: var(--fs-26);
  font-weight: 500;
  border-radius: var(--radius-md);
}

/* === 档案袋容器 === */
.archive-folder {
  background: var(--color-bg-card); border-radius: var(--radius-md); padding: 40rpx 30rpx 60rpx;
  position: relative; border: 1px solid var(--color-bg-elevated); 
  overflow: hidden;
  opacity: 0; transform: scale(0.98); transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}
.archive-folder.active { opacity: 1; transform: scale(1); }

/* 顶部纹理 */
.archive-folder::before {
  content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 8rpx;
  background: repeating-linear-gradient(45deg, #333, #333 10rpx, #222 10rpx, #222 20rpx);
}

/* 动画类 */
.slide-in-delay-1 { opacity: 0; animation: slideIn 0.28s forwards 0.08s; }
.slide-in-delay-2 { opacity: 0; animation: slideIn 0.28s forwards 0.14s; }
.slide-in-delay-3 { opacity: 0; animation: slideIn 0.28s forwards 0.2s; }
@keyframes slideIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }

/* 头部：抬高层级，避免戳记压住编号/日期 */
.folder-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 12;
}
.fh-left, .fh-right { display: flex; flex-direction: column; }
.fh-right { align-items: flex-end; max-width: 46%; }
.fh-label { font-size: var(--fs-18); color: var(--color-text-secondary); letter-spacing: 1rpx; margin-bottom: 6rpx; font-weight: bold; }
.fh-label .en-label { 
  font-family: var(--font-mono); 
  letter-spacing: 2rpx; 
  opacity: 0.6; 
  margin-right: 8rpx;
  font-size: var(--fs-16);
}
.fh-val { font-family: var(--font-mono); font-size: var(--fs-24); color: var(--color-text-body); letter-spacing: 1rpx; }
.fh-val.copy { text-decoration: underline; color: var(--color-primary); }
.divider-dashed { width: 100%; height: 0; border-top: 1px dashed rgba(38, 35, 32, 0.7); margin-bottom: 40rpx; }

/* 🟢 2. 物流标签 (航空信封风格) */
.shipping-label {
  background: var(--color-bg-card);
  color: var(--color-text-body); 
  padding: 30rpx; 
  border-radius: var(--radius-md);
  margin-bottom: 40rpx; 
  position: relative;
  overflow: hidden;
  border: 1px solid var(--brass-800);
}

.air-mail-border {
  position: absolute; top: 0; left: 0; right: 0; height: 6rpx;
  background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
}

.sl-header { 
  display: flex; justify-content: space-between; align-items: center;
  border-bottom: 1px solid var(--color-bg-elevated); padding-bottom: 16rpx;
  margin-bottom: 20rpx; margin-top: 10rpx;
}
.sl-header text { font-size: var(--fs-20); font-weight: 900; letter-spacing: 1rpx; color: var(--color-primary); }
.sl-header .en-label {
  font-family: var(--font-mono);
  letter-spacing: 2rpx;
  opacity: 0.7;
  margin-right: 8rpx;
  font-size: var(--fs-18);
}

.sl-carrier { display: flex; align-items: center; gap: 10rpx; }
.sl-carrier text { color: var(--color-text-body); font-weight: bold; }
.sl-icon { 
  width: 32rpx; 
  height: 32rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
}
.sl-icon image {
  width: 100%;
  height: 100%;
}

.sl-content { display: flex; flex-direction: column; gap: 16rpx; }

.sl-row { display: flex; align-items: baseline; }
.sl-lbl { 
  width: 140rpx; font-size: var(--fs-18); color: var(--color-text-secondary); font-weight: bold; 
  letter-spacing: 0.5rpx; 
}
.sl-lbl .en-label {
  font-family: var(--font-mono);
  letter-spacing: 1rpx;
  opacity: 0.6;
  margin-right: 4rpx;
  font-size: var(--fs-16);
}
.sl-val { font-size: var(--fs-26); color: var(--color-text-primary); font-weight: bold; flex: 1; min-width: 0; }
.sl-val.code {
  font-family: var(--font-mono);
  letter-spacing: 1rpx;
  flex: 0 1 auto;
  word-break: break-all;
}
.sl-val.code.muted { color: var(--color-text-secondary); font-weight: 500; }

.sl-waybill-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sl-waybill-block .sl-lbl { width: auto; }
.sl-waybill-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.sl-waybill-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.sl-copy-icon {
  flex-shrink: 0;
  font-size: var(--fs-24);
  color: var(--color-primary);
  line-height: 1;
  opacity: 0.85;
}

.sl-user-box { display: flex; align-items: baseline; gap: 10rpx; }
.sl-user { font-weight: 900; font-size: var(--fs-28); }
.sl-phone { font-family: var(--font-mono); color: var(--color-text-secondary); }

.sl-addr { 
  font-size: var(--fs-24); line-height: 1.4; color: var(--color-text-body); 
  padding-left: 140rpx; margin-top: -8rpx; 
}

.btn-track {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 22rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--color-primary);
}
.btn-track text {
  font-size: var(--fs-22);
  font-weight: 500;
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.btn-track-press {
  background: rgba(196, 167, 108, 0.12);
}
.sl-track-hint {
  display: block;
  font-size: var(--fs-20);
  line-height: 1.5;
  color: var(--color-text-secondary);
  letter-spacing: 0.02em;
}

/* 确认收货：物流区内全宽主 CTA，与查轨迹分离 */
.confirm-btn-area {
  margin-top: 28rpx;
  border-top: 1px dashed rgba(77, 64, 26, 0.55);
  padding-top: 24rpx;
}
.btn-sign {
  width: 100%;
  background: var(--color-primary);
  color: var(--color-bg);
  padding: 22rpx 30rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.btn-sign:active,
.btn-sign-press { background: #A8903C; }
.btn-sign text { font-size: var(--fs-28); font-weight: 600; letter-spacing: 0.06em; }
.btn-arrow { font-family: var(--font-latin); font-size: var(--fs-28); line-height: 1; }

/* 清单 */
.section-title { 
  font-size: var(--fs-22); color: var(--color-text-body); letter-spacing: 1rpx; margin-bottom: 24rpx; 
  display: block; border-left: 4rpx solid var(--color-primary); padding-left: 12rpx; font-weight: bold;
}
.section-title .en-label {
  font-family: var(--font-mono);
  letter-spacing: 2rpx;
  opacity: 0.6;
  margin-right: 8rpx;
  font-size: var(--fs-20);
}

.manifest-item { 
  display: flex; 
  background: var(--color-bg); 
  padding: 20rpx; 
  border-radius: var(--radius-md); 
  margin-bottom: 16rpx; 
  border: 1px solid var(--color-bg-elevated);
  transition: opacity var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
}
.manifest-item:last-child { margin-bottom: 0; }
.manifest-item:active,
.manifest-item-press { opacity: 0.88; background: var(--color-bg-elevated); }
.manifest-empty {
  font-size: var(--fs-24); color: var(--color-text-muted); text-align: center; padding: 32rpx 0;
}

.m-img { width: 100rpx; height: 100rpx; background: var(--color-bg-elevated); border-radius: var(--radius-md); margin-right: 20rpx; flex-shrink: 0; border: 1px solid var(--color-bg-elevated); }
.m-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.m-title { font-size: var(--fs-26); color: var(--color-text-primary); font-weight: bold; }
.m-latin { font-size: var(--fs-20); color: var(--color-primary); font-style: italic; font-family: var(--font-latin); }
.m-meta { display: flex; justify-content: space-between; font-size: var(--fs-22); color: var(--color-text-secondary); font-family: var(--font-mono); }
.m-qty .en-label {
  font-family: var(--font-mono);
  opacity: 0.5;
  margin-right: 4rpx;
  font-size: var(--fs-18);
}
.m-price { color: var(--color-primary); font-family: var(--font-mono); }  /* VIS3 纪律 05：金额等宽 */
.m-price.muted { color: var(--color-text-secondary); font-weight: 400; }


/* 财务 */
.finance-section { border-top: 1px dashed rgba(38, 35, 32, 0.7); padding-top: 30rpx; margin-top: 30rpx; }
/* VIS3 第 06 页两栏信息行：左标签走正文字族、右数值走等宽；减免只把**数值**染金，标签保持说明色 */
.f-row { display: flex; justify-content: space-between; align-items: baseline; font-size: var(--fs-22); color: var(--color-text-secondary); margin-bottom: 10rpx; font-family: var(--font-body); }
.f-row > text:last-child { font-family: var(--font-mono); color: var(--color-text-body); }
.f-row.highlight > text:last-child { color: var(--color-primary); }
.f-row > .shipping-fee-cell { font-family: var(--font-mono); }
.f-divider { width: 100%; height: 1px; background: rgba(38, 35, 32, 0.7); margin: 20rpx 0; }
.f-total { display: flex; justify-content: space-between; font-size: var(--fs-28); font-weight: bold; color: var(--color-text-primary); align-items: center; }
.f-total .en-label {
  font-family: var(--font-mono);
  letter-spacing: 2rpx;
  opacity: 0.6;
  margin-right: 8rpx;
  font-size: var(--fs-24);
}
.gold-txt { color: var(--color-primary); font-size: var(--fs-40); font-family: var(--font-mono); }  /* VIS3 纪律 05：实付金额等宽（第 06 页「实付 ¥ 1,260.00」） */
.shipping-fee-cell {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-size: var(--fs-22);   /* 与账单其它行同字号（2026-10-15）；免邮仍走下面的 gold-txt 放大成高光 */
}
.shipping-fee-cell.gold-txt { font-size: var(--fs-28); }
.shipping-fee-strike {
  color: var(--color-text-muted);
  font-size: var(--fs-24);
  text-decoration: line-through;
  font-family: var(--font-mono), monospace;
}

/* 印章：落在清单区上方，不挡 ARCHIVE/DATE */
.stamp-mark {
  position: absolute;
  top: 200rpx;
  right: 28rpx;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 6rpx double;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-18deg) scale(2);
  opacity: 0;
  z-index: 5;
  mix-blend-mode: screen;
  pointer-events: none;
}
.stamp-drop { animation: stampIn 0.28s ease-out forwards 0.16s; }
@keyframes stampIn { to { opacity: 0.72; transform: rotate(-18deg) scale(1); } }

.s-inner {
  font-size: var(--fs-22);
  font-weight: 900;
  letter-spacing: 1rpx;
  font-family: var(--font-mono);
  text-align: center;
  border-top: 2rpx solid;
  border-bottom: 2rpx solid;
  padding: 6rpx 8rpx;
  line-height: 1.25;
  max-width: 132rpx;
}
.stamp-mark.warn { color: var(--color-primary); border-color: var(--color-primary); }    
.stamp-mark.active { color: var(--color-success); border-color: var(--color-success); }  
.stamp-mark.success { color: var(--color-primary); border-color: var(--color-primary); } 
.stamp-mark.error { color: #ff4d4f; border-color: #ff4d4f; }   
.stamp-mark.void { color: #A09A90; border-color: #6B6560; }          

.holes { display: flex; justify-content: space-between; margin-top: 40rpx; padding: 0 40rpx; }
.hole { width: 20rpx; height: 20rpx; background: var(--color-bg); border-radius: 50%; box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.8); }

/* ==================== 底部操作栏 ==================== */
.action-footer {
  position: fixed; 
  bottom: 0; 
  left: 0; 
  width: 100%;
  max-width: 100%;
  background: rgba(26, 24, 20, 0.96); 
  backdrop-filter: blur(20px);
  border-top: 1px solid var(--color-bg-elevated);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex; 
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 16rpx;
  z-index: 50;
  box-sizing: border-box;
  overflow: hidden;
}
.action-footer--gift {
  padding-top: 16rpx;
}

/* 次级行（评价 / 售后 / 联系专员 / 自取凭证…）：等分铺满，放不下 3 个即换行 */
.btn-group {
  display: flex;
  gap: 16rpx;
  width: 100%;
  flex-wrap: wrap;
  align-items: center;
}
.btn-group > .btn-text { flex: 1 1 0; min-width: 210rpx; }

/* 「已评价」：不可再写 → 状态标签（仍可点进查看），不占大按钮 */
.od-status-chip {
  flex: 0 0 auto;
  height: 84rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 8rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  white-space: nowrap;
}
.od-chip-tick { font-size: var(--fs-22); color: var(--color-primary); }

.gift-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

/* 门店自取：凭证入口 = 底部「自取凭证」按钮（与申请退款并列），凭证本体在独立页
   subpackages/business/pickup-pass/index */
.btn-text.brass {
  color: var(--color-primary);
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.08);
}

/* 门店自取已完成：闭环确认行（正文区，不再占底部操作栏） */
.pickup-done {
  margin-bottom: 40rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  border: 1px solid rgba(82, 183, 136, 0.35);
  border-left: 4rpx solid rgba(82, 183, 136, 0.75);
  background: rgba(31, 29, 26, 0.9);
}
.pd-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
}
.pd-tick {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid rgba(82, 183, 136, 0.55);
  color: var(--color-success);
  font-size: var(--fs-24);
}
.pd-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.pd-title {
  font-size: var(--fs-28);
  letter-spacing: 0.04em;
  color: #F2EFE8;
}
.pd-sub {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  line-height: 1.4;
}
.gift-await-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}
.gift-await-hint {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  letter-spacing: 0.02em;
  text-align: center;
  line-height: 1.4;
}
.btn-gift-primary {
  width: 100%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary) !important;
  color: var(--color-bg) !important;
  font-size: var(--fs-28);
  font-weight: 600;
  letter-spacing: 0.04em;
  border-radius: var(--radius-md);
  border: none !important;
  line-height: 84rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}
.btn-gift-primary::after { border: none; }
.gift-await-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
  align-items: stretch;
}
.btn-gift-secondary,
.btn-gift-ghost {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: var(--fs-26);
  letter-spacing: 0.02em;
  box-sizing: border-box;
  white-space: nowrap;
}
.btn-gift-secondary {
  color: var(--color-primary);
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  background: transparent;
}
.btn-gift-fill {
  flex: none;
  width: 100%;
  font-size: var(--fs-24);
}
.btn-gift-ghost {
  color: var(--color-text-secondary);
  border: 1px solid rgba(160, 154, 144, 0.28);
  background: rgba(38, 35, 32, 0.5);
  flex: 0 0 30%;
  max-width: 220rpx;
  font-size: var(--fs-24);
}
.share-native {
  border: none !important;
  padding: 0;
  margin: 0;
  line-height: inherit;
}
.share-native::after { border: none; }

.gift-share-canvas-off {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 500px;
  height: 400px;
  pointer-events: none;
  opacity: 0;
}

/* 统一按钮样式：高 84 / 圆角 16 / 行距 16；按压态统一用 app.wxss 的 tap-press-soft */
.btn-text, .btn-main, .hologram-btn {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-26);
  font-weight: 700;
  letter-spacing: 1rpx;
  border-radius: var(--radius-md);
  padding: 0;
  margin: 0;
  line-height: 1;
  transition: background var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard);
  position: relative;
  overflow: hidden;
  min-width: 0;
}

/* 次级按钮 (申请退款、联系专员、评价商品) */
.btn-text {
  flex: 1 1 0;
  min-width: 0;
  padding: 0 12rpx;
  color: rgba(255,255,255,0.9);
  border: 1px solid rgba(255,255,255,0.18);
  background: rgba(255,255,255,0.04);
  white-space: nowrap;
  font-size: var(--fs-26);
  font-weight: 500;
}

.comment-after {
  border-color: rgba(196, 167, 108, 0.45);
  color: var(--color-primary);
}


/* 主按钮 (返回大厅 / 查看证书) */
.btn-main {
  flex: 1;
  min-width: 180rpx;
  background: var(--color-primary);
  color: var(--color-bg);
  border: none;
  font-size: var(--fs-28);
  gap: 10rpx;
}

.btn-care-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

@keyframes btn-golden-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}


/* 证书 / 描金次级按钮。不写 flex:1 —— 底栏是纵向 flex，flex-basis:0 会把高度压成 0
   （overflow:hidden 使最小高度归零），横排里由 .flex-grow 分宽 */
.hologram-btn {
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: var(--fs-26);
}

.hologram-btn.is-busy { opacity: 0.6; }

/* 每种状态唯一的主操作：金底 */
.hologram-btn.od-primary {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-bg);
  font-size: var(--fs-28);
}

.pending-pay-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}
.pending-pay-actions .flex-grow { flex: 1; min-width: 0; }
.pending-pay-actions .btn-text.cancel {
  flex: 0 0 200rpx;
  color: var(--color-text-secondary);
}

.received-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  align-items: stretch;
}

.received-actions .flex-grow { flex: 1; min-width: 0; }

.care-section { margin: 32rpx 0; padding: 0 8rpx; }

.care-hint-strip {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx; margin-top: 16rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-left: 4rpx solid var(--color-primary);
  border-radius: var(--radius-md);
}

.care-hint-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.care-hint-strip:active,
.care-hint-press { opacity: 0.88; }

.care-hint-main { flex: 1; min-width: 0; }

.care-hint-title {
  display: block; font-size: var(--fs-28); color: var(--color-text-body); font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.care-hint-desc {
  display: block; font-size: var(--fs-22); color: var(--color-text-secondary);
  margin-top: 8rpx; line-height: 1.5;
}

.care-hint-tag {
  display: inline-block; margin-top: 10rpx;
  font-size: var(--fs-20); letter-spacing: 0.04em;
}

.care-hint-cta { font-size: var(--fs-24); color: var(--color-primary); flex-shrink: 0; }

.holo-icon { 
  margin-right: 12rpx; 
  font-size: var(--fs-32); 
  position: relative;
  z-index: 1;
}

.custom-section { padding: 0 40rpx 24rpx; }

/* 售后约定卡（2026-10-12 产品负责人点名改版）：标题 = 一句话规则 + 类型签；条款为三行要点；
   只有扣费数字保留警示色加粗，其余强调降为细节；「联系专员」改整行轻链接，不与底栏主按钮抢视线 */
.aftercare-plate {
  background: #1F1D1A;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx 8rpx;
  margin-bottom: 20rpx;
}
.aftercare-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 22rpx;
  border-bottom: 1px solid rgba(77, 64, 26, 0.4);
}
.aftercare-title-col { flex: 1; min-width: 0; }
.aftercare-overline {
  display: block;
  font-size: var(--fs-20);
  font-weight: 500;
  letter-spacing: 0.14em;
  color: #8A7530;
}
.aftercare-title {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-30);
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
}
.aftercare-chip {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 4rpx 14rpx;
  font-size: var(--fs-20);
  line-height: 1.5;
  color: var(--color-primary);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: 999rpx;
  white-space: nowrap;
}
.aftercare-body { padding: 18rpx 0 6rpx; }
.aftercare-para {
  position: relative;
  display: block;
  padding-left: 26rpx;
  margin-bottom: 14rpx;
  font-size: var(--fs-24);
  line-height: 1.65;
  color: #A09A90;
}
.aftercare-para::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 17rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.6);
}
.aftercare-para:last-child { margin-bottom: 0; }
.aftercare-em { color: #D5D1C8; }
.aftercare-strong { font-weight: 500; color: #FFFFFF; }
.aftercare-warn { color: #E9A23B; font-weight: 600; }
.aftercare-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  margin: 10rpx -32rpx 0;
  padding: 22rpx 32rpx 24rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.4);
}
.aftercare-link-hint { font-size: var(--fs-24); color: #A09A90; }
.aftercare-link-label { font-size: var(--fs-24); color: var(--color-primary); font-weight: 500; }
.aftercare-link-arrow { font-size: var(--fs-28); line-height: 1; color: var(--color-primary); }
.aftercare-link-press { background: rgba(196, 167, 108, 0.06); }

.evidence-plate {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1rpx solid var(--brass-800, #4D401A);
  border-radius: var(--radius-lg);
}
.evidence-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.evidence-title {
  font-size: var(--fs-28);
  color: var(--color-text-primary);
  font-weight: 500;
}
.evidence-en {
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: #8A7530;
}
.evidence-video {
  width: 100%;
  height: 360rpx;
  margin-bottom: 16rpx;
  background: #151310;
  border-radius: var(--radius-md);
}
.evidence-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.evidence-img {
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--brass-800);
}
.custom-plate {
  margin-top: 16rpx;
  padding: 24rpx;
  background: rgba(250, 246, 237, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.25);
  border-radius: var(--radius-md);
}
.custom-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1px dashed rgba(196, 167, 108, 0.15);
}
.custom-line:last-child { border-bottom: none; }
.custom-lbl { font-size: var(--fs-22); color: var(--color-text-secondary); }
.custom-val { font-size: var(--fs-24); color: var(--color-text-body); text-align: right; flex: 1; }
.custom-val.latin { font-style: italic; font-family: var(--font-latin); color: var(--color-primary); }
.custom-val.gold { color: var(--color-primary); font-family: var(--font-mono); }  /* VIS3 纪律 05：金额等宽 */

/* ── 礼赠档案（2026-09-21）：把"这封信写给谁 / 进展到哪 / 回看入口"收在一张卡里 ── */
.gift-archive { margin: 8rpx 0 24rpx; }
.ga-card {
  margin-top: 16rpx;
  padding: var(--space-4, 32rpx);
  border-radius: var(--radius-md, 16rpx);
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.38);
}
.ga-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.ga-who { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
.ga-label { font-size: var(--fs-22); color: var(--color-text-secondary); flex-shrink: 0; }
.ga-name {
  font-size: var(--fs-32); color: var(--brass-300); font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.ga-status { font-size: var(--fs-22); flex-shrink: 0; }
.ga-status.tone-waiting { color: var(--brass-400); }
.ga-status.tone-moving { color: #8FB6D9; }
.ga-status.tone-done { color: #7EDC96; }
.ga-status.tone-muted { color: var(--color-text-secondary); }
.ga-note { margin-top: 16rpx; }
.ga-note-quote { font-size: var(--fs-24); line-height: 1.6; color: var(--color-text-body); }
.ga-meta { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 14rpx; }
.ga-meta-item { font-size: var(--fs-20); color: var(--color-text-secondary); }
.ga-entries { display: flex; gap: 16rpx; margin-top: 22rpx; }
.ga-entry {
  flex: 1; min-width: 0; text-align: center;
  padding: 18rpx 12rpx; border-radius: var(--radius-sm, 8rpx);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
}
.ga-entry.primary { background: var(--brass-400); border-color: var(--brass-400); }
.ga-entry.primary .ga-entry-text { color: var(--color-bg); font-weight: 600; }
.ga-entry-text { font-size: var(--fs-24); color: var(--brass-400); }

/* ── 包装实拍（2026-09-21）：发货留档，顾客可回看/放大 ── */
.pack-section { margin-top: 28rpx; }
.pack-grid { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: 18rpx; }
.pack-item {
  width: 188rpx;
  height: 188rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: rgba(38, 35, 32, 0.5);
}
.pack-tip {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}
