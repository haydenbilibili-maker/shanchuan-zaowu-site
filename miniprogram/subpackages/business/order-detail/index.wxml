<view class="container">
  <!-- 加载态：避免在 isDecrypted 置位前停留在深色空屏 -->
  <view class="detail-empty" wx:if="{{loading}}">
    <text class="detail-empty-title">档案解密中…</text>
    <text class="detail-empty-desc">正在调取订单档案，请稍候</text>
  </view>

  <view class="detail-empty" wx:elif="{{loadError}}">
    <text class="detail-empty-title">档案读取失败</text>
    <text class="detail-empty-desc">订单不存在或网络异常，请稍后重试</text>
    <view class="detail-empty-cta" wx:if="{{orderId}}" bindtap="retryLoad">重新加载</view>
  </view>

  <view class="archive-folder {{isDecrypted ? 'active' : ''}}" wx:else>
    
    <view class="folder-header">
      <view class="fh-left">
        <text class="fh-label"><text class="en-label">ARCHIVE NO.</text> 订单编号</text>
        <text class="fh-val copy" bindtap="copyOrderNo">{{order.serialNo}} ❐</text>
      </view>
      <view class="fh-right">
        <text class="fh-label"><text class="en-label">DATE</text> 日期</text>
        <text class="fh-val">{{order.archiveDate}}</text>
      </view>
    </view>

    <view class="divider-dashed"></view>

    <view class="shipping-label slide-in-delay-1" 
          wx:if="{{order.status === 'shipped' || order.status === 'received'}}">
      
      <view class="air-mail-border"></view>

      <view class="sl-header">
        <text><text class="en-label">PRIORITY MAIL</text> 优先派送</text>
        <view class="sl-carrier">
          <text>{{order.logistics.carrier || '顺丰速运'}}</text>
          <view class="sl-icon"><image src="/subpackages/business/assets/icons/plane.png" mode="aspectFit" class="icon-gold"></image></view>
        </view>
      </view>

      <view class="sl-content">
        <view class="sl-waybill-block">
          <text class="sl-lbl"><text class="en-label">WAYBILL NO.</text> 运单号</text>
          <view class="sl-waybill-row" wx:if="{{hasTracking}}">
            <view class="sl-waybill-main" bindtap="copyTracking" hover-class="tap-press" hover-stay-time="80">
              <text class="sl-val code">{{order.logistics.trackingNumber || '待发货'}}</text>
              <text class="sl-copy-icon" aria-label="复制运单号">❐</text>
            </view>
            <view class="btn-track" catchtap="openWaybillTracking" hover-class="btn-track-press" hover-stay-time="80">
              <text>{{canOpenWxTrack ? '查询物流轨迹' : '复制单号查询'}}</text>
            </view>
          </view>
          <view class="sl-waybill-row" wx:else>
            <text class="sl-val code muted">{{order.logistics.trackingNumber || '待发货'}}</text>
          </view>
          <text class="sl-track-hint" wx:if="{{hasTracking && canOpenWxTrack}}">以承运商轨迹为准，更新可能稍有延迟</text>
          <text class="sl-track-hint" wx:elif="{{hasTracking && trackHint}}">{{trackHint}}</text>
        </view>

        <view class="sl-row">
           <text class="sl-lbl"><text class="en-label">TO:</text> 收件人</text>
           <view class="sl-user-box">
             <text class="sl-user">{{order.address.name || '—'}}</text>
             <text class="sl-phone">{{order.address.phone || ''}}</text>
           </view>
        </view>
        <text class="sl-addr">{{order.addressLine || '地址待补充'}}</text>
      </view>

      <view class="confirm-btn-area" wx:if="{{order.status === 'shipped'}}">
         <view class="btn-sign" bindtap="confirmReceipt" hover-class="btn-sign-press" hover-stay-time="80">
            <text>确认签收</text>
            <text class="btn-arrow">→</text>
         </view>
      </view>
    </view>

    <!-- 门店自取：不展示快递面单 -->
    <view
      class="shipping-label slide-in-delay-1 pickup-label"
      wx:elif="{{isStorePickup && (order.status === 'paid' || order.status === 'ready_pickup')}}"
    >
      <view class="air-mail-border"></view>
      <view class="sl-header">
        <text><text class="en-label">STORE PICKUP</text> 门店自取</text>
      </view>
      <view class="sl-content">
        <text class="sl-lbl"><text class="en-label">VENUE</text> 领取门店</text>
        <text class="sl-user">{{pickupStoreName || orderPickupStoreName || '山川造物'}}</text>
        <text class="sl-addr" wx:if="{{pickupStoreInfo.floor || pickupStoreInfo.hours}}">{{pickupStoreInfo.floor}}{{pickupStoreInfo.floor && pickupStoreInfo.hours ? ' · ' : ''}}{{pickupStoreInfo.hours ? '营业 ' + pickupStoreInfo.hours : ''}}</text>
        <text class="sl-addr" wx:if="{{pickupStoreInfo.address}}">{{pickupStoreInfo.address}}</text>
        <text class="sl-addr">支付后专员备妥；到店后点下方「自取凭证」出示二维码，由专员核销后交付。</text>
      </view>
    </view>

    <!-- 门店自取已完成：闭环确认（凭证本体在独立页 subpackages/business/pickup-pass） -->
    <view class="pickup-done" wx:if="{{pickupDoneInfo}}">
      <view class="pd-row">
        <text class="pd-tick">✓</text>
        <view class="pd-main">
          <text class="pd-title">门店自取已完成</text>
          <text class="pd-sub">{{pickupDoneInfo.claimedAtText ? pickupDoneInfo.claimedAtText + ' · 已由专员核销交付' : '已由专员核销交付'}}</text>
        </view>
      </view>
    </view>

    <!-- 礼赠档案（2026-09-21）：订单详情页原来只在**底栏**按状态给礼赠动作，
         没有"回看这封礼笺 / 看这份礼赠进展"的入口 —— 送礼人付完款就找不到自己写的那封信了。 -->
    <view class="gift-archive slide-in-delay-1" wx:if="{{isGiftOrder}}">
      <text class="section-title"><text class="en-label">GIFT NOTE</text> 礼赠档案</text>
      <view class="ga-card">
        <view class="ga-head">
          <view class="ga-who">
            <text class="ga-label">赠与</text>
            <text class="ga-name">{{giftRecipientName || '（未留称呼）'}}</text>
          </view>
          <text class="ga-status tone-{{giftStatusTone}}">{{giftStatusText}}</text>
        </view>
        <view class="ga-note" wx:if="{{giftNotePreview}}">
          <text class="ga-note-quote">「{{giftNotePreview}}{{giftNotePreview.length >= 48 ? '…' : ''}}」</text>
        </view>
        <view class="ga-meta">
          <text class="ga-meta-item" wx:if="{{giftCardSignature}}">署 · {{giftCardSignature}}</text>
          <text class="ga-meta-item" wx:if="{{giftHasVoice}}">含语音</text>
          <text class="ga-meta-item" wx:if="{{giftShareToken}}">礼笺已封缄</text>
        </view>
        <view class="ga-entries">
          <view class="ga-entry primary" bindtap="goGiftEnvelope" hover-class="tap-press-soft" hover-stay-time="70">
            <text class="ga-entry-text">{{giftEnvelopeLabel}}</text>
          </view>
          <view class="ga-entry" bindtap="goGiftDetail" hover-class="tap-press-soft" hover-stay-time="70">
            <text class="ga-entry-text">礼赠详情</text>
          </view>
        </view>
      </view>
    </view>

    <view class="manifest-section slide-in-delay-2">
      <text class="section-title"><text class="en-label">MANIFEST</text> 订单清单</text>
      <block wx:if="{{order.products && order.products.length}}">
        <block wx:for="{{order.products}}" wx:key="id" wx:for-index="prodIndex">
          <view class="manifest-item" bindtap="goToProduct" data-id="{{item.id || item.productId || item._id}}" hover-class="manifest-item-press" hover-stay-time="80">
            <image src="{{item.image}}" mode="aspectFill" class="m-img"></image>
            <view class="m-info">
              <text class="m-title">{{item.title}}</text>
              <text class="m-latin">{{item.latin}}</text>
              <view class="m-meta">
                <text class="m-qty"><text class="en-label">QTY:</text> 数量 {{item.count || 1}}</text>
                <text class="m-price" wx:if="{{showOrderPrice}}">¥ {{item.price}}</text>
                <text class="m-price muted" wx:else>心意已隐去</text>
              </view>
            </view>
          </view>
        </block>
      </block>
      <view class="manifest-empty" wx:else>暂无藏品明细</view>
    </view>

    <!-- 发货包装实拍（可选）：馆员发货时留档，会随「山海有信」一并给到顾客；
         订单详情页这一处是**顾客主动回看**的入口（图片已由 JS 转成 https，见 packagePhotos）。 -->
    <view class="pack-section slide-in-delay-2" wx:if="{{order.packagePhotos && order.packagePhotos.length}}">
      <text class="section-title"><text class="en-label">PACKING</text> 包装实拍</text>
      <view class="pack-grid">
        <image
          class="pack-item"
          wx:for="{{order.packagePhotos}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          data-src="{{item}}"
          bindtap="previewPackagePhoto"
          lazy-load
        ></image>
      </view>
      <text class="pack-tip">这是这件的打包留影；点击可放大查看。</text>
    </view>

    <view class="custom-section slide-in-delay-2" wx:if="{{isCustomOrder && customPreviewLines.length}}">
      <text class="section-title"><text class="en-label">ATELIER</text> 定制方案</text>
      <view class="custom-plate">
        <view class="custom-line" wx:for="{{customPreviewLines}}" wx:key="label">
          <text class="custom-lbl">{{item.label}}</text>
          <text class="custom-val {{item.latin ? 'latin' : ''}}">{{item.value}}</text>
        </view>
        <view class="custom-line" wx:if="{{productionStatusLabel}}">
          <text class="custom-lbl">制作进度</text>
          <text class="custom-val gold">{{productionStatusLabel}}</text>
        </view>
        <view class="custom-line" wx:if="{{order.customExtraPrice > 0}}">
          <text class="custom-lbl">定制加价</text>
          <text class="custom-val gold">+¥ {{order.customExtraPrice}}</text>
        </view>
      </view>
    </view>

    <view class="care-section slide-in-delay-2" wx:if="{{order.status === 'received' && showCare}}">
      <text class="section-title"><text class="en-label">SPECIMEN CARE</text> 养护提醒</text>
      <view class="care-hint-strip" bindtap="goToCare" hover-class="care-hint-press">
        <image class="care-hint-icon" src="/assets/icons/care.png" mode="aspectFit"></image>
        <view class="care-hint-main">
          <text class="care-hint-title">{{careContext.productTitle}}</text>
          <text class="care-hint-desc">{{careContext.careSummary}}</text>
          <text class="care-hint-tag" style="color: {{careContext.categoryColor}};">{{careContext.categoryLabel}}</text>
        </view>
        <text class="care-hint-cta">查看指南 →</text>
      </view>
    </view>

    <view class="finance-section slide-in-delay-3" wx:if="{{showOrderPrice}}">
      <view class="f-row">
        <text>藏品合计</text>
        <text>¥ {{order.originalPrice || order.totalPrice}}</text>
      </view>
      
      <view class="f-row highlight" wx:if="{{order.discountRate < 1}}">
        <text>会员折扣（{{order.discountText}}）</text>
        <text>- ¥ {{order.discountAmount}}</text>
      </view>
      <view class="f-row highlight" wx:if="{{order.couponValue > 0}}">
        <text>礼券抵扣</text>
        <text>- ¥ {{order.couponValue}}</text>
      </view>
      
      <view class="f-row">
        <text>运费</text>
        <view class="shipping-fee-cell {{order.shippingFee > 0 ? '' : 'gold-txt'}}">
          <text wx:if="{{order.showShippingStrike}}" class="shipping-fee-strike">¥ {{order.originalShippingFeeDisplay}}</text>
          <text>{{order.shippingFeeLabel || (order.shippingFee > 0 ? ('¥ ' + order.shippingFeeDisplay) : '免邮')}}</text>
        </view>
      </view>
      
      <view class="f-divider"></view>
      
      <view class="f-total">
        <text wx:if="{{order.status === 'pending_pay'}}">应付金额</text>
        <text wx:elif="{{isDepositOrder}}">定金金额</text>
        <text wx:else>实付金额</text>
        <text class="gold-txt">¥ {{order.totalPrice}}</text>
      </view>
      <view class="f-row highlight" wx:if="{{depositCredit > 0}}">
        <text>已付定金抵扣</text>
        <text>- ¥ {{depositCredit}}</text>
      </view>
      <view class="f-row highlight" wx:if="{{order.refundDeduct > 0}}">
        <text>运输损耗（30%）</text>
        <text>- ¥ {{order.refundDeduct}}</text>
      </view>
      <view class="f-row highlight" wx:if="{{order.refundFee && (order.status === 'refunded' || order.status === 'refunding' || order.status === 'aftersales' || order.status === 'expired_refunding')}}">
        <text>{{order.status === 'refunded' ? '已退金额' : '预计退回'}}</text>
        <text>¥ {{order.refundFee}}</text>
      </view>
    </view>

    <!-- 售后举证（已提交） -->
    <view class="evidence-plate" wx:if="{{hasEvidenceBlock}}">
      <view class="evidence-head">
        <text class="evidence-title">售后举证</text>
        <text class="evidence-en">EVIDENCE</text>
      </view>
      <video
        wx:if="{{evidenceVideoUrl}}"
        class="evidence-video"
        src="{{evidenceVideoUrl}}"
        controls
        object-fit="contain"
        show-center-play-btn
      ></video>
      <view class="evidence-imgs" wx:if="{{evidenceImageUrls.length}}">
        <image
          wx:for="{{evidenceImageUrls}}"
          wx:key="*this"
          wx:for-index="idx"
          class="evidence-img"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewEvidenceImage"
          data-idx="{{idx}}"
        ></image>
      </view>
    </view>

    <view class="aftercare-plate" wx:if="{{refundPolicyLabel}}">
      <text class="aftercare-overline">AFTERCARE · {{refundPolicyLabel}}</text>
      <view class="aftercare-body">
        <view class="aftercare-para" wx:for="{{refundPolicyRichParagraphs}}" wx:for-item="para" wx:key="idx">
          <text
            wx:for="{{para.segments}}"
            wx:for-item="seg"
            wx:key="i"
            class="{{seg.warn ? 'aftercare-warn' : ''}} {{seg.em ? 'aftercare-em' : ''}} {{seg.strong ? 'aftercare-strong' : ''}}"
          >{{seg.t}}</text>
        </view>
      </view>
      <view class="aftercare-link" bindtap="goToSupport" hover-class="aftercare-link-press">
        <text class="aftercare-link-label">联系专员</text>
        <text class="aftercare-link-arrow">→</text>
      </view>
    </view>

    <view class="stamp-mark {{stampClass}} {{isDecrypted ? 'stamp-drop' : ''}}">
      <view class="s-inner">{{stampText}}</view>
    </view>

    <view class="holes">
      <view class="hole"></view><view class="hole"></view><view class="hole"></view>
    </view>

  </view>

  <view class="action-footer safe-area {{(isGiftOrder && (giftAwaitingAddress || giftReceiverNeedsAddress)) ? 'action-footer--gift' : ''}}" wx:if="{{!loadError && order._id}}">
    <!-- 底栏层级（2026-10-01 产品负责人点名）：上 = 唯一主操作（金底），下 = 次级等分行（自动换行）；不可点的「已评价」降为状态标签 -->
    <!-- 待付款：支付 + 取消（仅买家） -->
    <view class="pending-pay-actions" wx:if="{{order.status === 'pending_pay' && !isGiftReceiver}}">
      <view class="btn-text cancel" hover-class="tap-press-soft" hover-stay-time="80" catchtap="handleCancelOrder">取消订单</view>
      <view class="hologram-btn od-primary flex-grow {{paying ? 'is-busy' : ''}}" catchtap="handlePay" hover-class="{{paying ? '' : 'tap-press-soft'}}" hover-stay-time="80">
        <text>{{paying ? '正在拉起支付…' : ((payBtnLabel || '立即支付') + ' ¥' + order.totalPrice)}}</text>
      </view>
    </view>

    <!-- 已签收：养护 + 证书 -->
    <view class="received-actions" wx:if="{{order.status === 'received' && showCare && certRole !== 'giver'}}">
      <view class="btn-main flex-grow" hover-class="tap-press-soft" hover-stay-time="80" catchtap="goToCare">
        <image class="btn-care-icon" src="/subpackages/business/assets/icons/care-on-brass.png" mode="aspectFit"></image>
        <text>标本养护</text>
      </view>
      <view class="hologram-btn flex-grow" hover-class="tap-press-soft" hover-stay-time="80" catchtap="viewCertificate">收藏证书</view>
    </view>
    <view class="hologram-btn od-primary" hover-class="tap-press-soft" hover-stay-time="80" catchtap="viewCertificate" wx:elif="{{order.status === 'received'}}">
      <text>{{certRole === 'giver' ? '查看赠予凭证' : '查看收藏证书'}}</text>
    </view>

    <!-- 礼赠待填址：主操作 = 分享礼笺；次 = 提醒 / 退款；联系专员仅留 aftercare -->
    <view class="gift-await-bar" wx:if="{{isGiftOrder && giftAwaitingAddress}}">
      <text class="gift-await-hint" wx:if="{{giftExpireHint}}">{{giftExpireHint}}</text>
      <button class="btn-gift-primary share-native" open-type="share" hover-class="tap-press-soft">把礼笺交给 TA</button>
      <view class="gift-await-row">
        <view class="btn-gift-secondary" hover-class="tap-press-soft" hover-stay-time="80" bindtap="nudgeGift">再轻轻提醒一声</view>
        <view class="btn-gift-ghost" hover-class="tap-press-soft" hover-stay-time="80" bindtap="requestRefund" wx:if="{{showRefundEntry}}">{{refundEntryLabel}}</view>
      </view>
    </view>
    <!-- 受礼人待填址 -->
    <view class="gift-await-bar" wx:elif="{{isGiftOrder && giftReceiverNeedsAddress}}">
      <text class="gift-await-hint" wx:if="{{giftExpireHint}}">{{giftExpireHint}}</text>
      <view class="hologram-btn od-primary" hover-class="tap-press-soft" hover-stay-time="80" bindtap="goFillGiftAddress">留下收件去处</view>
    </view>
    <view class="gift-actions" wx:elif="{{isGiftOrder && giftShowPickupClaim}}">
      <view class="hologram-btn od-primary" hover-class="tap-press-soft" hover-stay-time="80" bindtap="goGiftPickupClaim">出示妥投码 {{giftClaimCode}}</view>
    </view>
    <!-- 礼赠分享封面离屏 canvas -->
    <canvas
      wx:if="{{isGiftOrder}}"
      type="2d"
      id="giftShareCanvas"
      class="gift-share-canvas-off"
      style="width: 500px; height: 400px;"
    ></canvas>

    <!-- 已签收：评价（可写 = 次级按钮；已评完 = 状态标签，仍可点进查看）+ 售后入口 -->
    <view class="btn-group" wx:if="{{order.status === 'received' && ((order.products && order.products.length > 0 && !isVoucherOrder) || showRefundEntry)}}">
      <view
        class="od-status-chip"
        hover-class="tap-press-soft"
        hover-stay-time="80"
        catchtap="goToComment"
        wx:if="{{order.status === 'received' && order.products && order.products.length > 0 && !isVoucherOrder && !reviewCanAny}}"
      >
        <text class="od-chip-tick">✓</text>
        <text>{{reviewSummaryLabel || '已评价'}}</text>
      </view>
      <view
        class="btn-text comment-after"
        hover-class="tap-press-soft"
        hover-stay-time="80"
        catchtap="goToComment"
        wx:elif="{{order.status === 'received' && order.products && order.products.length > 0 && !isVoucherOrder}}"
      >{{reviewPendingCount > 1 ? '继续评价' : '写下感受'}}</view>
      <block wx:if="{{showRefundEntry}}">
        <view class="btn-text" hover-class="tap-press-soft" hover-stay-time="80" bindtap="requestRefund">{{refundEntryLabel}}</view>
        <view class="btn-text" hover-class="tap-press-soft" hover-stay-time="80" bindtap="goToSupport">联系专员</view>
      </block>
    </view>

    <!-- 未签收订单：自取凭证 + 退款 + 联系专员（礼赠待填址已在上方处理，此处去重） -->
    <view class="btn-group" wx:if="{{order.status !== 'received' && order.status !== 'pending_pay' && !(isGiftOrder && giftAwaitingAddress) && !(isGiftOrder && giftReceiverNeedsAddress)}}">
      <view class="btn-text brass" hover-class="tap-press-soft" hover-stay-time="80" bindtap="openPickupPass" wx:if="{{showOrderPickup}}">自取凭证</view>
      <!-- 支付确认中：钱可能已扣，此前无任何自救入口 → 提供「重新确认支付结果」 -->
      <view class="btn-text brass" hover-class="tap-press-soft" hover-stay-time="80" bindtap="retryConfirmPayment" wx:if="{{showPayConfirmRetry}}">{{payConfirmBusy ? '确认中…' : '重新确认支付结果'}}</view>
      <view class="btn-text" hover-class="tap-press-soft" hover-stay-time="80" bindtap="requestRefund" wx:if="{{showRefundEntry}}">{{refundEntryLabel}}</view>
      <view class="btn-text" hover-class="tap-press-soft" hover-stay-time="80" bindtap="goToSupport">联系专员</view>
    </view>
  </view>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal）；详见 utils/appModal.js -->
<app-modal id="appModal" />
