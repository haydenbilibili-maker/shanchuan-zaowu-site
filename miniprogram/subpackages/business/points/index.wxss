/* pages/points/index.wxss */
/* 继承 app.wxss */

.container { padding: 0 30rpx; width: 100%; display: flex; flex-direction: column; align-items: center; }

/* 1. 资产卡 (金库风格) */
.asset-card {
  width: 100%; height: 400rpx; margin-top: 30rpx;
  border-radius: 24rpx; position: relative; overflow: hidden;
  /* 极黑底色 + 金色微光 */
  background: radial-gradient(circle at 50% -20%, #333 0%, #1A1814 70%);
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: 0 40rpx 80rpx rgba(0,0,0,0.8);
}

.card-texture {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.1;
  background-image: repeating-linear-gradient(45deg, #C4A76C 0, #C4A76C 1px, transparent 0, transparent 50%);
  background-size: 20rpx 20rpx;
}

.card-inner {
  position: relative; z-index: 2; height: 100%; padding: 60rpx 50rpx;
  display: flex; flex-direction: column; justify-content: space-between; align-items: center;
}

.card-top { width: 100%; display: flex; justify-content: space-between; align-items: center; }
.brand-group { text-align: center; width: 100%; }
.en { font-family: var(--font-din); font-size: 20rpx; color: var(--gold); letter-spacing: 8rpx; font-weight: bold; margin-bottom: 10rpx; display: block; }
.cn { font-size: 24rpx; color: #666; letter-spacing: 2rpx; }

.level-badge { 
  position: absolute; top: 40rpx; right: 40rpx;
  border: 1px solid rgba(196, 167, 108, 0.3); border-radius: 30rpx; 
  padding: 4rpx 16rpx; display: flex; align-items: center; background: rgba(196, 167, 108, 0.05);
}
.level-badge text { font-size: 18rpx; color: var(--gold); font-weight: bold; }

.card-main { margin-top: 20rpx; text-align: center; }
.num { font-size: 100rpx; color: #fff; font-weight: bold; font-family: var(--font-num); letter-spacing: 4rpx; text-shadow: 0 0 30rpx rgba(196, 167, 108,0.4); line-height: 1; }
.unit { font-size: 24rpx; color: #666; margin-top: 10rpx; display: block; font-family: var(--font-din); letter-spacing: 2rpx; }

.card-bottom .tips { font-size: 20rpx; color: #444; }

/* 2. 极简导航 */
.tab-navbar {
  width: 100%; display: flex; justify-content: center; align-items: center;
  margin: 60rpx 0 40rpx;
}
.tab-item {
  padding: 20rpx 60rpx; position: relative;
  font-size: 28rpx; color: #666; font-weight: bold; transition: all 0.3s;
}
.tab-item.active { color: #fff; font-size: 30rpx; }
.indicator {
  position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 8rpx; height: 8rpx; background: var(--gold); border-radius: 50%;
  box-shadow: 0 0 10rpx var(--gold);
}

/* 3. 权益网格 (沉浸式) */
.content-area { width: 100%; }
.section-header { margin-bottom: 40rpx; text-align: center; }
.title-group .en { font-family: var(--font-din); font-size: 20rpx; color: var(--gold); letter-spacing: 6rpx; font-weight: bold; }

.reward-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24rpx; }
.reward-card {
  background: #1F1D1A; border-radius: 16rpx; overflow: hidden;
  display: flex; flex-direction: column; position: relative;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.3);
}

.img-box { position: relative; width: 100%; padding-top: 100%; background: #1A1814; }
.img-box image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.9; object-fit: cover; }
.type-badge {
  position: absolute; top: 16rpx; left: 16rpx; font-size: 16rpx; font-weight: bold;
  color: #1A1814; background: var(--gold);
  padding: 4rpx 10rpx; border-radius: 4rpx; letter-spacing: 1rpx;
}
.sold-out-mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.8); color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; letter-spacing: 4rpx; font-weight: bold; font-family: var(--font-din);
}

.info-box { padding: 24rpx; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.r-title { font-size: 26rpx; color: #eee; font-weight: bold; margin-bottom: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.r-desc { font-size: 20rpx; color: #666; margin-bottom: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.r-footer { display: flex; justify-content: space-between; align-items: center; }
.cost-group .val { font-size: 32rpx; color: var(--gold); font-weight: bold; font-family: var(--font-num); }
.cost-group .unit { font-size: 18rpx; color: #666; margin-left: 4rpx; font-weight: bold; }

.btn-outline {
  font-size: 20rpx; color: #1A1814; background: var(--gold);
  padding: 8rpx 24rpx; border-radius: 30rpx; font-weight: bold; 
}
.btn-outline.disabled { background: #333; color: #666; }

/* 4. 我的兑换 (时间轴风格) */
.my-list { display: flex; flex-direction: column; gap: 40rpx; padding-left: 20rpx; border-left: 1px solid rgba(255,255,255,0.1); margin-left: 20rpx; }
.my-card {
  display: flex; position: relative; padding-left: 30rpx;
}
/* 时间轴点 */
.my-card::before {
  content: ''; position: absolute; left: -25rpx; top: 10rpx;
  width: 10rpx; height: 10rpx; background: var(--gold); border-radius: 50%;
  box-shadow: 0 0 10rpx var(--gold);
}

.my-thumb { width: 100rpx; height: 100rpx; border-radius: 8rpx; background: #1A1814; margin-right: 24rpx; flex-shrink: 0; border: 1px solid #333; }
.my-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }

.my-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.my-title { font-size: 26rpx; color: #eee; font-weight: bold; }
.my-meta { font-size: 20rpx; color: #555; font-family: monospace; }

.my-action-row { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.status-txt { font-size: 20rpx; color: #666; }
.btn-small {
  font-size: 20rpx; color: var(--gold); border: 1px solid var(--gold); 
  padding: 4rpx 16rpx; border-radius: 6rpx; font-weight: bold;
}
.btn-track {
  font-size: 20rpx; color: #aaa; border: 1px solid #444; 
  padding: 4rpx 16rpx; border-radius: 6rpx;
}

.empty-tip { text-align: center; color: #444; font-size: 24rpx; margin-top: 100rpx; letter-spacing: 2rpx; }
.copyright {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  text-align: center;
  color: #666;
  font-size: 20rpx;
  margin-top: 80rpx;
  letter-spacing: 0.1em;
}
.copyright .cr-cn { font-weight: 500; color: #333; }
.copyright .cr-en {
  font-size: 18rpx;
  letter-spacing: 0.18em;
  color: #8B6F47;
  font-weight: 600;
}

/* 弹窗复用 */
.qr-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.qr-content { width: 560rpx; background: #1a1a1a; border-radius: 24rpx; padding: 40rpx; display: flex; flex-direction: column; align-items: center; border: 1px solid #333; }
.qr-header { font-size: 32rpx; color: var(--gold); font-weight: bold; margin-bottom: 10rpx; letter-spacing: 2rpx; }
.qr-header .sub { font-size: 24rpx; color: #eee; margin-bottom: 40rpx; display: block; font-weight: normal; }
.qr-code-img { width: 400rpx; height: 400rpx; border: 10rpx solid #fff; }
.hint { margin-top: 30rpx; color: #666; font-size: 22rpx; }