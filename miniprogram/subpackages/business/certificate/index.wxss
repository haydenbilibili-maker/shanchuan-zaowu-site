/* pages/certificate/index.wxss */
page {
  background-color: var(--color-bg);
  color: #fff;
  font-family: "PingFang SC", serif;
  height: 100%;
  overflow: hidden;
}
view, text, image, button { box-sizing: border-box; }
.container { width: 100%; height: 100%; position: relative; }

/* 导航 - 黑金质感 */
.nav-bar { 
  position: absolute; 
  left: 30rpx; 
  z-index: 100; 
}
.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 24, 20, 0.4);
  backdrop-filter: blur(8px);
  border-radius: 50%;
  border: 1px solid transparent;
}

.empty-cert {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}
.empty-cert-title {
  font-size: var(--fs-32);
  color: #fff;
  margin-bottom: 12rpx;
}
.empty-cert-desc {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}
.empty-cert-btn {
  padding: 16rpx 48rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: 9999px;
  color: var(--color-primary);
  font-size: var(--fs-26);
}

/* 打印动画（2026-10-19）：与预约出票 / 代金券打印同一台打印机；证书生成时长不定 → 纸张循环吐出 */
.minting-layer {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: var(--color-bg); z-index: 50;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.cp-printer {
  width: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 44rpx;
}
.cp-machine {
  position: relative;
  z-index: 10;
  width: 100%;
  height: 44rpx;
  display: flex;
  justify-content: center;
  background: linear-gradient(to bottom, #33302C, #1A1814);
  border: 2rpx solid #4A4540;
  border-radius: 30rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.72);
}
.cp-slot {
  /* 不碰右侧三灯（灯组约占右侧 70rpx）；视觉规范 R2 不用金色外发光 → 出纸口内一道铜色细线，透明度呼吸 */
  width: 64%;
  height: 6rpx;
  margin-top: 18rpx;
  background: linear-gradient(180deg, #0F0D0B 0%, #0F0D0B 50%, rgba(196, 167, 108, 0.75) 50%, rgba(196, 167, 108, 0.75) 100%);
  border-radius: 4rpx;
  animation: cp-slot-pulse 1.2s ease-in-out infinite;
}
.cp-lights {
  position: absolute;
  right: 18rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cp-lights .signal-light { width: 12rpx; height: 12rpx; }
/* 出纸口下方的取景窗：纸从口里往下吐，超出窗口的部分看不到 */
.cp-window {
  width: 82%;
  height: 330rpx;
  margin-top: -2rpx;
  overflow: hidden;
}
.cp-paper {
  position: relative;
  height: 330rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  background-color: #F2EDE4;
  background-image: radial-gradient(rgba(196, 167, 108, 0.22) 0.7px, transparent 0.7px);
  background-size: 12rpx 12rpx;
  border: 3rpx solid var(--color-primary);
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.42);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: cp-feed 3.2s cubic-bezier(0.22, 0.82, 0.28, 1) infinite;
}
.cp-en { font-family: var(--font-mono); font-size: var(--fs-16); letter-spacing: 0.22em; color: #8B6F47; }
.cp-rule { width: 64rpx; height: 2rpx; margin: 14rpx 0; background: #B08D57; }
.cp-title { font-family: var(--font-brand); font-size: var(--fs-30); font-weight: 700; letter-spacing: 0.1em; color: #2E2618; }
.cp-ink { width: 80%; height: 8rpx; margin-top: 18rpx; border-radius: 4rpx; background: rgba(46, 38, 24, 0.16); }
.cp-ink.is-short { width: 56%; }
.cp-seal {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(168, 53, 42, 0.8);
  border-radius: 6rpx;
  transform: rotate(-10deg);
}
.cp-seal text { font-family: var(--font-brand); font-size: var(--fs-18); font-weight: 700; color: rgba(168, 53, 42, 0.85); }
.mint-txt { margin-top: 8rpx; font-family: var(--font-mono); font-size: var(--fs-24); color: var(--color-primary); letter-spacing: 4rpx; opacity: 0.85; }
/* 同款细进度条（预约出票 mint-progress）：时长不定 → 往复扫 */
.cp-progress { width: 300rpx; height: 4rpx; margin-top: 24rpx; background: rgba(196, 167, 108, 0.16); border-radius: 2rpx; overflow: hidden; }
.cp-progress-bar { width: 40%; height: 100%; background: var(--brass-400); animation: cp-progress 1.6s ease-in-out infinite; }
/* 纸：从出纸口吐出 → 停一拍 → 淡出换下一张 */
@keyframes cp-feed {
  0% { transform: translateY(-100%); opacity: 1; }
  68% { transform: translateY(0); opacity: 1; }
  88% { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(0); opacity: 0; }
}
@keyframes cp-slot-pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}
@keyframes cp-progress {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(250%); }
}

/* 证书展示层 */
.cert-layer {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: radial-gradient(circle at center, #1a1a1a 0%, var(--color-bg) 80%);
  opacity: 0; transition: opacity 0.8s var(--ease-standard);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding-bottom: 120rpx;
}
.cert-layer.active { opacity: 1; }

.cert-shadow-box {
  width: 600rpx;
  height: 960rpx;
  /* 2026-10-17：证书本身就是一张浅纸标本签 —— 外面不再套金框 / 斜光 / 漂浮动画，只留纸落在桌面上的投影 */
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.55), 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
  border-radius: 4rpx;
  background: #EEE6D4;
  position: relative;
  overflow: hidden;
}

.cert-canvas { width: 100%; height: 100%; }
/* 已固化证书直接展示时，画布留在 DOM（加载失败可退回现场绘制）但移出视野 */
.cert-canvas-off { position: absolute; left: -9999rpx; top: 0; }

/* 底部按钮 */
.action-bar {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.care-link {
  width: 100%;
  max-width: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
  padding: 16rpx 24rpx;
  font-size: var(--fs-24);
  color: var(--color-primary);
  letter-spacing: 0.06em;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: 9999px;
  background: rgba(196, 167, 108, 0.06);
}

.care-link-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.care-link:active {
  opacity: 0.88;
}

.action-row {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
}

.icon-btn.share {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  font-size: var(--fs-20);
  padding: 0;
  margin: 0;
  line-height: 1.2;
}
.icon-btn.share::after { border: none; }
.btn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 6rpx;
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

/* 本屏唯一实心金：保存到相册（去掉流光动画 / 渐变 / 内高光） */
.save-btn {
  width: 300rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--brass-400);
  color: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.12em;
}

/* 默认署名就地提示（注册不再问昵称） */
.sign-hint {
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  font-size: var(--fs-24);
  color: var(--brass-400);
  text-align: center;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .cp-paper,
  .cp-slot,
  .cp-progress-bar {
    animation: none;
  }
}
