/* pages/certificate/index.wxss */
page {
  background-color: var(--color-bg);
  color: #fff;
  font-family: "PingFang SC", serif;
  height: 100%;
  overflow: hidden;
}
view, text, image, button { box-sizing: border-box; }
.container { width: 100%; height: 100%; position: relative; }

/* 导航 - 黑金质感 */
.nav-bar { 
  position: absolute; 
  left: 30rpx; 
  z-index: 100; 
}
.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 24, 20, 0.4);
  backdrop-filter: blur(8px);
  border-radius: 50%;
  border: 1px solid transparent;
}

.empty-cert {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}
.empty-cert-title {
  font-size: var(--fs-32);
  color: #fff;
  margin-bottom: 12rpx;
}
.empty-cert-desc {
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}
.empty-cert-btn {
  padding: 16rpx 48rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: 9999px;
  color: var(--color-primary);
  font-size: var(--fs-26);
}

/* 铸造动画 */
.minting-layer {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: var(--color-bg); z-index: 50;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.mint-spinner {
  width: 60rpx; height: 60rpx; border: 4rpx solid rgba(196, 167, 108,0.3);
  border-top-color: var(--color-primary); border-radius: 50%;
  animation: spin 1s linear infinite; margin-bottom: 30rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.mint-txt { font-family: var(--font-mono); font-size: var(--fs-24); color: var(--color-primary); letter-spacing: 4rpx; opacity: 0.8; }

/* 证书展示层 */
.cert-layer {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: radial-gradient(circle at center, #1a1a1a 0%, var(--color-bg) 80%);
  opacity: 0; transition: opacity 0.8s var(--ease-standard);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding-bottom: 120rpx;
}
.cert-layer.active { opacity: 1; }

.cert-shadow-box {
  width: 600rpx; 
  height: 960rpx;
  box-shadow:
    0 20rpx 80rpx rgba(0,0,0,0.8),
    0 8rpx 32rpx rgba(0,0,0,0.6),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  border: 2rpx solid rgba(196, 167, 108,0.3);
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(20,20,20,0.7));
  transform: translateY(0);
  animation: float 6s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}
.cert-shadow-box::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    transparent 0%,
    rgba(196, 167, 108,0.05) 50%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 1;
}
@keyframes float { 
  0%, 100% { transform: translateY(0); } 
  50% { transform: translateY(-10rpx); } 
}

.cert-canvas { width: 100%; height: 100%; }
/* 已固化证书直接展示时，画布留在 DOM（加载失败可退回现场绘制）但移出视野 */
.cert-canvas-off { position: absolute; left: -9999rpx; top: 0; }

/* 底部按钮 */
.action-bar {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.care-link {
  width: 100%;
  max-width: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
  padding: 16rpx 24rpx;
  font-size: var(--fs-24);
  color: var(--color-primary);
  letter-spacing: 0.06em;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: 9999px;
  background: rgba(196, 167, 108, 0.06);
}

.care-link-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.care-link:active {
  opacity: 0.88;
}

.action-row {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
}

.icon-btn.share {
  width: 100rpx; 
  height: 100rpx; 
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.15), rgba(196, 167, 108,0.08));
  border: 1.5px solid rgba(196, 167, 108,0.4);
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center;
  color: var(--color-primary); 
  font-size: var(--fs-20); 
  padding: 0; 
  margin: 0;
  box-shadow:
    0 4rpx 12rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  backdrop-filter: blur(8px);
  transition: all var(--dur-base) var(--ease-standard);
  font-weight: 700;
}
.icon-btn.share::after { border: none; }
.icon-btn.share:active {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.25), rgba(196, 167, 108,0.15));
  border-color: rgba(196, 167, 108,0.6);
  transform: scale(0.95);
  box-shadow:
    0 2rpx 8rpx rgba(0,0,0,0.4),
    inset 0 1rpx 2rpx rgba(255,255,255,0.15);
}
.btn-icon { 
  width: 36rpx; 
  height: 36rpx; 
  margin-bottom: 6rpx; 
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

.save-btn {
  width: 300rpx; 
  height: 100rpx; 
  border-radius: 50rpx;
  background: linear-gradient(135deg, #A8903C 0%, var(--color-primary) 100%);
  background-size: 200% 100%;
  color: var(--color-bg);
  display: flex; 
  align-items: center; 
  justify-content: center;
  font-size: var(--fs-30); 
  font-weight: 800; 
  letter-spacing: 3rpx;
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,0.4),
    inset 0 2rpx 4rpx rgba(255,255,255,0.3),
    inset 0 -1rpx 2rpx rgba(0,0,0,0.2);
  border: 1.5px solid rgba(196, 167, 108,0.6);
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard), color var(--dur-slow) var(--ease-standard), background-color var(--dur-slow) var(--ease-standard), border-color var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard);
  position: relative;
  overflow: hidden;
  animation: save-btn-shine 3s ease-in-out infinite;
}
@keyframes save-btn-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
.save-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.3), transparent);
  opacity: 0;
  transition: opacity var(--dur-slow) var(--ease-standard);
  pointer-events: none;
}
.save-btn:active { 
  transform: scale(0.97);
  box-shadow:
    0 3rpx 12rpx rgba(0,0,0,0.5),
    inset 0 2rpx 4rpx rgba(255,255,255,0.4);
}
.save-btn:active::before {
  opacity: 1;
}

/* 默认署名就地提示（注册不再问昵称） */
.sign-hint {
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  font-size: var(--fs-24);
  color: var(--brass-400);
  text-align: center;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .mint-spinner,
  .cert-shadow-box,
  .save-btn {
    animation: none;
  }
}
