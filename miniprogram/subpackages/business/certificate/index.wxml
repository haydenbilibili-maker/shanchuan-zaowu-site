<!--pages/certificate/index.wxml-->
<view class="container">
  
  <view class="nav-bar" style="top:{{statusBarHeight}}px">
  </view>

  <!-- 1. 铸造动画 -->
  <view class="minting-layer" wx:if="{{isMinting}}">
    <view class="mint-spinner"></view>
    <text class="mint-txt">正在铸造专属证书…</text>
  </view>

  <view class="empty-cert" wx:if="{{missingId && !isMinting}}">
    <text class="empty-cert-title">未找到证书</text>
    <text class="empty-cert-desc">请从证书收藏夹进入，或查看已签收订单</text>
    <view class="empty-cert-btn" hover-class="tap-press" bindtap="goBack">返回</view>
  </view>

  <!-- 礼赠证书未签发：待签收 / 礼赠已结束 -->
  <view class="empty-cert" wx:if="{{certState && !isMinting}}">
    <text class="empty-cert-title">{{certStateTitle}}</text>
    <text class="empty-cert-desc">{{certStateDesc}}</text>
    <view class="empty-cert-btn" hover-class="tap-press" bindtap="goBack">返回</view>
  </view>

  <!-- 2. 证书展示 -->
  <view class="cert-layer {{showCert ? 'active' : ''}}">
    
    <view class="cert-shadow-box">
       <image wx:if="{{certImageUrl}}" class="cert-canvas" src="{{certImageUrl}}" mode="aspectFit" binderror="onCertImageError"></image>
       <canvas type="2d" id="certCanvas" class="cert-canvas {{certImageUrl ? 'cert-canvas-off' : ''}}"></canvas>
    </view>
    <view class="sign-hint" wx:if="{{signHint && showCert}}" bindtap="goRename" hover-class="tap-press-soft" hover-stay-time="80">证书署名为「藏家」· 改个名字重新签发 ›</view>
    
    <!-- 底部操作 -->
    <view class="action-bar safe-area">
      <view class="care-link" bindtap="goToCare" hover-class="tap-press-soft" hover-stay-time="80" wx:if="{{(careGuideUrl || orderId) && certKind !== 'gift_voucher'}}">
        <image class="care-link-icon" src="/assets/icons/care.png" mode="aspectFit"></image>
        <text>如何养护这件藏品 →</text>
      </view>
      <view class="action-row">
        <button class="icon-btn share" open-type="share" hover-class="tap-press">
          <image src="/assets/icons/share.png" class="btn-icon" mode="aspectFit"></image>
          <text>分享</text>
        </button>
        
        <view class="save-btn" hover-class="tap-press" bindtap="saveImage">
          <text>保存到相册</text>
        </view>
      </view>
    </view>

  </view>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal；utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
