.rw-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #1A1814;
  padding: 48rpx;
  box-sizing: border-box;
}

.rw-en {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  letter-spacing: 0.14em;
  margin-bottom: 12rpx;
}

.rw-cn {
  font-size: var(--fs-28);
  color: #A09A90;
}
