/* pages/my-bookings/index.wxss */
/* 继承 app.wxss */

.container { padding: 0; padding-bottom: 60rpx; }

/* 自定义导航栏 */
.custom-navbar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1A1814;
  z-index: 1000;
  border-bottom: 1px solid rgba(38, 35, 32, 0.85);
  padding: 0 30rpx;
}

.nav-back {
  position: absolute;
  left: 30rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon-text {
  font-size: 40rpx;
  color: #C4A76C;
  line-height: 1;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1) sepia(1) saturate(5) hue-rotate(15deg);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  font-family: 'Times New Roman', serif;
}

.nav-spacer {
  height: 88rpx;
}

/* Tab - 黑金质感 */
.tab-header {
  display: flex; 
  justify-content: center; 
  align-items: center;
  padding: 30rpx 0; 
  position: sticky; 
  top: 0; 
  background: linear-gradient(to bottom, rgba(0,0,0,0.98), rgba(0,0,0,0.95));
  z-index: 10;
  border-bottom: 1.5px solid rgba(196, 167, 108,0.2); 
  margin-bottom: 30rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.tab-item {
  font-size: 28rpx; 
  color: rgba(255,255,255,0.5); 
  padding: 12rpx 44rpx; 
  position: relative; 
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  font-weight: 600;
  letter-spacing: 2rpx;
}
.tab-item::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  transition: width 0.4s;
}
.tab-item.active { 
  color: var(--gold); 
  font-weight: 800; 
  font-size: 30rpx;
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.4);
}
.tab-item.active::after {
  width: 60rpx;
}
.dot { 
  position: absolute; 
  top: 8rpx; 
  right: 28rpx; 
  width: 12rpx; 
  height: 12rpx; 
  background: var(--gold); 
  border-radius: 50%;
  box-shadow: none;
  animation: dot-pulse 2s ease-in-out infinite;
}
@keyframes dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.2); }
}

.list-box { 
  display: flex; 
  flex-direction: column; 
  gap: 30rpx;
  padding: 0 30rpx;
}

/* 🟢 票据卡片 (待参加) - 黑金质感 */
.ticket-card {
  display: flex; 
  height: 240rpx;
  background: linear-gradient(135deg, rgba(0,0,0,0.8), rgba(20,20,20,0.6));
  border-radius: 20rpx; 
  overflow: hidden;
  box-shadow: 
    0 12rpx 40rpx rgba(0,0,0,0.6),
    0 4rpx 16rpx rgba(0,0,0,0.4),
    0 0 24rpx rgba(196, 167, 108,0.1),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  border: 1.5px solid rgba(196, 167, 108,0.2);
  position: relative;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.ticket-card:active {
  transform: scale(0.98) translateY(-2rpx);
  box-shadow: 
    0 8rpx 28rpx rgba(0,0,0,0.7),
    0 2rpx 12rpx rgba(0,0,0,0.5),
    0 0 32rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  border-color: rgba(196, 167, 108,0.4);
}

/* 左侧装饰 - 黑金质感 */
.ticket-left {
  width: 90rpx; 
  background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(20,20,20,0.7));
  border-right: 2rpx dashed rgba(196, 167, 108,0.3);
  display: flex; 
  align-items: center; 
  justify-content: center;
  position: relative;
  box-shadow: inset -2rpx 0 8rpx rgba(0,0,0,0.3);
}
.t-type { 
  transform: rotate(-90deg); 
  white-space: nowrap; 
  font-family: var(--font-din); 
  color: var(--gold); 
  font-size: 22rpx; 
  font-weight: 800; 
  letter-spacing: 3rpx;
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.4);
}
.hole-circle {
  position: absolute; 
  right: -14rpx; 
  width: 28rpx; 
  height: 28rpx; 
  background: radial-gradient(circle, #1A1814 0%, #1A1814 100%);
  border: 2px solid rgba(196, 167, 108,0.2);
  border-radius: 50%; 
  z-index: 2;
  box-shadow: 
    0 0 8rpx rgba(196, 167, 108,0.2),
    inset 0 2rpx 4rpx rgba(0,0,0,0.5);
}
.hole-circle.top { top: -14rpx; }
.hole-circle.bottom { bottom: -14rpx; }

/* 右侧内容 - 黑金质感 */
.ticket-right { 
  flex: 1; 
  padding: 28rpx 32rpx; 
  display: flex; 
  flex-direction: column; 
  justify-content: space-between; 
}

.tr-top { 
  display: flex; 
  justify-content: space-between; 
  align-items: flex-start; 
  margin-bottom: 16rpx;
}
.tr-title { 
  font-size: 32rpx; 
  font-weight: 900; 
  color: #fff; 
  max-width: 360rpx; 
  overflow: hidden; 
  white-space: nowrap; 
  text-overflow: ellipsis;
  text-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.8),
    0 1rpx 4rpx rgba(0,0,0,0.6);
  letter-spacing: 1rpx;
}
.tr-badge { 
  font-family: var(--font-din); 
  font-size: 20rpx; 
  color: rgba(196, 167, 108,0.8); 
  border: 1.5px solid rgba(196, 167, 108,0.3);
  padding: 4rpx 12rpx; 
  border-radius: 6rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
}

.tr-mid { 
  display: flex; 
  justify-content: space-between; 
  margin-top: 12rpx; 
  margin-bottom: 16rpx;
}
.info-col { 
  display: flex; 
  flex-direction: column; 
}
.lbl { 
  font-size: 18rpx; 
  color: rgba(255,255,255,0.4); 
  margin-bottom: 6rpx; 
  font-family: var(--font-din);
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.val { 
  font-size: 30rpx; 
  color: rgba(255,255,255,0.9); 
  font-weight: 800; 
  font-family: var(--font-din);
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.6);
}
.val.highlight { 
  color: var(--gold); 
  font-size: 34rpx; 
  text-shadow: 
    0 0 16rpx rgba(196, 167, 108,0.5),
    0 0 8rpx rgba(196, 167, 108,0.3),
    0 2rpx 4rpx rgba(0,0,0,0.6);
  font-weight: 900;
}

.tr-bot { 
  border-top: 1px solid rgba(196, 167, 108,0.15); 
  padding-top: 18rpx; 
  display: flex; 
  justify-content: flex-end; 
}
.btn-use { 
  font-size: 24rpx; 
  color: var(--gold); 
  font-weight: 800;
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.12), rgba(196, 167, 108,0.06));
  border: 1.5px solid rgba(196, 167, 108,0.3);
  transition: all 0.3s;
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
}
.btn-use:active {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.12));
  border-color: rgba(196, 167, 108,0.5);
  transform: scale(0.97);
  box-shadow: 
    0 0 16rpx rgba(196, 167, 108,0.3),
    0 2rpx 8rpx rgba(0,0,0,0.4),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
}

/* 🟢 历史记录卡片 - 黑金质感 */
.history-card {
  display: flex; 
  align-items: center; 
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(0,0,0,0.6), rgba(20,20,20,0.4));
  border-radius: 16rpx; 
  opacity: 0.85;
  border: 1.5px solid rgba(196, 167, 108,0.15);
  box-shadow: 
    0 8rpx 24rpx rgba(0,0,0,0.4),
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.03);
  transition: all 0.3s;
  backdrop-filter: blur(8px);
}
.history-card:active {
  transform: scale(0.98);
  opacity: 0.95;
  border-color: rgba(196, 167, 108,0.25);
}
.hc-left { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  margin-right: 28rpx; 
  border-right: 1.5px solid rgba(196, 167, 108,0.2); 
  padding-right: 28rpx; 
  min-width: 90rpx;
}
.hc-day { 
  font-size: 40rpx; 
  font-weight: 900; 
  color: rgba(196, 167, 108,0.7); 
  font-family: var(--font-din);
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.3);
}
.hc-month { 
  font-size: 22rpx; 
  color: rgba(255,255,255,0.4); 
  font-family: var(--font-din); 
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.hc-mid { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
}
.hc-title { 
  font-size: 28rpx; 
  color: rgba(255,255,255,0.7); 
  margin-bottom: 8rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.6);
}
.hc-time { 
  font-size: 24rpx; 
  color: rgba(255,255,255,0.5);
  font-family: var(--font-din);
  font-weight: 600;
}

.hc-right { 
  margin-left: 24rpx; 
}
.stamp-used { 
  border: 2rpx solid rgba(196, 167, 108,0.4); 
  color: rgba(196, 167, 108,0.7); 
  font-size: 18rpx; 
  padding: 6rpx 14rpx; 
  transform: rotate(-10deg); 
  font-weight: 800; 
  border-radius: 6rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  letter-spacing: 2rpx;
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.3);
}

.empty-state { 
  text-align: center; 
  margin-top: 120rpx; 
  color: rgba(255,255,255,0.4);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.empty-icon { 
  font-size: 80rpx; 
  margin-bottom: 24rpx; 
  filter: grayscale(1) sepia(1) hue-rotate(15deg) saturate(0.5);
  opacity: 0.4;
  text-shadow: 0 0 16rpx rgba(196, 167, 108,0.2);
}