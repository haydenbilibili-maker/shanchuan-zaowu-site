/* pages/ticket/index.wxss */
page {
  --gold: #C4A76C;
  --bg: #1A1814;
  background: var(--bg);
  height: 100%;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

/* ===== 顶部导航 ===== */
.page-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-bottom: 1px solid rgba(38, 35, 32, 0.8);
  background: rgba(26, 24, 20, 0.96);
  z-index: 10;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.25);
  background: rgba(31, 29, 26, 0.8);
}

.back-arrow {
  font-size: 36rpx;
  color: var(--gold);
  line-height: 1;
}

.page-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.header-spacer {
  width: 64rpx;
}

/* ===== 主体滚动区 ===== */
.page-body {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.ticket-wrap {
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.ticket-box {
  width: 100%;
  max-width: 640rpx;
  margin: 0 auto;
  background: linear-gradient(135deg, #1F1D1A 0%, #1A1814 50%, #1F1D1A 100%);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1px solid rgba(196, 167, 108, 0.2);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  position: relative;
}

.ticket-header {
  background: linear-gradient(135deg, #A8903C 0%, #C4A76C 100%);
  padding: 36rpx 32rpx;
  text-align: center;
}

.ticket-header text {
  display: block;
  color: #1A1814;
}

.header-main {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.sub {
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
  opacity: 0.85;
}

.qr-section {
  padding: 48rpx 32rpx;
  text-align: center;
  border-bottom: 1px dashed rgba(196, 167, 108, 0.2);
}

.qr-img {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 20rpx;
  display: block;
  border: 2px solid rgba(196, 167, 108, 0.3);
  border-radius: 12rpx;
  background: #fff;
  padding: 8rpx;
  box-sizing: border-box;
}

.qr-tip {
  display: block;
  font-size: 24rpx;
  color: rgba(196, 167, 108, 0.9);
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.qr-code {
  display: block;
  font-size: 20rpx;
  color: rgba(196, 167, 108, 0.6);
  letter-spacing: 1rpx;
  word-break: break-all;
  padding: 0 16rpx;
}

.info-section {
  padding: 32rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1px solid rgba(196, 167, 108, 0.1);
}

.row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.label {
  flex-shrink: 0;
  color: rgba(196, 167, 108, 0.7);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  padding-top: 4rpx;
}

.val {
  flex: 1;
  color: #D5D1C8;
  font-weight: 600;
  font-size: 28rpx;
  text-align: right;
  line-height: 1.5;
  word-break: break-word;
}

/* 核销印章 */
.stamp {
  position: absolute;
  top: 280rpx;
  right: 32rpx;
  transform: rotate(-18deg);
  z-index: 5;
  pointer-events: none;
}

.stamp-circle {
  width: 140rpx;
  height: 140rpx;
  border: 3rpx solid var(--gold);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--gold);
  font-weight: 700;
  background: rgba(196, 167, 108, 0.1);
}

.stamp-circle text {
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.stamp-date {
  font-size: 18rpx;
  margin-top: 4rpx;
}

/* ===== 底部固定操作栏 ===== */
.page-footer {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(26, 24, 20, 0.98);
  border-top: 1px solid rgba(38, 35, 32, 0.8);
  z-index: 10;
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.footer-btn.outline {
  background: transparent;
  border: 1px solid rgba(214, 64, 69, 0.4);
  color: #D64045;
}

.footer-btn.primary {
  background: var(--gold);
  border: none;
  color: #1A1814;
}

.footer-btn:active {
  opacity: 0.85;
}

/* CSS 日历图标（避免大图溢出） */
.icon-calendar {
  width: 28rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  position: relative;
  box-sizing: border-box;
  flex-shrink: 0;
}

.icon-calendar::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: 5rpx;
  width: 3rpx;
  height: 7rpx;
  background: currentColor;
  border-radius: 1rpx;
  box-shadow: 11rpx 0 0 currentColor;
}

.icon-calendar::after {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 3rpx;
  right: 3rpx;
  height: 2rpx;
  background: currentColor;
  opacity: 0.6;
}

/* ===== 改期弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background: #1F1D1A;
  border: 1px solid rgba(196, 167, 108, 0.25);
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid rgba(196, 167, 108, 0.15);
}

.modal-title {
  font-size: 30rpx;
  color: var(--gold);
  font-weight: 600;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(196, 167, 108, 0.7);
  font-size: 32rpx;
}

.modal-body {
  padding: 28rpx 32rpx;
}

.form-section {
  margin-bottom: 28rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: rgba(196, 167, 108, 0.8);
  margin-bottom: 16rpx;
}

.date-scroll {
  white-space: nowrap;
  height: 130rpx;
}

.date-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 112rpx;
  background: #262320;
  border-radius: 12rpx;
  margin-right: 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.2);
  vertical-align: top;
}

.date-pill.active {
  background: var(--gold);
  border-color: var(--gold);
}

.d-week {
  font-size: 20rpx;
  color: #A09A90;
  margin-bottom: 6rpx;
}

.date-pill.active .d-week,
.date-pill.active .d-day {
  color: #1A1814;
}

.d-day {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.time-btn {
  height: 72rpx;
  background: #262320;
  border: 1px solid rgba(196, 167, 108, 0.2);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D5D1C8;
  font-size: 26rpx;
}

.time-btn.active {
  background: var(--gold);
  border-color: var(--gold);
  color: #1A1814;
  font-weight: 600;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 32rpx;
  border-top: 1px solid rgba(196, 167, 108, 0.15);
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #262320;
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #A09A90;
}

.modal-btn.confirm {
  background: var(--gold);
  color: #1A1814;
}
