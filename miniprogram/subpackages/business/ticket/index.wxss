/* 入馆券（2026-10-17 重构）：博物馆黑票面 + 黄铜发丝框 + 浅纸二维码图版 + 撕票线 + 黄铜圆章；实心金只给「改期」 */
page {
  --color-primary: #C4A76C;
  --bg: #1A1814;
  background: var(--bg);
  height: 100%;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

/* ===== 顶部导航 ===== */
.page-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-bottom: 1px solid rgba(38, 35, 32, 0.8);
  background: rgba(26, 24, 20, 0.96);
  z-index: 10;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md, 16rpx);
  border: 1px solid transparent;
  background: transparent;
}

.page-title {
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.header-spacer {
  width: 64rpx;
}

/* ===== 主体滚动区
   iPhone：不用 flex:1 + height:0；预留底栏高度 */
.page-body {
  width: 100%;
  flex-shrink: 0;
  height: calc(100vh - 140rpx - env(safe-area-inset-bottom));
  max-height: calc(100vh - 140rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.ticket-body-safe {
  width: 100%;
  height: calc(32rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.ticket-wrap {
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.ticket-empty {
  padding: 120rpx 48rpx;
  text-align: center;
}
.ticket-empty-title {
  display: block;
  font-size: var(--fs-30);
  color: var(--color-text-body);
  margin-bottom: 12rpx;
}
.ticket-empty-desc {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: 40rpx;
}
.ticket-empty-cta {
  display: inline-block;
  padding: 16rpx 40rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.45);
  color: var(--brass-300);
  border-radius: 4rpx;
  font-size: var(--fs-26);
}

.ticket-box {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #24211C, #1F1D1A);
  border: 1rpx solid rgba(196, 167, 108, 0.32);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.5);
}

/* 内发丝框（与预约页翻转票 A 面同一家族） */
.ticket-box::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.14);
  pointer-events: none;
}

.ticket-header {
  padding: 44rpx 32rpx 8rpx;
  text-align: center;
}

.ticket-header text { display: block; }

.header-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.header-main {
  margin-top: 14rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.16em;
  color: var(--brass-200);
}

.sub {
  margin-top: 6rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.2em;
  color: rgba(232, 223, 203, 0.72);
}

.qr-section {
  padding: 36rpx 32rpx 8rpx;
  text-align: center;
}

/* 二维码图版：浅纸 + 墨色发丝框（码本身由 qrCanvas 画在 #FAF6ED 上） */
.qr-plate {
  display: inline-block;
  padding: 20rpx;
  margin-bottom: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: inset 0 0 0 1rpx rgba(46, 38, 24, 0.22), 0 10rpx 24rpx rgba(0, 0, 0, 0.36);
}

.qr-img {
  display: block;
  width: 280rpx;
  height: 280rpx;
  background: #FAF6ED;
}

.qr-live-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

/* 可核销：一枚铜色呼吸点（原信号灯） */
.live-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brass-300);
  animation: live-breathe 1.8s ease-in-out infinite;
}

@keyframes live-breathe {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(196, 167, 108, 0.12); }
  50% { box-shadow: 0 0 0 10rpx rgba(196, 167, 108, 0.22); }
}

@media (prefers-reduced-motion: reduce) {
  .live-dot { animation: none; }
}

.qr-tip {
  display: block;
  margin-bottom: 10rpx;
  font-size: var(--fs-24);
  letter-spacing: 0.08em;
  color: var(--brass-200);
}

.qr-live-row .qr-tip { margin-bottom: 0; }

.qr-tip.muted { color: var(--color-text-secondary, #A09A90); }

.qr-code {
  display: block;
  padding: 0 16rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: var(--brass-300);
  word-break: break-all;
}

/* 撕票线：两端半圆缺口挖成页面底色 */
.perf {
  display: flex;
  align-items: center;
  margin: 28rpx 0 4rpx;
}

.perf-notch {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #1A1814;
}

.perf-l { margin-left: -16rpx; }
.perf-r { margin-right: -16rpx; }

.perf-dash {
  flex: 1;
  height: 0;
  border-top: 2rpx dashed rgba(196, 167, 108, 0.24);
}

.info-section { padding: 8rpx 40rpx 36rpx; }

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.row:last-child { border-bottom: none; }

.label {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: var(--brass-300);
}

.val {
  flex: 1;
  font-size: var(--fs-28);
  line-height: 1.5;
  text-align: right;
  color: #F3ECDD;
  word-break: break-word;
}

.val-title { font-family: var(--font-brand); font-weight: 600; letter-spacing: 0.04em; }
.val-mono { font-family: var(--font-mono); }

/* 核销章：黄铜双圈圆章 */
.stamp {
  position: absolute;
  top: 300rpx;
  right: 40rpx;
  z-index: 5;
  transform: rotate(-16deg);
  pointer-events: none;
}

.stamp-circle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border: 3rpx solid var(--brass-300);
  border-radius: 50%;
  box-shadow: inset 0 0 0 6rpx #1F1D1A, inset 0 0 0 7rpx rgba(212, 188, 133, 0.6);
  background: rgba(26, 24, 20, 0.7);
  color: var(--brass-300);
}

.stamp-circle text {
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  letter-spacing: 0.2em;
}

.stamp-circle .stamp-date {
  margin-top: 4rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
}

/* ===== 底部固定操作栏：本屏唯一实心金 = 改期 ===== */
.page-footer {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(26, 24, 20, 0.98);
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  z-index: 10;
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 4rpx;
  font-size: var(--fs-28);
  letter-spacing: 0.12em;
}

/* 取消：中性描边（二次确认弹窗里才出现危险色） */
.footer-btn.outline {
  background: transparent;
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.4);
  color: var(--color-text-body, #D5D1C8);
}

.footer-btn.primary {
  background: var(--brass-400);
  color: #1A1814;
  font-weight: 600;
}

/* CSS 日历图标（避免大图溢出） */
.icon-calendar {
  width: 28rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  position: relative;
  box-sizing: border-box;
  flex-shrink: 0;
}

.icon-calendar::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: 5rpx;
  width: 3rpx;
  height: 7rpx;
  background: currentColor;
  border-radius: 1rpx;
  box-shadow: 11rpx 0 0 currentColor;
}

.icon-calendar::after {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 3rpx;
  right: 3rpx;
  height: 2rpx;
  background: currentColor;
  opacity: 0.6;
}

/* ===== 改期弹窗 ===== */
/* 改期：确认框形态（ui-pop-mask is-center is-toggle + ui-pop-dialog），这里只排表单（docs/弹层视觉规范_2026-10-13.md） */
.modal-content { width: 90%; max-width: 600rpx; }

.modal-body { padding: 8rpx 0 0; }

.form-section {
  margin-bottom: 28rpx;
}

.section-label {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.date-scroll {
  white-space: nowrap;
  height: 130rpx;
}

.date-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 112rpx;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-md);
  margin-right: 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.2);
  vertical-align: top;
}

/* 选中态：发丝金框 + 金字（实心金只留给「确认改期」） */
.date-pill.active {
  background: rgba(196, 167, 108, 0.12);
  border-color: var(--brass-400);
}

.d-week {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  margin-bottom: 6rpx;
}

.date-pill.active .d-week,
.date-pill.active .d-day {
  color: var(--brass-400);
}

.d-day {
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  font-weight: 700;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.time-btn {
  height: 72rpx;
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.2);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-body);
  font-size: var(--fs-26);
}

.time-btn.active {
  background: rgba(196, 167, 108, 0.12);
  border-color: var(--brass-400);
  color: var(--brass-400);
  font-weight: 600;
}

