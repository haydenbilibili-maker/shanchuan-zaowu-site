<view class="page">
  <view class="loading" wx:if="{{loading}}">加载地址…</view>

  <view class="empty" wx:elif="{{needLogin}}">
    <text>先重新进入</text>
    <text class="empty-sub">退出本机登录后，收货地址不会在此展示</text>
    <view class="add-btn primary" style="margin-top: 32rpx;" bindtap="goResumeLogin">重新进入</view>
  </view>

  <view class="addr-list" wx:elif="{{addresses.length > 0}}">
    <view
      class="addr-card {{item.isDefault ? 'default' : ''}}"
      wx:for="{{addresses}}"
      wx:key="_id"
      bindtap="onSelectAddress"
      data-index="{{index}}"
    >
      <view class="addr-head">
        <text class="addr-name">{{item.name}}</text>
        <text class="addr-phone">{{item.phone}}</text>
        <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
      </view>
      <text class="addr-detail">{{item.region[0]}} {{item.region[1]}} {{item.region[2]}} {{item.detail}}</text>
      <view class="addr-actions" catchtap="true">
        <text class="act-btn" catchtap="setDefault" data-id="{{item._id}}">设为默认</text>
        <text class="act-btn danger" catchtap="deleteAddress" data-id="{{item._id}}">删除</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text>暂无收货地址</text>
    <text class="empty-sub">可手动填写，或从微信通讯录导入</text>
  </view>

  <view class="add-bar" wx:if="{{!loading && !needLogin}}">
    <view class="add-btn" bindtap="importFromWechat">从微信导入</view>
    <view class="add-btn primary" bindtap="openManualForm">手动新增</view>
  </view>

  <!-- 手动填写地址 -->
  <view class="form-mask" wx:if="{{showManualForm}}" bindtap="closeManualForm" catchtouchmove="true">
    <view class="form-panel" catchtap="true">
      <view class="form-head">
        <text class="form-title">手动填写地址</text>
        <text class="form-close" bindtap="closeManualForm">✕</text>
      </view>

      <view class="form-body">
        <view class="form-row">
          <text class="form-label">收件人</text>
          <input class="form-input" placeholder="姓名" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
        </view>
        <view class="form-row">
          <text class="form-label">手机号</text>
          <input class="form-input" type="number" maxlength="11" placeholder="11 位手机号" value="{{form.phone}}" data-field="phone" bindinput="onFormInput" />
        </view>
        <view class="form-row" bindtap="onChooseRegion">
          <text class="form-label">省市区</text>
          <text class="form-value {{form.region.length ? '' : 'placeholder'}}">
            {{form.region.length ? form.region[0] + ' ' + form.region[1] + ' ' + form.region[2] : '请选择'}}
          </text>
        </view>
        <view class="form-row col">
          <text class="form-label">详细地址</text>
          <textarea
            class="form-textarea"
            placeholder="街道门牌等"
            value="{{form.detail}}"
            data-field="detail"
            bindinput="onFormInput"
            maxlength="120"
            auto-height
          />
        </view>
        <view class="form-row switch-row" bindtap="toggleDefault">
          <text class="form-label">设为默认地址</text>
          <view class="switch {{form.setAsDefault ? 'on' : ''}}"></view>
        </view>
      </view>

      <view class="form-footer">
        <view class="form-submit" bindtap="submitManualAddress">保存地址</view>
      </view>
    </view>
  </view>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal）；详见 utils/appModal.js -->
<app-modal id="appModal" />

  <!-- 统一主视觉提示（欢迎回来等）：原生 toast 与本产品视觉脱节，见 components/AppToast -->
  <app-toast
    show="{{toastShow}}"
    overline="{{toastOverline}}"
    title="{{toastTitle}}"
    desc="{{toastDesc}}"
    bind:close="onToastClose"
  />
