<view class="page">
  <view class="loading" wx:if="{{loading}}">加载地址…</view>

  <view class="empty" wx:elif="{{needLogin}}">
    <text>先重新进入</text>
    <text class="empty-sub">退出本机登录后，收货地址不会在此展示</text>
    <view class="add-btn primary" style="margin-top: 32rpx;" bindtap="goResumeLogin">重新进入</view>
  </view>

  <view class="addr-list" wx:elif="{{addresses.length > 0}}">
    <view
      class="addr-card {{item.isDefault ? 'default' : ''}}"
      wx:for="{{addresses}}"
      wx:key="_id"
      bindtap="onSelectAddress"
      data-index="{{index}}"
      hover-class="addr-card-press"
      hover-stay-time="80"
    >
      <view class="addr-head">
        <text class="addr-name">{{item.name}}</text>
        <text class="addr-phone">{{item.phone}}</text>
        <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
      </view>
      <text class="addr-detail">{{item.region[0]}} {{item.region[1]}} {{item.region[2]}} {{item.detail}}</text>
      <view class="addr-actions" catchtap="true">
        <view class="act-btn" wx:if="{{!item.isDefault}}" catchtap="setDefault" data-id="{{item._id}}" hover-class="tap-press" hover-stop-propagation>设为默认</view>
        <view class="act-btn danger" catchtap="deleteAddress" data-id="{{item._id}}" hover-class="tap-press" hover-stop-propagation>删除</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text>还没有收货地址</text>
    <text class="empty-sub">可手动填写，或一键导入微信里的收货地址</text>
  </view>

  <view class="add-bar" wx:if="{{!loading && !needLogin}}">
    <view class="add-btn" bindtap="importFromWechat" hover-class="tap-press" hover-stay-time="80">从微信导入</view>
    <view class="add-btn primary" bindtap="openManualForm" hover-class="tap-press" hover-stay-time="80">手动新增</view>
  </view>

  <!-- 手动填写地址 -->
  <view class="ui-pop-mask" wx:if="{{showManualForm}}" bindtap="closeManualForm" catchtouchmove="true">
    <view class="ui-pop-sheet" catchtap="true">
      <view class="ui-pop-grip"></view>
      <view class="ui-pop-head">
        <text class="ui-pop-kicker">ADDRESS</text>
        <text class="ui-pop-title">手动填写地址</text>
        <view class="ui-pop-close" bindtap="closeManualForm" hover-class="tap-press" hover-stay-time="80">✕</view>
      </view>

      <view class="form-body">
        <view class="form-field">
          <text class="form-label">收件人</text>
          <input class="form-input" placeholder="姓名" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
        </view>
        <view class="form-field">
          <text class="form-label">手机号</text>
          <input class="form-input" type="number" maxlength="11" placeholder="11 位手机号" value="{{form.phone}}" data-field="phone" bindinput="onFormInput" />
        </view>
        <view class="form-field">
          <text class="form-label">省市区</text>
          <picker mode="region" value="{{form.region}}" bindchange="onRegionChange">
            <view class="form-picker {{form.region.length ? '' : 'placeholder'}}">{{form.region.length ? form.region[0] + ' ' + form.region[1] + ' ' + form.region[2] : '请选择'}}</view>
          </picker>
        </view>
        <view class="form-field">
          <text class="form-label">详细地址</text>
          <textarea
            class="form-textarea"
            placeholder="街道门牌等"
            value="{{form.detail}}"
            data-field="detail"
            bindinput="onFormInput"
            maxlength="120"
            auto-height
          />
        </view>
        <view class="form-check" bindtap="toggleFormDefault">
          <view class="check-box {{form.setAsDefault ? 'on' : ''}}"></view>
          <text>设为默认地址</text>
        </view>
      </view>

      <view class="ui-pop-foot">
        <view class="ui-pop-btn is-primary {{saving ? 'is-disabled' : ''}}" bindtap="submitManualAddress" hover-class="{{saving ? '' : 'tap-press'}}" hover-stay-time="80">{{saving ? '保存中…' : '保存地址'}}</view>
      </view>
    </view>
  </view>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal）；详见 utils/appModal.js -->
<app-modal id="appModal" />

  <!-- 统一主视觉提示（欢迎回来等）：原生 toast 与本产品视觉脱节，见 components/AppToast -->
  <app-toast
    show="{{toastShow}}"
    overline="{{toastOverline}}"
    title="{{toastTitle}}"
    desc="{{toastDesc}}"
    bind:close="onToastClose"
  />
