page { background: #1A1814; color: #D5D1C8; padding-bottom: 160rpx; }
view, text { box-sizing: border-box; }

.page { padding: 24rpx; }

.addr-card {
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.4);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.addr-card.default { border-color: rgba(196, 167, 108, 0.4); }

.addr-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; flex-wrap: wrap; }
.addr-name { font-size: 32rpx; font-weight: 500; color: #fff; }
.addr-phone { font-size: 28rpx; color: #A09A90; }
.default-tag {
  font-size: 20rpx;
  color: #C4A76C;
  border: 1px solid rgba(196, 167, 108, 0.5);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.addr-detail { font-size: 26rpx; color: #D5D1C8; line-height: 1.5; display: block; }

.addr-actions { display: flex; gap: 32rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1px solid rgba(38, 35, 32, 0.6); }
.act-btn { font-size: 24rpx; color: #A09A90; }
.act-btn.danger { color: #D64045; }

.empty { text-align: center; padding: 120rpx 0; color: #6B6560; }
.empty-sub { display: block; font-size: 24rpx; margin-top: 12rpx; }

.add-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(26, 24, 20, 0.98);
  border-top: 1px solid rgba(38, 35, 32, 0.6);
}
.add-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border: 1px solid #C4A76C;
  color: #C4A76C;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.add-btn.primary {
  background: #C4A76C;
  color: #1A1814;
  border: none;
}
