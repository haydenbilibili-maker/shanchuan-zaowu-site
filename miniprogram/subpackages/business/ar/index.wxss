/* pages/ar/index.wxss */
/* 🟢 全局重置与防溢出 */
page { 
  background-color: #1A1814; 
  height: 100%; 
  width: 100%;
  overflow: hidden; /* 禁止溢出 */
  font-family: "DIN", sans-serif; 
}
view, text, image, slider { box-sizing: border-box; }

.container { width: 100%; height: 100%; position: relative; overflow: hidden; }

/* 相机层 */
.camera-view { width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: 1; }

/* === HUD 扫描层 === */
.scan-overlay {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
  z-index: 5; pointer-events: none; padding: 40rpx;
}

/* 网格背景 */
.grid-bg {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background-image: 
    linear-gradient(rgba(196, 167, 108,0.1) 1px, transparent 1px),
    linear-gradient(90deg, rgba(196, 167, 108,0.1) 1px, transparent 1px);
  background-size: 100rpx 100rpx;
  opacity: 0.3;
}

/* 顶部数据条 (防止溢出) */
.hud-top-bar {
  position: absolute; left: 0; width: 100%; 
  display: flex; justify-content: space-between; 
  padding: 0 40rpx; /* 左右留白 */
  box-sizing: border-box; /* 关键 */
}
.ht-item {
  background: rgba(0,0,0,0.5); color: #C4A76C; font-size: 20rpx; padding: 4rpx 12rpx; border: 1px solid rgba(196, 167, 108,0.3); border-radius: 4rpx; font-weight: bold;
}

/* 取景框四角 */
.corner { position: absolute; width: 80rpx; height: 80rpx; border-color: rgba(255,255,255,0.6); border-style: solid; }
.tl { top: 40rpx; left: 40rpx; border-width: 6rpx 0 0 6rpx; }
.tr { top: 40rpx; right: 40rpx; border-width: 6rpx 6rpx 0 0; }
.bl { bottom: 280rpx; left: 40rpx; border-width: 0 0 6rpx 6rpx; }
.br { bottom: 280rpx; right: 40rpx; border-width: 0 6rpx 6rpx 0; }

/* 扫描线动画 */
.scan-line {
  position: absolute; top: 0; left: 0; width: 100%; height: 2rpx;
  background: linear-gradient(to right, transparent, #C4A76C, transparent);
  box-shadow: none;
  animation: scan 3s ease-in-out infinite;
  opacity: 0.8;
}
@keyframes scan { 0% { top: 10%; opacity: 0; } 50% { opacity: 1; } 100% { top: 70%; opacity: 0; } }

/* HUD 底部 */
.hud-data.bottom { 
  position: absolute; bottom: 300rpx; left: 50%; transform: translateX(-50%); 
  text-align: center; animation: blink 2s infinite; 
}
.hud-label { font-size: 16rpx; color: #888; display: block; letter-spacing: 2rpx; }
.hud-val { font-size: 24rpx; color: #C4A76C; font-weight: bold; letter-spacing: 4rpx; }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

/* === 标本层 === */
.specimen-box { position: absolute; width: 400rpx; z-index: 10; }
.s-img { width: 100%; display: block; filter: drop-shadow(0 20rpx 30rpx rgba(0,0,0,0.5)); }

/* 智能锁定框 */
.target-lock {
  position: absolute; top: -20rpx; left: -20rpx; right: -20rpx; bottom: -20rpx;
  animation: breathe 2s infinite;
}
@keyframes breathe { 0% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.02); opacity: 0.4; } 100% { transform: scale(1); opacity: 0.8; } }

.c-mark { position: absolute; width: 20rpx; height: 20rpx; border-color: #C4A76C; border-style: solid; }
.target-lock .tl { top: 0; left: 0; border-width: 2rpx 0 0 2rpx; }
.target-lock .tr { top: 0; right: 0; border-width: 2rpx 2rpx 0 0; }
.target-lock .bl { bottom: 0; left: 0; border-width: 0 0 2rpx 2rpx; }
.target-lock .br { bottom: 0; right: 0; border-width: 0 2rpx 2rpx 0; }
.crosshair { 
  position: absolute; top: 50%; left: 50%; width: 20rpx; height: 20rpx; 
  border-left: 1px solid #C4A76C; border-top: 1px solid #C4A76C; 
  transform: translate(-50%, -50%) rotate(45deg); opacity: 0.5;
}

/* === UI 层 === */
.ui-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 20; pointer-events: none; }
.nav-bar, .controls { pointer-events: auto; }

.nav-bar { position: absolute; left: 30rpx; }
.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 24, 20, 0.5);
  border-radius: 50%;
  border: 1px solid transparent;
  backdrop-filter: blur(8px);
}

.controls {
  position: absolute; bottom: 0; width: 100%;
  background: linear-gradient(to top, #1A1814 20%, transparent);
  padding-bottom: 80rpx; display: flex; flex-direction: column; align-items: center;
}
.tips { color: #888; font-size: 22rpx; margin-bottom: 30rpx; letter-spacing: 2rpx; }

/* 🟢 修复：缩小滑块宽度，防止溢出 */
.slider-wrapper { 
  width: 65%; /* 缩小宽度 */
  display: flex; align-items: center; margin-bottom: 60rpx; 
}
.ar-slider { flex: 1; margin: 0 20rpx; } /* 减小 margin */
.lbl { color: #C4A76C; font-weight: bold; font-size: 28rpx; flex-shrink: 0; }

.shutter-btn {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  border: 4rpx solid rgba(196, 167, 108, 0.5);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s;
}
.shutter-btn:active,
.shutter-btn-press { transform: scale(0.9); opacity: 0.8; }
.inner { width: 110rpx; height: 110rpx; background: #C4A76C; border-radius: 50%; box-shadow: none; }

/* 闪光层 */
.flash-layer {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: #fff; z-index: 900; opacity: 0; pointer-events: none;
}
.flash-layer.active { opacity: 1; transition: opacity 0.1s ease-out; }

/* 分析中遮罩 */
.analyzing-mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.8); z-index: 800;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.scanner-bar { width: 100%; height: 4rpx; background: #C4A76C; box-shadow: 0 0 20rpx #C4A76C; animation: scan 1s infinite; }
.analyzing-mask text { margin-top: 40rpx; font-size: 24rpx; letter-spacing: 4rpx; color: #C4A76C; animation: blink 1s infinite; }

/* 预览层 */
.preview-mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: #1A1814; z-index: 999; display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.photo-frame { position: relative; padding: 20rpx; border: 1px solid #333; margin-bottom: 60rpx; }
.photo-result { height: 60vh; width: auto; }
.frame-corner { position: absolute; width: 20rpx; height: 20rpx; border-color: #C4A76C; border-style: solid; }
.frame-corner.tl { top: -2rpx; left: -2rpx; border-width: 4rpx 0 0 4rpx; }
.frame-corner.tr { top: -2rpx; right: -2rpx; border-width: 4rpx 4rpx 0 0; }
.frame-corner.bl { bottom: -2rpx; left: -2rpx; border-width: 0 0 4rpx 4rpx; }
.frame-corner.br { bottom: -2rpx; right: -2rpx; border-width: 0 4rpx 4rpx 0; }

.p-actions { display: flex; gap: 40rpx; width: 100%; justify-content: center; }
.btn {
  width: 240rpx; height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 40rpx; font-weight: bold; font-size: 26rpx;
}
.btn.retry { background: #222; color: #8A8A8A; border: 1px solid #444; }
.btn.save { background: linear-gradient(135deg, #A8903C, #C4A76C); color: #1A1814; box-shadow: none; }

/* === 定制试摆模式 === */
.container.custom-mode .scan-overlay { display: none; }

.wall-bg {
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(180deg, #262320 0%, #1A1814 100%);
  display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
  padding-bottom: 360rpx;
}

.wall-texture {
  position: absolute; inset: 0; opacity: 0.15;
  background-image: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 80rpx,
    rgba(196, 167, 108, 0.08) 80rpx,
    rgba(196, 167, 108, 0.08) 82rpx
  );
}

.wall-hint {
  position: relative; z-index: 2;
  font-size: 24rpx; color: #6B6560; letter-spacing: 0.06em;
}

.custom-hud {
  position: absolute; left: 32rpx; right: 32rpx; z-index: 15;
  pointer-events: none;
}

.custom-overline {
  display: block; font-size: 20rpx; color: #C4A76C; letter-spacing: 0.12em;
}

.custom-frame-name {
  display: block; font-size: 36rpx; color: #fff; font-weight: 600; margin-top: 8rpx;
}

.custom-specimen {
  display: block; font-size: 24rpx; color: #A09A90; margin-top: 4rpx;
}

.specimen-box.framed { width: 440rpx; }

.frame-outer {
  border-style: solid;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.45);
}

.frame-museum .frame-outer {
  box-shadow:
    inset 0 0 0 4rpx rgba(196, 167, 108, 0.35),
    0 24rpx 48rpx rgba(0, 0, 0, 0.5);
}

.frame-metal .frame-outer { box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.4); }

.frame-mat { box-sizing: border-box; }

.frame-switcher {
  width: 90%; white-space: nowrap; margin-bottom: 32rpx;
}

.frame-pill {
  display: inline-flex; align-items: center; height: 56rpx;
  padding: 0 24rpx; margin-right: 16rpx;
  border-radius: 9999px; font-size: 22rpx; color: #A09A90;
  background: rgba(31, 29, 26, 0.85); border: 1px solid rgba(38, 35, 32, 0.9);
}

.frame-pill.active {
  color: #C4A76C; border-color: #C4A76C;
  background: rgba(196, 167, 108, 0.12);
}

.shutter-tip, .static-tip {
  margin-top: 20rpx; font-size: 22rpx; color: #6B6560; letter-spacing: 0.04em;
}

.static-tip { text-align: center; padding: 0 48rpx; line-height: 1.5; }