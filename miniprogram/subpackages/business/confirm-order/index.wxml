<view class="page">
  <wxs src="../../../utils/latinDisplay.wxs" module="latin" />

  <!-- 授权回流提示：页内铜牌条，替代叠 toast -->
  <view
    class="auth-resume-hint"
    wx:if="{{showAuthResumeHint}}"
    bindtap="dismissAuthResumeHint"
    hover-class="tap-press-soft"
  >
    <text class="auth-resume-hint-text">{{authResumeHint}}</text>
    <text class="auth-resume-hint-close">收起</text>
  </view>

  <!-- 礼赠模式（蓝图 礼赠凭礼笺领取 §15）：送礼页 01 选礼 / 02 写笺 → 本页「03 交付与支付」。
       层级：步骤轨 → 礼物摘要（藏品 + 送给谁 + 礼笺摘录）→ 交付方式（四选一 + 跟随项：地址 / 门店 / 领取核验）→ 礼券与金额 → 底栏 -->
  <block wx:if="{{isGiftOrder}}">
  <view class="gift-rail">
    <view
      class="gift-rail-item done"
      data-step="1"
      bindtap="onGiftRailTap"
      hover-class="{{giftCanEditSteps ? 'tap-press' : 'none'}}"
      hover-stay-time="80"
      aria-role="button"
      aria-label="第 1 步 选礼"
    >
      <text class="gift-rail-num">01</text>
      <text class="gift-rail-label">选礼</text>
    </view>
    <view class="gift-rail-line"></view>
    <view
      class="gift-rail-item done"
      data-step="2"
      bindtap="onGiftRailTap"
      hover-class="{{giftCanEditSteps ? 'tap-press' : 'none'}}"
      hover-stay-time="80"
      aria-role="button"
      aria-label="第 2 步 写笺"
    >
      <text class="gift-rail-num">02</text>
      <text class="gift-rail-label">写笺</text>
    </view>
    <view class="gift-rail-line"></view>
    <view class="gift-rail-item on" aria-label="第 3 步 交付与支付（当前）">
      <text class="gift-rail-num">03</text>
      <text class="gift-rail-label">交付与支付</text>
    </view>
  </view>

  <!-- 礼物摘要：藏品一行 + 礼笺两行摘录（点开回写笺改）+ 包装 / 隐价一行 -->
  <view class="card gift-summary-card">
    <view class="gift-sum-goods" wx:for="{{items}}" wx:key="productId">
      <view class="gift-sum-img-wrap">
        <image class="gift-sum-img" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
        <view class="gift-sum-img goods-img-ph" wx:else>
          <image class="goods-img-ph-icon" src="/assets/icons/box.png" mode="aspectFit"></image>
        </view>
      </view>
      <view class="gift-sum-main">
        <text class="gift-sum-for">{{giftSelfTreat ? '犒劳自己' : (giftRecipientName ? '送给 · ' + giftRecipientName : '一份礼')}}</text>
        <text class="gift-sum-title">{{item.title}}</text>
        <!-- 单价不在摘要重复：下方账单「藏品合计」与底栏已给（2026-10-12 产品负责人：价格只在一处说清） -->
        <view class="gift-sum-row" wx:if="{{item.skuLabel || item.count > 1}}">
          <text class="gift-sum-sku">{{item.skuLabel || ''}}{{item.count > 1 ? ' ×' + item.count : ''}}</text>
        </view>
      </view>
    </view>
    <view
      class="gift-sum-letter"
      wx:if="{{giftCardBody || giftHasVoice}}"
      bindtap="onGiftRailTap"
      data-step="2"
      hover-class="{{giftCanEditSteps ? 'tap-press-soft' : 'none'}}"
      hover-stay-time="80"
    >
      <text class="gift-sum-letter-body" wx:if="{{giftCardBody}}">{{giftCardBody}}</text>
      <view class="gift-sum-letter-foot">
        <text class="gift-sum-sig" wx:if="{{giftCardSignature}}">— {{giftCardSignature}}</text>
        <text class="gift-sum-voice" wx:if="{{giftHasVoice}}">另封入一段声音</text>
        <text class="gift-sum-edit" wx:if="{{giftCanEditSteps}}">改礼笺 ›</text>
      </view>
    </view>
    <text class="gift-sum-wrap">{{giftPackagingNote}}{{giftHidePrice ? ' 礼笺与包裹不显示价格。' : ''}}</text>
  </view>

  <!-- 交付方式：四选一（门店自提关闭时三选一），选中项点亮；下面跟随该方式要填的东西 -->
  <view class="card gift-delivery-card" id="giftDeliveryCard">
    <text class="section-label">DELIVERY · {{giftSelfTreat ? '寄到哪里' : '怎样交给 TA'}}</text>
    <block wx:if="{{giftSelfTreat}}">
    <view class="delivery-opt active is-solo">
      <view class="delivery-radio" aria-hidden="true"></view>
      <view class="delivery-opt-main">
        <view class="delivery-head">
          <text class="delivery-name">寄到我的收货地址</text>
          <text class="delivery-tag">犒劳自己</text>
        </view>
        <text class="delivery-desc">{{giftDeliveryHint}}</text>
      </view>
    </view>
    <text class="claim-switch self-exit" wx:if="{{giftCanEditSteps}}" bindtap="onGiftRailTap" data-step="1">其实是送给别人？回到选礼换关系 ›</text>
    </block>
    <block wx:else>
    <view class="delivery-grid">
      <view
        class="delivery-tile {{giftDeliveryType === item.id ? 'active' : ''}}"
        wx:for="{{giftDeliveryOptions}}"
        wx:key="id"
        data-type="{{item.id}}"
        bindtap="onGiftSelectDelivery"
        hover-class="tap-press-soft"
        hover-stay-time="80"
        aria-role="radio"
        aria-checked="{{giftDeliveryType === item.id}}"
      >
        <view class="delivery-head">
          <view class="delivery-radio" aria-hidden="true"></view>
          <text class="delivery-name">{{item.name}}</text>
          <text class="delivery-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
        </view>
        <text class="delivery-short">{{item.short}}</text>
      </view>
    </view>
    <text class="delivery-hint">{{giftDeliveryHint}}</text>
    </block>

    <!-- 收货地址：快递给 TA / 寄给我 / 犒劳自己（与普通订单同一个地址页）；缺地址 / 号码不对就地描红 -->
    <view class="gift-follow ship-addr {{giftAddressError ? 'is-error' : ''}}" wx:if="{{giftNeedsAddress}}">
      <text class="follow-label">{{!giftSelfTreat && giftDeliveryType === 'ship_to_receiver' ? 'TA 的收货地址' : '我的收货地址'}} <text class="verify-set-req">* 必填</text></text>
      <view class="ship-addr-card {{address ? 'on' : ''}}" bindtap="chooseAddress" hover-class="tap-press-soft" hover-stay-time="80">
        <view class="ship-addr-main" wx:if="{{address}}">
          <view class="ship-addr-head">
            <text class="ship-addr-name">{{address.name}}</text>
            <text class="ship-addr-phone">{{address.phone}}</text>
          </view>
          <text class="ship-addr-detail">{{address.regionText}} {{address.detail}}</text>
        </view>
        <text class="ship-addr-ph" wx:else>{{!giftSelfTreat && giftDeliveryType === 'ship_to_receiver' ? '选择或新增 TA 的收货地址' : '选择或新增你的收货地址'}}</text>
        <text class="ship-addr-arrow" aria-hidden="true">›</text>
      </view>
      <view class="verify-set-err" wx:if="{{giftAddressError}}">
        <text class="verify-set-err-mark" aria-hidden="true">!</text>
        <text>{{giftAddressError}}</text>
      </view>
    </view>

    <!-- 门店自提：选门店；支付后得自提码，不另做核验 -->
    <view class="gift-follow store-pick {{giftStoreError ? 'is-error' : ''}}" wx:elif="{{isGiftStorePickup}}">
      <text class="follow-label">自提门店 <text class="verify-set-req">* 必选</text></text>
      <view class="store-chips">
        <view
          class="store-chip {{giftStoreId === item.storeId ? 'on' : ''}}"
          wx:for="{{giftStores}}"
          wx:key="storeId"
          data-id="{{item.storeId}}"
          data-name="{{item.name}}"
          bindtap="onGiftSelectStore"
          hover-class="tap-press-soft"
          hover-stay-time="80"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
      <text class="store-empty" wx:if="{{!giftStores.length}}">门店暂未就绪，稍后再选或换其他交付</text>
      <view class="verify-set-err" wx:if="{{giftStoreError}}">
        <text class="verify-set-err-mark" aria-hidden="true">!</text>
        <text>{{giftStoreError}}</text>
      </view>
      <view class="pickup-code-note">
        <text class="pickup-code-t">支付后生成自提码</text>
        <text class="pickup-code-d">可转发给 TA，到店出示由专员核销领取，不用另做核验</text>
      </view>
    </view>

    <!-- 领取核验：只在「邀请 TA 填地址」出现。手机号核验 / 凭礼笺领取（可加口令）；报错就地写在输入框下 -->
    <view class="gift-follow verify-set {{giftPhoneError ? 'is-error' : ''}}" wx:elif="{{isGiftInvite}}">
      <view class="verify-head">
        <text class="follow-label">领取核验</text>
        <text class="verify-mode" wx:if="{{giftClaimLink}}">{{giftClaimPasscode ? '凭礼笺 + 口令' : '凭礼笺领取'}}</text>
        <text class="verify-mode" wx:else>手机号核验</text>
      </view>
      <view class="verify-seg-row">
        <view
          class="verify-seg {{giftClaimLink ? '' : 'on'}} {{giftPhoneError ? 'is-error' : ''}}"
          data-mode="phone"
          bindtap="onGiftPickVerify"
          hover-class="verify-seg-press"
          hover-stay-time="80"
          aria-role="radio"
          aria-checked="{{!giftClaimLink}}"
        >
          <view class="verify-seg-radio" aria-hidden="true"></view>
          <view class="verify-seg-main">
            <text class="verify-seg-t">手机号核验</text>
            <text class="verify-seg-d">更安全 · 核对号码</text>
          </view>
        </view>
        <view
          class="verify-seg {{giftClaimLink ? 'on' : ''}}"
          data-mode="link"
          bindtap="onGiftPickVerify"
          hover-class="verify-seg-press"
          hover-stay-time="80"
          aria-role="radio"
          aria-checked="{{giftClaimLink}}"
        >
          <view class="verify-seg-radio" aria-hidden="true"></view>
          <view class="verify-seg-main">
            <text class="verify-seg-t">凭礼笺领取</text>
            <text class="verify-seg-d">不需要 TA 的手机号</text>
          </view>
        </view>
      </view>
      <block wx:if="{{giftClaimLink}}">
      <text class="verify-set-brief">TA 打开礼笺点「收下」即领取，一份限一人</text>
      <view
        class="claim-opt {{giftClaimPasscode ? 'on' : ''}}"
        bindtap="toggleGiftClaimPasscode"
        hover-class="verify-seg-press"
        hover-stay-time="80"
        aria-role="checkbox"
        aria-checked="{{giftClaimPasscode}}"
      >
        <view class="claim-check" aria-hidden="true"></view>
        <view class="claim-opt-main">
          <text class="claim-opt-t">加 6 位领取口令</text>
          <text class="claim-opt-d">{{giftClaimPasscode ? '已加 · TA 输对口令才能收下，口令只你看得到' : 'TA 输对才能收下，防止链接被转给别人'}}</text>
        </view>
      </view>
      <view class="verify-links">
        <text class="why-toggle {{giftVerifyWhyOpen ? 'open' : ''}}" bindtap="toggleGiftVerifyWhy">{{giftVerifyWhyOpen ? '收起规则' : '领取规则'}}</text>
      </view>
      <text class="verify-set-hint" wx:if="{{giftVerifyWhyOpen}}">TA 点「收下」即领取，仅限一人；收下前你可随时作废换链接。口令只有你看得到，礼笺不能发朋友圈。</text>
      </block>
      <block wx:else>
      <text class="verify-set-brief">TA 领取时核对这个号码，别人拿到链接也领不走</text>
      <input
        class="verify-set-input"
        type="number"
        maxlength="11"
        placeholder="TA 的 11 位手机号"
        placeholder-class="verify-set-ph"
        value="{{giftReceiverPhone}}"
        bindinput="onGiftPhoneInput"
      />
      <view class="verify-set-err" wx:if="{{giftPhoneError}}">
        <text class="verify-set-err-mark" aria-hidden="true">!</text>
        <text>{{giftPhoneError}}</text>
      </view>
      <view class="verify-links">
        <text class="why-toggle {{giftVerifyWhyOpen ? 'open' : ''}}" bindtap="toggleGiftVerifyWhy">{{giftVerifyWhyOpen ? '收起' : '为什么要填？'}}</text>
      </view>
      <text class="verify-set-hint" wx:if="{{giftVerifyWhyOpen}}">用于 TA 领取时核验，防止被他人领走；号码加密保存。</text>
      </block>
    </view>
  </view>
  </block>

  <!-- 收货地址：普通订单（门店自取不展示）；礼赠的地址在上面的交付卡里 -->
  <view class="card address-card" bindtap="chooseAddress" hover-class="address-card-hover" wx:if="{{!isGiftOrder && !storePickup}}">
    <block wx:if="{{address}}">
      <view class="addr-head">
        <text class="addr-name">{{address.name}}</text>
        <text class="addr-phone">{{address.phone}}</text>
      </view>
      <text class="addr-detail">{{address.regionText}} {{address.detail}}</text>
    </block>
    <block wx:else>
      <text class="addr-placeholder">请选择收货地址</text>
    </block>
    <text class="addr-arrow">›</text>
  </view>

  <!-- 普通订单：交付方式（快递 / 门店自取）；门店自取关闭时整卡隐藏 -->
  <view class="card fulfillment-card" wx:if="{{!isGiftOrder && storePickupEnabled}}">
    <text class="section-label">DELIVERY · 交付方式</text>
    <view class="fulfill-row">
      <view
        class="fulfill-opt {{!storePickup ? 'active' : ''}}"
        bindtap="setStorePickup"
        data-on="{{false}}"
        hover-class="tap-press-soft"
        hover-stay-time="80"
      >
        <text class="fulfill-opt-title">快递配送</text>
        <text class="fulfill-opt-sub">按址妥投 · 计运费</text>
      </view>
      <view
        class="fulfill-opt {{storePickup ? 'active' : ''}}"
        bindtap="setStorePickup"
        data-on="{{true}}"
        hover-class="tap-press-soft"
        hover-stay-time="80"
      >
        <text class="fulfill-opt-title">门店自取</text>
        <text class="fulfill-opt-sub">免运费 · 到店领取</text>
      </view>
    </view>
    <view class="pickup-hint" wx:if="{{storePickup}}">
      <text class="pickup-hint-title">{{pickupStoreName || '山川造物主店'}}</text>
      <text class="pickup-hint-addr" wx:if="{{pickupStoreAddress}}">{{pickupStoreAddress}}</text>
      <text class="pickup-hint-body">支付后专员备妥；到店出示订单，由专员核销后交付。</text>
    </view>
  </view>

  <!-- 定制摘要 -->
  <view class="card custom-card" wx:if="{{isCustomOrder && customPreviewLines.length}}">
    <view class="section-label">标本工坊 · 定制方案</view>
    <view class="custom-line" wx:for="{{customPreviewLines}}" wx:key="label">
      <text class="custom-label">{{item.label}}</text>
      <text class="custom-value {{item.latin ? 'latin' : ''}}">{{item.value}}</text>
    </view>
    <view class="custom-line" wx:if="{{customExtraPrice > 0}}">
      <text class="custom-label">定制加价</text>
      <text class="custom-value gold">+¥{{customExtraPrice}}</text>
    </view>
    <text class="custom-estimate" wx:if="{{customMeta.estimatedDays}}">预计 {{customMeta.estimatedDays}} 个工作日内发出</text>
  </view>

  <!-- 商品清单（礼赠模式藏品已在礼物摘要里，只留品牌说明） -->
  <view class="card">
    <block wx:if="{{!isGiftOrder}}">
    <view class="section-label">藏品清单</view>
    <view class="goods-item" wx:for="{{items}}" wx:key="productId">
      <view class="goods-img-wrap">
        <image class="goods-img" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
        <view class="goods-img goods-img-ph" wx:else>
          <image class="goods-img-ph-icon" src="/assets/icons/box.png" mode="aspectFit"></image>
        </view>
        <protected-badge product="{{item}}" size="xs" corner="bl" />
      </view>
      <view class="goods-info">
        <text class="goods-title">{{item.title}}</text>
        <text class="goods-sku" wx:if="{{item.skuLabel}}">{{item.skuLabel}}</text>
        <text class="goods-latin" wx:if="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
        <view class="goods-row">
          <text class="goods-price">¥{{item.price}}</text>
          <text class="goods-count">×{{item.count}}</text>
        </view>
      </view>
    </view>
    </block>
    <view class="brand-notes {{isGiftOrder ? 'is-solo' : ''}}">
      <view
        class="brand-note {{ethicsExpanded ? 'is-open' : ''}}"
        wx:if="{{showAnimalEthics}}"
        bindtap="toggleBrandNote"
        data-field="ethicsExpanded"
        hover-class="tap-press"
        hover-stay-time="80"
      >
        <view class="brand-note-head">
          <text class="brand-note-label">{{animalEthicsLabel}}</text>
          <text class="brand-note-chevron">›</text>
        </view>
        <text class="brand-note-summary" wx:if="{{!ethicsExpanded}}">{{animalEthicsSummary}}</text>
        <text class="brand-note-body" wx:else>{{animalEthicsNote}}</text>
      </view>
      <view
        class="brand-note {{pledgeExpanded ? 'is-open' : ''}}"
        bindtap="toggleBrandNote"
        data-field="pledgeExpanded"
        hover-class="tap-press"
        hover-stay-time="80"
      >
        <view class="brand-note-head">
          <text class="brand-note-label">{{onePercentPledgeLabel}}</text>
          <text class="brand-note-chevron">›</text>
        </view>
        <text class="brand-note-summary" wx:if="{{!pledgeExpanded}}">{{onePercentPledgeSummary}}</text>
        <text class="brand-note-body" wx:else>{{onePercentPledgeNote}}</text>
      </view>
    </view>
  </view>

  <!-- 备注：默认折叠行，点开后再展开；聚焦略增高 -->
  <view class="card remark-card {{remarkOpen ? 'is-open' : ''}}">
    <view
      class="remark-collapsed"
      wx:if="{{!remarkOpen}}"
      bindtap="openRemark"
      hover-class="remark-collapsed-hover"
      hover-stay-time="80"
    >
      <text class="remark-label">订单备注</text>
      <text class="remark-preview {{remark ? '' : 'muted'}}">{{remark || '添加备注'}}</text>
      <text class="row-arrow">›</text>
    </view>
    <block wx:else>
      <view class="remark-open-head">
        <text class="remark-label">订单备注</text>
        <text class="remark-done" bindtap="closeRemarkIfEmpty" wx:if="{{!remark}}">收起</text>
      </view>
      <textarea
        class="remark-input {{remarkFocused ? 'is-focused' : ''}}"
        placeholder="选填：包装、配送等特殊要求"
        maxlength="200"
        value="{{remark}}"
        focus="{{remarkFocus}}"
        auto-height="{{true}}"
        show-confirm-bar="{{false}}"
        adjust-position="{{true}}"
        bindinput="onRemarkInput"
        bindfocus="onRemarkFocus"
        bindblur="onRemarkBlur"
      />
    </block>
  </view>

  <!-- 我的钱包：皮质卡与「我的钱包」页共用样式；金额明细落在下方账单 -->
  <view class="wallet-leather-card wallet-leather-card--checkout {{useWalletPay ? 'is-on' : ''}}" wx:if="{{walletEnabled}}">
    <view class="wallet-leather-card__inner">
      <view class="wallet-leather-card__head-row wallet-leather-card__head--inline">
        <text class="wallet-leather-tag">WALLET</text>
        <text class="wallet-leather-title-muted">我的钱包</text>
      </view>

      <view class="wallet-leather-balance-block">
        <text class="wallet-leather-overline">可用余额</text>
        <view class="wallet-leather-balance-row {{walletBalancePending ? 'is-pending' : ''}}">
          <text class="wallet-leather-currency">¥</text>
          <text class="wallet-leather-balance">{{walletAvailableYuan}}</text>
        </view>
      </view>

      <text class="wallet-benefit">{{walletBenefitText}}</text>

      <view class="wallet-toggle-row wallet-leather-seam">
        <view class="wallet-toggle-copy">
          <text class="wallet-toggle-label">用钱包支付</text>
          <text class="wallet-toggle-hint">{{useWalletPay ? '已启用，抵扣见下方账单' : '余额可抵扣本单应付'}}</text>
        </view>
        <switch
          class="wallet-switch"
          checked="{{useWalletPay}}"
          disabled="{{walletBalancePending || walletAvailableFen <= 0 || walletToggling}}"
          color="#C4A76C"
          bindchange="onWalletPayToggle"
        />
      </view>
    </view>
  </view>

  <!-- 单一账单：商品合计 → 优惠券 → 折扣 → 运费/快递 → 应付
       2026-10-12 产品负责人点名重排：左「名目 + 小注」/ 右「金额」两栏；金额同一等宽字、减项金色带 −；
       说明性文字（礼券为何不可用、包邮规则）收进名目下小注，不再在右栏长句或单独起一行；只在应付前一道分隔 -->
  <view class="card bill-card {{useWalletPay ? 'bill-wallet' : ''}}">
    <view class="section-label">账单</view>

    <view class="bl-row">
      <view class="bl-l"><text class="bl-label">藏品合计</text></view>
      <text class="bl-v">¥{{originalPrice}}</text>
    </view>

    <view
      class="bl-row {{couponRowBlocked ? 'is-blocked' : 'is-tap'}}"
      bindtap="openCouponModal"
      hover-class="{{couponRowBlocked ? '' : 'bl-row-press'}}"
      hover-stay-time="80"
    >
      <view class="bl-l">
        <text class="bl-label">礼券</text>
        <text class="bl-note" wx:if="{{!selectedCoupon && couponRowNote}}">{{couponRowNote}}</text>
      </view>
      <view class="bl-v-wrap">
        <text class="bl-v is-gold is-text" wx:if="{{selectedCoupon && couponHint}}">{{couponHint}}</text>
        <text class="bl-v is-gold is-text" wx:elif="{{selectedCoupon}}">已选礼券</text>
        <text class="bl-v is-text {{couponRowBlocked ? 'is-muted' : ''}}" wx:else>{{couponRowShort || couponRowText}}</text>
        <text class="bl-arrow" wx:if="{{!couponRowBlocked}}">›</text>
      </view>
    </view>

    <view class="bl-row" wx:if="{{discountRate < 1 && vipSaved > 0}}">
      <view class="bl-l">
        <view class="bl-label-line">
          <text class="bl-label">{{discountLabel}}</text>
          <text class="bl-chip">{{discountText}}</text>
        </view>
      </view>
      <text class="bl-v is-gold">−¥{{vipSavedYuan}}</text>
    </view>
    <view class="bl-row" wx:if="{{depositCredit > 0}}">
      <view class="bl-l"><text class="bl-label">已付定金抵扣</text></view>
      <text class="bl-v is-gold">−¥{{depositCreditDisplay}}</text>
    </view>
    <view class="provisional-tip" wx:if="{{provisionalTip}}">{{provisionalTip}}</view>

    <view class="bl-row">
      <view class="bl-l">
        <text class="bl-label">{{storePickup || isGiftStorePickup ? '运费（门店自取）' : shippingLineLabel}}</text>
        <text class="bl-note {{isShippingFree ? '' : 'is-nudge'}}" wx:if="{{!storePickup && !isGiftStorePickup && shippingRuleText}}">{{shippingRuleText}}</text>
      </view>
      <view class="bl-v-wrap">
        <text wx:if="{{showShippingStrike}}" class="bl-strike">¥{{originalShippingFeeDisplay}}</text>
        <text class="bl-v {{isShippingFree || storePickup || isGiftStorePickup ? 'is-gold is-text' : ''}}">{{storePickup || isGiftStorePickup ? '自取免运费' : shippingFeeLabel}}</text>
      </view>
    </view>

    <view class="bl-row" wx:if="{{useWalletPay}}">
      <view class="bl-l"><text class="bl-label">订单应付</text></view>
      <text class="bl-v">¥{{finalPrice}}</text>
    </view>
    <view class="bl-row" wx:if="{{useWalletPay && walletPayYuan !== '0.00'}}">
      <view class="bl-l"><text class="bl-label">钱包抵扣</text></view>
      <text class="bl-v is-gold">−¥{{walletPayYuan}}</text>
    </view>

    <view class="bl-total">
      <text class="bl-total-label">{{payNowLabel}}</text>
      <text class="total-price">¥{{payNowYuan}}</text>
    </view>
    <text class="summary-foot-hint" wx:if="{{useWalletPay && wxpayYuan !== '0.00'}}">尾款将通过微信支付</text>
    <text class="summary-foot-hint" wx:elif="{{useWalletPay && wxpayYuan === '0.00'}}">本单将全额使用钱包余额</text>
  </view>

  <view class="aftercare-plate" wx:if="{{refundPolicyLabel}}">
    <view class="aftercare-head">
      <view class="aftercare-title-col">
        <text class="aftercare-overline">AFTERCARE · 售后约定</text>
        <text class="aftercare-title">{{refundPolicyShort || refundPolicyLabel}}</text>
      </view>
      <text class="aftercare-chip">{{refundPolicyLabel}}</text>
    </view>
    <view class="aftercare-body">
      <view class="aftercare-para" wx:for="{{refundPolicyRichParagraphs}}" wx:for-item="para" wx:key="idx">
        <text
          wx:for="{{para.segments}}"
          wx:for-item="seg"
          wx:key="i"
          class="{{seg.warn ? 'aftercare-warn' : ''}} {{seg.em ? 'aftercare-em' : ''}} {{seg.strong ? 'aftercare-strong' : ''}}"
        >{{seg.t}}</text>
      </view>
    </view>
    <view class="aftercare-link" bindtap="goToSupport" hover-class="aftercare-link-press" hover-stay-time="80">
      <text class="aftercare-link-hint">对售后有疑问？</text>
      <text class="aftercare-link-label">联系专员</text>
      <text class="aftercare-link-arrow">›</text>
    </view>
  </view>

  <!-- 底部提交 -->
  <view class="footer-bar">
    <view class="footer-price">
      <view class="fp-row">
        <text class="fp-label">{{footerPayLabel}}</text>
        <text class="fp-value">¥{{payNowYuan}}</text>
      </view>
      <!-- 有会员省额时底栏说一句（礼赠与普通订单同一口径；送礼页不再报价，2026-10-12） -->
      <text class="fp-note" wx:if="{{discountRate < 1 && vipSaved > 0}}">{{levelName}} {{discountText}} · 已省 ¥{{vipSavedYuan}}</text>
    </view>
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submitOrder" hover-class="{{submitting ? '' : 'submit-btn-hover'}}">
      {{submitting ? (isGiftOrder ? '备妥中…' : '处理中…') : (isGiftOrder ? (useWalletPay && wxpayYuan === '0.00' ? '钱包支付并备妥' : '支付并备妥') : (useWalletPay && wxpayYuan === '0.00' ? '钱包支付' : '提交订单'))}}
    </view>
  </view>
</view>

<!-- 优惠券弹窗 -->
<view class="ui-pop-mask" wx:if="{{showCouponModal}}" bindtap="closeCouponModal" catchtouchmove="true">
  <view class="ui-pop-sheet" catchtap="true">
    <view class="ui-pop-grip"></view>
    <view class="ui-pop-head">
      <text class="ui-pop-kicker">COUPONS</text>
      <text class="ui-pop-title">选择礼券</text>
      <text class="ui-pop-close" bindtap="closeCouponModal">✕</text>
    </view>
    <!-- 列表区按条数定高（券行约 156rpx、「不使用」行 112rpx），满 4 张再封顶 50vh -->
    <scroll-view scroll-y class="coupon-scroll" style="height: {{coupons.length >= 4 ? '50vh' : (coupons.length * 156 + 136) + 'rpx'}};" enhanced show-scrollbar="{{false}}">
      <view class="ui-pop-body">
        <view
          class="ui-pop-row {{!selectedCoupon ? 'is-on' : ''}}"
          bindtap="selectCoupon"
          data-index="-1"
          hover-class="tap-press-soft"
          hover-stay-time="80"
        >
          <view class="ui-pop-row-main"><text class="ui-pop-row-t">不使用礼券</text></view>
          <view class="ui-pop-radio {{!selectedCoupon ? 'is-on' : ''}}"></view>
        </view>
        <view
          class="ui-pop-row {{item._disabled ? 'is-off is-locked' : ''}} {{selectedCoupon && selectedCoupon._id === item._id ? 'is-on' : ''}}"
          wx:for="{{coupons}}"
          wx:key="_id"
          bindtap="selectCoupon"
          data-index="{{index}}"
          hover-class="tap-press-soft"
          hover-stay-time="80"
        >
          <text class="ui-pop-row-lead">{{item.faceLabel || ('¥' + item.value)}}</text>
          <view class="ui-pop-row-main">
            <text class="ui-pop-row-t">{{item.title || item.name || '礼券'}}</text>
            <text class="ui-pop-row-d">{{item.minSpend > 0 ? '满 ¥' + item.minSpend + ' 可用' : '无门槛'}}</text>
            <!-- 关键：展示**本单实际可省**（由本单金额算出），而非券面额；面额与本单实减常常不等 -->
            <text class="ui-pop-row-note" wx:if="{{item._save > 0}}">本单可省 ¥{{item._save}}</text>
            <text class="ui-pop-row-note is-off" wx:elif="{{item._reason}}">{{item._reason}}</text>
          </view>
          <view class="ui-pop-radio {{selectedCoupon && selectedCoupon._id === item._id ? 'is-on' : ''}}"></view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 启程前须知 / 温馨提示：共用居中铜牌；可控分行，保留博物柜温度 -->
<view class="ui-pop-mask is-center specimen-mask" wx:if="{{showCareNotice}}" catchtouchmove="true">
  <view class="ui-pop-dialog specimen-panel" catchtap="true">
    <view class="ui-pop-head">
      <text class="ui-pop-kicker">BEFORE YOU GO</text>
      <text class="ui-pop-title">{{careNoticeTitle}}</text>
    </view>
    <text class="notice-intro" wx:if="{{careNoticeIntro}}">{{careNoticeIntro}}</text>

    <view class="notice-block">
      <text class="notice-block-label">{{careUnboxLabel}}</text>
      <view
        class="notice-line"
        wx:for="{{careUnboxLines}}"
        wx:for-item="line"
        wx:for-index="li"
        wx:key="li"
      >
        <text
          wx:for="{{line.segs}}"
          wx:for-item="seg"
          wx:for-index="si"
          wx:key="si"
          class="{{seg.brass ? 'notice-brass' : ''}}"
        >{{seg.t}}</text>
      </view>
      <block wx:if="{{careHasButterfly}}">
        <view
          class="notice-line notice-antenna"
          wx:for="{{careAntennaLines}}"
          wx:for-item="line"
          wx:for-index="li"
          wx:key="li"
        >
          <text
            wx:for="{{line.segs}}"
            wx:for-item="seg"
            wx:for-index="si"
            wx:key="si"
            class="{{seg.brass ? 'notice-brass' : ''}}"
          >{{seg.t}}</text>
        </view>
      </block>
    </view>

    <view class="notice-block-rule" aria-hidden="true"></view>

    <view class="notice-block">
      <text class="notice-block-label">{{careCareLabel}}</text>
      <view
        class="notice-line"
        wx:for="{{careCareLines}}"
        wx:for-item="line"
        wx:for-index="li"
        wx:key="li"
      >
        <text
          wx:for="{{line.segs}}"
          wx:for-item="seg"
          wx:for-index="si"
          wx:key="si"
          class="{{seg.brass ? 'notice-brass' : ''}}"
        >{{seg.t}}</text>
      </view>
    </view>

    <view class="ui-pop-foot">
      <view class="ui-pop-btn is-ghost" bindtap="closeCareNotice" hover-class="tap-press" hover-stay-time="80">再看看</view>
      <view class="ui-pop-btn is-primary" bindtap="confirmCareNotice" hover-class="tap-press" hover-stay-time="80">已知悉，继续</view>
    </view>
  </view>
</view>

<!-- 标本 uniqueness 提示（同款居中铜牌；正文左齐，有温度） -->
<view class="ui-pop-mask is-center specimen-mask" wx:if="{{showSpecimenNotice}}" catchtouchmove="true">
  <view class="ui-pop-dialog specimen-panel" catchtap="true">
    <view class="ui-pop-head">
      <text class="ui-pop-kicker">NOTICE</text>
      <text class="ui-pop-title">温馨提示</text>
    </view>
    <view
      class="notice-line notice-line--warm"
      wx:for="{{specimenNoticeBodyLines}}"
      wx:for-item="line"
      wx:for-index="li"
      wx:key="li"
    >
      <text
        wx:for="{{line.segs}}"
        wx:for-item="seg"
        wx:for-index="si"
        wx:key="si"
        class="{{seg.brass ? 'notice-brass' : ''}}"
      >{{seg.t}}</text>
    </view>
    <view class="specimen-note notice-line--warm">
      <text
        wx:for="{{specimenNoticeNoteSegments}}"
        wx:for-item="seg"
        wx:for-index="si"
        wx:key="si"
        class="{{seg.brass ? 'notice-brass' : ''}}"
      >{{seg.t}}</text>
    </view>
    <view class="specimen-pledge-plate" wx:if="{{specimenPledgeLine}}">
      <view class="specimen-pledge-corner tl" aria-hidden="true"></view>
      <view class="specimen-pledge-corner tr" aria-hidden="true"></view>
      <view class="specimen-pledge-corner bl" aria-hidden="true"></view>
      <view class="specimen-pledge-corner br" aria-hidden="true"></view>
      <view class="specimen-pledge-inner">
        <text class="specimen-pledge-label">{{onePercentPledgeLabel}}</text>
        <text class="specimen-pledge-slogan">{{onePercentPledgeSlogan}}</text>
        <view class="specimen-pledge-rule" aria-hidden="true"></view>
        <text class="specimen-pledge-line" wx:if="{{specimenPledgeHasAmount}}">
          <text>{{specimenPledgeLineBefore}}</text><text class="specimen-pledge-amount">{{specimenPledgeLineAmount}}</text><text>{{specimenPledgeLineAfter}}</text>
        </text>
        <text class="specimen-pledge-line" wx:else>{{specimenPledgeLine}}</text>
      </view>
    </view>
    <view class="ui-pop-foot">
      <view class="ui-pop-btn is-ghost" bindtap="closeSpecimenNotice" hover-class="tap-press" hover-stay-time="80">再看看</view>
      <view class="ui-pop-btn is-primary" bindtap="confirmSpecimenNotice" hover-class="tap-press" hover-stay-time="80">已知悉，继续</view>
    </view>
  </view>
</view>

<!-- 未绑手机号时原地注册（按需加载 feature 分包组件；未就绪时退回跳注册页）。协议默认不勾、「先不注册」只关弹层 -->
<register-auth-dialog
  id="regDialog"
  show="{{regDialogShow}}"
  from="checkout"
  closable="{{true}}"
  close-text="先不注册"
  mask-closable="{{false}}"
  overline="CHECKOUT"
  title="授权手机号，继续下单"
  desc="订单与售后通知需要手机号。未注册将同步建档，新客礼放入账户。"
  lead="授权后自动继续刚才的下单"
  cta="授权手机号 · 继续下单"
  login-title="确认手机号，继续下单"
  login-desc="该微信已完成注册，授权手机号即可继续下单。"
  login-cta="授权手机号 · 继续下单"
  bind:success="onRegDialogSuccess"
  bind:close="onRegDialogClose"
/>

<!-- 全站样式化弹窗宿主（替代 wx.showModal）；详见 utils/appModal.js -->
<app-modal id="appModal" />
