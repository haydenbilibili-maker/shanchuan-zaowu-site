}
.wallet-leather-card::after {
  background:
    linear-gradient(118deg, transparent 30%, rgba(255, 232, 196, 0.07) 46%, rgba(255, 232, 196, 0.12) 50%, rgba(255, 232, 196, 0.05) 56%, transparent 70%),
    linear-gradient(180deg, rgba(255, 226, 180, 0.08) 0%, transparent 22%, transparent 74%, rgba(8, 6, 4, 0.45) 100%);
}
.wallet-leather-card__inner::before {
  inset: 16rpx;
  border: 2rpx dashed rgba(201, 168, 106, 0.55);
  box-shadow: 0 0 0 3rpx rgba(8, 6, 4, 0.28), inset 0 0 0 3rpx rgba(8, 6, 4, 0.28);
}
