@import './wallet-leather.wxss';

page {
  background: #1A1814;
  color: #D5D1C8;
  width: 100%;
  overflow-x: hidden;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
view, text, scroll-view { box-sizing: border-box; }

.page { padding: 24rpx; width: 100%; max-width: 100%; box-sizing: border-box; overflow-x: hidden; }

.auth-resume-hint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 28rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 16rpx;
}

.auth-resume-hint-press {
  opacity: 0.88;
}

.auth-resume-hint-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #D4BC85;
  line-height: 1.5;
}

.auth-resume-hint-close {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8A7530;
  letter-spacing: 0.04em;
}

.card {
  background: #1F1D1A;
  border: 1px solid #262320;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.address-card { position: relative; padding-right: 60rpx; }
.address-card-hover { background: #262320; }
.addr-head { display: flex; gap: 24rpx; margin-bottom: 12rpx; }
.addr-name { font-size: 32rpx; font-weight: 500; color: #FFFFFF; }
.addr-phone { font-size: 28rpx; color: #A09A90; }
.addr-detail { font-size: 26rpx; color: #D5D1C8; line-height: 1.5; }
.addr-placeholder { font-size: 30rpx; color: #C4A76C; }
.addr-arrow { position: absolute; right: 32rpx; top: 50%; transform: translateY(-50%); font-size: 40rpx; color: #6B6560; }

.fulfillment-card {
  border-color: rgba(196, 167, 108, 0.28);
}
.fulfill-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.fulfill-opt {
  flex: 1;
  min-width: 0;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid #262320;
  background: #1A1814;
}
.fulfill-opt.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}
.fulfill-opt-press { opacity: 0.88; }
.fulfill-opt-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}
.fulfill-opt.active .fulfill-opt-title { color: #C4A76C; }
.fulfill-opt-sub {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.4;
}
.pickup-hint {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px solid #262320;
}
.pickup-hint-title {
  display: block;
  font-size: 28rpx;
  color: #C4A76C;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  margin-bottom: 8rpx;
}
.pickup-hint-addr {
  display: block;
  font-size: 24rpx;
  color: #D5D1C8;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.pickup-hint-body {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.55;
}

.gift-invite-card {
  border-color: rgba(196, 167, 108, 0.45);
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.06) 0%, #1F1D1A 48%);
}
.gift-invite-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #C4A76C;
  margin: 8rpx 0 12rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
}
.gift-invite-desc {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.65;
}

.gift-pack-note {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.45);
}

.gift-pack-label {
  display: block;
  font-size: 20rpx;
  color: #C4A76C;
  letter-spacing: 0.1em;
  margin-bottom: 8rpx;
}

.gift-pack-body {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.65;
}

.brand-notes {
  margin-top: 16rpx;
  padding-top: 4rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.4);
}
.brand-note {
  padding: 18rpx 0 4rpx;
}
.brand-note + .brand-note {
  margin-top: 8rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.28);
}
.brand-note-press {
  opacity: 0.72;
}
.brand-note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.brand-note-label {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #C4A76C;
  letter-spacing: 0.1em;
}
.brand-note-chevron {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1;
  color: #6B6560;
  transition: transform 0.2s ease;
}
.brand-note.is-open .brand-note-chevron {
  transform: rotate(90deg);
  color: #C4A76C;
}
.brand-note-summary {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.5;
}
.brand-note-body {
  display: block;
  font-size: 24rpx;
  color: #D5D1C8;
  line-height: 1.65;
}

.gift-note-card {
  border-color: rgba(196, 167, 108, 0.35);
  background: #F2EDE4;
}
.gift-note-card .section-label {
  color: #8A7530;
}
.gift-note-body {
  display: block;
  font-size: 28rpx;
  color: #33302C;
  line-height: 1.7;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
}
.gift-note-voice {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8A7530;
  letter-spacing: 0.04em;
}
.gift-note-sig {
  display: block;
  margin-top: 20rpx;
  text-align: right;
  font-size: 24rpx;
  color: #8A7530;
}

.section-label {
  font-size: 22rpx;
  color: #6B6560;
  letter-spacing: 0.1em;
  margin-bottom: 24rpx;
}

.goods-item { display: flex; gap: 24rpx; padding: 16rpx 0; border-bottom: 1px solid rgba(38, 35, 32, 0.6); }
.goods-item:last-child { border-bottom: none; }
.goods-img-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #262320;
}
.goods-img { width: 100%; height: 100%; display: block; background: #262320; }
.goods-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.goods-title { font-size: 28rpx; color: #D5D1C8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-latin { font-size: 22rpx; color: #C4A76C; font-style: italic; margin-top: 4rpx; }
.goods-sku { font-size: 22rpx; color: #A09A90; margin-top: 4rpx; display: block; }
.shipping-tip {
  font-size: 22rpx;
  color: #6B6560;
  padding: 4rpx 0 16rpx;
  line-height: 1.45;
}
.shipping-tip.campaign,
.shipping-tip.free { color: #C4A76C; }
.provisional-tip {
  font-size: 22rpx;
  color: #C4A76C;
  padding: 0 0 16rpx;
  line-height: 1.4;
  margin-top: -8rpx;
}
.shipping-fee-value { justify-content: flex-end; }
.shipping-fee-strike {
  color: #6B6560;
  font-size: 24rpx;
  text-decoration: line-through;
  font-family: monospace;
}
.shipping-free-tag {
  color: #C4A76C;
  font-weight: 500;
  letter-spacing: 0.04em;
}
.aftercare-plate {
  position: relative;
  background: #1F1D1A;
  border: 1px solid #262320;
  border-left: 4rpx solid #C4A76C;
  border-radius: 24rpx;
  padding: 28rpx 32rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.aftercare-plate::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 1px;
  background: rgba(196, 167, 108, 0.35);
}
.aftercare-overline {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
  color: #C4A76C;
  margin-bottom: 20rpx;
}
.aftercare-body {
  margin-bottom: 8rpx;
}
.aftercare-para {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.7;
  margin-bottom: 12rpx;
}
.aftercare-para:last-child { margin-bottom: 0; }
.aftercare-warn {
  color: #E9A23B;
  font-weight: 500;
}
.aftercare-em {
  color: #C4A76C;
}
.aftercare-strong {
  font-weight: 600;
}
.aftercare-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 12rpx 20rpx;
  border: 1px solid rgba(196, 167, 108, 0.45);
  border-radius: 16rpx;
  background: transparent;
}
.aftercare-link-label {
  font-size: 24rpx;
  color: #C4A76C;
  font-weight: 500;
  letter-spacing: 0.04em;
}
.aftercare-link-arrow {
  font-size: 24rpx;
  color: #C4A76C;
  line-height: 1;
}
.aftercare-link-press {
  opacity: 0.78;
  background: rgba(196, 167, 108, 0.08);
}
/* 订单备注：默认单行折叠，与地址/账单行节奏一致 */
.remark-card {
  padding: 22rpx 32rpx;
}
.remark-card.is-open {
  padding-bottom: 24rpx;
}
.remark-collapsed {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 48rpx;
}
.remark-collapsed-hover {
  opacity: 0.88;
}
.remark-label {
  font-size: 28rpx;
  color: #A09A90;
  flex-shrink: 0;
}
.remark-preview {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #D5D1C8;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.remark-preview.muted {
  color: #6B6560;
}
.remark-open-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.remark-done {
  font-size: 24rpx;
  color: #C4A76C;
  padding: 4rpx 0 4rpx 16rpx;
}
.remark-input {
  width: 100%;
  min-height: 64rpx;
  max-height: 160rpx;
  background: #262320;
  border: 1px solid #262320;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.45;
  box-sizing: border-box;
}
.remark-input.is-focused {
  min-height: 96rpx;
  border-color: rgba(196, 167, 108, 0.35);
}
.goods-row { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.goods-price { font-size: 28rpx; color: #C4A76C; font-family: monospace; }
.goods-count { font-size: 24rpx; color: #A09A90; }

.row-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid rgba(38, 35, 32, 0.55);
}
.row-item:last-child { border-bottom: none; }
.row-item-tap { margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; border-radius: 12rpx; }
.row-item-blocked { margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; }
.row-item-press { background: rgba(196, 167, 108, 0.06); }
.row-label { font-size: 28rpx; color: #A09A90; flex-shrink: 0; max-width: 62%; }
.row-value { font-size: 28rpx; color: #D5D1C8; display: flex; align-items: center; gap: 8rpx; }
.row-value.gold { color: #C4A76C; }
.row-value.mono { font-family: monospace; }
.row-arrow { color: #6B6560; font-size: 32rpx; }
.coupon-hint { color: #C4A76C; }
.coupon-hint.muted { color: #6B6560; }
.coupon-hint.muted.blocked {
  color: #A09A90;
  max-width: 420rpx;
  text-align: right;
  line-height: 1.35;
  font-size: 24rpx;
}
.mono { font-family: monospace; }

.total-row {
  border-top: 1px solid rgba(196, 167, 108, 0.22);
  border-bottom: none;
  margin-top: 4rpx;
  padding-top: 24rpx;
  padding-bottom: 0;
}
.total-label { color: #D5D1C8; font-weight: 500; }
.total-price { font-size: 40rpx; font-weight: 600; color: #C4A76C; font-family: monospace; }

.footer-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(26, 24, 20, 0.98);
  border-top: 1px solid rgba(38, 35, 32, 0.6);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.footer-price { display: flex; align-items: baseline; gap: 8rpx; }
.fp-label { font-size: 24rpx; color: #A09A90; }
.fp-value { font-size: 40rpx; font-weight: 600; color: #C4A76C; font-family: monospace; }
.submit-btn {
  background: #C4A76C;
  color: #1A1814;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 64rpx;
  border-radius: 16rpx;
}
.submit-btn-hover { background: #A8903C; }
.submit-btn.disabled { opacity: 0.6; pointer-events: none; }

.modal-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.modal-panel {
  width: 100%;
  max-height: 70vh;
  background: #1F1D1A;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}
.modal-head { flex-shrink: 0; display: flex; justify-content: space-between; font-size: 32rpx; color: #FFFFFF; margin-bottom: 24rpx; }
.modal-close { color: #6B6560; padding: 8rpx; }
.coupon-scroll {
  flex-shrink: 0;
  width: 100%;
  height: 50vh;
  max-height: 50vh;
  min-height: 200rpx;
  box-sizing: border-box;
}
.coupon-opt {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.6);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.coupon-opt.selected {
  border-color: #C4A76C;
  background: rgba(196, 167, 108, 0.10);
}
.coupon-opt.disabled {
  opacity: 0.4;
  pointer-events: none;
  border-color: rgba(38, 35, 32, 0.6);
  background: #1F1D1A;
}
.coupon-opt-press { background: rgba(196, 167, 108, 0.06); border-color: rgba(196, 167, 108, 0.35); }
.coupon-opt.selected.coupon-opt-press { background: rgba(196, 167, 108, 0.14); }
.coupon-opt-name { flex: 1; font-size: 28rpx; color: #D5D1C8; }
.coupon-opt.selected .coupon-opt-name { color: #FFFFFF; }
.c-left { display: flex; flex-direction: column; flex-shrink: 0; }
.c-val { font-size: 32rpx; color: #C4A76C; font-weight: 600; }
.c-min { font-size: 22rpx; color: #6B6560; margin-top: 4rpx; }
.c-right { flex: 1; min-width: 0; }
.c-name { font-size: 26rpx; color: #D5D1C8; }
.radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #6B6560;
  border-radius: 50%;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.radio.checked {
  border-color: #C4A76C;
}
.radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #C4A76C;
}

.custom-line {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(38, 35, 32, 0.5);
}
.custom-line:last-of-type { border-bottom: none; }
.custom-label { font-size: 24rpx; color: #6B6560; flex-shrink: 0; }
.custom-value { font-size: 24rpx; color: #D5D1C8; text-align: right; flex: 1; }
.custom-value.latin { font-style: italic; color: #C4A76C; }
.custom-value.gold { color: #C4A76C; }

/* —— 下单门闸弹层：启程前须知 / 温馨提示 共用面板（内容左齐） —— */
.specimen-mask {
  align-items: center;
  justify-content: center;
  padding: 32rpx 28rpx;
  background: rgba(26, 24, 20, 0.72);
  z-index: 220;
}
.specimen-panel {
  width: 100%;
  max-height: 78vh;
  overflow-y: auto;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 36rpx;
  box-sizing: border-box;
  text-align: left;
}
.specimen-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 0.04em;
  margin-bottom: 20rpx;
  text-align: left;
}
.notice-intro {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.55;
  margin-bottom: 28rpx;
  text-align: left;
  /* 需求 12：引导句要求「不折行」——与 checkoutCareNotice.js 的文案长度配套。
     面板可用宽度约 622rpx，当前文案 18 字 × 24rpx ≈ 432rpx，留有余量。
     ⚠️ 若日后加长文案，必须同步复核这里，否则会溢出面板。 */
  white-space: nowrap;
}
.specimen-body {
  display: block;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.65;
  margin-bottom: 20rpx;
  text-align: left;
}
.notice-line {
  display: block;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.65;
  margin-bottom: 6rpx;
  text-align: left;
  white-space: nowrap;
  overflow: visible;
}
.notice-line text {
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.65;
}
.notice-line--warm {
  white-space: normal;
  margin-bottom: 4rpx;
}
.notice-brass {
  color: #C4A76C !important;
  font-weight: 500;
}
.notice-block {
  text-align: left;
  margin-bottom: 8rpx;
}
.notice-block-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #C4A76C;
  letter-spacing: 0.1em;
  margin-bottom: 14rpx;
  text-align: left;
}
.notice-antenna {
  margin-top: 12rpx;
}
.notice-antenna + .notice-antenna {
  margin-top: 0;
}
.notice-block-rule {
  height: 1px;
  margin: 22rpx 0;
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.35) 0%,
    rgba(196, 167, 108, 0.35) 72%,
    transparent 100%
  );
}
.specimen-note {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.55;
  margin-top: 16rpx;
  margin-bottom: 28rpx;
  text-align: left;
}
.specimen-note text {
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.55;
}
/* 1% 承诺：博物柜铜牌铭牌（双线框 + 四角饰线） */
.specimen-pledge-plate {
  position: relative;
  margin-bottom: 36rpx;
  padding: 6rpx;
  background: #1A1814;
  border: 1px solid rgba(196, 167, 108, 0.42);
  border-radius: 4rpx;
  text-align: left;
}
.specimen-pledge-inner {
  padding: 28rpx 30rpx 30rpx;
  border: 1px solid rgba(196, 167, 108, 0.2);
  text-align: left;
}
.specimen-pledge-corner {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-color: rgba(196, 167, 108, 0.72);
  border-style: solid;
  z-index: 1;
  pointer-events: none;
}
.specimen-pledge-corner.tl {
  top: 4rpx;
  left: 4rpx;
  border-width: 1px 0 0 1px;
}
.specimen-pledge-corner.tr {
  top: 4rpx;
  right: 4rpx;
  border-width: 1px 1px 0 0;
}
.specimen-pledge-corner.bl {
  bottom: 4rpx;
  left: 4rpx;
  border-width: 0 0 1px 1px;
}
.specimen-pledge-corner.br {
  bottom: 4rpx;
  right: 4rpx;
  border-width: 0 1px 1px 0;
}
.specimen-pledge-label {
  display: block;
  font-size: 18rpx;
  font-weight: 500;
  color: #6B5A24;
  letter-spacing: 0.2em;
  line-height: 1.3;
  margin-bottom: 14rpx;
  text-align: left;
}
.specimen-pledge-slogan {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #C4A76C;
  letter-spacing: 0.16em;
  line-height: 1.45;
  text-align: left;
}
.specimen-pledge-rule {
  height: 1px;
  margin: 20rpx 0 18rpx;
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.38) 0%,
    rgba(196, 167, 108, 0.38) 72%,
    transparent 100%
  );
}
.specimen-pledge-line {
  display: block;
  font-size: 22rpx;
  color: #8A7530;
  line-height: 1.65;
  text-align: left;
}
.specimen-pledge-amount {
  font-weight: 600;
  color: #C4A76C;
  letter-spacing: 0.02em;
}
.specimen-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.specimen-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.specimen-btn.secondary {
  background: transparent;
  border: 1px solid rgba(196, 167, 108, 0.45);
  color: #C4A76C;
}
.specimen-btn-hover { opacity: 0.82; }
.specimen-btn.primary {
  background: #C4A76C;
  color: #1A1814;
}
.specimen-btn-primary-hover { background: #A8903C; }
.custom-estimate {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #A09A90;
}

/* —— 我的钱包：皮质卡基座见 app.wxss；此处仅结账页交互文案 —— */
.wallet-leather-card--checkout .wallet-leather-balance-row.is-pending {
  opacity: 0.42;
}
.wallet-benefit {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.5;
  min-height: 33rpx;
  margin-bottom: 20rpx;
}
.wallet-benefit.is-muted {
  color: #6B6560;
}
.wallet-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.wallet-leather-seam.wallet-toggle-row {
  margin-top: 0;
}
.wallet-toggle-copy {
  flex: 1;
  min-width: 0;
}
.wallet-toggle-label {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.wallet-toggle-hint {
  display: block;
  font-size: 22rpx;
  color: #8B6F47;
  line-height: 1.4;
}
.wallet-leather-card.is-on .wallet-toggle-hint {
  color: #C4A76C;
}
.wallet-switch {
  transform: scale(0.92);
  flex-shrink: 0;
}

/* 单一账单：金额主路径 */
.bill-card {
  border-color: rgba(77, 64, 26, 0.55);
  padding-bottom: 32rpx;
}
.bill-card .section-label {
  margin-bottom: 12rpx;
  color: #8A7530;
  letter-spacing: 0.12em;
}
.bill-card .row-item:last-of-type {
  border-bottom: none;
}
.bill-wallet .total-row {
  border-top-color: rgba(196, 167, 108, 0.32);
}
.bill-wallet .total-price {
  font-size: 44rpx;
}
.summary-foot-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6B6560;
  line-height: 1.4;
}

/* 礼券项：本单实际可省 / 不可用原因（面额与本单实减常常不等，必须分开显示） */
.coupon-opt .c-right { display: flex; flex-direction: column; align-items: flex-end; }
.c-save {
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--gold, #C4A76C);
}
.c-save.is-off {
  color: var(--color-text-muted, #8A847C);
}
