@import './wallet-leather.wxss';

page {
  background: #1A1814;
  color: #D5D1C8;
  width: 100%;
  overflow-x: hidden;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
view, text, scroll-view { box-sizing: border-box; }

.page { padding: 24rpx; width: 100%; max-width: 100%; box-sizing: border-box; overflow-x: hidden; }

.auth-resume-hint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 28rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-md);
}

.auth-resume-hint-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #D4BC85;
  line-height: 1.5;
}

.auth-resume-hint-close {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8A7530;
  letter-spacing: 0.04em;
}

.card {
  background: #1F1D1A;
  border: 1px solid #262320;
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.address-card { position: relative; padding-right: 60rpx; }
.address-card-hover { background: #262320; }
.addr-head { display: flex; gap: 24rpx; margin-bottom: 12rpx; }
.addr-name { font-size: 32rpx; font-weight: 500; color: #FFFFFF; }
.addr-phone { font-size: 28rpx; color: #A09A90; }
.addr-detail { font-size: 26rpx; color: #D5D1C8; line-height: 1.5; }
.addr-placeholder { font-size: 30rpx; color: #C4A76C; }
.addr-arrow { position: absolute; right: 32rpx; top: 50%; transform: translateY(-50%); font-size: 40rpx; color: #6B6560; }

.fulfillment-card {
  border-color: rgba(196, 167, 108, 0.28);
}
.fulfill-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.fulfill-opt {
  flex: 1;
  min-width: 0;
  padding: 24rpx 20rpx;
  border-radius: var(--radius-md);
  border: 1px solid #262320;
  background: #1A1814;
}
.fulfill-opt.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}
.fulfill-opt-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}
.fulfill-opt.active .fulfill-opt-title { color: #C4A76C; }
.fulfill-opt-sub {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.4;
}
.pickup-hint {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px solid #262320;
}
.pickup-hint-title {
  display: block;
  font-size: 28rpx;
  color: #C4A76C;
  font-family: var(--font-brand);
  margin-bottom: 8rpx;
}
.pickup-hint-addr {
  display: block;
  font-size: 24rpx;
  color: #D5D1C8;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.pickup-hint-body {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.55;
}

.brand-notes {
  margin-top: 16rpx;
  padding-top: 4rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.4);
}
.brand-note {
  padding: 18rpx 0 4rpx;
}
.brand-note + .brand-note {
  margin-top: 8rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.28);
}
.brand-note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.brand-note-label {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #C4A76C;
  letter-spacing: 0.1em;
}
.brand-note-chevron {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1;
  color: #6B6560;
  transition: transform var(--dur-fast) var(--ease-standard);
}
.brand-note.is-open .brand-note-chevron {
  transform: rotate(90deg);
  color: #C4A76C;
}
.brand-note-summary {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.5;
}
.brand-note-body {
  display: block;
  font-size: 24rpx;
  color: #D5D1C8;
  line-height: 1.65;
}

.section-label {
  color: #8A7530;
}
.gift-note-body {
  display: block;
  font-size: 28rpx;
  color: #33302C;
  line-height: 1.7;
  font-family: var(--font-brand);
}
.gift-note-voice {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8A7530;
  letter-spacing: 0.04em;
}
.gift-note-sig {
  display: block;
  margin-top: 20rpx;
  text-align: right;
  font-size: 24rpx;
  color: #8A7530;
}

.section-label {
  font-size: 22rpx;
  color: #6B6560;
  letter-spacing: 0.1em;
  margin-bottom: 24rpx;
}

.goods-item { display: flex; gap: 24rpx; padding: 16rpx 0; border-bottom: 1px solid rgba(38, 35, 32, 0.6); }
.goods-item:last-child { border-bottom: none; }
.goods-img-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: #262320;
}
.goods-img { width: 100%; height: 100%; display: block; background: #262320; }
.goods-img-ph { display: flex; align-items: center; justify-content: center; }
.goods-img-ph-icon { width: 48rpx; height: 48rpx; opacity: 0.4; }
.goods-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.goods-title { font-size: 28rpx; color: #D5D1C8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-latin { font-size: 22rpx; color: #C4A76C; font-style: italic; margin-top: 4rpx; }
.goods-sku { font-size: 22rpx; color: #A09A90; margin-top: 4rpx; display: block; }

.provisional-tip {
  font-size: 22rpx;
  color: #C4A76C;
  padding: 0 0 16rpx;
  line-height: 1.4;
  margin-top: -8rpx;
}

/* 售后约定卡（2026-10-12 产品负责人点名改版）：标题 = 一句话规则 + 类型签；条款为三行要点；
   只有扣费数字保留警示色加粗，其余强调降为细节；「联系专员」改整行轻链接，不与底栏主按钮抢视线 */
.aftercare-plate {
  background: #1F1D1A;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx 8rpx;
  margin-bottom: 20rpx;
}
.aftercare-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 22rpx;
  border-bottom: 1px solid rgba(77, 64, 26, 0.4);
}
.aftercare-title-col { flex: 1; min-width: 0; }
.aftercare-overline {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
  color: #8A7530;
}
.aftercare-title {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
}
.aftercare-chip {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #C4A76C;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: 999rpx;
  white-space: nowrap;
}
.aftercare-body { padding: 18rpx 0 6rpx; }
.aftercare-para {
  position: relative;
  display: block;
  padding-left: 26rpx;
  margin-bottom: 14rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #A09A90;
}
.aftercare-para::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 17rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.6);
}
.aftercare-para:last-child { margin-bottom: 0; }
.aftercare-em { color: #D5D1C8; }
.aftercare-strong { font-weight: 500; color: #FFFFFF; }
.aftercare-warn { color: #E9A23B; font-weight: 600; }
.aftercare-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  margin: 10rpx -32rpx 0;
  padding: 22rpx 32rpx 24rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.4);
}
.aftercare-link-hint { font-size: 24rpx; color: #A09A90; }
.aftercare-link-label { font-size: 24rpx; color: #C4A76C; font-weight: 500; }
.aftercare-link-arrow { font-size: 28rpx; line-height: 1; color: #C4A76C; }
.aftercare-link-press { background: rgba(196, 167, 108, 0.06); }
/* 订单备注：默认单行折叠，与地址/账单行节奏一致 */
.remark-card {
  padding: 22rpx 32rpx;
}
.remark-card.is-open {
  padding-bottom: 24rpx;
}
.remark-collapsed {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 48rpx;
}
.remark-collapsed-hover {
  opacity: 0.88;
}
.remark-label {
  font-size: 28rpx;
  color: #A09A90;
  flex-shrink: 0;
}
.remark-preview {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #D5D1C8;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.remark-preview.muted {
  color: #6B6560;
}
.remark-open-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.remark-done {
  font-size: 24rpx;
  color: #C4A76C;
  padding: 4rpx 0 4rpx 16rpx;
}
.remark-input {
  width: 100%;
  min-height: 64rpx;
  max-height: 160rpx;
  background: #262320;
  border: 1px solid #262320;
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.45;
  box-sizing: border-box;
}
.remark-input.is-focused {
  min-height: 96rpx;
  border-color: rgba(196, 167, 108, 0.35);
}
.goods-row { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.goods-price { font-size: 28rpx; color: #C4A76C; font-family: var(--font-mono); }
.goods-count { font-size: 24rpx; color: #A09A90; }

.row-arrow { color: #6B6560; font-size: 32rpx; }

.total-price { font-size: 40rpx; font-weight: 600; color: #C4A76C; font-family: var(--font-mono); }

.footer-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(26, 24, 20, 0.98);
  border-top: 1px solid rgba(38, 35, 32, 0.6);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.footer-price { flex: 1; min-width: 0; margin-right: 24rpx; }
.fp-row { display: flex; align-items: baseline; gap: 8rpx; }
.fp-note { display: block; margin-top: 4rpx; font-size: 22rpx; color: #C4A76C; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fp-label { font-size: 24rpx; color: #A09A90; }
.fp-value { font-size: 40rpx; font-weight: 600; color: #C4A76C; font-family: var(--font-mono); }
.submit-btn {
  background: #C4A76C;
  color: #1A1814;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 64rpx;
  border-radius: var(--radius-md);
}
.submit-btn-hover { background: #A8903C; }
.submit-btn.disabled { opacity: 0.6; pointer-events: none; }

/* 选券抽屉：形态 / 头部 / 行 / 单选全取 app.wxss 的 ui-pop-*（docs/弹层视觉规范_2026-10-13.md）；高度在 wxml 按条数给 */
.coupon-scroll { width: 100%; box-sizing: border-box; }
.ui-pop-row.is-locked { pointer-events: none; }   /* 本页不可用券点不动（改版前 .coupon-opt.disabled 同义） */

.custom-line {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(38, 35, 32, 0.5);
}
.custom-line:last-of-type { border-bottom: none; }
.custom-label { font-size: 24rpx; color: #A09A90; flex-shrink: 0; }
.custom-value { font-size: 24rpx; color: #D5D1C8; text-align: right; flex: 1; }
.custom-value.latin { font-style: italic; color: #C4A76C; }
.custom-value.gold { color: #C4A76C; font-family: var(--font-mono); }  /* VIS3 纪律 05：金额等宽 */

/* —— 下单门闸弹层：启程前须知 / 温馨提示 共用面板（内容左齐） —— */
.specimen-mask { z-index: 820; }
/* 须知牌面：形态取 ui-pop-dialog；这里只放宽宽度（引导句不折行，见 .notice-intro）与长文滚动 */
.specimen-panel {
  max-width: 654rpx;
  max-height: 78vh;
  overflow-y: auto;
  text-align: left;
}
.notice-intro {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.55;
  margin-bottom: 28rpx;
  text-align: left;
  /* 需求 12：引导句要求「不折行」——与 checkoutCareNotice.js 的文案长度配套。
     面板可用宽度约 622rpx，当前文案 18 字 × 24rpx ≈ 432rpx，留有余量。
     ⚠️ 若日后加长文案，必须同步复核这里，否则会溢出面板。 */
  white-space: nowrap;
}
.specimen-body {
  display: block;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.65;
  margin-bottom: 20rpx;
  text-align: left;
}
.notice-line {
  display: block;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.65;
  margin-bottom: 6rpx;
  text-align: left;
  white-space: nowrap;
  overflow: visible;
}
.notice-line text {
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.65;
}
.notice-line--warm {
  white-space: normal;
  margin-bottom: 4rpx;
}
.notice-brass {
  color: #C4A76C !important;
  font-weight: 500;
}
.notice-block {
  text-align: left;
  margin-bottom: 8rpx;
}
.notice-block-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #C4A76C;
  letter-spacing: 0.1em;
  margin-bottom: 14rpx;
  text-align: left;
}
.notice-antenna {
  margin-top: 12rpx;
}
.notice-antenna + .notice-antenna {
  margin-top: 0;
}
.notice-block-rule {
  height: 1px;
  margin: 22rpx 0;
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.35) 0%,
    rgba(196, 167, 108, 0.35) 72%,
    transparent 100%
  );
}
.specimen-note {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.55;
  margin-top: 16rpx;
  margin-bottom: 28rpx;
  text-align: left;
}
.specimen-note text {
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.55;
}
/* 1% 承诺：博物柜铜牌铭牌（双线框 + 四角饰线） */
.specimen-pledge-plate {
  position: relative;
  margin-bottom: 36rpx;
  padding: 6rpx;
  background: #1A1814;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: 4rpx;
  text-align: left;
}
.specimen-pledge-inner {
  padding: 28rpx 30rpx 30rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.2);
  text-align: left;
}
.specimen-pledge-corner {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-color: rgba(196, 167, 108, 0.72);
  border-style: solid;
  z-index: 1;
  pointer-events: none;
}
.specimen-pledge-corner.tl {
  top: 4rpx;
  left: 4rpx;
  border-width: 1px 0 0 1px;
}
.specimen-pledge-corner.tr {
  top: 4rpx;
  right: 4rpx;
  border-width: 1px 1px 0 0;
}
.specimen-pledge-corner.bl {
  bottom: 4rpx;
  left: 4rpx;
  border-width: 0 0 1px 1px;
}
.specimen-pledge-corner.br {
  bottom: 4rpx;
  right: 4rpx;
  border-width: 0 1px 1px 0;
}
.specimen-pledge-label {
  display: block;
  font-size: 18rpx;
  font-weight: 500;
  color: #6B5A24;
  letter-spacing: 0.2em;
  line-height: 1.3;
  margin-bottom: 14rpx;
  text-align: left;
}
.specimen-pledge-slogan {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #C4A76C;
  letter-spacing: 0.16em;
  line-height: 1.45;
  text-align: left;
}
.specimen-pledge-rule {
  height: 1px;
  margin: 20rpx 0 18rpx;
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.38) 0%,
    rgba(196, 167, 108, 0.38) 72%,
    transparent 100%
  );
}
.specimen-pledge-line {
  display: block;
  font-size: 22rpx;
  color: #8A7530;
  line-height: 1.65;
  text-align: left;
}
.specimen-pledge-amount {
  font-weight: 600;
  color: #C4A76C;
  letter-spacing: 0.02em;
}

.custom-estimate {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #A09A90;
}

/* —— 我的钱包：皮质卡基座见 app.wxss；此处仅结账页交互文案 —— */
.wallet-leather-card--checkout .wallet-leather-balance-row.is-pending {
  opacity: 0.42;
}
.wallet-benefit {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.5;
  min-height: 33rpx;
  margin-bottom: 20rpx;
}
.wallet-benefit.is-muted {
  color: #6B6560;
}
.wallet-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.wallet-leather-seam.wallet-toggle-row {
  margin-top: 0;
}
.wallet-toggle-copy {
  flex: 1;
  min-width: 0;
}
.wallet-toggle-label {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 4rpx;
}
.wallet-toggle-hint {
  display: block;
  font-size: 22rpx;
  color: #8B6F47;
  line-height: 1.4;
}
.wallet-leather-card.is-on .wallet-toggle-hint {
  color: #C4A76C;
}
.wallet-switch {
  transform: scale(0.92);
  flex-shrink: 0;
}

/* 单一账单：金额主路径 */
/* 账单两栏（2026-10-12 重排）：左名目 + 小注，右金额；行间不画线，只在应付前一道分隔 */
.bl-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx 0;
}
.bl-row.is-tap, .bl-row.is-blocked { margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; border-radius: var(--radius-md); }
.bl-row-press { background: rgba(196, 167, 108, 0.06); }
.bl-l { flex: 1; min-width: 0; }
.bl-label-line { display: flex; align-items: center; gap: 12rpx; }
.bl-label { font-size: 28rpx; line-height: 40rpx; color: #A09A90; }
.bl-note { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.45; color: #8C867D; }
.bl-note.is-nudge { color: #C4A76C; }
.bl-chip {
  padding: 0 10rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #C4A76C;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
.bl-v-wrap { flex-shrink: 0; display: flex; align-items: center; gap: 10rpx; }
.bl-v {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #D5D1C8;
  font-family: var(--font-mono);
  white-space: nowrap;
}
.bl-v.is-text { font-family: inherit; font-size: 26rpx; }
.bl-v.is-gold { color: #C4A76C; }
.bl-v.is-muted { color: #8C867D; }
.bl-strike { font-size: 24rpx; color: #6B6560; text-decoration: line-through; font-family: var(--font-mono); }
.bl-arrow { font-size: 32rpx; line-height: 40rpx; color: #A09A90; }
.bl-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 12rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.22);
}
.bl-total-label { font-size: 28rpx; color: #D5D1C8; font-weight: 500; }
.bill-card {
  border-color: rgba(77, 64, 26, 0.55);
  padding-bottom: 32rpx;
}
.bill-card .section-label {
  margin-bottom: 12rpx;
  color: #8A7530;
  letter-spacing: 0.12em;
}

.bill-wallet .total-price {
  font-size: 44rpx;
}
.summary-foot-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.4;
}


/* ═══ 礼赠模式（蓝图 礼赠凭礼笺领取 §15）：步骤轨 → 礼物摘要 → 交付方式（含跟随项）═══ */
.brand-notes.is-solo { margin-top: 0; padding-top: 0; border-top: none; }

/* 步骤轨：与送礼页同形（01 / 02 已完成可点回，03 当前） */
.gift-rail {
  display: flex;
  align-items: center;
  padding: 4rpx 8rpx 24rpx;
}
.gift-rail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.gift-rail-num {
  font-size: 20rpx;
  color: #C4A76C;
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}
.gift-rail-label { font-size: 22rpx; color: #A09A90; }
.gift-rail-item.on .gift-rail-label { color: #D5D1C8; }
.gift-rail-line {
  flex: 1;
  height: 1px;
  margin: 0 16rpx 28rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(77, 64, 26, 0.25));
}

/* 礼物摘要：藏品一行 + 礼笺两行摘录（浅纸色，点开回写笺）+ 包装一行小字 */
.gift-summary-card {
  border-color: rgba(196, 167, 108, 0.35);
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.06) 0%, #1F1D1A 56%);
}
.gift-sum-goods { display: flex; gap: 24rpx; align-items: center; }
.gift-sum-goods + .gift-sum-goods { margin-top: 16rpx; }
.gift-sum-img-wrap { flex-shrink: 0; width: 120rpx; height: 120rpx; border-radius: var(--radius-md); overflow: hidden; background: #262320; }
.gift-sum-img { width: 120rpx; height: 120rpx; }
.gift-sum-main { flex: 1; min-width: 0; }
.gift-sum-for { display: block; font-size: 22rpx; color: #C4A76C; letter-spacing: 0.06em; }
.gift-sum-title {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gift-sum-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-top: 8rpx; }
.gift-sum-sku { flex: 1; min-width: 0; font-size: 22rpx; color: #A09A90; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gift-sum-letter {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: #F2EDE4;
}
.gift-sum-letter-body {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.65;
  color: #33302C;
  font-family: var(--font-brand);
}
.gift-sum-letter-foot { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; }
.gift-sum-sig { font-size: 22rpx; color: #8A7530; }
.gift-sum-voice { font-size: 22rpx; color: #8A7530; }
.gift-sum-edit { margin-left: auto; font-size: 22rpx; color: #8A7530; }
.gift-sum-wrap { display: block; margin-top: 18rpx; font-size: 22rpx; line-height: 1.6; color: #A09A90; }

/* 交付方式：2×2 单选块（可选才描边，只有选中项点亮），下面一句说明 + 跟随项 */
.gift-delivery-card { border-color: rgba(196, 167, 108, 0.28); }
.delivery-grid { display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 16rpx; padding-top: 22rpx; }  /* 标签是行内 text、margin-bottom 不生效；留出推荐签骑边框的高度 */
.delivery-tile {
  position: relative;
  width: 48.5%;
  padding: 20rpx 20rpx 22rpx;
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
  transition: border-color var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard);
}
.delivery-tile.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}
.delivery-tile .delivery-radio { width: 26rpx; height: 26rpx; margin-top: 0; }
.delivery-tile.active .delivery-radio {
  border-color: #C4A76C;
  background: #C4A76C;
  box-shadow: inset 0 0 0 5rpx #1F1D1A;
}
/* 半宽卡里「邀请 TA 填地址」+「推荐」放不下一行：名称不折行（极窄时省略号兜底），
   推荐签移出标题行、骑在卡片上边框右侧，不再占标题宽度 */
.delivery-tile .delivery-name {
  min-width: 0;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.delivery-tile .delivery-tag {
  position: absolute;
  top: -15rpx;
  right: 16rpx;
  padding: 0 10rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  letter-spacing: 0.08em;
  border-radius: var(--radius-sm);
}
.delivery-short { display: block; margin-top: 8rpx; padding-left: 38rpx; font-size: 22rpx; line-height: 1.45; color: #A09A90; }
.delivery-tile.active .delivery-short { color: #D5D1C8; }
.delivery-hint { display: block; margin-top: 18rpx; font-size: 22rpx; line-height: 1.6; color: #A09A90; }
.delivery-opt.is-solo { margin-bottom: 0; }

/* 跟随项：地址 / 门店 / 领取核验（只出现一种），与选项之间一道细线分隔 */
.gift-follow {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1px solid rgba(77, 64, 26, 0.4);
}
.follow-label { display: block; font-size: 26rpx; font-weight: 500; color: #FFFFFF; margin-bottom: 14rpx; }
.verify-head .follow-label { margin-bottom: 0; }
.store-chips { display: flex; flex-wrap: wrap; }
.store-pick.is-error .store-chip { border-color: #E8927C; }

/* 交付方式：单选行（可选的东西才描边），只有选中项点亮 */
.delivery-opt {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
}
.delivery-opt.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.06);
}
.delivery-radio {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-top: 4rpx;
  border: 1px solid #6B6560;
  border-radius: 50%;
  box-sizing: border-box;
}
.delivery-opt.active .delivery-radio {
  border-color: #C4A76C;
  background: #C4A76C;
  box-shadow: inset 0 0 0 6rpx #1F1D1A;
}
.delivery-opt-main { flex: 1; min-width: 0; }

.delivery-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.delivery-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.delivery-tag {
  font-size: 20rpx;
  color: #1A1814;
  background: #C4A76C;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.delivery-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.5;
}

.store-chip {
  display: inline-flex; align-items: center;
  padding: 12rpx 24rpx; margin: 0 12rpx 12rpx 0;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-md); font-size: 24rpx; color: #D5D1C8;
}
.store-chip.on {
  border-color: #C4A76C; color: #C4A76C;
  background: rgba(196, 167, 108, 0.08);
}
.store-empty { display: block; font-size: 24rpx; color: #A09A90; }
.pickup-code-note {
  margin-top: 12rpx;
  padding-left: 18rpx;
  border-left: 2px solid var(--primary);
}
.pickup-code-t { display: block; font-size: 26rpx; font-weight: 500; color: var(--text-gold); }
.pickup-code-d { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; color: var(--text-sub); }

/* 收货地址（快递给 TA / 寄给我 / 犒劳自己）：一张可点的地址卡，选好后金边；缺地址时描红、错误就地 */
.ship-addr-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
}
.ship-addr-card.on {
  border-color: var(--primary);
  background: rgba(196, 167, 108, 0.06);
}
.ship-addr.is-error .ship-addr-card { border-color: #E8927C; }
.ship-addr-main { flex: 1; min-width: 0; }
.ship-addr-head { display: flex; align-items: baseline; gap: 16rpx; }
.ship-addr-name { font-size: 28rpx; font-weight: 500; color: var(--text-main); }
.ship-addr-phone { font-size: 24rpx; color: var(--text-sub); }
.ship-addr-detail { display: block; margin-top: 6rpx; font-size: 24rpx; line-height: 1.5; color: var(--text-body); }
.ship-addr-ph { flex: 1; font-size: 26rpx; color: var(--text-gold); }
.ship-addr-arrow { flex-shrink: 0; font-size: 32rpx; color: var(--text-sub); }
.ship-addr-note { display: block; margin-top: 12rpx; font-size: 22rpx; line-height: 1.5; color: var(--text-sub); }

/* 领取核验：标题行（右侧标当前方式）→ 两张单选卡（可选，才描边）→ 一句结论 → 输入 / 口令 → 折叠规则。
   说明类不加框；出错时输入框与「手机号核验」卡同时描红，错误就地写在输入框下 */
.verify-set {
  display: flex;
  flex-direction: column;
}
.verify-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.verify-mode {
  font-size: 22rpx;
  color: var(--text-gold);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
}
.verify-seg-row { display: flex; gap: 16rpx; margin-bottom: 18rpx; }
.verify-seg {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 20rpx 22rpx;
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
  transition: border-color var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard);
}
.verify-seg.on {
  border-color: var(--primary);
  background: rgba(196, 167, 108, 0.1);
}
.verify-seg.on.is-error { border-color: #E8927C; }
.verify-seg-press { background: rgba(196, 167, 108, 0.14); }
.verify-seg-radio {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  border: 1px solid #6B6560;
  border-radius: 50%;
  box-sizing: border-box;
}
.verify-seg.on .verify-seg-radio {
  border-color: var(--primary);
  background: var(--primary);
  box-shadow: inset 0 0 0 6rpx var(--bg-root);
}
.verify-seg-main { flex: 1; min-width: 0; }
.verify-seg-t { display: block; font-size: 26rpx; font-weight: 500; color: var(--text-body); }
.verify-seg.on .verify-seg-t { color: var(--text-main); }
.verify-seg-d { display: block; margin-top: 4rpx; font-size: 22rpx; line-height: 1.45; color: var(--text-sub); }
.verify-set-input {
  margin-top: 14rpx;
  height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: #2A2621;
  color: #F3ECDD;
  font-size: 30rpx;
}
.verify-set.is-error .verify-set-input { box-shadow: inset 0 0 0 1px #E8927C; }
.verify-set-ph { color: #7D7466; font-size: 26rpx; }
.verify-set-brief { font-size: 24rpx; line-height: 1.5; color: var(--text-body); }
.verify-set-hint { margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; color: #A09A90; animation: pick-in 0.2s ease-out; }
.verify-set-req { color: #E8927C; font-size: 22rpx; }
.verify-set-err {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #E8927C;
  animation: pick-in 0.2s ease-out;
}
.verify-set-err-mark {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-top: 3rpx;
  border-radius: 50%;
  background: #E8927C;
  color: var(--bg-root);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}
.verify-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
/* 折叠规则：小字 + 箭头，展开时箭头翻转 */
.why-toggle { font-size: 22rpx; color: #A09A90; padding: 4rpx 0; }
.why-toggle::after {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  margin: 0 0 4rpx 10rpx;
  border-right: 1px solid #A09A90;
  border-bottom: 1px solid #A09A90;
  transform: rotate(45deg);
  transition: transform var(--dur-fast) var(--ease-standard);
}
.why-toggle.open::after { transform: rotate(-135deg); margin-bottom: 0; }
.claim-switch { font-size: 24rpx; color: #C4A76C; text-decoration: underline; }
.self-exit { display: block; margin-top: 18rpx; }
/* 口令：可勾选的一行（描边 = 可选），勾上后整行点亮 */
.claim-opt {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
  padding: 18rpx 20rpx;
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
  transition: border-color var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard);
}
.claim-opt.on { border-color: rgba(196, 167, 108, 0.55); background: rgba(196, 167, 108, 0.06); }
.claim-check { width: 30rpx; height: 30rpx; margin-top: 4rpx; flex-shrink: 0; border: 1rpx solid #C4A76C; border-radius: var(--radius-sm); margin-right: 14rpx; box-sizing: border-box; }
.claim-opt.on .claim-check { background: #C4A76C; box-shadow: inset 0 0 0 5rpx #1F1D1A; }
.claim-opt-main { flex: 1; min-width: 0; }
.claim-opt-t { display: block; font-size: 26rpx; color: #E6DCC8; line-height: 1.5; }
.claim-opt-d { display: block; margin-top: 2rpx; font-size: 22rpx; color: var(--text-sub); line-height: 1.5; }

@keyframes pick-in {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
