/* pages/framer/index.wxss */
page {
  background-color: #1A1814;
  color: #fff;
  font-family: var(--font-body);
}

.load-error-overlay {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx 80rpx;
  text-align: center;
  gap: 16rpx;
}
.load-error-title { color: #FFFFFF; font-size: 34rpx; font-weight: 500; }
.load-error-desc { color: #A09A90; font-size: 26rpx; line-height: 1.5; margin-bottom: 24rpx; }
.load-error-actions { display: flex; flex-direction: column; gap: 20rpx; width: 100%; max-width: 480rpx; }
.load-error-btn {
  height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 16rpx; border: 1px solid #C4A76C; color: #C4A76C; font-size: 28rpx;
}
.load-error-btn.primary { background: #C4A76C; color: #1A1814; border: none; }

/* 🟢 自定义导航栏 */
.nav-bar {
  position: fixed; left: 30rpx; z-index: 100;
  /* top 由 JS 动态控制 */
}
.back-icon {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  background: rgba(26, 24, 20, 0.45);
  backdrop-filter: blur(8px);
  border: 1px solid transparent;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-icon-press {
  opacity: 0.82;
}

/* 1. 头部档案 */
.framer-header {
  position: relative;
  width: 100%;
  height: 700rpx; /* 🟢 加高头部，让图片展示更完整 */
  display: flex; justify-content: center; align-items: center;
  overflow: hidden;
}

/* 背景图 */
.bg-layer {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  opacity: 0.6; /* 降低透明度，让背景暗一点，凸显文字 */
}
.mask {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  /* 🟢 优化渐变：从透明到纯黑，无缝衔接下方内容 */
  background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.4) 60%, #1A1814 100%);
}

.content {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
  padding: 0 60rpx; text-align: center;
  margin-top: 100rpx; /* 避开顶部内容 */
}

.avatar-box { position: relative; margin-bottom: 24rpx; }
.avatar-box image {
  width: 180rpx; height: 180rpx; border-radius: 50%;
  border: 4rpx solid #C4A76C;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.6);
}
.verified-badge {
  position: absolute; bottom: 10rpx; right: 10rpx;
  width: 40rpx; height: 40rpx; background: #C4A76C; color: #1A1814;
  border-radius: 50%; font-size: 24rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  border: 2px solid #1A1814;
}

.name {
  font-size: 44rpx; font-weight: bold; color: #fff; margin-bottom: 8rpx;
  letter-spacing: 2rpx; text-shadow: 0 4rpx 10rpx rgba(0,0,0,0.5);
}

.alias {
  font-size: 26rpx;
  color: #C4A76C;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 16rpx; margin-bottom: 8rpx; }

.intro-section {
  padding: 8rpx 48rpx 40rpx;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.skill-tag {
  font-size: 22rpx;
  color: #C4A76C;
  border: 1px solid rgba(196, 167, 108, 0.35);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.style-line {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #A09A90;
  margin-bottom: 20rpx;
}

.gallery-section {
  padding: 0 30rpx 40rpx;
}

.gallery-scroll {
  white-space: nowrap;
  width: 100%;
}

.gallery-shot {
  display: inline-block;
  width: 280rpx;
  height: 280rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  border: 1px solid #262320;
  background: #1F1D1A;
  vertical-align: top;
}
.tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  font-size: 22rpx; color: #C4A76C; 
  border: 1px solid rgba(196, 167, 108, 0.4);
  padding: 6rpx 16rpx; border-radius: 30rpx;
  background: rgba(0,0,0,0.4);
  white-space: nowrap;
  box-sizing: border-box;
}

.bio {
  display: block;
  margin: 0 auto;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.6;
  text-align: center;
}

.craft-intro {
  display: block;
  margin: 20rpx auto 0;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.65;
  text-align: center;
}

/* 2. 作品集 */
.work-section {
  padding: 0 30rpx 60rpx; position: relative; top: -20rpx;
}

.section-header {
  display: flex; align-items: center; justify-content: center; margin-bottom: 50rpx;
}
.title-group { display: flex; flex-direction: column; align-items: center; margin: 0 30rpx; }
.section-header .en { font-size: 20rpx; color: #C4A76C; letter-spacing: 6rpx; margin-bottom: 6rpx; }
.section-header .cn { font-size: 32rpx; font-weight: bold; color: #fff; letter-spacing: 2rpx; }
.line { width: 60rpx; height: 1px; background: linear-gradient(to right, transparent, #333, transparent); }

/* Grid 布局 */
.product-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24rpx; }

.product-card {
  background: #1a1a1a; border-radius: 12rpx; overflow: hidden;
  border: 1px solid #2a2a2a;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.3);
}

.img-box { position: relative; width: 100%; padding-top: 100%; }
.img-box image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.status-badge {
  position: absolute; top: 12rpx; right: 12rpx;
  background: rgba(0,0,0,0.8); color: #C4A76C; font-size: 18rpx;
  padding: 4rpx 10rpx; border-radius: 4rpx;
}

.info { padding: 24rpx; }
.p-title {
  display: block; font-size: 26rpx; color: var(--color-text-body); margin-bottom: 10rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: bold;
}
.p-year { font-size: 22rpx; color: var(--color-text-secondary); display: block; }

.empty-tip { text-align: center; color: var(--color-text-secondary); font-size: 24rpx; margin-top: 100rpx; }