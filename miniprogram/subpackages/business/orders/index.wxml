<!--pages/orders/index.wxml-->
<view class="container">
  
  <!-- 顶部 Tab -->
  <view class="tab-container">
    <scroll-view scroll-x="true" class="tab-scroll" enable-flex="true" show-scrollbar="{{false}}">
      <block wx:for="{{tabs}}" wx:key="key">
        <view 
          class="tab-pill {{curTab === index ? 'active' : ''}}" 
          bindtap="switchTab" 
          data-index="{{index}}">
          <text>{{item.name}}</text>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- 列表区域 -->
  <view class="archive-cabinet">
    
    <!-- Loading -->
    <view class="loading-box" wx:if="{{loading}}">
      <view class="scanner"></view>
      <text>正在扫描档案...</text>
    </view>

    <block wx:else>
      <view class="order-list" wx:if="{{orders.length > 0}}">
        <block wx:for="{{orders}}" wx:key="_id">
          
          <!-- 🟢 绑定新的点击事件 handleOrderClick -->
          <view 
            class="order-card stagger-card" 
            bindtap="handleOrderClick" 
            data-id="{{item._id}}"
            data-item="{{item}}">
            
            <view class="card-head">
              <text class="order-no">NO.{{item.orderNo}}</text>
              
              <!-- 状态印章 -->
              <view class="status-stamp {{item.status}}">
                <view class="stamp-inner">
                  <text class="cn">{{item.statusStr}}</text>
                  <!-- 简单的英文映射，也可在 JS 处理 -->
                  <text class="en">{{item.status === 'signed' ? '已归档' : '状态'}}</text>
                </view>
              </view>
            </view>

            <view class="card-body">
              <block wx:for="{{item.products}}" wx:key="id" wx:for-item="prod" wx:if="{{index < 1}}">
                <image src="{{prod.image}}" mode="aspectFill" class="prod-img"></image>
                <view class="prod-info">
                  <text class="prod-name">{{prod.title}}</text>
                  <text class="prod-latin">{{prod.latin || 'Specimen'}}</text>
                  <view class="sku-tag">数量: {{item.count}}</view>
                </view>
              </block>
            </view>

            <view class="card-foot">
              <view class="total-box">
                <text class="lbl">合计</text>
                <text class="val">¥{{item.totalPrice}}</text>
              </view>
              
              <!-- 操作按钮 -->
              <view class="btn-group" style="display:flex; gap:20rpx;">
                 <!-- 待付款 -> 去支付 -->
                 <view class="btn-action primary" 
                      wx:if="{{item.status === 'pending_pay'}}" 
                      catchtap="handlePay" 
                      data-id="{{item._id}}">
                  去支付
                </view>

                <!-- 待收货 -> 确认签收 -->
                <view class="btn-action" 
                      wx:if="{{item.status === 'shipped'}}" 
                      catchtap="confirmReceipt" 
                      data-id="{{item._id}}">
                  确认签收
                </view>
                
                <!-- 已签收 -> 查看详情 -->
                <view class="btn-action gold" 
                      wx:if="{{item.status === 'received' || item.status === 'signed'}}" 
                      catchtap="handleOrderClick" 
                      data-item="{{item}}">
                  查看证书
                </view>
              </view>
            </view>

          </view>
        </block>
        
        <view class="end-mark">
          <text>档案检索完毕</text>
          <text class="sub">档案检索完毕</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <view class="safe-box-icon">
           <view class="lock"></view><view class="led"></view>
        </view>
        <text class="empty-title">暂无相关记录</text>
        <text class="empty-desc">暂无相关记录</text>
      </view>
    </block>

  </view>
</view>