<!--pages/orders/index.wxml-->
<view class="container">
  
  <!-- 顶部 Tab -->
  <view class="tab-container">
    <scroll-view scroll-x="true" class="tab-scroll" enable-flex="true" show-scrollbar="{{false}}">
      <block wx:for="{{tabs}}" wx:key="key">
        <view 
          class="tab-pill {{curTab === index ? 'active' : ''}}" 
          bindtap="switchTab" 
          data-index="{{index}}"
          hover-class="tap-press"
          hover-stay-time="80">
          <text>{{item.name}}</text>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- 列表区域 -->
  <view class="archive-cabinet">
    
    <!-- Loading -->
    <view class="loading-box" wx:if="{{loading}}">
      <view class="scanner"></view>
      <text>正在扫描档案…</text>
    </view>

    <block wx:else>
      <view class="order-list" wx:if="{{orders.length > 0}}">
        <block wx:for="{{orders}}" wx:key="_id">
          
          <!-- 🟢 绑定新的点击事件 handleOrderClick -->
          <view 
            class="order-card stagger-card" 
            bindtap="handleOrderClick" 
            data-id="{{item._id}}"
            data-item="{{item}}"
            hover-class="order-card-press"
            hover-stay-time="80">
            
            <view class="card-head">
              <text class="order-no">NO.{{item.orderNo}}</text>
              
              <!-- 状态印章 -->
              <view class="status-stamp {{item.status}}">
                <view class="stamp-inner">
                  <text class="cn">{{item.statusStr}}</text>
                  <!-- 简单的英文映射，也可在 JS 处理 -->
                  <text class="en">{{item.statusEn}}</text>
                </view>
              </view>
            </view>

            <view class="card-body">
              <block wx:for="{{item.products}}" wx:key="id" wx:for-item="prod" wx:if="{{index < 1}}">
                <view class="prod-img-wrap">
                  <image wx:if="{{prod.image}}" src="{{prod.image}}" mode="aspectFill" class="prod-img" lazy-load></image>
                  <view wx:else class="prod-img prod-img-ph">
                    <image class="prod-img-ph-icon" src="/assets/icons/box.png" mode="aspectFit"></image>
                  </view>
                  <view class="prod-more" wx:if="{{item.products.length > 1}}">共 {{item.products.length}} 件</view>
                </view>
                <view class="prod-info">
                  <text class="prod-name">{{prod.title}}</text>
                  <text class="prod-latin" wx:if="{{prod.latin && !item.isVoucherOrder}}">{{prod.latin}}</text>
                  <view class="sku-tag">× {{prod.count || item.count || 1}}</view>
                  <view class="sku-tag gift" wx:if="{{item.giftTag}}">{{item.giftTag}}</view>
                  <view class="sku-tag gift" wx:elif="{{item.depositTag}}">{{item.depositTag}}</view>
                </view>
              </block>
            </view>

            <view class="card-foot">
              <view class="total-box">
                <text class="lbl">{{item.showOrderPrice === false ? '礼赠' : '合计'}}</text>
                <text class="val" wx:if="{{item.showOrderPrice !== false}}">¥{{item.totalPrice}}</text>
                <text class="val muted" wx:else>心意已备妥</text>
              </view>
              
              <!-- 操作按钮 -->
              <view class="btn-group" style="display:flex; gap:20rpx;">
                 <!-- 待付款 -> 去支付（仅买家） -->
                 <view class="btn-action primary {{payingId === item._id ? 'is-busy' : ''}}" hover-class="btn-action-press" 
                      wx:if="{{item.status === 'pending_pay' && !item.isGiftReceiver}}" 
                      catchtap="handlePay" 
                      data-id="{{item._id}}">
                  {{payingId === item._id ? '支付中…' : (item.payBtnLabel || '立即支付')}}
                </view>

                <!-- 送礼人：待填址 -> 分享礼笺 -->
                <view class="btn-action gold" hover-class="btn-action-press"
                      wx:if="{{item.giftNeedsAddress && !item.isGiftReceiver}}"
                      catchtap="handleOrderClick"
                      data-id="{{item._id}}"
                      data-item="{{item}}">
                  去分享礼笺
                </view>

                <!-- 受礼人：待填址 -> 填写地址 -->
                <view class="btn-action primary" hover-class="btn-action-press"
                      wx:if="{{item.giftNeedsAddress && item.isGiftReceiver}}"
                      catchtap="goFillGiftAddress"
                      data-id="{{item._id}}">
                  去填写地址
                </view>

                <!-- 待收货 -> 确认签收 -->
                <view class="btn-action" hover-class="btn-action-press" 
                      wx:if="{{item.status === 'shipped'}}" 
                      catchtap="confirmReceipt" 
                      data-id="{{item._id}}">
                  确认签收
                </view>
                
                <!-- 已签收 -> 评价 / 详情 -->
                <view class="btn-action" hover-class="btn-action-press"
                      wx:if="{{(item.status === 'received' || item.status === 'signed') && !item.isVoucherOrder}}"
                      catchtap="goToReview"
                      data-id="{{item._id}}"
                      data-item="{{item}}">
                  写下感受
                </view>
                <view class="btn-action gold" hover-class="btn-action-press" 
                      wx:if="{{item.status === 'received' || item.status === 'signed'}}" 
                      catchtap="handleOrderClick" 
                      data-id="{{item._id}}">
                  查看详情
                </view>
              </view>
            </view>

          </view>
        </block>
        
        <!-- 买家侧还有更多：给出可点的加载入口（触底也会自动加载） -->
        <view class="end-mark load-more" wx:if="{{curTab === 0 && ownedHasMore}}" bindtap="loadMoreOwned" hover-class="tap-press" hover-stay-time="80">
          <text>{{loadingMore ? '加载中…' : '点击加载更早的订单'}}</text>
        </view>
        <view class="end-mark" wx:else>
          <text>档案检索完毕</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <view class="safe-box-icon">
           <view class="lock"></view><view class="led"></view>
        </view>
        <text class="empty-title">{{loadError ? '档案读取失败' : tabs[curTab].emptyTitle}}</text>
        <text class="empty-desc">{{loadError ? '请检查网络后重试' : tabs[curTab].emptyDesc}}</text>
        <view class="empty-cta" wx:if="{{loadError}}" bindtap="loadOrders" hover-class="empty-cta-press">重新加载</view>
        <navigator class="empty-cta" wx:else url="/pages/index/index" open-type="switchTab" hover-class="empty-cta-press">去逛逛</navigator>
      </view>
    </block>

  </view>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal）；详见 utils/appModal.js -->
<app-modal id="appModal" />