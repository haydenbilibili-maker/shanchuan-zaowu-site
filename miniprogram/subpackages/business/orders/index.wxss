/* pages/orders/index.wxss */
page { 
  background-color: #1A1814; 
  color: #fff; 
  font-family: "PingFang SC", sans-serif; 
  height: 100%; 
  width: 100%;
  overflow-x: hidden;
  overflow-y: auto;
}
view, text, image, scroll-view { box-sizing: border-box; }

.container { width: 100%; max-width: 100%; min-height: 100%; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); overflow-x: hidden; box-sizing: border-box; }

/* === 1. 横向滚动 Tab (解决拥挤) === */
.tab-container {
  position: sticky; top: 0; z-index: 50;
  background: rgba(26, 24, 20, 0.96); backdrop-filter: blur(10px);
  border-bottom: 1px solid #262320;
  padding: 20rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.tab-scroll {
  white-space: nowrap; width: 100%; padding: 0 30rpx; display: flex;
  box-sizing: border-box;
}

.tab-pill {
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  padding: 10rpx 30rpx; margin-right: 20rpx;
  background: #1F1D1A; border: 1px solid #262320; border-radius: 40rpx;
  color: #A09A90; font-size: 24rpx; transition: all 0.2s;
}

.tab-pill.active {
  background: #C4A76C; color: #1A1814; border-color: #C4A76C; font-weight: bold;
  box-shadow: none;
}
.tab-pill-press { opacity: 0.82; }

/* === 2. 列表区域 === */
.archive-cabinet { padding: 30rpx; width: 100%; }

/* Loading */
.loading-box { text-align: center; padding-top: 100rpx; opacity: 0.7; }
.scanner { 
  width: 100%; height: 2rpx; background: linear-gradient(to right, transparent, #C4A76C, transparent);
  margin-bottom: 20rpx; animation: scan 1.5s infinite;
}
@keyframes scan { 0% { opacity: 0; width: 0; } 50% { opacity: 1; width: 100%; } 100% { opacity: 0; width: 0; } }
.loading-box text { font-size: 22rpx; letter-spacing: 2rpx; color: #C4A76C; }


/* 卡片 */
.order-card {
  background: #1F1D1A; border: 1px solid #262320; border-radius: 16rpx;
  padding: 30rpx; margin-bottom: 24rpx;
  position: relative; overflow: hidden;
  opacity: 0; animation: slideUp 0.28s ease-out forwards;
  transition: transform 0.22s ease, border-color 0.22s ease;
}
.order-card:last-child { margin-bottom: 0; }
.order-card-press { transform: scale(0.985); border-color: rgba(196, 167, 108, 0.4); }
@keyframes slideUp { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }

/* 头部 */
.card-head { 
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 24rpx; border-bottom: 1px dashed rgba(38, 35, 32, 0.7); padding-bottom: 20rpx;
  min-height: 60rpx;
}
.order-no { font-family: 'DIN'; font-size: 24rpx; color: #A09A90; letter-spacing: 1rpx; margin-top: 8rpx; }

/* 🟢 双语印章 */
.status-stamp {
  padding: 4rpx 8rpx; 
  border: 4rpx double; /* 双线边框，模拟印章 */
  border-radius: 8rpx;
  transform: rotate(-10deg); opacity: 0.9;
}
.stamp-inner {
  display: flex; flex-direction: column; align-items: center; line-height: 1;
}
.stamp-inner .cn { font-size: 20rpx; font-weight: 900; letter-spacing: 2rpx; margin-bottom: 2rpx; }
.stamp-inner .en { font-size: var(--fs-16); font-weight: bold; transform: scale(0.8); font-family: 'DIN'; }

/* 状态颜色 */
.status-stamp.paid { color: #C4A76C; border-color: #C4A76C; }
.status-stamp.paid_awaiting_address { color: #E9A23B; border-color: #E9A23B; }
.status-stamp.shipped { color: #52B788; border-color: #52B788; }
.status-stamp.received { color: #666; border-color: #666; }
.status-stamp.refunding,
.status-stamp.aftersales,
.status-stamp.expired_refunding { color: #D64045; border-color: #D64045; }
.status-stamp.refunded { color: #A09A90; border-color: #6B6560; }
.status-stamp.pending_pay { color: #E9A23B; border-color: #E9A23B; }

/* 内容 */
.card-body { display: flex; margin-bottom: 24rpx; }
.prod-img { width: 140rpx; height: 140rpx; background: #1A1814; border-radius: 12rpx; border: 1px solid #262320; margin-right: 24rpx; flex-shrink: 0; }
/* 2026-09-21 分子级审计：`flex:1` 子项默认 min-width:auto（= min-content），拉丁学名这类长 token
   会把整行顶宽、被 .order-card 的 overflow:hidden 直接裁掉且无省略号；标题也没有任何钳制。
   与同仓 feature/search 的 .ac-info/.ac-title 同型写法对齐：min-width:0 + 单行省略号。 */
.prod-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.prod-name { font-size: 28rpx; font-weight: bold; color: #D5D1C8; margin-bottom: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.prod-latin { font-family: 'Times New Roman'; font-style: italic; font-size: 22rpx; color: #C4A76C; margin-bottom: 12rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sku-tag { font-size: 20rpx; color: #A09A90; border: 1px solid #262320; align-self: flex-start; padding: 2rpx 8rpx; border-radius: 4rpx; }
.sku-tag.gift { color: #C4A76C; border-color: rgba(196, 167, 108, 0.45); margin-top: 8rpx; }

/* 底部 */
.card-foot { display: flex; justify-content: space-between; align-items: center; }
.total-box { display: flex; align-items: baseline; }
.lbl { font-size: 20rpx; color: #888; margin-right: 8rpx; }
.val { font-family: 'DIN'; font-size: 36rpx; color: #C4A76C; font-weight: bold; }

.btn-action {
  background: #262320; color: #D5D1C8; font-size: 22rpx; font-weight: 600;
  padding: 10rpx 30rpx; border-radius: 16rpx; border: 1px solid #4D401A;
  letter-spacing: 1rpx; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}
.btn-action.primary {
  background: #C4A76C;
  color: #1A1814;
  border-color: #C4A76C;
}
.btn-action.gold {
  background: transparent;
  color: #C4A76C;
  border-color: rgba(196, 167, 108, 0.55);
}
.btn-action:active { background: #C4A76C; color: #1A1814; border-color: #C4A76C; }
.btn-action.primary:active { background: #A8903C; border-color: #A8903C; }
.total-box .val.muted { color: #A09A90; font-size: 24rpx; font-weight: 400; letter-spacing: 0.04em; }

.end-mark { text-align: center; margin-top: 40rpx; display: flex; flex-direction: column; align-items: center; }
.end-mark text { font-size: 20rpx; color: #6B6560; letter-spacing: 2rpx; }

/* 空状态 */
.empty-state { text-align: center; padding-top: 120rpx; color: #A09A90; }
.safe-box-icon { 
  width: 100rpx; height: 100rpx; border: 1px solid #4D401A; border-radius: 12rpx; margin: 0 auto 30rpx; 
  display: flex; align-items: center; justify-content: center;
}
.lock { width: 20rpx; height: 30rpx; background: #4D401A; border-radius: 4rpx; }
.empty-title { font-size: 28rpx; letter-spacing: 2rpx; margin-bottom: 8rpx; display: block; color: #D5D1C8; }
.empty-desc { font-size: 20rpx; color: #6B6560; display: block; margin-bottom: 32rpx; }
.empty-cta {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #C4A76C;
  color: #1A1814;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 16rpx;
  letter-spacing: 0.06em;
}
.empty-cta-press { background: #A8903C; }
/* 分页加载入口 */
.load-more { color: var(--brass-400); }
.load-more:active { opacity: .7; }
