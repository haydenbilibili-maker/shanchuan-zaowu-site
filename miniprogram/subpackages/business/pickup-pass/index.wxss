/* 门店自取凭证（独立页）—— 继承 app.wxss 主题变量 */

page {
  background-color: var(--color-bg);
  color: var(--color-text-body);
  font-family: "PingFang SC", sans-serif;
}

view, text, canvas { box-sizing: border-box; }

.pass-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 头部 ---------- */
.pass-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0 4rpx;
}
.pass-eyebrow {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.26em;
  color: var(--color-text-muted);
}
.pass-title {
  font-family: var(--font-brand);
  font-size: 40rpx;
  letter-spacing: 0.04em;
  color: #F2EFE8;
}
.pass-chip {
  margin-top: 6rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
  font-size: 24rpx;
  letter-spacing: 0.1em;
  transform: rotate(-3deg);
}
.pass-chip-wait {
  color: var(--color-warning);
  border-color: rgba(233, 162, 59, 0.5);
  background: rgba(233, 162, 59, 0.12);
}
.pass-chip-ready {
  color: var(--gold);
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.14);
}
.pass-chip-done {
  color: var(--color-success);
  border-color: rgba(82, 183, 136, 0.5);
  background: rgba(82, 183, 136, 0.12);
}
.pass-headline {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.pass-orderno {
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

/* ---------- 凭证主体 ---------- */
.pass-card {
  position: relative;
  padding: 34rpx 32rpx 30rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  background:
    radial-gradient(130% 70% at 50% 0%, rgba(196, 167, 108, 0.16) 0%, rgba(196, 167, 108, 0) 62%),
    linear-gradient(180deg, #24211C 0%, var(--color-bg-card) 100%);
  box-shadow: 0 14rpx 36rpx rgba(0, 0, 0, 0.38);
  overflow: hidden;
}

.pass-qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* 白底 + 内边距 = 二维码静区，柜台扫一次成功 */
.pass-qr-frame {
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--brass-50);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.38);
}
.pass-qr {
  display: block;
  width: 460rpx;
  height: 460rpx;
  background: var(--brass-50);
}
.pass-qr-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: var(--color-text-muted);
}

/* 撕票线 */
.pass-perf {
  display: flex;
  align-items: center;
  margin: 30rpx -32rpx 26rpx;
}
.pass-notch {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-bg);
}
.pass-notch-l { margin-left: -14rpx; }
.pass-notch-r { margin-right: -14rpx; }
.pass-dash {
  flex: 1;
  height: 0;
  border-top: 1rpx dashed rgba(196, 167, 108, 0.35);
}

.pass-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-md);
  border: 1rpx dashed rgba(196, 167, 108, 0.3);
  background: rgba(26, 24, 20, 0.6);
}
.pass-code-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.pass-code-label {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: var(--color-text-muted);
}
.pass-code-value {
  font-family: var(--font-mono);
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: var(--gold);
}
.pass-copy {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  font-size: 22rpx;
  color: var(--gold);
}

/* 三段进度 */
.pass-steps {
  display: flex;
  margin-top: 30rpx;
}
.pass-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pass-step-track {
  position: relative;
  width: 100%;
  height: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pass-dot {
  position: relative;
  z-index: 2;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.25);
}
.pass-dot-done { background: var(--color-success); }
.pass-dot-current {
  background: var(--gold);
  animation: passPulse 1.8s ease-in-out infinite;
}
.pass-line {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  width: 100%;
  height: 1rpx;
  background: rgba(196, 167, 108, 0.25);
}
.pass-step-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
.pass-step-label-done { color: var(--color-text-body); }
.pass-step-label-current { color: var(--gold); }
@keyframes passPulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(196, 167, 108, 0.14); }
  50% { box-shadow: 0 0 0 12rpx rgba(196, 167, 108, 0.24); }
}

/* ---------- 领取门店 ---------- */
.pass-store {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
}
.pass-store-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.pass-store-label {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--color-text-muted);
}
.pass-nav {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  font-size: 22rpx;
  color: var(--gold);
}
.pass-store-name {
  font-size: 32rpx;
  color: var(--color-text-body);
}
.pass-store-line {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
}

/* ---------- 提示 / 已完成 / 错误 ---------- */
.pass-hint {
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-secondary);
}
.pass-guard {
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--color-warning);
}
.pass-refresh {
  margin-top: -8rpx;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
  color: var(--color-text-muted);
}
/* 已交付：凭证收起为核销回执，避免二次扫码 */
.pass-sealed {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0 26rpx;
}
.pass-sealed-tick {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(82, 183, 136, 0.45);
  background: rgba(82, 183, 136, 0.14);
  color: var(--color-success);
  font-size: 56rpx;
}
.pass-sealed-title {
  font-family: var(--font-brand);
  font-size: 34rpx;
  letter-spacing: 0.04em;
  color: var(--color-text-body);
}
.pass-sealed-sub {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
.pass-error {
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(214, 64, 69, 0.4);
  background: rgba(214, 64, 69, 0.08);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-error);
  text-align: center;
}

/* ---------- 底部操作 ---------- */
.pass-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.pass-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: 28rpx;
}
.pass-btn.ghost {
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  color: var(--gold);
}
.pass-btn.primary {
  background: var(--gold);
  color: #1A1814;
  font-weight: 500;
}
.pass-support {
  align-self: center;
  padding: 16rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}
.pass-press { opacity: 0.72; }

/* 凭证失效态的操作区 */
.pass-closed-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  justify-content: center;
}
