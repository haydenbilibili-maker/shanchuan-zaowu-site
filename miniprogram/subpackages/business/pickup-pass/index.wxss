/* 门店自取凭证（2026-10-17 重构，与入馆券同一家族）
   博物馆黑票面 + 黄铜发丝框；二维码浅纸图版；状态章改方角发丝章（铜 / 暖白 / 灰，不用信号橙绿）；
   「已自提」为墨色印章；门店为发丝线信息块；本屏唯一实心金 = 订单详情。数据、轮询、核销联动不变。 */
page {
  background-color: #1A1814;
  color: var(--color-text-body);
  font-family: var(--font-body);
}

view, text, canvas { box-sizing: border-box; }

.pass-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 头部：眉标 + 宋体主标 + 状态章 ---------- */
.pass-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0 4rpx;
}

.pass-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.pass-title {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.pass-chip {
  margin-top: 8rpx;
  padding: 6rpx 22rpx;
  border-radius: 2rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.16em;
}

.pass-chip-wait {
  color: #E8DFCB;
  box-shadow: inset 0 0 0 1rpx rgba(232, 223, 203, 0.4);
}

.pass-chip-ready {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.1);
  box-shadow: var(--ring-brass);
}

.pass-chip-done {
  color: var(--color-text-secondary, #A09A90);
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.4);
}

.pass-chip-closed {
  color: var(--color-text-secondary, #A09A90);
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.3);
}

.pass-headline {
  margin-top: 4rpx;
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
}

.pass-orderno {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: rgba(160, 154, 144, 0.85);
}

/* ---------- 凭证主体：博物馆黑票面 ---------- */
.pass-card {
  position: relative;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.32);
  background: linear-gradient(180deg, #24211C, #1F1D1A);
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
}

.pass-card::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.14);
  pointer-events: none;
}

.pass-qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 浅纸图版 + 内边距 = 二维码静区，柜台扫一次成功 */
.pass-qr-frame {
  position: relative;
  padding: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: inset 0 0 0 1rpx rgba(46, 38, 24, 0.22), 0 10rpx 24rpx rgba(0, 0, 0, 0.36);
}

.pass-qr {
  display: block;
  width: 460rpx;
  height: 460rpx;
  background: #FAF6ED;
}

.pass-qr-hint {
  margin-top: 18rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: var(--brass-200);
}

/* 已交付：二维码留在票面上但码面变灰 + 盖「已自提」墨色印章，既联动告知也阻止二次出示 */
.pass-qr-used .pass-qr {
  opacity: 0.2;
}

.pass-qr-used .pass-qr-hint { color: var(--color-text-secondary, #A09A90); }

.pass-qr-stamp {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) rotate(-14deg);
  padding: 12rpx 34rpx;
  border: 4rpx solid rgba(90, 78, 58, 0.85);
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 4rpx rgba(243, 236, 221, 0.9), inset 0 0 0 6rpx rgba(90, 78, 58, 0.5);
  background: rgba(243, 236, 221, 0.78);
  color: #3D3424;
  font-family: var(--font-brand);
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  white-space: nowrap;
  pointer-events: none;
  z-index: 2;
}

/* 撕票线 */
.pass-perf {
  display: flex;
  align-items: center;
  margin: 32rpx -36rpx 24rpx;
}

.pass-notch {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #1A1814;
}

.pass-notch-l { margin-left: -16rpx; }
.pass-notch-r { margin-right: -16rpx; }

.pass-dash {
  flex: 1;
  height: 0;
  border-top: 2rpx dashed rgba(196, 167, 108, 0.24);
}

/* 自取码：发丝线一行（眉标 / 等宽大字 / 复制） */
.pass-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 4rpx;
}

.pass-code-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.pass-code-label {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.pass-code-value {
  font-family: var(--font-mono);
  font-size: var(--fs-48);
  font-weight: 600;
  letter-spacing: 0.16em;
  color: var(--brass-200);
}

.pass-copy {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.45);
  font-size: var(--fs-22);
  letter-spacing: 0.08em;
  color: var(--brass-300);
}

/* 三段进度：铜点（已过 = 实点，当前 = 呼吸环，未到 = 空点） */
.pass-steps {
  display: flex;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.pass-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pass-step-track {
  position: relative;
  width: 100%;
  height: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pass-dot {
  position: relative;
  z-index: 2;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1F1D1A;
  box-shadow: inset 0 0 0 2rpx rgba(196, 167, 108, 0.35);
}

.pass-dot-done { background: #8B6F47; box-shadow: none; }

.pass-dot-current {
  background: var(--brass-300);
  box-shadow: none;
  animation: passPulse 1.8s ease-in-out infinite;
}

.pass-line {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  width: 100%;
  height: 1rpx;
  background: rgba(196, 167, 108, 0.25);
}

.pass-step-label {
  margin-top: 14rpx;
  font-size: var(--fs-22);
  color: rgba(160, 154, 144, 0.85);
}

.pass-step-label-done { color: var(--color-text-body); }
.pass-step-label-current { color: var(--brass-200); }

@keyframes passPulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(196, 167, 108, 0.14); }
  50% { box-shadow: 0 0 0 12rpx rgba(196, 167, 108, 0.24); }
}

/* ---------- 领取门店：发丝线信息块 ---------- */
.pass-store {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 4rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.pass-store-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pass-store-label {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.pass-nav {
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: var(--brass-300);
}

.pass-store-name {
  margin-top: 4rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
}

.pass-store-line {
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary, #A09A90);
}

/* ---------- 提示 / 已完成 / 错误 ---------- */
.pass-hint {
  font-size: var(--fs-22);
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-secondary);
}

/* 防转发提醒：铜色（原警示橙） */
.pass-guard {
  font-size: var(--fs-22);
  line-height: 1.6;
  text-align: center;
  color: var(--brass-300);
}

.pass-refresh {
  margin-top: -8rpx;
  font-size: var(--fs-20);
  line-height: 1.5;
  text-align: center;
  color: rgba(160, 154, 144, 0.85);
}

/* 已交付 / 失效：凭证收成回执，避免二次扫码 */
.pass-sealed {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0 30rpx;
}

.pass-sealed-tick {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(212, 188, 133, 0.7), inset 0 0 0 8rpx #1F1D1A, inset 0 0 0 9rpx rgba(212, 188, 133, 0.4);
  font-family: var(--font-brand);
  font-size: 48rpx;
  color: var(--brass-300);
}

.pass-sealed-title {
  font-family: var(--font-brand);
  font-size: var(--fs-34);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
}

.pass-sealed-sub {
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  text-align: center;
}

.pass-error {
  padding: 20rpx 24rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(214, 64, 69, 0.4);
  background: rgba(214, 64, 69, 0.08);
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-error-on-tint);
  text-align: center;
}

/* ---------- 底部操作：本屏唯一实心金 = 订单详情 ---------- */
.pass-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.pass-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  font-size: var(--fs-28);
  letter-spacing: 0.12em;
}

.pass-btn.ghost {
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.4);
  color: var(--color-text-body, #D5D1C8);
}

.pass-btn.primary {
  background: var(--brass-400);
  color: #1A1814;
  font-weight: 600;
}

.pass-support {
  align-self: center;
  padding: 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--fs-24);
}

/* 凭证失效态的操作区 */
.pass-closed-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  justify-content: center;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .pass-dot-current {
    animation: none;
  }
}

/* 仪式感：柜台当场核销（2026-10-18 产品负责人点名「做强下单主流程仪式感」）
   顾客正举着凭证时状态翻成已交付：二维码 0.6s 褪灰，「已自提」印从放大落下（0.46s）——与馆印同一套落印动作。
   只在本页亲眼看着核销时播（announceClaimed）；历史已核销进页直接静态。 */
.pass-qr { transition: opacity 0.6s ease-out; }
.pass-qr-frame.is-live .pass-qr-stamp { animation: pass-stamp-land 0.46s cubic-bezier(0.2, 0.9, 0.3, 1.2) 0.2s both; }
@keyframes pass-stamp-land {
  0% { opacity: 0; transform: translate(-50%, -50%) rotate(-14deg) scale(1.9); }
  60% { opacity: 1; transform: translate(-50%, -50%) rotate(-14deg) scale(0.94); }
  100% { opacity: 1; transform: translate(-50%, -50%) rotate(-14deg) scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .pass-qr { transition: none; }
  .pass-qr-frame.is-live .pass-qr-stamp { animation: none; }
}
