page {
  background: #1A1814;
  color: #FFFFFF;
}

.page-track {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.card {
  width: 100%;
  padding: 40rpx 32rpx;
  background: #1F1D1A;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.title {
  display: block;
  font-size: var(--fs-32);
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.sub {
  display: block;
  font-size: var(--fs-24);
  color: #A09A90;
  line-height: 1.55;
  margin-bottom: 16rpx;
}

.waybill {
  display: block;
  font-size: var(--fs-26);
  color: var(--color-primary);
  font-family: var(--font-mono);
  margin-bottom: 28rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 12rpx;
}

.btn-primary,
.btn-secondary {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  font-weight: 500;
}

.btn-primary {
  background: var(--color-primary);
  color: #1A1814;
}

.btn-secondary {
  background: transparent;
  color: var(--color-primary);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}
