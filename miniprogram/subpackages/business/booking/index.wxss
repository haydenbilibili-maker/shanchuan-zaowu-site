/* 预约 · 入馆券（2026-10-17 重构）
   页头沿用原双面翻转典藏票（只做配色 / 字体适配，不推翻）；下划线页签；眉标 + 宋体分区头；发丝线表单与金线环选中；
   「我的预约」浅纸票根；本屏唯一实心金 = 底栏提交钮。数据、提交、门禁、生成入馆券流程不变。 */
@keyframes holo-scan { 0% { transform: translateX(-100%); } 100% { transform: translateX(340%); } }
@keyframes scan-y { 0% { top: 0; opacity: 0; } 50% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
@keyframes bk-pulse { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
@keyframes bk-progress { from { transform: translateX(-100%); } to { transform: translateX(0); } }
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #1A1814;
  position: relative;
}

/* —— 页头：典藏票据（双面翻转票，原设计保留；2026-10-17 只做整体视觉适配）——
   A 面：#1F1D1A 博物馆黑 + 黄铜发丝框 / 黄铜数字；B 面：浅纸渐变 + 墨色；
   去掉 emoji 水印与光晕，品牌 / 持券人改宋体；尺寸、翻面动效、齿孔缺口、防伪线、VALID 章均沿用原版。 */
.ticket-header {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  width: 100%;
  padding: 24rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.ticket-3d-container {
  position: relative;
  width: 100%;
  height: 432rpx; /* 原 380rpx 装不下页脚（防伪线 + VALID 章被裁），加高让整张票完整 */
  transform-style: preserve-3d;
  transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.ticket-3d-container.flipped { transform: rotateY(180deg); }

.ticket-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  overflow: hidden;
  backface-visibility: hidden;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.5);
}

/* A 面：博物馆黑 + 黄铜 */
.face-front {
  background: linear-gradient(180deg, #24211C, #1F1D1A);
  border: 1rpx solid rgba(196, 167, 108, 0.32);
  transform: rotateY(0deg);
  z-index: 2;
}

/* B 面：浅纸 + 墨色 */
.face-back {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  transform: rotateY(180deg);
  color: #2E2618;
}

.paper-texture {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0.04;
  pointer-events: none;
  background-image:
    repeating-linear-gradient(0deg, #C4A76C 0, #C4A76C 1rpx, transparent 0, transparent 6rpx),
    repeating-linear-gradient(90deg, #C4A76C 0, #C4A76C 1rpx, transparent 0, transparent 6rpx);
}
.gold-strip { position: absolute; top: 0; left: 30rpx; bottom: 0; width: 2rpx; background: linear-gradient(to bottom, transparent, var(--brass-400), transparent); z-index: 5; opacity: 0.5; }
.silver-strip { position: absolute; top: 0; left: 30rpx; bottom: 0; width: 2rpx; background: linear-gradient(to bottom, transparent, #B08D57, transparent); z-index: 5; opacity: 0.6; }

/* 水印：宋体「山海」刻字（原 🦋 emoji） */
.watermark {
  position: absolute;
  right: 12rpx;
  bottom: 44rpx;
  font-family: var(--font-brand);
  font-size: 150rpx;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1;
  color: #C4A76C;
  opacity: 0.06;
  transform: rotate(-8deg);
  pointer-events: none;
  z-index: 1;
}
.watermark.light { color: #2E2618; opacity: 0.05; }

/* 齿孔缺口：挖成页面底色 */
.notch { position: absolute; top: 160rpx; width: 32rpx; height: 32rpx; background: #1A1814; border-radius: 50%; z-index: 5; }
.notch.left { left: -16rpx; }
.notch.right { right: -16rpx; }

.tp-header {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 30rpx 40rpx 20rpx;
  border-bottom: 1rpx dashed rgba(196, 167, 108, 0.22);
}
.tp-header.light { border-bottom-color: rgba(46, 38, 24, 0.24); }

.tp-brand { flex: 1; display: flex; flex-direction: column; margin-right: 20rpx; }

.tp-logo {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  letter-spacing: 0.12em;
  line-height: 1.3;
  color: var(--brass-200);
}
.tp-logo.light { color: #2E2618; }

.tp-tagline { margin-top: 6rpx; font-size: var(--fs-20); letter-spacing: 0.15em; line-height: 1.3; color: rgba(232, 223, 203, 0.72); }
.tp-tagline.light { color: #5A4E3A; }

.tp-sub { margin-top: 8rpx; font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: 0.24em; line-height: 1.4; color: var(--brass-300); }
.tp-sub.light { color: #8B6F47; }

.tp-serial {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  border-radius: 2rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--brass-300);
}
.tp-serial.light { color: #8B6F47; border-color: rgba(46, 38, 24, 0.28); }

/* 票面字段都挂在 .tp-body 下：.val / .label 与下方「我的预约」票根同名，不加作用域会被后者覆盖 */
.tp-body { position: relative; z-index: 2; padding: 20rpx 40rpx; }
.info-row { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 14rpx; }
.info-row.sub { margin-bottom: 0; }
.info-item { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.info-item.center { align-items: center; text-align: center; }
.info-item.right { align-items: flex-end; text-align: right; }

.tp-body .label { margin-bottom: 8rpx; font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: 0.16em; color: var(--brass-300); }
.tp-body .label.light { color: #8A7F6C; }

.tp-body .val { font-family: var(--font-mono); font-size: var(--fs-36); font-weight: 600; line-height: 1; color: #F3ECDD; }
.tp-body .val.light { color: #2E2618; }

.tp-body .val.highlight { font-size: var(--fs-48); line-height: 0.8; color: var(--brass-200); }
.tp-body .val.highlight.light { color: #8B6F47; }

.val-calligraphy {
  max-width: 100%;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  line-height: 1;
  color: #F3ECDD;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.val-calligraphy.light { color: #2E2618; }

.val-sm { font-size: var(--fs-22); letter-spacing: 0.06em; color: rgba(232, 223, 203, 0.86); }
.val-sm.light { color: #5A4E3A; }

/* 底部：防伪线 + VALID 章 */
.tp-footer {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx;
  background: #1A1814;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}
.tp-footer.light { background: rgba(46, 38, 24, 0.05); border-top-color: rgba(46, 38, 24, 0.14); }

.security-thread {
  position: relative;
  z-index: 5;
  width: 48%;
  height: 12rpx;
  overflow: hidden;
  border-radius: 2rpx;
  background: repeating-linear-gradient(90deg, rgba(196, 167, 108, 0.18), rgba(196, 167, 108, 0.18) 4rpx, rgba(196, 167, 108, 0.42) 5rpx, rgba(196, 167, 108, 0.42) 8rpx);
}
.security-thread.light {
  background: repeating-linear-gradient(90deg, rgba(46, 38, 24, 0.12), rgba(46, 38, 24, 0.12) 4rpx, rgba(46, 38, 24, 0.28) 5rpx, rgba(46, 38, 24, 0.28) 8rpx);
}

.scan-light {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 6;
  width: 30%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(232, 214, 170, 0.7), transparent);
  animation: holo-scan 3s infinite linear;
}
.security-thread.light .scan-light { background: linear-gradient(90deg, transparent, rgba(176, 141, 87, 0.7), transparent); }
@media (prefers-reduced-motion: reduce) { .scan-light { animation: none; } }

.stamp-seal {
  padding: 4rpx 12rpx;
  border: 2rpx solid var(--brass-300);
  border-radius: 2rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
  opacity: 0.85;
}
.stamp-seal.light { border-color: #8B6F47; color: #8B6F47; }

.flip-hint {
  position: absolute;
  right: 180rpx;
  bottom: 26rpx;
  z-index: 3;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.12em;
  color: rgba(196, 167, 108, 0.55);
  pointer-events: none;
}
.flip-hint.light { color: rgba(46, 38, 24, 0.45); }

/* —— 滚动区 —— */
.scroll-content {
  width: 100%;
  position: relative;
  z-index: 5;
  height: calc(100vh - 472rpx);
  max-height: calc(100vh - 472rpx);
  flex-shrink: 0;
  box-sizing: border-box;
}

.scroll-inner { padding: 8rpx 32rpx 0; }

.booking-scroll-safe { height: calc(200rpx + env(safe-area-inset-bottom)); }

/* —— 下划线页签 —— */
.tab-box {
  display: flex;
  gap: 36rpx;
  margin-top: 16rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.tab-item {
  height: 80rpx;
  line-height: 80rpx;
  margin-bottom: -1rpx;
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  color: var(--brass-200);
  font-weight: 500;
  border-bottom-color: var(--brass-400);
}

/* —— 分区头：眉标 + 宋体 —— */
.section-label {
  display: flex;
  flex-direction: column;
  margin: 48rpx 0 20rpx;
}

.sl-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.sl-cn {
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  letter-spacing: 0.06em;
  color: #F3ECDD;
}

/* —— 门店 / 定制 / 伴宠方案：发丝线块 —— */
.custom-plan-banner {
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.16);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.cp-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.cp-title {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: #F3ECDD;
}

.cp-sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.store-banner { position: relative; }

.cp-switch {
  position: absolute;
  top: 24rpx;
  right: 0;
  font-size: var(--fs-24);
  color: var(--brass-200);
}

.cp-switch.locked-tip {
  position: static;
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.cp-line {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.1);
}

.cp-label { font-size: var(--fs-22); color: var(--color-text-secondary); }
.cp-val { font-size: var(--fs-24); color: var(--color-text-body); text-align: right; }

.cp-tip {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.store-picker-mask { z-index: 90; }

.store-picker-sheet {
  position: relative;
  z-index: 91;
  margin: 16rpx 0 24rpx;
  padding: 8rpx 24rpx;
  background: var(--pop-surface);
  border: 1rpx solid var(--pop-hairline);
  border-radius: var(--pop-radius-dialog);
  box-shadow: var(--pop-shadow-dialog);
  animation: ui-pop-in var(--dur-base) var(--ease-out-soft) both;
}

.store-picker-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.12);
}

.store-picker-item:last-child { border-bottom: none; }

.spi-name {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: var(--color-text-body);
}

.store-picker-item.active .spi-name { color: var(--brass-200); }

.spi-loc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

/* —— 日期 —— */
.calendar-wrapper { margin-bottom: 16rpx; }

.date-selector-toggle {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  font-size: var(--fs-22);
  color: var(--brass-300);
}

.date-selector-toggle-press { opacity: 0.8; }

.toggle-text { font-size: var(--fs-22); }

.toggle-icon {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
}

.toggle-icon image { width: 28rpx; height: 28rpx; }

.date-scroll {
  white-space: nowrap;
  display: flex;
  margin: 0 -32rpx;
  width: calc(100% + 64rpx);
}

.date-scroll.hidden { display: none; }

.date-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 120rpx;
  margin-left: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  border-radius: var(--radius-sm);
}

.date-pill:first-child { margin-left: 32rpx; }

.d-week { font-size: var(--fs-20); color: var(--color-text-secondary); }

.d-day {
  margin-top: 6rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-32);
  color: var(--color-text-body);
}

.date-pill.active {
  border-color: var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
  box-shadow: var(--ring-brass);
}

.date-pill.active .d-week,
.date-pill.active .d-day { color: var(--brass-200); }

/* —— 时段 —— */
.time-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.time-btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--color-text-body);
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  border-radius: var(--radius-sm);
}

.time-btn.active {
  color: var(--brass-200);
  border-color: var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
  box-shadow: var(--ring-brass);
}

.time-btn.disabled {
  color: var(--color-text-secondary);
  border-style: dashed;
  opacity: 0.6;
}

.waitlist-hint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.hint-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.hint-icon image { width: 32rpx; height: 32rpx; }

.hint-text { flex: 1; font-size: var(--fs-24); color: var(--color-text-body); }

.waitlist-btn {
  flex-shrink: 0;
  padding: 0 24rpx;
  line-height: 60rpx;
  font-size: var(--fs-24);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-sm);
}

.waitlist-btn-press { opacity: 0.8; }

/* —— 人数 —— */
.guest-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.guest-tip { font-size: var(--fs-22); color: var(--color-text-secondary); }

.stepper { display: flex; align-items: center; gap: 8rpx; }

.s-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  box-sizing: border-box;
  font-size: var(--fs-32);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  border-radius: 50%;
}

.s-btn-press { opacity: 0.75; }

.s-val {
  min-width: 72rpx;
  text-align: center;
  font-family: var(--font-mono);
  font-size: var(--fs-32);
  color: #F3ECDD;
}

/* —— 联系信息：发丝线输入 —— */
.common-form-area { margin-top: 8rpx; }

.input-group { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.input-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 100rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.input-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.input-icon image { width: 32rpx; height: 32rpx; }

.mini-input {
  flex: 1;
  height: 100rpx;
  font-size: var(--fs-28);
  color: #F3ECDD;
}

.ph { color: var(--color-text-secondary); }

.icon-gold {
  filter: brightness(0) saturate(100%) invert(72%) sepia(14%) saturate(1004%) hue-rotate(2deg) brightness(92%) contrast(92%);
}

/* —— 课程 / 活动：发丝线行 —— */
.activity-list { margin-top: 24rpx; }

.act-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 16rpx;
  margin: 0 -16rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  border-radius: var(--radius-sm);
}

.act-card-press { opacity: 0.86; }

.act-card.selected {
  background: rgba(196, 167, 108, 0.1);
  box-shadow: var(--ring-brass);
}

.act-card.is-full { opacity: 0.6; }

.act-img {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
}

.act-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }

.act-t {
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: #F3ECDD;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.act-d { font-size: var(--fs-22); color: var(--color-text-secondary); }

.act-b { display: flex; align-items: center; gap: 16rpx; }

.act-p {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--brass-200);
}

.act-seat {
  padding: 0 10rpx;
  line-height: 32rpx;
  font-size: var(--fs-18);
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  border-radius: 4rpx;
}

.act-seat.is-full { color: #D6A04C; border-color: rgba(214, 160, 76, 0.45); }

/* —— 我的预约 —— */
.booking-history-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.history-tab-item {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: var(--fs-24);
  color: var(--color-text-body);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-sm);
}

.history-tab-item.active {
  color: var(--brass-200);
  border-color: var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
  box-shadow: var(--ring-brass);
}

.booking-list { margin-top: 24rpx; }

/* 待参加：浅纸票根（左窄条类型 + 齿孔 + 右侧信息） */
.ticket-card {
  position: relative;
  display: flex;
  min-height: 236rpx;
  margin-bottom: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.4);
  animation: fadeInUp 0.4s ease-out both;
}

.ticket-card-press { opacity: 0.9; }

.ticket-left {
  position: relative;
  flex-shrink: 0;
  width: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 2rpx dashed rgba(46, 38, 24, 0.28);
}

.hole-circle {
  position: absolute;
  right: -15rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #1A1814;
}

.hole-circle.top { top: -14rpx; }
.hole-circle.bottom { bottom: -14rpx; }

.dashed-line { display: none; }

.t-type {
  writing-mode: vertical-rl;
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  letter-spacing: 0.3em;
  color: #8B6F47;
}

.ticket-right {
  flex: 1;
  min-width: 0;
  padding: 24rpx 28rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.tr-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.tr-title {
  flex: 1;
  min-width: 0;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #2E2618;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tr-badge {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  color: #8A7F6C;
}

.tr-mid {
  display: flex;
  gap: 32rpx;
  margin-top: 18rpx;
}

.info-col { display: flex; flex-direction: column; gap: 6rpx; }

.lbl { font-size: var(--fs-18); color: #8A7F6C; letter-spacing: 0.1em; }

.val {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: #2E2618;
}

.val.highlight { color: #8B6F47; font-weight: 600; }

.tr-bot {
  display: flex;
  justify-content: flex-end;
  margin-top: auto;
  padding-top: 14rpx;
}

.btn-use { font-size: var(--fs-22); color: #8B6F47; }

/* 历史：发丝线行 + 「已使用」章 */
.history-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.history-card-press { opacity: 0.86; }

.hc-left {
  flex-shrink: 0;
  width: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hc-day {
  font-family: var(--font-mono);
  font-size: var(--fs-36);
  color: var(--color-text-body);
}

.hc-month { font-size: var(--fs-18); color: var(--color-text-secondary); }

.hc-mid { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }

.hc-title {
  font-size: var(--fs-26);
  color: var(--color-text-body);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hc-time { font-size: var(--fs-22); color: var(--color-text-secondary); }

.hc-right { flex-shrink: 0; }

.stamp-used {
  padding: 4rpx 12rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: 4rpx;
  transform: rotate(-6deg);
}

.empty-state {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.stagger-item { animation: fadeInUp 0.4s ease-out both; }

/* —— 底栏：本屏唯一实心金 —— */
.fixed-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  box-sizing: border-box;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #1A1814;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  pointer-events: none;
}

.submit-btn {
  pointer-events: auto;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brass-400);
  border-radius: var(--radius-md);
}

.submit-btn-press { opacity: 0.88; }

.btn-content { display: flex; align-items: center; }

.btn-main {
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.1em;
  color: #1A1814;
}

/* —— 生成入馆券（仪式卡）：出票口吐出一张浅纸券 —— */
.mint-modal {
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* 仪式卡遮罩：ui-pop-mask is-deep is-toggle（docs/弹层视觉规范_2026-10-13.md），active 仅留给后代选择器 */

.mint-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-bottom: env(safe-area-inset-bottom);
  position: relative;
}
/* 2026-10-18 防遮挡：不再用 80vh 定高 + 底部绝对定位（矮屏上按钮会压住出纸底边）。
   出纸仍绝对定位、从打印机下沿 0→720rpx 展开；操作区回到文档流，
   margin-top 恰好让出整张纸 + 48rpx 间距 —— 无论屏多矮，按钮永远在纸下方，遮罩居中整组。 */

.mint-machine {
  width: 520rpx;
  height: 40rpx;
  background: #262320;
  border-radius: 30rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: center;
}

.printer-light { position: absolute; right: 24rpx; top: 12rpx; }

.printer-slot {
  width: 420rpx;
  height: 6rpx;
  margin-top: 16rpx;
  background: #1A1814;
  border-radius: 4rpx;
}

.ticket-paper {
  position: absolute;
  top: 20rpx;
  left: 0;
  right: 0;
  margin: 0 auto;
  width: 480rpx;
  height: 0;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border-radius: 0 0 4rpx 4rpx;
  overflow: hidden;
  z-index: 5;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  transition: height 2.5s var(--ease-standard);
}

.ticket-paper.printing { height: 720rpx; }

.tp-mini {
  position: relative;
  padding: 40rpx;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.tp-mini::before {
  content: '';
  position: absolute;
  inset: 14rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.tm-head { text-align: center; margin-bottom: 24rpx; width: 100%; }

.tm-title {
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #2E2618;
}

.tm-line { width: 60rpx; height: 1rpx; background: rgba(46, 38, 24, 0.3); margin: 16rpx auto 0; }

.tm-invite { text-align: center; margin-bottom: 24rpx; flex: 1; display: flex; flex-direction: column; justify-content: center; }

.tm-label {
  display: block;
  margin-bottom: 12rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: #8B6F47;
}

.tm-name {
  display: block;
  margin-bottom: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  color: #2E2618;
}

.tm-desc { font-size: var(--fs-20); color: #5E5444; }

.tm-code-box { margin-top: auto; display: flex; flex-direction: column; align-items: center; width: 100%; padding-bottom: 20rpx; }

.tm-qr {
  width: 260rpx;
  height: 260rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  position: relative;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.tm-qr image { width: 100%; height: 100%; }

.scan-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: #B08D57;
  animation: scan-y 2s infinite;
}

.tm-val {
  font-family: var(--font-mono);
  font-size: var(--fs-32);
  letter-spacing: 0.06em;
  color: #2E2618;
}

.tm-foot { margin-top: 16rpx; font-size: var(--fs-18); letter-spacing: 0.12em; color: #8A7F6C; }

.mint-bottom-area {
  position: relative;
  /* = 出纸 top 20 + 高 720 − 打印机高 40 + 间距 48 */
  margin-top: 748rpx;
  min-height: 184rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
}

.mint-tip {
  margin-bottom: 20rpx;
  font-size: var(--fs-24);
  letter-spacing: 0.1em;
  color: var(--color-text-secondary);
  animation: bk-pulse 1.5s infinite;
}

.mint-progress { width: 300rpx; height: 4rpx; background: rgba(196, 167, 108, 0.16); border-radius: 2rpx; overflow: hidden; }

.mp-bar { width: 100%; height: 100%; background: var(--brass-400); transform: translateX(-100%); animation: bk-progress 2.5s linear forwards; }

.mint-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity var(--dur-slow) var(--ease-standard) 2.6s, transform var(--dur-slow) var(--ease-standard) 2.6s;
}

.mint-actions.show { opacity: 1; transform: translateY(0); }

.btn-check {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 96rpx;
  line-height: 92rpx;
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.1em;
  color: #1A1814;
  background: var(--brass-400);
  border-radius: var(--radius-md);
}

.btn-check-press { opacity: 0.88; }

.btn-check .arrow { font-size: var(--fs-30); }

.btn-group-sub { margin-top: 24rpx; }

.btn-sub-act {
  padding: 16rpx;
  font-size: var(--fs-24);
  color: var(--brass-200);
}

.btn-sub-act-press { opacity: 0.8; }

/* 小惊喜：朱印「入馆」—— 出纸完成时自上而下盖印（放大 → 回落 → 轻微回弹），落在票纸右下角内框上；
   朱色只在纸面上出现，是整张入馆券唯一的红 */
.tm-seal {
  position: absolute;
  right: 34rpx;
  bottom: 44rpx;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(168, 53, 42, 0.82);
  border-radius: 6rpx;
  box-shadow: inset 0 0 0 3rpx rgba(243, 236, 221, 0.5), inset 0 0 0 5rpx rgba(168, 53, 42, 0.55);
  color: rgba(168, 53, 42, 0.86);
  transform: rotate(-12deg) scale(1.9);
  opacity: 0;
  pointer-events: none;
  z-index: 2;
}
.tm-seal-ch {
  font-family: var(--font-brand);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 36rpx;
}
.tm-seal.is-stamped { animation: tm-seal-stamp 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.2) both; }
@keyframes tm-seal-stamp {
  0% { opacity: 0; transform: rotate(-12deg) scale(1.9); }
  60% { opacity: 0.95; transform: rotate(-12deg) scale(0.94); }
  100% { opacity: 0.9; transform: rotate(-12deg) scale(1); }
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .scan-bar,
  .mint-tip {
    animation: none;
  }
  .tm-seal.is-stamped { animation: none; opacity: 0.9; transform: rotate(-12deg); }
}
