/* pages/booking/index.wxss */
/* 继承 app.wxss */

/* 1. 动画定义 */
@keyframes holo-scan { 0% { transform: translateX(-100%); } 100% { transform: translateX(200%); } }
@keyframes scan-y { 0% { top: 0; opacity: 0; } 50% { opacity: 1; } 100% { top: 100%; opacity: 0; } }

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 0;
  background: var(--color-bg);
  position: relative;
}

/* 2. 典藏票据预览 (3D 翻转版) */
.ticket-header { position: relative; z-index: 10; width: 100%; padding: 0 40rpx 8rpx; flex-shrink: 0; }

.booking-back {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md, 16rpx);
  border: 1px solid transparent;
  background: transparent;
}

/* 3D 容器 */
.ticket-3d-container {
  position: relative;
  width: 100%; height: 380rpx; 
  transform-style: preserve-3d; 
  transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.ticket-3d-container.flipped { transform: rotateY(180deg); }

/* 通用票面 */
.ticket-face {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  border-radius: 16rpx; overflow: hidden;
  backface-visibility: hidden; 
  box-shadow: 0 30rpx 60rpx rgba(0,0,0,0.8);
}

/* 正面：黑金 (Dark) */
.face-front {
  background: radial-gradient(circle at 90% 10%, #222 0%, #111 100%);
  border: 1px solid rgba(255,255,255,0.1);
  transform: rotateY(0deg); z-index: 2;
}

/* 背面：白银 (Light) */
.face-back {
  background: #f5f5f7; border: 1px solid #ddd;
  transform: rotateY(180deg); color: #333;
}

/* 装饰元素 */
.paper-texture { position: absolute; width: 100%; height: 100%; opacity: 0.05; pointer-events: none; background-image: repeating-linear-gradient(0deg, var(--gold) 0, var(--gold) 1rpx, transparent 0, transparent 6rpx), repeating-linear-gradient(90deg, var(--gold) 0, var(--gold) 1rpx, transparent 0, transparent 6rpx); }
.gold-strip { position: absolute; top: 0; left: 30rpx; bottom: 0; width: 2rpx; background: linear-gradient(to bottom, transparent, var(--gold), transparent); z-index: 5; opacity: 0.5; }
.silver-strip { position: absolute; top: 0; left: 30rpx; bottom: 0; width: 4rpx; background: linear-gradient(to bottom, transparent, #ccc, transparent); z-index: 5; }

.watermark { 
  position: absolute; bottom: -20rpx; right: -10rpx; font-size: 260rpx; 
  opacity: 0.08; pointer-events: none; transform: rotate(-15deg); 
  filter: grayscale(1) contrast(1.2); z-index: 1; font-family: var(--font-brand); 
}
.watermark.light { opacity: 0.05; filter: none; color: var(--color-bg); }

.notch { position: absolute; top: 160rpx; width: 32rpx; height: 32rpx; background: var(--color-bg); border-radius: 50%; z-index: 5; }
.notch.left { left: -16rpx; box-shadow: inset -2rpx 0 6rpx rgba(255,255,255,0.1); } 
.notch.right { right: -16rpx; box-shadow: inset 2rpx 0 6rpx rgba(255,255,255,0.1); }
.notch.light { background: var(--color-bg); box-shadow: inset 0 0 4rpx rgba(0,0,0,0.1); }

/* 内容布局 */
.tp-header { 
  padding: 40rpx 40rpx 30rpx; 
  display: flex; 
  justify-content: space-between; 
  align-items: flex-start; /* 顶部对齐，防止换行导致编号下移 */
  position: relative; z-index: 2; 
  border-bottom: 1px dashed rgba(255,255,255,0.1); 
}
.tp-header.light { border-bottom: 1px dashed #ccc; }

/* 🟢 修复：品牌区域允许换行 */
.tp-brand {
  flex: 1; /* 占据剩余空间 */
  display: flex;
  flex-direction: column; /* 垂直排列主副标题 */
  margin-right: 20rpx; /* 与编号保持距离 */
}

.tp-logo { 
  font-family: var(--font-brand); 
  font-size: var(--fs-24); 
  font-weight: 900; 
  letter-spacing: 2rpx; 
  color: var(--gold); 
  line-height: 1.3; /* 增加行高，防止换行太挤 */
  word-break: break-word; /* 允许长单词换行 */
  white-space: normal; /* 允许换行 */
}
.tp-logo.light { color: var(--color-bg); }

.tp-tagline {
  font-size: 20rpx;
  color: rgba(213, 209, 200, 0.9);
  letter-spacing: 0.15em;
  margin-top: 6rpx;
  font-weight: 400;
  line-height: 1.3;
}
.tp-tagline.light { color: #555; }

.tp-sub { 
  font-size: 18rpx; 
  color: #A09A90; 
  letter-spacing: 2rpx; 
  margin-top: 8rpx; 
  font-weight: bold; 
  text-transform: uppercase; 
  font-family: var(--font-din); 
  line-height: 1.4;
  white-space: normal; /* 允许换行 */
}
.tp-sub.light { color: #888; }

.tp-serial { 
  font-family: var(--font-din); 
  font-size: 20rpx; 
  color: #A09A90; 
  border: 1px solid #333; 
  padding: 4rpx 10rpx; 
  border-radius: 4rpx; 
  flex-shrink: 0; /* 防止编号被挤压 */
}
.tp-serial.light { color: #555; border-color: #ccc; }

.tp-body { padding: 30rpx 40rpx; position: relative; z-index: 2; }
.info-row { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24rpx; }
.info-item { display: flex; flex-direction: column; flex: 1; }
.info-item.center { align-items: center; text-align: center; }
.info-item.right { align-items: flex-end; text-align: right; }

.label { font-size: 18rpx; color: #A09A90; letter-spacing: 2rpx; margin-bottom: 8rpx; font-weight: bold; text-transform: uppercase; font-family: var(--font-din); }
.label.light { color: #999; }

.val { font-family: var(--font-din); font-size: 36rpx; font-weight: bold; color: #fff; line-height: 1; }
.val.light { color: var(--color-bg); }

.val.highlight { color: var(--gold); font-size: 48rpx; text-shadow: none; line-height: 0.8; }
.val.highlight.light { color: var(--gold); text-shadow: none; }

.val-calligraphy { font-family: "Times New Roman", serif; font-style: italic; font-size: 32rpx; color: #eee; line-height: 1; }
.val-calligraphy.light { color: #333; }

.val-sm { font-size: 20rpx; font-weight: bold; color: #eee; letter-spacing: 1rpx; text-transform: uppercase; font-family: var(--font-din); }
.val-sm.light { color: #555; }

/* 底部 & 防伪线 */
.tp-footer { 
  background: #1a1a1a; padding: 20rpx 40rpx; 
  display: flex; justify-content: space-between; align-items: center; 
  position: relative; z-index: 2; border-top: 1px solid rgba(255,255,255,0.05); 
}
.tp-footer.light { background: #e8e8e8; border-top: 1px solid #ddd; }

/* 动态防伪线容器 */
.security-thread {
  width: 60%; height: 16rpx;
  background: repeating-linear-gradient(90deg, #333, #333 4rpx, #555 5rpx, #555 8rpx);
  position: relative;
  border-radius: 4rpx;
  opacity: 0.9;
  overflow: hidden;
  z-index: 5;
}
.security-thread.light {
  background: repeating-linear-gradient(90deg, #ccc, #ccc 4rpx, #eee 5rpx, #eee 8rpx);
}

/* 扫描光效实体 */
.scan-light {
  width: 30%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  position: absolute; top: 0; left: 0;
  animation: holo-scan 2s infinite linear;
  z-index: 6;
}
.security-thread.light .scan-light {
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108, 0.8), transparent);
}

.stamp-seal { border: 2rpx solid var(--gold); color: var(--gold); font-size: 18rpx; font-weight: bold; padding: 4rpx 12rpx; border-radius: 4rpx; letter-spacing: 4rpx; opacity: 0.8; }
.stamp-seal.light { border-color: var(--color-bg); color: var(--color-bg); opacity: 0.6; }

.flip-hint {
  position: absolute; bottom: 10rpx; right: 20rpx;
  font-size: var(--fs-18); color: rgba(255,255,255,0.5);
  font-family: var(--font-din); letter-spacing: 2rpx;
  pointer-events: none;
}

/* 3. 滚动操作区
   iPhone：不用 flex:1 + height:0（scroll-view 会塌成空白） */
.scroll-content {
  width: 100%;
  position: relative;
  z-index: 5;
  height: calc(100vh - 420rpx);
  max-height: calc(100vh - 420rpx);
  flex-shrink: 0;
  box-sizing: border-box;
}
/* 底部为固定预约栏预留：用内容区 spacer，不依赖 scroll-view padding-bottom */
.scroll-inner { padding: 16rpx 30rpx 0; }
.booking-scroll-safe {
  width: 100%;
  height: calc(220rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

/* Tab 切换 - 黑金质感 */
.tab-box { 
  display: flex; 
  background: linear-gradient(135deg, rgba(0,0,0,0.6), rgba(20,20,20,0.5)); 
  border-radius: 100rpx; 
  padding: 6rpx; 
  margin-bottom: 28rpx; 
  border: 1.5px solid rgba(196, 167, 108,0.2);
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
}
.tab-item { 
  flex: 1; 
  min-width: 0;
  text-align: center; 
  font-size: 24rpx; 
  color: rgba(255,255,255,0.6); 
  padding: 14rpx 6rpx; 
  border-radius: 40rpx; 
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard), color var(--dur-slow) var(--ease-standard), background-color var(--dur-slow) var(--ease-standard), border-color var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard); 
  font-weight: 700;
  letter-spacing: 1rpx;
  position: relative;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  box-sizing: border-box;
}
.tab-item::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.15), transparent);
  opacity: 0;
  transition: opacity var(--dur-slow) var(--ease-standard);
  pointer-events: none;
}
.tab-item:active::before {
  opacity: 1;
}
.tab-item.active { 
  background: linear-gradient(135deg, #A8903C 0%, var(--gold) 100%);
  background-size: 200% 100%;
  color: var(--color-bg); 
  box-shadow:
    0 3rpx 12rpx rgba(0,0,0,0.4),
    inset 0 2rpx 4rpx rgba(255,255,255,0.3);
  font-weight: 800;
  border: 1px solid rgba(196, 167, 108,0.6);
  animation: tab-golden-shine 3s ease-in-out infinite;
}
@keyframes tab-golden-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* 日期选择 */
.section-label { 
  font-size: 24rpx; color: var(--gold); letter-spacing: 4rpx; margin-bottom: 30rpx; 
  font-weight: bold; display: flex; align-items: center; 
}
.section-label::before { content: ''; width: 6rpx; height: 6rpx; background: var(--gold); margin-right: 16rpx; transform: rotate(45deg); }

/* 日历视图切换 */
.calendar-wrapper {
  margin: 24rpx 0;
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.date-selector-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  margin: 24rpx 0;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  border: 2px solid rgba(196, 167, 108,0.2);
  border-radius: 16rpx;
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
}

.date-selector-toggle:active,
.date-selector-toggle-press {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.1));
  border-color: rgba(196, 167, 108,0.4);
  transform: scale(0.98);
}

.toggle-text {
  font-size: 26rpx;
  color: var(--gold);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.toggle-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold);
}
.toggle-icon image {
  width: 32rpx;
  height: 32rpx;
}
.toggle-icon > view {
  width: 32rpx;
  height: 32rpx;
}

.date-scroll.hidden {
  display: none;
}

.date-scroll { display: flex; white-space: nowrap; margin-bottom: 50rpx; height: 140rpx; width: 100%; }
.date-pill { 
  display: inline-flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center; 
  width: 110rpx; 
  height: 140rpx; 
  background: linear-gradient(135deg, rgba(0,0,0,0.8), rgba(20,20,20,0.6)); 
  border-radius: 16rpx; 
  margin-right: 20rpx; 
  border: 1.5px solid rgba(196, 167, 108,0.2); 
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard), color var(--dur-slow) var(--ease-standard), background-color var(--dur-slow) var(--ease-standard), border-color var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard);
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
  position: relative;
  overflow: hidden;
}
.date-pill::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), transparent);
  opacity: 0;
  transition: opacity var(--dur-slow) var(--ease-standard);
  pointer-events: none;
}
.date-pill:active::before {
  opacity: 1;
}
.date-pill.active { 
  background: linear-gradient(135deg, #A8903C 0%, var(--gold) 100%);
  background-size: 200% 100%;
  border-color: rgba(196, 167, 108,0.8); 
  box-shadow:
    0 3rpx 12rpx rgba(0,0,0,0.4),
    inset 0 2rpx 4rpx rgba(255,255,255,0.3);
  transform: translateY(-6rpx) scale(1.05);
  animation: date-golden-shine 3s ease-in-out infinite;
}
@keyframes date-golden-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
.d-week { font-size: 20rpx; color: rgba(255,255,255,0.5); margin-bottom: 8rpx; font-family: var(--font-din); text-transform: uppercase; font-weight: 600; transition: color var(--dur-slow) var(--ease-standard); }
.d-day { font-size: 40rpx; font-weight: 800; color: rgba(255,255,255,0.9); font-family: var(--font-din); transition: color var(--dur-slow) var(--ease-standard); }
.date-pill.active .d-week, .date-pill.active .d-day { color: var(--color-bg); }

/* 时间与人数 - 黑金质感 */
.time-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24rpx; margin-bottom: 30rpx; }

/* 候补功能提示 */
.waitlist-hint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  border: 2px solid rgba(196, 167, 108,0.3);
  border-radius: 16rpx;
  backdrop-filter: blur(8px);
}

.hint-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hint-icon > view {
  width: 32rpx;
  height: 32rpx;
}

.hint-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(196, 167, 108,0.9);
  letter-spacing: 1rpx;
}

.waitlist-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.1));
  border: 2px solid rgba(196, 167, 108,0.4);
  border-radius: 12rpx;
  color: var(--gold);
  font-size: 24rpx;
  font-weight: 600;
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
}

.waitlist-btn:active,
.waitlist-btn-press {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.3), rgba(196, 167, 108,0.2));
  transform: scale(0.98);
}
.time-btn { 
  height: 88rpx; 
  background: linear-gradient(135deg, rgba(0,0,0,0.6), rgba(20,20,20,0.4)); 
  border: 1.5px solid rgba(196, 167, 108,0.2); 
  border-radius: 12rpx; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  font-family: var(--font-din); 
  font-size: 30rpx; 
  color: rgba(255,255,255,0.7); 
  position: relative;
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard), color var(--dur-slow) var(--ease-standard), background-color var(--dur-slow) var(--ease-standard), border-color var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard);
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
  overflow: hidden;
  font-weight: 600;
}
.time-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.15), transparent);
  opacity: 0;
  transition: opacity var(--dur-slow) var(--ease-standard);
  pointer-events: none;
}
.time-btn:active::before {
  opacity: 1;
}
.time-btn.active { 
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.1));
  border-color: var(--gold); 
  color: var(--gold); 
  box-shadow:
    0 4rpx 12rpx rgba(0,0,0,0.4),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  font-weight: 800;
  transform: scale(1.05);
  text-shadow: none;
}
.time-btn.disabled { 
  opacity: 0.3; 
  pointer-events: none; 
  text-decoration: line-through;
  filter: grayscale(0.8);
}

.guest-card { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  background: linear-gradient(135deg, rgba(0,0,0,0.6), rgba(20,20,20,0.5)); 
  border: 1.5px solid rgba(196, 167, 108,0.2); 
  border-radius: 16rpx; 
  padding: 30rpx; 
  margin-bottom: 50rpx;
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
}
.guest-tip { font-size: 22rpx; color: rgba(255,255,255,0.5); }
.stepper { 
  display: flex; 
  align-items: center; 
  background: linear-gradient(135deg, rgba(0,0,0,0.8), rgba(20,20,20,0.6)); 
  border-radius: 30rpx; 
  border: 1.5px solid rgba(196, 167, 108,0.3); 
  padding: 4rpx;
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
}
.s-btn { 
  width: 70rpx; 
  height: 60rpx; 
  line-height: 56rpx; 
  text-align: center; 
  font-size: 36rpx; 
  color: var(--gold); 
  font-weight: 800;
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  border-radius: 26rpx;
  position: relative;
  overflow: hidden;
}
.s-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), transparent);
  opacity: 0;
  transition: opacity var(--dur-base) var(--ease-standard);
  pointer-events: none;
}
.s-btn:active,
.s-btn-press {
  background: rgba(196, 167, 108,0.15);
  transform: scale(0.95);
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.3);
}
.s-btn:active::before {
  opacity: 1;
}
.s-val { 
  width: 60rpx; 
  text-align: center; 
  font-size: 30rpx; 
  color: #fff; 
  font-family: var(--font-din); 
  font-weight: 800;
  text-shadow: none;
}

/* 输入框 */
.input-group { margin-bottom: 40rpx; }
.input-row { display: flex; align-items: center; height: 100rpx; border-bottom: 1px solid rgba(255,255,255,0.1); }
.input-icon { 
  width: 32rpx; 
  height: 32rpx; 
  margin-right: 24rpx; 
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.5; 
  filter: grayscale(1); 
}
.input-icon image {
  width: 32rpx;
  height: 32rpx;
}
.input-icon > view {
  width: 32rpx;
  height: 32rpx;
}
