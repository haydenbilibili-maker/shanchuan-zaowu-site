  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.val {
  font-size: 30rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 800;
  font-family: var(--font-din);
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.6);
}

.val.highlight {
  color: var(--gold);
  font-size: 34rpx;
  text-shadow:
    0 2rpx 4rpx rgba(0,0,0,0.6);
  font-weight: 900;
}

.tr-bot {
  border-top: 1px solid rgba(196, 167, 108,0.15);
  padding-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  flex-shrink: 0;
}

.btn-use {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 800;
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.12), rgba(196, 167, 108,0.06));
  border: 1.5px solid rgba(196, 167, 108,0.3);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  box-sizing: border-box;
  line-height: 1.3;
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
}

.btn-use:active {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.12));
  border-color: rgba(196, 167, 108,0.5);
  transform: scale(0.97);
  box-shadow:
    0 2rpx 8rpx rgba(0,0,0,0.4),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
}

/* 历史记录卡片样式 */
.history-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(0,0,0,0.6), rgba(20,20,20,0.4));
  border-radius: 16rpx;
  opacity: 0.85;
  border: 1.5px solid rgba(196, 167, 108,0.15);
  box-shadow: 
    0 8rpx 24rpx rgba(0,0,0,0.4),
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.03);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  backdrop-filter: blur(8px);
}

.history-card:active,
.history-card-press {
  transform: scale(0.98);
  opacity: 0.95;
  border-color: rgba(196, 167, 108,0.25);
}

.hc-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 28rpx;
  border-right: 1.5px solid rgba(196, 167, 108,0.2);
  padding-right: 28rpx;
  min-width: 90rpx;
}

.hc-day {
  font-size: 40rpx;
  font-weight: 900;
  color: rgba(196, 167, 108,0.7);
  font-family: var(--font-din);
  text-shadow: none;
}

.hc-month {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  font-family: var(--font-din);
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.hc-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hc-title {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 8rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.6);
}

.hc-time {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  font-family: var(--font-din);
  font-weight: 600;
}

.hc-right {
  margin-left: 24rpx;
}

.stamp-used {
  border: 2rpx solid rgba(196, 167, 108,0.4);
  color: rgba(196, 167, 108,0.7);
  font-size: 18rpx;
  padding: 6rpx 14rpx;
  transform: rotate(-10deg);
  font-weight: 800;
  border-radius: 6rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  letter-spacing: 2rpx;
  text-shadow: none;
}

.empty-state {
  text-align: center;
  margin-top: 120rpx;
  color: rgba(255,255,255,0.4);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}