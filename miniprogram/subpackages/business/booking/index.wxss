/* ==================== 🟢 4. 门票铸造动画 (布局修复版) ==================== */

.mint-modal {
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* 仪式卡遮罩：ui-pop-mask is-deep is-toggle（docs/弹层视觉规范_2026-10-13.md），active 仅留给后代选择器 */

.mint-content { 
  width: 100%; 
  height: 80vh; /* 占据屏幕高度 */
  display: flex; flex-direction: column; align-items: center; 
  justify-content: flex-start; /* 从上往下排布 */
  padding-top: 100rpx; /* 给票纸留出滑出的空间 */
  position: relative;
}

/* 打印机实体 */
.mint-machine {
  width: 520rpx; height: 40rpx; 
  background: linear-gradient(to bottom, #333, #1a1a1a); 
  border-radius: 30rpx; border: 2rpx solid #444;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.8);
  position: relative; z-index: 10; /* 关键：盖住票纸顶部 */
  display: flex; justify-content: center;
}

/* 指示灯：样式见 app.wxss .signal-light；此处仅定位 */
.printer-light {
  position: absolute; right: 24rpx; top: 12rpx;
}

.printer-slot {
  width: 420rpx; height: 6rpx; background: var(--color-bg); margin-top: 16rpx; border-radius: 4rpx;
  box-shadow: 0 0 10rpx var(--gold);
}

/* 🟢 票据本体 */
.ticket-paper {
  position: absolute; /* 相对于 mint-machine 定位可能太复杂，这里相对于 mint-content 定位更稳 */
  top: 120rpx; /* 刚好在打印机下面一点 */
  left: 0; right: 0; margin: 0 auto; /* 水平居中 */
  
  width: 480rpx; /* 比打印机窄一点 */
  height: 0; /* 初始高度 */
  
  background: #f7f5f0; 
  border: 4rpx solid var(--gold); 
  border-top: none; /* 顶部无边框，模拟连着 */
  border-radius: 0 0 16rpx 16rpx; 
  
  overflow: hidden; z-index: 5; /* 在打印机下面 */
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.5);
  transition: height 2.5s var(--ease-standard);
  
  /* 纸张纹理 */
  background-image: radial-gradient(#e0e0e0 1px, transparent 1px);
  background-size: 12rpx 12rpx;
}
.ticket-paper.printing { height: 800rpx; } /* 展开高度 */

.tp-mini { 
  padding: 40rpx; height: 100%; width: 100%;
