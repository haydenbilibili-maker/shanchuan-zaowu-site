<!--pages/booking/index.wxml-->
<view class="container">

  <!-- 1. 顶部：入馆券票根（2026-10-17 重构）—— 原双面翻转票（两面重复 + 🦋 水印 + VALID 章）收成一张浅纸票根：
       左三格（日期 / 时段 / 人数）随选择实时更新，齿孔线右侧是持券人与类型。 -->
  <view class="ticket-header">
    <view class="stub">
      <view class="stub-pin" aria-hidden="true"></view>
      <view class="stub-main">
        <text class="stub-eyebrow">VISIT PASS · 入馆券 · NO.V-{{ticketYear}}</text>
        <view class="stub-row">
          <view class="stub-cell"><text class="stub-k">日期</text><text class="stub-v">{{ticketInfo.dateStr}}</text></view>
          <view class="stub-cell"><text class="stub-k">时段</text><text class="stub-v is-key">{{ticketInfo.timeStr}}</text></view>
          <view class="stub-cell"><text class="stub-k">人数</text><text class="stub-v">{{bookCount < 10 ? '0' + bookCount : bookCount}} 人</text></view>
        </view>
      </view>
      <view class="stub-tear" aria-hidden="true"></view>
      <view class="stub-side">
        <text class="stub-k">持券人</text>
        <text class="stub-holder">{{contactName || '贵宾'}}</text>
        <text class="stub-type">{{ticketInfo.typeStr}}</text>
      </view>
    </view>
  </view>

  <!-- 2. 中间：滚动操作区 -->
  <scroll-view scroll-y="true" class="scroll-content" enable-flex="true">
    <view class="scroll-inner">
      <view class="tab-box">
        <view hover-class="tap-press-soft" hover-stay-time="80" class="tab-item {{currentTab==0 ? 'active' : ''}}" bindtap="switchTab" data-idx="0">入店参观</view>
        <view hover-class="tap-press-soft" hover-stay-time="80" class="tab-item {{currentTab==1 ? 'active' : ''}}" bindtap="switchTab" data-idx="1">手作课程</view>
        <view hover-class="tap-press-soft" hover-stay-time="80" class="tab-item {{currentTab==2 ? 'active' : ''}}" bindtap="switchTab" data-idx="2">特别活动</view>
        <view hover-class="tap-press-soft" hover-stay-time="80" class="tab-item {{currentTab==3 ? 'active' : ''}}" bindtap="switchTab" data-idx="3">我的预约</view>
      </view>

      <!-- A: 参观表单 (仅 Tab 0 显示日期选择) -->
      <block wx:if="{{currentTab == 0}}">
        <view hover-class="tap-press-soft" hover-stay-time="80" class="custom-plan-banner store-banner {{storeLocked ? 'locked' : ''}}" bindtap="toggleStorePicker">
          <text class="cp-overline">STORE · 预约门店</text>
          <text class="cp-title">{{storeName}}</text>
          <text class="cp-sub" wx:if="{{storeLocationLabel}}">{{storeLocationLabel}}</text>
          <text class="cp-switch" wx:if="{{!storeLocked}}">切换门店 ›</text>
          <text class="cp-switch locked-tip" wx:else>定制 / 伴宠服务固定预约星宸标本工作室</text>
          <block wx:for="{{storeVisitTips}}" wx:key="*this">
            <text class="cp-tip">· {{item}}</text>
          </block>
        </view>
        <view class="ui-pop-mask store-picker-mask" wx:if="{{storePickerOpen}}" bindtap="closeStorePicker" catchtouchmove="true"></view>
        <view class="store-picker-sheet" wx:if="{{storePickerOpen}}">
          <view
            class="store-picker-item {{item.storeId === storeId ? 'active' : ''}}"
            wx:for="{{storeList}}"
            wx:key="storeId"
            bindtap="selectBookingStore"
            data-id="{{item.storeId}}"
            hover-class="tap-press-soft"
            hover-stay-time="80"
          >
            <text class="spi-name">{{item.name}}</text>
            <text class="spi-loc">{{item.locationLabel}}</text>
          </view>
        </view>
        <view class="custom-plan-banner" wx:if="{{isCustomBooking && customPlanLines.length}}">
          <text class="cp-overline">ATELIER · 定制方案</text>
          <text class="cp-title">{{customPlanTitle}}</text>
          <view class="cp-line" wx:for="{{customPlanLines}}" wx:key="label">
            <text class="cp-label">{{item.label}}</text>
            <text class="cp-val">{{item.value}}</text>
          </view>
          <text class="cp-tip">预约成功后，门店将按此方案为您预留确认时段</text>
        </view>
        <view class="custom-plan-banner pet" wx:if="{{isPetIntakeBooking && petPlanLines.length}}">
          <text class="cp-overline">PET MEMORIAL · 遗体交接</text>
          <text class="cp-title">{{petPlanTitle}}</text>
          <view class="cp-line" wx:for="{{petPlanLines}}" wx:key="label">
            <text class="cp-label">{{item.label}}</text>
            <text class="cp-val">{{item.value}}</text>
          </view>
          <text class="cp-tip">请选择到店交接时间，标本师将当面确认并接收</text>
        </view>
        <view class="section-label"><text class="sl-en">DATE</text><text class="sl-cn">选择日期</text></view>
        
        <!-- 日历视图 -->
        <view class="calendar-wrapper" wx:if="{{showCalendar}}">
          <calendar 
            selected-date="{{selectedCalendarDate}}"
            unavailable-dates="{{unavailableDates}}"
            full-dates="{{fullDates}}"
            bind:select="onCalendarSelect">
          </calendar>
        </view>
        
        <!-- 快速日期选择（横向滚动） -->
        <view class="date-selector-toggle" bindtap="toggleCalendarView" hover-class="date-selector-toggle-press" hover-stay-time="80">
          <text class="toggle-text">{{showCalendar ? '切换到快速选择' : '切换到日历视图'}}</text>
          <view class="toggle-icon" wx:if="{{!showCalendar}}"><image src="/assets/icons/calendar_gold.png" mode="aspectFit"></image></view>
          <text class="toggle-icon" wx:else>→</text>
        </view>
        
        <scroll-view scroll-x="true" class="date-scroll {{showCalendar ? 'hidden' : ''}}" enable-flex="true">
          <block wx:for="{{weekDays}}" wx:key="index">
            <view hover-class="tap-press" hover-stay-time="80" class="date-pill {{selectedDateIndex === index ? 'active' : ''}}" bindtap="selectDate" data-index="{{index}}">
              <text class="d-week">{{item.week}}</text><text class="d-day">{{item.day}}</text>
            </view>
          </block>
        </scroll-view>
        
        <view class="section-label"><text class="sl-en">SESSION</text><text class="sl-cn">预约时段</text></view>
        <view class="time-grid">
          <block wx:for="{{timeSlots}}" wx:key="index">
            <view hover-class="tap-press" hover-stay-time="80" class="time-btn {{item.status === 'full' ? 'disabled' : ''}} {{selectedTimeIndex === index ? 'active' : ''}}" bindtap="selectTime" data-index="{{index}}" data-status="{{item.status}}">
              <text>{{item.time}}</text>
            </view>
          </block>
        </view>
        
        <!-- 🟢 候补功能提示 -->
        <view class="waitlist-hint" wx:if="{{selectedTimeIndex !== -1 && timeSlots[selectedTimeIndex].status === 'full'}}">
          <view class="hint-icon"><image src="/subpackages/business/assets/icons/clock.png" mode="aspectFit" class="icon-gold"></image></view>
          <text class="hint-text">该时间段已满，可加入候补列表</text>
          <view class="waitlist-btn" bindtap="addToWaitlist" hover-class="waitlist-btn-press" hover-stay-time="80">加入候补</view>
        </view>
        <view class="section-label"><text class="sl-en">GUESTS</text><text class="sl-cn">参观人数</text></view>
        <view class="guest-card">
           <text class="guest-tip">单次预约上限 10 人</text>
           <view class="stepper"><view class="s-btn" bindtap="changeCount" hover-class="s-btn-press" hover-stay-time="80" data-type="minus">-</view><view class="s-val">{{bookCount}}</view><view class="s-btn" bindtap="changeCount" hover-class="s-btn-press" hover-stay-time="80" data-type="add">+</view></view>
        </view>
      </block>

      <!-- B: 手作课程列表 -->
      <block wx:if="{{currentTab == 1}}">
        <view class="activity-list">
          <block wx:for="{{courses}}" wx:key="_id">
            <view class="act-card {{selectedActivityId === item._id ? 'selected' : ''}} {{item._full ? 'is-full' : ''}}" bindtap="selectActivity" hover-class="act-card-press" hover-stay-time="80" data-id="{{item._id}}" data-status="{{item._full ? 'full' : item.status}}" data-type="course">
              <image class="act-img" src="{{item.image}}" mode="aspectFill"></image>
              <view class="act-info">
                <text class="act-t">{{item.title}}</text>
                <text class="act-d">{{item.date}} · {{item.time}}</text>
                <view class="act-b"><text class="act-p">¥{{item.price}}</text><text class="act-seat {{item._full ? 'is-full' : ''}}" wx:if="{{item._seat}}">{{item._seat}}</text></view>
              </view>
            </view>
          </block>
          <view class="empty-state" wx:if="{{courses.length === 0}}"><text>暂无课程排期</text></view>
        </view>
      </block>

      <!-- C: 特别活动列表 -->
      <block wx:if="{{currentTab == 2}}">
        <view class="activity-list">
          <block wx:for="{{activities}}" wx:key="_id">
            <view class="act-card {{selectedActivityId === item._id ? 'selected' : ''}} {{item._full ? 'is-full' : ''}}" bindtap="selectActivity" hover-class="act-card-press" hover-stay-time="80" data-id="{{item._id}}" data-status="{{item._full ? 'full' : item.status}}" data-type="activity">
              <image class="act-img" src="{{item.image}}" mode="aspectFill"></image>
              <view class="act-info">
                <text class="act-t">{{item.title}}</text>
                <text class="act-d">{{item.date}} · {{item.location}}</text>
                <view class="act-b"><text class="act-p">¥{{item.price}}</text><text class="act-seat {{item._full ? 'is-full' : ''}}" wx:if="{{item._seat}}">{{item._seat}}</text></view>
              </view>
            </view>
          </block>
          <view class="empty-state" wx:if="{{activities.length === 0}}"><text>暂无活动安排</text></view>
        </view>
      </block>

      <!-- D: 我的预约（原预约历史） -->
      <block wx:if="{{currentTab == 3}}">
        <view class="booking-history-tabs">
          <view hover-class="tap-press-soft" hover-stay-time="80" class="history-tab-item {{bookingHistoryTab==0 ? 'active' : ''}}" bindtap="switchHistoryTab" data-idx="0">待参加</view>
          <view hover-class="tap-press-soft" hover-stay-time="80" class="history-tab-item {{bookingHistoryTab==1 ? 'active' : ''}}" bindtap="switchHistoryTab" data-idx="1">历史记录</view>
        </view>
        
        <!-- 待参加列表 -->
        <view class="booking-list" wx:if="{{bookingHistoryTab==0}}">
          <block wx:for="{{upcomingBookings}}" wx:key="_id">
            <view class="ticket-card" bindtap="goToBookingDetail" hover-class="ticket-card-press" hover-stay-time="80" data-id="{{item._id}}">
              <view class="ticket-left">
                <view class="hole-circle top"></view>
                <view class="hole-circle bottom"></view>
                <view class="dashed-line"></view>
                <text class="t-type">{{item.type === 'handcraft_course' ? '手作课' : (item.type==='special_activity'?'活动':'参观')}}</text>
              </view>
              <view class="ticket-right">
                <view class="tr-top">
                  <text class="tr-title">{{item.title}}</text>
                  <view class="tr-badge">NO.{{item._id_short}}</view>
                </view>
                <view class="tr-mid">
                  <view class="info-col">
                    <text class="lbl">日期</text>
                    <text class="val">{{item.month}} {{item.day}}</text>
                  </view>
                  <view class="info-col">
                    <text class="lbl">时段</text>
                    <text class="val highlight">{{item.time}}</text>
                  </view>
                  <view class="info-col">
                    <text class="lbl">人数</text>
                    <text class="val">{{item.people}}</text>
                  </view>
                </view>
                <view class="tr-bot">
                  <view class="btn-use">查看入馆券 ›</view>
                </view>
              </view>
            </view>
          </block>
          <view class="empty-state" wx:if="{{upcomingBookings.length === 0 && !loadingBookings}}">
            <text>暂无待参加行程</text>
          </view>
        </view>
        
        <!-- 历史记录列表 -->
        <view class="booking-list" wx:if="{{bookingHistoryTab==1}}">
          <block wx:for="{{historyBookings}}" wx:key="_id">
            <view class="history-card" bindtap="goToBookingDetail" hover-class="history-card-press" hover-stay-time="80" data-id="{{item._id}}">
              <view class="hc-left">
                <text class="hc-day">{{item.day}}</text>
                <text class="hc-month">{{item.month}}</text>
              </view>
              <view class="hc-mid">
                <text class="hc-title">{{item.title}}</text>
                <text class="hc-time">{{item.time}} · {{item.people}}人</text>
              </view>
              <view class="hc-right">
                <view class="stamp-used">已使用</view>
              </view>
            </view>
          </block>
          <view class="empty-state" wx:if="{{historyBookings.length === 0 && !loadingBookings}}">
            <text>暂无历史记录</text>
          </view>
        </view>
      </block>

      <!-- 🟢 公共部分：联系人信息 (Tab 0, 1, 2 显示，Tab 3不显示) -->
      <view class="common-form-area" wx:if="{{currentTab < 3}}">
        <view class="section-label"><text class="sl-en">CONTACT</text><text class="sl-cn">联系信息</text></view>
        <view class="input-group">
           <view class="input-row"><view class="input-icon"><image src="/assets/icons/user.png" mode="aspectFit" class="icon-gold"></image></view><input class="mini-input" placeholder="姓名" placeholder-class="ph" value="{{contactName}}" bindinput="onInput" data-field="contactName"/></view>
           <view class="input-row"><view class="input-icon"><image src="/assets/icons/phone.png" mode="aspectFit" class="icon-gold"></image></view><input class="mini-input" type="number" placeholder="手机号" placeholder-class="ph" value="{{contactPhone}}" bindinput="onInput" data-field="contactPhone"/></view>
        </view>
      </view>

    </view>
    <view class="booking-scroll-safe" aria-hidden="true"></view>
  </scroll-view>

  <!-- 3. 底部：悬浮操作栏 (仅Tab 0, 1, 2显示) -->
  <view class="fixed-footer safe-area" wx:if="{{currentTab < 3}}">
    <!-- 入店参观 -->
    <view class="submit-btn full-width" wx:if="{{currentTab == 0}}" bindtap="submitBooking" hover-class="submit-btn-press" hover-stay-time="80">
      <view class="btn-content"><text class="btn-main">免费预约 · 生成入馆券</text></view>
    </view>
    <!-- 手作课程 -->
    <view class="submit-btn full-width" wx:if="{{currentTab == 1}}" bindtap="submitActivityBooking" hover-class="submit-btn-press" hover-stay-time="80">
      <view class="btn-content"><text class="btn-main">预约课程</text></view>
    </view>
    <!-- 特别活动 -->
    <view class="submit-btn full-width" wx:if="{{currentTab == 2}}" bindtap="submitActivityBooking" hover-class="submit-btn-press" hover-stay-time="80">
      <view class="btn-content"><text class="btn-main">报名活动</text></view>
    </view>
  </view>

  <!-- 4. 门票铸造动画 -->
  <view class="ui-pop-mask is-deep is-toggle mint-modal {{showMintModal ? 'is-open active' : ''}}" catchtouchmove="true">
    <view class="mint-content">
      <view class="mint-machine">
        <view class="signal-light printer-light {{mintAnimation ? 'blink' : ''}}"></view>
        <view class="printer-slot"></view>
      </view>
      <view class="ticket-paper {{mintAnimation ? 'printing' : ''}}">
        <view class="tp-mini">
          <view class="tm-head">
             <text class="tm-title">山海造物 · 入馆券</text>
             <view class="tm-line"></view>
          </view>
          <view class="tm-invite">
            <text class="tm-label">INVITATION · 邀请函</text>
            <text class="tm-name">诚邀 {{contactName ? contactName + ' 先生/女士' : '贵宾'}}</text>
            <text class="tm-desc">欢迎预约到店，慢慢看、慢慢选。</text>
          </view>
          <view class="tm-code-box">
            <view class="tm-qr">
              <canvas type="2d" id="mintQrCanvas" class="mint-qr-canvas" style="width: 240rpx; height: 240rpx;"></canvas>
              <view class="scan-bar"></view>
            </view>
            <text class="tm-val">{{newTicketCode}}</text>
          </view>
          <view class="tm-foot">仅限本人使用</view>
        </view>
      </view>
      <view class="mint-bottom-area">
        <block wx:if="{{!mintFinished}}">
           <text class="mint-tip">正在打印您的专属通行证…</text>
           <view class="mint-progress"><view class="mp-bar"></view></view>
        </block>
        <view class="mint-actions {{mintFinished ? 'show' : ''}}">
          <view class="btn-check primary" bindtap="goToMyBookings" hover-class="btn-check-press" hover-stay-time="80">
             <text>查看凭证</text> <text class="arrow">→</text>
          </view>
          <view class="btn-group-sub">
             <view class="btn-sub-act" bindtap="closeMintModal" hover-class="btn-sub-act-press" hover-stay-time="80">继续预约</view>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal）；详见 utils/appModal.js -->
<app-modal id="appModal" />

<!-- 未绑手机号时原地注册（按需加载 feature 分包组件；未就绪时退回跳注册页）。协议默认不勾、「先不注册」只关弹层 -->
<register-auth-dialog
  id="regDialog"
  show="{{regDialogShow}}"
  from="booking"
  closable="{{true}}"
  close-text="先不注册"
  mask-closable="{{false}}"
  overline="BOOKING"
  title="授权手机号，继续预约"
  desc="预约提醒与到店通知需要手机号。未注册将同步建档，新客礼放入账户。"
  lead="授权后自动继续刚才的预约"
  cta="授权手机号 · 继续预约"
  login-title="确认手机号，继续预约"
  login-desc="该微信已完成注册，授权手机号即可继续预约。"
  login-cta="授权手机号 · 继续预约"
  bind:success="onRegDialogSuccess"
  bind:close="onRegDialogClose"
/>
