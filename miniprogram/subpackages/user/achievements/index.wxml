<!--pages/user/achievements/index.wxml-->
<view class="container">
  
  <view class="nav-bar" style="top: {{statusBarHeight}}px">
    <view class="back-btn" bindtap="goBack">←</view>
    <text class="page-title">我的成就 | ACHIEVEMENTS</text>
    <view class="share-btn" bindtap="shareAchievements">
      <text class="share-icon">📤</text>
    </view>
  </view>

  <scroll-view 
    scroll-y 
    class="content" 
    style="padding-top: {{statusBarHeight + 44}}px"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    refresher-background="transparent">
    
    <!-- 成就总览卡片 - 优化布局 -->
    <view class="overview-card">
      <view class="overview-bg-glow"></view>
      <view class="overview-bg-pattern"></view>
      <view class="overview-content">
        <!-- 顶部图标和标题 -->
        <view class="overview-header">
          <view class="overview-icon-wrapper">
            <view class="overview-icon-bg"></view>
            <view class="overview-icon">🏆</view>
            <view class="overview-icon-ring"></view>
          </view>
          <view class="overview-title">
            <text class="title-main">成就总览</text>
            <text class="title-sub">ACHIEVEMENT OVERVIEW</text>
          </view>
        </view>
        
        <!-- 统计数据 -->
        <view class="overview-stats">
          <view class="stat-item">
            <view class="stat-icon-wrapper">
              <text class="stat-icon">✓</text>
            </view>
            <text class="stat-val">{{achievementStats && achievementStats.unlocked || 0}}</text>
            <text class="stat-label">已解锁</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <view class="stat-icon-wrapper">
              <text class="stat-icon">📊</text>
            </view>
            <text class="stat-val">{{achievementStats && achievementStats.total || 0}}</text>
            <text class="stat-label">总成就</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <view class="stat-icon-wrapper">
              <text class="stat-icon">🎯</text>
            </view>
            <text class="stat-val">{{achievementStats && achievementStats.progress || 0}}%</text>
            <text class="stat-label">完成度</text>
          </view>
        </view>
        
        <!-- 进度条 -->
        <view class="overview-progress-wrapper">
          <view class="progress-header">
            <text class="progress-label">整体进度</text>
            <text class="progress-percent">{{achievementStats && achievementStats.progress || 0}}%</text>
          </view>
          <view class="overview-progress">
            <view class="progress-track">
              <view 
                class="progress-fill" 
                style="width: {{achievementStats && achievementStats.progress || 0}}%"
                data-progress="{{achievementStats && achievementStats.progress || 0}}">
                <view class="progress-shine"></view>
                <view class="progress-glow"></view>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 奖励信息 -->
        <view class="overview-reward">
          <view class="reward-icon-wrapper">
            <text class="reward-icon-main">🎁</text>
          </view>
          <view class="reward-content">
            <text class="reward-label">累计奖励</text>
            <text class="reward-value">{{achievementStats && achievementStats.totalRewards || 0}} 积分</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 成就分类列表 -->
    <view class="achievements-section" wx:for="{{achievementTypes}}" wx:key="type">
      <view class="section-header">
        <view class="section-icon">{{item.icon}}</view>
        <view class="section-title">
          <text class="title-cn">{{item.name}}</text>
          <text class="title-en">{{item.enName}}</text>
        </view>
        <view class="section-count">
          <text class="count-unlocked">{{item.unlockedCount}}</text>
          <text class="count-separator">/</text>
          <text class="count-total">{{item.totalCount}}</text>
        </view>
      </view>

      <view class="achievements-grid">
        <view 
          class="achievement-item {{achievement.unlocked ? 'unlocked' : 'locked'}}" 
          wx:for="{{item.achievements}}" 
          wx:key="id"
          wx:for-item="achievement"
          bindtap="viewAchievement"
          data-achievement="{{achievement}}">
          
          <view class="achievement-bg-glow" wx:if="{{achievement.unlocked}}"></view>
          <view class="achievement-bg-pattern"></view>
          
          <!-- 状态角标 -->
          <view class="achievement-status">
            <view class="status-badge unlocked" wx:if="{{achievement.unlocked}}">
              <text class="status-icon">✓</text>
            </view>
            <view class="status-badge locked" wx:else>
              <text class="status-icon">🔒</text>
            </view>
          </view>
          
          <!-- 图标区域 -->
          <view class="achievement-icon-wrapper">
            <view class="achievement-icon-bg"></view>
            <text class="achievement-icon">{{achievement.icon}}</text>
            <view class="achievement-icon-ring" wx:if="{{achievement.unlocked}}"></view>
            <view class="achievement-icon-shine" wx:if="{{achievement.unlocked}}"></view>
          </view>
          
          <!-- 信息区域 -->
          <view class="achievement-info">
            <text class="achievement-name">{{achievement.name}}</text>
            <text class="achievement-desc">{{achievement.desc}}</text>
            
            <!-- 未解锁：显示进度 -->
            <view class="achievement-progress" wx:if="{{!achievement.unlocked}}">
              <view class="progress-header-mini">
                <text class="progress-label-mini">进度</text>
                <text class="progress-percent-mini">{{achievement.progressPercent}}%</text>
              </view>
              <view class="progress-bar-mini">
                <view class="progress-fill-mini" style="width: {{achievement.progressPercent}}%">
                  <view class="progress-shine-mini"></view>
                </view>
              </view>
              <text class="progress-text">{{achievement.progress}} / {{achievement.threshold}}</text>
            </view>
            
            <!-- 已解锁：显示奖励 -->
            <view class="achievement-reward" wx:if="{{achievement.unlocked}}">
              <view class="reward-badge">
                <text class="reward-icon">🎁</text>
                <text class="reward-text">+{{achievement.reward.points}} 积分</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 骨架屏加载 -->
    <view class="skeleton-container" wx:if="{{loading && achievementTypes.length === 0}}">
      <view class="skeleton-card">
        <view class="skeleton-header">
          <view class="skeleton-icon"></view>
          <view class="skeleton-title">
            <view class="skeleton-line long"></view>
            <view class="skeleton-line short"></view>
          </view>
        </view>
        <view class="skeleton-stats">
          <view class="skeleton-stat" wx:for="{{3}}" wx:key="index"></view>
        </view>
        <view class="skeleton-progress"></view>
      </view>
      <view class="skeleton-section" wx:for="{{2}}" wx:key="index">
        <view class="skeleton-section-header"></view>
        <view class="skeleton-grid">
          <view class="skeleton-item" wx:for="{{3}}" wx:key="item" wx:for-item="item"></view>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && achievementTypes.length === 0 && !refreshing}}">
      <text class="empty-icon">⚠️</text>
      <text class="empty-text">暂无成就数据</text>
      <view class="retry-btn" bindtap="onRetry">重试</view>
    </view>

  </scroll-view>

  <!-- 成就详情弹窗 -->
  <view class="achievement-modal {{showModal ? 'show' : ''}}" wx:if="{{selectedAchievement}}" catchtap="closeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-close" bindtap="closeModal">×</view>
      <view class="modal-icon-wrapper">
        <view class="modal-icon-bg"></view>
        <text class="modal-icon">{{selectedAchievement.icon}}</text>
        <view class="modal-icon-ring" wx:if="{{selectedAchievement.unlocked}}"></view>
      </view>
      <view class="modal-title">{{selectedAchievement.name}}</view>
      <view class="modal-desc">{{selectedAchievement.desc}}</view>
      
      <view class="modal-info">
        <view class="modal-info-item" wx:if="{{!selectedAchievement.unlocked}}">
          <text class="info-label">当前进度</text>
          <text class="info-value">{{selectedAchievement.progress}} / {{selectedAchievement.threshold}}</text>
        </view>
        <view class="modal-progress" wx:if="{{!selectedAchievement.unlocked}}">
          <view class="modal-progress-track">
            <view class="modal-progress-fill" style="width: {{selectedAchievement.progressPercent}}%">
              <view class="modal-progress-shine"></view>
            </view>
          </view>
        </view>
        <view class="modal-info-item" wx:if="{{selectedAchievement.unlocked}}">
          <text class="info-label">奖励</text>
          <view class="info-reward">
            <text class="reward-icon">🎁</text>
            <text class="reward-value">+{{selectedAchievement.reward.points}} 积分</text>
          </view>
        </view>
      </view>
      
      <view class="modal-status" wx:if="{{selectedAchievement.unlocked}}">
        <text class="status-text">✓ 已解锁</text>
      </view>
      <view class="modal-status locked" wx:else>
        <text class="status-text">🔒 未解锁</text>
      </view>
      
      <!-- 分享按钮 -->
      <view class="modal-actions" wx:if="{{selectedAchievement.unlocked}}">
        <view class="modal-share-btn" bindtap="shareSingleAchievement">
          <text class="share-icon-small">📤</text>
          <text class="share-text">分享成就</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 成就解锁动画 -->
  <view class="unlock-animation {{showUnlockAnimation ? 'show' : ''}}" wx:if="{{unlockedAchievement}}">
    <view class="unlock-content">
      <view class="unlock-icon-wrapper">
        <view class="unlock-icon-bg"></view>
        <text class="unlock-icon">{{unlockedAchievement.icon}}</text>
        <view class="unlock-icon-ring"></view>
        <view class="unlock-sparkles">
          <view class="sparkle sparkle-1">✨</view>
          <view class="sparkle sparkle-2">⭐</view>
          <view class="sparkle sparkle-3">💫</view>
          <view class="sparkle sparkle-4">🌟</view>
        </view>
      </view>
      <view class="unlock-title">成就解锁！</view>
      <view class="unlock-name">{{unlockedAchievement.name}}</view>
      <view class="unlock-reward">
        <text class="reward-label">获得奖励：</text>
        <text class="reward-value">+{{unlockedAchievement.reward.points}} 积分</text>
      </view>
      <view class="unlock-actions">
        <view class="unlock-btn" bindtap="closeUnlockAnimation">知道了</view>
        <view class="unlock-btn share" bindtap="shareUnlockedAchievement">分享</view>
      </view>
    </view>
  </view>
</view>