/* 成就解锁动画 */
.unlock-animation {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(30px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.unlock-animation.show {
  opacity: 1;
  visibility: visible;
}

.unlock-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 50rpx;
  background: 
    radial-gradient(circle at 30% 30%, rgba(196, 167, 108,0.5) 0%, rgba(196, 167, 108,0.3) 30%, transparent 60%),
    radial-gradient(circle at 70% 70%, rgba(196, 167, 108,0.4) 0%, rgba(196, 167, 108,0.2) 30%, transparent 60%),
    linear-gradient(135deg, 
      rgba(0,0,0,0.98) 0%, 
      rgba(5,5,5,0.96) 20%,
      rgba(10,10,10,0.94) 40%,
      rgba(15,15,15,0.92) 50%, 
      rgba(10,10,10,0.94) 60%,
      rgba(5,5,5,0.96) 80%,
      rgba(0,0,0,0.98) 100%);
  border: 4px solid rgba(196, 167, 108,0.8);
  border-radius: 50rpx;
  box-shadow: 
    0 80rpx 200rpx rgba(0,0,0,0.95),
    0 40rpx 100rpx rgba(0,0,0,0.9),
    0 0 200rpx rgba(196, 167, 108,0.6),
    0 0 100rpx rgba(196, 167, 108,0.5),
    0 0 50rpx rgba(196, 167, 108,0.4),
    inset 0 6rpx 12rpx rgba(255,255,255,0.25),
    inset 0 0 200rpx rgba(196, 167, 108,0.25);
  backdrop-filter: blur(40px);
  transform: scale(0.8) translateY(60rpx);
  transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: unlock-bounce 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s;
}

.unlock-animation.show .unlock-content {
  transform: scale(1) translateY(0);
}

@keyframes unlock-bounce {
  0% {
    transform: scale(0.8) translateY(60rpx);
    opacity: 0;
  }
  50% {
    transform: scale(1.05) translateY(-10rpx);
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

.unlock-icon-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.unlock-icon-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.6) 0%, rgba(196, 167, 108,0.4) 50%, transparent 100%);
  border-radius: 50%;
  filter: blur(40rpx);
  animation: unlock-glow-pulse 2s ease-in-out infinite;
}

@keyframes unlock-glow-pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.2);
    opacity: 1;
  }
}

.unlock-icon {
  position: relative;
  z-index: 1;
  font-size: 140rpx;
  filter: drop-shadow(0 0 60rpx rgba(196, 167, 108,0.8));
  animation: unlock-icon-bounce 1s ease-in-out infinite;
}

@keyframes unlock-icon-bounce {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20rpx) scale(1.1);
  }
}

.unlock-icon-ring {
  position: absolute;
  top: -30rpx;
  left: -30rpx;
  width: calc(100% + 60rpx);
  height: calc(100% + 60rpx);
  border: 4px solid rgba(196, 167, 108,0.7);
  border-radius: 50%;
  box-shadow: 
    0 0 80rpx rgba(196, 167, 108,0.7),
    inset 0 0 80rpx rgba(196, 167, 108,0.3);
  animation: unlock-ring-rotate 3s linear infinite;
  z-index: 0;
}

@keyframes unlock-ring-rotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.unlock-sparkles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.sparkle {
  position: absolute;
  font-size: 40rpx;
  animation: sparkle-float 2s ease-in-out infinite;
}

.sparkle-1 {
  top: 10%;
  left: 20%;
  animation-delay: 0s;
}

.sparkle-2 {
  top: 20%;
  right: 15%;
  animation-delay: 0.5s;
}

.sparkle-3 {
  bottom: 15%;
  left: 25%;
  animation-delay: 1s;
}

.sparkle-4 {
  bottom: 10%;
  right: 20%;
  animation-delay: 1.5s;
}

@keyframes sparkle-float {
  0%, 100% {
    transform: translate(0, 0) scale(0.8);
    opacity: 0.6;
  }
  50% {
    transform: translate(20rpx, -30rpx) scale(1.2);
    opacity: 1;
  }
}

