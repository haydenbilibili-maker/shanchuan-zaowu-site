/* pages/user/achievements/index.wxss - 极致黑金质感优化版 */
.container {
  min-height: 100vh;
  background: 
    radial-gradient(circle at 15% 25%, rgba(196, 167, 108,0.08) 0%, transparent 45%),
    radial-gradient(circle at 85% 75%, rgba(196, 167, 108,0.05) 0%, transparent 45%),
    radial-gradient(circle at 50% 50%, rgba(196, 167, 108,0.03) 0%, transparent 60%),
    linear-gradient(180deg, #030303 0%, #1A1814 20%, #1A1814 40%, #0f0f0f 60%, #1A1814 80%, #1A1814 100%);
  position: relative;
  overflow-x: hidden;
}

/* 背景动态光效 */
.container::before {
  content: '';
  position: fixed;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.06) 0%, transparent 60%),
    linear-gradient(
      135deg,
      transparent 40%,
      rgba(255,255,255,0.02) 45%,
      rgba(196, 167, 108,0.05) 50%,
      rgba(255,255,255,0.02) 55%,
      transparent 60%
    );
  animation: bg-shine-rotate 20s linear infinite;
  z-index: 0;
  pointer-events: none;
  filter: blur(60rpx);
}

@keyframes bg-shine-rotate {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

/* 导航栏 - 增强质感 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  background: 
    linear-gradient(180deg, rgba(0,0,0,0.98) 0%, rgba(0,0,0,0.95) 100%),
    radial-gradient(circle at 50% 0%, rgba(196, 167, 108,0.1) 0%, transparent 70%);
  backdrop-filter: blur(20px);
  border-bottom: 1.5px solid rgba(196, 167, 108,0.25);
  z-index: 100;
  box-shadow: 
    0 4rpx 16rpx rgba(0,0,0,0.6),
    0 0 30rpx rgba(196, 167, 108,0.1);
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255,255,255,0.9);
  margin-right: 20rpx;
  background: 
    radial-gradient(circle, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.4) 100%),
    linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  border-radius: 50%;
  border: 1.5px solid rgba(196, 167, 108,0.3);
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.5),
    0 0 16rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.back-btn:active {
  transform: scale(0.9);
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.3) 0%, rgba(196, 167, 108,0.15) 100%);
  border-color: rgba(196, 167, 108,0.5);
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.6),
    0 0 24rpx rgba(196, 167, 108,0.4);
}

.page-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 3rpx;
  text-shadow: 
    0 2rpx 12rpx rgba(0,0,0,0.8),
    0 0 24rpx rgba(196, 167, 108,0.3);
  flex: 1;
}

.share-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: 
    radial-gradient(circle, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.4) 100%),
    linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  border-radius: 50%;
  border: 1.5px solid rgba(196, 167, 108,0.3);
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.5),
    0 0 16rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  margin-left: 20rpx;
}

.share-btn:active {
  transform: scale(0.9);
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.3) 0%, rgba(196, 167, 108,0.15) 100%);
  border-color: rgba(196, 167, 108,0.5);
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.6),
    0 0 24rpx rgba(196, 167, 108,0.4);
}

.share-icon {
  font-size: 32rpx;
  filter: drop-shadow(0 0 8rpx rgba(196, 167, 108,0.4));
}

.content {
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
}

/* 成就总览卡片 - 极致黑金质感 */
.overview-card {
  position: relative;
  background: 
    radial-gradient(circle at 20% 20%, rgba(196, 167, 108,0.35) 0%, rgba(196, 167, 108,0.2) 30%, transparent 55%),
    radial-gradient(circle at 80% 80%, rgba(196, 167, 108,0.25) 0%, rgba(196, 167, 108,0.15) 30%, transparent 55%),
    radial-gradient(circle at 50% 50%, rgba(196, 167, 108,0.12) 0%, transparent 65%),
    linear-gradient(135deg, 
      rgba(0,0,0,0.99) 0%, 
      rgba(5,5,5,0.97) 15%,
      rgba(10,10,10,0.95) 30%,
      rgba(15,15,15,0.93) 45%,
      rgba(20,20,20,0.92) 50%,
      rgba(15,15,15,0.93) 55%,
      rgba(10,10,10,0.95) 70%,
      rgba(5,5,5,0.97) 85%,
      rgba(0,0,0,0.99) 100%);
  border: 3.5px solid rgba(196, 167, 108,0.6);
  border-radius: 40rpx;
  padding: 56rpx 44rpx;
  margin-bottom: 50rpx;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 
    0 50rpx 120rpx rgba(0,0,0,0.95),
    0 20rpx 60rpx rgba(0,0,0,0.9),
    0 8rpx 28rpx rgba(0,0,0,0.8),
    0 2rpx 12rpx rgba(0,0,0,0.7),
    0 0 120rpx rgba(196, 167, 108,0.4),
    0 0 60rpx rgba(196, 167, 108,0.3),
    0 0 30rpx rgba(196, 167, 108,0.25),
    0 0 15rpx rgba(196, 167, 108,0.2),
    inset 0 4rpx 8rpx rgba(255,255,255,0.2),
    inset 0 0 140rpx rgba(196, 167, 108,0.18),
    inset 0 -3rpx 6rpx rgba(196, 167, 108,0.12);
  backdrop-filter: blur(25px);
}

.overview-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 35%),
    linear-gradient(225deg, rgba(196, 167, 108,0.12) 0%, transparent 45%),
    linear-gradient(45deg, transparent 0%, rgba(196, 167, 108,0.05) 50%, transparent 100%);
  z-index: 0;
  pointer-events: none;
  mix-blend-mode: overlay;
  opacity: 0.8;
}

.overview-bg-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.4) 0%, rgba(196, 167, 108,0.3) 25%, rgba(196, 167, 108,0.2) 40%, transparent 70%),
    radial-gradient(circle at 70% 30%, rgba(196, 167, 108,0.3) 0%, rgba(196, 167, 108,0.2) 30%, transparent 50%),
    radial-gradient(circle at 30% 70%, rgba(196, 167, 108,0.2) 0%, transparent 40%);
  animation: overview-glow-pulse 6s ease-in-out infinite;
  z-index: 0;
  pointer-events: none;
  filter: blur(60rpx);
}

.overview-bg-pattern {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.12;
  background-image: 
    radial-gradient(rgba(196, 167, 108,0.5) 2px, transparent 2px),
    radial-gradient(rgba(196, 167, 108,0.4) 1.5px, transparent 1.5px),
    radial-gradient(rgba(196, 167, 108,0.3) 1px, transparent 1px),
    linear-gradient(45deg, transparent 48%, rgba(196, 167, 108,0.08) 50%, transparent 52%);
  background-size: 60rpx 60rpx, 40rpx 40rpx, 25rpx 25rpx, 30rpx 30rpx;
  background-position: 0 0, 30rpx 30rpx, 15rpx 15rpx, 0 0;
  z-index: 0;
  pointer-events: none;
  filter: blur(0.8px);
}

@keyframes overview-glow-pulse {
  0%, 100% { 
    opacity: 0.7; 
    transform: scale(1) translate(0, 0); 
  }
  50% { 
    opacity: 1; 
    transform: scale(1.2) translate(5%, 5%); 
  }
}

.overview-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 顶部标题区域 */
.overview-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.overview-icon-wrapper {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.overview-icon-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.5) 0%, rgba(196, 167, 108,0.35) 40%, rgba(196, 167, 108,0.2) 60%, transparent 100%);
  border-radius: 50%;
  filter: blur(30rpx);
  animation: icon-bg-pulse 3.5s ease-in-out infinite;
  box-shadow: 
    0 0 60rpx rgba(196, 167, 108,0.6),
    0 0 100rpx rgba(196, 167, 108,0.4);
}

@keyframes icon-bg-pulse {
  0%, 100% { opacity: 0.8; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}

.overview-icon {
  position: relative;
  z-index: 1;
  font-size: 96rpx;
  filter: drop-shadow(0 0 50rpx rgba(196, 167, 108,0.8)) drop-shadow(0 0 80rpx rgba(196, 167, 108,0.5));
  animation: icon-float 4.5s ease-in-out infinite;
  text-shadow: 0 0 60rpx rgba(196, 167, 108,0.6);
}

.overview-icon-ring {
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  width: calc(100% + 32rpx);
  height: calc(100% + 32rpx);
  border: 3px solid rgba(196, 167, 108,0.6);
  border-radius: 50%;
  box-shadow: 
    0 0 50rpx rgba(196, 167, 108,0.6),
    0 0 80rpx rgba(196, 167, 108,0.4),
    inset 0 0 50rpx rgba(196, 167, 108,0.25);
  animation: icon-ring-rotate 12s linear infinite;
  z-index: 0;
}

.overview-icon-ring::before {
  content: '';
  position: absolute;
  top: -3px;
  left: -3px;
  width: calc(100% + 6px);
  height: calc(100% + 6px);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50%;
  box-shadow: 
    0 0 30rpx rgba(255,255,255,0.3),
    inset 0 0 30rpx rgba(255,255,255,0.1);
}

@keyframes icon-ring-rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes icon-float {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-12rpx) scale(1.05); }
}

.overview-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.title-main {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
  font-family: 'Times New Roman', serif;
  letter-spacing: 3rpx;
  text-shadow: 
    0 2rpx 12rpx rgba(0,0,0,0.8),
    0 0 24rpx rgba(196, 167, 108,0.4);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.title-sub {
  font-family: 'DIN';
  font-size: 20rpx;
  color: var(--gold);
  letter-spacing: 5rpx;
  text-transform: uppercase;
  text-shadow: 0 0 16rpx rgba(196, 167, 108,0.5);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 统计数据 - 极致优化 */
.overview-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  padding: 36rpx 20rpx;
  background: 
    radial-gradient(circle at 30% 50%, rgba(196, 167, 108,0.15) 0%, transparent 50%),
    linear-gradient(135deg, 
      rgba(0,0,0,0.6) 0%, 
      rgba(10,10,10,0.5) 30%,
      rgba(20,20,20,0.45) 50%, 
      rgba(15,15,15,0.5) 70%,
      rgba(0,0,0,0.6) 100%);
  border-radius: 28rpx;
  border: 2px solid rgba(196, 167, 108,0.3);
  box-shadow: 
    0 8rpx 24rpx rgba(0,0,0,0.6),
    0 0 40rpx rgba(196, 167, 108,0.2),
    0 0 20rpx rgba(196, 167, 108,0.15),
    inset 0 3rpx 6rpx rgba(0,0,0,0.6),
    inset 0 0 50rpx rgba(196, 167, 108,0.08);
  backdrop-filter: blur(12px);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.overview-stats::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 40%),
    linear-gradient(225deg, rgba(196, 167, 108,0.1) 0%, transparent 50%);
  z-index: 0;
  pointer-events: none;
  mix-blend-mode: overlay;
  opacity: 0.7;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  padding: 0 8rpx;
  position: relative;
  z-index: 1;
  min-width: 0;
  box-sizing: border-box;
}

.stat-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.3) 0%, rgba(196, 167, 108,0.2) 40%, rgba(196, 167, 108,0.1) 60%, transparent 100%);
  border-radius: 50%;
  border: 2px solid rgba(196, 167, 108,0.4);
  box-shadow: 
    0 6rpx 16rpx rgba(0,0,0,0.5),
    0 0 30rpx rgba(196, 167, 108,0.3),
    0 0 15rpx rgba(196, 167, 108,0.2),
    inset 0 2rpx 4rpx rgba(255,255,255,0.15),
    inset 0 0 30rpx rgba(196, 167, 108,0.1);
  position: relative;
}

.stat-icon-wrapper::before {
  content: '';
  position: absolute;
  top: -2px;
  left: -2px;
  width: calc(100% + 4px);
  height: calc(100% + 4px);
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.3), transparent, rgba(196, 167, 108,0.3));
  z-index: -1;
  animation: icon-wrapper-glow 3s ease-in-out infinite;
}

@keyframes icon-wrapper-glow {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.stat-icon {
  font-size: 32rpx;
  filter: drop-shadow(0 0 16rpx rgba(196, 167, 108,0.5)) drop-shadow(0 0 24rpx rgba(196, 167, 108,0.3));
  position: relative;
  z-index: 1;
}

.stat-val {
  font-family: 'DIN';
  font-size: 56rpx;
  font-weight: 900;
  color: var(--gold);
  text-shadow: 
    0 0 35rpx rgba(196, 167, 108,0.8),
    0 0 20rpx rgba(196, 167, 108,0.6),
    0 2rpx 12rpx rgba(0,0,0,0.9);
  line-height: 1;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 1.5rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

.stat-divider {
  width: 2px;
  height: 90rpx;
  background: linear-gradient(
    to bottom, 
    transparent 0%,
    rgba(196, 167, 108,0.5) 15%,
    rgba(196, 167, 108,0.7) 30%,
    rgba(196, 167, 108,0.8) 50%,
    rgba(196, 167, 108,0.7) 70%,
    rgba(196, 167, 108,0.5) 85%,
    transparent 100%
  );
  box-shadow: 
    0 0 16rpx rgba(196, 167, 108,0.4),
    0 0 8rpx rgba(196, 167, 108,0.3);
  border-radius: 1px;
}

/* 进度条区域 - 优化 */
.overview-progress-wrapper {
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
  gap: 16rpx;
}

.progress-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 700;
  letter-spacing: 1.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.progress-percent {
  font-family: 'DIN';
  font-size: 36rpx;
  font-weight: 900;
  color: var(--gold);
  text-shadow: 0 0 20rpx rgba(196, 167, 108,0.6);
  letter-spacing: 2rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.overview-progress {
  width: 100%;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  background: 
    linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(20,20,20,0.5) 50%, rgba(0,0,0,0.7) 100%);
  border-radius: 7rpx;
  overflow: hidden;
  border: 2px solid rgba(196, 167, 108,0.35);
  box-shadow: 
    inset 0 3rpx 6rpx rgba(0,0,0,0.6),
    0 0 30rpx rgba(196, 167, 108,0.25);
  box-sizing: border-box;
}

.progress-fill {
  position: relative;
  height: 100%;
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108,0.95) 0%,
    var(--gold) 30%,
    rgba(255,255,255,0.9) 50%,
    var(--gold) 70%,
    rgba(196, 167, 108,0.95) 100%
  );
  background-size: 300% 100%;
  border-radius: 7rpx;
  box-shadow: 
    0 0 30rpx rgba(196, 167, 108,0.7),
    inset 0 2rpx 4rpx rgba(255,255,255,0.4);
  transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1);
  animation: progress-shine 3s linear infinite;
  overflow: hidden;
}

@keyframes progress-shine {
  0% { background-position: 0% 50%; }
  100% { background-position: 300% 50%; }
}

.progress-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255,255,255,0.5) 50%,
    transparent 100%
  );
  animation: progress-shine-sweep 2.5s ease-in-out infinite;
}

.progress-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(196, 167, 108,0.4) 0%, transparent 70%);
  animation: progress-glow-pulse 2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes progress-glow-pulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}

@keyframes progress-shine-sweep {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* 奖励信息 - 极致优化 */
.overview-reward {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 36rpx;
  background: 
    radial-gradient(circle at 30% 50%, rgba(196, 167, 108,0.3) 0%, rgba(196, 167, 108,0.2) 30%, transparent 60%),
    radial-gradient(circle at 70% 50%, rgba(196, 167, 108,0.2) 0%, transparent 50%),
    linear-gradient(135deg, 
      rgba(196, 167, 108,0.25) 0%, 
      rgba(196, 167, 108,0.2) 25%,
      rgba(196, 167, 108,0.18) 50%, 
      rgba(196, 167, 108,0.2) 75%,
      rgba(196, 167, 108,0.25) 100%);
  border: 2.5px solid rgba(196, 167, 108,0.6);
  border-radius: 28rpx;
  box-shadow: 
    0 8rpx 28rpx rgba(0,0,0,0.6),
    0 4rpx 16rpx rgba(0,0,0,0.5),
    0 0 40rpx rgba(196, 167, 108,0.5),
    0 0 20rpx rgba(196, 167, 108,0.4),
    0 0 10rpx rgba(196, 167, 108,0.3),
    inset 0 3rpx 6rpx rgba(255,255,255,0.2),
    inset 0 0 50rpx rgba(196, 167, 108,0.15),
    inset 0 -2rpx 4rpx rgba(196, 167, 108,0.1);
  backdrop-filter: blur(12px);
  position: relative;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.overview-reward::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 35%),
    linear-gradient(225deg, rgba(196, 167, 108,0.15) 0%, transparent 45%);
  z-index: 0;
  pointer-events: none;
  mix-blend-mode: overlay;
  opacity: 0.8;
}

.reward-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.4) 0%, rgba(196, 167, 108,0.3) 40%, rgba(196, 167, 108,0.2) 60%, transparent 100%);
  border-radius: 50%;
  border: 2.5px solid rgba(196, 167, 108,0.6);
  box-shadow: 
    0 6rpx 16rpx rgba(0,0,0,0.5),
    0 0 32rpx rgba(196, 167, 108,0.5),
    0 0 16rpx rgba(196, 167, 108,0.4),
    inset 0 2rpx 4rpx rgba(255,255,255,0.25),
    inset 0 0 40rpx rgba(196, 167, 108,0.15);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  animation: reward-icon-pulse 2.5s ease-in-out infinite;
}

@keyframes reward-icon-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.reward-icon-main {
  font-size: 36rpx;
  filter: drop-shadow(0 0 16rpx rgba(196, 167, 108,0.6));
}

.reward-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  position: relative;
  z-index: 1;
}

.reward-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 1.5rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.reward-value {
  font-family: 'DIN';
  font-size: 36rpx;
  font-weight: 900;
  color: var(--gold);
  text-shadow: 
    0 0 24rpx rgba(196, 167, 108,0.6),
    0 2rpx 8rpx rgba(0,0,0,0.8);
  letter-spacing: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 成就分类区域 - 极致优化 */
.achievements-section {
  margin-bottom: 70rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  padding: 24rpx 0;
  padding-bottom: 28rpx;
  border-bottom: 3px solid rgba(196, 167, 108,0.3);
  position: relative;
  background: 
    linear-gradient(135deg, rgba(0,0,0,0.3) 0%, rgba(10,10,10,0.2) 100%);
  border-radius: 20rpx 20rpx 0 0;
  padding-left: 24rpx;
  padding-right: 24rpx;
  margin-left: -24rpx;
  margin-right: -24rpx;
  width: calc(100% + 48rpx);
  box-sizing: border-box;
  min-width: 0;
}

.section-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(135deg, rgba(255,255,255,0.02) 0%, transparent 40%),
    linear-gradient(225deg, rgba(196, 167, 108,0.08) 0%, transparent 50%);
  z-index: 0;
  pointer-events: none;
  mix-blend-mode: overlay;
  opacity: 0.7;
  border-radius: 20rpx 20rpx 0 0;
}

.section-header::after {
  content: '';
  position: absolute;
  bottom: -3px;
  left: 24rpx;
  width: 140rpx;
  height: 3px;
  background: linear-gradient(
    90deg, 
    var(--gold) 0%,
    rgba(196, 167, 108,0.8) 30%,
    rgba(196, 167, 108,0.6) 70%,
    transparent 100%
  );
  box-shadow: 
    0 0 24rpx rgba(196, 167, 108,0.7),
    0 0 48rpx rgba(196, 167, 108,0.4);
  border-radius: 2px;
}

.section-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 0 20rpx rgba(196, 167, 108,0.6)) drop-shadow(0 0 30rpx rgba(196, 167, 108,0.4));
  animation: section-icon-pulse 3.5s ease-in-out infinite;
  position: relative;
  z-index: 1;
}

@keyframes section-icon-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.section-title {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
  position: relative;
  z-index: 1;
}

.title-cn {
  font-size: 34rpx;
  font-weight: 900;
  color: #fff;
  font-family: 'Times New Roman', serif;
  letter-spacing: 2.5rpx;
  text-shadow: 
    0 2rpx 10rpx rgba(0,0,0,0.8),
    0 0 20rpx rgba(196, 167, 108,0.3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.title-en {
  font-family: 'DIN';
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 5rpx;
  text-transform: uppercase;
  text-shadow: 0 0 16rpx rgba(196, 167, 108,0.5);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.section-count {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: 
    radial-gradient(circle at 30% 50%, rgba(196, 167, 108,0.2) 0%, transparent 50%),
    linear-gradient(135deg, rgba(196, 167, 108,0.18), rgba(196, 167, 108,0.12));
  border: 2px solid rgba(196, 167, 108,0.4);
  border-radius: 20rpx;
  box-shadow: 
    0 6rpx 16rpx rgba(0,0,0,0.5),
    0 0 28rpx rgba(196, 167, 108,0.3),
    0 0 14rpx rgba(196, 167, 108,0.2),
    inset 0 2rpx 4rpx rgba(255,255,255,0.15),
    inset 0 0 30rpx rgba(196, 167, 108,0.1);
  position: relative;
  z-index: 1;
}

.count-unlocked {
  font-family: 'DIN';
  font-size: 36rpx;
  font-weight: 900;
  color: var(--gold);
  text-shadow: 0 0 20rpx rgba(196, 167, 108,0.6);
  white-space: nowrap;
  flex-shrink: 0;
}

.count-separator {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  white-space: nowrap;
  flex-shrink: 0;
}

.count-total {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  white-space: nowrap;
  flex-shrink: 0;
}

/* 成就网格 - 极致优化 */
.achievements-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx;
  padding: 0 4rpx;
}

/* 成就卡片 - 极致黑金质感 */
.achievement-item {
  position: relative;
  background: 
    radial-gradient(circle at 20% 50%, rgba(196, 167, 108,0.15) 0%, rgba(196, 167, 108,0.08) 30%, transparent 50%),
    radial-gradient(circle at 80% 50%, rgba(196, 167, 108,0.1) 0%, rgba(196, 167, 108,0.05) 30%, transparent 50%),
    radial-gradient(circle at 50% 50%, rgba(196, 167, 108,0.05) 0%, transparent 60%),
    linear-gradient(135deg, 
      rgba(0,0,0,0.95) 0%, 
      rgba(5,5,5,0.92) 20%,
      rgba(10,10,10,0.9) 35%,
      rgba(15,15,15,0.88) 50%, 
      rgba(10,10,10,0.9) 65%,
      rgba(5,5,5,0.92) 80%,
      rgba(0,0,0,0.95) 100%);
  border: 3px solid rgba(196, 167, 108,0.35);
  border-radius: 32rpx;
  padding: 40rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  backdrop-filter: blur(18px);
  box-shadow: 
    0 20rpx 60rpx rgba(0,0,0,0.8),
    0 8rpx 28rpx rgba(0,0,0,0.7),
    0 4rpx 12rpx rgba(0,0,0,0.6),
    0 0 60rpx rgba(196, 167, 108,0.2),
    0 0 30rpx rgba(196, 167, 108,0.15),
    0 0 15rpx rgba(196, 167, 108,0.1),
    inset 0 3rpx 6rpx rgba(255,255,255,0.12),
    inset 0 0 70rpx rgba(196, 167, 108,0.1),
    inset 0 -2rpx 4rpx rgba(196, 167, 108,0.06);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.achievement-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(135deg, rgba(255,255,255,0.03) 0%, transparent 40%),
    linear-gradient(225deg, rgba(196, 167, 108,0.08) 0%, transparent 50%);
  z-index: 0;
  pointer-events: none;
  mix-blend-mode: overlay;
  opacity: 0.7;
}

.achievement-item.unlocked {
  border-color: rgba(196, 167, 108,0.7);
  background: 
    radial-gradient(circle at 25% 50%, rgba(196, 167, 108,0.35) 0%, rgba(196, 167, 108,0.25) 35%, rgba(196, 167, 108,0.15) 50%, transparent 65%),
    radial-gradient(circle at 75% 50%, rgba(196, 167, 108,0.3) 0%, rgba(196, 167, 108,0.2) 35%, transparent 55%),
    radial-gradient(circle at 50% 50%, rgba(196, 167, 108,0.15) 0%, transparent 60%),
    linear-gradient(135deg, 
      rgba(196, 167, 108,0.22) 0%, 
      rgba(196, 167, 108,0.2) 20%,
      rgba(196, 167, 108,0.18) 40%,
      rgba(196, 167, 108,0.16) 50%, 
      rgba(196, 167, 108,0.18) 60%,
      rgba(196, 167, 108,0.2) 80%,
      rgba(196, 167, 108,0.22) 100%);
  box-shadow: 
    0 24rpx 72rpx rgba(0,0,0,0.85),
    0 12rpx 36rpx rgba(0,0,0,0.75),
    0 6rpx 16rpx rgba(0,0,0,0.7),
    0 0 100rpx rgba(196, 167, 108,0.5),
    0 0 50rpx rgba(196, 167, 108,0.4),
    0 0 25rpx rgba(196, 167, 108,0.3),
    0 0 12rpx rgba(196, 167, 108,0.25),
    inset 0 4rpx 8rpx rgba(255,255,255,0.2),
    inset 0 0 100rpx rgba(196, 167, 108,0.18),
    inset 0 -3rpx 6rpx rgba(196, 167, 108,0.12);
}

.achievement-item.locked {
  opacity: 0.6;
  filter: grayscale(0.6) brightness(0.7);
  border-color: rgba(196, 167, 108,0.12);
  background: 
    linear-gradient(135deg, 
      rgba(0,0,0,0.95) 0%, 
      rgba(5,5,5,0.92) 20%,
      rgba(10,10,10,0.9) 35%,
      rgba(15,15,15,0.88) 50%, 
      rgba(10,10,10,0.9) 65%,
      rgba(5,5,5,0.92) 80%,
      rgba(0,0,0,0.95) 100%);
}

.achievement-item:active {
  transform: scale(0.97) translateY(-2rpx);
}

.achievement-bg-glow {
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(196, 167, 108,0.25) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
  animation: achievement-glow-pulse 3.5s ease-in-out infinite;
  filter: blur(30rpx);
}

.achievement-bg-pattern {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.08;
  background-image: 
    radial-gradient(rgba(196, 167, 108,0.4) 1.5px, transparent 1.5px),
    linear-gradient(45deg, transparent 48%, rgba(196, 167, 108,0.1) 50%, transparent 52%);
  background-size: 28rpx 28rpx, 22rpx 22rpx;
  background-position: 0 0, 0 0;
  z-index: 0;
  pointer-events: none;
  filter: blur(0.5px);
}

@keyframes achievement-glow-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* 状态角标 - 优化位置 */
.achievement-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 3;
}

.status-badge {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-shadow: 
    0 6rpx 16rpx rgba(0,0,0,0.6),
    0 0 24rpx rgba(196, 167, 108,0.4),
    inset 0 2rpx 4rpx rgba(255,255,255,0.15);
}

.status-badge.unlocked {
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.5) 0%, rgba(196, 167, 108,0.35) 50%, rgba(196, 167, 108,0.25) 100%);
  border: 2px solid rgba(196, 167, 108,0.7);
  box-shadow: 
    0 6rpx 16rpx rgba(0,0,0,0.7),
    0 0 32rpx rgba(196, 167, 108,0.6),
    0 0 16rpx rgba(196, 167, 108,0.4),
    inset 0 2rpx 4rpx rgba(255,255,255,0.2);
  animation: badge-pulse 2s ease-in-out infinite;
}

@keyframes badge-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.status-badge.locked {
  background: rgba(0,0,0,0.6);
  border: 1.5px solid rgba(255,255,255,0.15);
}

.status-icon {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: 900;
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.6);
}

.status-badge.locked .status-icon {
  color: rgba(255,255,255,0.4);
  font-size: 24rpx;
}

/* 图标区域 - 优化 */
.achievement-icon-wrapper {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  margin-bottom: 8rpx;
}

.achievement-icon-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.3) 0%, rgba(196, 167, 108,0.2) 50%, transparent 100%);
  border-radius: 50%;
  filter: blur(25rpx);
  z-index: 0;
}

.achievement-item.unlocked .achievement-icon-bg {
  background: 
    radial-gradient(circle, rgba(196, 167, 108,0.5) 0%, rgba(196, 167, 108,0.35) 50%, transparent 100%);
  animation: icon-bg-pulse 2.5s ease-in-out infinite;
}

.achievement-icon {
  position: relative;
  z-index: 1;
  font-size: 72rpx;
  filter: drop-shadow(0 0 24rpx rgba(196, 167, 108,0.5));
  transition: transform 0.3s;
}

.achievement-item.unlocked .achievement-icon {
  filter: drop-shadow(0 0 36rpx rgba(196, 167, 108,0.7));
  animation: icon-float 3.5s ease-in-out infinite;
}

.achievement-icon-ring {
  position: absolute;
  top: -12rpx;
  left: -12rpx;
  width: calc(100% + 24rpx);
  height: calc(100% + 24rpx);
  border: 2.5px solid rgba(196, 167, 108,0.5);
  border-radius: 50%;
  box-shadow: 
    0 0 36rpx rgba(196, 167, 108,0.5),
    inset 0 0 36rpx rgba(196, 167, 108,0.2);
  animation: icon-ring-rotate 9s linear infinite;
  z-index: 0;
}

.achievement-icon-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    135deg,
    transparent 40%,
    rgba(255,255,255,0.2) 50%,
    transparent 60%
  );
  animation: icon-shine-rotate 4s linear infinite;
  z-index: 0;
  pointer-events: none;
}

@keyframes icon-shine-rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 信息区域 - 优化 */
.achievement-info {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.achievement-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #fff;
  font-family: 'Times New Roman', serif;
  letter-spacing: 2rpx;
  text-align: center;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.8);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.achievement-item.unlocked .achievement-name {
  color: var(--gold);
  text-shadow: 
    0 0 24rpx rgba(196, 167, 108,0.7),
    0 2rpx 10rpx rgba(0,0,0,0.8);
}

.achievement-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  letter-spacing: 1rpx;
  text-align: center;
  line-height: 1.5;
  min-height: 66rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  word-break: break-word;
}

/* 进度条 - 优化 */
.achievement-progress {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
}

.progress-header-mini {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-bottom: 4rpx;
}

.progress-label-mini {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  letter-spacing: 1rpx;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-percent-mini {
  font-family: 'DIN';
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(196, 167, 108,0.9);
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.4);
  white-space: nowrap;
  flex-shrink: 0;
}

.progress-bar-mini {
  width: 100%;
  height: 8rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 4rpx;
  overflow: hidden;
  border: 1px solid rgba(196, 167, 108,0.25);
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.5);
}

.progress-fill-mini {
  position: relative;
  height: 100%;
  background: linear-gradient(90deg, rgba(196, 167, 108,0.8), var(--gold));
  border-radius: 4rpx;
  box-shadow: 
    0 0 16rpx rgba(196, 167, 108,0.5),
    inset 0 1rpx 2rpx rgba(255,255,255,0.3);
  transition: width 0.8s ease;
  overflow: hidden;
}

.progress-shine-mini {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255,255,255,0.4) 50%,
    transparent 100%
  );
  animation: progress-shine-sweep 2s ease-in-out infinite;
}

.progress-text {
  font-size: 20rpx;
  color: rgba(196, 167, 108,0.9);
  letter-spacing: 1rpx;
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

/* 奖励徽章 - 优化 */
.achievement-reward {
  width: 100%;
  display: flex;
  justify-content: center;
}

.reward-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  background: 
    linear-gradient(135deg, rgba(196, 167, 108,0.25), rgba(196, 167, 108,0.15));
  border: 1.5px solid rgba(196, 167, 108,0.4);
  border-radius: 16rpx;
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.4),
    0 0 20rpx rgba(196, 167, 108,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.12);
}

.reward-icon {
  font-size: 24rpx;
  filter: drop-shadow(0 0 8rpx rgba(196, 167, 108,0.4));
}

.reward-text {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.5);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 32rpx;
  min-height: 400rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.4;
  filter: grayscale(0.5);
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 2rpx;
  text-align: center;
  word-wrap: break-word;
  max-width: 100%;
  box-sizing: border-box;
}

.retry-btn {
  margin-top: 20rpx;
  padding: 20rpx 40rpx;
  background: 
    linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.12));
  border: 2px solid rgba(196, 167, 108,0.4);
  border-radius: 24rpx;
  color: var(--gold);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.4),
    0 0 20rpx rgba(196, 167, 108,0.2);
  transition: all 0.3s;
}

.retry-btn:active {
  transform: scale(0.95);
  background: 
    linear-gradient(135deg, rgba(196, 167, 108,0.3), rgba(196, 167, 108,0.2));
}

/* 骨架屏样式 */
.skeleton-container {
  width: 100%;
  padding: 0;
}

.skeleton-card {
  background: 
    linear-gradient(135deg, rgba(0,0,0,0.6), rgba(10,10,10,0.5));
  border: 2px solid rgba(196, 167, 108,0.2);
  border-radius: 40rpx;
  padding: 56rpx 44rpx;
  margin-bottom: 50rpx;
  overflow: hidden;
}

.skeleton-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108,0.1) 0%,
    rgba(196, 167, 108,0.2) 50%,
