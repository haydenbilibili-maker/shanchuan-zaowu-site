<!--pages/user/certificates/index.wxml-->
<view class="container">
  
  <view class="nav-bar" style="top: {{statusBarHeight}}px">
    <view class="back-btn" bindtap="goBack">←</view>
    <text class="page-title">证书收藏夹｜MY CERTIFICATES</text>
  </view>

  <scroll-view scroll-y class="content" style="padding-top: {{statusBarHeight + 44}}px">
    
    <view class="header-text">
      <text class="h1">荣誉档案</text>
      <text class="h2">共收藏 {{certificates.length}} 件珍品</text>
    </view>

    <view class="cert-grid">
      <block wx:for="{{certificates}}" wx:key="_id">
        <view class="cert-item stagger-item" style="animation-delay: {{index * 0.1}}s" bindtap="viewCert" data-id="{{item._id}}">
          <!-- 模拟证书缩略图 (如果有生成图更好，没有则用商品图+相框) -->
          <view class="cert-frame">
            <image src="{{item.displayImage}}" mode="aspectFill" class="c-img"></image>
             <view class="c-overlay">
               <text class="c-no">{{item.orderNo}}</text>
             </view>
             <view class="c-seal">CERTIFIED</view>
          </view>
          <text class="c-name">{{item.products[0].title}}</text>
          <text class="c-date">{{item.dateStr}}</text>
        </view>
      </block>
    </view>

    <view class="empty-state" wx:if="{{certificates.length === 0 && !loading}}">
       <text>暂无收藏证书</text>
       <view class="btn-go" bindtap="goShop">去探索</view>
    </view>

  </scroll-view>
</view>