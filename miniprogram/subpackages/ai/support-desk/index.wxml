<!-- 客服工作台（2026-11-27 交互视觉对齐与升级）：
     页头与订单认领 / 联系专员同构；三档分段（待回复带数）；卡片左侧状态色条 + 相对时间 + 超时「已等」；
     详情底部弹层 = 对话（顾客 ↔ 专员）+ 快捷动作 + 顾客 360 + 内部备注 + 回复；遮罩 / 固定区 catchtouchmove，正文 scroll-view 不加；
     page-meta 在弹层打开时锁背后页面。展示口径见 deskView.js -->
<page-meta page-style="{{openId ? 'overflow: hidden;' : ''}}" />
<view class="sd-page">
  <view class="sd-head">
    <view class="sd-rule"></view>
    <text class="sd-eyebrow">SUPPORT DESK</text>
    <text class="sd-title">客服工作台</text>
    <text class="sd-sub">顾客在「联系专员」的留言都在这里；回复会发到对方的「山海有信」。待回复按等得最久的排在前面。</text>
  </view>

  <view class="sd-seg">
    <view class="sd-seg-item {{tab === 'pending' ? 'on' : ''}}" data-tab="pending" bindtap="switchTab" hover-class="sd-seg-press" hover-stay-time="80">
      <text class="sd-seg-cn">待回复</text>
      <text class="sd-seg-sub {{pendingCount ? 'is-hot' : ''}}">{{pendingCount ? pendingCount + ' 条' : '已清空'}}</text>
    </view>
    <view class="sd-seg-item {{tab === 'replied' ? 'on' : ''}}" data-tab="replied" bindtap="switchTab" hover-class="sd-seg-press" hover-stay-time="80">
      <text class="sd-seg-cn">已回复</text>
      <text class="sd-seg-sub">REPLIED</text>
    </view>
    <view class="sd-seg-item {{tab === 'all' ? 'on' : ''}}" data-tab="all" bindtap="switchTab" hover-class="sd-seg-press" hover-stay-time="80">
      <text class="sd-seg-cn">全部</text>
      <text class="sd-seg-sub">ALL</text>
    </view>
  </view>

  <view class="sd-search">
    <image class="sd-search-ico" src="/assets/icons/search.png" mode="aspectFit" binderror="onImageError" />
    <input class="sd-search-input" value="{{query}}" bindinput="onSearch" placeholder="搜类型 / 内容 / 订单号 / 会员" placeholder-class="sd-ph" confirm-type="search" />
    <text class="sd-search-x" wx:if="{{query}}" bindtap="clearSearch" hover-class="tap-press-soft" hover-stay-time="80">清除</text>
  </view>

  <view class="sd-tip is-{{hintTone}}" wx:if="{{hint && !openId}}">{{hint}}</view>

  <view class="sd-list" wx:if="{{rows.length}}">
    <view class="sd-row tone-{{item.tone}} {{item.overdue ? 'is-overdue' : ''}}" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onRowTap" hover-class="sd-row-press" hover-stay-time="80">
      <view class="sd-row-top">
        <text class="sd-topic">{{item.topicLabel}}</text>
        <text class="sd-wait" wx:if="{{item.overdue}}">{{item.waitedText}}</text>
        <text class="sd-status tone-{{item.tone}}" wx:else>{{item.statusText}}{{item.replyCount ? ' · 回复 ' + item.replyCount + ' 次' : ''}}</text>
      </view>
      <text class="sd-msg">{{item.message || '（没有正文）'}}</text>
      <view class="sd-row-foot">
        <text class="sd-meta">{{item.ago}}{{item.orderNo ? ' · 订单 ' + item.orderNo : ''}}{{item.hasImages ? ' · 有附图' : ''}}</text>
        <text class="sd-who" wx:if="{{item.customer}}">{{item.customer}}{{item.customerCount > 1 ? ' · 第 ' + item.customerCount + ' 次' : ''}}</text>
      </view>
    </view>
    <view class="sd-more" wx:if="{{hasMore || loadingMore}}" bindtap="loadMore" hover-class="tap-press-soft" hover-stay-time="80">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="sd-end" wx:elif="{{rows.length > 6}}">没有更多了</view>
  </view>

  <view class="sd-skel" wx:if="{{loading && !rows.length}}">
    <view class="sd-skel-row" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sd-skel-l"></view>
      <view class="sd-skel-l short"></view>
    </view>
  </view>
  <view class="sd-empty" wx:if="{{!loading && !rows.length}}">
    <image class="sd-empty-ico" src="/assets/icons/message.png" mode="aspectFit" binderror="onImageError" />
    <text class="sd-empty-t">{{query ? '没有找到「' + query + '」相关的留言' : (tab === 'pending' ? '待回复的留言都清完了' : '还没有留言')}}</text>
    <text class="sd-empty-s">{{query ? '换个词，或清除搜索看全部' : (tab === 'pending' ? '顾客新留言会进「工作信息」，也会通知到你' : '顾客在「联系专员」留言后会出现在这里')}}</text>
  </view>

  <!-- 详情：底部弹层（与其它页统一）。点开就出弹层，读取时先给骨架 -->
  <view class="ui-pop-mask" wx:if="{{openId}}" bindtap="closeDetail" catchtouchmove="true">
    <view class="ui-pop-sheet sd-sheet" catchtap="noop">
      <view class="sd-sheet-head" catchtouchmove="noop">
        <view class="sd-sheet-t">
          <text class="sd-sheet-k">{{detail ? detail.topicLabel : '留言'}}</text>
          <view class="sd-sheet-title-row">
            <text class="sd-sheet-title">{{detail ? detail.customer : '读取中…'}}</text>
            <text class="sd-chip tone-{{detail.tone}}" wx:if="{{detail}}">{{detail.statusText}}</text>
            <text class="sd-chip is-wait" wx:if="{{detail.waitedText}}">{{detail.waitedText}}</text>
          </view>
          <text class="sd-sheet-time" wx:if="{{detail}}">{{detail.time}} · {{detail.ago}}</text>
        </view>
        <view class="sd-sheet-close" hover-class="tap-press" hover-stay-time="80" catchtap="closeDetail">✕</view>
      </view>

      <view class="sd-quick" wx:if="{{detail && (detail.orderNo || detail.contactPhone)}}" catchtouchmove="noop">
        <view class="sd-quick-chip" wx:if="{{detail.orderNo}}" catchtap="copyOrderNo" hover-class="tap-press-soft" hover-stay-time="80">复制单号</view>
        <view class="sd-quick-chip" wx:if="{{detail.orderId}}" data-id="{{detail.orderId}}" catchtap="openOrderDetail" hover-class="tap-press-soft" hover-stay-time="80">查看订单 ›</view>
        <view class="sd-quick-chip" wx:if="{{detail.contactPhone}}" catchtap="callCustomer" hover-class="tap-press-soft" hover-stay-time="80">拨打 {{detail.contactPhone}}</view>
      </view>

      <scroll-view scroll-y class="sd-sheet-body">
        <view class="sd-sheet-skel" wx:if="{{!detail}}">
          <view class="sd-skel-l"></view>
          <view class="sd-skel-l"></view>
          <view class="sd-skel-l short"></view>
        </view>

        <block wx:if="{{detail}}">
          <!-- 对话：顾客原留言 + 历次回复（history = 专员那几条） -->
          <view class="sd-thread">
            <view class="sd-bubble-row is-{{item.side}}" wx:for="{{detail.thread}}" wx:key="key">
              <view class="sd-bubble is-{{item.side}}">
                <text class="sd-bubble-who">{{item.side === 'staff' ? '专员回复' : '顾客留言'}} · {{item.time}}</text>
                <text class="sd-bubble-text" user-select>{{item.text}}</text>
                <view class="sd-quote-imgs" wx:if="{{item.images.length}}">
                  <image class="sd-quote-img" wx:for="{{item.images}}" wx:for-item="url" wx:key="*this" src="{{url}}" mode="aspectFill" data-url="{{url}}" catchtap="previewImage" binderror="onImageError" />
                </view>
              </view>
            </view>
            <text class="sd-hint-line" wx:if="{{!detail.history.length}}">还没有回复过，在下面写第一条</text>
            <text class="sd-ctx" wx:if="{{detail.orderNo || detail.productName}}">{{detail.orderNo ? '订单 ' + detail.orderNo : ''}}{{detail.orderNo && detail.productName ? ' · ' : ''}}{{detail.productName}}</text>
          </view>

          <view class="sd-block" wx:if="{{customer}}">
            <text class="sd-block-t">这位顾客</text>
            <view class="sd-facts">
              <view class="sd-fact"><text class="sd-fact-n">{{customer.orderCount}}</text><text class="sd-fact-l">单</text></view>
              <view class="sd-fact"><text class="sd-fact-n">{{customer.commentCount}}</text><text class="sd-fact-l">评价</text></view>
              <view class="sd-fact"><text class="sd-fact-n">{{customer.ticketCount}}</text><text class="sd-fact-l">留言</text></view>
            </view>
            <view class="sd-order" wx:for="{{customer.orders}}" wx:key="id" data-id="{{item.id}}" catchtap="openOrderDetail" hover-class="tap-press-soft" hover-stay-time="80">
              <text class="sd-order-t">{{item.title}}</text>
              <text class="sd-order-s">¥{{item.amount}} · {{item.status}}</text>
              <text class="sd-order-go">›</text>
            </view>
          </view>

          <view class="sd-block">
            <text class="sd-block-t">内部备注 <text class="sd-block-s">（顾客看不到）</text></text>
            <view class="sd-note" wx:for="{{notes}}" wx:key="key">
              <text class="sd-note-time">{{item.time}}</text>
              <text class="sd-note-text" user-select>{{item.text}}</text>
            </view>
            <view class="sd-note-row">
              <input class="sd-note-input" value="{{noteText}}" bindinput="onNoteInput" maxlength="300" placeholder="记一笔：已电话联系 / 等顾客补图" placeholder-class="sd-ph" />
              <view class="sd-note-save {{noteText ? '' : 'is-off'}}" catchtap="addNote" hover-class="tap-press" hover-stay-time="80">保存</view>
            </view>
          </view>

          <view class="sd-block" wx:if="{{detail.status !== 'resolved'}}">
            <text class="sd-block-t">回复</text>
            <view class="sd-phrases">
              <view class="sd-phrase" wx:for="{{phrases}}" wx:key="*this" data-text="{{item}}" catchtap="pickPhrase" hover-class="tap-press-soft" hover-stay-time="80">{{item}}</view>
            </view>
            <textarea class="sd-input" fixed="{{true}}" cursor-spacing="120" value="{{replyText}}" bindinput="onReplyInput" maxlength="500" placeholder="写回复，发送后顾客会在「山海有信」收到" placeholder-class="sd-ph"></textarea>
            <text class="sd-count">{{replyText.length}}/500</text>
          </view>
        </block>
      </scroll-view>

      <view class="sd-sheet-tip is-{{hintTone}}" wx:if="{{hint}}" catchtouchmove="noop">{{hint}}</view>
      <view class="sd-sheet-foot" wx:if="{{detail}}" catchtouchmove="noop">
        <block wx:if="{{detail.status === 'resolved'}}">
          <view class="sd-send" catchtap="reopenTicket" hover-class="tap-press" hover-stay-time="80">重新打开</view>
        </block>
        <block wx:else>
          <view class="sd-resolve {{resolveArmed ? 'is-armed' : ''}}" catchtap="markResolved" hover-class="tap-press" hover-stay-time="80">{{resolveArmed ? '还没回复过，再点确认' : '标记已解决'}}</view>
          <view class="sd-send {{sending ? 'is-off' : ''}}" catchtap="sendReply" hover-class="tap-press" hover-stay-time="80">{{sending ? '发送中…' : '发送回复'}}</view>
        </block>
      </view>
    </view>
  </view>
</view>
