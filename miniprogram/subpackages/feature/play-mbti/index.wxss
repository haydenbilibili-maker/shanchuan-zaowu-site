@import "../play-shared/ritual-play.wxss";

/* ── MBTI 贴士：一根双极轴 ──────────────────────────────────────
   入口不是"一枚瓦片"：两端各一个极点，中间一枚游标；游标滑到哪侧就给哪侧的话。 */
.rp-axis {
  position: relative;
  /* 2026-09-22（渲染台出图评审）：这一页的形态件原来是 300×120rpx 的**2rpx 细线 + 细空心圈**，
     在整屏深色里像一根发丝 —— 与另外三页的形态件（签筒 150×210、饼壳、星盘 ~200 直径）
     比**视觉重量明显偏弱**，而它是这一页唯一的主体。加粗线、放大端圈与游标、略放宽。 */
  width: 360rpx;
  height: 150rpx;
}

.rp-axis-line {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: 72rpx;          /* = 高 150 / 2 - 线高 3 */
  height: 3rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.28) 0%, rgba(196, 167, 108, 0.9) 50%, rgba(196, 167, 108, 0.28) 100%);
}

.rp-axis-end {
  position: absolute;
  top: 57rpx;          /* 端圈高 36 → 圆心落在中心线 75 上 */
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.72);
  border-radius: 50%;
}

.rp-axis-end.is-left { left: 0; }
.rp-axis-end.is-right { right: 0; }

.rp-axis-knob {
  position: absolute;
  left: 162rpx;        /* = (宽 360 - 游标 44) / 2 —— 换宽度必须同步改，否则游标不居中 */
  top: 53rpx;          /* 游标高 44 → 圆心落在中心线 75 上 */
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, var(--brass-100) 0%, var(--brass-400) 100%);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
}

/* 进行态：游标从中间滑向左极再回右侧停住（"对齐"的感觉） */
.rp-stage.is-pending .rp-axis-knob {
  animation: rp-knob-align 900ms cubic-bezier(0.3, 0.7, 0.3, 1) forwards;
}

@keyframes rp-knob-align {
  0% { transform: translateX(0); }
  38% { transform: translateX(-118rpx); }
  72% { transform: translateX(118rpx); }
  100% { transform: translateX(0); }
}

/* ── 结果纸面：一张类型卡（浅纸 + 顶部一根小轴） ──────────────────── */
.rp-paper {
  background: linear-gradient(180deg, #F6F1E4 0%, #EAE2D0 100%);
  border: 1rpx solid rgba(122, 92, 44, 0.32);
}

.rp-axis-mini {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 30rpx;
  margin-top: 12rpx;
}

.rp-axis-mini-line {
  flex: 1;
  height: 2rpx;
  background: rgba(58, 50, 38, 0.3);
}

.rp-axis-mini-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.rp-axis-mini-dot.is-left {
  background: rgba(58, 50, 38, 0.45);
}

.rp-axis-mini-dot.is-right {
  background: rgba(122, 46, 36, 0.6);
}

.rp-paper-title {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  letter-spacing: 0.03em;
}
