<!--subpackages/feature/care/index.wxml · 标本养护「养护手册」（2026-10-17 重构）
    原生导航栏已写「标本养护」：页内不再叠自绘页头与固定 scroll-view，改为页面滚动。
    卷首 → 当季纸签 → 我的藏品 → 品类手册（浅纸签 + 刻版线描）→ 日常要点 → 联系专员。数据与跳转不变。 -->
<view class="page-care">
  <view class="care-skeleton" wx:if="{{loading}}">
    <view class="sk-block sk-hero"></view>
    <view class="sk-block sk-row" wx:for="{{[1,2]}}" wx:key="*this"></view>
    <view class="sk-grid">
      <view class="sk-block sk-grid-item" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
    </view>
  </view>

  <view class="care-content {{pageReady ? 'ready' : ''}}" wx:else>
    <!-- 卷首 -->
    <view class="head care-enter care-enter-d1" catchlongpress="onEasterEggLongPress" data-egg-id="kuafu">
      <text class="eyebrow">SPECIMEN CARE · 养护手册</text>
      <text class="head-title">把山海安放好</text>
      <text class="head-sub">按品类查看养护要点；签收的藏品，在这里找到它自己的那一页。</text>
    </view>

    <!-- 当季：一张浅纸签 -->
    <view class="season care-enter care-enter-d2" wx:if="{{seasonalTip}}">
      <view class="season-pin" aria-hidden="true"></view>
      <text class="season-eyebrow">{{seasonEyebrow}}</text>
      <text class="season-title">{{seasonalTip.title}}</text>
      <text class="season-desc">{{seasonalTip.desc}}</text>
    </view>

    <!-- 我的藏品 -->
    <view class="block care-enter care-enter-d3" wx:if="{{recentSpecimens.length}}">
      <view class="sec-head">
        <view class="sec-head-t">
          <text class="eyebrow">MY SPECIMENS</text>
          <text class="sec-title">我的藏品</text>
        </view>
        <text class="sec-link" hover-class="care-press" bindtap="goToMySpecimens" wx:if="{{specimenTotal > 0}}">全部 {{specimenTotal}} 件 ›</text>
      </view>
      <view
        class="spec-row"
        wx:for="{{recentSpecimens}}"
        wx:key="key"
        hover-class="tap-press-soft"
        hover-stay-time="80"
        bindtap="openSpecimenCare"
        data-category="{{item.category}}"
        data-order-id="{{item.orderId}}"
        data-product-id="{{item.productId}}"
      >
        <image class="spec-thumb" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}"></image>
        <view class="spec-thumb is-empty" wx:else><text class="spec-letter">{{item.categoryLabel[0]}}</text></view>
        <view class="spec-main">
          <text class="spec-eyebrow">{{item.categoryLabel}}{{item.receiveTimeText ? ' · ' + item.receiveTimeText + ' 签收' : ''}}</text>
          <text class="spec-title">{{item.title}}</text>
          <text class="spec-summary">{{item.careSummary}}</text>
        </view>
        <text class="spec-chevron">›</text>
      </view>
    </view>

    <!-- 空态 -->
    <view class="block empty care-enter care-enter-d3" wx:elif="{{!loading}}">
      <text class="empty-title">还没有已签收的藏品</text>
      <text class="empty-desc">签收后，这里会出现它专属的养护指南。也可以先按品类浏览通用要点。</text>
      <view class="empty-cta" bindtap="scrollToCategories" hover-class="care-press">浏览品类手册 ›</view>
    </view>

    <!-- 品类手册：浅纸签 + 刻版线描 -->
    <view class="block care-enter care-enter-d4" id="care-categories">
      <view class="sec-head-t">
        <text class="eyebrow">BY CATEGORY</text>
        <text class="sec-title">品类手册</text>
      </view>
      <view class="cat-grid">
        <view
          class="cat {{item.wide ? 'is-wide' : ''}}"
          wx:for="{{categoryCards}}"
          wx:key="category"
          hover-class="tap-press-soft"
          hover-stay-time="80"
          bindtap="openCategory"
          data-category="{{item.category}}"
          aria-role="button"
          aria-label="{{item.label}}养护指南"
        >
          <image class="cat-plate" src="{{item.plate}}" mode="aspectFit" wx:if="{{item.plate}}"></image>
          <view class="cat-copy">
            <text class="cat-overline">{{item.overline}}</text>
            <text class="cat-title">{{item.label}}</text>
            <text class="cat-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 日常要点：编号发丝线手风琴 -->
    <view class="block care-enter care-enter-d5">
      <view class="sec-head-t">
        <text class="eyebrow">EVERYDAY</text>
        <text class="sec-title">日常要点</text>
      </view>
      <view class="tips">
        <view
          class="tip {{expandedTip === item.key ? 'is-open' : ''}}"
          wx:for="{{generalTips}}"
          wx:key="key"
          bindtap="toggleTip"
          data-key="{{item.key}}"
          hover-class="tap-press-soft"
          hover-stay-time="80"
          aria-role="button"
        >
          <view class="tip-head">
            <text class="tip-no">0{{index + 1}}</text>
            <text class="tip-title">{{item.title}}</text>
            <text class="tip-toggle">{{expandedTip === item.key ? '−' : '+'}}</text>
          </view>
          <text class="tip-desc" wx:if="{{expandedTip === item.key}}">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 联系专员 -->
    <view class="support care-enter care-enter-d6" hover-class="tap-press-soft" hover-stay-time="80" bindtap="goToSupport" aria-role="button">
      <view class="support-main">
        <text class="support-title">仍有问题？</text>
        <text class="support-desc">变色、返潮、框体异常，联系专员协助查看</text>
      </view>
      <text class="support-cta">联系专员 ›</text>
    </view>
  </view>
  <easter-egg-note id="easterEggNote" />
</view>
