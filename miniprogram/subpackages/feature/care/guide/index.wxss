/* subpackages/feature/care/guide/index.wxss */
@import '../care-common.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.page-guide {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  background: var(--color-bg);
  box-sizing: border-box;
}

.page-guide .care-scroll {
  bottom: auto;
}

.care-title {
  font-size: 34rpx;
  line-height: 1.35;
}

.sk-hero {
  height: 168rpx;
  margin-bottom: var(--space-3);
}

.sk-plate {
  height: 200rpx;
  margin-bottom: var(--space-4);
}

.sk-section {
  height: 220rpx;
  margin-bottom: var(--space-3);
}

.sync-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  padding: 16rpx 20rpx;
  margin-bottom: var(--space-3);
  background: rgba(233, 162, 59, 0.08);
  border: 1px solid rgba(233, 162, 59, 0.28);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.sync-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.sync-retry {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-400);
  padding: 8rpx 4rpx;
}

.cat-hero {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  position: relative;
  padding: var(--space-4) var(--space-4) var(--space-4) 40rpx;
  margin-bottom: var(--space-3);
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
  overflow: hidden;
}

.cat-hero-stripe {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.cat-hero-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108, 0.1);
  border: 1px solid rgba(196, 167, 108, 0.22);
  border-radius: var(--radius-md);
}

.cat-hero-icon image {
  width: 40rpx;
  height: 40rpx;
}

.cat-hero-copy {
  flex: 1;
  min-width: 0;
}

.cat-hero-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.12em;
  font-style: italic;
  text-transform: uppercase;
}

.cat-hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cat-hero-lead {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-card {
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border-highlight);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.context-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.12em;
  font-style: italic;
}

.context-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.context-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-top: 10rpx;
  line-height: 1.4;
  word-break: break-word;
}

.context-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ctx-tag {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  border: 1px solid;
  white-space: nowrap;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ctx-tag.brass {
  color: var(--brass-400);
  border-color: var(--brass-800);
  background: rgba(196, 167, 108, 0.08);
}

.ctx-tag.muted {
  color: var(--color-text-secondary);
  border-color: var(--color-border);
  background: transparent;
}

.context-cert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid var(--color-bg-elevated);
  font-size: 24rpx;
  color: var(--brass-400);
}

.context-cert-arrow {
  font-size: 32rpx;
  line-height: 1;
  opacity: 0.8;
}

.summary-plate {
  position: relative;
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.summary-plate::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.14);
  border-radius: calc(var(--radius-lg) - 8rpx);
  pointer-events: none;
}

.plate-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.12em;
  font-style: italic;
}

.plate-kicker {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
  margin-bottom: 12rpx;
}

.plate-summary {
  display: block;
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  line-height: 1.5;
  font-family: var(--font-brand);
  word-break: break-word;
}

.plate-draft {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 14rpx;
  line-height: 1.55;
  word-break: break-word;
}

.toc-wrap {
  margin-bottom: var(--space-4);
  overflow: hidden;
}

.toc-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.12em;
  margin-bottom: 12rpx;
}

.toc-scroll {
  width: 100%;
  white-space: nowrap;
}

.toc-row {
  display: inline-flex;
  align-items: center;
}

.toc-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  color: var(--color-text-secondary);
  box-sizing: border-box;
}

.toc-chip.active {
  border-color: var(--brass-800);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.08);
}

.toc-pad {
  width: 8rpx;
  height: 1px;
  flex-shrink: 0;
}

.section-block {
  margin-bottom: var(--space-3);
  padding: var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
  overflow: hidden;
}

.block-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}

.block-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.1);
  border: 1px solid rgba(196, 167, 108, 0.22);
  color: var(--brass-400);
  font-size: 20rpx;
  font-family: var(--font-mono);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.block-head-copy {
  flex: 1;
  min-width: 0;
}

.block-overline {
  display: block;
  font-size: 18rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.1em;
  font-style: italic;
}

.block-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.block-toggle {
  font-size: 32rpx;
  color: var(--brass-400);
  flex-shrink: 0;
  width: 48rpx;
  text-align: center;
  line-height: 1;
}

.block-content {
  overflow: hidden;
  max-height: 2400rpx;
  transition: max-height var(--dur-slow) var(--ease-standard), opacity var(--dur-base) var(--ease-standard), margin-top var(--dur-base) var(--ease-standard);
  opacity: 1;
  margin-top: 20rpx;
}

.block-content.collapsed {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
}

.block-body {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.7;
  margin-bottom: 16rpx;
  word-break: break-word;
}

.checklist {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.check-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  padding: 12rpx 16rpx;
  background: rgba(26, 24, 20, 0.45);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.check-mark {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  border: 2rpx solid var(--brass-400);
  margin-top: 8rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.check-mark.brass {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.18);
}

.check-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-body);
  line-height: 1.55;
  word-break: break-word;
}

.warning-block {
  padding: var(--space-4);
  margin-bottom: var(--space-3);
  background: var(--color-bg-card);
  border: 1px solid rgba(214, 64, 69, 0.28);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.warning-overline {
  display: block;
  font-size: 18rpx;
  color: var(--color-error);
  letter-spacing: 0.12em;
  font-style: italic;
  margin-bottom: 8rpx;
}

.warning-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.warning-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 1px solid rgba(214, 64, 69, 0.4);
  background: rgba(214, 64, 69, 0.12);
  color: var(--color-error);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 34rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.warning-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.warning-body {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.65;
  margin-bottom: 16rpx;
  word-break: break-word;
}

.warning-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.warning-item {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.warning-mark {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-error);
  opacity: 0.7;
  flex-shrink: 0;
}

.warning-tip {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  word-break: break-word;
}

.framing-card {
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}

.framing-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.12em;
  font-style: italic;
}

.framing-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  margin-bottom: 10rpx;
}

.framing-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.framing-badge {
  font-size: 20rpx;
  color: var(--brass-400);
  padding: 4rpx 12rpx;
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-full);
}

.framing-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: 16rpx;
  word-break: break-word;
}

.footer-note {
  text-align: center;
  padding: var(--space-2) 0 var(--space-4);
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.7;
}

.footer-note text {
  display: block;
}

.care-scroll-pad.footer-aware {
  height: 24rpx;
}

.care-footer-btn.primary:active,
.care-footer-btn.secondary:active {
  opacity: 0.88;
}
