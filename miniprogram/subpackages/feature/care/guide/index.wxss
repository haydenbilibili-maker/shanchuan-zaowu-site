/* subpackages/feature/care/guide/index.wxss · 养护指南「养护手册」（2026-10-17 重构）
   自绘页头与固定 scroll-view 退场（页面滚动）；品类色条 / 色块标签退场，品类用刻版线描与等宽眉标表达。
   care-common（四份字节一致镜像）只取骨架 / 入场 / 按压 / 空态 / 底栏，不改。 */
@import '../care-common.wxss';

page {
  background: #1A1814;
}

.page-guide {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(176rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
}

.sk-hero { height: 320rpx; }
.sk-plate { height: 200rpx; margin-bottom: var(--space-3); }
.sk-section { height: 120rpx; margin-bottom: var(--space-2); }

/* —— 同步失败提示：发丝线行 —— */
.sync-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.16);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.sync-text { font-size: var(--fs-22); color: var(--color-text-secondary); }

.sync-retry { flex-shrink: 0; font-size: var(--fs-24); color: var(--brass-200); }

/* —— 品类卷首：一张浅纸签（铜别针 + 内发丝框 + 刻版线描）—— */
.cat-hero {
  position: relative;
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 44rpx 36rpx 36rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.42);
}

.cat-hero::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.cat-hero-pin {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  background: #B08D57;
}

.cat-hero-plate {
  flex-shrink: 0;
  width: 168rpx;
  height: 168rpx;
}

.cat-hero-copy { flex: 1; min-width: 0; }

.cat-hero-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: #8B6F47;
}

.cat-hero-title {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #2E2618;
}

.cat-hero-lead {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: #5E5444;
}

/* —— 这件藏品：发丝线块 —— */
.context-card {
  margin-top: 40rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.context-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.context-label {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.context-title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  color: #F3ECDD;
}

.context-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ctx-tag {
  padding: 0 14rpx;
  line-height: 40rpx;
  font-size: var(--fs-20);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  border-radius: 4rpx;
}

.ctx-tag.muted { color: var(--color-text-secondary); border-color: rgba(196, 167, 108, 0.2); }

.context-cert {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: var(--fs-24);
  color: var(--brass-200);
}

.context-cert-arrow { font-size: var(--fs-26); }

/* —— 养护摘要：宋体大段 + 免责小字 —— */
.summary-plate { margin-top: 40rpx; }

.summary-plate .plate-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.plate-kicker {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-34);
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.plate-summary {
  display: block;
  margin-top: 16rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  line-height: 1.8;
  color: #E0DAD0;
}

.plate-draft {
  display: block;
  margin-top: 14rpx;
  font-size: var(--fs-20);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* —— 章节目录 —— */
.toc-wrap { margin-top: 40rpx; }

.toc-label {
  display: block;
  margin-bottom: 14rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.toc-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  width: calc(100% + 64rpx);
}

.toc-row { display: flex; gap: 12rpx; padding-left: 32rpx; }

.toc-pad { flex-shrink: 0; width: 20rpx; }

.toc-chip {
  flex-shrink: 0;
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: var(--fs-24);
  color: var(--color-text-body);
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-sm);
}

.toc-chip.active {
  color: var(--brass-200);
  border-color: var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
  box-shadow: var(--ring-brass);
}

/* —— 章节：发丝线手风琴 —— */
.section-block {
  margin-top: 24rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.section-block:first-of-type { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.block-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.block-index {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--brass-300);
}

.block-head-copy { flex: 1; min-width: 0; }

.block-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: var(--color-text-secondary);
}

.block-title {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: #F3ECDD;
}

.block-toggle {
  flex-shrink: 0;
  font-size: var(--fs-34);
  color: var(--brass-300);
}

.block-content {
  overflow: hidden;
  max-height: 2400rpx;
  transition: max-height var(--dur-slow) var(--ease-standard), opacity var(--dur-base) var(--ease-standard);
  opacity: 1;
  padding-bottom: 28rpx;
}

.block-content.collapsed {
  max-height: 0;
  opacity: 0;
  padding-bottom: 0;
}

.block-body {
  display: block;
  font-size: var(--fs-26);
  line-height: 1.8;
  color: var(--color-text-body);
}

.checklist { margin-top: 16rpx; }

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 10rpx 0;
}

.check-mark {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  border: 2rpx solid var(--brass-300);
  box-sizing: border-box;
}

.check-mark.brass { background: var(--brass-300); }

.check-text {
  flex: 1;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* —— 异常信号：琥珀发丝框（不是红色警告块）—— */
.warning-block {
  margin-top: 40rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(214, 160, 76, 0.45);
  border-radius: var(--radius-md);
}

.warning-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: #D6A04C;
}

.warning-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
}

.warning-icon {
  width: 34rpx;
  height: 34rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: var(--fs-22);
  font-weight: 600;
  color: #D6A04C;
  border: 2rpx solid #D6A04C;
  border-radius: 50%;
  box-sizing: border-box;
}

.warning-label {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: #F3ECDD;
}

.warning-body {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: var(--color-text-body);
}

.warning-list { margin-top: 12rpx; }

.warning-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 6rpx 0;
}

.warning-mark {
  flex-shrink: 0;
  width: 8rpx;
  height: 8rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: #D6A04C;
}

.warning-tip {
  flex: 1;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* —— 装裱补充 —— */
.framing-card {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.16);
}

.framing-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.framing-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
}

.framing-title {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: #F3ECDD;
}

.framing-badge {
  padding: 0 12rpx;
  line-height: 36rpx;
  font-size: var(--fs-20);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  border-radius: 4rpx;
}

.framing-desc {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* —— 页脚说明 —— */
.footer-note {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 56rpx;
}

.footer-note text {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  letter-spacing: 0.06em;
}
