/* subpackages/feature/care/index.wxss · 标本养护「养护手册」（2026-10-17 重构）
   care-common 只取骨架屏 / 入场动效 / 按压（四份字节一致的镜像不改）；页头与固定滚动区退场。 */
@import './care-common.wxss';

page {
  background: #1A1814;
}

.page-care {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
}

.eyebrow,
.season-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

/* —— 卷首 —— */
.head-title {
  display: block;
  margin-top: 16rpx;
  font-family: var(--font-brand);
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: #F3ECDD;
}

.head-sub {
  display: block;
  margin-top: 14rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* —— 当季：浅纸签（铜别针 + 内发丝框）—— */
.season {
  position: relative;
  margin-top: 40rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.4);
}

.season::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.season-pin {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  background: #B08D57;
}

.season-eyebrow { color: #8B6F47; }

.season-title {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  color: #2E2618;
}

.season-desc {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: #5E5444;
}

/* —— 分区头 —— */
.block { margin-top: 56rpx; }

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.sec-head-t { display: flex; flex-direction: column; padding-bottom: 20rpx; }

.sec-title {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-34);
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.sec-link {
  padding: 8rpx 0 28rpx 24rpx;
  font-size: var(--fs-24);
  color: var(--brass-300);
}

/* —— 我的藏品：缩略图发丝线行 —— */
.spec-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.spec-row:last-child { border-bottom: 1rpx solid rgba(196, 167, 108, 0.14); }

.spec-thumb {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
}

.spec-thumb.is-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(196, 167, 108, 0.24);
}

.spec-letter {
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  color: rgba(196, 167, 108, 0.5);
}

.spec-main { flex: 1; min-width: 0; }

.spec-eyebrow {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.06em;
  color: var(--brass-300);
}

.spec-title {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-28);
  color: var(--color-text-body);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.spec-summary {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.spec-chevron {
  flex-shrink: 0;
  font-size: var(--fs-32);
  color: var(--color-text-secondary);
}

/* —— 空态 —— */
.empty {
  padding: 40rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.empty-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: #F3ECDD;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.empty-cta {
  display: inline-block;
  margin-top: 20rpx;
  font-size: var(--fs-24);
  color: var(--brass-200);
}

/* —— 品类手册：两列浅纸签，末张通栏 —— */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.cat {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 28rpx;
  box-sizing: border-box;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.3);
}

.cat::before {
  content: '';
  position: absolute;
  inset: 8rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.2);
  pointer-events: none;
}

.cat.is-wide {
  grid-column: 1 / -1;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.cat-plate {
  width: 112rpx;
  height: 112rpx;
  align-self: center;
}

.cat.is-wide .cat-plate { align-self: auto; flex-shrink: 0; }

.cat-copy { min-width: 0; margin-top: 8rpx; }

.cat-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: #8B6F47;
}

.cat-title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #2E2618;
}

.cat-desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: #5E5444;
}

/* —— 日常要点 —— */
.tips { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.tip {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.tip-head {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.tip-no {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.tip-title {
  flex: 1;
  font-size: var(--fs-28);
  color: var(--color-text-body);
}

.tip.is-open .tip-no,
.tip.is-open .tip-title { color: var(--brass-200); }

.tip-toggle {
  font-size: var(--fs-32);
  color: var(--brass-300);
}

.tip-desc {
  display: block;
  margin: 12rpx 0 0 54rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* —— 联系专员：描边行（本页没有实心金）—— */
.support {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 56rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  border-radius: var(--radius-md);
}

.support-main { flex: 1; min-width: 0; }

.support-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  color: #F3ECDD;
}

.support-desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.support-cta {
  flex-shrink: 0;
  font-size: var(--fs-24);
  color: var(--brass-200);
}
