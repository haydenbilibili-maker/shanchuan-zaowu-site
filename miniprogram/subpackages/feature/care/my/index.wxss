/* subpackages/feature/care/my/index.wxss · 我的标本养护「养护手册」（2026-10-17 重构）
   页面滚动；品类彩色标签退场 → 发丝描边小签；卡片 → 缩略图发丝线行。 */
@import '../care-common.wxss';

page {
  background: #1A1814;
}

.page-my-care {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
}

.sk-hero { height: 180rpx; }

.intro { padding-bottom: 32rpx; }

.intro-overline {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.intro-title {
  display: block;
  margin-top: 14rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
}

.intro-text {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.list-count {
  padding-bottom: 16rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.spec-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.spec-card:last-child { border-bottom: 1rpx solid rgba(196, 167, 108, 0.14); }

.spec-frame { flex-shrink: 0; }

.spec-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 4rpx;
  background: #1F1D1A;
}

.spec-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(196, 167, 108, 0.24);
  box-sizing: border-box;
}

.cover-letter {
  font-family: var(--font-mono);
  font-size: var(--fs-36);
  color: rgba(196, 167, 108, 0.5);
}

.spec-body { flex: 1; min-width: 0; }

.spec-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-body);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.spec-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.tag-cat,
.tag-custom {
  padding: 0 12rpx;
  line-height: 36rpx;
  font-size: var(--fs-20);
  color: var(--brass-200);
  border: 1rpx solid rgba(196, 167, 108, 0.36);
  border-radius: 4rpx;
}

.tag-date {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.spec-framing {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.spec-summary {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.spec-chevron {
  flex-shrink: 0;
  font-size: var(--fs-32);
  color: var(--color-text-secondary);
}

.empty,
.load-error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 40rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.empty-title {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  color: #F3ECDD;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.empty-btn {
  margin-top: 20rpx;
  font-size: var(--fs-24);
  color: var(--brass-200);
}

/* 陪伴天数（2026-10-18）：一行小字，数字用等宽铜色；整百天换成描边小印 */
.spec-days { display: inline-flex; align-items: baseline; gap: 6rpx; margin-top: 10rpx; }
.spec-days-k { font-size: var(--fs-20); color: var(--color-text-secondary); }
.spec-days-n { font-family: var(--font-mono); font-size: var(--fs-26); color: var(--brass-300); }
.spec-days.is-mark {
  padding: 2rpx 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.6);
  border-radius: 4rpx;
}
