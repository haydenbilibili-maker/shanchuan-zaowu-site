<!--subpackages/feature/care/my/index.wxml-->
<view class="page-my-care">
  <!-- 2026-10-17「养护手册」重构：原生导航栏已写标题，自绘页头与固定 scroll-view 退场，改为页面滚动 -->
    <view class="care-skeleton" wx:if="{{loading}}">
      <view class="sk-block sk-hero"></view>
      <view class="sk-block sk-row" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>

    <view class="care-content {{pageReady ? 'ready' : ''}}" wx:else>
      <view class="intro care-enter care-enter-d1">
        <text class="intro-overline">MY SPECIMENS · 我的藏品</text>
        <text class="intro-title">每一件，都有它自己的那一页</text>
        <text class="intro-text">已签收的藏品，点开查看对应的养护指南</text>
      </view>

      <view class="load-error care-enter care-enter-d2" wx:if="{{loadError}}">
        <text class="empty-title">藏品加载失败</text>
        <text class="empty-desc">请检查网络后重试</text>
        <view class="empty-btn" bindtap="retryLoad" hover-class="care-press">重新加载</view>
      </view>

      <view class="list care-enter care-enter-d2" wx:elif="{{specimens.length}}">
        <view class="list-count">共 {{specimens.length}} 件</view>
        <view
          class="spec-card"
          wx:for="{{specimens}}"
          wx:key="key"
          hover-class="tap-press-soft"
          hover-stay-time="80"
          bindtap="openSpecimen"
          data-category="{{item.category}}"
          data-order-id="{{item.orderId}}"
          data-product-id="{{item.productId}}"
        >
          <view class="spec-frame">
            <image class="spec-cover" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}"></image>
            <view class="spec-cover placeholder" wx:else>
              <text class="cover-letter">{{item.categoryOverline[0]}}</text>
            </view>
          </view>
          <view class="spec-body">
            <text class="spec-title">{{item.title}}</text>
            <view class="spec-tags">
              <text class="tag-cat">{{item.categoryLabel}}</text>
              <text class="tag-custom" wx:if="{{item.isCustom}}">定制</text>
              <text class="tag-date" wx:if="{{item.receiveTimeText}}">{{item.receiveTimeText}}</text>
            </view>
            <!-- 陪伴第 N 天（2026-10-18）：只按真实签收时间算；整百天换成铜色小印 -->
            <view class="spec-days {{item.companionDays % 100 === 0 ? 'is-mark' : ''}}" wx:if="{{item.companionDays > 0}}">
              <text class="spec-days-k">陪伴第</text>
              <text class="spec-days-n">{{item.companionDays}}</text>
              <text class="spec-days-k">天</text>
            </view>
            <text class="spec-framing" wx:if="{{item.framingName}}">装裱：{{item.framingName}}</text>
            <text class="spec-summary">{{item.careSummary}}</text>
          </view>
          <view class="spec-chevron"><text>›</text></view>
        </view>
      </view>

      <view class="empty care-enter care-enter-d2" wx:else>
        <text class="empty-title">还没有已签收藏品</text>
        <text class="empty-desc">确认收货后，藏品会出现在这里，并匹配对应养护指南</text>
        <view class="empty-btn" bindtap="goToHub" hover-class="care-press">浏览品类养护 →</view>
      </view>
    </view>

</view>
