/* subpackages/feature/care/care-common.wxss — 标本养护模块共享样式 */

.grain-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  opacity: 0.35;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
}

/* ── 导航头 ── */
.care-header {
  position: relative;
  z-index: 10;
  box-sizing: border-box;
  padding: var(--space-2) var(--space-4) var(--space-3);
  background: rgba(26, 24, 20, 0.96);
  border-bottom: 1px solid var(--color-border);
}

.care-nav-inner {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}

.care-header::after {
  content: '';
  position: absolute;
  left: var(--space-4);
  right: var(--space-4);
  bottom: 0;
  height: 1px;
  background: var(--brass-800);
  opacity: 0.55;
}

.care-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  transition: border-color var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
}

.care-back .page-nav-back-icon {
  width: 48rpx;
  height: 48rpx;
}

.care-back-hover {
  background: rgba(196, 167, 108, 0.06);
  border-color: var(--color-border);
}

.care-brand {
  flex: 1;
  min-width: 0;
}

.care-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.care-title-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.care-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.care-sub {
  display: block;
  font-size: 18rpx;
  color: var(--brass-400);
  letter-spacing: 0.14em;
  margin-top: 6rpx;
}

.care-header-spacer {
  width: 72rpx;
  flex-shrink: 0;
}

.care-header-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 1px solid;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.care-header-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

/* ── 滚动区 ── */
.care-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding: 0 var(--space-4);
  box-sizing: border-box;
  overflow-x: hidden;
}

.care-scroll-pad {
  height: calc(64rpx + env(safe-area-inset-bottom));
}

/* ── 区块标题 ── */
.care-section {
  margin-bottom: var(--space-5);
}

.care-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

.care-section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--brass-400);
  letter-spacing: 0.1em;
}

.care-section-label::before {
  content: '';
  width: 6rpx;
  height: 22rpx;
  border-radius: 3rpx;
  background: var(--brass-400);
  opacity: 0.85;
}

.care-section-more {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 0;
}

.care-more-hover {
  color: var(--brass-400);
}

/* ── 入场动效 ── */
@keyframes careFadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes careFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes carePulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.15); }
}

@keyframes careShimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes careArrowNudge {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(6rpx); }
}

.care-content.ready .care-enter {
  animation: careFadeUp 0.55s cubic-bezier(0.22, 0.8, 0.22, 1) forwards;
  opacity: 0;
}

.care-enter-d1 { animation-delay: 0.05s !important; }
.care-enter-d2 { animation-delay: 0.12s !important; }
.care-enter-d3 { animation-delay: 0.19s !important; }
.care-enter-d4 { animation-delay: 0.26s !important; }
.care-enter-d5 { animation-delay: 0.33s !important; }
.care-enter-d6 { animation-delay: 0.40s !important; }

/* ── 按压反馈 ── */
.care-press {
  transform: scale(0.98);
  opacity: 0.92;
}

.care-card-hover {
  background: var(--color-bg-elevated) !important;
  border-color: var(--brass-800) !important;
}

/* ── 骨架屏 ── */
.care-skeleton {
  padding: var(--space-2) 0 var(--space-4);
}

.sk-block {
  border-radius: var(--radius-lg);
  background: linear-gradient(
    90deg,
    var(--color-bg-card) 0%,
    var(--color-bg-elevated) 50%,
    var(--color-bg-card) 100%
  );
  background-size: 200% 100%;
  animation: careShimmer 1.4s ease-in-out infinite;
}

.sk-hero {
  height: 160rpx;
  margin-bottom: var(--space-4);
}

.sk-row {
  height: 140rpx;
  margin-bottom: var(--space-2);
}

.sk-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.sk-grid-item {
  height: 168rpx;
}

/* ── 支持条 ── */
.care-support {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid var(--color-border-highlight);
  border-radius: var(--radius-lg);
  position: relative;
  overflow: hidden;
}

.care-support::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: var(--brass-400);
  opacity: 0.7;
}

.care-support-main {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
}

.care-support-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-body);
  font-weight: 500;
}

.care-support-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  line-height: 1.45;
}

.care-support-cta {
  font-size: 24rpx;
  color: var(--brass-400);
  flex-shrink: 0;
  animation: careArrowNudge 2s ease-in-out infinite;
}

.care-support-hover {
  background: rgba(196, 167, 108, 0.1);
}

/* ── 空态 / 失败 ── */
.care-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 24rpx 48rpx;
  text-align: center;
  box-sizing: border-box;
}

.care-empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: var(--space-4);
  border-radius: 50%;
  border: 1rpx solid var(--brass-800);
  background: rgba(196, 167, 108, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.care-empty-icon image {
  width: 44rpx;
  height: 44rpx;
}

.care-empty-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-body);
  margin-bottom: 12rpx;
}

.care-empty-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: 32rpx;
}

.care-empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-bg);
  background: var(--brass-400);
  border-radius: var(--radius-md);
}

.care-empty-btn.ghost {
  color: var(--brass-400);
  background: transparent;
  border: 1rpx solid var(--brass-400);
}

/* ── 底部主次按钮 ── */
.care-footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: var(--space-3);
  box-sizing: border-box;
  padding: 16rpx var(--space-4) calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(26, 24, 20, 0.96);
  border-top: 1px solid var(--color-border);
}

.care-footer-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.care-footer-btn.primary {
  background: var(--brass-400);
  color: var(--color-bg);
}

.care-footer-btn.secondary {
  background: transparent;
  border: 1rpx solid var(--brass-400);
  color: var(--brass-400);
}

.care-footer-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
