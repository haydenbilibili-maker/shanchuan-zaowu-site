/* subpackages/feature/community/publish/index.wxss */
page {
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.page-publish {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.pub-nav {
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg);
  padding-left: 28rpx;
  box-sizing: border-box;
}

.pub-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-side {
  min-width: 120rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: var(--fs-28);
  color: var(--color-text-secondary);
  padding: 12rpx 0;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 0 16rpx;
}

.nav-side-right {
  /* 与左侧「取消」等宽，保证标题居中 */
}

.pub-scroll {
  flex: 1;
  box-sizing: border-box;
}

.media-section {
  padding: 28rpx 28rpx 8rpx;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-cell,
.media-add {
  /* 留余量：原 3×(33.333% - 8rpx) + 2×12rpx = 恰好 100%（错题本 E26）；行数不定，保留 gap 维持左对齐 */
  width: 31.8%;
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.media-cell {
  background: var(--color-bg-elevated);
}

.media-img {
  width: 100%;
  height: 100%;
}

.media-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(26, 24, 20, 0.72);
  color: #fff;
  font-size: var(--fs-28);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.media-cover-tag {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  font-size: var(--fs-18);
  color: var(--color-bg);
  background: var(--brass-400);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
}

.media-add {
  border: 1px dashed var(--color-border-highlight);
  background: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.media-add text {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.add-plus {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}
.add-plus-h,
.add-plus-v {
  position: absolute;
  background: var(--brass-400);
  border-radius: 2rpx;
}
.add-plus-h {
  left: 0;
  right: 0;
  top: 50%;
  height: 4rpx;
  margin-top: -2rpx;
}
.add-plus-v {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 4rpx;
  margin-left: -2rpx;
}

.media-hint {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.video-cover-box {
  position: relative;
  width: 240rpx;
  height: 320rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-card);
  border: 1px dashed var(--color-border-highlight);
  margin-bottom: 24rpx;
}

.video-cover-img {
  width: 100%;
  height: 100%;
}

.video-cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--color-text-muted);
  font-size: var(--fs-24);
}

.video-cover-badge {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  font-size: var(--fs-20);
  color: var(--color-bg);
  background: var(--brass-400);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.editor-section {
  padding: 16rpx 28rpx 24rpx;
  border-bottom: 1px solid var(--color-border);
}

.title-input {
  width: 100%;
  font-size: var(--fs-32);
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 16rpx 0;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 16rpx;
}

.body-input {
  width: 100%;
  min-height: 240rpx;
  font-size: var(--fs-28);
  line-height: 1.65;
  color: var(--color-text-body);
}

.char-count {
  display: block;
  text-align: right;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.tags-section,
.category-section {
  padding: 24rpx 28rpx;
  border-bottom: 1px solid var(--color-border);
}

.section-label {
  display: block;
  font-size: var(--fs-26);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-chip {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
}

.tag-chip.on {
  color: var(--brass-400);
  border-color: var(--color-border-highlight);
  background: rgba(196, 167, 108, 0.1);
}

.tag-input,
.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--fs-26);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.form-row {
  margin-top: 8rpx;
}

.form-label {
  display: block;
  font-size: var(--fs-24);
  color: var(--brass-400);
  margin-bottom: 12rpx;
}

.cat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cat-chip {
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
}

.cat-chip.on {
  color: var(--brass-400);
  border-color: var(--color-border-highlight);
  background: rgba(196, 167, 108, 0.1);
}

.ph {
  color: var(--color-text-muted);
}

.scroll-pad {
  height: 32rpx;
}

.pub-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--color-bg) 70%, rgba(26, 24, 20, 0));
  border-top: 1px solid var(--color-border);
  z-index: 20;
}

.footer-submit {
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
}

.footer-submit.ready {
  color: var(--color-bg);
  background: var(--brass-400);
  border-color: var(--brass-400);
  font-weight: 600;
}

.footer-submit.ready:active {
  background: var(--brass-500);
}

/* 入展展签（2026-10-18）：与反馈回执 / 入藏卡同一张纸、同一方朱印 */
.exhibit-mask { z-index: 900; }
.exhibit-tag {
  position: relative;
  width: 540rpx;
  padding: 44rpx 44rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 14rpx #F0E8D6, inset 0 0 0 15rpx rgba(46, 38, 24, 0.22), 0 24rpx 60rpx rgba(0, 0, 0, 0.55);
  animation: ex-rise 0.36s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}
.ex-en { display: block; font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: 0.28em; color: #8B6F47; }
.ex-title {
  display: block;
  margin-top: 10rpx;
  padding-right: 110rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 700;
  line-height: 1.35;
  color: #2E2618;
}
.ex-rule { width: 72rpx; height: 2rpx; margin: 18rpx 0 14rpx; background: #B08D57; }
.ex-row { display: flex; gap: 20rpx; padding: 6rpx 0; font-size: var(--fs-24); }
.ex-k { flex-shrink: 0; color: #8A7F6C; letter-spacing: 0.1em; }
.ex-v { color: #2E2618; }
.ex-v.mono { font-family: var(--font-mono); letter-spacing: 0.06em; }
.ex-seal {
  position: absolute;
  right: 40rpx;
  top: 40rpx;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(168, 53, 42, 0.85);
  border-radius: 6rpx;
  box-shadow: inset 0 0 0 3rpx rgba(243, 236, 221, 0.5), inset 0 0 0 5rpx rgba(168, 53, 42, 0.5);
  color: rgba(168, 53, 42, 0.9);
  transform: rotate(-12deg);
  animation: ex-seal 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.2) 0.4s both;
}
.ex-seal-ch { font-family: var(--font-brand); font-size: 30rpx; font-weight: 700; line-height: 34rpx; }
@keyframes ex-rise { from { opacity: 0; transform: translateY(48rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes ex-seal {
  0% { opacity: 0; transform: rotate(-12deg) scale(1.9); }
  60% { opacity: 1; transform: rotate(-12deg) scale(0.94); }
  100% { opacity: 1; transform: rotate(-12deg) scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .exhibit-tag,
  .ex-seal { animation: none; }
}
