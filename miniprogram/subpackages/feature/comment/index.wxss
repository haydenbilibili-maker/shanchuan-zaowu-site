/* subpackages/feature/comment/index.wxss — Museum Mode */
page {
  background-color: #1A1814;
  color: #D5D1C8;
  overscroll-behavior-x: none;
  overflow-x: hidden;
  height: 100vh;
}

.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

.scroll-container {
  width: 100%;
  flex-shrink: 0;
  height: calc(100vh - 160rpx - env(safe-area-inset-bottom));
  max-height: calc(100vh - 160rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content-wrapper {
  padding: 0;
  padding-bottom: 40rpx;
  min-height: 100%;
}

.bottom-spacer {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: calc(88rpx + env(safe-area-inset-top));
  background: #1A1814;
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  border-bottom: 1px solid #26232066;
  box-sizing: border-box;
}

.back-btn {
  position: absolute;
  left: 16rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn-press {
  opacity: 0.7;
}

.back-arrow {
  font-size: 48rpx;
  color: #C4A76C;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 0.04em;
}

.gate-card {
  margin: 40rpx 32rpx;
  padding: 48rpx 32rpx;
  background: #1F1D1A;
  border: 1px solid #26232066;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gate-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.gate-text {
  font-size: 26rpx;
  color: #A09A90;
  line-height: 1.6;
}

.gate-actions {
  margin-top: 16rpx;
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border: 1px solid #C4A76C;
  border-radius: 16rpx;
  color: #C4A76C;
  font-size: 26rpx;
}

.header-section {
  padding: 30rpx;
  margin-bottom: 8rpx;
}

.target-info {
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  background: #1F1D1A;
  border: 1px solid #4D401A;
  border-radius: 24rpx;
}

.target-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #262320;
}

.target-details {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.target-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.target-subtitle {
  font-size: 24rpx;
  color: #C4A76C;
  font-style: italic;
  margin-bottom: 8rpx;
}

.target-hint {
  font-size: 22rpx;
  color: #A09A90;
}

.product-pick {
  margin: 0 32rpx 24rpx;
}

.product-pick-scroll {
  white-space: nowrap;
  margin-top: 12rpx;
}

.product-chip {
  display: inline-flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 200rpx;
  max-width: 280rpx;
  padding: 20rpx 24rpx;
  margin-right: 16rpx;
  background: #1F1D1A;
  border: 1px solid #26232066;
  border-radius: 16rpx;
  vertical-align: top;
}

.product-chip.active {
  border-color: #C4A76C;
}

.product-chip.done {
  opacity: 0.72;
}

.chip-title {
  font-size: 24rpx;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-status {
  font-size: 20rpx;
  color: #A09A90;
}

.rating-section,
.content-section,
.image-section {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: #1F1D1A;
  border: 1px solid #26232066;
  border-radius: 24rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #C4A76C;
  margin-bottom: 24rpx;
  letter-spacing: 0.08em;
}

.rating-stars {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  padding: 8rpx 0 12rpx;
}

.star {
  font-size: 56rpx;
  color: #4A4540;
  line-height: 1;
}

.star.active {
  color: #C4A76C;
}

.rating-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #C4A76C;
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  padding: 24rpx;
  background: #262320;
  border: 1px solid #4D401A66;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #D5D1C8;
  line-height: 1.7;
  box-sizing: border-box;
}

.input-placeholder {
  color: #6B6560;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #6B6560;
  margin-top: 12rpx;
}

.image-list {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.uploaded-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 1px solid #26232066;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  /* 2026-09-21 分子级审计：原字面量 #D64045 配白字仅 4.489（AA 需 4.5）→ 用令牌（4.74） */
  background: var(--color-error);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  z-index: 10;
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  border: 1px dashed #C4A76C66;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.upload-icon {
  font-size: 40rpx;
  color: #C4A76C;
  margin-bottom: 6rpx;
  font-weight: 300;
}

.upload-text {
  font-size: 22rpx;
  color: #A09A90;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #1A1814;
  border-top: 1px solid #26232066;
  z-index: 100;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: #C4A76C;
  color: #1A1814;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 96rpx;
}

.submit-btn:active {
  background: #A8903C;
}

.submit-btn.submitting,
.submit-btn[disabled] {
  background: #262320;
  color: #6B6560;
}
