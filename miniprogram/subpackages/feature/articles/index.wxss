/* subpackages/feature/articles/index.wxss */
page {
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.page-articles {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.page-header {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 20rpx;
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg);
}

.header-left,
.header-right {
  width: 72rpx;
  flex-shrink: 0;
}

.header-brand {
  flex: 1;
  text-align: center;
}

.brand-cn {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  font-family: var(--font-heading);
  color: var(--color-text-primary);
}

.brand-en {
  display: block;
  font-size: 16rpx;
  color: var(--brass-600);
  letter-spacing: 0.1em;
  margin-top: 6rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}


.filter-bar {
  background: var(--color-bg-card);
  border-bottom: 1px solid var(--color-border);
  padding: 20rpx 32rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.category-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.category-chip.active {
  background: rgba(196, 167, 108, 0.1);
  border-color: var(--color-border-highlight);
  color: var(--brass-400);
  font-weight: 500;
}

.category-scroll-pad {
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
}

.search-row {
  margin-bottom: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  padding: 0 24rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.ph {
  color: var(--color-text-muted);
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sort-group {
  display: flex;
  gap: 12rpx;
}

.sort-chip {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  /* 2026-09-21 分子级审计：#6B6560 在 --color-bg-elevated 上仅 2.72（AA 需 4.5）→ secondary（5.60） */
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1px solid transparent;
}

.sort-chip.active {
  color: var(--brass-400);
  border-color: var(--color-border-highlight);
  background: rgba(196, 167, 108, 0.08);
}

.link-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid var(--color-border-highlight);
  background: rgba(196, 167, 108, 0.06);
}

.link-chip text {
  font-size: 22rpx;
  color: var(--brass-400);
}

.link-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.8;
}

.articles-list {
  padding: 24rpx 32rpx;
}

.article-card {
  display: flex;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.article-card:active {
  border-color: var(--color-border-highlight);
  background: var(--color-bg-elevated);
}

.article-cover {
  width: 220rpx;
  height: 168rpx;
  flex-shrink: 0;
  background: var(--color-bg-elevated);
}

.article-body {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.article-top {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.tag-category {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  font-size: 20rpx;
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.1);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(77, 64, 26, 0.35);
  white-space: nowrap;
  box-sizing: border-box;
}

.tag-ugc {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  font-size: 20rpx;
  color: var(--color-forest);
  background: rgba(45, 90, 63, 0.12);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  white-space: nowrap;
  box-sizing: border-box;
}

.article-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-brief {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.55;
}

.article-foot {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-stats {
  display: flex;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.stat-icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.55;
}

.article-author {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-box {
  text-align: center;
  padding: 60rpx 32rpx;
}

.state-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.state-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
