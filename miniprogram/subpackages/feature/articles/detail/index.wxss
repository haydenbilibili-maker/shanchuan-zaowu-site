/* subpackages/feature/articles/detail/index.wxss */
page {
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.container {
  min-height: 100vh;
  background: var(--color-bg);
}

.load-error-overlay {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
  gap: 16rpx;
  position: relative;
}
.load-error-title { color: var(--color-text-primary); font-size: var(--fs-34); font-weight: 500; }
.load-error-desc { color: var(--color-text-secondary); font-size: var(--fs-26); line-height: 1.5; margin-bottom: 24rpx; }
.load-error-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 480rpx;
}
.load-error-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: var(--fs-28);
}
.load-error-btn.primary {
  background: var(--color-primary);
  color: var(--color-bg);
  border: none;
}

/* ── Hero ── */
.hero-area {
  position: relative;
  height: 560rpx;
  width: 100%;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(26, 24, 20, 0.08) 35%, var(--color-bg) 100%);
}

.hero-text {
  position: absolute;
  bottom: 48rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 2;
}

.article-category {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-22);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.12);
  border: 1px solid rgba(77, 64, 26, 0.4);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

.category-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.85;
}

.article-title {
  font-size: var(--fs-44);
  color: var(--color-text-primary);
  font-weight: 600;
  font-family: var(--font-brand);
  display: block;
  line-height: 1.35;
  margin-bottom: 14rpx;
  letter-spacing: 0.04em;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.meta-divider {
  color: var(--color-text-muted);
}

.back-btn {
  position: fixed;
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  background: rgba(26, 24, 20, 0.45);
  backdrop-filter: blur(8px);
  border-radius: 50%;
  border: 1px solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.back-btn:active {
  opacity: 0.88;
}


.share-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: inherit;
}

.share-btn::after { border: none; }

.comment-section {
  border-top: 1px solid var(--color-border);
  background: var(--color-bg);
}

.note-gallery {
  position: relative;
  background: var(--color-bg);
}

.gallery-swiper {
  width: 100%;
  height: 750rpx;
}

.gallery-img {
  width: 100%;
  height: 100%;
}

.gallery-head {
  padding: 32rpx;
}

.gallery-title {
  position: static;
  text-shadow: none;
  margin-top: 16rpx;
}

.gallery-back {
  position: fixed;
  z-index: 100;
}

/* ── 正文 ── */
.article-body {
  padding: 36rpx 32rpx;
  background: var(--color-bg);
  min-height: 400rpx;
}

.intro-text {
  font-size: var(--fs-28);
  font-weight: 400;
  color: var(--brass-300);
  font-style: italic;
  font-family: var(--font-brand);
  margin-bottom: 32rpx;
  padding: 0 20rpx;
  border-left: 4rpx solid var(--brass-600);
  line-height: 1.75;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  padding: 6rpx 16rpx;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  white-space: nowrap;
  box-sizing: border-box;
}

.rich-text-container {
  color: var(--color-text-body);
  font-size: var(--fs-30);
  line-height: 1.8;
  text-align: justify;
  margin-bottom: 32rpx;
}

.video-container {
  position: relative;
  margin: 32rpx 0;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
}

.article-video {
  width: 100%;
  height: 400rpx;
  background: var(--color-bg-elevated);
}

.video-controls {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  z-index: 10;
}

.control-item {
  padding: 10rpx 18rpx;
  background: var(--brass-400);
  color: var(--color-bg);
  border-radius: var(--radius-full);
  font-size: var(--fs-22);
  font-weight: 600;
  font-family: var(--font-mono);
}

/* ── 统计栏 ── */
.stats-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 28rpx 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  margin: 32rpx 0 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.stat-icon.liked,
.stat-icon.collected {
  opacity: 1;
}

.stat-value {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

/* ── 相关推荐 ── */
.related-section {
  padding: 32rpx;
  background: var(--color-bg-card);
  border-top: 1px solid var(--color-border);
}

.section-head {
  margin-bottom: 24rpx;
}

.section-overline {
  display: block;
  font-size: var(--fs-18);
  color: var(--brass-600);
  letter-spacing: 0.14em;
  margin-bottom: 6rpx;
}

.section-title {
  display: block;
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--color-text-primary);
  font-family: var(--font-heading);
}

.related-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.related-item {
  display: flex;
  background: var(--color-bg-elevated);
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--color-border);
}

.related-item:active {
  border-color: var(--color-border-highlight);
}

.related-cover {
  width: 200rpx;
  height: 150rpx;
  flex-shrink: 0;
  background: var(--color-bg-card);
}

.related-content {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.related-title {
  font-size: var(--fs-26);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.45;
}

.related-brief {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.related-stats {
  display: flex;
  gap: 16rpx;
}

.related-stat {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.related-stat-icon {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.55;
}

/* ===== 转载来源与许可（末尾署名）===== */
.source-block {
  margin: 32rpx 32rpx 0;
  padding: 24rpx 26rpx;
  border-radius: var(--radius-md, 16rpx);
  background: var(--color-bg-card, rgba(255, 255, 255, 0.03));
  border: 1rpx solid var(--color-border, rgba(196, 167, 108, 0.18));
  display: flex;
  flex-direction: column;
}
.source-label {
  font-size: var(--fs-20);
  letter-spacing: 0.14em;
  color: var(--color-primary, #C4A76C);
  margin-bottom: 14rpx;
}
.source-title {
  font-size: var(--fs-26);
  line-height: 1.5;
  color: var(--color-text-primary, #E8E4DC);
}
.source-line {
  margin-top: 8rpx;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-secondary, #A8A29A);
}
.source-note {
  margin-top: 14rpx;
  font-size: var(--fs-20);
  line-height: 1.6;
  color: var(--color-text-secondary, #A8A29A);
  opacity: 0.85;
}
.source-link {
  margin-top: 18rpx;
  align-self: flex-start;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-primary, #C4A76C);
  font-size: var(--fs-22);
  color: var(--color-primary, #C4A76C);
}

/* ================================================================
   阅读仪式（2026-10-18 产品负责人「继续看还有哪些模块…可做微创新」）
   顶部 2rpx 黄铜进度线；标题下「约 N 分钟读完」；正文读到末尾盖「读毕」小朱印（与馆印同一套落印）。
   ================================================================ */
.read-progress {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  height: 4rpx;
  z-index: 50;
  background: rgba(196, 167, 108, 0.12);
  pointer-events: none;
}
.read-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.5), var(--brass-300, #D4BC85));
  transition: width 0.15s linear;
}
.read-end {
  margin: 40rpx 0 24rpx;
}
.read-end-rule {
  height: 1px;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent);
}
.read-end-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
  padding-left: 8rpx;
}
.read-seal {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(196, 72, 58, 0.85);
  border-radius: 6rpx;
  box-shadow: inset 0 0 0 4rpx rgba(26, 24, 20, 0.9), inset 0 0 0 6rpx rgba(196, 72, 58, 0.45);
  transform: rotate(-10deg);
  animation: read-seal-stamp 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
}
.read-seal-ch {
  font-family: var(--font-brand);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 30rpx;
  color: rgba(214, 92, 76, 0.95);
}
@keyframes read-seal-stamp {
  0% { opacity: 0; transform: rotate(-10deg) scale(1.9); }
  60% { opacity: 1; transform: rotate(-10deg) scale(0.94); }
  100% { opacity: 1; transform: rotate(-10deg) scale(1); }
}
.read-end-en {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300, #D4BC85);
}
.read-end-cn {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
}
@media (prefers-reduced-motion: reduce) {
  .read-seal { animation: none; }
  .read-progress-fill { transition: none; }
}
