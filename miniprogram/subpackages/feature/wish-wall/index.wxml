<!--subpackages/feature/wish-wall/index.wxml
  需求 28：马上有 · 弹幕祈福墙
  ⚠️ 类名一律 ww- 前缀：本页曾把点灯卡片命名为 .lamp，与 app.wxss 的全局信号灯基类
  .lamp（12rpx 圆点、flex-shrink:0）撞车 —— 卡片被压成 6px 宽竖条，文案一字一行被裁切。
  页面类名不得与全局撞车，已由 npm run test:wish-wall 的全仓守卫钉住。 -->
<view class="ww-page">
  <view class="ww-grain" aria-hidden="true"></view>

  <!-- 牌匾式纸质页头：浅纸 + 铜字，与礼赠页的标本纸页头同一语言 -->
  <view class="ww-hero">
    <view class="ww-fiber" aria-hidden="true"></view>
    <view class="ww-emboss" aria-hidden="true"></view>
    <view class="ww-wm" aria-hidden="true"></view>
    <view class="ww-hero-body">
      <view class="ww-hero-top">
        <text class="ww-over">WISH WALL · 马上有愿</text>
        <!-- 灯的状态直接写进页头：今日已点 = 铜灯亮，未点 = 空心 -->
        <view class="signal-light {{lamp.lit ? 'lamp-brass on' : 'lamp-muted hollow'}}" aria-hidden="true"></view>
        <view class="ww-seal" aria-hidden="true"><view class="ww-seal-inner"></view></view>
      </view>
      <text class="ww-brand">山海造物</text>
      <!-- 主标题固定「祈福墙」：入口传进来的 title 本身就是「马上有」，
           写「{{productTitle}} · 祈福墙」会变成「马上有 · 祈福墙」重复两遍 -->
      <text class="ww-title">祈福墙</text>
      <!-- 这一行右侧原本空着（印泥/水印之外没有任何内容）。祈运标签挪上来：
           ① 第一屏就能看到"这面墙求什么"（不必滚到玩法区）② 玩法区因此省下一条提示的高度 -->
      <view class="ww-scope-row">
        <!-- 产品 chip 本身就是**产品链路的常驻入口**（第一屏就能到详情页）。
             以前只有抽完玩法才在结果卡里出现「看这件藏品」，链路藏得太深。 -->
        <text
          class="ww-scope {{productId ? 'is-link' : ''}}"
          wx:if="{{productTitle}}"
          bindtap="goProduct"
          hover-class="ww-scope-press"
          hover-stay-time="70"
          aria-role="{{productId ? 'link' : 'text'}}"
        >{{productTitle}}{{productId ? ' ›' : ''}}</text>
        <text class="ww-bless" wx:if="{{blessLabelText}}">偏「{{blessLabelText}}」</text>
      </view>
      <text class="ww-hint">把想成真的心愿挂上墙。轻一点写，短一点说。</text>
    </view>
  </view>

  <!-- 未开放：不发任何请求，只给一句解释 -->
  <view class="ww-closed" wx:if="{{flagChecked && !allowed}}">
    <view class="ww-closed-lamp" aria-hidden="true">
      <view class="signal-light lamp-muted hollow" aria-hidden="true"></view>
    </view>
    <text class="ww-closed-title">祈福墙暂未开放</text>
    <text class="ww-closed-desc">馆方正在准备这块墙面，稍后再来看看。</text>
  </view>

  <block wx:else>
    <!-- 墙面：浅纸墙 + 轨道化弹幕。同轨严格不重叠（排期见 utils/wishWall.buildDanmakuRows） -->
    <view
      class="ww-wall {{echoRows.length ? 'is-echo' : ''}}"
      aria-label="{{rows.length ? rows.length + ' 条心愿在墙上流动，轻点一条可展开愿签' : '祈福墙'}}"
    >
      <view class="ww-wall-fiber" aria-hidden="true"></view>
      <view class="ww-wall-inner">
        <!-- 刻度必须和内层同坐标系：挂在整面墙上会因底部页脚高度而逐轨错开 -->
        <view class="ww-wall-rail rail-1" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-2" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-3" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-4" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-5" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-6" aria-hidden="true"></view>
        <!-- 加载中：四条轨道各出一条浅纸微光条（全站约定是骨架，不是一行字） -->
        <block wx:if="{{loading}}">
          <view class="ww-wall-skel skel-1" aria-hidden="true"></view>
          <view class="ww-wall-skel skel-2" aria-hidden="true"></view>
          <view class="ww-wall-skel skel-3" aria-hidden="true"></view>
          <view class="ww-wall-skel skel-4" aria-hidden="true"></view>
        </block>
        <block wx:else>
          <view
            class="ww-danmaku ww-tone-{{item.tone}}"
            wx:for="{{rows}}"
            wx:key="key"
            style="top:{{item.topPercent}}%; animation-duration:{{item.durationMs}}ms; animation-delay:{{item.delayMs}}ms;"
            bindtap="openWishCard"
          data-id="{{item.id}}"
          hover-class="ww-danmaku-press"
          hover-stay-time="70"
          aria-role="button"
          aria-label="{{item.text}}"
        >
              <text class="ww-emoji" wx:if="{{item.emoji}}">{{item.emoji}}</text>
          <!-- 墙面只保留**置顶**标记（铜钉）；「馆方」与愿签卡一起下线（2026-09-18 产品决定） -->
          <view
            class="ww-dm-mark {{item.pinned ? 'is-pinned' : ''}}"
            wx:if="{{item.pinned}}"
            aria-hidden="true"
          ></view>
          <text class="ww-dm-text {{item.id === freshId ? 'is-fresh' : ''}}">{{item.text}}</text>
        </view>
          <!-- ⚠️ 失败时不得说「墙面还是空的」——那是把加载失败谎报成没人许愿 -->
          <view class="ww-wall-empty" wx:if="{{!rows.length}}">
            <view class="ww-wall-empty-mark" aria-hidden="true"></view>
            <text class="ww-wall-empty-title">{{loadError ? '墙面未展开' : '墙面还是空的'}}</text>
            <text class="ww-wall-empty-desc">{{loadError ? '网络或权限异常，可在下方重试' : '做第一个许愿的人'}}</text>
          </view>
        </block>
      </view>
      <!-- 墙页脚＝「墙面 → 愿签列表」的快捷入口：弹幕看得快、愿签看得清，
           看完流动的手指自然会想"有没有一条是我的/我想细看"。这行文字是可点的，
           省掉"手动往下滚一屏"这一步（交互优化，2026-09-18） -->
      <view
        class="ww-wall-foot"
        wx:if="{{rows.length}}"
        bindtap="goWishList"
        hover-class="ww-wall-foot-press"
        hover-stay-time="70"
        aria-role="button"
        aria-label="{{items.length}} 条心愿，点击查看愿签列表"
      >
        <view class="signal-light lamp-brass" aria-hidden="true"></view>
        <text class="ww-wall-foot-text">{{items.length}} 条心愿正在墙上流动</text>
        <text class="ww-wall-foot-more">看全部 ›</text>
      </view>
      <view class="ww-wall-foot is-loading" wx:elif="{{loading}}">
        <view class="signal-light lamp-muted" aria-hidden="true"></view>
        <text class="ww-wall-foot-text">正在展开墙面…</text>
      </view>
      <!-- 即时反馈回声：点灯 / 木鱼 / 落愿（以及后续玩法）之后，墙的页脚回一句、边框亮一下。
           为什么放页脚这一条 44rpx 带里：四条弹幕轨道的第 4 条落在 84%，轨下只剩 ~17rpx，
           塞不下任何东西；页脚是墙内**唯一**不会被弹幕穿过的位置（overflow:hidden 已裁好）。
           为什么是数组 + wx:key：连点要**重播**动画，同 key 不会重播（与弹幕轮播同一手法）。 -->
      <view
        class="ww-echo"
        wx:for="{{echoRows}}"
        wx:key="key"
        aria-label="{{item.text}}{{item.sub ? ' ' + item.sub : ''}}"
        aria-role="alert"
      >
        <view class="signal-light lamp-brass" aria-hidden="true"></view>
        <text class="ww-echo-text">{{item.text}}</text>
        <text class="ww-echo-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
      </view>
    </view>
    <!-- 祈福动作区：点灯 + 木鱼并列（产品负责人 2026-09-19 版式） -->
    <view class="ww-ritual-row">
    <!-- 灯龛：零门槛的入场动作。点完亮出当天那一句，同一天复现同一句。
         光晕是灯座盒子的子元素（不再用行内绝对定位），文案列 flex:1 —— 布局不会被压塌 -->
    <view
      class="ww-lantern {{lamp.lit ? 'is-lit' : 'is-idle'}}"
      bindtap="onLampTap"
      hover-class="ww-lantern-press"
      hover-stay-time="70"
      aria-role="button"
      aria-label="{{lamp.lit ? '今日灯已点' : '点一盏灯'}}"
    >
      <view class="ww-lantern-box" aria-hidden="true">
        <view class="ww-lantern-halo"></view>
        <view class="ww-lantern-core"></view>
      </view>
      <!-- 点灯爱心动效：一次性飘起（heartBurst 由 js 短暂置真，2.6s 后收起） -->
      <view class="ww-hearts" wx:if="{{heartBurst}}" aria-hidden="true">
        <text class="ww-heart h1">♥</text>
        <text class="ww-heart h2">♥</text>
        <text class="ww-heart h3">♥</text>
        <text class="ww-heart h4">♥</text>
        <text class="ww-heart h5">♥</text>
      </view>
      <view class="ww-lantern-copy">
        <!-- 标题独占一行：标题与徽章同排时，半宽卡里「今日灯已点」会被挤成两行 -->
        <text class="ww-lantern-title">{{lamp.lit ? '今日灯已点' : '点一盏灯'}}</text>
        <!-- 徽章另起一行且允许折行（窄卡里宁可折行，也不要把标题挤断） -->
        <view class="ww-lantern-meta">
          <!-- 灯位：连续点灯攒出来的层级（1/3/7 天 → 1/3/5 盏）。称号来自 wishWall.lampTier -->
          <text class="ww-lantern-tier" wx:if="{{lamp.lit && lamp.label}}">{{lamp.label}}</text>
          <!-- 今天是个节气就直说 —— 节气灯语优先于通用灯语 -->
          <text class="ww-lantern-solar" wx:if="{{lamp.solar}}">{{lamp.solar.name}}</text>
          <!-- 不是节气日时给"还差几天"：一个"过几天再来"的理由（>7 天不显示，免得成噪音） -->
          <text class="ww-lantern-next" wx:elif="{{lamp.solarNext}}">距{{lamp.solarNext.name}} {{lamp.solarNext.inDays}} 天</text>
        </view>
      </view>
      <view class="ww-streak" wx:if="{{lamp.streak > 1}}">
        <view class="ww-lamps" aria-hidden="true">
          <view class="ww-lamp-dot" wx:for="{{lamp.lampDots}}" wx:key="*this"></view>
        </view>
        <text class="ww-streak-n">{{lamp.streak}}</text>
        <text class="ww-streak-l">天</text>
      </view>
      <!-- 灯语 / 灯位说明整行落在标题块下面（flex-basis:100%）：
           留在文案列里时它只有 ~220rpx 宽，「灯亮着，就还有没说完的心愿。」的第二行只剩
           3 个字（真机截图里的"的心愿。"孤字）—— 产品反馈的「文案过于拥挤」就是从这来的。
           整行之后 13 字以内一行装得下（文案池也按这个上限收过，见 utils/wishRitual.js）。 -->
      <view class="ww-lantern-tail">
        <text class="ww-lantern-line" wx:if="{{lamp.lit}}">{{lamp.line}}</text>
        <text class="ww-lantern-line is-idle" wx:else>点一下，替今天留个记号</text>
        <text class="ww-lantern-note" wx:if="{{lamp.lit && lamp.tierNote}}">{{lamp.tierNote}}</text>
      </view>
    </view>

    <view class="ww-ritual-card" bindtap="onMuyuTap" hover-class="ww-muyu-press" hover-stay-time="70"
      aria-role="button" aria-label="安心木鱼，敲一下静一分">
      <view class="ww-muyu {{muyuBeat ? 'is-beat' : ''}}" aria-hidden="true">
        <view class="ww-muyu-slit"></view>
      </view>
      <view class="ww-muyu-copy">
        <text class="ww-muyu-title">安心木鱼</text>
        <text class="ww-muyu-line">敲一下，静一分</text>
        <text class="ww-muyu-count" wx:if="{{muyuCount}}">功德 {{muyuCount}}</text>
      </view>
      <text class="ww-muyu-plus" wx:if="{{muyuPlus}}">+1</text>
    </view>
    </view>
    <!-- 创新钩子 H2「功德证」次级入口（开关 showMuyuCertificate，缺字段默认关）。
         为什么是**一整行**放在木鱼动作区下方，而不是塞进半宽的木鱼卡里：
         卡宽约 330rpx，中文标签 + 「领证 ›」在 20~22rpx 字号下已接近一行上限，塞进去会折行；
         而且方案 §H2 明确要求"两个证书/记录入口不要与木鱼/点灯视觉并列"（仪式区不许变成功能区）。
         它是**次级**入口：只在里程点出现（阈值在 utils/muyuCertificate.CERT_MILESTONES），
         且不拦截主流程 —— 不点它，木鱼照敲。 -->
    <view
      class="ww-cert-entry"
      wx:if="{{certEntry}}"
      bindtap="onCertEntryTap"
      hover-class="ww-cert-entry-press"
      hover-stay-time="70"
      aria-role="button"
      aria-label="{{certEntry.mode === 'claim' ? '领取功德证' : '回看功德证'}}"
    >
      <text class="ww-cert-entry-tag">{{certEntry.tag}}</text>
      <text class="ww-cert-entry-go">{{certEntry.action}}</text>
    </view>
    <!-- 说明：一行说清玩法，不占版面（原长说明已收进页头一句）+ 音效开关 -->
    <view class="ww-foot-row">
      <text class="ww-foot-note">点一盏灯、敲一下木鱼，心愿挂上墙就会一直流动。</text>
      <view
        class="ww-sound {{soundOn ? 'is-on' : 'is-off'}}"
        bindtap="onToggleSound"
        hover-class="ww-sound-press"
        hover-stay-time="70"
        aria-role="switch"
        aria-checked="{{soundOn}}"
        aria-label="仪式音效"
      >{{soundOn ? '音效 开' : '音效 关'}}</view>
    </view>

    <!-- 发送条（顺流）：**弹幕墙下方、玩法区上方** —— 2026-09-19 产品口径变更，
         原为 `position: fixed; bottom: 0` 吸底（§35）。改顺流后不再需要页面底部预留。
         见文件末尾同名注释块（那里记了取舍与回退方式）。 -->
    <view class="ww-composer">
      <input
        class="ww-input"
        id="wishInput"
        value="{{draft}}"
        maxlength="{{textMax}}"
        confirm-type="send"
        placeholder="例如：马上有闲，马上有缘"
        placeholder-class="ww-input-ph"
        bindinput="onDraftInput"
        bindconfirm="submitWish"
      />
      <view
        class="ww-send {{posting || !draft || quota.exhausted ? 'is-off' : ''}}"
        bindtap="submitWish"
        hover-class="ww-send-press"
        hover-stay-time="70"
        aria-role="button"
        aria-disabled="{{posting || !draft || quota.exhausted ? 'true' : 'false'}}"
      >{{posting ? '挂上…' : (quota.exhausted ? '明天再来' : '挂上墙')}}</view>
    </view>

    <!-- 玩法区（注册表驱动，2026-09-18 需求 5 第一批）：
         点灯 / 木鱼是"动作"，这里是"抽一句" —— 抽到的结果由页尾的**纸签弹层**呈现，
         看完能直接「写成心愿」，形成"抽 → 写 → 上墙"的一条路。
         ⚠️ 瓦片一律 wx:for 注册表，页面不写死玩法名（加玩法只改 config/ritualPlays.js）。 -->
    <view class="ww-plays">
      <view class="ww-plays-head">
        <text class="ww-plays-title">今天的玩法</text>
        <text class="ww-plays-sub">抽一句，顺手写下来</text>
      </view>
      <view class="ww-play-grid">
        <view
          class="ww-play {{playResult && playResult.id === item.id ? 'is-open' : ''}}"
          wx:for="{{plays}}"
          wx:key="id"
          bindtap="onPlayTap"
          data-id="{{item.id}}"
          hover-class="ww-play-press"
          hover-stay-time="70"
          aria-role="button"
          aria-label="{{item.name}}：{{item.hint}}"
        >
          <view class="ww-play-mark" aria-hidden="true">{{item.mark}}</view>
          <view class="ww-play-copy">
            <text class="ww-play-name">{{item.name}}</text>
            <text class="ww-play-hint">{{item.hint}}</text>
          </view>
        </view>
      </view>

      <!-- 纸签弹层（2026-09-18 细节雕刻）：
           结果以前是"就地展开的一张亮色卡"，夹在深色瓦片下既不像卡也不像弹窗 —— 产品反馈"与页面割裂"。
           现在明确身份：**一张签从底部递上来**（遮罩 + 铜色把手 + 印章字标），纸面语言与牌匾/愿签同源。
           标题/正文仍全部来自 utils/ritualPlay 的纯函数（页面零判断）。 -->
      <!-- 需要星座/MBTI 但资料里没有 → 引导去补（不给一个编出来的结果） -->
      <view class="ww-play-need" wx:if="{{playNeed}}">
        <text class="ww-play-need-text">这个玩法要用到你的「{{playNeed.fieldLabel}}」，资料页填一下就好（{{playNeed.gain}}）。</text>
        <view class="ww-play-need-cta" bindtap="goProfileField" hover-class="ww-play-need-press" hover-stay-time="70" aria-role="button">
          去填{{playNeed.fieldLabel}}
        </view>
      </view>
    </view>

    <!-- 写愿签 -->
    <view class="ww-write">
      <view class="ww-inspo" wx:if="{{inspiration.length}}">
        <text class="ww-inspo-label">灵感</text>
        <view class="ww-inspo-row">
          <view
            class="ww-inspo-chip"
            wx:for="{{inspiration}}"
            wx:key="*this"
            bindtap="useInspiration"
            data-text="{{item}}"
            hover-class="ww-inspo-press"
            hover-stay-time="70"
            aria-role="button"
          >{{item}}</view>
        </view>
      </view>


      <view class="ww-write-foot">
        <!-- 额度如实预告（上限与云函数 DAILY_LIMIT 同源）：写了才被拒的体验最差 -->
        <text class="ww-quota {{quota.exhausted ? 'is-done' : ''}}" wx:if="{{quota.cap}}">
          {{quota.exhausted ? '今日 ' + quota.cap + ' 条额度已用完，明天再来' : '今日还可写 ' + quota.left + ' 条'}}
        </text>
        <text class="ww-count">{{draft.length}}/{{textMax}}</text>
      </view>

      <view class="ww-notice" wx:if="{{myHidden > 0}}">
        <view class="signal-light lamp-warn" aria-hidden="true"></view>
        <text class="ww-notice-text">你有 {{myHidden}} 条心愿被馆方暂时收起，未公开展示。</text>
      </view>
    </view>

    <!-- 愿签列表：弹幕看得快，愿签看得清，也便于复制与无障碍阅读。
         id 是墙页脚「看全部 ›」的落点（wx.pageScrollTo 的 selector），改名要同步 goWishList -->
    <view class="ww-head" id="wishList">
      <!-- 两个视图共用一套愿签渲染，只有数据源不同（见页面 applyView）。
           本轮把它从"两个像标题的文字"改成**分段控件**：切换意图要一眼看得出来 -->
      <view class="ww-seg" aria-role="tablist">
        <view
          class="ww-seg-item {{viewMode === 'wall' ? 'is-on' : ''}}"
          bindtap="switchView"
          data-mode="wall"
          hover-class="ww-seg-press"
          hover-stay-time="70"
          aria-role="tab"
          aria-selected="{{viewMode === 'wall'}}"
        >
          <text class="ww-seg-label">墙上的愿签</text>
          <!-- 条数必须挂进**它所属的那一段**：此前它游离在段外、紧挨「我的心愿」，
               看着像在说"我的心愿有 26 条"（真图复核发现）。两段各自带自己的数，语义才自明 -->
          <text class="ww-seg-n" wx:if="{{viewMode === 'wall' && items.length}}">{{items.length}}</text>
        </view>
        <view
          class="ww-seg-item {{viewMode === 'mine' ? 'is-on' : ''}}"
          bindtap="switchView"
          data-mode="mine"
          hover-class="ww-seg-press"
          hover-stay-time="70"
          aria-role="tab"
          aria-selected="{{viewMode === 'mine'}}"
        >
          <text class="ww-seg-label">我的心愿</text>
          <text class="ww-seg-n" wx:if="{{mine.total}}">{{mine.total}}</text>
        </view>
      </view>
    </view>
    <view class="ww-tags">
      <!-- 加载中：愿签骨架（与站点同款铜色微光） -->
      <!-- ⚠️ wx:if 必须放在外层 block 上，**不能与 wx:for 同标签**：
           `wx:for` 与 `wx:if` 写在同一元素上时，编译器不会把它当成
           `wx:elif`/`wx:else` 链的起点，下面的 `wx:elif="{{loadError}}"` 会直接报
           「Bad attr `wx:elif` … `wx:if not found`」——这是 **WXML 编译错误**，
           会让**整个 feature 分包**编译失败，表现为该分包所有页面
           `navigateTo:fail timeout`（2026-09-17 实测定位）。 -->
      <block wx:if="{{loading}}">
      <view class="ww-tag-skel" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="ww-tag-skel-pin" aria-hidden="true"></view>
        <view class="ww-tag-skel-avatar wallet-skel"></view>
        <view class="ww-tag-skel-main">
          <view class="ww-tag-skel-line is-w1 wallet-skel"></view>
          <view class="ww-tag-skel-line is-w2 wallet-skel"></view>
        </view>
      </view>
      </block>
      <!-- ⚠️ 失败必须给重试入口，且不得与「还没有人许愿」同时出现 -->
      <view class="ww-error" wx:elif="{{loadError}}">
        <view class="signal-light lamp-warn" aria-hidden="true"></view>
        <text class="ww-error-text">{{loadError}}</text>
        <view class="ww-error-retry" wx:if="{{allowed}}" bindtap="refresh" hover-class="ww-error-retry-press" hover-stay-time="70" aria-role="button">再试一次</view>
      </view>
      <block wx:else>
      <!-- 两列瀑布：30 条全宽卡片会拉出一条看不到头的列表；
           拆两列后滚动长度减半，也更像"一面贴满愿签的墙" -->
      <view class="ww-tag-cols">
        <view class="ww-tag-col" wx:for="{{tagColumns}}" wx:for-item="col" wx:for-index="ci" wx:key="ci">
          <view
            class="ww-tag {{item.isFresh ? 'is-fresh' : ''}}"
            wx:for="{{col}}"
            wx:for-item="item"
            wx:key="_id"
            bindtap="openWishCard"
            data-id="{{item._id}}"
            hover-class="ww-tag-press"
            hover-stay-time="70"
            aria-role="button"
          >
            <view class="ww-tag-pin" aria-hidden="true"></view>
            <!-- 印记优先级：已收起 > 我的 > 置顶（都是"你需要先知道"的信息）。
                 ⚠️ 2026-09-18 产品决定：**去掉「馆方」章** —— 首批基线内容全是馆方发的，
                 26 条愿签里 24 条盖章 = 这个章不再传递任何信息，只是噪音。
                 `official` 字段**保留在数据与行模型里**（见 utils/wishWall.js 的注释），
                 以后若要区分"真人馆方回复"与"AI 基线"，不必做数据迁移就能挂回来。 -->
            <text class="ww-tag-seal is-hidden" wx:if="{{item.hidden}}">已收起</text>
            <text class="ww-tag-seal is-mine" wx:elif="{{item.isMine}}">我的</text>
            <text class="ww-tag-seal" wx:elif="{{item.pinned}}">置顶</text>
            <text class="ww-tag-text">{{item.text}}</text>
            <view class="ww-tag-foot">
              <image wx:if="{{item.avatar}}" class="ww-tag-avatar" src="{{item.avatar}}" mode="aspectFill" lazy-load aria-hidden="true"></image>
              <text class="ww-tag-meta">{{item.nickname}} · {{item.timeText}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="ww-tags-empty" wx:if="{{!items.length}}">{{viewMode === 'mine' ? '你还没在这面墙上写过心愿' : '还没有人许愿'}}</view>
      <!-- 明确收尾：服务端一面墙只回 30 条，到底了要如实说 -->
      <view class="ww-end" wx:if="{{items.length}}">
        <view class="ww-end-rule" aria-hidden="true"></view>
        <text class="ww-end-text">{{tagCapped ? '已到墙底 · 仅展示最近 ' + items.length + ' 条' : '已到墙底 · 共 ' + items.length + ' 条'}}</text>
        <view class="ww-end-rule" aria-hidden="true"></view>
      </view>
      </block>
    </view>

    <!-- 博物笔记：彩蛋拾得的去处。此前墙上没有任何入口指向它，用户不知道去哪儿看 -->
    <view
      class="ww-relics"
      wx:if="{{relics.total}}"
      bindtap="goRelics"
      hover-class="ww-relics-press"
      hover-stay-time="70"
      aria-role="button"
    >
      <view class="signal-light lamp-brass" aria-hidden="true"></view>
      <text class="ww-relics-text">博物笔记 · 已拾 {{relics.found}} / {{relics.total}} 页</text>
      <text class="ww-relics-chevron" aria-hidden="true">›</text>
    </view>
  </block>

  <!-- 心愿笺：点愿签展开的那张纸。弹幕看得快、愿签看得清、笺看得住 -->
  <view
    class="ww-card-mask"
    wx:if="{{card}}"
    bindtap="closeWishCard"
    catchtouchmove="noop"
    aria-role="button"
    aria-label="关闭心愿笺"
  >
    <view
      class="ww-card"
      catchtap="noop"
      aria-role="dialog"
      aria-label="心愿笺"
    >
      <!-- 笺是"最近看"的一层，给它与牌匾/纸墙同一套纸质材料 -->
      <view class="ww-card-fiber" aria-hidden="true"></view>
      <view class="ww-card-emboss" aria-hidden="true"></view>
      <view class="ww-card-pin" aria-hidden="true"></view>
      <text class="ww-card-over">愿签</text>
      <text class="ww-card-text">{{card.text}}</text>
      <view class="ww-card-meta">
        <text class="ww-card-who">{{card.nickname}}</text>
        <text class="ww-card-time">{{card.timeText}}</text>
      </view>
      <view class="ww-card-tags">
        <text class="ww-card-tag is-warn" wx:if="{{card.hidden}}">已被馆方收起</text>
        <text class="ww-card-tag" wx:if="{{card.isMine}}">我的</text>
        <text class="ww-card-tag" wx:if="{{card.pinned}}">置顶</text>
      </view>
      <view class="ww-card-acts">
        <view class="ww-card-act" bindtap="borrowWishText" hover-class="ww-card-act-press" hover-stay-time="70" aria-role="button">抄一句</view>
        <view class="ww-card-act" bindtap="copyWishText" hover-class="ww-card-act-press" hover-stay-time="70" aria-role="button">复制</view>
        <button class="ww-card-act is-share" open-type="share">祈一份</button>
      </view>
    </view>
  </view>

  <!-- 彩蛋浮层：进页（吉量）/ 落愿（驳）/ 连点灯（騊駼）/ 心愿数（鹿蜀）由注册表驱动，页面只提供这个挂点 -->
  <easter-egg-note id="easterEggNote" />

  <!-- 注册转化：浏览与仪式免费（价值先行），**落愿这一步才要身份**。
       closable=true → 不把用户困在弹窗里；关掉后草稿还在，回来还能接着挂。 -->
  <register-auth-dialog
    show="{{showRegisterDialog}}"
    overline="WISH WALL"
    title="注册后心愿才挂得住"
    desc="一键注册即可把这条心愿挂上墙、收进「我的心愿」，以后每天回来都看得到它。"
    cta="同意并一键注册"
    closable="{{true}}"
    close-text="先不挂"
    from="wish_wall"
    bind:cta="onRegisterDialogCta"
      bind:success="onRegisterSuccess"
    bind:close="onRegisterDialogClose"
    bind:fail="onRegisterDialogFail"
  />

  <!-- 「连续记录云保存」注册钩子（开关 showRitualProfile，缺配置默认关）。
       同一个 RegisterAuthDialog 组件、同一条 cta→success 链，只有文案与来源不同 ——
       只在用户真有可丢的进展（连灯 ≥2 天 / 木鱼 ≥21 下）且未注册时才由 JS 打开。
       closable=true：拒绝的是"现在注册"，不是"删掉我的连灯"，所以给「先存着」，
       关掉之后本地记录一个字都不动。 -->
  <register-auth-dialog
    show="{{showRitualDialog}}"
    overline="RITUAL BACKUP"
    title="注册后连灯记录不丢"
    desc="{{ritualGateDesc}}"
    cta="同意并一键注册"
    closable="{{true}}"
    close-text="先存着"
    from="wish_ritual"
    bind:cta="onRitualDialogCta"
    bind:success="onRitualRegisterSuccess"
    bind:close="onRitualDialogClose"
    bind:fail="onRitualDialogFail"
  />

  <!-- 创新钩子 H2「功德证」的领证注册门禁（开关 showMuyuCertificate，缺字段默认关）。
       同一个 RegisterAuthDialog 组件、同一条 cta→success 链，只有文案与来源不同 ——
       只在用户**点了「领证」且未注册**时才由 JS 打开（入口本身不拦主流程）。
       closable=true：拒绝的是"现在注册"，不是"删掉我的功德"，关掉之后本地计数与已发的证一个字都不动。 -->
  <register-auth-dialog
    show="{{showCertDialog}}"
    overline="MUYU CERTIFICATE"
    title="注册后功德证存得住"
    desc="{{certGateDesc}}"
    cta="同意并一键注册"
    closable="{{true}}"
    close-text="先不领"
    from="muyu_cert"
    bind:cta="onCertDialogCta"
    bind:success="onCertRegisterSuccess"
    bind:close="onCertDialogClose"
    bind:fail="onCertDialogFail"
  />

  <!-- 统一轻提示（AppToast）：钩子的结果反馈（「已存到云端」/「记录仍在本机」）走这里。
       为什么不用 wx.showToast：本页原生调用数被 check:dialog-ratchet 冻结（只许降不许涨）。 -->
  <app-toast
    show="{{toastShow}}"
    overline="{{toastOverline}}"
    title="{{toastTitle}}"
    desc="{{toastDesc}}"
    duration="{{toastDuration}}"
    bind:close="onToastClose"
  />
  <!-- 纸签弹层（遮罩 + 从底部升起的签）：与发送条一样，**必须是 .ww-page 的直接子节点** ——
       它原本挂在 .ww-plays 里，而 .ww-plays 是 z-index:1 的层叠上下文，于是弹层的 z-index:41
       只在那个上下文内有效，吸底发送条（页面级 z-index:30）反而画到它上面（渲染图里实测到）。
       规则：**凡是 fixed 覆盖层，不许待在任何一个带 z-index 的祖先里**。 -->
  <view
    class="ww-sheet-mask"
    wx:if="{{playResult}}"
    bindtap="closePlayResult"
    aria-role="button"
    aria-label="收起"
  ></view>
  <view
    class="ww-sheet"
    wx:if="{{playResult}}"
    style="transform: translateY({{sheetDragY}}px);"
    aria-role="dialog"
    aria-label="{{playResult.name}}结果"
  >
    <view
      class="ww-sheet-grip"
      bindtouchstart="onSheetGripStart"
      bindtouchmove="onSheetGripMove"
      bindtouchend="onSheetGripEnd"
      bindtouchcancel="onSheetGripEnd"
    ><view class="ww-sheet-grip-bar" aria-hidden="true"></view></view>

    <view class="ww-sheet-head">
      <view class="ww-sheet-mark" aria-hidden="true">{{playResult.mark}}</view>
      <view class="ww-sheet-head-copy">
        <text class="ww-sheet-overline" wx:if="{{playResult.overline}}">{{playResult.overline}}</text>
        <text class="ww-sheet-name">{{playResult.name}}</text>
      </view>
      <text class="ww-sheet-close" bindtap="closePlayResult" hover-class="ww-sheet-close-press" hover-stay-time="70" aria-role="button">收起</text>
    </view>

    <view class="ww-sheet-body">
      <text class="ww-sheet-title">{{playResult.title}}</text>
      <text class="ww-sheet-sub" wx:if="{{playResult.sub}}">{{playResult.sub}}</text>
      <text
        class="ww-sheet-line"
        wx:for="{{playResult.lines}}"
        wx:key="*this"
        style="animation-delay: {{120 + index * 60}}ms;"
      >{{item}}</text>
    </view>

    <view class="ww-sheet-cta-row">
      <view class="ww-sheet-cta" bindtap="usePlayWish" hover-class="ww-sheet-cta-press" hover-stay-time="70" aria-role="button">
        {{playResult.wish ? '写成心愿' : '写下我的心愿'}}
      </view>
    </view>

    <!-- 产品链路：**只留一条主路**（以前同时有"推荐卡"和"看这件藏品"两行，谁主谁次看不出来）。
         有祈运推荐就用推荐，没有就用这面墙自己的藏品。 -->
    <view
      class="ww-sheet-product"
      wx:if="{{reco || productId}}"
      bindtap="{{reco ? 'goRecoProduct' : 'goProduct'}}"
      hover-class="ww-sheet-product-press"
      hover-stay-time="70"
      aria-role="button"
    >
      <view class="ww-sheet-product-copy">
        <text class="ww-sheet-product-label">{{reco ? reco.label : ('这面墙的藏品' + (productTitle ? ' · ' + productTitle : ''))}}</text>
        <text class="ww-sheet-product-title" wx:if="{{reco}}">{{reco.title}}</text>
        <text class="ww-sheet-product-meta" wx:if="{{reco && (reco.latinName || reco.priceText)}}">{{reco.latinName}}{{reco.latinName && reco.priceText ? ' · ' : ''}}{{reco.priceText}}</text>
      </view>
      <!-- ⚠️ 这一行是 CTA 文案（"看看这件"），不是装饰 —— 不许 aria-hidden，
           否则读屏用户听不到这条主路的出口（本批曾误加一次，自查时撤掉）。 -->
      <text class="ww-sheet-product-go">看看这件 ›</text>
    </view>

    <text class="ww-sheet-note">今日这一句一天一支，明天会换新的。</text>
  </view>

  <!-- 创新钩子 H2「功德证」本体（可保管、可回看）：与纸签弹层同一套纸张语言与层叠纪律 ——
       同样是 .ww-page 的直接子节点（fixed 覆盖层不许待在带 z-index 的祖先里，见上面那段注释）。
       文字**只有计数与日期**（合规口径：文化娱乐向、不涉命理改运），见 utils/muyuCertificate。
       ⚠️ 字宽/折行属本仓「静态检查盲区」，只能真机验；本轮**没有真机验证**，交付说明已如实标注。 -->
  <view
    class="ww-sheet-mask"
    wx:if="{{certCard}}"
    bindtap="closeCertCard"
    aria-role="button"
    aria-label="收起"
  ></view>
  <view
    class="ww-sheet"
    wx:if="{{certCard}}"
    aria-role="dialog"
    aria-label="功德证"
  >
    <view class="ww-sheet-grip"><view class="ww-sheet-grip-bar" aria-hidden="true"></view></view>

    <view class="ww-sheet-head">
      <view class="ww-sheet-head-copy">
        <text class="ww-sheet-overline">MUYU MERIT</text>
        <text class="ww-sheet-name">功德证</text>
      </view>
      <text class="ww-sheet-close" bindtap="closeCertCard" hover-class="ww-sheet-close-press" hover-stay-time="70" aria-role="button">收起</text>
    </view>

    <view class="ww-sheet-body">
      <!-- 只写计数与日期：不写运势、不写改运、不写"心愿应验" -->
      <text class="ww-sheet-title">功德 {{certCard.muyuCount}}</text>
      <text class="ww-sheet-sub">里程 {{certCard.milestone}}</text>
      <text class="ww-sheet-line">领取日期 {{certCard.dayKey}}</text>
    </view>

    <text class="ww-sheet-note">{{certNote}}</text>
  </view>

  <!-- 发送条：**弹幕墙下方**（2026-09-19 产品口径变更）。
       原设计是吸底（§35 产品点头，`position: fixed; bottom: 0`），但产品真机反馈
       「点『写下我的心愿』后页面滚下去、看不到输入框」—— 根因是纸签弹层没收（已修），
       但产品进一步要求把输入放到**更醒目**的位置：弹幕墙下方、与玩法区同屏。
       因此改为**顺流**（`position: static`），不再吸底、不再需要页面底部预留 180rpx。
       ⚠️ 代价（如实记录）：主操作不再「永远在拇指下」，要滚到墙下方才看得到；
       若日后产品觉得吵，改回 fixed 即可（一处样式 + 两条判据）。 -->
</view>
