<!--subpackages/feature/wish-wall/index.wxml
  需求 28：马上有 · 弹幕祈福墙
  ⚠️ 类名一律 ww- 前缀：本页曾把点灯卡片命名为 .lamp，与 app.wxss 的全局信号灯基类
  .lamp（12rpx 圆点、flex-shrink:0）撞车 —— 卡片被压成 6px 宽竖条，文案一字一行被裁切。
  页面类名不得与全局撞车，已由 npm run test:wish-wall 的全仓守卫钉住。 -->
<view class="ww-page">
  <view class="ww-grain" aria-hidden="true"></view>

  <!-- 未开放：不发任何请求，只给一句解释。
       ⚠️ 2026-09-20 改造：必须区分**开关读失败**与**馆方确实没开放** ——
       把网络故障说成「馆方正在准备这块墙面」是假事实，用户也没有可走的一步。
       读失败时说"没能打开"并给重试（onGateRetry → bootstrap({force:true})）。 -->
  <view class="ww-closed" wx:if="{{flagChecked && !allowed}}">
    <view class="ww-closed-lamp" aria-hidden="true">
      <view class="signal-light {{gateError ? 'lamp-warn' : 'lamp-muted hollow'}}" aria-hidden="true"></view>
    </view>
    <text class="ww-closed-title">{{gateError ? '墙面没能打开' : '祈福墙暂未开放'}}</text>
    <text class="ww-closed-desc">{{gateError ? '网络或权限异常，没读上馆方的开关。' : '馆方正在准备这块墙面，稍后再来看看。'}}</text>
    <view
      class="ww-closed-retry"
      wx:if="{{gateError}}"
      bindtap="onGateRetry"
      hover-class="ww-closed-retry-press"
      hover-stay-time="70"
      aria-role="button"
    >再试一次</view>
  </view>

  <block wx:else>
    <!-- 墙面：浅纸墙 + 轨道化弹幕。同轨严格不重叠（排期见 utils/wishWall.buildDanmakuRows） -->
    <view
      class="ww-wall {{echoRows.length ? 'is-echo' : ''}}"
      aria-label="{{rows.length ? rows.length + ' 条心愿在墙上流动，轻点一条可展开愿签' : '祈福墙'}}"
    >
      <!-- 牌匾式页头：**与墙面同一张卡**（2026-09-20 产品要求「hero banner 应该与弹幕墙合并」）。
           做法：页头进墙、自己不画底（.ww-hero.is-joined 背景透明 + 无边无圆角），
           由墙面的连续纸面与纹理承载它 —— 不是两段拼色，也不是"去掉空隙"那种视觉凑合。
           关闭态（flagChecked && !allowed）时墙面不渲染，页面由 .ww-closed 自己给标题
           「祈福墙暂未开放」，所以不会出现"没有页头"的空页。 -->
      <view class="ww-hero is-joined">
      <view class="ww-fiber" aria-hidden="true"></view>
      <view class="ww-emboss" aria-hidden="true"></view>
      <view class="ww-wm" aria-hidden="true"></view>
      <view class="ww-hero-body">
        <view class="ww-hero-top">
          <text class="ww-over">马上有 · WISH WALL</text>
          <!-- 灯的状态直接写进页头：今日已点 = 铜灯亮，未点 = 空心 -->
          <view class="signal-light {{lamp.lit ? 'lamp-brass on' : 'lamp-muted hollow'}}" aria-hidden="true"></view>
          <view class="ww-seal" aria-hidden="true"><view class="ww-seal-inner"></view></view>
        </view>
        <!-- 牌匾主体（2026-09-20 改造）：左边两行字，右边一块**黄铜铭牌**。
             为什么必须有那块铜牌：线下黑马底座嵌着黄铜三字「马上有」（PRD §2.1 的原件），
             而页头此前**通篇没有一个器物** —— 三行字直接浮在纸面上，牌匾没有重心，
             也就撑不起目标 2「一眼认出这是黑马那面墙」。铜牌是那个原件的线上对等物。
             铭牌是装饰（同样的三个字已在 overline 里），故 aria-hidden。 -->
        <view class="ww-hero-main">
          <view class="ww-hero-names">
            <text class="ww-brand">山海造物</text>
            <!-- 主标题固定「祈福墙」：入口传进来的 title 本身就是「马上有」，
                 写「{{productTitle}} · 祈福墙」会变成「马上有 · 祈福墙」重复两遍 -->
            <text class="ww-title">祈福墙</text>
          </view>
          <view class="ww-plate" aria-hidden="true">
            <text class="ww-plate-text">马上有</text>
          </view>
        </view>
        <!-- 这一行右侧原本空着（印泥/水印之外没有任何内容）。祈运标签挪上来：
             ① 第一屏就能看到"这面墙求什么"（不必滚到玩法区）② 玩法区因此省下一条提示的高度 -->
        <view class="ww-scope-row">
          <!-- 2026-09-27「马上有 = 门店核心 IP」：页头原来的「本墙/本品 chip + 一行通用导语」
               合并成一条**展签**（博物馆展品铭牌）：实物图 / 名称 · 物种 / 在哪家店可见。
               点开是展品卡（寓意、人设、线下现场、去藏品页）。文案出处见 config/wallExhibit.js。
               没登记展品的墙（exhibit 为 null）退回原来的产品 chip。 -->
          <view
            class="ww-exhibit"
            wx:if="{{exhibit}}"
            bindtap="openExhibit"
            hover-class="ww-exhibit-press"
            hover-stay-time="70"
            aria-role="button"
            aria-label="认识展品 {{exhibit.name}}，{{exhibit.species}}，{{exhibit.storeLabel}}可见实物"
          >
            <view class="ww-exhibit-thumb {{exhibit.cover ? 'has-img' : ''}}" aria-hidden="true">
              <image wx:if="{{exhibit.cover}}" class="ww-exhibit-img" src="{{exhibit.cover}}" mode="aspectFill" />
              <text wx:else class="ww-exhibit-glyph">马</text>
            </view>
            <view class="ww-exhibit-copy">
              <view class="ww-exhibit-name-row">
                <text class="ww-exhibit-name">{{exhibit.name}}</text>
                <text class="ww-exhibit-species">{{exhibit.species}}</text>
              </view>
              <text class="ww-exhibit-where">{{exhibit.storeLabel}} · 可见实物</text>
            </view>
            <text class="ww-exhibit-go">认识它 ›</text>
          </view>
          <!-- 产品 chip：**没登记展品的墙**才在页头出现（有展品时它挪进展品卡当「去藏品页」）。
               ⚠️ 2026-09-21（P2-7）：handler 是 `goWallProduct` —— 这里**没有任何玩法发生**，
               复用玩法转化事件会把「参与玩法」比率推到 >100%。上报口径见 index.js。 -->
          <view
            class="ww-scope {{productId ? 'is-link' : 'is-wall'}}"
            wx:elif="{{productTitle}}"
            bindtap="goWallProduct"
            hover-class="ww-scope-press"
            hover-stay-time="70"
            aria-role="{{productId ? 'link' : 'text'}}"
            aria-label="{{productId ? ('回看本品 ' + productTitle) : ('本墙 ' + productTitle)}}"
          >{{productTitle}}{{productId ? ' · 去看' : ''}}</view>
          <view class="ww-bless" wx:if="{{blessLabelText}}">偏「{{blessLabelText}}」</view>
        </view>
      </view>
    </view>
      <view class="ww-wall-fiber" aria-hidden="true"></view>
      <view class="ww-wall-inner">
        <!-- 刻度必须和内层同坐标系：挂在整面墙上会因底部页脚高度而逐轨错开 -->
        <view class="ww-wall-rail rail-1" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-2" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-3" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-4" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-5" aria-hidden="true"></view>
        <view class="ww-wall-rail rail-6" aria-hidden="true"></view>
        <!-- 加载中：四条轨道各出一条浅纸微光条（全站约定是骨架，不是一行字） -->
        <block wx:if="{{loading}}">
          <view class="ww-wall-skel skel-1" aria-hidden="true"></view>
          <view class="ww-wall-skel skel-2" aria-hidden="true"></view>
          <view class="ww-wall-skel skel-3" aria-hidden="true"></view>
          <view class="ww-wall-skel skel-4" aria-hidden="true"></view>
        </block>
        <block wx:else>
          <view
            class="ww-danmaku ww-tone-{{item.tone}} {{item.isMine ? 'is-mine' : ''}} {{item.pinned ? 'is-pinned-dm' : ''}} {{item.boost || item.id === freshId ? 'is-boost' : ''}} {{item.id === heldDmId ? 'is-held' : ''}}"
            wx:for="{{rows}}"
            wx:key="key"
            style="top:{{item.topPercent}}%; animation-duration:{{item.durationMs}}ms; animation-delay:{{item.delayMs}}ms;"
            bindtap="openWishCard"
            data-id="{{item.id}}"
            hover-class="ww-danmaku-press"
            hover-stay-time="70"
            aria-role="button"
            aria-label="{{item.text}}"
          >
            <!-- 弹幕皮肤：薄纸签（可读滚动优先；钉头/绳保留厅墙气质） -->
            <view class="ww-dm-slip {{item.id === freshId || item.boost ? 'is-landing' : ''}} {{item.isMine ? 'is-mine-slip' : ''}} {{item.pinned ? 'is-pinned-slip' : ''}}">
              <view class="ww-dm-cord" aria-hidden="true"></view>
              <text class="ww-emoji" wx:if="{{item.emoji}}">{{item.emoji}}</text>
              <view
                class="ww-dm-mark {{item.pinned ? 'is-pinned' : ''}}"
                wx:if="{{item.pinned}}"
                aria-hidden="true"
              ></view>
              <text class="ww-dm-text {{item.id === freshId || item.boost ? 'is-fresh' : ''}} {{item.isMine ? 'is-mine-text' : ''}}">{{item.text}}</text>
              <view class="ww-dm-spark" wx:if="{{item.id === heldDmId}}" aria-hidden="true"></view>
            </view>
          </view>
          <!-- ⚠️ 失败时不得说「墙面还是空的」——那是把加载失败谎报成没人许愿 -->
          <view class="ww-wall-empty" wx:if="{{!rows.length}}">
            <view class="ww-wall-empty-mark" aria-hidden="true"></view>
            <text class="ww-wall-empty-title">{{loadError ? '墙面未展开' : '马上有还没听到心愿'}}</text>
            <text class="ww-wall-empty-desc">{{loadError ? '网络或权限异常，可在下方重试' : '对着它，写下第一句'}}</text>
          </view>
        </block>
      </view>
      <!-- 墙页脚＝「墙面 → 愿签列表」的快捷入口：弹幕看得快、愿签看得清，
           看完流动的手指自然会想"有没有一条是我的/我想细看"。这行文字是可点的，
           省掉"手动往下滚一屏"这一步（交互优化，2026-09-18） -->
      <view
        class="ww-wall-foot"
        wx:if="{{rows.length}}"
        bindtap="goWishList"
        hover-class="ww-wall-foot-press"
        hover-stay-time="70"
        aria-role="button"
        aria-label="{{wallCount}} 条心愿，点击查看愿签列表"
      >
        <view class="signal-light lamp-brass" aria-hidden="true"></view>
        <text class="ww-wall-foot-text">{{wallCount}} 条心愿正在墙上流动</text>
        <text class="ww-wall-foot-more">看全部 ›</text>
      </view>
      <view class="ww-wall-foot is-loading" wx:elif="{{loading}}">
        <view class="signal-light lamp-muted" aria-hidden="true"></view>
        <text class="ww-wall-foot-text">正在展开墙面…</text>
      </view>
      <!-- 即时反馈回声：点灯 / 木鱼 / 落愿（以及后续玩法）之后，墙的页脚回一句、边框亮一下。
           为什么放页脚这一条 44rpx 带里：四条弹幕轨道的第 4 条落在 84%，轨下只剩 ~17rpx，
           塞不下任何东西；页脚是墙内**唯一**不会被弹幕穿过的位置（overflow:hidden 已裁好）。
           为什么是数组 + wx:key：连点要**重播**动画，同 key 不会重播（与弹幕轮播同一手法）。 -->
      <view
        class="ww-echo"
        wx:for="{{echoRows}}"
        wx:key="key"
        aria-label="{{item.text}}{{item.sub ? ' ' + item.sub : ''}}"
        aria-role="alert"
      >
        <view class="signal-light lamp-brass" aria-hidden="true"></view>
        <text class="ww-echo-text">{{item.text}}</text>
        <text class="ww-echo-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
      </view>
    </view>
    <!-- 厅内挂签台：发送条 + 灵感/额度合成一座仪式台（composer 自身仍 transparent/static，守卫钉死）。
         位置不变量：wall < composer < plays，且全页只有一个（守卫已钉）。 -->
    <view class="ww-desk {{deskPosted ? 'is-posted' : ''}}">
      <view class="ww-desk-lintel" aria-hidden="true">
        <view class="ww-desk-seal"><text class="ww-desk-seal-t">{{deskPosted ? '成' : '挂'}}</text></view>
        <view class="ww-desk-copy">
          <text class="ww-desk-title">{{deskPosted ? '已挂上墙' : '挂签台'}}</text>
          <text class="ww-desk-sub">{{deskPosted ? '这句正在墙上亮着' : '对着马上有，写下想要的'}}</text>
        </view>
      </view>
    <view class="ww-composer">
      <!-- 为什么要摘掉原生 maxlength（P0 修复的另一半）：它按 **UTF-16 码元** 算，
           绑成 textMax=30 时一个 emoji 吃掉 2 个额度、一个家庭 emoji 吃掉 8 个；
           而同一属性也没有办法表达「30 个字」。故取消原生截断，**唯一**截断点是
           `index.js` 的 `wishTextTruncate(…, TEXT_MAX)`（按「字」，绝不切出半个代理对），
           与服务端 `manageWishWall` 的内嵌副本同源。
           ⚠️ 代价（如实记录）：真机上"打到 30 字"不再有输入层硬停，只靠 JS 回写；
           手感属本仓静态检查盲区，需真机复核。 -->
      <input
        class="ww-input"
        id="wishInput"
        value="{{draft}}"
        maxlength="-1"
        confirm-type="send"
        adjust-position="{{true}}"
        cursor-spacing="24"
        hold-keyboard="{{false}}"
        placeholder="例如：马上有闲，马上有缘"
        placeholder-class="ww-input-ph"
        focus="{{inputFocus}}"
        bindinput="onDraftInput"
        bindblur="onInputBlur"
        bindconfirm="submitWish"
      />
      <view
        class="ww-send {{posting || !draft || quota.exhausted ? 'is-off' : ''}}"
        bindtap="submitWish"
        hover-class="ww-send-press"
        hover-stay-time="70"
        aria-role="button"
        aria-disabled="{{posting || !draft || quota.exhausted ? 'true' : 'false'}}"
      >{{posting ? '挂上…' : (quota.exhausted ? '明天再来' : '挂上墙')}}</view>
    </view>

    <!-- 写愿助手（2026-09-20 改造）：灵感词 + 今日额度 + 字数，**紧跟发送条**。
         改造前它们在页面下方（灯/木鱼/玩法之后）：离线版式实测**距发送条 586px、整块在首屏之外**，
         而 useInspiration 只改 draft、既不聚焦也不滚动 —— 真机现象就是产品反馈的「点了像没反应」。
         现在它与发送条同一个区块：点完立刻看得到输入框里的字，字数也在同一视线里。
         守卫：scripts/render-wall-preview.mjs 钉住「灵感行顶边必须落在首屏内」。 -->
    <view class="ww-wishassist" wx:if="{{inspiration.length || quota.cap}}">
      <view class="ww-inspo" wx:if="{{inspiration.length}}">
        <text class="ww-inspo-label">灵感</text>
        <view class="ww-inspo-row">
          <view
            class="ww-inspo-chip"
            wx:for="{{inspiration}}"
            wx:key="*this"
            bindtap="useInspiration"
            data-text="{{item}}"
            hover-class="ww-inspo-press"
            hover-stay-time="70"
            aria-role="button"
          >{{item}}</view>
        </view>
      </view>
      <view class="ww-write-foot">
        <!-- 额度如实预告（上限与云函数 DAILY_LIMIT 同源）：写了才被拒的体验最差。
             读不到（mine 失败）时**不许沿用默认值** —— 默认值是"还可写 5 条"，而用户可能正好写满了；
             那种情况下这句话就是替服务端打包票。unknown 分支只说事实。 -->
        <text class="ww-quota is-unknown" wx:if="{{quota.cap && quota.unknown}}">额度暂时读不到，能否再写以提交结果为准</text>
        <text class="ww-quota {{quota.exhausted ? 'is-done' : ''}}" wx:elif="{{quota.cap}}">
          {{quota.exhausted ? '今日 ' + quota.cap + ' 条额度已用完，明天再来' : '今日还可写 ' + quota.left + ' 条'}}
        </text>
        <text class="ww-count">{{draftCount}}/{{textMax}}</text>
      </view>
    </view>
    </view>

    <view class="ww-notice" wx:if="{{myHidden > 0}}">
      <view class="signal-light lamp-warn" aria-hidden="true"></view>
      <text class="ww-notice-text">你有 {{myHidden}} 条心愿被馆方暂时收起，未公开展示。</text>
    </view>

    <!-- 注册成功后的「下一步」（PRD §9-4 裁决：**两者合一** = 券包 + 去逛）。
         用**就地提示条**而不是新弹窗：不再加一层模态（避开原生弹窗棘轮），也不打断"心愿刚上墙"那一帧。
         文案只写**成立的事实**（"注册成功"）—— 不写"券已到账"：礼包发不发取决于后台配置，
         写死了就是在替配置打包票（本仓最忌"看起来像真的"）。两个出口各自单独记漏斗 step。 -->
    <view class="ww-joined" wx:if="{{justRegistered}}">
      <text class="ww-joined-text">注册成功 · 欢迎来到山海造物</text>
      <view class="ww-joined-acts">
        <view class="ww-joined-act" bindtap="goCouponsAfterRegister" hover-class="ww-joined-act-press" hover-stay-time="70" aria-role="button">我的券包</view>
        <view class="ww-joined-act is-primary" bindtap="goShoppingAfterRegister" hover-class="ww-joined-act-press" hover-stay-time="70" aria-role="button">去逛逛</view>
      </view>
    </view>

    <!-- 仪式厅：与挂签台 / 签廊同族厅盒（门楣 + 器物龛） -->
    <view class="ww-hall is-ritual">
    <view class="ww-hall-lintel">
      <view class="ww-hall-seal" aria-hidden="true"><text class="ww-hall-seal-t">仪</text></view>
      <view class="ww-hall-copy">
        <text class="ww-hall-title">今天的仪式</text>
        <text class="ww-hall-sub">给马上有点一盏灯 · 敲一下木鱼</text>
      </view>
      <view
        class="ww-sound {{soundOn ? 'is-on' : 'is-off'}}"
        bindtap="onToggleSound"
        hover-class="ww-sound-press"
        hover-stay-time="70"
        aria-role="switch"
        aria-checked="{{soundOn}}"
        aria-label="仪式音效"
      >{{soundOn ? '音效 开' : '音效 关'}}</view>
    </view>

    <!-- 祈福动作区：点灯 + 木鱼并列（产品负责人 2026-09-19 版式） -->
    <view class="ww-ritual-row">
    <!-- 灯龛：零门槛的入场动作。点完亮出当天那一句，同一天复现同一句。
         光晕是灯座盒子的子元素（不再用行内绝对定位），文案列 flex:1 —— 布局不会被压塌 -->
    <view
      class="ww-lantern {{lamp.lit ? 'is-lit' : 'is-idle'}}"
      bindtap="onLampTap"
      hover-class="ww-lantern-press"
      hover-stay-time="70"
      aria-role="button"
      aria-label="{{lamp.lit ? '今日灯已点' : '点一盏灯'}}"
    >
      <view class="ww-lantern-box" aria-hidden="true">
        <view class="ww-lantern-halo"></view>
        <view class="ww-lantern-core"></view>
      </view>
      <!-- 点灯爱心动效：一次性飘起（heartBurst 由 js 短暂置真，2.6s 后收起） -->
      <view class="ww-hearts" wx:if="{{heartBurst}}" aria-hidden="true">
        <text class="ww-heart h1">♥</text>
        <text class="ww-heart h2">♥</text>
        <text class="ww-heart h3">♥</text>
        <text class="ww-heart h4">♥</text>
        <text class="ww-heart h5">♥</text>
      </view>
      <view class="ww-lantern-copy">
        <!-- 标题独占一行：标题与徽章同排时，半宽卡里「今日灯已点」会被挤成两行 -->
        <text class="ww-lantern-title">{{lamp.lit ? '今日灯已点' : '点一盏灯'}}</text>
        <!-- 徽章另起一行且允许折行（窄卡里宁可折行，也不要把标题挤断） -->
        <view class="ww-lantern-meta">
          <!-- 灯位：连续点灯攒出来的层级（1/3/7 天 → 1/3/5 盏）。称号来自 wishWall.lampTier -->
          <text class="ww-lantern-tier" wx:if="{{lamp.lit && lamp.label}}">{{lamp.label}}</text>
          <!-- 今天是个节气就直说 —— 节气灯语优先于通用灯语 -->
          <text class="ww-lantern-solar" wx:if="{{lamp.solar}}">{{lamp.solar.name}}</text>
          <!-- 不是节气日时给"还差几天"：一个"过几天再来"的理由（>7 天不显示，免得成噪音） -->
          <text class="ww-lantern-next" wx:elif="{{lamp.solarNext}}">距{{lamp.solarNext.name}} {{lamp.solarNext.inDays}} 天</text>
        </view>
      <view class="ww-streak" wx:if="{{lamp.streak > 1}}">
        <view class="ww-lamps" aria-hidden="true">
          <view class="ww-lamp-dot" wx:for="{{lamp.lampDots}}" wx:key="*this"></view>
        </view>
        <text class="ww-streak-n">{{lamp.streak}}</text>
        <text class="ww-streak-l">天</text>
      </view>
      </view>
      <!-- 灯语 / 灯位说明整行落在标题块下面（flex-basis:100%）：
           留在文案列里时它只有 ~220rpx 宽，「灯亮着，就还有没说完的心愿。」的第二行只剩
           3 个字（真机截图里的"的心愿。"孤字）—— 产品反馈的「文案过于拥挤」就是从这来的。
           整行之后 13 字以内一行装得下（文案池也按这个上限收过，见 utils/wishRitual.js）。 -->
      <view class="ww-lantern-tail">
        <text class="ww-lantern-line" wx:if="{{lamp.lit}}">{{lamp.line}}</text>
        <text class="ww-lantern-line is-idle" wx:else>点一下，替今天留个记号</text>
        <text class="ww-lantern-note" wx:if="{{lamp.lit && lamp.tierNote}}">{{lamp.tierNote}}</text>
      </view>
    </view>

    <view class="ww-ritual-card" bindtap="onMuyuTap" hover-class="ww-muyu-press" hover-stay-time="70"
      aria-role="button" aria-label="安心木鱼，敲一下静一分">
      <view class="ww-muyu {{muyuBeat ? 'is-beat' : ''}}" aria-hidden="true">
        <view class="ww-muyu-slit"></view>
      </view>
      <view class="ww-muyu-copy">
        <text class="ww-muyu-title">安心木鱼</text>
        <text class="ww-muyu-line">敲一下，静一分</text>
        <text class="ww-muyu-count" wx:if="{{muyuCount}}">功德 {{muyuCount}}</text>
      </view>
      <text class="ww-muyu-plus" wx:if="{{muyuPlus}}">+1</text>
    </view>
    </view>
    <!-- 创新钩子 H2「功德证」次级入口（开关 showMuyuCertificate，缺字段默认关）。
         为什么是**一整行**放在木鱼动作区下方，而不是塞进半宽的木鱼卡里：
         卡宽约 330rpx，中文标签 + 「领证 ›」在 20~22rpx 字号下已接近一行上限，塞进去会折行；
         而且方案 §H2 明确要求"两个证书/记录入口不要与木鱼/点灯视觉并列"（仪式区不许变成功能区）。
         它是**次级**入口：只在里程点出现（阈值在 utils/muyuCertificate.CERT_MILESTONES），
         且不拦截主流程 —— 不点它，木鱼照敲。 -->
    <view
      class="ww-cert-entry"
      wx:if="{{certEntry}}"
      bindtap="onCertEntryTap"
      hover-class="ww-cert-entry-press"
      hover-stay-time="70"
      aria-role="button"
      aria-label="{{certEntry.mode === 'claim' ? '领取功德证' : '回看功德证'}}"
    >
      <text class="ww-cert-entry-tag">{{certEntry.tag}}</text>
      <text class="ww-cert-entry-go">{{certEntry.action}}</text>
    </view>
    </view>
    <!-- 「说明行 + 音效」整块已下线（2026-09-20 改造）：音效上移到仪式区区头，
         说明文案与墙页脚重复。原结构见 git 历史（.ww-foot-row）。 -->

    <!-- 玩法分区 · 玩法**入口区**（PRD v1.4 §11.3 六分区的「玩法」；§11.4 玩法各开一页）。
         2026-09-21 口径变更：这里**只做入口** —— 进行态 / 结果 / 推荐 / 分享全部搬到各自玩法页
         （每个玩法一个完整闭环：入口 → 进行态 → 结果 → 留档 → 下一步）。
         ⚠️ 三条不许破：
           · `wx:for="{{plays}}"` 注册表驱动，页面不写死玩法名（加玩法只改 config/ritualPlays.js）；
           · 前两枚由祈运标签决定（applyBlessScope 的排序不变，同一天同一标签结果仍确定）；
           · 入口形态按注册表 `form` 分支（card / shell / ring / axis / leaf / coin）—— 各玩法入口长得不一样，
             不再靠"前两枚更大"这一种表达（§11.1 R1）。
         每个入口还带**"今天玩过没有"**（`item.played / entryNote / doneNote`）——
         这是把用户再引进玩法页的理由（状态由本地留档按日期键现算，见 index.js refreshPlayStates）。 -->
    <view class="ww-plays">
      <view class="ww-plays-head">
        <view class="ww-hall-seal is-play" aria-hidden="true"><text class="ww-hall-seal-t">玩</text></view>
        <view class="ww-plays-head-copy">
          <text class="ww-plays-title">今天的玩法</text>
          <text class="ww-plays-sub">{{blessLabelText ? '偏「' + blessLabelText + '」先推这两支' : '领一句，回来说给马上有听'}}</text>
        </view>
      </view>
      <view class="ww-play-grid">
        <view
          class="ww-play is-{{item.form}} {{index < 2 ? 'is-lead' : 'is-minor'}}"
          wx:for="{{plays}}"
          wx:key="id"
          bindtap="onPlayTap"
          data-id="{{item.id}}"
          hover-class="ww-play-press"
          hover-stay-time="70"
          aria-role="button"
          aria-label="{{item.name}}：{{item.played ? item.doneNote : item.hint}}"
        >
          <!-- 入口形态：各玩法一套（纯 CSS 盒子，不用图片/图标资产、不用 canvas） -->
          <view class="ww-play-form" wx:if="{{item.form === 'card'}}" aria-hidden="true">
            <view class="ww-play-tube">
              <!-- 2026-09-22：入口尺寸下「筒」读成一块铜方块 —— 补一支露在筒口的签条，
                   这是玩法页 .rp-stick 已有的语言，一眼能看出"这是签筒"。 -->
              <view class="ww-play-tube-stick"></view>
              <view class="ww-play-tube-body"></view>
              <view class="ww-play-tube-mouth"></view>
            </view>
          </view>
          <view class="ww-play-form" wx:elif="{{item.form === 'shell'}}" aria-hidden="true">
            <view class="ww-play-shell">
              <view class="ww-play-shell-half is-left"></view>
              <view class="ww-play-shell-half is-right"></view>
            </view>
          </view>
          <view class="ww-play-form" wx:elif="{{item.form === 'ring'}}" aria-hidden="true">
            <view class="ww-play-ring">
              <view class="ww-play-ring-dot"></view>
            </view>
          </view>
          <view class="ww-play-form" wx:elif="{{item.form === 'axis'}}" aria-hidden="true">
            <view class="ww-play-axis">
              <view class="ww-play-axis-line"></view>
              <view class="ww-play-axis-knob"></view>
            </view>
          </view>
          <view class="ww-play-form" wx:elif="{{item.form === 'leaf'}}" aria-hidden="true">
            <view class="ww-play-leaf">
              <view class="ww-play-leaf-vein"></view>
            </view>
          </view>
          <view class="ww-play-form" wx:elif="{{item.form === 'coin'}}" aria-hidden="true">
            <view class="ww-play-coin">
              <view class="ww-play-coin-hole"></view>
            </view>
          </view>

          <!-- 「先推」绝对定位到格角，不进标题 flex 行 —— 否则挤「今日一签」折成两行（2026-09-27） -->
          <text class="ww-play-lead-tag" wx:if="{{index < 2}}">先推</text>
          <view class="ww-play-copy">
            <view class="ww-play-title-row">
              <view class="ww-play-mark" aria-hidden="true">{{item.mark}}</view>
              <text class="ww-play-name">{{item.name}}</text>
            </view>
            <!-- 副标（hint）恒显：与状态句分工（做什么 / 今天做没做），六格同为「标题+副标+状态」三行，行高齐平 -->
            <text class="ww-play-hint">{{item.hint}}</text>
            <text class="ww-play-state {{item.played ? 'is-done' : ''}}">{{item.played ? item.doneNote : item.entryNote}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 这里原来是一整块「写愿签」（灵感 + 额度 + 越权提示）。
         2026-09-20 改造把它拆了：灵感词与额度上移到发送条正下方（同一个视线），
         越权提示上移为独立一行 —— 整块 `.ww-write` 因此消失（见上面 .ww-wishassist 的说明）。 -->

    <!-- 愿签内容流（PRD v1.4 §11.1 R2「页面下方的祈福内容流彻底优化」）：
         整段交给自包含组件 <wall-feed>（`components/WallFeed/`）。
         为什么抽成组件：本页正被 R1（玩法大改）编辑，内容流必须与它**文件级解耦** ——
         页面只传原始数据与回调能力，组件自己持有全部视图态（两栏 / 筛选 / 排序 / 分页游标 /
         加载更多状态机 / 详情层），并且**不发任何云调用**（见组件 `index.js` 顶部的契约表）。
         ⚠️ `items` 传的是**墙面那一份**（`wallItems`），与当前视图无关 ——
         视图态在组件里；页面旧的 `data.items`（会被 applyView 换成当前视图）**不许**传进去，
         否则切到「我的心愿」后墙视图会串台（这正是 2026-09-20 修过的那个缺陷）。
         ⚠️ `id="wishList"` 必须留在页面：墙页脚「看全部 ›」的 `wx.pageScrollTo({selector:'#wishList'})`
         指着它。这里是一个零高度锚点（无定位、无 z-index、无 transform），
         不会把组件的 `position: fixed` 详情层（z-index 60）困住（本页 `.ww-plays` 踩过这个坑）。 -->
    <view id="wishList"></view>
    <wall-feed
      items="{{wallItems}}"
      mine-rows="{{mineRows}}"
      wall-count="{{wallCount}}"
      mine-total="{{mine.total}}"
      loading="{{loading}}"
      load-error="{{loadError}}"
      mine-loading="{{mineLoading}}"
      mine-error="{{mineError}}"
      allowed="{{allowed}}"
      has-more="{{false}}"
      manageable="{{false}}"
      capped="{{wallCapped}}"
      bind:switchview="onFeedSwitchView"
      bind:loadmore="onFeedLoadMore"
      bind:retry="onFeedRetry"
      bind:retrymine="onFeedRetryMine"
      bind:openwish="onFeedOpenWish"
      bind:closewish="onFeedCloseWish"
      bind:borrowwish="onFeedBorrowWish"
    />

    <!-- 博物笔记：彩蛋拾得的去处。此前墙上没有任何入口指向它，用户不知道去哪儿看 -->
    <view
      class="ww-relics"
      wx:if="{{relics.total}}"
      bindtap="goRelics"
      hover-class="ww-relics-press"
      hover-stay-time="70"
      aria-role="button"
    >
      <view class="signal-light lamp-brass" aria-hidden="true"></view>
      <text class="ww-relics-text">博物笔记 · 已拾 {{relics.found}} / {{relics.total}} 页</text>
      <text class="ww-relics-chevron" aria-hidden="true">›</text>
    </view>
  </block>

  <!-- 展品卡：从墙头展签点开。认识「马上有」这件展品 → 对着它写一句 / 去它的藏品页。
       只画有出处的字段（config/wallExhibit）与商品记录里读得到的字段；读不到的格子不画。
       纪律（PRD §2.2）：不引导触摸标本。 -->
  <view
    class="ww-exhibit-mask"
    wx:if="{{exhibitOpen && exhibit}}"
    bindtap="closeExhibit"
    catchtouchmove="noop"
    aria-role="button"
    aria-label="关闭展品卡"
  >
    <view class="ww-exhibit-sheet" catchtap="noop" aria-role="dialog" aria-label="展品 {{exhibit.name}}">
      <view class="ww-exhibit-sheet-fiber" aria-hidden="true"></view>
      <view class="ww-exhibit-stage">
        <image wx:if="{{exhibit.cover}}" class="ww-exhibit-stage-img" src="{{exhibit.cover}}" mode="aspectFill" />
        <view wx:else class="ww-exhibit-stage-ph" aria-hidden="true">
          <view class="ww-exhibit-stage-beam"></view>
          <text class="ww-exhibit-stage-glyph">马</text>
        </view>
        <view class="ww-exhibit-stage-plate" aria-hidden="true"><text class="ww-exhibit-stage-plate-t">{{exhibit.name}}</text></view>
      </view>
      <view class="ww-exhibit-body">
        <text class="ww-exhibit-over">展品 · {{exhibit.nameEn}}</text>
        <view class="ww-exhibit-title-row">
          <text class="ww-exhibit-title">{{exhibit.name}}</text>
          <text class="ww-exhibit-sub">{{exhibit.species}}</text>
        </view>
        <text class="ww-exhibit-latin" wx:if="{{exhibit.latinName}}">{{exhibit.latinName}}</text>
        <text class="ww-exhibit-meaning">{{exhibit.meaning}}</text>
        <text class="ww-exhibit-persona">「{{exhibit.persona}}」</text>
        <view class="ww-exhibit-facts">
          <view class="ww-exhibit-fact">
            <text class="ww-exhibit-fact-k">在哪</text>
            <text class="ww-exhibit-fact-v">{{exhibit.storeLabel}} · {{exhibit.visitNote}}</text>
          </view>
          <view class="ww-exhibit-fact">
            <text class="ww-exhibit-fact-k">现场</text>
            <text class="ww-exhibit-fact-v">{{exhibit.scene}}</text>
          </view>
          <view class="ww-exhibit-fact" wx:if="{{exhibit.themeNote}}">
            <text class="ww-exhibit-fact-k">主题</text>
            <text class="ww-exhibit-fact-v">{{exhibit.themeNote}}</text>
          </view>
        </view>
        <view class="ww-exhibit-acts">
          <view class="ww-exhibit-act is-primary" bindtap="exhibitToWish" hover-class="ww-exhibit-act-press" hover-stay-time="70" aria-role="button">对着它写一句</view>
          <view
            class="ww-exhibit-act is-link"
            wx:if="{{productId}}"
            bindtap="goWallProduct"
            hover-class="ww-exhibit-act-press"
            hover-stay-time="70"
            aria-role="link"
            aria-label="去藏品页 {{productTitle}}"
          >去藏品页 ›</view>
        </view>
        <text class="ww-exhibit-idea">{{exhibit.idea}} · {{exhibit.slogan}}</text>
      </view>
    </view>
  </view>

  <!-- 心愿笺：点愿签展开的那张纸。弹幕看得快、愿签看得清、笺看得住 -->
  <view
    class="ww-card-mask"
    wx:if="{{card}}"
    bindtap="closeWishCard"
    catchtouchmove="noop"
    aria-role="button"
    aria-label="关闭心愿笺"
  >
    <view
      class="ww-card"
      catchtap="noop"
      aria-role="dialog"
      aria-label="心愿笺"
    >
      <!-- 笺是"最近看"的一层，给它与牌匾/纸墙同一套纸质材料 -->
      <view class="ww-card-fiber" aria-hidden="true"></view>
      <view class="ww-card-emboss" aria-hidden="true"></view>
      <view class="ww-card-pin" aria-hidden="true"></view>
      <text class="ww-card-over">愿签</text>
      <text class="ww-card-text">{{card.text}}</text>
      <view class="ww-card-meta">
        <text class="ww-card-who">{{card.nickname}}</text>
        <text class="ww-card-time">{{card.timeText}}</text>
      </view>
      <view class="ww-card-tags">
        <text class="ww-card-tag is-warn" wx:if="{{card.hidden}}">已被馆方收起</text>
        <text class="ww-card-tag" wx:if="{{card.isMine}}">我的</text>
        <text class="ww-card-tag" wx:if="{{card.pinned}}">置顶</text>
      </view>
      <view class="ww-card-acts">
        <view class="ww-card-act" bindtap="borrowWishText" hover-class="ww-card-act-press" hover-stay-time="70" aria-role="button">抄一句</view>
        <view class="ww-card-act" bindtap="copyWishText" hover-class="ww-card-act-press" hover-stay-time="70" aria-role="button">复制</view>
        <button class="ww-card-act is-share" open-type="share">祈一份</button>
      </view>
    </view>
  </view>

  <!-- 彩蛋浮层：进页（吉量）/ 落愿（驳）/ 连点灯（騊駼）/ 心愿数（鹿蜀）由注册表驱动，页面只提供这个挂点 -->
  <easter-egg-note id="easterEggNote" />

  <!-- 注册转化：浏览与仪式免费（价值先行），**落愿这一步才要身份**。
       closable=true → 不把用户困在弹窗里；关掉后草稿还在，回来还能接着挂。 -->
  <register-auth-dialog
    show="{{showRegisterDialog}}"
    overline="WISH WALL"
    title="注册后心愿才挂得住"
    desc="一键注册即可把这条心愿挂上墙、收进「我的心愿」，以后每天回来都看得到它。"
    cta="同意并一键注册"
    closable="{{true}}"
    close-text="先不挂"
    from="wish_wall"
    bind:cta="onRegisterDialogCta"
      bind:success="onRegisterSuccess"
    bind:close="onRegisterDialogClose"
    bind:fail="onRegisterDialogFail"
  />

  <!-- 「连续记录云保存」注册钩子（开关 showRitualProfile，缺配置默认关）。
       同一个 RegisterAuthDialog 组件、同一条 cta→success 链，只有文案与来源不同 ——
       只在用户真有可丢的进展（连灯 ≥2 天 / 木鱼 ≥21 下）且未注册时才由 JS 打开。
       closable=true：拒绝的是"现在注册"，不是"删掉我的连灯"，所以给「先存着」，
       关掉之后本地记录一个字都不动。 -->
  <register-auth-dialog
    show="{{showRitualDialog}}"
    overline="RITUAL BACKUP"
    title="注册后连灯记录不丢"
    desc="{{ritualGateDesc}}"
    cta="同意并一键注册"
    closable="{{true}}"
    close-text="先存着"
    from="wish_ritual"
    bind:cta="onRitualDialogCta"
    bind:success="onRitualRegisterSuccess"
    bind:close="onRitualDialogClose"
    bind:fail="onRitualDialogFail"
  />

  <!-- 创新钩子 H2「功德证」的领证注册门禁（开关 showMuyuCertificate，缺字段默认关）。
       同一个 RegisterAuthDialog 组件、同一条 cta→success 链，只有文案与来源不同 ——
       只在用户**点了「领证」且未注册**时才由 JS 打开（入口本身不拦主流程）。
       closable=true：拒绝的是"现在注册"，不是"删掉我的功德"，关掉之后本地计数与已发的证一个字都不动。 -->
  <register-auth-dialog
    show="{{showCertDialog}}"
    overline="MUYU CERTIFICATE"
    title="注册后功德证存得住"
    desc="{{certGateDesc}}"
    cta="同意并一键注册"
    closable="{{true}}"
    close-text="先不领"
    from="muyu_cert"
    bind:cta="onCertDialogCta"
    bind:success="onCertRegisterSuccess"
    bind:close="onCertDialogClose"
    bind:fail="onCertDialogFail"
  />

  <!-- 统一轻提示（AppToast）：钩子的结果反馈（「已存到云端」/「记录仍在本机」）走这里。
       为什么不用 wx.showToast：本页原生调用数被 check:dialog-ratchet 冻结（只许降不许涨）。 -->
  <app-toast
    show="{{toastShow}}"
    overline="{{toastOverline}}"
    title="{{toastTitle}}"
    desc="{{toastDesc}}"
    duration="{{toastDuration}}"
    bind:close="onToastClose"
  />
  <!-- 原「纸签弹层（玩法结果）」整块已下线（2026-09-21 PRD v1.4 §11.4：玩法各开一页）。
       结果 / 写成心愿 / 分享 / 推荐行**原样搬到玩法页**（`.rp-*`，见 subpackages/feature/play-*），
       本页只剩入口区。层叠纪律不变：本页仍是 fixed 覆盖层（H2 功德证）必须是 `.ww-page` 直接子节点。 -->

  <!-- 玩法弹层（2026-09-27 产品口径：六个玩法都在墙上完成，入口不再跳页）。
       组件在 plays 分包（分包异步化，json 里 componentPlaceholder 占位），本体与独立页同一份皮与行为。
       wx:if 挂载：关掉即卸载，墙面挂签台 / 弹幕 / 签廊的状态一概不动。 -->
  <play-sheet
    wx:if="{{playSheetId}}"
    play-id="{{playSheetId}}"
    ctx="{{playSheetCtx}}"
    bind:close="onPlaySheetClose"
    bind:wish="onPlaySheetWish"
    bind:post="onPlaySheetPost"
    bind:share="onPlaySheetShare"
  />

  <!-- 创新钩子 H2「功德证」本体（可保管、可回看）：与纸签弹层同一套纸张语言与层叠纪律 ——
       同样是 .ww-page 的直接子节点（fixed 覆盖层不许待在带 z-index 的祖先里，见上面那段注释）。
       文字**只有计数与日期**（合规口径：文化娱乐向、不涉命理改运），见 utils/muyuCertificate。
       ⚠️ 字宽/折行属本仓「静态检查盲区」，只能真机验；本轮**没有真机验证**，交付说明已如实标注。 -->
  <view
    class="ww-sheet-mask"
    wx:if="{{certCard}}"
    bindtap="closeCertCard"
    aria-role="button"
    aria-label="收起"
  ></view>
  <view
    class="ww-sheet"
    wx:if="{{certCard}}"
    aria-role="dialog"
    aria-label="功德证"
  >
    <view class="ww-sheet-grip"><view class="ww-sheet-grip-bar" aria-hidden="true"></view></view>

    <view class="ww-sheet-head">
      <view class="ww-sheet-head-copy">
        <text class="ww-sheet-overline">MUYU MERIT</text>
        <text class="ww-sheet-name">功德证</text>
      </view>
      <text class="ww-sheet-close" bindtap="closeCertCard" hover-class="ww-sheet-close-press" hover-stay-time="70" aria-role="button">收起</text>
    </view>

    <view class="ww-sheet-body">
      <!-- 只写计数与日期：不写运势、不写改运、不写"心愿应验" -->
      <text class="ww-sheet-title">功德 {{certCard.muyuCount}}</text>
      <text class="ww-sheet-sub">里程 {{certCard.milestone}}</text>
      <text class="ww-sheet-line">领取日期 {{certCard.dayKey}}</text>
    </view>

    <text class="ww-sheet-note">{{certNote}}</text>
  </view>

  <!-- 发送条：**弹幕墙下方**（2026-09-19 产品口径变更）。
       原设计是吸底（§35 产品点头，`position: fixed; bottom: 0`），但产品真机反馈
       「点『写下我的心愿』后页面滚下去、看不到输入框」—— 根因是纸签弹层没收（已修），
       但产品进一步要求把输入放到**更醒目**的位置：弹幕墙下方、与玩法区同屏。
       因此改为**顺流**（`position: static`），不再吸底、不再需要页面底部预留 180rpx。
       ⚠️ 代价（如实记录）：主操作不再「永远在拇指下」，要滚到墙下方才看得到；
       若日后产品觉得吵，改回 fixed 即可（一处样式 + 两条判据）。 -->
</view>
