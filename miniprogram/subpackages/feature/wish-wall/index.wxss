/* ==================== 灯龛 ==================== */

.ww-lantern {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: var(--space-2);
  min-width: 0;
  padding: 22rpx 20rpx;
  /* v3：展龛托盘 —— 双线铜框 + 暖光 */
  background:
    radial-gradient(120% 80% at 18% 0%, rgba(233, 190, 110, 0.18) 0%, transparent 55%),
    linear-gradient(165deg, #2A241C 0%, #18150F 100%);
  border: 2rpx solid rgba(196, 167, 108, 0.48);
  border-radius: var(--radius-lg);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.06),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.12),
    inset 0 -24rpx 48rpx rgba(196, 167, 108, 0.06),
    0 14rpx 28rpx rgba(0, 0, 0, 0.3);
}

.ww-lantern.is-lit {
  border-color: rgba(233, 190, 110, 0.62);
  background:
    radial-gradient(100% 90% at 20% 10%, rgba(233, 190, 110, 0.28) 0%, transparent 50%),
    linear-gradient(125deg, rgba(196, 167, 108, 0.18) 0%, #16140F 58%);
}

/* 按压反馈：与同族卡片同值。
   同族（愿签 .ww-tag / 玩法瓦片 .ww-play / 木鱼卡 .ww-muyu）实测都是 0.86，灯卡原是唯一的 0.9；
   灯卡与木鱼卡在版式上被显式定义成"一对"（守卫已钉住两者内边距一致），按压观感也必须同值。
   2026-09-19 由 0.9 → 0.86，与上面三处对齐。 */
.ww-lantern-press {
  opacity: 0.86;
}

/* 未点灯时内容只有三行，顶对齐会在底部留一截空白（真机截图里与右边的木鱼卡不对称）；
   点亮后是四行、本来就填满，所以只在 is-idle 时居中 —— 不改点亮态的对齐（那是真图确认过的）。
   A3 出图：idle 边再亮半档，一眼读成「可点的仪式」而非静物卡。 */
.ww-lantern.is-idle {
  align-items: center;
  border-color: rgba(196, 167, 108, 0.48);
  background:
    radial-gradient(100% 80% at 20% 0%, rgba(196, 167, 108, 0.12) 0%, transparent 55%),
    linear-gradient(180deg, #1E1B15 0%, #14120E 100%);
}

/* 灯座：固定 56rpx 方盒，光晕与灯芯都在盒内定位 —— 行内绝不放绝对定位元素，
   否则父级宽度一收缩，文案列就被挤成一字一行（历史事故） */
.ww-lantern-box {
  position: relative;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
}

.ww-lantern-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 108rpx;
  height: 108rpx;
  margin: -54rpx 0 0 -54rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(233, 190, 110, 0.5), rgba(233, 190, 110, 0) 70%);
  opacity: 0;
  transform: scale(0.7);
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard);
  pointer-events: none;
}

.ww-lantern.is-lit .ww-lantern-halo {
  opacity: 1;
  transform: scale(1.1);
  animation: ww-lantern-breath 3.6s ease-in-out infinite;
}

@keyframes ww-lantern-breath {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 0.92; transform: scale(1.16); }
}

.ww-lantern-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 46rpx;
  height: 46rpx;
  margin: -23rpx 0 0 -23rpx;
  /* 灯芯 = 附件里的「灯泡」SVG（2026-09-18 产品指定）。
     ⚠️ 图的声明**只有一处**：本文件末尾「点灯 / 木鱼 图标替换」段（连 encoding 也只在那里改）。
     同一个选择器出现两份 background-image 时，后一份会静默吃掉前一份 —— 改哪份都不生效、还看不出来。
     这里只负责**几何 + 两态**；图是单色单路径，所以「未点灯」不另做一张，直接把同一枚调暗。 */
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  opacity: 0.38;
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard);
}

.ww-lantern.is-lit .ww-lantern-core {
  /* 点亮 = 同一枚灯泡回到全亮 + 微微放大；光晕交给 .ww-lantern-halo
     （不用 box-shadow：方形盒子上的阴影会在灯泡背后露出一圈方角） */
  opacity: 1;
  transform: scale(1.06);
}

.ww-lantern-copy {
  flex: 1;
  min-width: 0;
}

/* 灯语 + 灯位说明：整行（不跟标题抢那 ~220rpx 的窄列）。
   整行可用宽 = 卡宽 - 左右 padding = 295rpx；灯语 21rpx × 13 字 = 273rpx，一行装得下。 */
.ww-lantern-tail {
  flex: 0 0 100%;
  min-width: 0;
}

.ww-lantern-title {
  display: block;
  font-size: var(--fs-30);
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 1rpx;
  color: #F2EDE3;
}

.ww-lantern.is-lit .ww-lantern-title {
  color: #E9BE6E;
}

.ww-lantern-line {
  display: block;
  /* 整行的第一行，段间距交给 .ww-lantern 的 gap，不再叠 margin */
  margin-top: 0;
  /* 字号口径：文本带；21rpx 不在字阶 14 档内（20 与 22 的正中间）→ 按"同值换令牌"不动值（见文件头） */
  font-size: 21rpx;
  /* 中文正文行距 1.45 偏挤（真图反馈）；1.6 是这套字号下的舒适值 */
  line-height: 1.6;
  color: var(--brass-400);
}

.ww-lantern-line.is-idle {
  color: var(--color-text-muted);
}

/* 连续天数：小铜牌，不占正文抬头 */
.ww-streak {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 半宽卡里它是"固定宽度"的一份子：原来 76rpx 会把文案列挤到只剩 5–6 个字（标题被压断）。
     压到 48rpx 后文案列多出 ~28rpx（约 1 个字），标题不再折行。 */
  min-width: 48rpx;
  /* 2026-09-24 A3：横排静态行后，竖向 6rpx padding + fs-26 数字把徽章撑到 ~43px，
     点亮态整卡因此多出一截空高。收成 4rpx / fs-22 后徽章 ≈32px，信息不变、密度下来。 */
  padding: 4rpx var(--space-1);
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.1);
}

.ww-streak-n {
  font-size: var(--fs-22);
  line-height: 1.1;
  color: var(--brass-300);
  font-family: var(--font-mono);
}

/* 连续天数：**自己占一行的静态行**（2026-09-20，几何实测后从"浮层"改回来）。
   它此前是文案列右边的一份 flex 子项。半宽卡可用宽 ≈ 450rpx，扣掉图标 64 + 两个 gap 32
   + 本盒 48~76，文案列只剩 ~150rpx —— 而点亮后标题「今日灯已点」= 5 × 30rpx = 150rpx，
   正好卡在断行临界上：离线渲染里实测折成「今日灯已 / 点」（真机字体更宽时同样会折）。
   中间试过"绝对定位到右上角"：折行确实修好了（标题从 2 行 78px 回到 1 行 39px），
   **但它把"标题被挤断"换成了"文字钻到徽章底下"** —— 子代理用 headless-Chrome 量 rect 相交，
   实测徽章 66px：3 盏档压灯位行 4px、5 盏档压标题 18px（「点」整字被盖）。
   给文案列让位（padding-right）又会把标题挤回两行 —— **两个方向都不成立**：
   半宽卡横向要同时容下 标题 155 + 徽章 66 + 灯位行 159 ≈ 380rpx，而文案列只有 ~221rpx，这道加法没有解。
   所以改成**静态行**：徽章在自己的行里，文案列拿满整宽，**不存在横向竞争**。
   代价如实记录：点亮态卡片多一行（约 30rpx）→ 玩法区更靠下（已是本工具的"参考项"，见 §7.3）。
   ⚠️ DOM 顺序（copy → streak → tail）**不变**，test:wish-wall 的顺序判据与
   `.ww-streak { min-width: 48rpx }` 判据都照旧成立。
   判据：render-wall-preview 的「连续天数盒压字」（量文字 rect 的相交，必须为 0）。 */
.ww-lantern .ww-streak {
  /* ⚠️ 它现在是 `.ww-lantern-copy` 的**子节点**（WXML 里挪进去了），不再是 `.ww-lantern` 的 flex 子项 ——
     这是"占一行且保持小徽章"的唯一形态：作为 copy 里的 inline-flex，它在 meta 行之后另起一行、
     宽度收缩到内容（≈58px）；而作为 .ww-lantern 的 flex 子项时，`flex:0 0 100%` 会让它铺成
     横贯整卡的色带、自然宽度又会被挤回标题那一行。 */
  display: inline-flex;
  /* 横排（点 天 数 一行）而不是竖排：它已经独占一行，再竖着堆就是白白多出 ~35rpx 高。 */
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  margin-top: var(--space-1);
}

/* 横排之后"天"字不再需要与数字拉开一行间距 */
.ww-lantern .ww-streak-l {
  margin-top: 0;
}

/* 点亮态的标题**不缩**：连续天数盒已改为静态行（见上），文案列拿满整宽 ——
   「今日灯已点」在 fs-30 下实测 155px ≤ 221px，余量充足，字号与未点亮态保持一致。
   （短暂试过"缩到 fs-28 + 徽章浮层"，那是为了给浮层让路；改静态行后这层妥协不再需要。） */

.ww-streak-l {
  margin-top: 2rpx;
  font-size: var(--fs-18);
  color: #8C857A;
}

/* ==================== 墙面（弹幕舞台） ==================== */

/* 浅纸墙：深字浅底，弹幕才读得清；四条轨道画成极淡的横向导线。
   ⚠️ 2026-09-19：原先文件末尾还有**第二段 `.ww-wall { … }`**（"视觉强化"），只写 border/box-shadow。
   同选择器后者静默覆盖前者 → 这里的 `border: var(--brass-200)` 与底下两层 inset 阴影**从来没生效过**
   （改哪一份都不生效，与本页 .ww-lantern-core 双 background-image 是同一类坑）。
   现把**生效值**（强化版描边 + 内光 + 外投影）合并进本块，末尾那段删除；渲染结果不变，声明只剩一处。 */
.ww-wall {
  position: relative;
  z-index: 1;
  /* 2026-09-20 真合并：页头进墙后本卡**总高改为由内容决定** = 页头(自适应) + 舞台(336) + 页脚带(44)。
     原来固定 380rpx，是因为墙里只有「舞台 + 页脚带」。
     ⚠️「布局不随内容抖动」这条要求**没有放宽**，只是把固定高度落到**舞台本身**
     （.ww-wall-inner 336rpx）：抖动风险来自弹幕行数/动画，而舞台高度仍是死的。
     守卫现在同时钉「舞台 336rpx」与「页脚带 44rpx」两条（比原来钉得更细）。 */
  padding-bottom: 44rpx;   /* 页脚 / 回声带仍是 absolute;bottom:0 → 正好落进这条带，与合并前一致 */
  margin: var(--space-2) 0 var(--space-4);
  overflow: hidden;
  /* v2：展厅嵌墙 —— 更暖的纸、双线铜框、入场动效（hex 必须留在 gradient 里：对比度守卫从这里抽底色） */
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.55) 0%, transparent 28%),
    linear-gradient(180deg, #F8F3E8 0%, #EFE7D6 48%, #E5DCC8 100%);
  border: 2rpx solid var(--ww-frame);
  border-radius: var(--radius-xl);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.55),
    inset 0 0 0 6rpx rgba(196, 167, 108, 0.08),
    0 18rpx 40rpx rgba(0, 0, 0, 0.32);
  animation: ww-wall-in 560ms cubic-bezier(0.22, 0.82, 0.28, 1) both;
}

@keyframes ww-wall-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ww-wall-fiber {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.11;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='2.1' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}

/* 轨道刻度：与 buildDanmakuRows 的 topPercent 对齐（6 轨 → 8/23.2/38.4/53.6/68.8/84）。
   只画左侧一小段 —— 整条横线会像表格线，且弹幕文字正好压在线上，越读越乱。
   活墙感改由挂签纸条承担，刻度仍守「短刻度」判据。
   ⚠️ 刻度挂在 .ww-wall-inner 里：它的高度不含底部页脚，与弹幕同一坐标系。
   ⚠️ 条数必须等于 utils/wishWall 的 LANES（守卫对账）。 */
.ww-wall-rail {
  position: absolute;
  left: 18rpx;
  z-index: 1;
  width: 26rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: rgba(138, 117, 48, 0.28);
  pointer-events: none;
}

.ww-wall-rail::before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: -4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, var(--brass-100) 0%, var(--brass-500) 70%);
  box-shadow: 0 0 0 1rpx rgba(196, 167, 108, 0.28);
}

.ww-wall-rail.rail-1 { top: 8%; }
.ww-wall-rail.rail-2 { top: 23.2%; }
.ww-wall-rail.rail-3 { top: 38.4%; }
.ww-wall-rail.rail-4 { top: 53.6%; }
.ww-wall-rail.rail-5 { top: 68.8%; }
.ww-wall-rail.rail-6 { top: 84%; }

.ww-wall-inner {
  /* 2026-09-20 真合并：页头进墙后，本层从「绝对定位铺满墙的上半」改为**流内固定高度**。
     高度 = 原 380rpx − 页脚带 44rpx = 336rpx —— 与合并前**逐像素相同**，
     所以 buildDanmakuRows 的 topPercent 落位、.ww-wall-rail 的刻度对齐**完全不变**。 */
  position: relative;
  height: 336rpx;
  z-index: 2;
}

/* 单条弹幕：从右向左匀速穿过。时长由 utils/wishWall.danmakuDurationMs 按字数换算；
   只播一轮（forwards）—— 循环播放会让同轨弹幕在第二轮重新叠在一起。
   2026-09-26 活墙：外层仍是动画载体；内层 .ww-dm-slip 是挂签薄皮。
   2026-09-26 B 站式：层级（本人/置顶/刚发）+ 点按短暂停住，运动优先于货架感。 */
.ww-danmaku {
  position: absolute;
  left: 100%;
  display: flex;
  align-items: center;
  white-space: nowrap;
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  font-size: var(--fs-32);
  line-height: 1.3;
  /* A5：色值守卫钉死 #4A4234（浅底深字）；档位色由 .ww-tone-N 覆盖；可读性靠 text-shadow */
  color: #4A4234;
  letter-spacing: 0.02em;
  animation-name: ww-danmaku-scroll;
  animation-timing-function: linear;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
  will-change: transform;
  z-index: 2;
}

/* 挂签薄皮：保留铜绳钉，但背景更透——读起来先是「弹幕」，纸签是皮肤 */
.ww-dm-slip {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  max-width: 92vw;
  padding: var(--space-1) var(--space-2) var(--space-1) var(--space-2);
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.78) 0%, rgba(242, 234, 214, 0.62) 100%);
  border: 1rpx solid rgba(138, 117, 48, 0.32);
  border-radius: 4rpx 8rpx 8rpx 4rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.7),
    0 4rpx 10rpx rgba(48, 40, 16, 0.1);
}

.ww-dm-cord {
  position: absolute;
  left: 14rpx;
  top: -12rpx;
  width: 2rpx;
  height: 12rpx;
  background: linear-gradient(180deg, rgba(138, 117, 48, 0.55), rgba(138, 117, 48, 0.12));
}

.ww-dm-cord::before {
  content: '';
  position: absolute;
  left: -4rpx;
  top: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, var(--brass-100) 0%, var(--brass-500) 70%);
  box-shadow: 0 1rpx 2rpx rgba(48, 40, 16, 0.25);
}

.ww-dm-text {
  text-shadow: 0 1rpx 0 rgba(250, 246, 237, 0.72);
}

/* 本人：左铜条 + 略重字 —— 在滚动海里一眼认出「我的」 */
.ww-danmaku.is-mine {
  z-index: 3;
}

.ww-dm-slip.is-mine-slip {
  border-color: rgba(168, 144, 60, 0.55);
  box-shadow:
    inset 4rpx 0 0 rgba(196, 167, 108, 0.72),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.75),
    0 5rpx 12rpx rgba(48, 40, 16, 0.12);
}

.ww-dm-text.is-mine-text {
  font-weight: 600;
}

/* 置顶：更实的铜框，像 B 站「特殊弹幕」但仍铜系 */
.ww-danmaku.is-pinned-dm {
  z-index: 4;
}

.ww-dm-slip.is-pinned-slip {
  border-color: rgba(168, 144, 60, 0.7);
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.9) 0%, rgba(236, 220, 180, 0.78) 100%);
  box-shadow:
    0 0 0 1rpx rgba(196, 167, 108, 0.28),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.85),
    0 6rpx 14rpx rgba(48, 40, 16, 0.14);
}

/* 刚挂上 / boost：高级弹幕 —— 金边脉冲 + 略抬层级 */
.ww-danmaku.is-boost {
  z-index: 6;
}

.ww-dm-slip.is-landing {
  z-index: 5;
  border-color: rgba(168, 144, 60, 0.85);
  background:
    linear-gradient(180deg, rgba(255, 248, 230, 0.95) 0%, rgba(236, 214, 160, 0.82) 100%);
  box-shadow:
    0 0 0 2rpx rgba(233, 190, 110, 0.55),
    0 0 22rpx rgba(233, 190, 110, 0.35),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.95),
    0 10rpx 22rpx rgba(48, 40, 16, 0.2);
  animation: ww-dm-landing 1.05s cubic-bezier(0.22, 0.82, 0.28, 1) 1;
}

@keyframes ww-dm-landing {
  0% { transform: translateY(-14rpx) scale(1.12); filter: brightness(1.22); }
  50% { transform: translateY(0) scale(1.04); filter: brightness(1.1); }
  100% { transform: translateY(0) scale(1); filter: brightness(1); }
}

@keyframes ww-danmaku-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(calc(-100vw - 100%)); }
}

/* 墙面 → 心愿笺：弹幕不是装饰，点一条能展开那张纸 */
.ww-danmaku-press {
  opacity: 0.92;
  filter: brightness(1.06);
}

/* 点按短暂停住（B 站式）：暂停滚动 + 微放大 + 铜火花 */
.ww-danmaku.is-held {
  z-index: 9;
  animation-play-state: paused !important;
  filter: brightness(1.08);
}

.ww-danmaku.is-held .ww-dm-slip {
  transform: scale(1.06);
  border-color: rgba(168, 144, 60, 0.8);
  box-shadow:
    0 0 0 2rpx rgba(233, 190, 110, 0.45),
    0 8rpx 18rpx rgba(48, 40, 16, 0.2);
}

.ww-dm-spark {
  position: absolute;
  right: -6rpx;
  top: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, var(--brass-50) 0%, var(--brass-300) 55%, transparent 72%);
  box-shadow: 0 0 12rpx rgba(233, 190, 110, 0.85);
  animation: ww-dm-spark 560ms ease-out 1 both;
  pointer-events: none;
}

@keyframes ww-dm-spark {
  0% { transform: scale(0.4); opacity: 0; }
  35% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(0.6); opacity: 0; }
}

/* 墙上只留置顶的铜钉（「馆方」灰钉已随徽章一起下线） */
.ww-dm-mark {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.ww-dm-mark.is-pinned {
  background: radial-gradient(circle at 36% 34%, var(--brass-100) 0%, var(--brass-500) 70%);
  box-shadow: 0 0 0 2rpx rgba(196, 167, 108, 0.35);
}

/* 刚落愿那一句在墙上先亮一下，随后随高亮一起褪回 */
.ww-dm-text.is-fresh {
  color: var(--brass-700);
  text-shadow:
    0 0 18rpx rgba(233, 190, 110, 1),
    0 0 4rpx rgba(122, 92, 44, 0.5),
    0 1rpx 0 rgba(250, 246, 237, 0.85);
  font-weight: 700;
  animation: ww-dm-fresh-pulse 1.2s ease-out 2;
}

@keyframes ww-dm-fresh-pulse {
  0%, 100% { filter: brightness(1); }
  40% { filter: brightness(1.18); }
}

/* 墙面空态：展厅空龛（加载态走 .ww-wall-skel，不写这行字） */
.ww-wall-empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: var(--fs-24);
  color: #8A7E66;
}

.ww-wall-empty-mark {
  width: 72rpx;
  height: 6rpx;
  margin-bottom: 12rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, transparent, rgba(168, 144, 60, 0.7), transparent);
  box-shadow: none;
}

.ww-wall-empty-title {
  font-size: var(--fs-32);
  letter-spacing: 0.12em;
  color: #3A2E12;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-weight: 700;
}

.ww-wall-empty-desc {
  font-size: var(--fs-22);
  letter-spacing: 0.04em;
  color: rgba(90, 74, 36, 0.78);
}

.ww-wall-foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  height: 44rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 18rpx 0 20rpx;
  /* v2：嵌墙页脚 —— 更暖的铜条 */
  background: linear-gradient(180deg, #EFE6D2 0%, #E4D9C2 100%);
  border-top: 1px solid rgba(138, 117, 48, 0.32);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.45);
}

.ww-wall-foot .signal-light {
  box-shadow: none;
}

.ww-wall-foot-text {
  font-size: var(--fs-20);
  letter-spacing: 0.06em;
  color: #5A4A28;
  font-weight: 500;
}

/* 「看全部 ›」：铜门把手胶囊 —— 进愿签流的显式入口（页脚整行可点，见 goWishList） */
.ww-wall-foot-more {
  margin-left: auto;
  padding: 4rpx var(--space-2);
  font-size: var(--fs-18);
  letter-spacing: 0.08em;
  color: #2A220E;
  font-weight: 700;
  background: linear-gradient(150deg, #F0E2B8 0%, var(--brass-400) 55%, var(--brass-600) 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.45);
  border-radius: 999rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.45),
    0 2rpx 6rpx rgba(48, 40, 16, 0.18);
}

.ww-wall-foot-press {
  background: rgba(233, 190, 110, 0.28);
}

.ww-wall-foot-press .ww-wall-foot-more {
  filter: brightness(0.94);
}

/* ── 即时反馈回声（需求 28 · 玩法动作 → 墙的回应）──────────────────────
   位置：与页脚同一条 44rpx 带（z-index 在页脚之上覆盖它），因为这是墙内唯一不会被
   弹幕穿过的横向条带（第 4 轨在 84%，轨下只剩 ~17rpx）。
   时长的唯一事实源是 utils/ritualFeedback.ECHO_HOLD_MS（1800ms），
   页面那个计时器负责移除 DOM，这里只负责"进-停-出"的观感，两处必须同值。 */
.ww-echo {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  height: 44rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 20rpx;
  /* ⚠️ 必须**不透明**：2026-09-18 真机截图里，半透明的这条带让下面的页脚文字透上来，
     「我拆开了今天的签饼」与「26 条心愿正在墙上流动」叠成两行字（看着像渲染错乱）。
     带子整条盖住页脚是**故意的** —— 回声期间不需要同时读页脚。
     v2：铜金不透明条，落愿回响一眼盖住页脚。 */
  background: linear-gradient(90deg, #E8C878 0%, #F4EBD4 48%, #E6D7A8 100%);
  border-top: 1px solid rgba(138, 117, 48, 0.48);
  box-shadow: 0 -6rpx 16rpx rgba(196, 167, 108, 0.28);
  animation: ww-echo-life 1800ms ease-out forwards;
}

.ww-echo-text {
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: #3A2E12;
  font-weight: 700;
}

.ww-echo-sub {
  font-size: var(--fs-18);
  color: rgba(74, 58, 20, 0.78);
  opacity: 0.95;
}

/* 8% 处淡入（快，手感是即时的）、82% 起淡出（慢，不留残影到下一轮） */
@keyframes ww-echo-life {
  0% { opacity: 0; transform: translateY(8rpx); }
  8% { opacity: 1; transform: translateY(0); }
  82% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-4rpx); }
}

/* 墙本身也"吸一口气"：只有边框与内光闪一下，不动尺寸、不动轨道（改几何会牵动弹幕布局） */
.ww-wall.is-echo {
  animation: ww-echo-wall 900ms ease-out 1;
}

@keyframes ww-echo-wall {
  0% { box-shadow: inset 0 0 0 rgba(233, 190, 110, 0); }
  30% { box-shadow: inset 0 0 64rpx rgba(233, 190, 110, 0.42); }
  100% { box-shadow: inset 0 0 0 rgba(233, 190, 110, 0); }
}

/* ==================== 写愿区（2026-09-20 改造） ====================
   这里原来是一张独立的「写愿签」卡（`.ww-write`），位置在灯 / 木鱼 / 玩法**之后**。
   问题（离线版式实测，不是观感）：灵感行距发送条 **586px、整块在首屏之外**，
   而 `useInspiration` 只改 draft、既不聚焦也不滚动 —— 点一下的唯一反馈是远处一个数字跳了一下，
   真机反馈就是「点了像没反应」。现在灵感词 + 额度 + 字数贴在发送条正下方（`.ww-wishassist`），
   与输入框同一视线、点完就能看到输入框里的字。
   为什么不另给卡底：它与发送条本来就该读成一组（发送条自己是透明的，见 `.ww-composer` 的说明）。 */
.ww-wishassist {
  position: relative;
  z-index: 1;
  margin-top: var(--space-2);
  /* 2026-09-24 续升：写愿助手与仪式区拉开，composer 块收束清晰 */
  margin-bottom: var(--space-1);
  padding: 0 4rpx;
}

.ww-inspo {
  display: flex;
  /* 2026-09-24 真机：「灵感」偏上、chips 一行时像脱节 → 与首行 chip 垂直居中 */
  align-items: center;
  gap: 12rpx;
}

.ww-inspo-label {
  flex-shrink: 0;
  margin-top: 0;
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

.ww-inspo-row {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ww-inspo-chip {
  min-height: 44rpx;
  padding: var(--space-1) var(--space-2);
  box-sizing: border-box;
  font-size: var(--fs-22);
  line-height: 1.35;
  color: #E8D9A8;
  /* v2：挂签台助手 —— 浅铜壳，与深墨输入槽成对 */
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.22) 0%, rgba(196, 167, 108, 0.1) 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.48);
  border-radius: 999rpx;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.12);
}

.ww-inspo-press {
  background: rgba(196, 167, 108, 0.28);
  opacity: 0.86;
}

/* 发送条（**顺流**，2026-09-19 产品口径变更）：
   原为吸底（2026-09-18 产品确认「主操作永远在拇指下」），现按产品要求移到
   **弹幕墙下方、玩法区上方**，改为随文档流排布 —— 更醒目、不再有遮挡风险。
   ⚠️ 取舍：主操作不再「永远在拇指下」，要滚到墙下方才看得到。
   ⚠️ 位置变了，**层叠上下文的问题也随之消失**：原吸底版必须是 .ww-page 的直接子节点
   （否则被 .ww-write 的 z-index:1 上下文压住，真机出现"互相遮挡"）；
   顺流后它落在 .ww-write 内部，与愿签卡同层，不再需要 z-index 与不透明底来盖东西。
   若产品日后觉得吵要改回吸底：恢复 position:fixed + .ww-page 的 180rpx 底部预留，
   并把 test:wish-wall 的两条吸底判据一起改回（见该文件「发送条吸底」断言）。 */
/* ==================== 厅内挂签台（2026-09-26） ====================
   外壳 .ww-desk 承担展陈底；.ww-composer 本身必须保持 static + transparent（守卫钉死）。 */
.ww-desk {
  position: relative;
  z-index: 1;
  margin: var(--space-1) 0 var(--space-3);
  padding: 22rpx 22rpx 20rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-xl);
  background:
    radial-gradient(80% 50% at 50% 0%, rgba(212, 188, 133, 0.18), transparent 55%),
    linear-gradient(165deg, #1A1712 0%, #12100C 55%, #0E0C0A 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.05),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.08),
    0 16rpx 36rpx rgba(0, 0, 0, 0.32);
}

.ww-desk-lintel {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.28);
}

.ww-desk-seal {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #F0E2B8 0%, var(--brass-300) 42%, var(--brass-500) 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.5);
  box-shadow:
    inset 0 2rpx 0 rgba(250, 246, 237, 0.5),
    0 6rpx 14rpx rgba(0, 0, 0, 0.28);
}

.ww-desk-seal-t {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: var(--fs-28);
  font-weight: 700;
  color: #2A220E;
  letter-spacing: 0.08em;
}

.ww-desk-copy {
  flex: 1;
  min-width: 0;
}

.ww-desk-title {
  display: block;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: var(--fs-30);
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--brass-50);
}

.ww-desk-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  letter-spacing: 0.04em;
  color: rgba(224, 207, 163, 0.62);
}

.ww-desk .ww-composer {
  margin: 0;
}

.ww-desk .ww-wishassist {
  margin-top: var(--space-2);
  margin-bottom: 0;
  padding: 0;
}

.ww-desk .ww-inspo-label {
  color: rgba(224, 207, 163, 0.55);
}

.ww-desk .ww-quota,
.ww-desk .ww-count {
  color: rgba(224, 207, 163, 0.48);
}

/* 落愿瞬间：台面铜金回响，与墙脚 echo / 挂签 is-landing 同窗 */
.ww-desk.is-posted {
  border-color: rgba(212, 188, 133, 0.72);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.1),
    inset 0 0 48rpx rgba(233, 190, 110, 0.22),
    0 16rpx 36rpx rgba(0, 0, 0, 0.32);
  animation: ww-desk-posted 900ms ease-out 1;
}

.ww-desk.is-posted .ww-desk-seal {
  background: linear-gradient(145deg, var(--brass-50) 0%, #F0E2B8 40%, var(--brass-400) 100%);
  box-shadow:
    0 0 0 4rpx rgba(233, 190, 110, 0.35),
    inset 0 2rpx 0 rgba(250, 246, 237, 0.65),
    0 6rpx 14rpx rgba(0, 0, 0, 0.28);
}

.ww-desk.is-posted .ww-desk-title {
  color: #F0E2B8;
}

@keyframes ww-desk-posted {
  0% { filter: brightness(1); }
  35% { filter: brightness(1.12); }
  100% { filter: brightness(1); }
}

.ww-composer {
  /* 显式 static：让「已从吸底改为顺流」这个设计意图读得出来，也是 test:wish-wall 的判据锚点
     （判据按设计模式分支 —— 若这里被改回 fixed，吸底那一套遮挡判据会自动复活）。 */
  position: static;
  display: flex;
  align-items: center;
  gap: 14rpx;
  /* 守卫钉死：顺流时 background 必须 transparent */
  margin: var(--space-3) 0 var(--space-1);
  padding: 0;
  background: transparent;
}

.ww-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 var(--space-3);
  box-sizing: border-box;
  font-size: var(--fs-26);
  color: #F2EDE3;
  /* v2：挂签台 —— 深墨槽 + 铜框，一眼是「写」的入口 */
  background: linear-gradient(180deg, #1A1712 0%, #12100C 100%);
  border: 2rpx solid rgba(196, 167, 108, 0.48);
  border-radius: 999rpx;
  box-shadow:
    inset 0 2rpx 8rpx rgba(0, 0, 0, 0.35),
    0 0 0 1rpx rgba(250, 246, 237, 0.04);
}

.ww-input-ph {
  color: rgba(224, 207, 163, 0.42);
}

.ww-send {
  flex-shrink: 0;
  height: 88rpx;
  min-width: 168rpx;
  padding: 0 var(--space-4);
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-26);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #2A220E;
  /* v2：主钮更像铜铸章 */
  background: linear-gradient(155deg, #F0E2B8 0%, var(--brass-300) 42%, var(--brass-500) 100%);
  border: 1rpx solid rgba(224, 207, 163, 0.5);
  border-radius: 999rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.55),
    0 10rpx 22rpx rgba(0, 0, 0, 0.32);
}

.ww-send-press {
  background: var(--brass-500);
  /* 与墙内同族可点面一致：0.86 */
  opacity: 0.86;
}

.ww-send.is-off {
  opacity: 0.42;
}

.ww-write-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2);
  /* 2026-09-24 真机：灵感行与额度行略挤 */
  margin-top: 14rpx;
}

/* 今日额度：如实预告（上限与云函数 DAILY_LIMIT 同源），别让用户写完才被拒 */
.ww-quota {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20);
  color: var(--color-text-muted);
}

.ww-quota.is-done {
  color: var(--color-warning);
}

/* 额度**读不到**（mine 失败）时的专属态。
   为什么必须与普通态区分：普通态是灰（一句事实），用完是橙（警示），
   而"读不到"是第三种 —— 它既不是事实也不是警示，是"这条信息暂时没有"。
   三者共用一色会让用户以为额度还是准的（2026-09-20 修；子代理静态扫描抓到 `is-unknown` 无规则）。 */
.ww-quota.is-unknown {
  color: var(--brass-300);
}

.ww-count {
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  font-family: var(--font-mono);
}

.ww-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: var(--space-2) 20rpx;
  border: 1rpx solid rgba(233, 162, 59, 0.32);
  border-radius: var(--radius-sm);
}

.ww-notice .signal-light {
  margin-top: var(--space-1);
}

.ww-notice-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-warning);
}

/* ==================== 愿签列表 ==================== */

.ww-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: var(--space-4) 0 var(--space-2);
}

/* 分段控件：两个视图是"切换"，不是"两个标题" —— 容器给底、选中给铜底 */
.ww-seg {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.06);
}

.ww-seg-item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1) 20rpx;
  border-radius: 999rpx;
}

.ww-seg-press {
  opacity: 0.75;
}

.ww-seg-label {
  font-size: var(--fs-24);
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
}

.ww-seg-n {
  font-size: var(--fs-18);
  font-family: var(--font-mono);
  color: var(--color-text-muted);
}

/* 两列瀑布：列内纵向堆叠，列间等宽；文案 2–30 字差异大，按行对齐会留空洞 */
.ww-tag-cols {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.ww-tag-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 愿签：左侧铜线是"签绳"，顶部左铜钉 + 右印章，正文手写体 */
.ww-tag {
  position: relative;
  /* 顶部 48rpx 是"顶带"：左铜钉 + 右印章落在这里，正文从顶带下方起排。
     实测：34rpx 时印章压行盒 5rpx；46rpx 仍差 0.5rpx（视口下看不见，
     但 Android 走衬线回退时行高不同会真的压上）—— 故留 2.8rpx 余量。 */
  padding: var(--space-6) var(--space-2) var(--space-2) 22rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #221F1A 0%, #1B1917 100%);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.ww-tag::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.7) 0%, rgba(196, 167, 108, 0.12) 100%);
}

.ww-tag-pin {
  position: absolute;
  left: 5rpx;
  top: 17rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, var(--brass-200) 0%, var(--brass-500) 70%);
}

.ww-tag-text {
  display: block;
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  font-size: var(--fs-30);
  line-height: 1.5;
  color: var(--brass-100);
  word-break: break-all;
}

.ww-tag-foot {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-top: 10rpx;
  min-width: 0;
}

.ww-tag-avatar {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.24);
}

.ww-tag-meta {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 印记（已收起 / 我的 / 置顶）：贴在签右上角（与正文错开，靠 padding-top 预留的顶带）。
   「馆方」印章已下线（2026-09-18 产品决定），它的 .is-official 样式一并删除 —— 不留死样式 */
.ww-tag-seal {
  position: absolute;
  right: 12rpx;
  top: 14rpx;
  padding: 2rpx var(--space-1);
  font-size: var(--fs-16);
  line-height: 1.4;
  letter-spacing: 0.04em;
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.08);
}

.ww-tags-empty {
  position: relative;
  z-index: 1;
  padding: var(--space-5) 0;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-muted);
}

/* 收尾条：让"到底了"看得出来（原来 30 条一路滚下去没有终点） */
.ww-end {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: 28rpx 0 var(--space-1);
}

.ww-end-rule {
  flex: 1;
  height: 1px;
  background: rgba(196, 167, 108, 0.16);
}

.ww-end-text {
  flex-shrink: 0;
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

/* ==================== 加载骨架 / 错误重试（对齐全站约定） ====================
 * 全站约定：加载中出骨架（全局 keyframes `skeleton-shimmer`），不是一行文字；
 * 浅纸面用纸色微光，深卡用铜色微光（与 wallet 的 `.wallet-leather-skel` 同配方）。
 */

.ww-wall-skel {
  position: absolute;
  left: 18rpx;
  height: 28rpx;
  border-radius: var(--radius-sm);
  /* v2：浅纸墙上的铜箔条 —— 比旧灰条更像「签」即将落地 */
  background: linear-gradient(
    90deg,
    rgba(168, 144, 60, 0.1) 0%,
    rgba(212, 188, 133, 0.38) 46%,
    rgba(168, 144, 60, 0.1) 100%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
  box-shadow:
    0 1rpx 0 rgba(250, 246, 237, 0.45),
    inset 0 0 0 1rpx rgba(196, 167, 108, 0.18);
}

.ww-wall-skel::before {
  content: '';
  position: absolute;
  left: -14rpx;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-top: -4rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, var(--brass-100) 0%, var(--brass-500) 70%);
  box-shadow: 0 0 0 1rpx rgba(196, 167, 108, 0.3);
}

/* 四条骨架压在四轨位置上，读作"这里马上会有字" */
.ww-wall-skel.skel-1 { top: 8%; width: 46%; }
.ww-wall-skel.skel-2 { top: 33.3%; width: 62%; }
.ww-wall-skel.skel-3 { top: 58.7%; width: 38%; }
.ww-wall-skel.skel-4 { top: 84%; width: 54%; }

.ww-wall-foot.is-loading {
  background: linear-gradient(180deg, #E8DFCC 0%, #DDD2BA 100%);
}

.ww-wall-foot.is-loading .ww-wall-foot-text {
  color: rgba(90, 74, 36, 0.55);
}

.ww-wall-foot.is-loading .ww-wall-foot-more {
  opacity: 0.55;
}

.wallet-skel {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.08) 0%,
    rgba(212, 188, 133, 0.2) 46%,
    rgba(196, 167, 108, 0.08) 100%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

.ww-tag-skel {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  /* ⚠️ 2026-09-20 修：这里的 padding 原为 `20rpx 22rpx 20rpx 26rpx`，与**真卡**的
     `48rpx(顶带) 16rpx 16rpx 22rpx` 完全不同 → 骨架总高 ~92rpx、真卡 ~155rpx，
     **加载完成时整列会跳高 40%**（骨架存在的意义正是防止这个）。
     现在与真卡**逐字同口径**（顶带 --space-6 + 左右/底 --space-2 + 左 22rpx），
     并把内部块撑到真卡的正文+底行高度。
     ⚠️ 必须写成令牌：48/16 正是 --space-6/--space-2 的值，写裸字面量会被
     「与 --space-* 同值的间距一律写成令牌」拦下（本轮实测踩到）。 */
  padding: var(--space-6) var(--space-2) var(--space-2) 22rpx;
  margin-bottom: 14rpx;
  /* 与真卡 .ww-tag 同底同渐变：骨架被真卡替换时不许跳色（原写 #1F1D1A，比真卡顶色浅一档）。 */
  background: linear-gradient(180deg, #221F1A 0%, #1B1917 100%);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.ww-tag-skel-pin {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.25);
}

.ww-tag-skel-avatar {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.ww-tag-skel-main {
  flex: 1;
  min-width: 0;
  /* 2026-09-20：撑到真卡「正文一行(45rpx) + 底行间距(10rpx) + 头像(36rpx)」≈ 91rpx。
     不撑开的话 flex 行只有头像的 36rpx 高，骨架总高 ~92rpx vs 真卡 ~155rpx → 加载时整列跳高。 */
  min-height: 91rpx;
}

.ww-tag-skel-line {
  height: 22rpx;
}

.ww-tag-skel-line.is-w1 { width: 52%; }
.ww-tag-skel-line.is-w2 { width: 32%; margin-top: 12rpx; height: 18rpx; }

/* 错误态：与全站 `list-error + 再试一次` 同构
   （礼券夹/礼赠/积分/首页/订单都有重试入口，本页原来只能靠下拉刷新碰运气） */
.ww-error {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid rgba(233, 162, 59, 0.28);
  border-radius: var(--radius-md);
}

.ww-error-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-24);
  line-height: 1.5;
  color: var(--color-warning);
}

.ww-error-retry {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  font-size: var(--fs-24);
  color: var(--brass-400);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-sm);
}

.ww-error-retry-press {
  background: rgba(196, 167, 108, 0.12);
  opacity: 0.9;
}

/* ==================== 灯位层级 / 节气（仪式升级） ==================== */

/* 徽章行：独立于标题，允许折行（半宽卡里挤不下时折行，而不是把标题压断） */
.ww-lantern-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-1);
  /* 徽章与标题之间要能"呼吸"：6rpx 在真机上等于贴着（文案拥挤的一半来源） */
  margin-top: 12rpx;
}

.ww-lantern-tier,
.ww-lantern-solar {
  padding: 2rpx 10rpx;
  font-size: var(--fs-18);
  line-height: 1.5;
  border-radius: var(--radius-sm);
}

/* 灯位称号：铜色实心 —— 它是"连着来"攒出来的，要比节气更实 */
.ww-lantern-tier {
  color: var(--color-bg);
  background: var(--brass-400);
}

/* 节气：描边，只在当天出现 */
.ww-lantern-solar {
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
}

/* 距下一个节气：与节气同日出现时被 wx:elif 挡掉，所以两者不会同屏 */
.ww-lantern-next {
  font-size: var(--fs-18);
  color: var(--color-text-muted);
}

.ww-lantern-note {
  display: block;
  /* 灯位说明是三级信息：与灯语拉开 8rpx，字号再降一档、颜色压到 muted */
  margin-top: var(--space-1);
  /* 字号口径：文本带；19rpx 不在字阶 14 档内（18 与 20 的正中间）→ 不动值（见文件头） */
  font-size: 19rpx;
  line-height: 1.5;
  /* 2026-09-24 真机：点亮后灯语+说明+徽章挤成一块灰金 → 说明再降一档透明度，不改字号/间距（守卫钉住） */
  color: rgba(138, 133, 124, 0.78);
}

/* 连续点灯的小灯排：盏数由 lampTier 决定（1/3/5） */
.ww-lamps {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 2rpx;
  /* ⚠️ **固定宽度**（2026-09-20，子代理几何实测后修）：点子数随连灯档位变（1/3/5 盏），
     宽度若跟着变，右上角徽章就"几天宽一点"，与标题抢的宽度**不可预测** ——
     实测 5 盏档徽章宽 84px，把标题「今日灯已点」右端 18px 压到了徽章底下（整字被盖）。
     钉死 40rpx 后 1/3/5 点同宽（5×6 + 4×2 = 38 ≤ 40），徽章宽度是常量，
     文案列的可用宽度因此**可算**（这也是"不再压字"能被判据证明的前提）。
     点子仍然按档位画（1/3/5），只是容器不再随它伸缩。 */
  width: 40rpx;
  height: 10rpx;
  /* 竖排时代给"点阵在上、数字在下"留的 margin-bottom；2026-09-20 改横排后已无用，
     留着只会在行内把徽章再撑高一点。 */
}

.ww-lamp-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--brass-300);
  box-shadow: 0 0 8rpx rgba(233, 190, 110, 0.7);
}

/* ==================== 视图切换（墙上 / 我的心愿） ==================== */

/* 选中态：铜底 + 深字，一眼看出"当前在哪一栏" */
.ww-seg-item.is-on {
  background: linear-gradient(160deg, var(--brass-300) 0%, var(--brass-400) 48%, var(--brass-500) 100%);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.35);
}

.ww-seg-item.is-on .ww-seg-label {
  color: var(--color-bg);
}

.ww-seg-item.is-on .ww-seg-n {
  color: rgba(26, 24, 20, 0.7);
}

/* ==================== 愿签印记（已收起 / 我的） ==================== */

/* 刚落愿的愿签：铜光呼吸一下，把"它落在墙上了"说清楚 */
.ww-tag.is-fresh {
  border-color: rgba(196, 167, 108, 0.85);
  box-shadow: 0 0 0 1rpx rgba(196, 167, 108, 0.35), 0 6rpx 24rpx rgba(233, 190, 110, 0.18);
  animation: ww-fresh-in 0.5s ease-out both;
}

@keyframes ww-fresh-in {
  from { opacity: 0; transform: translateY(-12rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.ww-tag-press {
  opacity: 0.86;
}

/* ⚠️ 2026-09-20 改造：`.ww-tag-seal.is-mine`（金色「我的」章）整条下线。
   理由与 2026-09-18 下线「馆方」章**完全相同**：产品负责人真机截图里 6 张愿签有 5 张盖着它
   —— 重复 5 次的信息不再是信息，只是噪音。
   信号改挂在卡片**已有的左侧铜绳**（`.ww-tag::before`）上：粗一档 + 铜色实心 + 一圈微光。
   为什么复用而不是新加元素：`::before` 本来就画在左边缘（3rpx 淡铜竖线），
   加粗加亮**不改任何盒尺寸**，不会把正文挤动一行 —— 换成一个新元素就要重新配平顶部 48rpx 顶带。
   一眼扫得到"哪条是我的"，但不占一行、不与标题抢视线。 */
.ww-tag.is-mine::before {
  width: 5rpx;
  top: 8rpx;
  bottom: 8rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, var(--brass-300) 0%, var(--brass-500) 100%);
  box-shadow: none;
}

.ww-tag-seal.is-hidden {
  color: var(--color-warning);
  border-color: rgba(233, 162, 59, 0.5);
  background: rgba(233, 162, 59, 0.1);
}

/* ==================== 博物笔记入口 ==================== */

.ww-relics {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-4);
  padding: 20rpx var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
}

.ww-relics-press {
  opacity: 0.9;
}

.ww-relics-text {
  flex: 1;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.ww-relics-chevron {
  color: var(--brass-400);
}

/* ==================== 心愿笺浮层 ==================== */

/* z-index 9980 < 彩蛋浮层 9990：彩蛋永远在最上层，不能被心愿笺压住 */
.ww-card-mask {
  position: fixed;
  inset: 0;
  z-index: 9980;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(10, 9, 8, 0.72);
}

/* 笺是浅纸：与牌匾/墙面同一套"纸"的语言 */
.ww-card {
  position: relative;
  width: 100%;
  padding: 44rpx 36rpx var(--space-4);
  background: linear-gradient(168deg, #F5F0E6 0%, #EFE8DA 100%);
  border-radius: var(--radius-lg);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

/* 纸纤维：与牌匾（.ww-fiber）、纸墙（.ww-wall-fiber）同一纹理语言 */
.ww-card-fiber {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  border-radius: var(--radius-lg);
  opacity: 0.5;
  pointer-events: none;
  background-image:
    repeating-linear-gradient(94deg, rgba(120, 104, 70, 0.05) 0 1px, transparent 1px 4px),
    repeating-linear-gradient(4deg, rgba(120, 104, 70, 0.04) 0 1px, transparent 1px 6px);
}

/* 压印：四周内阴影，纸才有厚度 */
.ww-card-emboss {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  border-radius: var(--radius-lg);
  pointer-events: none;
  box-shadow: inset 0 0 0 1rpx rgba(120, 104, 70, 0.16), inset 0 18rpx 36rpx rgba(120, 104, 70, 0.08);
}

/* 材料层是绝对定位的，会盖在静态内容上 —— 内容必须显式抬层 */
.ww-card-over,
.ww-card-tags,
.ww-card-acts {
  position: relative;
  z-index: 1;
}

.ww-card-pin {
  position: absolute;
  left: 50%;
  top: -10rpx;
  width: 72rpx;
  height: 20rpx;
  margin-left: -36rpx;
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.55);
}

.ww-card-over {
  display: block;
  font-size: var(--fs-18);
  letter-spacing: 0.3em;
  color: #8C7A50;
}

.ww-card-text {
  display: block;
  margin-top: 18rpx;
  font-family: var(--font-brand);
  /* 字号口径：文本带；42rpx 不在字阶 14 档内（--fs-40 与 --fs-44 各差 2rpx = 无唯一就近，改值会改观感）→ 不动值（见文件头） */
  font-size: 42rpx;
  line-height: 1.5;
  color: #241F18;
  word-break: break-all;
}

.ww-card-meta {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 22rpx;
}

.ww-card-who {
  font-size: var(--fs-22);
  color: #5C5347;
}

.ww-card-time {
  font-size: var(--fs-20);
  color: #8C857A;
}

.ww-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin-top: 12rpx;
}

.ww-card-tag {
  padding: 2rpx 10rpx;
  font-size: var(--fs-18);
  color: #6E5B28;
  border: 1rpx solid rgba(110, 91, 40, 0.35);
  border-radius: var(--radius-sm);
}

.ww-card-tag.is-warn {
  color: #A8541C;
  border-color: rgba(168, 84, 28, 0.4);
}

.ww-card-acts {
  display: flex;
  gap: var(--space-2);
  margin-top: 28rpx;
}

.ww-card-act {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: var(--fs-26);
  color: #241F18;
  border: 1rpx solid rgba(110, 91, 40, 0.4);
  border-radius: 999rpx;
}

.ww-card-act-press {
  background: rgba(110, 91, 40, 0.08);
}

/* button 自带默认样式与 ::after 边框，必须显式重置，否则三个动作高度不齐 */
.ww-card-act.is-share {
  padding: 0;
  margin: 0;
  background: #6E5B28;
  color: #F7F3EA;
  border-color: #6E5B28;
  font-size: var(--fs-26);
  font-weight: 400;
}

.ww-card-act.is-share::after {
  border: none;
}

/* ── 弹幕 6 档配色（2026-09-18 重做：按**浅纸**墙面配色） ──────────────────
   ⚠️ 上一版取的是「中高明度、保证**深色墙面**上可读」的色 —— 可墙面后来改成了浅纸
   （`linear-gradient(#F6F1E7 → #E7DFCF)`），于是 6 档在纸上只有 **1.0–1.8:1**：
   最浅的「素笺」几乎隐形（实测截图里那几条"发虚"的弹幕就是它）。
   现在按浅纸重做：统一**深墨/矿物色**，对墙面的三个渐变停靠点最差 **5.23:1**（AA 需 4.5:1）。
   配色仍由 utils/wishWall.js 按 id 稳定分配（确定性，非随机）。
   守卫：test:wish-wall 里**真的算对比度**（读本文件的色值 × 墙面渐变），低于 4.5 即失败。 */
.ww-tone-0 { color: #4A4234; }   /* 素笺（墨） */
.ww-tone-1 { color: #6E5019; }   /* 铜金 */
.ww-tone-2 { color: #38602F; }   /* 苔绿 */
.ww-tone-3 { color: #2F5D78; }   /* 远海 */
.ww-tone-4 { color: #8A4640; }   /* 珊瑚 */
.ww-tone-5 { color: #5B4A78; }   /* 紫晶 */
.ww-emoji {
  margin-right: 6rpx;
  font-size: var(--fs-26);
  opacity: 0.92;
}

/* ── 点灯爱心动效（2026-09-19）：一次性飘起、错落上行、渐隐 ──────────────
   只在 heartBurst 为真时挂载（js 2.6s 后收起）→ 不会常驻重播；
   暖色系 + 低透明度，克制，不抢弹幕注意力。 */
.ww-hearts {
  position: absolute;
  left: 50%;
  bottom: 56rpx;
  pointer-events: none;
}
/* 点灯后的余烬（2026-09-20 动效专项）：
   此前 5 颗 ♥ 用了 **4 种颜色**，其中 `#E0A9A0`（粉）与 `#C7B4DE`（紫）**不在本页的纸/铜语言里**
   —— 子代理审计把这两个值列为"无等价 token 的离群色"，而它们恰好只出现在这一处动效上。
   现在统一到铜色三档（200/300/400），层次改由**明度 + 字号 + 横向错位**表达，而不是靠换色相：
   色相一多，五颗心读起来像贴纸，而不像一盏铜灯升起的余烬。
   横向错位用 `left`（不写进 @keyframes 的 var/calc）：keyframes 里只有负责居中的 translate(-50%)，
   left 负责散开 —— 这样不必在动画里求值自定义属性，基础库兼容面更宽。 */
.ww-heart {
  position: absolute;
  left: 0;
  bottom: 0;
  font-size: var(--fs-26);
  color: var(--brass-300);
  opacity: 0;
  /* 与全页动效同一缓动族（ease-out）；此前它是唯一写 `ease` 的一处 */
  animation: ww-heart-float 1.6s ease-out forwards;
  text-shadow: none;
}
/* 第一颗（h1）：显式写出颜色/字号/0 延迟 —— 此前 h1 在 WXSS 里**没有任何规则**
   （只有 h2~h5），靠基类兜底。空转的类名会让下一个人以为"h1 是特例"，实际它只是没写。 */
.ww-heart.h1 { left: -12rpx; color: var(--brass-200); font-size: var(--fs-22); animation-delay: 0s; }
.ww-heart.h2 { left: 8rpx; color: var(--brass-300); font-size: var(--fs-26); animation-delay: 0.18s; }
.ww-heart.h3 { left: -4rpx; color: var(--brass-400); font-size: var(--fs-20); animation-delay: 0.34s; }
.ww-heart.h4 { left: 14rpx; color: var(--brass-200); font-size: var(--fs-24); animation-delay: 0.5s; }
.ww-heart.h5 { left: 2rpx; color: var(--brass-300); font-size: var(--fs-28); animation-delay: 0.66s; }
@keyframes ww-heart-float {
  0%   { opacity: 0; transform: translate(-50%, 0) scale(0.7); }
  18%  { opacity: 0.95; }
  100% { opacity: 0; transform: translate(-50%, -120rpx) scale(1.12); }
}

/* ═══════════════════════════════════════════════════════════════════
 * 祈福动作区（2026-09-19 版式重构 · 第一批）
 * ① 点灯 + 安心木鱼 **并列**：row 包裹两个卡片，各自 flex:1（不改点灯卡自身规则）
 * ② 弹幕墙**视觉强化**：只加描边/内光/标题字重 —— 不动轨道结构与高度
 *    （轨道刻度与 topPercent 由 test-wish-wall 钉住，动高度有风险 ✗）
 * ═══════════════════════════════════════════════════════════════════ */
.ww-ritual-row {
  /* 用 grid 而不是 flex：两张卡**严格等宽**（flex 会按内容分配，左卡文案长就比右卡宽）；
     `align-items: stretch` 让两张卡等高 —— 前提是卡片自身没有多余 margin（见 .ww-lantern）。 */
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  margin-top: 4rpx;
  gap: 18rpx;
}
.ww-ritual-row .ww-lantern { flex: 1; min-width: 0; }

.ww-ritual-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
  padding: 22rpx 20rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.48);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(120% 80% at 18% 0%, rgba(200, 154, 99, 0.2) 0%, transparent 55%),
    linear-gradient(165deg, #2A241C 0%, #18150F 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.06),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.12),
    0 14rpx 28rpx rgba(0, 0, 0, 0.3);
}
.ww-muyu-press { opacity: 0.86; }

/* 木鱼：纯 CSS 造型（暖木色圆身 + 深色鱼口），不引素材 */
.ww-muyu {
  position: relative;
  flex-shrink: 0;
  width: 64rpx;
  height: 56rpx;
  border-radius: 50% 50% 46% 46%;
  background: radial-gradient(120% 120% at 32% 26%, #C89A63 0%, #A97B45 58%, #7E5A31 100%);
  box-shadow: inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.28), 0 4rpx 10rpx rgba(0, 0, 0, 0.22);
  transition: transform var(--dur-fast) var(--ease-out-soft);
}
.ww-muyu.is-beat { transform: scale(0.9); }
.ww-muyu-slit {
  position: absolute;
  left: 12%;
  right: 12%;
  top: 46%;
  height: 6rpx;
  border-radius: var(--radius-sm);
  background: rgba(38, 26, 14, 0.72);
}
.ww-muyu-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
  /* 2026-09-24 真机：灯已点时左卡文案很满，右卡等高后底部空洞一眼可见。
     拷贝列拉满卡高，把「功德」沉底，填空洞但不改「两卡内边距一致 / 卡本身垂直居中」守卫。 */
  align-self: stretch;
  justify-content: flex-start;
}
.ww-muyu-title {
  font-size: var(--fs-30);
  font-weight: 600;
  color: #F2EDE3;
  letter-spacing: 1rpx;
}
.ww-muyu-line { font-size: var(--fs-20); color: rgba(224, 207, 163, 0.78); line-height: 1.45; }
.ww-muyu-count {
  margin-top: auto;
  padding-top: 10rpx;
  font-size: var(--fs-22);
  color: var(--brass-200);
}
.ww-muyu-plus {
  position: absolute;
  right: 20rpx;
  top: 14rpx;
  font-size: var(--fs-22);
  color: #D9BE86;
  animation: ww-muyu-plus 0.42s ease-out forwards;
}
@keyframes ww-muyu-plus {
  0% { opacity: 0; transform: translateY(6rpx); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-22rpx); }
}

/* ═══════════════════════════════════════════════════════════════════
 * 创新钩子 H2「功德证」次级入口（开关 showMuyuCertificate）
 *
 * 只在里程点出现的一整行，放在木鱼动作区下方 —— 为什么不是塞进半宽的木鱼卡：
 *   · 卡宽 = 750 - 2×32(页面) - 2×20(卡内) ≈ 330rpx（还要减去 64rpx 的木鱼造型），
 *     中文标签 + 「领证 ›」在 20~22rpx 字号下已接近一行上限，塞进去必然折行；
 *   · 方案 §H2 要求"两个证书/记录入口不要与木鱼/点灯视觉并列"（仪式区不许变成功能区）。
 * ⚠️ 本仓把"字宽/折行"记为**静态检查盲区**（AGENTS.md），上面这段只是源码侧推算，
 *    真机效果**本轮未验**（交付说明如实标注，不声称"好看"）。
 * ═══════════════════════════════════════════════════════════════════ */
.ww-cert-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-top: var(--space-2);
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.34);
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.12) 0%, rgba(196, 167, 108, 0.04) 100%);
}
.ww-cert-entry-press { opacity: 0.86; }
.ww-cert-entry-tag { font-size: var(--fs-22); color: #D9BE86; letter-spacing: 1rpx; }
.ww-cert-entry-go { font-size: var(--fs-22); color: #EFE6D2; }

/* 说明行 + 音效开关（2026-09-20 改造）：说明文案已删（与墙页脚重复），
   音效开关上移到仪式区**区头**。这里只保留区头本身。 */
.ww-sec-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* v2：厅区头 —— 与玩法区拉开成两厅 */
  margin: var(--space-4) 2rpx 12rpx;
}

/* v2：区头铜方钉（仪式 / 玩法共用） */
.ww-sec-mark {
  flex-shrink: 0;
  width: 10rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, var(--brass-200) 0%, var(--brass-500) 100%);
  box-shadow: none;
}

.ww-sec-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-28);
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.1em;
  color: var(--brass-100);
  /* v2：不再靠左边框，改用 .ww-sec-mark */
  padding-left: 0;
  border-left: 0;
}

/* 仪式音效开关：铜色描边小胶囊。开=实心铜字，关=压暗（一眼看出状态，不靠读文字） */
.ww-sound {
  flex-shrink: 0;
  padding: 6rpx var(--space-2);
  font-size: var(--fs-20);
  letter-spacing: 0.04em;
  border-radius: 999rpx;
}

.ww-sound.is-on {
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.12);
}

.ww-sound.is-off {
  color: var(--color-text-muted, #8A857C);
  border: 1rpx solid rgba(138, 133, 124, 0.34);
  background: transparent;
}

.ww-sound-press {
  /* A3：与仪式卡 / 玩法同族按压 0.86 */
  opacity: 0.86;
}

/* ==================== 玩法区（今日一签 / 签饼 / 星座 / MBTI） ====================
   与点灯/木鱼那两张卡**刻意不同族**：那两张是"动作卡"（有状态、有计数、会一直亮），
   这里是"抽一句"的入口瓦片（无状态、点开就地展开结果）。所以：
   - 瓦片矮、不带边框发光，只留纸面与字标；
   - 结果卡用与愿签同一套"纸面 + 铜边"语言，展开在瓦片下方。 */
/* 注册成功后的「下一步」提示条（PRD §9-4「两者合一」）：纸面语言与页面一致，两个出口并排。
   间距用 12/18/20rpx —— 刻意避开与 --space-* 同值的字面量（那是守卫的判据）。 */
.ww-joined {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 12rpx 0 0;
  padding: 18rpx 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-md);
}
.ww-joined-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-24);
  color: var(--color-text-primary);
}
.ww-joined-acts { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.ww-joined-act {
  padding: 12rpx 20rpx;
  font-size: var(--fs-24);
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: 999rpx;
}
.ww-joined-act.is-primary { color: var(--color-bg); background: var(--brass-300); border-color: var(--brass-300); }
.ww-joined-act-press { opacity: 0.86; }

.ww-plays {
  position: relative;
  z-index: 1;
  margin-top: var(--space-4);
  margin-bottom: var(--space-3);
  padding: 22rpx 20rpx 20rpx;
  /* v3：玩法厅 —— 与仪式厅 / 挂签台同族深厅盒 */
  background:
    radial-gradient(90% 48% at 50% 0%, rgba(212, 188, 133, 0.16), transparent 55%),
    linear-gradient(165deg, #1A1712 0%, #12100C 58%, #0E0C0A 100%);
  border: 2rpx solid rgba(196, 167, 108, 0.36);
  border-radius: var(--radius-xl);
  box-shadow:
    inset 0 0 0 1rpx rgba(250, 246, 237, 0.05),
    inset 0 1rpx 0 rgba(250, 246, 237, 0.08),
    0 16rpx 36rpx rgba(0, 0, 0, 0.3);
}

.ww-plays-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 0 0 18rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.28);
}

.ww-plays-head-copy {
  flex: 1;
  min-width: 0;
}

.ww-plays-title {
  display: block;
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: var(--fs-30);
  letter-spacing: 0.12em;
  color: var(--brass-50);
  font-weight: 700;
}

.ww-plays-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-18);
  color: rgba(224, 207, 163, 0.55);
  letter-spacing: 0.02em;
}

.ww-play-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

/* ── 玩法入口区（2026-09-21 口径变更 · PRD v1.4 §11.4「玩法各开一页」）──────────
   这里**只是入口**：进行态 / 结果 / 推荐 / 分享都在各自玩法页。
   入口**各有形态**（注册表 `form` → is-card / is-shell / is-ring / is-axis / is-leaf / is-coin，
   见 index.wxml 与 config/ritualPlays.js）—— 不再靠"前两枚更大"这一种表达，
   但前两枚仍加一道「先推」标记（祈运标签排序的结果要看得见，§11.1 R1）。
   各 form 一律占一列（2×2 起）：整行的排法会把第二个入口顶出首屏（离线实测 y1305 > 1191），
   与"一屏内至少可见 2 个入口"的既有判据冲突。 */
.ww-play {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
  /* 2026-09-27：六格固定同高 —— 标题/副标/状态各 1 行，禁止靠内容把格子撑参差 */
  height: 152rpx;
  min-height: 152rpx;
  padding: 18rpx 18rpx 18rpx 20rpx;
  /* v3：门券 —— 浅铜顶光 + 双线 */
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.06) 0%, transparent 42%),
    linear-gradient(160deg, #242018 0%, #14120E 100%);
  border: 2rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.1),
    0 10rpx 22rpx rgba(0, 0, 0, 0.26);
  overflow: hidden;
}

.ww-play.is-lead {
  background:
    linear-gradient(180deg, rgba(250, 246, 237, 0.1) 0%, transparent 40%),
    linear-gradient(155deg, #2E281E 0%, #18150F 100%);
  border-color: rgba(212, 188, 133, 0.62);
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.14),
    0 12rpx 26rpx rgba(0, 0, 0, 0.3);
}

.ww-play.is-lead::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, var(--brass-200) 0%, var(--brass-500) 100%);
}

.ww-play.is-minor {
  /* 与 lead 同 padding，避免次格矮一截破坏 2×3 节奏 */
  padding: 18rpx 18rpx 18rpx 20rpx;
}

.ww-play-press {
  opacity: 0.86;
}

/* ── 入口形态（纯 CSS 盒子：无图片、无图标资产、无 canvas）────────────── */
.ww-play-form {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 72rpx;
}

/* 形态一：签筒 */
.ww-play-tube {
  position: relative;
  width: 44rpx;
  height: 64rpx;
}

/* 筒口露出的签条：让它读成「签筒」而不是一块铜方块（玩法页 .rp-stick 的同族语言） */
.ww-play-tube-stick {
  position: absolute;
  left: 15rpx;
  top: -8rpx;
  width: 14rpx;
  height: 26rpx;
  border-radius: 7rpx 7rpx 2rpx 2rpx;
  background: linear-gradient(180deg, var(--brass-100) 0%, var(--brass-400) 100%);
}

.ww-play-tube-body {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 44rpx;
  height: 50rpx;
  background: linear-gradient(180deg, var(--brass-500) 0%, var(--brass-800) 100%);
  border-radius: 4rpx 4rpx 10rpx 10rpx;
}

.ww-play-tube-mouth {
  position: absolute;
  left: -2rpx;
  top: 8rpx;
  width: 48rpx;
  height: 12rpx;
  background: var(--brass-900);
  border-radius: 50%;
  /* 口沿加一道高光：44×64rpx 这个尺寸下，纯深色椭圆容易被筒身吃掉 */
  box-shadow: inset 0 -2rpx 0 rgba(255, 255, 255, 0.18);
}

/* 形态二：签饼（两半合拢） */
.ww-play-shell {
  position: relative;
  width: 56rpx;
  height: 40rpx;
}

.ww-play-shell-half {
  position: absolute;
  top: 3rpx;
  width: 26rpx;
  height: 34rpx;
  background: linear-gradient(160deg, var(--brass-200) 0%, var(--brass-500) 100%);
}

.ww-play-shell-half.is-left {
  left: 0;
  border-radius: 16rpx 3rpx 3rpx 16rpx;
}

.ww-play-shell-half.is-right {
  right: 0;
  border-radius: 3rpx 16rpx 16rpx 3rpx;
}

/* 形态三：星盘（一圈 + 一枚指针点） */
.ww-play-ring {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 50%;
}

.ww-play-ring-dot {
  position: absolute;
  left: 18rpx;
  top: -5rpx;
  width: 8rpx;
  height: 8rpx;
  background: var(--brass-300);
  border-radius: 50%;
}

/* 形态四：双极轴 */
.ww-play-axis {
  position: relative;
  width: 60rpx;
  height: 34rpx;
}

.ww-play-axis-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 16rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.25) 0%, rgba(196, 167, 108, 0.75) 50%, rgba(196, 167, 108, 0.25) 100%);
}

.ww-play-axis-knob {
  position: absolute;
  left: 22rpx;
  top: 9rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--brass-300);
  border-radius: 50%;
}

/* 形态五：时令叶（节气签） */
.ww-play-leaf {
  position: relative;
  width: 40rpx;
  height: 54rpx;
  border-radius: 6% 70% 16% 70%;
  background: linear-gradient(155deg, #C8B478 0%, #8A9A52 48%, #5A6E38 100%);
  transform: rotate(-18deg);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.28);
}

.ww-play-leaf-vein {
  position: absolute;
  left: 18rpx;
  top: 8rpx;
  width: 2rpx;
  height: 36rpx;
  background: rgba(42, 36, 24, 0.35);
  border-radius: 1rpx;
}

/* 形态六：方孔铜钱 */
.ww-play-coin {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #F0E2B8 0%, var(--brass-400) 55%, #8A7038 100%);
  box-shadow: inset 0 0 0 3rpx rgba(122, 92, 44, 0.28);
}

.ww-play-coin-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  background: #14120E;
  box-shadow: 0 0 0 1rpx rgba(122, 92, 44, 0.4);
}

.ww-play-copy {
  flex: 1;
  min-width: 0;
}

.ww-play-title-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  /* 标题行固定单行高，与字标对齐；折行由 .ww-play-name nowrap 兜住 */
  height: 30rpx;
  min-width: 0;
}

.ww-play-mark {
  flex-shrink: 0;
  /* 2026-09-24：34 → 30rpx —— 与「先推」徽章同排时不再抢标题行宽度 */
  width: 30rpx;
  height: 30rpx;
  font-size: var(--fs-16);
  line-height: 30rpx;
  text-align: center;
  color: var(--color-bg);
  background: linear-gradient(145deg, var(--brass-200) 0%, var(--brass-400) 52%, var(--brass-600) 100%);
  border-radius: 50%;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.5);
}

.ww-play-name {
  flex: 1;
  min-width: 0;
  display: block;
  font-size: var(--fs-26);
  font-weight: 600;
  line-height: 30rpx;
  height: 30rpx;
  letter-spacing: 0.04em;
  color: #F2EDE3;
  /* 2026-09-27：标题硬性单行 —— 「今日一签」+「先推」曾挤成两行把格子撑到 176 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ww-play-lead-tag {
  /* 格角铜章：脱离标题 flex，不再挤占正文宽度（2026-09-27） */
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 1;
  padding: 2rpx 10rpx 3rpx;
  font-size: var(--fs-16);
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #2A220E;
  /* v2：先推＝迷你铜章，不是灰字标签 */
  background: linear-gradient(150deg, #F0E2B8 0%, var(--brass-400) 55%, var(--brass-600) 100%);
  border: 1rpx solid rgba(107, 90, 36, 0.45);
  border-radius: 999rpx;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.45);
}

.ww-play-hint {
  display: block;
  margin-top: 6rpx;
  height: 26rpx;
  font-size: var(--fs-18);
  line-height: 26rpx;
  /* 2026-09-26：副文案略亮，入口理由一眼可读 */
  color: rgba(224, 207, 163, 0.76);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 「今天玩过没有」：这是把用户再引进玩法页的理由（状态来自本地留档，见 index.js refreshPlayStates）
   2026-09-24 真机：已玩过状态句偏灰偏小 → 提亮；本轮再钉「未玩」也够可读
   2026-09-27：与副标同档单行高；已玩/未玩字号统一，避免已玩句更宽更容易折行 */
.ww-play-state {
  display: block;
  margin-top: 4rpx;
  height: 26rpx;
  font-size: var(--fs-18);
  line-height: 26rpx;
  color: rgba(224, 207, 163, 0.62);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ww-play-state.is-done {
  color: var(--brass-200);
  letter-spacing: 0.02em;
}

/* ── 纸签弹层（2026-09-18 细节雕刻）──────────────────────────────────
   身份明确：遮罩 + 从底部升起的纸签 + 铜色把手 + 印章字标。
   纸面语言与牌匾/愿签同源（浅纸 + 铜边 + 内高光 + 四角铭牌），所以"亮色块"不再是突兀，
   而是**同一套纸张语言里递上来的一张签**。 */
.ww-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  /* 暖黑而不是纯黑：与博物黑同色系，压暗但不发蓝。
     ⚠️ 浓度 62% 在浅色页面上够，但本页是博物黑 —— 实测"根本看不出被压暗"，
     于是弹层没有"盖住页面"的重量感。调到 78%（仍看得见轮廓，但页面明显退后）。 */
  background: rgba(10, 9, 7, 0.78);
  animation: ww-sheet-mask-in 200ms ease-out 1 forwards;
}

@keyframes ww-sheet-mask-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.ww-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  max-height: 84vh;
  overflow-y: auto;
  padding: 0 30rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #F8F4EB 0%, #F1EADD 60%, #EBE3D4 100%);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  animation: ww-sheet-up 300ms cubic-bezier(0.22, 0.9, 0.24, 1) 1 forwards;
  transition: transform var(--dur-fast) var(--ease-out-soft);
}

/* 四角铭牌：与 AppModal / 注册弹窗同一套"牌"的语言 */
.ww-sheet::before,
.ww-sheet::after {
  content: '';
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid rgba(138, 117, 48, 0.42);
}
.ww-sheet::before { left: 16rpx; top: 16rpx; border-right: 0; border-bottom: 0; border-radius: 6rpx 0 0 0; }
.ww-sheet::after { right: 16rpx; top: 16rpx; border-left: 0; border-bottom: 0; border-radius: 0 6rpx 0 0; }

@keyframes ww-sheet-up {
  0% { transform: translateY(102%); }
  100% { transform: translateY(0); }
}

.ww-sheet-grip {
  padding: 18rpx 0 10rpx;
  display: flex;
  justify-content: center;
}

.ww-sheet-grip-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(138, 117, 48, 0.32);
}

.ww-sheet-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(138, 117, 48, 0.22);
}

/* 印章式字标：与玩法瓦片上的铜圈同形，签与"抽签那一按"在视觉上连起来 */
.ww-sheet-mark {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-28);
  color: var(--brass-700);
  border: 2rpx solid rgba(138, 117, 48, 0.5);
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.18);
}

.ww-sheet-head-copy { flex: 1; min-width: 0; }

.ww-sheet-overline {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.14em;
  color: var(--brass-600);
}

.ww-sheet-name {
  display: block;
  margin-top: 2rpx;
  font-size: var(--fs-26);
  letter-spacing: 0.04em;
  color: #4A4234;
}

/* 「收起」触控区：**44pt ≈ 88rpx** 是可用性下限，而原来只有 ~38rpx 高（padding 8 + 行高 ~22），
   真机上很容易点不中（产品负责人真机截图里它就是个很小的纯文字）。
   做法：用 padding 把触控区撑到 88rpx，再用**负 margin 抵消**它对行高的影响 —— 视觉一字未动。 */
.ww-sheet-close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -30rpx 0;
  padding: 0 0 0 20rpx;
  font-size: var(--fs-22);
  color: var(--brass-600);
}

.ww-sheet-close-press { opacity: 0.6; }

.ww-sheet-body { padding: 22rpx 2rpx 0; }

/* 签文：本页最大的一行字，用书法体 + 加宽字距，标题就是"签"本身 */
.ww-sheet-title {
  display: block;
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, serif;
  font-size: var(--fs-44);
  line-height: 1.25;
  /* ⚠️ 2026-09-21 复核：真机上「放下一 点」那种空隙**不是字距问题** ——
     0.04em @44rpx ≈ 1.76rpx（0.15mm），肉眼看不见；内容源也是 `keyword: '放下一点'`（无空格）。
     它来自**手写体「一」自己的字身**（短横 + 左右大留白）。已撤回改成 0 的那次改动：
     没有真机证据就不动字距（与夜班「字阶契约收口」同一条纪律）。 */
  letter-spacing: 0.04em;
  color: var(--brass-700);
}

.ww-sheet-sub {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--fs-22);
  color: var(--brass-600);
}

.ww-sheet-line {
  display: block;
  margin-top: 14rpx;
  /* 字号口径：文本带；25rpx 不在字阶 14 档内（--fs-24 与 --fs-26 各差 1rpx = 无唯一就近，改值会改观感）→ 不动值（见文件头） */
  font-size: 25rpx;
  line-height: 1.72;
  color: #4A4234;
  opacity: 0;
  animation: ww-sheet-line-in 260ms ease-out 1 forwards;
}

@keyframes ww-sheet-line-in {
  0% { opacity: 0; transform: translateY(10rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* 玩法结果的动作行 / 推荐行（`.ww-sheet-cta*` / `.ww-sheet-product*`）已随玩法弹层
   整体搬到玩法页（2026-09-21 · PRD v1.4 §11.4）：那边叫 `.rp-acts` / `.rp-act` / `.rp-reco`
   （见 subpackages/feature/play-shared/ritual-play.wxss）。本页不再有这两族样式。 */

.ww-sheet-note {
  display: block;
  margin-top: 18rpx;
  /* 字号口径：文本带；19rpx 不在字阶 14 档内（18 与 20 的正中间）→ 不动值（见文件头） */
  font-size: 19rpx;
  text-align: center;
  color: #8A7E66;
}

/* 需要补资料的引导（`.ww-play-need*`）已随玩法结果一起搬到玩法页 ——
   那边叫 `.rp-need` / `.rp-need-text` / `.rp-need-cta`（见 play-shared/ritual-play.wxss）。
   本页入口区**不承载**这条分支：点入口是跳页，页面自己会处理缺资料。 */

/* 弹幕墙视觉强化（更实的描边 + 内光 + 外投影）已于 2026-09-19 **合并进上面唯一的 .ww-wall 块** ——
   原先它单独成块挂在文件末尾，同选择器后者静默覆盖前者，导致上面那份 border/box-shadow 是死声明。 */

/* ── 点灯 / 木鱼 图标替换（2026-09-19，产品负责人提供 SVG）──────────────────
   微信 <image> 不渲染 SVG ✗ → 走 **base64 data-URI + background-image**（矢量、几 KB、随包、无白名单）；
   图标原文件无 fill（默认黑，深色页看不见 ✗）→ 已注入品牌色（灯=铜金 #D9BE86、木鱼=暖木 #C89A63）。 */
.ww-lantern-core {
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  /* 图标替代原纯色灯泡：保留尺寸与居中，光晕仍由 .ww-lantern-halo 承担 */
}
.ww-muyu {
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-color: transparent;
  box-shadow: none;
  border-radius: 0;
}
.ww-muyu-slit { display: none; }   /* 图标自带鱼口，隐藏原 CSS 画的鱼口 */

/* ══ 2026-10-12 质感层（产品负责人点名「祈福墙详情页质感提升」）══════════════════════════
   追加在文件末，同特异性按顺序覆盖：上方各版（v2 / v3）规则与守卫钉住的值原样保留，
   本层只调「视觉重量」—— 不动布局几何、定位层级、弹幕舞台尺寸与任何交互。
   ① 四座厅盒（挂签台 / 仪式 / 玩法）：2rpx 金框 + 顶光 + 投影三重 → 发丝框 + 极淡顶光，厅与厅靠间距分；
   ② 门楣金币章（挂 / 仪 / 玩）：实心铜币 → 发丝方印（金字、透明底），不再满页金球；
   ③ 玩法格：去掉标题前的小铜币（左侧器物已是图示，二者重复）；「先推」改格内细金字签，不压边框；
   ④ 发送钮不可点态：整钮降透明（发灰发脏）→ 描边空心，可点时才是铜钮；
   ⑤ 额度 / 字数说明字 muted → secondary（深底上 muted 不达标）。 */
.ww-desk,
.ww-hall,
.ww-plays {
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  background:
    linear-gradient(180deg, rgba(212, 188, 133, 0.06) 0%, rgba(212, 188, 133, 0) 32%),
    linear-gradient(165deg, #191611 0%, #110F0C 100%);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.05);
}

.ww-desk-lintel,
.ww-hall-lintel,
.ww-plays-head {
  gap: 18rpx;
  padding-bottom: 18rpx;
  border-bottom-color: rgba(196, 167, 108, 0.16);
}

.ww-desk-seal,
.ww-hall-seal {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  box-shadow: none;
}

.ww-desk-seal-t,
.ww-hall-seal-t {
  font-size: var(--fs-26);
  font-weight: 600;
  color: var(--brass-300);
  letter-spacing: 0;
}

.ww-desk-title,
.ww-hall-title,
.ww-plays-title {
  font-weight: 600;
  letter-spacing: 0.14em;
}

.ww-play {
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  background: linear-gradient(160deg, #1F1B15 0%, #14120E 100%);
  box-shadow: none;
}

.ww-play.is-lead {
  border-color: rgba(212, 188, 133, 0.5);
  background:
    linear-gradient(180deg, rgba(212, 188, 133, 0.08) 0%, rgba(212, 188, 133, 0) 50%),
    linear-gradient(155deg, #262118 0%, #17140F 100%);
  box-shadow: none;
}

.ww-play-mark { display: none; }

.ww-play-lead-tag {
  top: 14rpx;
  right: 14rpx;
  padding: 0 var(--space-1);
  font-size: var(--fs-16);
  line-height: 28rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: var(--brass-300);
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: var(--radius-sm);
  box-shadow: none;
}

.ww-send.is-off {
  opacity: 1;
  color: rgba(212, 188, 133, 0.6);
  background: transparent;
  border-color: rgba(196, 167, 108, 0.36);
  box-shadow: none;
}

.ww-quota,
.ww-count {
  color: var(--color-text-secondary);
}

/* 质感层续：玩法厅门楣的印（原规则带 .ww-plays-head 前缀，特异性更高，须同前缀覆盖）；
   仪式两器龛：2rpx 金框 → 发丝框，点灯后的金光仍由 .is-lit 自身规则给（未覆盖） */
.ww-plays-head .ww-hall-seal {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  box-shadow: none;
}

.ww-lantern.is-idle,
.ww-ritual-card {
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  box-shadow: none;
}

/* 质感层续（全站 R2）：墙脚「看全部 ›」是次要动作 —— 铜铸实心钮 → 浅纸面上的深铜描边（实心铜只留挂签台主钮） */
.ww-wall-foot-more {
  font-weight: 600;
  color: var(--brass-700);
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid rgba(107, 90, 36, 0.5);
  box-shadow: none;
}
