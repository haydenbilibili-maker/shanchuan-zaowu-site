/* subpackages/feature/wish-wall/index.wxss
 * 需求 28：马上有 · 弹幕祈福墙
 *
 * 设计口径（Museum Mode）：
 *   牌匾（浅纸页头）→ 灯龛（暖光仪式）→ 纸墙（轨道弹幕）→ 写愿 → 愿签列表
 *   · 浅纸只给「牌匾」和「墙面」两块：它们是这页的主体，也让弹幕深字浅底可读；
 *   · 其余交互面维持深色卡，避免整页发白；
 *   · 所有类名 ww- 前缀 —— 本页曾用 .lamp 撞上 app.wxss 的全局信号灯基类，
 *     卡片被压成 12rpx 竖条（详见 index.wxml 顶部注释与 test:wish-wall 的撞车守卫）。
 */
page {
  /* 用设计 token：本页曾是全仓唯一写 #14120F 的页面，而 index.json 自己写的是 #1A1814 */
  background: var(--color-bg);
}

.ww-page {
  position: relative;
  min-height: 100vh;
  /* 底部预留：72rpx（原安全余量）+ 108rpx（吸底发送条的高度：84 输入 + 12×2 内边距）*/
  padding: 0 var(--space-4) calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部暖光：把视线压到牌匾上 */
.ww-grain {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: radial-gradient(120% 60% at 50% 0%, rgba(196, 167, 108, 0.12), transparent 62%);
}

/* ==================== 牌匾式纸质页头 ==================== */

.ww-hero {
  position: relative;
  z-index: 1;
  overflow: hidden;
  /* 2026-09-18：纵向节奏收紧一档（24/22 → 20/18，底距 32 → 24）——真机截图里页头下半是留白，
     省下来的高度给弹幕墙与玩法区（首屏能多露出一块内容）。 */
  margin: 16rpx 0 24rpx;
  padding: 20rpx 26rpx 18rpx;
  background: linear-gradient(165deg, var(--brass-50) 0%, #F2EDE4 48%, #EDE6DA 100%);
  border: 1px solid var(--brass-200);
  border-radius: var(--radius-md);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.85);
}

/* 纸纤维：浅底用 multiply 才像纸（深底请改用 soft-light） */
.ww-fiber {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.1;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.35' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}

/* 压印内框 */
.ww-emboss {
  position: absolute;
  inset: 10rpx;
  z-index: 0;
  pointer-events: none;
  border: 1px solid rgba(138, 117, 48, 0.24);
  border-radius: 10rpx;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.6);
}

/* 标本水印：右下角淡圈 + 内点，浅底上极弱 */
.ww-wm {
  position: absolute;
  right: -30rpx;
  bottom: -40rpx;
  z-index: 0;
  width: 200rpx;
  height: 200rpx;
  border: 16rpx solid rgba(107, 90, 36, 0.05);
  border-radius: 50%;
  pointer-events: none;
}

.ww-wm::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  margin: -28rpx 0 0 -28rpx;
  border: 6rpx solid rgba(107, 90, 36, 0.05);
  border-radius: 50%;
}

.ww-hero-body {
  position: relative;
  z-index: 2;
}

.ww-hero-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 34rpx;
  margin-bottom: 8rpx;
}

.ww-hero-top .signal-light {
  box-shadow: none;
  flex-shrink: 0;
  /* 浅纸上 var(--brass-400) 几乎看不见：加一圈深铜描边把灯"钉"出来 */
  border-color: rgba(107, 90, 36, 0.55);
}

.ww-hero-top .signal-light.lamp-brass {
  background: var(--brass-500);
}

.ww-over {
  min-width: 0;
  font-size: 18rpx;
  line-height: 1.3;
  letter-spacing: 0.14em;
  color: var(--brass-600);
}

.ww-seal {
  flex-shrink: 0;
  margin-left: auto;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 2px solid var(--brass-400);
  border-radius: 50%;
  background: linear-gradient(145deg, var(--brass-200) 0%, var(--brass-400) 48%, var(--brass-600) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.45);
}

.ww-seal-inner {
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: rgba(74, 66, 52, 0.55);
}

.ww-brand {
  display: block;
  margin-bottom: 2rpx;
  font-size: 20rpx;
  line-height: 1.3;
  letter-spacing: 0.16em;
  color: var(--brass-500);
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
}

.ww-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.06em;
  color: var(--brass-700);
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
}

/* 作用域（入口传进来的藏品名）：铜色小字，与主标题拉开层级，避免重复 */
/* 产品名 + 祈运标签同一行：左侧产品名、右侧祈运（把页头右侧的空白用起来） */
.ww-scope-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

/* 产品 chip 作为入口时：铜色加深 + 细描边，一眼看出"这个能点" */
.ww-scope.is-link {
  color: var(--brass-700);
  border-color: rgba(138, 117, 48, 0.5);
  background: rgba(196, 167, 108, 0.22);
}

.ww-scope-press {
  opacity: 0.72;
}

.ww-bless {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: var(--brass-700);
  background: rgba(196, 167, 108, 0.22);
  border: 1px solid rgba(138, 117, 48, 0.34);
  border-radius: 999rpx;
}

.ww-scope {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: var(--brass-600);
  background: rgba(196, 167, 108, 0.16);
  border: 1px solid rgba(138, 117, 48, 0.28);
  border-radius: 999rpx;
}

.ww-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7A6E58;
}

/* ==================== 未开放 ==================== */

.ww-closed {
  position: relative;
  z-index: 1;
  margin-top: 60rpx;
  padding: 56rpx 32rpx;
  text-align: center;
  border: 1rpx dashed rgba(196, 167, 108, 0.3);
  border-radius: var(--radius-lg);
}

.ww-closed-lamp {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.ww-closed-lamp .signal-light {
  width: 20rpx;
  height: 20rpx;
}

.ww-closed-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-text-body);
}

.ww-closed-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
}

/* ==================== 灯龛 ==================== */

.ww-lantern {
  position: relative;
  z-index: 1;
  display: flex;
  /* 顶对齐：图标与第一行文字齐，两张卡的内容线也就在同一水平线上 */
  align-items: flex-start;
  /* ⚠️ 允许折行只为灯语那一行（`.ww-lantern-tail { flex: 0 0 100% }`）：
     标题块（图标 + 标题 + 徽章）占第一行，灯语/灯位说明整行落到第二行。
     行间距就是这里的 gap —— 不再靠各段自己的 margin-top 堆，免得越调越挤。 */
  flex-wrap: wrap;
  gap: 16rpx;
  min-width: 0;
  /* ⚠️ 这里曾有 margin-bottom: var(--space-3)（竖排时代的遗留）：
     进了 flex/grid 行之后它会让左卡比右卡矮一截，两卡永远不等高。 */
  /* 纵向 22 → 26rpx：文案变整行之后卡片不高了，多出来的高度给上下留白。
     横向保持 20rpx（半宽卡里再收就把徽章行挤折行了）。木鱼卡必须同值（守卫钉住）。 */
  padding: 26rpx 20rpx;
  background: linear-gradient(180deg, #1F1D1A 0%, #1B1917 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.24);
  border-radius: var(--radius-lg);
}

.ww-lantern.is-lit {
  border-color: rgba(196, 167, 108, 0.5);
  background: linear-gradient(120deg, rgba(196, 167, 108, 0.12) 0%, #1B1917 62%);
}

.ww-lantern-press {
  opacity: 0.9;
}

/* 未点灯时内容只有三行，顶对齐会在底部留一截空白（真机截图里与右边的木鱼卡不对称）；
   点亮后是四行、本来就填满，所以只在 is-idle 时居中 —— 不改点亮态的对齐（那是真图确认过的）。 */
.ww-lantern.is-idle {
  align-items: center;
}

/* 灯座：固定 56rpx 方盒，光晕与灯芯都在盒内定位 —— 行内绝不放绝对定位元素，
   否则父级宽度一收缩，文案列就被挤成一字一行（历史事故） */
.ww-lantern-box {
  position: relative;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
}

.ww-lantern-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 108rpx;
  height: 108rpx;
  margin: -54rpx 0 0 -54rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(233, 190, 110, 0.5), rgba(233, 190, 110, 0) 70%);
  opacity: 0;
  transform: scale(0.7);
  transition: opacity 0.5s ease, transform 0.5s ease;
  pointer-events: none;
}

.ww-lantern.is-lit .ww-lantern-halo {
  opacity: 1;
  transform: scale(1.1);
  animation: ww-lantern-breath 3.6s ease-in-out infinite;
}

@keyframes ww-lantern-breath {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 0.92; transform: scale(1.16); }
}

.ww-lantern-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 46rpx;
  height: 46rpx;
  margin: -23rpx 0 0 -23rpx;
  /* 灯芯 = 附件里的「灯泡」SVG（2026-09-18 产品指定）。
     ⚠️ 图的声明**只有一处**：本文件末尾「点灯 / 木鱼 图标替换」段（连 encoding 也只在那里改）。
     同一个选择器出现两份 background-image 时，后一份会静默吃掉前一份 —— 改哪份都不生效、还看不出来。
     这里只负责**几何 + 两态**；图是单色单路径，所以「未点灯」不另做一张，直接把同一枚调暗。 */
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  opacity: 0.38;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.ww-lantern.is-lit .ww-lantern-core {
  /* 点亮 = 同一枚灯泡回到全亮 + 微微放大；光晕交给 .ww-lantern-halo
     （不用 box-shadow：方形盒子上的阴影会在灯泡背后露出一圈方角） */
  opacity: 1;
  transform: scale(1.06);
}

.ww-lantern-copy {
  flex: 1;
  min-width: 0;
}

/* 灯语 + 灯位说明：整行（不跟标题抢那 ~220rpx 的窄列）。
   整行可用宽 = 卡宽 - 左右 padding = 295rpx；灯语 21rpx × 13 字 = 273rpx，一行装得下。 */
.ww-lantern-tail {
  flex: 0 0 100%;
  min-width: 0;
}

.ww-lantern-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  letter-spacing: 1rpx;
  color: #F2EDE3;
}

.ww-lantern.is-lit .ww-lantern-title {
  color: #E9BE6E;
}

.ww-lantern-line {
  display: block;
  /* 整行的第一行，段间距交给 .ww-lantern 的 gap，不再叠 margin */
  margin-top: 0;
  font-size: 21rpx;
  /* 中文正文行距 1.45 偏挤（真图反馈）；1.6 是这套字号下的舒适值 */
  line-height: 1.6;
  color: var(--brass-400);
}

.ww-lantern-line.is-idle {
  color: var(--color-text-muted);
}

/* 连续天数：小铜牌，不占正文抬头 */
.ww-streak {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 半宽卡里它是"固定宽度"的一份子：原来 76rpx 会把文案列挤到只剩 5–6 个字（标题被压断）。
     压到 48rpx 后文案列多出 ~28rpx（约 1 个字），标题不再折行。 */
  min-width: 48rpx;
  padding: 6rpx 8rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.1);
}

.ww-streak-n {
  font-size: 26rpx;
  line-height: 1.1;
  color: var(--brass-300);
  font-family: var(--font-mono);
}

.ww-streak-l {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #8C857A;
}

/* ==================== 墙面（弹幕舞台） ==================== */

/* 浅纸墙：深字浅底，弹幕才读得清；四条轨道画成极淡的横向导线 */
.ww-wall {
  position: relative;
  z-index: 1;
  height: 380rpx;
  margin-bottom: var(--space-3);
  overflow: hidden;
  background: linear-gradient(180deg, #F6F1E7 0%, #EFE8DA 52%, #E7DFCF 100%);
  border: 1px solid var(--brass-200);
  border-radius: var(--radius-lg);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.9), inset 0 -24rpx 40rpx rgba(138, 117, 48, 0.08);
}

.ww-wall-fiber {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.09;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='2.1' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}

/* 轨道刻度：与 buildDanmakuRows 的 topPercent 对齐（6 轨 → 8/23.2/38.4/53.6/68.8/84）。
   只画左侧一小段 —— 整条横线会像表格线，且弹幕文字正好压在线上，越读越乱。
   ⚠️ 刻度挂在 .ww-wall-inner 里：它的高度不含底部页脚，与弹幕同一坐标系；
      挂到 .ww-wall 上会因页脚高度（44rpx）逐轨错开，第 4 条能差 18px。
   ⚠️ 条数必须等于 utils/wishWall 的 LANES（守卫对账）。 */
.ww-wall-rail {
  position: absolute;
  left: 18rpx;
  z-index: 1;
  width: 26rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: rgba(138, 117, 48, 0.34);
  pointer-events: none;
}

.ww-wall-rail.rail-1 { top: 8%; }
.ww-wall-rail.rail-2 { top: 23.2%; }
.ww-wall-rail.rail-3 { top: 38.4%; }
.ww-wall-rail.rail-4 { top: 53.6%; }
.ww-wall-rail.rail-5 { top: 68.8%; }
.ww-wall-rail.rail-6 { top: 84%; }

.ww-wall-inner {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 44rpx;
  z-index: 2;
}

/* 单条弹幕：从右向左匀速穿过。时长由 utils/wishWall.danmakuDurationMs 按字数换算；
   只播一轮（forwards）—— 循环播放会让同轨弹幕在第二轮重新叠在一起 */
.ww-danmaku {
  position: absolute;
  left: 100%;
  display: flex;
  align-items: center;
  gap: 10rpx;
  white-space: nowrap;
  /* 手写体：心愿是"写"上去的。字号比原来的无衬线大一号 —— 手写体笔画细，移动中要认得出。
     2026-09-18 真机截图：28 → 32rpx（380rpx 的浅纸墙上 4 轨小字显得空且小）。
     ⚠️ 改这个值必须同步 utils/wishWall 的 CHAR_RPX：同轨不重叠按它估算文案宽度，
     估小了后一条会在前一条尾部还在屏内时进场（守卫按"字号 ×1.03 ≈ CHAR_RPX"实算对账）。 */
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  font-size: 32rpx;
  line-height: 1.3;
  color: #4A4234;
  letter-spacing: 0.02em;
  animation-name: ww-danmaku-scroll;
  animation-timing-function: linear;
  animation-iteration-count: 1;
  animation-fill-mode: forwards;
  will-change: transform;
}

@keyframes ww-danmaku-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(calc(-100vw - 100%)); }
}

/* 墙面 → 心愿笺：弹幕不是装饰，点一条能展开那张纸（与愿签同一交互） */
.ww-danmaku-press {
  opacity: 0.55;
}

/* 墙上只留置顶的铜钉（「馆方」灰钉已随徽章一起下线） */
.ww-dm-mark {
  flex-shrink: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.ww-dm-mark.is-pinned {
  background: radial-gradient(circle at 36% 34%, var(--brass-200) 0%, var(--brass-500) 70%);
}

/* 刚落愿那一句在墙上先亮一下，随后随高亮一起褪回 */
.ww-dm-text.is-fresh {
  color: var(--brass-700);
  text-shadow: 0 0 10rpx rgba(233, 190, 110, 0.8);
}

.ww-wall-empty,
.ww-wall-loading {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #8A7E66;
}

.ww-wall-empty-mark {
  width: 44rpx;
  height: 4rpx;
  margin-bottom: 12rpx;
  border-radius: 2rpx;
  background: rgba(138, 117, 48, 0.4);
}

.ww-wall-empty-title {
  font-size: 28rpx;
  color: var(--brass-700);
}

.ww-wall-empty-desc {
  font-size: 22rpx;
}

.ww-wall-foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  height: 44rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 20rpx;
  background: rgba(231, 223, 207, 0.9);
  border-top: 1px solid rgba(138, 117, 48, 0.16);
}

.ww-wall-foot .signal-light {
  box-shadow: none;
}

.ww-wall-foot-text {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--brass-600);
}

/* 「看全部 ›」：贴着右边缘的弱提示（页脚整行可点，见 goWishList） */
.ww-wall-foot-more {
  margin-left: auto;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--brass-500);
}

.ww-wall-foot-press {
  background: rgba(233, 190, 110, 0.28);
}

/* ── 即时反馈回声（需求 28 · 玩法动作 → 墙的回应）──────────────────────
   位置：与页脚同一条 44rpx 带（z-index 在页脚之上覆盖它），因为这是墙内唯一不会被
   弹幕穿过的横向条带（第 4 轨在 84%，轨下只剩 ~17rpx）。
   时长的唯一事实源是 utils/ritualFeedback.ECHO_HOLD_MS（1800ms），
   页面那个计时器负责移除 DOM，这里只负责"进-停-出"的观感，两处必须同值。 */
.ww-echo {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  height: 44rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 20rpx;
  /* ⚠️ 必须**不透明**：2026-09-18 真机截图里，半透明的这条带让下面的页脚文字透上来，
     「我拆开了今天的签饼」与「26 条心愿正在墙上流动」叠成两行字（看着像渲染错乱）。
     带子整条盖住页脚是**故意的** —— 回声期间不需要同时读页脚。 */
  background: linear-gradient(90deg, #E6D6AE 0%, #EFE8DA 62%, #E7DFCF 100%);
  border-top: 1px solid rgba(138, 117, 48, 0.34);
  animation: ww-echo-life 1800ms ease-out forwards;
}

.ww-echo-text {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--brass-700);
}

.ww-echo-sub {
  font-size: 18rpx;
  color: var(--brass-600);
  opacity: 0.9;
}

/* 8% 处淡入（快，手感是即时的）、82% 起淡出（慢，不留残影到下一轮） */
@keyframes ww-echo-life {
  0% { opacity: 0; transform: translateY(8rpx); }
  8% { opacity: 1; transform: translateY(0); }
  82% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-4rpx); }
}

/* 墙本身也"吸一口气"：只有边框与内光闪一下，不动尺寸、不动轨道（改几何会牵动弹幕布局） */
.ww-wall.is-echo {
  animation: ww-echo-wall 900ms ease-out 1;
}

@keyframes ww-echo-wall {
  0% { box-shadow: inset 0 0 0 rgba(233, 190, 110, 0); }
  35% { box-shadow: inset 0 0 54rpx rgba(233, 190, 110, 0.34); }
  100% { box-shadow: inset 0 0 0 rgba(233, 190, 110, 0); }
}

/* ==================== 写愿签 ==================== */

.ww-write {
  position: relative;
  z-index: 1;
  padding: 24rpx 26rpx;
  margin-bottom: var(--space-3);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.ww-inspo {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.ww-inspo-label {
  flex-shrink: 0;
  margin-top: 8rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

.ww-inspo-row {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ww-inspo-chip {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--brass-300);
  background: rgba(196, 167, 108, 0.1);
  border: 1rpx solid rgba(196, 167, 108, 0.3);
  border-radius: 999rpx;
}

.ww-inspo-press {
  background: rgba(196, 167, 108, 0.2);
}

/* 发送条**吸底**（2026-09-18 产品确认）：主操作永远在拇指下，不必先滚一屏。
   ⚠️ 页面底部必须预留 ≥ 这条的高度（见 .ww-page 的 padding-bottom），否则最后一张愿签会被盖住。
   高度 = 输入框 84rpx + 上下内边距 12×2 + 安全区。 */
.ww-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* ⚠️ 必须是不透明背景：半透明时下面的愿签会透上来，与真机反馈的"互相遮挡"叠在一起更难读。
     （与 §28 回声条同一个坑：盖在别的东西上的条带，背景就得是实的。） */
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 32rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid rgba(196, 167, 108, 0.28);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.35);
}

.ww-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--color-text-body);
  background: #16140F;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: 999rpx;
}

.ww-input-ph {
  color: var(--color-text-muted);
}

.ww-send {
  flex-shrink: 0;
  height: 84rpx;
  padding: 0 32rpx;
  line-height: 84rpx;
  font-size: 26rpx;
  color: #1A1814;
  /* 与全站黄铜主按钮同一配方：160deg / 48% / 描边 + 顶部内高光 */
  background: linear-gradient(160deg, var(--brass-300) 0%, var(--brass-400) 48%, var(--brass-500) 100%);
  border: 1px solid rgba(224, 207, 163, 0.4);
  border-radius: 999rpx;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.35);
}

.ww-send-press {
  background: var(--brass-500);
  opacity: 0.92;
}

.ww-send.is-off {
  opacity: 0.42;
}

.ww-write-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
}

/* 今日额度：如实预告（上限与云函数 DAILY_LIMIT 同源），别让用户写完才被拒 */
.ww-quota {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.ww-quota.is-done {
  color: var(--color-warning);
}

.ww-count {
  font-size: 20rpx;
  color: var(--color-text-muted);
  font-family: var(--font-mono);
}

.ww-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(233, 162, 59, 0.32);
  border-radius: var(--radius-sm);
}

.ww-notice .signal-light {
  margin-top: 8rpx;
}

.ww-notice-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-warning);
}

/* ==================== 愿签列表 ==================== */

.ww-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: var(--space-4) 0 16rpx;
}

/* 分段控件：两个视图是"切换"，不是"两个标题" —— 容器给底、选中给铜底 */
.ww-seg {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.06);
}

.ww-seg-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.ww-seg-press {
  opacity: 0.75;
}

.ww-seg-label {
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
}

.ww-seg-n {
  font-size: 18rpx;
  font-family: var(--font-mono);
  color: var(--color-text-muted);
}

/* 两列瀑布：列内纵向堆叠，列间等宽；文案 2–30 字差异大，按行对齐会留空洞 */
.ww-tag-cols {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.ww-tag-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 愿签：左侧铜线是"签绳"，顶部左铜钉 + 右印章，正文手写体 */
.ww-tag {
  position: relative;
  /* 顶部 48rpx 是"顶带"：左铜钉 + 右印章落在这里，正文从顶带下方起排。
     实测：34rpx 时印章压行盒 5rpx；46rpx 仍差 0.5rpx（视口下看不见，
     但 Android 走衬线回退时行高不同会真的压上）—— 故留 2.8rpx 余量。 */
  padding: 48rpx 16rpx 16rpx 22rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #221F1A 0%, #1B1917 100%);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.ww-tag::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.7) 0%, rgba(196, 167, 108, 0.12) 100%);
}

.ww-tag-pin {
  position: absolute;
  left: 5rpx;
  top: 17rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 34%, var(--brass-200) 0%, var(--brass-500) 70%);
}

.ww-tag-text {
  display: block;
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--brass-100);
  word-break: break-all;
}

.ww-tag-foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  min-width: 0;
}

.ww-tag-avatar {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-bg-elevated);
  border: 1rpx solid rgba(196, 167, 108, 0.24);
}

.ww-tag-meta {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 印记（已收起 / 我的 / 置顶）：贴在签右上角（与正文错开，靠 padding-top 预留的顶带）。
   「馆方」印章已下线（2026-09-18 产品决定），它的 .is-official 样式一并删除 —— 不留死样式 */
.ww-tag-seal {
  position: absolute;
  right: 12rpx;
  top: 14rpx;
  padding: 2rpx 8rpx;
  font-size: 16rpx;
  line-height: 1.4;
  letter-spacing: 0.04em;
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: 6rpx;
  background: rgba(196, 167, 108, 0.08);
}

.ww-tags-empty {
  position: relative;
  z-index: 1;
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* 收尾条：让"到底了"看得出来（原来 30 条一路滚下去没有终点） */
.ww-end {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 8rpx;
}

.ww-end-rule {
  flex: 1;
  height: 1px;
  background: rgba(196, 167, 108, 0.16);
}

.ww-end-text {
  flex-shrink: 0;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
}

/* ==================== 加载骨架 / 错误重试（对齐全站约定） ====================
 * 全站约定：加载中出骨架（全局 keyframes `skeleton-shimmer`），不是一行文字；
 * 浅纸面用纸色微光，深卡用铜色微光（与 wallet 的 `.wallet-leather-skel` 同配方）。
 */

.ww-wall-skel {
  position: absolute;
  left: 18rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: linear-gradient(
    90deg,
    rgba(138, 117, 48, 0.06) 0%,
    rgba(138, 117, 48, 0.16) 46%,
    rgba(138, 117, 48, 0.06) 100%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

/* 四条骨架压在四轨位置上，读作"这里马上会有字" */
.ww-wall-skel.skel-1 { top: 8%; width: 46%; }
.ww-wall-skel.skel-2 { top: 33.3%; width: 62%; }
.ww-wall-skel.skel-3 { top: 58.7%; width: 38%; }
.ww-wall-skel.skel-4 { top: 84%; width: 54%; }

.ww-wall-foot.is-loading {
  background: rgba(231, 223, 207, 0.8);
}

.ww-wall-foot.is-loading .ww-wall-foot-text {
  color: var(--color-text-muted);
}

.wallet-skel {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.08) 0%,
    rgba(212, 188, 133, 0.2) 46%,
    rgba(196, 167, 108, 0.08) 100%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
  border-radius: 6rpx;
}

.ww-tag-skel {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 22rpx 20rpx 26rpx;
  margin-bottom: 14rpx;
  background: linear-gradient(180deg, #1F1D1A 0%, #1B1917 100%);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.ww-tag-skel-pin {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.25);
}

.ww-tag-skel-avatar {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.ww-tag-skel-main {
  flex: 1;
  min-width: 0;
}

.ww-tag-skel-line {
  height: 22rpx;
}

.ww-tag-skel-line.is-w1 { width: 52%; }
.ww-tag-skel-line.is-w2 { width: 32%; margin-top: 12rpx; height: 18rpx; }

/* 错误态：与全站 `list-error + 再试一次` 同构
   （礼券夹/礼赠/积分/首页/订单都有重试入口，本页原来只能靠下拉刷新碰运气） */
.ww-error {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid rgba(233, 162, 59, 0.28);
  border-radius: var(--radius-md);
}

.ww-error-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-warning);
}

.ww-error-retry {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: var(--brass-400);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-sm);
}

.ww-error-retry-press {
  background: rgba(196, 167, 108, 0.12);
  opacity: 0.9;
}

/* ==================== 灯位层级 / 节气（仪式升级） ==================== */

/* 徽章行：独立于标题，允许折行（半宽卡里挤不下时折行，而不是把标题压断） */
.ww-lantern-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  /* 徽章与标题之间要能"呼吸"：6rpx 在真机上等于贴着（文案拥挤的一半来源） */
  margin-top: 12rpx;
}

.ww-lantern-tier,
.ww-lantern-solar {
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  line-height: 1.5;
  border-radius: 6rpx;
}

/* 灯位称号：铜色实心 —— 它是"连着来"攒出来的，要比节气更实 */
.ww-lantern-tier {
  color: var(--color-bg);
  background: var(--brass-400);
}

/* 节气：描边，只在当天出现 */
.ww-lantern-solar {
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
}

/* 距下一个节气：与节气同日出现时被 wx:elif 挡掉，所以两者不会同屏 */
.ww-lantern-next {
  font-size: 18rpx;
  color: var(--color-text-muted);
}

.ww-lantern-note {
  display: block;
  /* 灯位说明是三级信息：与灯语拉开 8rpx，字号再降一档、颜色压到 muted */
  margin-top: 8rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
}

/* 连续点灯的小灯排：盏数由 lampTier 决定（1/3/5） */
.ww-lamps {
  display: flex;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.ww-lamp-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brass-300);
  box-shadow: 0 0 8rpx rgba(233, 190, 110, 0.7);
}

/* ==================== 视图切换（墙上 / 我的心愿） ==================== */

/* 选中态：铜底 + 深字，一眼看出"当前在哪一栏" */
.ww-seg-item.is-on {
  background: linear-gradient(160deg, var(--brass-300) 0%, var(--brass-400) 48%, var(--brass-500) 100%);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.35);
}

.ww-seg-item.is-on .ww-seg-label {
  color: #1A1814;
}

.ww-seg-item.is-on .ww-seg-n {
  color: rgba(26, 24, 20, 0.7);
}

/* ==================== 愿签印记（已收起 / 我的） ==================== */

/* 刚落愿的愿签：铜光呼吸一下，把"它落在墙上了"说清楚 */
.ww-tag.is-fresh {
  border-color: rgba(196, 167, 108, 0.85);
  box-shadow: 0 0 0 1rpx rgba(196, 167, 108, 0.35), 0 6rpx 24rpx rgba(233, 190, 110, 0.18);
  animation: ww-fresh-in 0.5s ease both;
}

@keyframes ww-fresh-in {
  from { opacity: 0; transform: translateY(-12rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.ww-tag-press {
  opacity: 0.86;
}

.ww-tag-seal.is-mine {
  color: var(--color-bg);
  background: var(--brass-400);
  border-color: var(--brass-400);
}

.ww-tag-seal.is-hidden {
  color: #E9A23B;
  border-color: rgba(233, 162, 59, 0.5);
  background: rgba(233, 162, 59, 0.1);
}

/* ==================== 博物笔记入口 ==================== */

.ww-relics {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-4);
  padding: 20rpx 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
}

.ww-relics-press {
  opacity: 0.9;
}

.ww-relics-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.ww-relics-chevron {
  color: var(--brass-400);
}

/* ==================== 心愿笺浮层 ==================== */

/* z-index 9980 < 彩蛋浮层 9990：彩蛋永远在最上层，不能被心愿笺压住 */
.ww-card-mask {
  position: fixed;
  inset: 0;
  z-index: 9980;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(10, 9, 8, 0.72);
}

/* 笺是浅纸：与牌匾/墙面同一套"纸"的语言 */
.ww-card {
  position: relative;
  width: 100%;
  padding: 44rpx 36rpx 32rpx;
  background: linear-gradient(168deg, #F5F0E6 0%, #EFE8DA 100%);
  border-radius: var(--radius-lg);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

/* 纸纤维：与牌匾（.ww-fiber）、纸墙（.ww-wall-fiber）同一纹理语言 */
.ww-card-fiber {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  border-radius: var(--radius-lg);
  opacity: 0.5;
  pointer-events: none;
  background-image:
    repeating-linear-gradient(94deg, rgba(120, 104, 70, 0.05) 0 1px, transparent 1px 4px),
    repeating-linear-gradient(4deg, rgba(120, 104, 70, 0.04) 0 1px, transparent 1px 6px);
}

/* 压印：四周内阴影，纸才有厚度 */
.ww-card-emboss {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  border-radius: var(--radius-lg);
  pointer-events: none;
  box-shadow: inset 0 0 0 1rpx rgba(120, 104, 70, 0.16), inset 0 18rpx 36rpx rgba(120, 104, 70, 0.08);
}

/* 材料层是绝对定位的，会盖在静态内容上 —— 内容必须显式抬层 */
.ww-card-over,
.ww-card-tags,
.ww-card-acts {
  position: relative;
  z-index: 1;
}

.ww-card-pin {
  position: absolute;
  left: 50%;
  top: -10rpx;
  width: 72rpx;
  height: 20rpx;
  margin-left: -36rpx;
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.55);
}

.ww-card-over {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.3em;
  color: #8C7A50;
}

.ww-card-text {
  display: block;
  margin-top: 18rpx;
  font-family: var(--font-brand);
  font-size: 42rpx;
  line-height: 1.5;
  color: #241F18;
  word-break: break-all;
}

.ww-card-meta {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 22rpx;
}

.ww-card-who {
  font-size: 22rpx;
  color: #5C5347;
}

.ww-card-time {
  font-size: 20rpx;
  color: #8C857A;
}

.ww-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.ww-card-tag {
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  color: #6E5B28;
  border: 1rpx solid rgba(110, 91, 40, 0.35);
  border-radius: 6rpx;
}

.ww-card-tag.is-warn {
  color: #A8541C;
  border-color: rgba(168, 84, 28, 0.4);
}

.ww-card-acts {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.ww-card-act {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 26rpx;
  color: #241F18;
  border: 1rpx solid rgba(110, 91, 40, 0.4);
  border-radius: 999rpx;
}

.ww-card-act-press {
  background: rgba(110, 91, 40, 0.08);
}

/* button 自带默认样式与 ::after 边框，必须显式重置，否则三个动作高度不齐 */
.ww-card-act.is-share {
  padding: 0;
  margin: 0;
  background: #6E5B28;
  color: #F7F3EA;
  border-color: #6E5B28;
  font-size: 26rpx;
  font-weight: 400;
}

.ww-card-act.is-share::after {
  border: none;
}

/* ── 弹幕 6 档配色（2026-09-18 重做：按**浅纸**墙面配色） ──────────────────
   ⚠️ 上一版取的是「中高明度、保证**深色墙面**上可读」的色 —— 可墙面后来改成了浅纸
   （`linear-gradient(#F6F1E7 → #E7DFCF)`），于是 6 档在纸上只有 **1.0–1.8:1**：
   最浅的「素笺」几乎隐形（实测截图里那几条"发虚"的弹幕就是它）。
   现在按浅纸重做：统一**深墨/矿物色**，对墙面的三个渐变停靠点最差 **5.23:1**（AA 需 4.5:1）。
   配色仍由 utils/wishWall.js 按 id 稳定分配（确定性，非随机）。
   守卫：test:wish-wall 里**真的算对比度**（读本文件的色值 × 墙面渐变），低于 4.5 即失败。 */
.ww-tone-0 { color: #4A4234; }   /* 素笺（墨） */
.ww-tone-1 { color: #6E5019; }   /* 铜金 */
.ww-tone-2 { color: #38602F; }   /* 苔绿 */
.ww-tone-3 { color: #2F5D78; }   /* 远海 */
.ww-tone-4 { color: #8A4640; }   /* 珊瑚 */
.ww-tone-5 { color: #5B4A78; }   /* 紫晶 */
.ww-emoji {
  margin-right: 6rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

/* ── 点灯爱心动效（2026-09-19）：一次性飘起、错落上行、渐隐 ──────────────
   只在 heartBurst 为真时挂载（js 2.6s 后收起）→ 不会常驻重播；
   暖色系 + 低透明度，克制，不抢弹幕注意力。 */
.ww-hearts {
  position: absolute;
  left: 50%;
  bottom: 56rpx;
  pointer-events: none;
}
.ww-heart {
  position: absolute;
  left: 0;
  bottom: 0;
  font-size: 26rpx;
  color: #E0A9A0;
  opacity: 0;
  animation: ww-heart-float 1.6s ease-out forwards;
}
.ww-heart.h2 { color: #D9BE86; font-size: 22rpx; animation-delay: 0.18s; }
.ww-heart.h3 { color: #E0A9A0; font-size: 30rpx; animation-delay: 0.34s; }
.ww-heart.h4 { color: #C7B4DE; font-size: 20rpx; animation-delay: 0.5s; }
.ww-heart.h5 { color: #D9BE86; font-size: 24rpx; animation-delay: 0.66s; }
@keyframes ww-heart-float {
  0%   { opacity: 0; transform: translate(-50%, 0) scale(0.7); }
  18%  { opacity: 0.95; }
  100% { opacity: 0; transform: translate(-50%, -120rpx) scale(1.12); }
}

/* ═══════════════════════════════════════════════════════════════════
 * 祈福动作区（2026-09-19 版式重构 · 第一批）
 * ① 点灯 + 安心木鱼 **并列**：row 包裹两个卡片，各自 flex:1（不改点灯卡自身规则）
 * ② 弹幕墙**视觉强化**：只加描边/内光/标题字重 —— 不动轨道结构与高度
 *    （轨道刻度与 topPercent 由 test-wish-wall 钉住，动高度有风险 ✗）
 * ═══════════════════════════════════════════════════════════════════ */
.ww-ritual-row {
  /* 用 grid 而不是 flex：两张卡**严格等宽**（flex 会按内容分配，左卡文案长就比右卡宽）；
     `align-items: stretch` 让两张卡等高 —— 前提是卡片自身没有多余 margin（见 .ww-lantern）。 */
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  gap: 16rpx;
}
.ww-ritual-row .ww-lantern { flex: 1; min-width: 0; }

.ww-ritual-card {
  position: relative;
  display: flex;
  /* ⚠️ 这里必须**垂直居中**，不能跟着灯卡改成 flex-start：
     木鱼卡只有两行，等高（grid stretch）之后顶部对齐会在底部留一大片空白 ——
     真机截图上一眼就能看出来。灯卡相反：它内容三行、本来就填满，所以顶对齐。
     两张卡各自的**内边距**保持一致，才是"像一对"的真正来源。 */
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  /* ⚠️ 必须与 .ww-lantern 同值（守卫 `两卡内边距一致` 钉住）：改一边就是"两张卡不像一对" */
  padding: 26rpx 20rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.34);
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.10) 0%, rgba(196, 167, 108, 0.03) 100%);
}
.ww-muyu-press { opacity: 0.86; }

/* 木鱼：纯 CSS 造型（暖木色圆身 + 深色鱼口），不引素材 */
.ww-muyu {
  position: relative;
  flex-shrink: 0;
  width: 64rpx;
  height: 56rpx;
  border-radius: 50% 50% 46% 46%;
  background: radial-gradient(120% 120% at 32% 26%, #C89A63 0%, #A97B45 58%, #7E5A31 100%);
  box-shadow: inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.28), 0 4rpx 10rpx rgba(0, 0, 0, 0.22);
  transition: transform 0.12s ease-out;
}
.ww-muyu.is-beat { transform: scale(0.9); }
.ww-muyu-slit {
  position: absolute;
  left: 12%;
  right: 12%;
  top: 46%;
  height: 6rpx;
  border-radius: 6rpx;
  background: rgba(38, 26, 14, 0.72);
}
.ww-muyu-copy { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.ww-muyu-title { font-size: 26rpx; color: #EFE6D2; letter-spacing: 1rpx; }
.ww-muyu-line { font-size: 20rpx; color: var(--color-text-muted, #8A857C); }
.ww-muyu-count { font-size: 20rpx; color: #D9BE86; }
.ww-muyu-plus {
  position: absolute;
  right: 20rpx;
  top: 14rpx;
  font-size: 22rpx;
  color: #D9BE86;
  animation: ww-muyu-plus 0.42s ease-out forwards;
}
@keyframes ww-muyu-plus {
  0% { opacity: 0; transform: translateY(6rpx); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-22rpx); }
}

/* 说明：一行说完，不占版面 */
.ww-foot-note {
  display: block;
  /* 与音效开关同行（见 .ww-foot-row）：说明占满剩余宽度，开关固定宽度贴右 */
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--color-text-muted, #8A857C);
}

.ww-foot-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 4rpx 4rpx;
}

/* 仪式音效开关：铜色描边小胶囊。开=实心铜字，关=压暗（一眼看出状态，不靠读文字） */
.ww-sound {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  border-radius: 999rpx;
}

.ww-sound.is-on {
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.12);
}

.ww-sound.is-off {
  color: var(--color-text-muted, #8A857C);
  border: 1rpx solid rgba(138, 133, 124, 0.34);
  background: transparent;
}

.ww-sound-press {
  opacity: 0.72;
}

/* ==================== 玩法区（今日一签 / 签饼 / 星座 / MBTI） ====================
   与点灯/木鱼那两张卡**刻意不同族**：那两张是"动作卡"（有状态、有计数、会一直亮），
   这里是"抽一句"的入口瓦片（无状态、点开就地展开结果）。所以：
   - 瓦片矮、不带边框发光，只留纸面与字标；
   - 结果卡用与愿签同一套"纸面 + 铜边"语言，展开在瓦片下方。 */
.ww-plays {
  position: relative;
  z-index: 1;
  margin-bottom: var(--space-3);
}

.ww-plays-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin: 4rpx 4rpx 14rpx;
}

.ww-plays-title {
  font-size: 26rpx;
  letter-spacing: 0.06em;
  color: var(--brass-300);
}

.ww-plays-sub {
  font-size: 20rpx;
  color: var(--color-text-muted, #8A857C);
}

.ww-play-grid {
  display: grid;
  /* 两列等宽：瓦片内容长度差异大（"MBTI 贴士" vs "拆签饼"），flex 会按内容分配 */
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.ww-play {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  padding: 20rpx 18rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.ww-play-press {
  opacity: 0.86;
}

/* 展开中的瓦片：铜边亮起来，和下方结果卡连成一组 */
.ww-play.is-open {
  border-color: rgba(196, 167, 108, 0.62);
  background: rgba(196, 167, 108, 0.1);
}

.ww-play-mark {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.08);
}

.ww-play-copy {
  flex: 1;
  min-width: 0;
}

.ww-play-name {
  display: block;
  font-size: 26rpx;
  line-height: 1.3;
  color: #EFE6D2;
}

.ww-play-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.4;
  color: var(--color-text-muted, #8A857C);
}

/* ── 纸签弹层（2026-09-18 细节雕刻）──────────────────────────────────
   身份明确：遮罩 + 从底部升起的纸签 + 铜色把手 + 印章字标。
   纸面语言与牌匾/愿签同源（浅纸 + 铜边 + 内高光 + 四角铭牌），所以"亮色块"不再是突兀，
   而是**同一套纸张语言里递上来的一张签**。 */
.ww-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  /* 暖黑而不是纯黑：与博物黑同色系，压暗但不发蓝。
     ⚠️ 浓度 62% 在浅色页面上够，但本页是博物黑 —— 实测"根本看不出被压暗"，
     于是弹层没有"盖住页面"的重量感。调到 78%（仍看得见轮廓，但页面明显退后）。 */
  background: rgba(10, 9, 7, 0.78);
  animation: ww-sheet-mask-in 200ms ease-out 1 forwards;
}

@keyframes ww-sheet-mask-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.ww-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  max-height: 84vh;
  overflow-y: auto;
  padding: 0 30rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #F8F4EB 0%, #F1EADD 60%, #EBE3D4 100%);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  animation: ww-sheet-up 300ms cubic-bezier(0.22, 0.9, 0.24, 1) 1 forwards;
  transition: transform 160ms ease-out;
}

/* 四角铭牌：与 AppModal / 注册弹窗同一套"牌"的语言 */
.ww-sheet::before,
.ww-sheet::after {
  content: '';
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid rgba(138, 117, 48, 0.42);
}
.ww-sheet::before { left: 16rpx; top: 16rpx; border-right: 0; border-bottom: 0; border-radius: 6rpx 0 0 0; }
.ww-sheet::after { right: 16rpx; top: 16rpx; border-left: 0; border-bottom: 0; border-radius: 0 6rpx 0 0; }

@keyframes ww-sheet-up {
  0% { transform: translateY(102%); }
  100% { transform: translateY(0); }
}

.ww-sheet-grip {
  padding: 18rpx 0 10rpx;
  display: flex;
  justify-content: center;
}

.ww-sheet-grip-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(138, 117, 48, 0.32);
}

.ww-sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(138, 117, 48, 0.22);
}

/* 印章式字标：与玩法瓦片上的铜圈同形，签与"抽签那一按"在视觉上连起来 */
.ww-sheet-mark {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--brass-700);
  border: 2rpx solid rgba(138, 117, 48, 0.5);
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.18);
}

.ww-sheet-head-copy { flex: 1; min-width: 0; }

.ww-sheet-overline {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--brass-600);
}

.ww-sheet-name {
  display: block;
  margin-top: 2rpx;
  font-size: 26rpx;
  letter-spacing: 0.04em;
  color: #4A4234;
}

.ww-sheet-close {
  flex-shrink: 0;
  padding: 8rpx 4rpx 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--brass-600);
}

.ww-sheet-close-press { opacity: 0.6; }

.ww-sheet-body { padding: 22rpx 2rpx 0; }

/* 签文：本页最大的一行字，用书法体 + 加宽字距，标题就是"签"本身 */
.ww-sheet-title {
  display: block;
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, serif;
  font-size: 44rpx;
  line-height: 1.25;
  letter-spacing: 0.04em;
  color: var(--brass-700);
}

.ww-sheet-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--brass-600);
}

.ww-sheet-line {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.72;
  color: #4A4234;
  opacity: 0;
  animation: ww-sheet-line-in 260ms ease-out 1 forwards;
}

@keyframes ww-sheet-line-in {
  0% { opacity: 0; transform: translateY(10rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.ww-sheet-cta-row { margin-top: 26rpx; }

.ww-sheet-cta {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  letter-spacing: 0.06em;
  color: #1A1814;
  background: linear-gradient(160deg, var(--brass-300) 0%, var(--brass-400) 48%, var(--brass-500) 100%);
  border-radius: 12rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.ww-sheet-cta-press { opacity: 0.9; }

/* 产品链路：一条主路。左侧说明"为什么是它"，右侧是唯一的出口动作 */
.ww-sheet-product {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(138, 117, 48, 0.3);
  border-radius: 12rpx;
}

.ww-sheet-product-press { opacity: 0.82; }

.ww-sheet-product-copy { flex: 1; min-width: 0; }

.ww-sheet-product-label {
  display: block;
  font-size: 19rpx;
  letter-spacing: 0.06em;
  color: var(--brass-600);
}

.ww-sheet-product-title {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #3A3428;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ww-sheet-product-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #7A6E58;
}

.ww-sheet-product-go {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-700);
}

.ww-sheet-note {
  display: block;
  margin-top: 18rpx;
  font-size: 19rpx;
  text-align: center;
  color: #8A7E66;
}

/* 需要补资料：说清"要哪个字段、填了有什么好处"，只给一条去填的路 */
.ww-play-need {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx dashed rgba(196, 167, 108, 0.44);
  border-radius: var(--radius-md);
}

.ww-play-need-text {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--color-text-muted, #8A857C);
}

.ww-play-need-press {
  opacity: 0.85;
}

.ww-play-need-cta {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  color: var(--brass-300);
  border: 1rpx solid rgba(196, 167, 108, 0.5);
  border-radius: var(--radius-sm);
}

/* 弹幕墙视觉强化：更实的描边 + 内光 + 标题层次（不动轨道与高度） */
.ww-wall {
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  box-shadow: inset 0 0 40rpx rgba(196, 167, 108, 0.10), 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

/* ── 点灯 / 木鱼 图标替换（2026-09-19，产品负责人提供 SVG）──────────────────
   微信 <image> 不渲染 SVG ✗ → 走 **base64 data-URI + background-image**（矢量、几 KB、随包、无白名单）；
   图标原文件无 fill（默认黑，深色页看不见 ✗）→ 已注入品牌色（灯=铜金 #D9BE86、木鱼=暖木 #C89A63）。 */
.ww-lantern-core {
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  /* 图标替代原纯色灯泡：保留尺寸与居中，光晕仍由 .ww-lantern-halo 承担 */
}
.ww-muyu {
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-color: transparent;
  box-shadow: none;
  border-radius: 0;
}
.ww-muyu-slit { display: none; }   /* 图标自带鱼口，隐藏原 CSS 画的鱼口 */
