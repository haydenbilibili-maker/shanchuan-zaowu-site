/* 博物君（2026-11-23）：深底馆面；博物君的话 = 浅纸标本签（与心愿签 / 信笺同一种纸），访客的话 = 铜描边 */
page { background: var(--color-bg, #1A1814); height: 100%; }

.mg-page { position: relative; height: 100vh; display: flex; flex-direction: column; }
.mg-scroll { flex: 1; min-height: 0; }

/* 卷首 */
.mg-head { padding: 40rpx 32rpx 8rpx; }
.mg-eyebrow { display: block; font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .2em; color: var(--brass-300, #D4BC8A); }
.mg-title { display: block; margin-top: 12rpx; font-family: var(--font-brand); font-size: var(--fs-44, 44rpx); letter-spacing: .12em; color: var(--brass-100, #F1E6CC); }
.mg-desc { display: block; margin-top: 10rpx; font-size: var(--fs-24); color: var(--color-text-secondary); }

/* 对话 */
.mg-list { padding: 24rpx 32rpx 0; }
.mg-row { display: flex; margin-top: 28rpx; }
.mg-row.is-user { justify-content: flex-end; }
.mg-row.is-guide { align-items: flex-start; gap: 16rpx; }
.mg-col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }

/* 方寸印：博物君的落款 */
.mg-seal {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-top: 6rpx;
  border-radius: var(--r-thumb-sm, 8rpx);
  background: var(--mat-seal);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  color: #F3E7D3;
}

.mg-seal-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.mg-bubble {
  display: block;
  max-width: 100%;
  padding: 22rpx 26rpx;
  font-size: var(--fs-28);
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
  box-sizing: border-box;
}
.mg-bubble.is-guide {
  border-radius: 4rpx var(--r-card, 16rpx) var(--r-card, 16rpx) var(--r-card, 16rpx);
  background: linear-gradient(180deg, var(--mat-paper-tone), #E9DFCA);
  color: var(--mat-ink);
  box-shadow: inset 0 0 0 1rpx rgba(176, 141, 87, 0.35);
}
.mg-bubble.is-guide.is-error { background: rgba(196, 167, 108, 0.08); color: var(--brass-200, #E3D2AC); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28); }
.mg-bubble.is-user {
  max-width: 80%;
  border-radius: var(--r-card, 16rpx) 4rpx var(--r-card, 16rpx) var(--r-card, 16rpx);
  background: rgba(196, 167, 108, 0.12);
  color: var(--brass-100, #F1E6CC);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.4);
}

/* 翻书中 */
.mg-bubble.is-pending { display: flex; align-items: center; gap: 14rpx; }
.mg-pending-t { font-size: var(--fs-24); color: var(--mat-ink-soft); }
.mg-dots { display: flex; gap: 8rpx; }
.mg-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--mat-brass-pin); animation: mg-dot 1.2s ease-in-out infinite; }
.mg-dot:nth-child(2) { animation-delay: .15s; }
.mg-dot:nth-child(3) { animation-delay: .3s; }
@keyframes mg-dot { 0%, 80%, 100% { opacity: .25; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-6rpx); } }
@media (prefers-reduced-motion: reduce) { .mg-dot { animation: none; opacity: .7; } }

/* 馆内去处：文字链一排 */

/* 追问 / 开场问题：描边小签 */
.mg-chip {
  max-width: 520rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 12rpx 22rpx;
  border-radius: var(--r-pill, 999rpx);
  font-size: var(--fs-24);
  color: var(--brass-200, #E3D2AC);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.4);
}
.mg-chip.is-block { display: block; margin-top: 14rpx; border-radius: var(--r-control, 16rpx); padding: 20rpx 24rpx; }

.mg-starters { padding: 28rpx 32rpx 0; }
.mg-starters-k { display: block; font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .16em; color: var(--brass-300, #D4BC8A); }

.mg-note { display: block; margin: 36rpx 32rpx 8rpx; font-size: var(--fs-18); line-height: 1.5; color: var(--color-text-secondary); opacity: .78; text-align: center; letter-spacing: .02em; }
.mg-end { height: 32rpx; }

/* 底部输入条 */
.mg-bar {
  flex-shrink: 0;
  /* 2026-11-25：真机底部输入条被 Home 指示条 / 圆角遮住 —— 用安全区把整条抬起来
     （.safe-area 只是个标记类，全仓没有定义，别指望它） */
  padding: 16rpx 32rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0px));
  background: var(--color-bg, #1A1814);
  border-top: 1rpx solid rgba(196, 167, 108, 0.18);
}
.mg-bar-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.mg-quota { font-size: var(--fs-20); color: var(--color-text-secondary); }
.mg-clear { padding: 6rpx 0 6rpx 16rpx; font-size: var(--fs-20); color: var(--brass-300, #D4BC8A); }
.mg-bar-row { display: flex; align-items: center; gap: 16rpx; }
.mg-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: var(--r-control, 16rpx);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3);
  font-size: var(--fs-28);
  color: var(--brass-100, #F1E6CC);
}
.mg-input-ph { color: var(--color-text-secondary); }
.mg-send {
  flex-shrink: 0;
  width: 96rpx;
  height: 80rpx;
  border-radius: var(--r-control, 16rpx);
  background: var(--brass-400, #C4A76C);
  color: #1A1814;
  font-family: var(--font-brand);
  font-size: var(--fs-30, 30rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mg-send.is-off { opacity: .45; }

/* 图鉴物种链接（2026-11-23）：回答下方一枚小标本签 */

/* 逐字显示中（2026-11-23）：末尾一枚铜色光标（嵌套 text：真机 text 组件上 ::after 不可靠） */
.mg-caret { margin-left: 2rpx; color: var(--mat-brass-pin); animation: mg-caret 0.8s steps(1) infinite; }
@keyframes mg-caret { 50% { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .mg-caret { animation: none; } }

/* 闭馆（2026-11-23）：一张描边说明签 */
.mg-closed { margin: 28rpx 32rpx 0 100rpx; padding: 24rpx 26rpx; border-radius: var(--r-card, 16rpx); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.32); }
.mg-closed-k { display: block; font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .16em; color: var(--brass-300, #D4BC8A); }
.mg-closed-t { display: block; margin-top: 10rpx; font-size: var(--fs-26); line-height: 1.6; color: var(--brass-200, #E3D2AC); }

/* 回答反馈 / 复制（2026-11-23）：气泡下一行小字，命中区上下补足 */

/* 对话之外的三件工具（2026-11-23）：卷首下一排三张小签 */
.mg-tools { display: flex; justify-content: space-between; margin-top: 24rpx; }
.mg-tool { width: 31.5%; padding: 18rpx 0; border-radius: var(--r-control, 16rpx); text-align: center; box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.32); background: rgba(196, 167, 108, 0.06); }
.mg-tool-k { display: block; font-family: var(--font-mono); font-size: var(--fs-16, 16rpx); letter-spacing: .18em; color: var(--brass-300, #D4BC8A); }
.mg-tool-t { display: block; margin-top: 4rpx; font-size: var(--fs-26); color: var(--brass-100, #F1E6CC); }

/* 标本工坊入口（2026-11-23）：工具排下一条横幅 */
.mg-workshop { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; padding: 22rpx 24rpx; border-radius: var(--r-card, 16rpx); background: linear-gradient(120deg, rgba(196, 167, 108, 0.16), rgba(196, 167, 108, 0.04)); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.36); }
.mg-workshop-main { flex: 1; min-width: 0; }
.mg-workshop-t { display: block; margin-top: 4rpx; font-family: var(--font-brand); font-size: var(--fs-28); color: var(--brass-100, #F1E6CC); }
.mg-workshop-d { display: block; margin-top: 4rpx; font-size: var(--fs-22); color: var(--color-text-secondary); }
.mg-workshop-go { flex-shrink: 0; font-size: var(--fs-30, 30rpx); color: var(--brass-300, #D4BC8A); }

/* 回答区重排（2026-11-23）：签脚贴在回答纸签底边 + 两条一行横滑（延伸 / 接着问） */
.mg-bubble.is-guide.has-foot { align-self: stretch; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.mg-fb {
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 26rpx 12rpx;
  border-radius: 0 0 var(--r-card, 16rpx) var(--r-card, 16rpx);
  background: #E6DBC4;
  box-shadow: inset 0 0 0 1rpx rgba(176, 141, 87, 0.35);
}
.mg-fb-l, .mg-fb-r { display: flex; align-items: center; gap: 12rpx; }
.mg-fb-btn { padding: 10rpx 4rpx; font-size: var(--fs-22); color: var(--mat-ink-label); }
.mg-fb-btn.is-saved { color: var(--mat-seal); }
.mg-fb-sep { font-size: var(--fs-20); color: rgba(138, 111, 69, 0.5); }
.mg-fb-done { padding: 10rpx 0; font-size: var(--fs-22); color: var(--mat-ink-soft); }

.mg-strip-box { align-self: stretch; display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; }
.mg-strip-k { flex-shrink: 0; width: 76rpx; font-size: var(--fs-20); letter-spacing: .08em; color: var(--brass-300, #D4BC8A); }
.mg-strip { flex: 1; min-width: 0; white-space: nowrap; }
.mg-strip-row { display: inline-flex; align-items: center; gap: 12rpx; padding-right: 32rpx; }
.mg-sp { flex-shrink: 0; display: flex; align-items: center; gap: 10rpx; padding: 12rpx 20rpx; border-radius: var(--r-pill, 999rpx); background: rgba(196, 167, 108, 0.1); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.32); }
.mg-sp-no { font-family: var(--font-mono); font-size: var(--fs-18); color: var(--brass-300, #D4BC8A); }
.mg-sp-zh { font-size: var(--fs-24); color: var(--brass-100, #F1E6CC); }
.mg-act { flex-shrink: 0; padding: 12rpx 20rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-24); color: var(--brass-200, #E3D2AC); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22); }
.mg-strip .mg-chip { flex-shrink: 0; }

/* 横滑提示：行尾一抹渐隐，看得出后面还有（不挡点击） */
.mg-strip-box { position: relative; }
.mg-strip-box::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 48rpx; background: linear-gradient(90deg, rgba(26, 24, 20, 0), var(--color-bg, #1A1814)); pointer-events: none; }

/* 开场问题卡（2026-11-23）：两列，科普通栏 */
.mg-st-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 14rpx; }
.mg-st { width: 48.5%; margin-bottom: 16rpx; padding: 20rpx 22rpx; box-sizing: border-box; border-radius: var(--r-card, 16rpx); background: rgba(196, 167, 108, 0.06); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3); }
.mg-st.is-wide { width: 100%; background: rgba(196, 167, 108, 0.12); }
.mg-st-k { display: block; font-size: var(--fs-20); letter-spacing: .12em; color: var(--brass-300, #D4BC8A); }
.mg-st-q { display: block; margin-top: 8rpx; font-size: var(--fs-26); line-height: 1.5; color: var(--brass-100, #F1E6CC); }
.mg-st.is-wide .mg-st-q { font-family: var(--font-brand); font-size: var(--fs-28); }

/* 回到最新（2026-11-23）：输入条上方居中一枚小胶囊 */
.mg-jump { position: absolute; left: 50%; bottom: 220rpx; z-index: 5; transform: translateX(-50%); padding: 14rpx 28rpx; border-radius: var(--r-pill, 999rpx); background: rgba(36, 33, 29, 0.96); box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.45), inset 0 0 0 1rpx rgba(196, 167, 108, 0.45); font-size: var(--fs-22); color: var(--brass-200, #E3D2AC); }


/* —— 回答分段与学名（2026-11-23）：段间留白；拉丁学名斜体深铜，像标本签上的学名行 —— */
.mg-bubble.is-rich { white-space: normal; }
.mg-para { display: block; white-space: pre-wrap; }
.mg-para + .mg-para { margin-top: 18rpx; }
.mg-latin { font-family: var(--font-latin, Georgia, serif); font-style: italic; color: #7A5A2B; letter-spacing: 0.01em; }

/* —— 馆里有这件（2026-11-23）：回答点到的图鉴物种在馆里有藏品 —— 横滑小卡，点进详情走原购买动线 —— */
.mg-goods { align-self: stretch; margin-top: 20rpx; position: relative; }
/* 行尾渐隐：卡片滑到边上不是被硬切 */
.mg-goods::after { content: ''; position: absolute; right: 0; top: 34rpx; bottom: 0; width: 48rpx; background: linear-gradient(90deg, rgba(26, 24, 20, 0), var(--color-bg, #1A1814)); pointer-events: none; }
.mg-goods-k { display: block; margin-bottom: 10rpx; font-size: var(--fs-20); letter-spacing: .08em; color: var(--brass-300, #D4BC8A); }
.mg-good {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 320rpx;
  padding: 10rpx 16rpx 10rpx 10rpx;
  box-sizing: border-box;
  border-radius: var(--r-card, 16rpx);
  background: rgba(196, 167, 108, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
}
.mg-good-img { flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 10rpx; }
.mg-good-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.mg-good-t { font-size: var(--fs-24); color: var(--brass-100, #F1E6CC); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mg-good-p { font-family: var(--font-mono); font-size: var(--fs-22); color: var(--brass-400, #C4A76C); }

/* AI 生成标注（2026-11-26 审核驳回：逐条回答也要显著说明） */
.mg-ai-tag {
  align-self: flex-start;
  margin: 0 0 4rpx 4rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--r-thumb-sm, 4rpx);
  font-size: var(--fs-18);
  line-height: 1.5;
  color: var(--mat-ink);
  background: var(--mat-brass);
}
