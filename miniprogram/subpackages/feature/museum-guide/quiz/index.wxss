@import '../naturalist.wxss';
/* 进度：五枚细条，答过的实心、当前描亮 */
.qz-pips { display: flex; gap: 10rpx; margin-top: 32rpx; }
.qz-pip { flex: 1; height: 6rpx; border-radius: var(--r-pill, 999rpx); background: rgba(196, 167, 108, 0.18); }
.qz-pip.is-past { background: var(--brass-400, #C4A76C); }
.qz-pip.is-on { background: var(--brass-200, #E3D2AC); }
.qz-card { margin-top: 20rpx; }
.qz-prompt { display: block; margin-top: 24rpx; font-family: var(--font-brand); font-size: var(--fs-32, 32rpx); line-height: 1.6; color: #2E2618; }
.qz-opts { margin-top: 24rpx; }
.qz-opt { display: flex; align-items: center; gap: 18rpx; margin-top: 14rpx; padding: 22rpx 22rpx; border-radius: var(--r-control, 16rpx); background: rgba(255, 252, 245, 0.55); box-shadow: inset 0 0 0 1rpx rgba(138, 111, 69, 0.3); }
.qz-opt-k { width: 40rpx; height: 40rpx; flex-shrink: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: var(--fs-20); color: #8A6F45; box-shadow: inset 0 0 0 1rpx rgba(138, 111, 69, 0.45); }
.qz-opt-t { flex: 1; min-width: 0; font-size: var(--fs-26); color: #2E2618; }
.qz-opt-mark { flex-shrink: 0; font-size: var(--fs-28); }
.qz-opt.is-locked { opacity: 0.7; }
.qz-opt.is-right { opacity: 1; background: rgba(95, 128, 90, 0.16); box-shadow: inset 0 0 0 2rpx rgba(78, 112, 74, 0.6); }
.qz-opt.is-right .qz-opt-mark { color: #4E704A; }
.qz-opt.is-wrong { opacity: 1; background: rgba(142, 59, 46, 0.1); box-shadow: inset 0 0 0 2rpx rgba(142, 59, 46, 0.5); }
.qz-opt.is-wrong .qz-opt-mark { color: #8E3B2E; }
.qz-explain { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(138, 111, 69, 0.3); }

/* 结果 */
.qz-score { display: flex; align-items: baseline; justify-content: center; gap: 10rpx; margin-top: 24rpx; }
.qz-score-n { font-family: var(--font-latin); font-size: 120rpx; line-height: 1; color: #2E2618; }
.qz-score-t { font-family: var(--font-mono); font-size: var(--fs-30, 30rpx); color: #8A6F45; }
.qz-line { display: block; margin-top: 16rpx; text-align: center; font-size: var(--fs-26); color: #3A2F1E; }
.qz-stats { display: flex; }
.qz-stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.qz-stat-n { font-family: var(--font-mono); font-size: 44rpx; color: #2E2618; }
.qz-rv { padding: 24rpx 0; border-bottom: 1rpx solid rgba(196, 167, 108, 0.12); }
.qz-rv-p { display: block; font-size: var(--fs-26); line-height: 1.6; color: var(--brass-100, #F1E6CC); }
.qz-rv-a { display: block; margin-top: 8rpx; font-size: var(--fs-24); }
.qz-rv-a.is-ok { color: #9DBB94; }
.qz-rv-a.is-no { color: #E0A99C; }
.qz-rv-e { display: block; margin-top: 8rpx; font-size: var(--fs-22); line-height: 1.6; color: var(--color-text-secondary); }
.qz-rv-ask { display: inline-block; margin-top: 8rpx; padding: 6rpx 0; font-size: var(--fs-22); color: var(--brass-200, #E3D2AC); }
