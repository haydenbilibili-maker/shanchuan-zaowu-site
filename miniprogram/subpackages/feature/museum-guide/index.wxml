<!-- 博物君 · 山海造物标本馆的 AI 馆员（2026-11-23）。蓝图 docs/博物君_AI馆员_蓝图_2026-11-23.md
     结构：卷首 → 对话（博物君 = 纸面签，访客 = 铜描边）→ 开场问题 / 追问 / 馆内去处 → 底部输入条 -->
<view class="mg-page">
  <scroll-view class="mg-scroll" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view class="mg-head">
      <text class="mg-eyebrow">MUSEUM GUIDE · 博物君</text>
      <text class="mg-title">博物君</text>
      <text class="mg-desc">山海造物标本馆的馆员。懂这座馆，也懂一点自然史。</text>
      <!-- 对话之外（2026-11-23）：今日一物 / 博物小测 / 博物笔记 —— 全部读本地图鉴，不占提问次数 -->
      <view class="mg-tools">
        <view class="mg-tool" data-url="/subpackages/feature/museum-guide/daily/index" bindtap="onTool" hover-class="tap-press-soft" hover-stay-time="80">
          <text class="mg-tool-k">TODAY</text><text class="mg-tool-t">今日一物</text>
        </view>
        <view class="mg-tool" data-url="/subpackages/feature/museum-guide/quiz/index" bindtap="onTool" hover-class="tap-press-soft" hover-stay-time="80">
          <text class="mg-tool-k">QUIZ</text><text class="mg-tool-t">博物小测</text>
        </view>
        <view class="mg-tool" data-url="/subpackages/feature/museum-guide/notes/index" bindtap="onTool" hover-class="tap-press-soft" hover-stay-time="80">
          <text class="mg-tool-k">NOTES</text><text class="mg-tool-t">博物笔记</text>
        </view>
      </view>
      <!-- 标本工坊（2026-11-23）：制作体验 / 陈列体验 / 标本灵感 → 馆里的同类藏品 -->
      <view class="mg-workshop" data-url="/subpackages/feature/museum-guide/workshop/index" bindtap="onTool" hover-class="tap-press-soft" hover-stay-time="80">
        <view class="mg-workshop-main">
          <text class="mg-tool-k">WORKSHOP</text>
          <text class="mg-workshop-t">标本工坊 · 亲手做一只标本</text>
          <text class="mg-workshop-d">回软、展翅、下针、干燥、装裱，做完看看馆里的同类藏品</text>
        </view>
        <text class="mg-workshop-go">›</text>
      </view>
    </view>

    <view class="mg-list">
      <block wx:for="{{messages}}" wx:key="id">
        <!-- 访客 -->
        <view class="mg-row is-user" wx:if="{{item.role === 'user'}}">
          <text class="mg-bubble is-user" user-select>{{item.text}}</text>
        </view>
        <!-- 博物君 -->
        <view class="mg-row is-guide" wx:else>
          <view class="mg-seal" aria-hidden="true"><image class="mg-seal-icon" src="{{guideAvatar}}" mode="aspectFit"></image></view>
          <view class="mg-col">
            <view class="mg-bubble is-guide is-pending" wx:if="{{item.pending}}">
              <text class="mg-pending-t">博物君正在翻书</text>
              <view class="mg-dots" aria-hidden="true"><view class="mg-dot"></view><view class="mg-dot"></view><view class="mg-dot"></view></view>
            </view>
            <!-- 逐字显示（2026-11-23）：revealing 时显示 shown，点气泡直接写完 -->
            <text class="mg-bubble is-guide {{item.isError ? 'is-error' : ''}} {{item.revealing ? 'is-writing' : ''}}" user-select wx:else data-index="{{index}}" bindtap="onTapBubble">{{item.revealing ? item.shown : item.text}}<text class="mg-caret" wx:if="{{item.revealing}}" aria-hidden="true">▍</text></text>
            <!-- 回答里提到的图鉴物种（2026-11-23）→ 那一页 -->
            <view class="mg-species" wx:if="{{item.species.length && !item.revealing}}">
              <view class="mg-sp" wx:for="{{item.species}}" wx:for-item="sp" wx:key="no" data-no="{{sp.no}}" bindtap="onTapSpecies" hover-class="tap-press-soft" hover-stay-time="80">
                <text class="mg-sp-no">No.{{sp.no}}</text>
                <text class="mg-sp-zh">图鉴 · {{sp.zh}}</text>
                <text class="mg-sp-go">›</text>
              </view>
            </view>
            <!-- 馆内去处（白名单） -->
            <view class="mg-acts" wx:if="{{item.actions.length && !item.revealing}}">
              <text class="mg-act" wx:for="{{item.actions}}" wx:for-item="act" wx:key="key" data-url="{{act.url}}" data-tab="{{act.tab}}" data-key="{{act.key}}" bindtap="onTapAction" hover-class="tap-press" hover-stay-time="80">{{act.label}} ›</text>
            </view>
            <!-- 反馈 / 复制（2026-11-23）：写完的正式回答才出；投过票只留一句谢谢 -->
            <view class="mg-fb" wx:if="{{!item.isError && !item.isWelcome && !item.pending && !item.revealing && item.text}}">
              <block wx:if="{{item.logId}}">
                <text class="mg-fb-done" wx:if="{{item.vote}}">{{item.vote === 'up' ? '谢谢，博物君记下了' : '谢谢，博物君会再翻翻书'}}</text>
                <block wx:else>
                  <text class="mg-fb-btn" data-index="{{index}}" data-vote="up" bindtap="onVote" hover-class="tap-press" hover-stay-time="80">有帮助</text>
                  <text class="mg-fb-btn" data-index="{{index}}" data-vote="down" bindtap="onVote" hover-class="tap-press" hover-stay-time="80">没帮助</text>
                </block>
              </block>
              <text class="mg-fb-btn" data-index="{{index}}" bindtap="onCopy" hover-class="tap-press" hover-stay-time="80">复制</text>
              <text class="mg-fb-btn {{item.saved ? 'is-saved' : ''}}" data-index="{{index}}" bindtap="onSave" hover-class="tap-press" hover-stay-time="80">{{item.saved ? '已收藏' : '收藏'}}</text>
            </view>
            <!-- 追问 -->
            <view class="mg-follow" wx:if="{{item.followUps.length && !sending && !item.revealing}}">
              <text class="mg-chip" wx:for="{{item.followUps}}" wx:for-item="q" wx:key="*this" data-q="{{q}}" bindtap="onTapFollowUp" hover-class="tap-press-soft" hover-stay-time="80">{{q}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 开场问题：还没问过时出现 -->
    <!-- 闭馆（超管工作台关掉博物君，2026-11-23）：一句说明，开场问题与输入条收起；本机旧对话仍可回看 -->
    <view class="mg-closed" wx:if="{{closed}}">
      <text class="mg-closed-k">CLOSED · 闭馆整理中</text>
      <text class="mg-closed-t">{{closedText}}</text>
    </view>

    <view class="mg-starters" wx:if="{{!hasAsked && !closed}}">
      <text class="mg-starters-k">可以这样问</text>
      <text class="mg-chip is-block" wx:for="{{starters}}" wx:key="*this" data-q="{{item}}" bindtap="onTapStarter" hover-class="tap-press-soft" hover-stay-time="80">{{item}}</text>
    </view>

    <text class="mg-note">博物君的回答由 AI 生成，仅供参考；馆藏、价格与开放时间以页面为准。对话只存在这台手机上。</text>
    <view id="mg-end" class="mg-end"></view>
  </scroll-view>

  <!-- 底部输入条 -->
  <view class="mg-bar safe-area" wx:if="{{!closed}}">
    <view class="mg-bar-meta">
      <text class="mg-quota">{{quotaText || '问博物君关于自然与这座馆的事'}}</text>
      <text class="mg-clear" wx:if="{{hasAsked}}" bindtap="onClear" hover-class="tap-press" hover-stay-time="80">清空对话</text>
    </view>
    <view class="mg-bar-row">
      <input
        class="mg-input"
        value="{{draft}}"
        maxlength="{{questionMax}}"
        placeholder="问博物君…"
        placeholder-class="mg-input-ph"
        confirm-type="send"
        cursor-spacing="24"
        adjust-position
        bindinput="onDraftInput"
        bindconfirm="onSend"
      />
      <view class="mg-send {{sending || !draft ? 'is-off' : ''}}" bindtap="onSend" hover-class="tap-press" hover-stay-time="80" aria-role="button" aria-label="发送">{{sending ? '…' : '问'}}</view>
    </view>
  </view>
</view>

<app-modal id="appModal" />
