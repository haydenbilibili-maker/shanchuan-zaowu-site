/* 博物君 · 今日一物 / 博物小测 / 博物笔记 共用（2026-11-23）：深底馆面 + 浅纸标本签（与问答页同一种纸） */
page { background: var(--color-bg, #1A1814); }
.nt-page { min-height: 100vh; padding: 0 32rpx calc(64rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.nt-head { padding: 40rpx 0 8rpx; }
.nt-eyebrow { display: block; font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .2em; color: var(--brass-300, #D4BC8A); }
.nt-title { display: block; margin-top: 12rpx; font-family: var(--font-brand); font-size: var(--fs-44, 44rpx); letter-spacing: .12em; color: var(--brass-100, #F1E6CC); }
.nt-desc { display: block; margin-top: 10rpx; font-size: var(--fs-24); line-height: 1.6; color: var(--color-text-secondary); }

/* 纸面标本签 */
.nt-paper {
  position: relative;
  margin-top: 32rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: var(--r-card, 16rpx);
  background: linear-gradient(180deg, var(--mat-paper-tone), #E9DFCA);
  box-shadow: inset 0 0 0 1rpx rgba(176, 141, 87, 0.35), 0 12rpx 32rpx rgba(0, 0, 0, 0.35);
  color: var(--mat-ink);
}
.nt-paper::before {
  content: '';
  position: absolute;
  left: 14rpx; right: 14rpx; top: 14rpx; bottom: 14rpx;
  border: 1rpx solid rgba(176, 141, 87, 0.32);
  border-radius: var(--r-thumb-sm, 8rpx);
  pointer-events: none;
}
.nt-paper-top { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: var(--fs-20); letter-spacing: .12em; color: var(--mat-ink-label); }
.nt-rule { height: 1rpx; margin: 24rpx 0; background: rgba(138, 111, 69, 0.3); }
.nt-k { font-size: var(--fs-20); letter-spacing: .1em; color: var(--mat-ink-label); }
.nt-v { display: block; margin-top: 6rpx; font-size: var(--fs-26); line-height: 1.7; color: var(--mat-ink); }

/* 按钮 */
.nt-btns { display: flex; gap: 20rpx; margin-top: 32rpx; }
.nt-btn { flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--r-control, 16rpx); font-size: var(--fs-26); color: var(--brass-200, #E3D2AC); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.45); }
.nt-btn.is-primary { background: var(--brass-400, #C4A76C); color: #1A1814; box-shadow: none; font-family: var(--font-brand); }

/* 分节 */
.nt-sec { margin-top: 48rpx; }
.nt-sec-k { display: block; font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .16em; color: var(--brass-300, #D4BC8A); }
.nt-sec-t { display: block; margin-top: 6rpx; font-size: var(--fs-30, 30rpx); color: var(--brass-100, #F1E6CC); }
.nt-row { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid rgba(196, 167, 108, 0.12); }
.nt-row-d { width: 84rpx; flex-shrink: 0; font-family: var(--font-mono); font-size: var(--fs-22); color: var(--color-text-secondary); }
.nt-row-t { flex: 1; min-width: 0; font-size: var(--fs-26); color: var(--brass-100, #F1E6CC); }
.nt-row-s { flex-shrink: 0; font-size: var(--fs-22); color: var(--color-text-secondary); }
.nt-foot { display: block; margin-top: 40rpx; text-align: center; font-size: var(--fs-22); color: var(--color-text-secondary); }
