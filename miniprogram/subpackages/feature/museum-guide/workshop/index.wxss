@import '../naturalist.wxss';
/* 标本工坊（2026-11-23） */
.ws-tabs { display: flex; margin-top: 28rpx; border-bottom: 1rpx solid rgba(196, 167, 108, 0.18); }
.ws-tab { flex: 1; padding: 20rpx 0; text-align: center; font-size: var(--fs-26); color: var(--color-text-secondary); border-bottom: 3rpx solid transparent; }
.ws-tab.is-on { color: var(--brass-100, #F1E6CC); border-bottom-color: var(--brass-400, #C4A76C); }
.ws-lead { display: block; margin-top: 28rpx; font-size: var(--fs-24); line-height: 1.6; color: var(--color-text-secondary); }
.ws-sub { display: block; margin-top: 28rpx; font-size: var(--fs-22); color: var(--brass-300, #D4BC8A); }
.ws-link { display: block; margin-top: 24rpx; padding: 8rpx 0; text-align: center; font-size: var(--fs-24); color: var(--brass-200, #E3D2AC); }
.ws-link-dark { display: block; margin-top: 20rpx; padding: 6rpx 0; font-size: var(--fs-24); color: #8A6F45; }
.ws-loading { display: block; margin-top: 20rpx; font-size: var(--fs-24); color: var(--color-text-secondary); }
.dl-latin { display: block; margin-top: 6rpx; font-family: var(--font-latin); font-style: italic; font-size: var(--fs-24); color: #6B5A3E; }

/* 选一只 */
.ws-choice { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; padding: 26rpx 24rpx; border-radius: var(--r-card, 16rpx); background: rgba(196, 167, 108, 0.06); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3); }
.ws-choice-no { flex-shrink: 0; font-family: var(--font-mono); font-size: var(--fs-20); color: var(--brass-300, #D4BC8A); }
.ws-choice-main { flex: 1; min-width: 0; }
.ws-choice-name { display: block; font-family: var(--font-brand); font-size: var(--fs-30, 30rpx); color: var(--brass-100, #F1E6CC); }
.ws-choice-latin { display: block; margin-top: 4rpx; font-family: var(--font-latin); font-style: italic; font-size: var(--fs-22); color: var(--color-text-secondary); }
.ws-choice-go { flex-shrink: 0; font-size: var(--fs-24); color: var(--brass-200, #E3D2AC); }

/* 五步进度 */
.ws-steps { display: flex; gap: 8rpx; margin-top: 28rpx; }
.ws-step-pip { flex: 1; padding-top: 12rpx; border-top: 4rpx solid rgba(196, 167, 108, 0.18); text-align: center; font-size: var(--fs-20); color: var(--color-text-secondary); }
.ws-step-pip.is-past { border-top-color: var(--brass-400, #C4A76C); color: var(--brass-300, #D4BC8A); }
.ws-step-pip.is-on { border-top-color: var(--brass-200, #E3D2AC); color: var(--brass-100, #F1E6CC); }
.ws-card { margin-top: 20rpx; }
.ws-how { display: block; margin-top: 20rpx; font-family: var(--font-brand); font-size: var(--fs-30, 30rpx); color: #2E2618; }
.ws-stage { margin-top: 28rpx; }
.ws-readout { display: block; margin: 16rpx 0; text-align: center; font-family: var(--font-mono); font-size: var(--fs-24); color: #6B5A3E; }
.ws-readout.ws-big { font-size: 56rpx; color: #2E2618; }
.ws-act { margin-top: 24rpx; }
.nt-btn.is-off { opacity: .45; }

/* 回软：刻度条 + 按住钮 */
.ws-gauge { position: relative; height: 18rpx; border-radius: var(--r-pill, 999rpx); background: rgba(138, 111, 69, 0.18); overflow: hidden; }
.ws-gauge-zone { position: absolute; top: 0; bottom: 0; background: rgba(78, 112, 74, 0.35); }
.ws-gauge-fill { position: absolute; left: 0; top: 0; bottom: 0; background: rgba(176, 141, 87, 0.75); }
.ws-hold { height: 120rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--r-card, 16rpx); background: #2E2618; color: #F3E7D3; font-family: var(--font-brand); font-size: var(--fs-30, 30rpx); letter-spacing: .1em; }
.ws-hold.is-holding { background: #8A6F45; }
.ws-hold.is-done { opacity: .5; }

/* 展翅：两片翅 + 身体 */
.ws-bfly { position: relative; height: 220rpx; display: flex; align-items: center; justify-content: center; }
.ws-body { width: 14rpx; height: 150rpx; border-radius: var(--r-pill, 999rpx); background: #3A2F1E; z-index: 1; }
.ws-wing { width: 170rpx; height: 130rpx; background: linear-gradient(135deg, #3F6FA8, #1E3D66); opacity: .9; transition: transform .08s linear; }
.ws-wing.is-left { border-radius: 80% 10% 30% 60%; transform-origin: 100% 50%; margin-right: -4rpx; }
.ws-wing.is-right { border-radius: 10% 80% 60% 30%; transform-origin: 0% 50%; margin-left: -4rpx; }

/* 下针：轨道 + 靶区 + 针 */
.ws-track { position: relative; height: 80rpx; border-radius: var(--r-control, 16rpx); background: rgba(138, 111, 69, 0.15); }
.ws-target { position: absolute; left: 45%; width: 10%; top: 0; bottom: 0; background: rgba(78, 112, 74, 0.35); }
.ws-needle { position: absolute; top: 8rpx; bottom: 8rpx; width: 4rpx; margin-left: -2rpx; background: #2E2618; }

/* 装裱选择 */
.ws-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; }
.ws-chip { padding: 14rpx 24rpx; border-radius: var(--r-pill, 999rpx); font-size: var(--fs-24); color: #6B5A3E; box-shadow: inset 0 0 0 1rpx rgba(138, 111, 69, 0.4); }
.ws-chip.is-on { background: #2E2618; color: #F3E7D3; box-shadow: none; }
.ws-chip.is-dark { color: var(--brass-200, #E3D2AC); box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.4); }
.ws-chip.is-dark.is-on { background: var(--brass-400, #C4A76C); color: #1A1814; }

/* 本步结果 */
.ws-result { margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(138, 111, 69, 0.3); }
.ws-why { display: block; margin-top: 12rpx; font-size: var(--fs-22); line-height: 1.7; color: #6B5A3E; }

/* 作品卡：衬底三种 */
.ws-work { margin-top: 32rpx; padding: 28rpx; border-radius: var(--r-card, 16rpx); box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.45); }
.ws-work.bd-linen { background: linear-gradient(180deg, #F3ECDD, #E6DAC2); color: #2E2618; }
.ws-work.bd-ink { background: linear-gradient(180deg, #24211D, #141210); color: #F1E6CC; }
.ws-work.bd-wood { background: linear-gradient(180deg, #C9A27A, #A47E58); color: #2A1E12; }
.ws-work-graphic { display: block; width: 100%; border-radius: var(--r-thumb-sm, 8rpx); margin-bottom: 20rpx; }
.ws-work-in { position: relative; padding: 28rpx 24rpx; border: 1rpx solid rgba(176, 141, 87, 0.5); border-radius: var(--r-thumb-sm, 8rpx); }
.ws-work-top { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: var(--fs-20); letter-spacing: .1em; opacity: .75; }
.ws-work-name { display: block; margin-top: 28rpx; font-family: var(--font-brand); font-size: 56rpx; letter-spacing: .1em; }
.ws-work-latin { display: block; margin-top: 6rpx; font-family: var(--font-latin); font-style: italic; font-size: var(--fs-24); opacity: .75; }
.ws-work-seal { position: absolute; right: 24rpx; top: 70rpx; padding: 10rpx 14rpx; border-radius: var(--r-thumb-sm, 8rpx); background: #8E3B2E; color: #F3E7D3; font-family: var(--font-brand); font-size: var(--fs-26); letter-spacing: .1em; transform: rotate(-6deg); }
.ws-work-score { display: block; margin-top: 18rpx; font-size: var(--fs-24); opacity: .85; }
.ws-work-notes { margin-top: 20rpx; }
.ws-work-note { display: flex; gap: 16rpx; padding: 10rpx 0; border-top: 1rpx solid rgba(176, 141, 87, 0.25); }
.ws-wn-k { flex-shrink: 0; width: 120rpx; font-family: var(--font-mono); font-size: var(--fs-20); opacity: .75; }
.ws-wn-v { flex: 1; min-width: 0; font-size: var(--fs-22); line-height: 1.6; }
.ws-work-sign { display: block; margin-top: 20rpx; text-align: right; font-size: var(--fs-20); letter-spacing: .12em; opacity: .7; }

/* 陈列方案 / 灵感签 */
.ws-plan-t { display: block; margin-top: 16rpx; font-family: var(--font-brand); font-size: 40rpx; color: #2E2618; }
.ws-insp-t { display: block; margin-top: 20rpx; font-family: var(--font-brand); font-size: 44rpx; letter-spacing: .06em; color: #2E2618; }
.ws-insp-line { display: block; margin-top: 18rpx; font-family: var(--font-brand); font-size: var(--fs-26); line-height: 1.8; color: #3A2F1E; }

/* 推荐两列 */
.ws-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 20rpx; }
.ws-cell { width: 48.5%; margin-bottom: 20rpx; }
