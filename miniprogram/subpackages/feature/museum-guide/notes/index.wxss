@import '../naturalist.wxss';
.nb-card { margin-top: 28rpx; }
.nb-q { display: block; margin-top: 20rpx; font-size: var(--fs-24); line-height: 1.6; color: #6B5A3E; }
.nb-a { display: block; margin-top: 12rpx; font-size: var(--fs-26); line-height: 1.8; color: #2E2618; white-space: pre-wrap; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }
.nb-a.is-open { display: block; -webkit-line-clamp: unset; overflow: visible; }
.nb-acts { display: flex; gap: 32rpx; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(138, 111, 69, 0.3); }
.nb-act { padding: 6rpx 0; font-size: var(--fs-22); color: #8A6F45; }
.nb-act.is-danger { color: #8E3B2E; }
.nb-empty { margin-top: 64rpx; text-align: center; }
.nb-empty-t { display: block; font-family: var(--font-brand); font-size: var(--fs-30, 30rpx); color: var(--brass-100, #F1E6CC); }
.nb-empty-d { display: block; margin-top: 12rpx; font-size: var(--fs-24); line-height: 1.6; color: var(--color-text-secondary); }
