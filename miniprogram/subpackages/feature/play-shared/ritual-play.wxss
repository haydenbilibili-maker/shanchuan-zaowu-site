/**
 * 玩法页共享样式（PRD v1.4 §11.4：玩法各开一页）。
 *
 * 为什么是一个共享 wxss 而不是四份：四个玩法页**只该在"自己的表达"上不同**
 * （入口形态、进行态动画、结果纸面），布局骨架、动作按钮、推荐行、留档、补资料引导
 * 应当是同一套 —— 复制四份必然各自漂移（本仓错题本反复出现的形态）。
 * 四个页都在 `subpackages/feature/` 同一个分包里，`@import` 同包文件是合法方向
 * （分包只能引用主包 + 自己，见 `check:subpackage-refs`）。
 *
 * 色/字口径：一律走 `app.wxss` 的令牌（`--brass-*` / `--color-*` / `--fs-*` / `--space-*`），
 * 不写字面量字号；`color` 与 `background` 不在同一条规则里成对出现（除非对比度明显安全）——
 * `check:mp-contrast` 只判"同规则配对"的对比度，这是刻意的免责写法，
 * 但也因此**每个页面的纸面语言由各页自己的 wxss 定义**（浅纸上的深字在那里声明）。
 */

.rp-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 var(--space-4) var(--space-6);
}

/* ── 页头：字标 + 玩法名 + "今天玩过没有" ───────────────────────── */
.rp-hero {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) 0 var(--space-2);
}

.rp-hero-mark {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  font-size: var(--fs-26);
  line-height: 64rpx;
  text-align: center;
  color: var(--color-bg);
  background: linear-gradient(145deg, var(--brass-200) 0%, var(--brass-400) 52%, var(--brass-600) 100%);
  border-radius: 50%;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.5);
}

.rp-hero-copy {
  flex: 1;
  min-width: 0;
}

.rp-hero-name {
  display: block;
  font-size: var(--fs-30);
  letter-spacing: 0.04em;
  color: var(--brass-300);
}

.rp-hero-state {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-muted, #8A857C);
}

/* ── 进行态 / 入口：舞台（各页自己的动画在页面 wxss 里） ───────────── */
.rp-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  padding: var(--space-1) 0;
}

.rp-hint {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--fs-22);
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-body);
}

.rp-spin-text {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  text-align: center;
  color: var(--brass-300);
}

/* ── 主按钮（开始一次玩法） ───────────────────────────────────── */
.rp-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  margin-top: var(--space-2);
  font-size: var(--fs-26);
  border-radius: var(--radius-md);
}

.rp-cta.is-primary {
  color: var(--color-bg);
  background: linear-gradient(135deg, var(--brass-300) 0%, var(--brass-500) 100%);
}

.rp-cta.is-pending {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.12);
  border: 1rpx solid rgba(196, 167, 108, 0.42);
}

.rp-press {
  opacity: 0.86;
}

/* ── 结果：纸面骨架（浅纸上的深字；各页的纸面材质/边界在页面 wxss） ── */
.rp-paper {
  position: relative;
  box-sizing: border-box;
  margin-top: var(--space-2);
  padding: 34rpx 30rpx 30rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.28);
}

.rp-paper-grip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 34rpx;
  margin: -22rpx 0 6rpx;
}

.rp-paper-grip-bar {
  width: 76rpx;
  height: 6rpx;
  background: rgba(58, 50, 38, 0.28);
  border-radius: 999rpx;
}

.rp-paper-mark {
  position: absolute;
  top: 24rpx;
  right: 26rpx;
  width: 56rpx;
  height: 56rpx;
  font-size: var(--fs-24);
  line-height: 56rpx;
  text-align: center;
  color: #7A2E24;
  border: 2rpx solid rgba(122, 46, 36, 0.55);
  border-radius: 8rpx;
}

.rp-paper-overline {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.14em;
  color: rgba(58, 50, 38, 0.66);
}

.rp-paper-title {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-40);
  line-height: 1.25;
  color: #2A2418;
}

.rp-paper-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  color: rgba(58, 50, 38, 0.78);
}

.rp-line {
  display: block;
  margin-top: 14rpx;
  font-size: var(--fs-26);
  line-height: 1.62;
  color: #3A3226;
}

.rp-note {
  display: block;
  margin-top: 18rpx;
  padding-top: 16rpx;
  font-size: var(--fs-20);
  line-height: 1.58;
  color: rgba(58, 50, 38, 0.62);
  border-top: 1rpx solid rgba(42, 36, 24, 0.16);
}

/* ── 结果页的动作（主 CTA 必须在最上面：推荐不许抢注意力） ─────────── */
.rp-acts {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.rp-act {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  /* 2026-09-22：84 → 88。渲染台量出 84rpx < 本仓自己的 **88rpx（44pt）可点区下限**
     （`.rp-cta` 就是 88）—— 四个玩法页的动作按钮都偏矮，真机上容易点不中。 */
  height: 88rpx;
  font-size: var(--fs-26);
  border-radius: var(--radius-md);
}

.rp-act.is-primary {
  color: var(--color-bg);
  background: linear-gradient(135deg, var(--brass-300) 0%, var(--brass-500) 100%);
}

.rp-act.is-share {
  color: var(--brass-300);
  background: transparent;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
}

/* ── 祈运弱推：取件中占位、失败也占位（同高，内容不上跳） ───────────── */
.rp-reco {
  display: flex;
  align-items: center;
  margin-top: var(--space-2);
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.rp-reco-copy {
  flex: 1;
  min-width: 0;
}

.rp-reco-label {
  display: block;
  font-size: var(--fs-20);
  color: var(--brass-300);
}

.rp-reco-title {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-26);
  color: #EFE6D2;
}

.rp-reco-meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-muted, #8A857C);
}

.rp-reco-skel {
  height: 34rpx;
  margin-top: 6rpx;
  border-radius: var(--radius-sm);
}

.rp-reco-go {
  flex-shrink: 0;
  margin-left: var(--space-2);
  font-size: var(--fs-22);
  color: var(--brass-300);
}

/* ── 缺资料：去补（不给假结果的这条路是画出来的） ─────────────────── */
.rp-need {
  margin-top: var(--space-2);
  padding: 28rpx 26rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-md);
}

.rp-need-text {
  display: block;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: var(--color-text-body);
}

.rp-need-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 2026-09-22：80 → 88（同上，可点区下限）。缺资料是**唯一出口**，更不该难点。 */
  height: 88rpx;
  margin-top: 20rpx;
  font-size: var(--fs-24);
  border-radius: var(--radius-md);
}

.rp-need-cta.is-primary {
  color: var(--color-bg);
  background: var(--brass-300);
}

/* ── 「换一个」维度切换（星座 12 / MBTI 16） ──────────────────────── */
.rp-variants {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: var(--space-3);
}

.rp-variant {
  /* 2026-09-22：渲染台（可点区清单改为**从 WXML 的 bindtap 自动派生**后）量出
     它只有 **102×50rpx** —— 而星座 12 个 / MBTI 16 个是密集网格，最容易误触。
     竖向 padding 10 → 30rpx：芯片高 50 → **90rpx**（≥ 88rpx 下限），
     网格因此变高是可接受的代价（每行多 40rpx，2–3 行）。 */
  padding: 30rpx 20rpx;
  /* 短标签（MBTI 的 INTJ 这类 4 字母）只有 84rpx 宽 < 88rpx 下限 ⇒ 用 min-width 兜住。
     只影响比 88rpx 还窄的芯片，宽标签（摩羯座这类 3 字）视觉不变。 */
  min-width: 88rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: var(--fs-20);
  color: var(--color-text-body);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}

.rp-variant.is-on {
  color: var(--color-bg);
  background: var(--brass-300);
  border-color: var(--brass-300);
}

/* ── 留档（可回看） ──────────────────────────────────────────── */
.rp-archive {
  margin-top: var(--space-3);
}

.rp-archive-toggle {
  display: block;
  font-size: var(--fs-22);
  color: var(--brass-300);
  /* 2026-09-22：它原来是个**裸文字链**（高度只有 ~30rpx）—— 渲染台量出来的可点区远低于 88rpx。
     用 padding 撑开触控区 + **负 margin 抵消**，视觉一行字原样不动。 */
  padding: 29rpx 0;
  margin: -29rpx 0;
}

.rp-archive-list {
  margin-top: 10rpx;
}

.rp-archive-row {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
  font-size: var(--fs-20);
  color: var(--color-text-muted, #8A857C);
  border-bottom: 1rpx solid var(--color-border);
}

.rp-archive-day {
  flex-shrink: 0;
}

.rp-archive-what {
  flex: 1;
  min-width: 0;
  color: var(--color-text-body);
}

.rp-archive-empty {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-20);
  color: var(--color-text-muted, #8A857C);
}

/* ── 底部合规小字（与 utils/ritualFeedback.js 头注同一条口径） ──────── */
.rp-foot {
  display: block;
  margin-top: var(--space-4);
  font-size: var(--fs-18);
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-muted, #8A857C);
}
