/* components/CommentList/index.wxss
 * 2026-11-25 产品负责人「用户评价也使用纸质规范进行优化」—— 材质规范 docs/材质规范_纸与金属_2026-11-25.md：
 *   · 评分签：标本签纸 + 内框（本区主角纸，只有它带内框以外的装饰）
 *   · 每条评价：信笺纸（藏家写下的一张笺），内框发丝线；字只用墨四档；星用铜色
 *   · 晒图：贴在笺上的小照片（纸白衬边 + 浅影）；商家回复：牛皮回执纸附条
 *   · 排序 / 筛选是控件，留在暗底：去掉外框盒子，只留胶囊；选中 = 发丝金环（不实心金）
 *   · 按压：纸下沉 2rpx、投影收短，不缩放 / 不降透明度
 * 组件样式隔离：--mat-* 令牌经 page 继承可取；全局类（tap-press 等）取不到，按压态在本文件内写。 */

.comment-list {
  padding: 8rpx 0 24rpx;
}

/* —— 评分签 —— */
.comment-stats {
  position: relative;
  margin-bottom: 28rpx;
  padding: 30rpx 32rpx 28rpx;
  border-radius: var(--r-card, 16rpx);
  background: var(--mat-paper-grain), var(--mat-paper-label);
  box-shadow: var(--mat-paper-shadow), var(--mat-paper-edge);
  color: var(--mat-ink);
}
.comment-stats::before {
  content: '';
  position: absolute;
  inset: 10rpx;
  border: 1rpx solid var(--mat-paper-frame);
  border-radius: var(--r-thumb-sm, 8rpx);
  pointer-events: none;
}
.stats-header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20rpx;
}
.stats-title {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.title-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.16em;
  color: var(--mat-ink-label);
}
.title-cn {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--mat-ink);
}
.stats-rating {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.rating-value {
  font-family: var(--font-brand);
  font-size: 60rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--mat-ink);
}
.rating-stars {
  display: flex;
  gap: 2rpx;
}
.star {
  font-size: var(--fs-24);
  color: rgba(138, 111, 69, 0.25);
}
.star.active {
  color: var(--mat-brass-pin);
}
.stats-count {
  font-size: var(--fs-20);
  letter-spacing: 0.06em;
  color: var(--mat-ink-label);
}

/* —— 排序 / 筛选（暗底控件） —— */
.comment-filters {
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.filter-group {
  display: flex;
  align-items: center;
}
.filter-label {
  min-width: 80rpx;
  margin-right: 12rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.06em;
  color: var(--color-text-secondary);
}
.filter-chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.filter-chip {
  padding: 8rpx 22rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  border-radius: var(--r-pill, 999rpx);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.18);
  transition: color var(--dur-fast) var(--ease-standard), box-shadow var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard);
}
.filter-chip.active {
  color: var(--brass-200, #E0CFA3);
  font-weight: 600;
  background: rgba(196, 167, 108, 0.1);
  box-shadow: var(--ring-brass-soft);
}
.filter-chip-press {
  background: rgba(196, 167, 108, 0.14);
}

/* —— 每条评价：信笺纸 —— */
.comments-container {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.comment-item {
  position: relative;
  padding: 30rpx 30rpx 24rpx;
  border-radius: var(--r-card, 16rpx);
  background: var(--mat-paper-grain), var(--mat-paper-letter);
  box-shadow: var(--mat-paper-shadow), var(--mat-paper-edge);
  color: var(--mat-ink);
}
.comment-item::before {
  content: '';
  position: absolute;
  inset: 10rpx;
  border: 1rpx solid var(--mat-paper-frame);
  border-radius: var(--r-thumb-sm, 8rpx);
  pointer-events: none;
}
.comment-header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.comment-user {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.user-name {
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--mat-ink);
}
.comment-rating {
  display: flex;
  gap: 2rpx;
}
.comment-rating .star {
  font-size: var(--fs-22);
}
.comment-time {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.06em;
  color: var(--mat-ink-label);
}
.comment-content {
  position: relative;
  margin-bottom: 18rpx;
  font-size: var(--fs-28);
  line-height: 1.8;
  color: var(--mat-ink-body);
  word-break: break-word;
}
.pin-tag {
  display: inline-flex;
  align-items: center;
  margin-right: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--r-thumb-sm, 8rpx);
  font-family: var(--font-brand);
  font-size: var(--fs-20);
  letter-spacing: 0.1em;
  color: var(--mat-seal);
  background: var(--mat-seal-tint);
  box-shadow: inset 0 0 0 1rpx var(--mat-seal-line);
  white-space: nowrap;
  box-sizing: border-box;
}

/* 商家回复：牛皮回执纸附条 */
.merchant-reply {
  position: relative;
  margin: 0 0 18rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-thumb-sm, 8rpx);
  background: var(--mat-paper-kraft);
  box-shadow: var(--mat-paper-edge);
}
.reply-label {
  display: block;
  margin-bottom: 6rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.14em;
  color: var(--mat-ink-label);
}
.reply-text {
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--mat-ink-body);
}

/* 追加评价：同一张笺纸的续笺 —— 虚线裁切 + 墨色小签，不另起卡片 */
.comment-append {
  position: relative;
  margin: 4rpx 0 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--mat-paper-rule);
}
.append-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.append-label {
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--mat-seal-line);
  border-radius: 4rpx;
  background: var(--mat-seal-tint);
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.14em;
  color: var(--mat-seal);
}
.append-days {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.08em;
  color: var(--mat-ink-label);
}
.append-text {
  display: block;
  font-size: var(--fs-26);
  line-height: 1.7;
  color: var(--mat-ink-body);
}
.append-images {
  margin: 14rpx 0 0;
}

/* 晒图：贴在笺上的小照片 */
.comment-images {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.comment-image {
  width: 200rpx;
  height: 200rpx;
  box-sizing: border-box;
  border: 6rpx solid #FBF8F1;
  border-radius: var(--r-thumb-sm, 8rpx);
  background: var(--mat-paper-tone-deep);
  box-shadow: 0 4rpx 10rpx rgba(92, 70, 28, 0.2), 0 0 0 1rpx var(--mat-paper-frame);
}

/* 行脚：虚线 + 墨线小钮 */
.comment-footer {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--mat-paper-rule);
}
.comment-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill, 999rpx);
  box-shadow: inset 0 0 0 1rpx rgba(138, 111, 69, 0.35);
  transition: transform var(--dur-instant) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard);
}
.comment-like.liked {
  background: var(--mat-seal-tint);
  box-shadow: inset 0 0 0 1rpx var(--mat-seal-line);
}
.comment-like-press {
  transform: var(--mat-press-shift);
  background: rgba(138, 111, 69, 0.08);
}
.like-icon {
  font-size: var(--fs-24);
  color: var(--mat-ink-soft);
}
.comment-like.liked .like-icon,
.comment-like.liked .like-count {
  color: var(--mat-seal);
}
.like-count {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--mat-ink-soft);
}

/* —— 加载 / 空态（暗底） —— */
.load-more {
  padding: 30rpx;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--brass-300, #D4BC85);
}
.load-more-press {
  opacity: 0.78;
}
.loading {
  padding: 30rpx;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.7;
}
.empty-cta {
  margin-top: 24rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: var(--r-pill, 999rpx);
  color: var(--color-primary);
  font-size: var(--fs-24);
}
.empty-text {
  margin-bottom: 12rpx;
  font-size: var(--fs-28);
  color: var(--color-text-secondary);
}
.empty-sub {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}
