/* components/CommentList/index.wxss */

.comment-list {
  padding: 40rpx 30rpx;
  background: var(--color-bg);
}

/* 评价统计 */
.comment-stats {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  border: 1rpx solid rgba(196, 167, 108,0.2);
  border-radius: var(--radius-md);
  backdrop-filter: blur(10px);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats-title {
  display: flex;
  flex-direction: column;
}

.title-cn {
  font-size: var(--fs-32);
  font-weight: 900;
  color: #fff;
  margin-bottom: 8rpx;
  font-family: var(--font-latin);
}

.title-en {
  font-size: var(--fs-20);
  color: var(--color-primary);
  letter-spacing: 2rpx;
  font-family: var(--font-mono);
}

.stats-rating {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rating-value {
  font-size: var(--fs-48);
  font-weight: 900;
  color: var(--color-primary);
  font-family: var(--font-mono);
}

.rating-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: var(--fs-24);
  color: rgba(255,255,255,0.2);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
}

.star.active {
  color: var(--color-primary);
  text-shadow: none;
}

.stats-count {
  font-size: var(--fs-22);
  color: rgba(255,255,255,0.5);
  font-family: var(--font-mono);
}

/* 排序和筛选 */
.comment-filters {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: rgba(255,255,255,0.03);
  border-radius: var(--radius-md);
  border: 1px solid rgba(255,255,255,0.05);
}

.filter-group {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: var(--fs-24);
  color: rgba(255,255,255,0.6);
  margin-right: 16rpx;
  min-width: 80rpx;
}

.filter-chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.filter-chip {
  padding: 8rpx 20rpx;
  font-size: var(--fs-22);
  color: rgba(255,255,255,0.6);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-lg);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
}

.filter-chip.active {
  color: var(--color-primary, #C4A76C);
  background: rgba(196, 167, 108,0.15);
  border-color: rgba(196, 167, 108,0.4);
  font-weight: 700;
}

.filter-chip-press,
.comment-like-press,
.load-more-press {
  opacity: 0.78;
}

/* 评价列表 */
.comments-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.comment-item {
  padding: 30rpx;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: var(--radius-md);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.comment-user {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: var(--fs-26);
  font-weight: 700;
  color: #fff;
}

.comment-rating {
  display: flex;
  gap: 4rpx;
}

.comment-time {
  font-size: var(--fs-20);
  color: rgba(255,255,255,0.4);
  font-family: var(--font-mono);
}

.comment-content {
  font-size: var(--fs-28);
  line-height: 1.8;
  color: rgba(255,255,255,0.8);
  margin-bottom: 20rpx;
  word-break: break-word;
}

/* 评价图片 */
.comment-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.comment-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.05);
}

.comment-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.comment-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-lg);
  background: rgba(255,255,255,0.05);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
}

.comment-like.liked {
  background: rgba(196, 167, 108,0.15);
  border: 1rpx solid rgba(196, 167, 108,0.3);
}

.like-icon {
  font-size: var(--fs-24);
  color: rgba(255,255,255,0.6);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
}

.comment-like.liked .like-icon {
  color: var(--color-primary);
}

.like-count {
  font-size: var(--fs-22);
  color: rgba(255,255,255,0.5);
  font-family: var(--font-mono);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: rgba(255,255,255,0.6);
  font-size: var(--fs-24);
}

.loading {
  text-align: center;
  padding: 30rpx;
  color: rgba(255,255,255,0.4);
  font-size: var(--fs-24);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.7;
}

.empty-cta {
  margin-top: 24rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 9999px;
  color: var(--color-primary);
  font-size: var(--fs-24);
}

.empty-text {
  font-size: var(--fs-28);
  color: rgba(255,255,255,0.5);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: var(--fs-22);
  color: rgba(255,255,255,0.3);
}

.pin-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  font-size: var(--fs-20);
  color: var(--color-success);
  border: 1px solid rgba(82, 183, 136, 0.4);
  padding: 4rpx 8rpx;
  border-radius: var(--radius-sm);
  margin-right: 8rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.merchant-reply {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(196, 167, 108, 0.08);
  border-left: 3rpx solid var(--color-primary);
  border-radius: var(--radius-sm);
}

.reply-label {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-primary);
  margin-bottom: 6rpx;
}

.reply-text {
  font-size: var(--fs-24);
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.5;
}






