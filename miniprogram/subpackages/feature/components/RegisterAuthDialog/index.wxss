/* 注册引导 / 一键注册弹窗 —— 形态取 app.wxss 的 ui-pop-* 零件 */

.rad-mask { z-index: 900; }
.rad-plate { text-align: center; }

.rad-desc {
  margin-top: 14rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--text-sub, #A09A90);
  text-align: center;
}

.rad-perks {
  width: 100%;
  margin: 28rpx 0 8rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.16);
  box-sizing: border-box;
}
.rad-perk {
  display: flex;
  align-items: center;
  padding: 7rpx 0;
}
.rad-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold, #C4A76C);
  margin-right: 14rpx;
  flex-shrink: 0;
}
.rad-perk-t {
  font-size: 24rpx;
  color: var(--text-body, #D5D1C8);
  line-height: 1.5;
}

.rad-agree {
  width: 100%;
  margin-top: 18rpx;
  padding: 16rpx 8rpx;
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  border-radius: var(--radius-sm, 8rpx);
}
.rad-check {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  margin: 4rpx 14rpx 0 0;
  flex-shrink: 0;
  border: 2rpx solid rgba(196, 167, 108, 0.7);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}
.rad-check.is-on { background: var(--gold, #C4A76C); border-color: var(--gold, #C4A76C); }
.rad-check.is-on::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 3rpx;
  width: 8rpx;
  height: 16rpx;
  border: solid #1A1814;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}
.rad-agree-t {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-sub, #A09A90);
}
.rad-agree-hint {
  align-self: flex-start;
  padding-left: 54rpx;
  font-size: 22rpx;
  color: var(--brass-300, #D4BC85);
}
.rad-agree.is-shake { animation: rad-shake 0.42s ease; }
@keyframes rad-shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-10rpx); }
  40%, 80% { transform: translateX(10rpx); }
}

.rad-cta {
  width: 100%;
  margin-top: 14rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border: none;
  border-radius: var(--radius-md);
  background: var(--brass-400, #C4A76C);   /* 与 ui-pop-btn.is-primary 同为平涂品牌金（原三段铜铸渐变 + 900 粗黑） */
  color: #1A1814;
  font-size: var(--fs-28);
  font-weight: 600;
  letter-spacing: 0.04em;
}
.rad-cta::after { border: none; }
.rad-cta-press { opacity: 0.88; }
.rad-cta[disabled] { opacity: 0.6; }
.rad-cta.is-off { opacity: 0.55; }

.rad-link { color: var(--gold, #C4A76C); }

.rad-close {
  margin-top: 22rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-sub, #A09A90);
}
