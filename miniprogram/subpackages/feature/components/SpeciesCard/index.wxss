.species-card {
  background: var(--color-bg-card, #1F1D1A);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1rpx solid rgba(38, 35, 32, 0.9);
}

.card-image-wrap {
  position: relative;
  width: 100%;
  height: 480rpx;
  background: #1A1814;
}

.card-image {
  width: 100%;
  height: 100%;
  display: block;
}

.card-image-veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: linear-gradient(to top, rgba(26, 24, 20, 0.92), transparent);
  pointer-events: none;
}

.card-image-badge {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 16rpx;
  background: rgba(26, 24, 20, 0.72);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-sm);
}

.card-image-badge text {
  font-size: var(--fs-20);
  font-weight: 500;
  color: var(--color-primary);
  letter-spacing: 0.06em;
}

.card-body {
  padding: 32rpx;
}

.specimen-plate {
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
  background: #FAF6ED;
  border: 1rpx solid #E0CFA3;
  border-radius: var(--radius-md);
}

.plate-en {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--fs-18);
  font-weight: 500;
  letter-spacing: 0.16em;
  color: #8A7530;
  font-style: italic;
}

.name-block {
  margin-bottom: 0;
}

.name-zh {
  display: block;
  font-size: var(--fs-40);
  font-weight: 600;
  font-family: var(--font-brand);
  color: #6B5A24;
  letter-spacing: 0.04em;
  line-height: 1.3;
}

.name-latin {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-26);
  font-style: italic; font-family: var(--font-latin);
  color: var(--color-primary);
  line-height: 1.35;
}

.plate-protection {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E0CFA3;
}

.plate-protection-label {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.12em;
  color: #8A7530;
  margin-bottom: 10rpx;
}

.prot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.prot-tag {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  background: rgba(196, 167, 108, 0.12);
}

.prot-sys {
  font-size: var(--fs-18);
  letter-spacing: 0.06em;
  color: #8A7530;
}

.prot-val {
  font-size: var(--fs-22);
  font-weight: 500;
  color: #6B5A24;
}

.prot-tag.tone-warn {
  border-color: rgba(233, 162, 59, 0.4);
  background: rgba(233, 162, 59, 0.12);
}

.prot-tag.tone-warn .prot-val {
  color: #E9A23B;
}

.prot-tag.tone-ok {
  border-color: rgba(45, 90, 63, 0.28);
  background: rgba(45, 90, 63, 0.08);
}

.prot-tag.tone-ok .prot-val {
  color: #2D5A3F;
}

.prot-tag.tone-info {
  border-color: rgba(91, 143, 185, 0.28);
  background: rgba(91, 143, 185, 0.08);
}

.prot-tag.tone-info .prot-val {
  color: var(--color-info);
}

.prot-tag.tone-muted {
  border-color: rgba(139, 111, 71, 0.25);
  background: rgba(139, 111, 71, 0.08);
}

.prot-empty {
  font-size: var(--fs-22);
  color: #8B6F47;
}

.prot-summary {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-20);
  line-height: 1.6;
  color: #8B6F47;
}

.tax-scroll {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.tax-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 0 4rpx 4rpx;
  padding-right: 32rpx;
}

.tax-chip {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  font-size: var(--fs-22);
  color: #D4BC85;
  background: rgba(196, 167, 108, 0.08);
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(196, 167, 108, 0.22);
}

.confidence-block {
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  background: var(--color-bg-elevated, #262320);
  border: 1rpx solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
}

.conf-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.conf-label {
  font-size: var(--fs-22);
  color: #A09A90;
  letter-spacing: 0.04em;
}

.conf-pct {
  font-size: var(--fs-28);
  font-weight: 600;
  font-family: var(--font-mono, monospace);
  color: var(--color-primary);
}

.conf-pct.tone-medium {
  color: #E9A23B;
}

.conf-pct.tone-low {
  color: #D64045;
}

.conf-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(77, 64, 26, 0.55);
  overflow: hidden;
}

.conf-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.conf-fill.tone-medium {
  background: #E9A23B;
}

.conf-fill.tone-low {
  background: var(--color-error);
}

.conf-desc {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-22);
  color: #A09A90;
  line-height: 1.4;
}

.warn-banner {
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  font-size: var(--fs-24);
  line-height: 1.5;
  color: #E9A23B;
  background: rgba(233, 162, 59, 0.08);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(233, 162, 59, 0.25);
}

.photo-tips {
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(38, 35, 32, 0.8);
}

.pt-title {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-primary);
  margin-bottom: 12rpx;
  letter-spacing: 0.06em;
}

.pt-line {
  display: block;
  font-size: var(--fs-22);
  color: #A09A90;
  line-height: 1.7;
  padding-left: 2rpx;
}

.pt-line::before {
  content: '· ';
  color: #8A7530;
}

.disclaimer {
  display: block;
  margin-top: 28rpx;
  font-size: var(--fs-20);
  color: #6B6560;
  line-height: 1.5;
}

.section.science {
  margin-top: 8rpx;
}

.sec-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.sec-copy {
  flex: 1;
  min-width: 0;
}

.sec-en {
  display: block;
  font-size: var(--fs-18);
  font-weight: 500;
  letter-spacing: 0.14em;
  color: var(--color-primary);
  font-style: italic;
  margin-bottom: 6rpx;
}

.sec-title {
  display: block;
  font-size: var(--fs-30);
  font-weight: 500;
  color: #FFFFFF;
}

.sec-toggle {
  flex-shrink: 0;
  padding: 4rpx 0;
  font-size: var(--fs-22);
  color: var(--color-primary);
}

.sec-toggle-press {
  opacity: 0.7;
}

.sci-text {
  font-size: var(--fs-28);
  line-height: 1.75;
  color: #D5D1C8;
}

.sci-text.collapsed {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.sci-text.expanded {
  display: block;
}

.fun-fact {
  margin-top: 28rpx;
  padding: 24rpx 24rpx 24rpx 0;
  display: flex;
  gap: 20rpx;
  background: #262320;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--brass-800);
  overflow: hidden;
}

.ff-rule {
  width: 6rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, var(--color-primary) 0%, #8A7530 100%);
  border-radius: 0 4rpx 4rpx 0;
}

.ff-body {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.ff-label {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-primary);
  margin-bottom: 10rpx;
  letter-spacing: 0.1em;
}

.ff-text {
  font-size: var(--fs-28);
  line-height: 1.65;
  color: #D5D1C8;
}

/* ================================================================
   仪式感：鉴定结果「打字机」（2026-10-18）
   中文名墨迹晕开（字距由疏到正、0.5s）→ 学名逐字敲出（JS 控速，≤1.3s，黄铜光标闪烁）→ 敲完画标签线 → 置信度由 0 填满。
   只在刚鉴定完（fresh=1）时出现；点标本牌跳过。
   ================================================================ */
.latin-line {
  display: flex;
  align-items: baseline;
  min-height: 36rpx;
  margin-top: 10rpx;
}
.latin-line .name-latin { margin-top: 0; }
.latin-caret {
  margin-left: 2rpx;
  font-size: var(--fs-26);
  line-height: 1.35;
  color: var(--brass-400);
  animation: latin-caret-blink 0.7s steps(1) infinite;
}
@keyframes latin-caret-blink { 50% { opacity: 0; } }
.name-zh.ink-in { animation: name-ink-in 0.5s ease-out both; }
@keyframes name-ink-in {
  0% { opacity: 0; letter-spacing: 0.3em; filter: blur(3px); }
  100% { opacity: 1; letter-spacing: 0.04em; filter: blur(0); }
}
.latin-rule {
  width: 120rpx;
  height: 2rpx;
  margin-top: 12rpx;
  background: var(--brass-400);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 0.45s ease-out;
}
.latin-rule.drawn { transform: scaleX(1); }
.conf-fill { transition: width 0.8s cubic-bezier(0.2, 0.8, 0.3, 1); }
@media (prefers-reduced-motion: reduce) {
  .latin-caret,
  .name-zh.ink-in { animation: none; }
  .latin-rule,
  .conf-fill { transition: none; }
}
