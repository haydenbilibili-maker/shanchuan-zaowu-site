<!--subpackages/feature/detail/index.wxml-->
<wxs module="tool">
var calcVip = function(price, rate) {
  if (!price) return '0';
  var p = parseFloat(price);
  return (p * rate).toFixed(0);
}
module.exports.calcVip = calcVip;
// 礼赠场景 key → 中文（与 cloudfunctions/getGiftSceneProducts/giftScenes.js 同源）
var SCENE_LABELS = {
  housewarming: '乔迁', wedding: '新婚', birthday: '生日', anniversary: '纪念日',
  enrollment: '升学', graduation: '毕业', new_job: '新工作', gratitude: '致谢'
};
var sceneChips = function(list) {
  if (!list || !list.length) return [];
  var out = [];
  for (var i = 0; i < list.length && out.length < 4; i++) {
    var k = list[i];
    if (SCENE_LABELS[k]) out.push({ key: k, label: SCENE_LABELS[k] });
  }
  return out;
};
module.exports.sceneChips = sceneChips;
// 折扣标签：0.7 → 「7 折」，0.85 → 「8.5 折」（模板层算，不动 js）
var discountLabel = function(rate) {
  var r = parseFloat(rate);
  if (!r || r >= 1) return '';
  var z = Math.round(r * 100) / 10;
  return (z % 1 === 0 ? z.toFixed(0) : z.toFixed(1)) + ' 折';
};
module.exports.discountLabel = discountLabel;
// 省钱标签：原价 - 会员价（具体金额比折扣率更有说服力）；无折扣返回空串
var saveLabel = function(price, rate) {
  var p = parseFloat(price); var r = parseFloat(rate);
  if (!p || !r || r >= 1) return '';
  var save = Math.round(p - p * r);
  return save > 0 ? ('省 ¥' + save) : '';
};
module.exports.saveLabel = saveLabel;
</wxs>
<wxs src="../../../utils/latinDisplay.wxs" module="latin" />

<view class="container {{isSinglePage ? 'is-single-page' : ''}}">
  <!-- 顶部导航：滚动渐显；单页模式隐藏返回（路由不可用） -->
  <view class="nav-bar-wrap" wx:if="{{!isSinglePage}}" style="padding-top: {{statusBarHeight}}px; background: rgba(26,24,20,{{navOpacity}});">
    <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
      <nav-back ext-class="nav-icon-btn back-icon" bind:back="goBack" />
      <text class="nav-title" wx:if="{{navOpacity > 0.5}}">{{product.title}}</text>
      <view class="nav-right-group" style="padding-right: {{navPaddingRight}}px;">
        <button class="nav-icon-btn nav-share-btn" plain open-type="share" hover-class="nav-share-hover">
          <image src="/assets/icons/share.png" class="nav-action-icon" mode="aspectFit"></image>
        </button>
        <view class="nav-icon-btn nav-cart-btn" bindtap="goToCart" hover-class="nav-icon-press">
          <image src="/assets/icons/tab-cart.png" class="nav-action-icon" mode="aspectFit"></image>
          <view class="badge-solid-danger badge-sm cart-badge badge-enter" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
        </view>
        <view
          class="nav-veil-btn"
          wx:if="{{sensitiveBlurEnabled && !sensitiveVeiled}}"
          bindtap="onNavSensitiveVeil"
          hover-class="tap-press"
          hover-stay-time="80"
        >{{sensitiveBadgeLabel}}</view>
      </view>
    </view>
  </view>

  <view class="load-error-overlay" wx:if="{{loadError}}">
    <text class="load-error-title">{{loadErrorMsg || '藏品加载失败'}}</text>
    <text class="load-error-desc">请检查网络后重试，或返回馆藏继续浏览</text>
    <view class="load-error-actions">
      <view class="load-error-btn primary" bindtap="retryLoadProduct" wx:if="{{productId}}" hover-class="tap-press" hover-stay-time="80">重新加载</view>
      <view class="load-error-btn" bindtap="goBack" hover-class="tap-press" hover-stay-time="80">返回馆藏</view>
    </view>
  </view>

  <block wx:else>
  <view class="sticky-tabs {{showStickyTabs ? 'visible' : ''}}" style="top: {{statusBarHeight + navBarHeight}}px;">
    <view class="tab-item {{activeTab === 'detail' ? 'active' : ''}}" bindtap="scrollToSection" data-tab="detail" hover-class="tap-press" hover-stay-time="80">藏品</view>
    <view class="tab-item {{activeTab === 'archive' ? 'active' : ''}}" bindtap="scrollToSection" data-tab="archive" hover-class="tap-press" hover-stay-time="80">档案</view>
    <view class="tab-item {{activeTab === 'review' ? 'active' : ''}}" bindtap="scrollToSection" data-tab="review" hover-class="tap-press" hover-stay-time="80">评价<text wx:if="{{commentTotal > 0}}" class="tab-count">({{commentTotal}})</text></view>
  </view>

  <!-- 主图轮播 / 冷启动骨架 -->
  <view class="hero-wrapper">
    <block wx:if="{{detailSkeleton}}">
      <view class="detail-skel-hero skeleton" aria-hidden="true"></view>
    </block>
    <block wx:else>
    <sensitive-blur-gate
      id="sensitiveBlurGate"
      enabled="{{sensitiveBlurEnabled}}"
      product-id="{{productId}}"
      size="hero"
      show-badge="{{isSinglePage}}"
      bind:change="onSensitiveBlurChange"
    >
      <swiper wx:if="{{!heroSlides.length}}" class="hero-swiper" indicator-dots="{{imageTotal > 1}}" indicator-color="rgba(255,255,255,0.3)" indicator-active-color="#C4A76C" circular="true" bindchange="onSwiperChange">
        <block wx:for="{{product.images}}" wx:key="*this">
          <swiper-item>
            <image src="{{imgView[item] || item}}" mode="aspectFill" class="slide-image" bindtap="previewImage" data-current="{{item}}" lazy-load="{{index > 0}}" binderror="onImageDegrade"></image>
          </swiper-item>
        </block>
      </swiper>
      <!-- 视频/实况旁路：仅当商品有 media 时渲染；静音、不自动播放、不自动全屏，切走/离页即暂停 -->
      <swiper wx:else class="hero-swiper" indicator-dots="{{imageTotal > 1}}" indicator-color="rgba(255,255,255,0.3)" indicator-active-color="#C4A76C" circular="true" bindchange="onHeroMediaChange">
        <swiper-item wx:for="{{heroSlides}}" wx:key="key">
          <image wx:if="{{item.kind==='image'}}" src="{{imgView[item.src] || item.src}}" mode="aspectFill" class="slide-image" bindtap="previewImage" data-current="{{item.src}}" lazy-load="{{index > 0}}" binderror="onImageDegrade"></image>
          <video wx:else id="{{item.vid}}" class="slide-image hero-video" src="{{item.url}}" poster="{{item.poster}}" muted="{{true}}" autoplay="{{false}}" loop="{{item.kind==='live'}}" controls="{{item.kind!=='live'}}" show-center-play-btn="{{item.kind!=='live'}}" show-mute-btn="{{true}}" object-fit="contain" bindtap="onHeroLiveTap" data-vid="{{item.vid}}" data-kind="{{item.kind}}" bindplay="onHeroVideoPlay" bindpause="onHeroVideoPause" bindended="onHeroVideoPause"></video>
          <view wx:if="{{item.kind==='live'}}" class="hero-live-badge">LIVE{{heroPlaying===item.vid?'':' · 轻点播放'}}</view>
        </swiper-item>
      </swiper>
    </sensitive-blur-gate>
    <!-- 主图角标：仅合规「合法带证」；孤品由下方铜牌说明条承载，不叠图 -->
    <view class="hero-badge-stack" wx:if="{{isProtected}}">
      <protected-badge show="{{true}}" size="sm" corner="static" />
    </view>
    <view class="img-counter" wx:if="{{imageTotal > 1 && !sensitiveVeiled}}">{{imageIndex + 1}}/{{imageTotal}}</view>
    <view class="hero-overlay"></view>
    </block>
  </view>

  <!-- 核心内容区 -->
  <view class="content-body">
    <!-- 需求 28：马上有祈福墙入口 —— 头部主 SKU 商品图正下方。
         原来埋在「藏品参数之后、图文详情之前」，等于没人看得到。
         用 compact 一行版：三行卡片会把价格卡挤出首屏（本页 24rpx 侧边距由 content-body 提供）；
         间距由**宿主自己的包裹 view**给，不用组件的 ext-class —— 同一元素上组件样式与宿主样式
         撞 margin 时谁生效不保证（切片实测宿主会被组件样式吃掉）；ext-class 只留给"改皮肤"。
         判定与跳转仍收在组件里，全站拓展 = 别处再放一行同名标签。 -->
    <view class="wish-wall-slot">
      <wish-wall-entry
        enabled="{{wishWallEnabled}}"
        product="{{product}}"
        from="detail"
        compact="{{true}}"
      />
    </view>

    <!-- 价格与标题 -->
    <view class="commerce-card {{isOneOfAKind ? 'commerce-card-unique' : ''}}" id="section-detail">
      <view class="price-block">
        <block wx:if="{{!commerceReady}}">
          <view class="detail-skel-price skeleton" aria-hidden="true"></view>
          <view class="detail-skel-stock skeleton" aria-hidden="true"></view>
        </block>
        <block wx:else>
        <view class="price-row">
          <block wx:if="{{discountRate < 1}}">
            <view class="vip-box">
              <text class="symbol">VIP ¥</text>
              <text class="num">{{tool.calcVip(displayPrice, discountRate)}}</text>
            </view>
            <text class="origin">¥{{displayPrice}}{{priceFrom ? '起' : ''}}</text>
          </block>
          <block wx:else>
            <text class="symbol">¥</text>
            <text class="num">{{displayPrice}}</text>
            <text class="price-from" wx:if="{{priceFrom}}">起</text>
          </block>
          <!-- 右侧：折扣 + 库存（原先各自占行，合并后消掉两处留白） -->
          <view class="price-side">
            <text class="discount-chip" wx:if="{{discountRate < 1}}">{{tool.saveLabel(displayPrice, discountRate)}}</text>
            <text class="side-stock unique" wx:if="{{isOneOfAKind}}">{{uniqueStockLabel}}</text>
            <text class="side-stock soldout" wx:elif="{{displayStock <= 0}}">已售罄</text>
            <text class="side-stock warn" wx:elif="{{displayStock <= 2}}">仅剩 {{displayStock}} 件</text>
            <text class="side-stock" wx:elif="{{displayStock != null}}">现货 {{displayStock}} 件</text>
          </view>
        </view>
        </block>
      </view>

      <view class="unique-plate" wx:if="{{isOneOfAKind && commerceReady}}">
        <view class="unique-plate-frame">
          <view class="unique-plate-corner tl"></view>
          <view class="unique-plate-corner tr"></view>
          <view class="unique-plate-corner bl"></view>
          <view class="unique-plate-corner br"></view>
          <text class="unique-plate-kicker">{{product.isTreasure ? 'TREASURE' : 'ONE OF A KIND'}}</text>
          <text class="unique-plate-title">{{uniquePlateTitle}}</text>
          <text class="unique-plate-desc">{{uniquePlateDesc}}</text>
        </view>
      </view>

      <view class="title-block">
        <block wx:if="{{!product.title}}">
          <view class="detail-skel-title skeleton" aria-hidden="true"></view>
          <view class="detail-skel-title short skeleton" aria-hidden="true"></view>
        </block>
        <block wx:else>
        <!-- 元信息标签：品类 / 装裱 / 工艺；孤品见铜牌，合法带证见主图角标，此处不重复 -->
        <view class="tags-row" wx:if="{{product.category || (craftTags && craftTags.length)}}">
          <text class="tag-item" wx:if="{{product.category}}">{{product.category}}</text>
          <text class="tag-item" wx:for="{{craftTags}}" wx:key="key">{{item.label}}</text>
        </view>
        <text class="title-theme" wx:if="{{product.themeName}}">{{product.themeName}}</text>
        <!-- 题记：与主题名配套的一句话（送礼时它比四字名更打动人） -->
        <text class="title-main {{product.themeName ? 'is-sub' : ''}}">{{product.title}}</text>
        <text class="title-theme-note" wx:if="{{product.themeName && product.themeNote}}">{{product.themeNote}}</text>
        <text class="latin-sub" wx:if="{{latin.display(product.latinName)}}">{{latin.display(product.latinName)}}</text>
        </block>
      </view>

      <!-- 礼赠面板（坪效位）：把「这是什么」变成「适合送什么场合」+ 一键送礼 -->
      <!-- 极细分隔：信息卡与礼赠面板是两块气场，靠间距会糊在一起 -->
      <view class="card-divider" aria-hidden="true"></view>
      <view class="gift-panel" wx:if="{{product.giftEligible !== false}}">
        <view class="gift-panel-head">
          <text class="gift-panel-title">作为礼物</text>
          <text class="gift-panel-sub">可写礼笺 · 可附礼盒 · 可指定送达日</text>
        </view>
        <view class="gift-scene-row" wx:if="{{tool.sceneChips(product.giftScenes).length}}">
          <text class="gift-scene-label">适合</text>
          <view
            class="gift-scene-chip"
            wx:for="{{tool.sceneChips(product.giftScenes)}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="goGiftScene"
            hover-class="gift-scene-chip-press"
          >{{item.label}}</view>
        </view>
        <view class="gift-cta" bindtap="goGiftCompose" hover-class="tap-press-soft">一键送礼 · 写礼笺</view>
      </view>

      <!-- 服务保障 -->
      <view class="service-row">
        <view class="service-item"><text class="service-dot"></text><text>博物级装裱</text></view>
        <view class="service-item"><text class="service-dot"></text><text>正品保障</text></view>
        <view class="service-item" bindtap="openRefundSheet" hover-class="tap-press">
          <text class="service-dot"></text>
          <text>{{refundServiceLabel}}</text>
          <text class="service-more">说明</text>
        </view>
      </view>
    </view>

    <!-- 优惠券条：标签展示券面，右侧仅放操作文案，避免「可省」重复 -->
    <view class="coupon-strip" wx:if="{{showCouponStrip}}" bindtap="openCouponSheet" hover-class="coupon-strip-press" hover-stay-time="80">
      <view class="coupon-strip-label">优惠</view>
      <scroll-view scroll-x class="coupon-strip-scroll" enhanced show-scrollbar="{{false}}">
        <view class="coupon-strip-tags">
          <view class="coupon-tag" wx:for="{{couponStripTags}}" wx:key="id">{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="coupon-strip-action">{{couponHint || '查看'}} ›</view>
    </view>

    <!-- 规格 / 运费 / 数量 信息行 -->
    <view class="info-rows">
      <view class="info-row" bindtap="openSkuSheet" hover-class="info-row-press" hover-stay-time="80">
        <text class="info-label">已选</text>
        <text class="info-value">{{specSummary}}</text>
        <text class="info-arrow">›</text>
      </view>
      <view class="info-row">
        <text class="info-label">运费</text>
        <view class="info-value shipping-fee-inline {{isShippingFree ? 'gold' : ''}}">
          <text wx:if="{{showShippingStrike}}" class="shipping-fee-strike">¥{{originalShippingFeeDisplay}}</text>
          <text class="{{isShippingFree ? 'shipping-free-tag' : ''}}">{{shippingHint}}</text>
        </view>
      </view>
      <!-- 说明行：收起态只放得下一行短句；点一下展开完整规则（含承运商与"否则运费 ¥X"） -->
      <view class="info-row muted" bindtap="toggleShippingRuleDetail" hover-class="info-row-press" hover-stay-time="80">
        <text class="info-label">说明</text>
        <text class="info-value {{shippingDetailOpen ? 'open' : ''}}">{{shippingDetailOpen ? shippingRuleText : shippingRuleShort}}</text>
        <text class="info-arrow rule-arrow {{shippingDetailOpen ? 'open' : ''}}">›</text>
      </view>
    </view>

    <!-- 标本养护摘要（购前预览） -->
    <view class="care-strip" wx:if="{{showCareStrip}}" bindtap="goToCareGuide" hover-class="care-strip-press" hover-stay-time="80">
      <view class="care-strip-accent"></view>
      <image class="care-strip-icon" src="/assets/icons/care.png" mode="aspectFit"></image>
      <view class="care-strip-main">
        <text class="care-strip-overline">SPECIMEN CARE · 养护说明</text>
        <text class="care-strip-summary">{{careSummary}}</text>
        <text class="care-strip-tag" style="color: {{careCategoryColor}};">{{careCategoryLabel}}</text>
      </view>
      <text class="care-strip-cta">查看指南 →</text>
    </view>

    <!-- 品牌说明：伦理（条件）+ 1% 承诺（常驻）；默认摘要，点开展开 -->
    <view class="brand-notes">
      <view
        class="brand-note {{ethicsExpanded ? 'is-open' : ''}}"
        wx:if="{{showAnimalEthics}}"
        bindtap="toggleBrandNote"
        data-field="ethicsExpanded"
        hover-class="tap-press"
        hover-stay-time="80"
      >
        <view class="brand-note-head">
          <text class="brand-note-label">{{animalEthicsLabel}}</text>
          <text class="brand-note-chevron">›</text>
        </view>
        <text class="brand-note-summary" wx:if="{{!ethicsExpanded}}">{{animalEthicsSummary}}</text>
        <text class="brand-note-body" wx:else>{{animalEthicsNote}}</text>
      </view>
      <view
        class="brand-note {{pledgeExpanded ? 'is-open' : ''}}"
        bindtap="toggleBrandNote"
        data-field="pledgeExpanded"
        hover-class="tap-press"
        hover-stay-time="80"
      >
        <view class="brand-note-head">
          <text class="brand-note-label">{{onePercentPledgeLabel}}</text>
          <text class="brand-note-chevron">›</text>
        </view>
        <text class="brand-note-summary" wx:if="{{!pledgeExpanded}}">{{onePercentPledgeSummary}}</text>
        <text class="brand-note-body" wx:else>{{onePercentPledgeNote}}</text>
      </view>
    </view>

    <!-- 快捷功能 -->
    <view class="quick-actions">
      <view class="quick-btn" bindtap="showAR" hover-class="quick-btn-press" hover-stay-time="80">
        <image src="/assets/icons/box.png" class="quick-icon"></image>
        <text>AR 试摆</text>
      </view>
      <view class="quick-btn" bindtap="show360" hover-class="quick-btn-press" hover-stay-time="80">
        <image src="/assets/icons/trend.png" class="quick-icon"></image>
        <text>360° 鉴赏</text>
      </view>
      <view class="quick-btn" bindtap="createPoster" hover-class="quick-btn-press" hover-stay-time="80">
        <image src="/subpackages/feature/assets/icons/poster.png" class="quick-icon"></image>
        <text>知识卡</text>
      </view>
      <view class="quick-btn" bindtap="handleAudio" hover-class="quick-btn-press" hover-stay-time="80">
        <image src="/subpackages/feature/assets/icons/audio.png" class="quick-icon"></image>
        <text>讲解</text>
      </view>
    </view>

    <!-- 商品参数 -->
    <view class="section-title">PARAMETERS / 藏品参数</view>
    <view class="params-card">
      <view class="param-row"><text class="param-k">品类</text><text class="param-v">{{product.category || '—'}}</text></view>
      <view class="param-row" wx:if="{{!archiveDisplay.craftProcessEmpty}}"><text class="param-k">制作工艺</text><text class="param-v">{{archiveDisplay.craftProcess}}</text></view>
      <view class="param-row" wx:if="{{!archiveDisplay.framingEmpty}}"><text class="param-k">装裱方式</text><text class="param-v">{{archiveDisplay.framingMethod}}</text></view>
      <view class="param-row"><text class="param-k">采集地</text><text class="param-v {{archiveDisplay.originEmpty ? 'is-placeholder' : ''}}">{{archiveDisplay.origin}}</text></view>
      <view class="param-row"><text class="param-k">采集时间</text><text class="param-v {{archiveDisplay.dateEmpty ? 'is-placeholder' : ''}}">{{archiveDisplay.date}}</text></view>
      <view class="param-row"><text class="param-k">装裱尺寸</text><text class="param-v {{archiveDisplay.sizeEmpty ? 'is-placeholder' : ''}}">{{archiveDisplay.size}}</text></view>
      <view class="param-row"><text class="param-k">标本师</text><text class="param-v gold {{archiveDisplay.framerEmpty ? 'is-placeholder' : ''}}" bindtap="goToFramer" data-id="{{archiveDisplay.framerId}}">{{archiveDisplay.framerName}}</text></view>
      <view class="param-row" wx:if="{{latin.display(product.latinName)}}"><text class="param-k">拉丁学名</text><text class="param-v latin">{{latin.display(product.latinName)}}</text></view>
    </view>

    <!-- 图文详情 -->
    <view class="section-title">DETAILS / 图文详情</view>
    <view class="detail-content">
      <view class="detail-prose" wx:if="{{descriptionParagraphs.length}}">
        <view class="detail-prose-rule" aria-hidden="true"></view>
        <view
          class="detail-para {{item.isLead ? 'detail-para--lead' : 'detail-para--body'}}"
          wx:for="{{descriptionParagraphs}}"
          wx:for-item="item"
          wx:key="idx"
        >
          <text
            wx:for="{{item.segments}}"
            wx:for-item="seg"
            wx:key="i"
            class="detail-seg {{seg.kind === 'latin' ? 'detail-seg-latin' : ''}} {{seg.kind === 'book' ? 'detail-seg-book' : ''}}"
          >{{seg.t}}</text>
        </view>
      </view>
      <view class="detail-prose-divider" wx:if="{{descriptionParagraphs.length && hasDetailHtml}}"></view>
      <view class="detail-html-wrap" wx:if="{{hasDetailHtml}}">
        <mp-html
          content="{{detailHtmlContent}}"
          tag-style="{{detailTagStyle}}"
          container-style="{{detailHtmlContainerStyle}}"
          preview-img="{{true}}"
        />
      </view>
      <!-- 多规格：按规格 Tab 分类画廊，避免纵向堆叠 -->
      <view class="detail-gallery" wx:if="{{detailGalleryMode === 'sku' && detailImageGroups.length}}">
        <scroll-view class="detail-spec-tabs" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
          <view
            class="detail-spec-tab {{activeDetailGroupId === item.id ? 'active' : ''}}"
            wx:for="{{detailImageGroups}}"
            wx:key="id"
            bindtap="selectDetailGroup" hover-class="tap-press-soft" hover-stay-time="80"
            data-id="{{item.id}}"
          >{{item.label}}</view>
        </scroll-view>
        <swiper
          class="detail-spec-swiper"
          current="{{activeDetailSlide}}"
          bindchange="onDetailSwiperChange"
          indicator-dots="{{activeDetailImages.length > 1}}"
          indicator-color="rgba(160,154,144,0.35)"
          indicator-active-color="#C4A76C"
          circular="{{activeDetailImages.length > 1}}"
        >
          <swiper-item wx:for="{{activeDetailImages}}" wx:key="*this">
            <image
              class="detail-spec-slide"
              src="{{imgView[item] || item}}"
              mode="aspectFill"
              lazy-load
              hover-class="detail-img-press"
              hover-stay-time="80"
              bindtap="previewDetailImage"
              data-current="{{item}}"
              binderror="onImageDegrade"
            ></image>
          </swiper-item>
        </swiper>
        <view class="detail-spec-caption" wx:if="{{activeDetailGroupLabel || selectedSkuSizeText}}">
          <view class="detail-spec-caption-main">
            <text class="detail-spec-caption-label" wx:if="{{activeDetailGroupLabel}}">{{activeDetailGroupLabel}}</text>
            <text class="detail-spec-caption-size" wx:if="{{selectedSkuSizeText}}">{{selectedSkuSizeText}}</text>
          </view>
          <text class="detail-spec-caption-count" wx:if="{{activeDetailImages.length}}">{{activeDetailSlide + 1}}/{{activeDetailImages.length}}</text>
        </view>
        <view class="detail-shared" wx:if="{{sharedDetailImages.length}}">
          <text class="detail-shared-title">更多细节</text>
          <scroll-view class="detail-shared-scroll" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
            <image
              class="detail-shared-thumb"
              wx:for="{{sharedDetailImages}}"
              wx:key="*this"
              src="{{imgThumbView[item] || item}}"
              mode="aspectFill"
              lazy-load
              hover-class="detail-img-press"
              hover-stay-time="80"
              bindtap="previewSharedDetailImage"
              data-current="{{item}}"
              binderror="onImageDegrade"
            ></image>
          </scroll-view>
        </view>
      </view>
      <!-- 单规格 / 无规格：保持简洁纵向图文 -->
      <view class="detail-images" wx:elif="{{detailImages.length}}">
        <image
          wx:for="{{detailImages}}"
          wx:key="*this"
          src="{{imgView[item] || item}}"
          mode="widthFix"
          class="detail-img"
          hover-class="detail-img-press"
          hover-stay-time="80"
          bindtap="previewDetailImage"
          data-current="{{item}}"
          binderror="onImageDegrade"
        ></image>
      </view>
    </view>

    <!-- 档案区 -->
    <view id="section-archive">
      <view class="section-title">SPECIMEN ARCHIVES / 标本档案</view>
      <view class="archive-grid">
        <view class="archive-item {{archiveDisplay.originEmpty ? 'is-empty' : ''}}">
          <text class="lbl">采集地 ORIGIN</text>
          <text class="val {{archiveDisplay.originEmpty ? 'is-placeholder' : ''}}">{{archiveDisplay.origin}}</text>
        </view>
        <view class="archive-item {{archiveDisplay.dateEmpty ? 'is-empty' : ''}}">
          <text class="lbl">采集时间 DATE</text>
          <text class="val {{archiveDisplay.dateEmpty ? 'is-placeholder' : ''}}">{{archiveDisplay.date}}</text>
        </view>
        <view class="archive-item {{archiveDisplay.sizeEmpty ? 'is-empty' : ''}}">
          <text class="lbl">装裱尺寸 SIZE</text>
          <text class="val {{archiveDisplay.sizeEmpty ? 'is-placeholder' : ''}}">{{archiveDisplay.size}}</text>
        </view>
        <view
          class="archive-item {{archiveDisplay.framerEmpty ? 'is-empty' : 'clickable'}}"
          bindtap="goToFramer"
          data-id="{{archiveDisplay.framerId}}"
          hover-class="{{archiveDisplay.framerEmpty ? 'none' : 'archive-item-press'}}"
          hover-stay-time="80"
        >
          <text class="lbl">标本师 ARTISAN</text>
          <view class="val-row">
            <text class="val {{archiveDisplay.framerEmpty ? 'is-placeholder' : 'gold'}}">{{archiveDisplay.framerName}}</text>
            <text class="arrow" wx:if="{{!archiveDisplay.framerEmpty}}">→</text>
          </view>
        </view>
      </view>

      <view class="section-title">TAXONOMY / 科学分类</view>
      <view class="taxonomy-card" wx:if="{{product.taxonomy && (product.taxonomy.kingdom || product.taxonomy.phylum || product.taxonomy.class)}}">
        <view class="tax-row" wx:if="{{product.taxonomy.kingdom}}"><text class="k">界 Kingdom</text><text class="v">{{product.taxonomy.kingdom}}</text></view>
        <view class="tax-row" wx:if="{{product.taxonomy.phylum}}"><text class="k">门 Phylum</text><text class="v">{{product.taxonomy.phylum}}</text></view>
        <view class="tax-row" wx:if="{{product.taxonomy.class}}"><text class="k">纲 Class</text><text class="v">{{product.taxonomy.class}}</text></view>
        <view class="tax-row" wx:if="{{product.taxonomy.order}}"><text class="k">目 Order</text><text class="v">{{product.taxonomy.order}}</text></view>
        <view class="tax-row" wx:if="{{product.taxonomy.family}}"><text class="k">科 Family</text><text class="v">{{product.taxonomy.family}}</text></view>
        <view class="tax-row" wx:if="{{product.taxonomy.genus}}"><text class="k">属 Genus</text><text class="v">{{product.taxonomy.genus}}</text></view>
        <view class="tax-row highlight" wx:if="{{latin.display(product.latinName)}}"><text class="k">种 Species</text><text class="v">{{latin.display(product.latinName)}}</text></view>
      </view>
      <view class="taxonomy-card" wx:elif="{{product.category}}">
        <view class="tax-row highlight"><text class="k">分类 Category</text><text class="v">{{product.rootCategoryName ? product.rootCategoryName + ' · ' : ''}}{{product.category}}</text></view>
        <view class="tax-row highlight" wx:if="{{latin.display(product.latinName)}}"><text class="k">种 Species</text><text class="v">{{latin.display(product.latinName)}}</text></view>
      </view>
      <view class="taxonomy-empty" wx:else>
        <text class="muted">暂无科学分类信息</text>
      </view>

      <block wx:if="{{showProtectionCert}}">
        <view class="section-title">PROVENANCE / 来源说明</view>
        <view class="cert-card" bindtap="previewCertificate" hover-class="tap-press-soft" hover-stay-time="80">
          <view class="cert-badge">{{protectionLabel}}</view>
          <view class="cert-body">
            <image class="cert-image" src="{{certificateUrl}}" mode="widthFix" />
            <view class="cert-footer">
              <text class="cert-tip">本藏品随附来源与合规文件（见下图）</text>
              <text class="cert-action">点击查看大图 →</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 相关推荐 -->
    <block wx:if="{{recommends.length}}">
      <view class="section-title">RELATED / 相关推荐</view>
      <scroll-view class="recommend-scroll" scroll-x="true" enable-flex="true">
        <block wx:for="{{recommends}}" wx:key="_id">
          <view class="rec-card" bindtap="goToDetail" data-id="{{item._id}}" hover-class="rec-card-hover">
            <view class="rec-img-wrap">
              <sensitive-blur-gate
                enabled="{{item.sensitiveBlur}}"
                product-id="{{item._id}}"
                size="thumb"
              >
                <image src="{{imgThumbView[item.images[0] || item.image || item.httpImage] || item.images[0] || item.image || item.httpImage}}" mode="aspectFill" lazy-load binderror="onImageDegrade"></image>
              </sensitive-blur-gate>
              <protected-badge product="{{item}}" size="xs" corner="bl" />
            </view>
            <text class="rec-name">{{item.title}}</text>
            <view class="rec-craft-tags" wx:if="{{item.craftTags && item.craftTags.length}}">
              <text class="rec-craft-tag" wx:for="{{item.craftTags}}" wx:for-item="ctag" wx:key="key">{{ctag.label}}</text>
            </view>
            <text class="rec-price">¥{{item.price}}</text>
          </view>
        </block>
      </scroll-view>
    </block>

    <!-- 用户评价 -->
    <view class="comment-section" id="section-review">
      <view class="comment-header">
        <view class="section-title inline">REVIEWS / 用户评价</view>
        <view class="comment-action muted" wx:if="{{product._id}}">
          <text>签收后可在订单中评价</text>
        </view>
      </view>
      <comment-list
        wx:if="{{product._id}}"
        target-type="product"
        target-id="{{product._id}}"
        show-stats="{{true}}"></comment-list>
      <view class="comment-empty-hint" wx:else>
        <text>{{detailSkeleton || !commerceReady ? '同步档案…' : '加载中…'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏：朋友圈单页隐藏交互 CTA（平台底部已有「前往小程序」） -->
  <view class="bottom-bar safe-area" wx:if="{{!isSinglePage}}">
    <view class="bottom-icons">
      <view class="icon-btn" bindtap="goToSupport" hover-class="icon-btn-press" hover-stay-time="80">
        <image class="bar-icon" src="/assets/icons/message.png" mode="aspectFit"></image>
        <text class="bar-txt">客服</text>
      </view>
      <view class="icon-btn" bindtap="goToCart" hover-class="icon-btn-press" hover-stay-time="80">
        <image class="bar-icon" src="/assets/icons/tab-cart.png" mode="aspectFit"></image>
        <text class="bar-txt">购物车</text>
        <view class="badge-solid-danger badge-sm bar-badge badge-enter" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
      </view>
      <!-- 有货：轻量「收藏」；售罄：心愿语义位留给「想要」候补 -->
      <view
        wx:if="{{commerceReady && displayStock > 0}}"
        class="icon-btn {{inFavorite ? 'active' : ''}}"
        bindtap="toggleFavorite"
        hover-class="icon-btn-press"
        hover-stay-time="80"
      >
        <image class="bar-icon {{inFavorite ? 'wish-on' : ''}}" src="{{inFavorite ? '/assets/icons/star-active.png' : '/assets/icons/star.png'}}" mode="aspectFit"></image>
        <text class="bar-txt">{{inFavorite ? '已藏' : '收藏'}}</text>
      </view>
      <view
        wx:elif="{{commerceReady}}"
        class="icon-btn {{inWishlist ? 'active' : ''}}"
        bindtap="toggleWishlist"
        hover-class="icon-btn-press"
        hover-stay-time="80"
      >
        <image class="bar-icon {{inWishlist ? 'wish-on' : ''}}" src="/assets/icons/heart.png" mode="aspectFit"></image>
        <text class="bar-txt">{{inWishlist ? '已想要' : '想要'}}</text>
      </view>
      <view wx:else class="icon-btn" aria-hidden="true">
        <view class="detail-skel-icon skeleton"></view>
        <text class="bar-txt"> </text>
      </view>
    </view>
    <view class="bottom-cta" wx:if="{{product._id && commerceReady && (displayStock <= 0 || canPayBalance)}}">
      <!-- 无缓存时同高度占位，避免先闪默认「到货通知/付定金」再跳到已候补/继续付定金 -->
      <block wx:if="{{!engagementReady && displayStock <= 0}}">
        <view class="wishlist-cta cta-skel" aria-hidden="true">
          <view class="cta-skel-line cta-skel-main"></view>
          <view class="cta-skel-line cta-skel-sub"></view>
        </view>
        <view class="deposit-cta cta-skel" wx:if="{{showDepositCta || canPayBalance}}" aria-hidden="true">
          <view class="cta-skel-line cta-skel-main"></view>
          <view class="cta-skel-line cta-skel-sub"></view>
        </view>
      </block>
      <block wx:else>
        <!-- 主 CTA 用到货通知语义，与左侧心形「想要」区分 -->
        <view class="wishlist-cta {{inWishlist ? 'on' : ''}}" bindtap="toggleWishlist" wx:if="{{displayStock <= 0}}" hover-class="cta-press" hover-stay-time="80">
          <text class="btn-main">{{inWishlist ? '已候补' : '到货通知'}}</text>
          <text class="btn-wish-sub">优先提醒</text>
        </view>
        <view
          class="deposit-cta {{depositStatus === 'deposit_paid' || depositStatus === 'settled' ? 'on' : ''}}"
          wx:if="{{showDepositCta || canPayBalance}}"
          bindtap="handleDeposit"
          hover-class="cta-press"
          hover-stay-time="80"
        >
          <text class="btn-main">
            <block wx:if="{{canPayBalance || depositStatus === 'awaiting_balance'}}">付尾款</block>
            <block wx:elif="{{depositStatus === 'deposit_paid'}}">已付定金</block>
            <block wx:elif="{{depositStatus === 'settled'}}">已付清</block>
            <block wx:elif="{{depositStatus === 'pending_pay' || canPayDeposit}}">继续付定金</block>
            <block wx:else>付定金</block>
          </text>
          <text class="btn-wish-sub">
            <block wx:if="{{canPayBalance || depositStatus === 'awaiting_balance'}}">定金抵扣·付清余款</block>
            <block wx:elif="{{depositStatus === 'deposit_paid'}}">上架后付尾款</block>
            <block wx:elif="{{depositStatus === 'settled'}}">本单已完成</block>
            <block wx:elif="{{depositStatus === 'pending_pay' || canPayDeposit}}">未完成可继续</block>
            <block wx:else>优先制作·逾期不退</block>
          </text>
        </view>
      </block>
    </view>
    <view class="bottom-cta" wx:elif="{{product._id && commerceReady}}">
      <view class="custom-btn" bindtap="goToCustom" wx:if="{{showSpecimenCustom}}" hover-class="cta-press" hover-stay-time="80">
        <text class="btn-sub">定制</text>
      </view>
      <view class="gift-btn" bindtap="goToGift" wx:if="{{showGift && product.giftEligible !== false}}" hover-class="cta-press" hover-stay-time="80">
        <text class="btn-sub">送 TA</text>
      </view>
      <view class="add-cart-btn" bindtap="handleBuy" hover-class="cta-press" hover-stay-time="80">
        <text class="btn-sub">加购物车</text>
      </view>
      <view class="buy-now-btn" bindtap="handleBuyNow" hover-class="buy-now-btn-press" hover-stay-time="80">
        <text class="btn-main">立即购买</text>
      </view>
    </view>
  </view>

  <!-- 积分提示 -->
  <view class="point-toast {{showPointTip ? 'active' : ''}}">
    <view class="pt-icon">✦</view>
    <text class="pt-text">{{pointTipText}}</text>
  </view>

  <!-- 360 鉴赏弹窗 -->
  <view class="mask-360" wx:if="{{show360Modal}}" bindtap="close360">
    <view class="box-360"
          catchtap="true"
          catchtouchstart="on360TouchStart"
          catchtouchmove="on360TouchMove"
          catchtouchend="on360TouchEnd">
      <view class="tip-360">360° INTERACTIVE</view>
      <view class="spinner-3d"
            style="transform: rotateX({{rotateX}}deg) rotateY({{rotateY}}deg); transition: {{transition}};">
        <!-- 走 imgView 映射：映射值 = 追加 imageMogr2 的 https 链（此前直绑 cloud:// 渲染不出） -->
        <image src="{{imgView[product.images[0]] || product.images[0]}}" mode="aspectFill"></image>
        <view class="spinner-back"></view>
      </view>
      <view class="hint-360">左右/上下滑动以鉴赏细节</view>
    </view>
  </view>

  <!-- SKU 规格选择 -->
  <view class="sku-mask" wx:if="{{showSkuSheet}}" bindtap="closeSkuSheet">
    <view class="sku-panel" catchtap="true">
      <view class="sku-head">
        <view class="sku-img-wrap" catchtap="previewSkuImage" hover-class="tap-press-soft" hover-stay-time="80">
          <image class="sku-img" src="{{imgView[selectedSku.image || product.images[0]] || selectedSku.image || product.images[0]}}" mode="aspectFill"></image>
          <view class="sku-img-hint" aria-hidden="true">
            <image class="sku-img-hint-icon" src="/subpackages/feature/detail/assets/sku-zoom.png" mode="aspectFit"></image>
          </view>
        </view>
        <view class="sku-meta">
          <text class="sku-price">¥{{displayPrice}}</text>
          <text class="sku-stock">库存 {{displayStock}}</text>
          <text class="sku-selected">已选：{{specSummary}}</text>
          <text class="sku-shipping">
            <text wx:if="{{showShippingStrike}}" class="shipping-fee-strike">¥{{originalShippingFeeDisplay}} </text>
            <text class="{{isShippingFree ? 'shipping-free-tag' : ''}}">{{shippingHint}}</text>
          </text>
        </view>
        <text class="sku-close" bindtap="closeSkuSheet" hover-class="cta-press" hover-stay-time="80">✕</text>
      </view>
      <block wx:if="{{hasSku && product.skuDimensions && product.skuDimensions.length}}">
        <view class="sku-section" wx:for="{{dimensionOptions}}" wx:key="name">
          <text class="sku-label">{{item.name}}</text>
          <view class="sku-options">
            <view
              class="sku-pill {{selectedSpecs[item.name] === val.value ? 'active' : ''}} {{val.disabled ? 'soldout' : ''}}"
              wx:for="{{item.values}}"
              wx:for-item="val"
              wx:key="value"
              bindtap="selectDimension"
              hover-class="cta-press"
              hover-stay-time="80"
              data-dim="{{item.name}}"
              data-value="{{val.value}}"
            >{{val.value}}</view>
          </view>
        </view>
      </block>
      <view class="sku-section" wx:elif="{{hasSku}}">
        <text class="sku-label">规格</text>
        <view class="sku-options">
          <view
            class="sku-pill {{selectedSkuId === item.id ? 'active' : ''}} {{item.stock <= 0 ? 'soldout' : ''}}"
            wx:for="{{product.skus}}"
            wx:key="id"
            bindtap="selectSku"
            hover-class="cta-press"
            hover-stay-time="80"
            data-id="{{item.id}}"
          >{{item.specLabel}}</view>
        </view>
      </view>
      <view class="sku-size-row" wx:if="{{hasSku && selectedSkuSizeText}}">
        <text class="sku-size-k">尺寸</text>
        <text class="sku-size-v">{{selectedSkuSizeText}}</text>
      </view>
      <view class="sku-section qty-section">
        <text class="sku-label">数量</text>
        <view class="qty-stepper">
          <view class="qty-btn {{buyCount <= 1 ? 'disabled' : ''}}" bindtap="changeBuyCount" data-delta="-1" hover-class="cta-press" hover-stay-time="80">−</view>
          <text class="qty-num">{{buyCount}}</text>
          <view class="qty-btn {{buyCount >= displayStock ? 'disabled' : ''}}" bindtap="changeBuyCount" data-delta="1" hover-class="cta-press" hover-stay-time="80">+</view>
        </view>
      </view>
      <view class="sku-confirm" bindtap="confirmSkuAction" hover-class="sku-confirm-press" hover-stay-time="80">{{skuConfirmText}}</view>
    </view>
  </view>

  <!-- 优惠券弹层 -->
  <view class="coupon-mask" wx:if="{{showCouponSheet}}" bindtap="closeCouponSheet">
    <view class="coupon-panel" catchtap="true">
      <view class="coupon-panel-head">
        <text>礼券</text>
        <text class="sku-close" bindtap="closeCouponSheet" hover-class="cta-press" hover-stay-time="80">✕</text>
      </view>
      <scroll-view scroll-y class="coupon-panel-body" enhanced show-scrollbar="{{false}}" enable-flex="{{true}}">
        <view class="coupon-section-title" wx:if="{{claimableCoupons.length}}">可领取</view>
        <view class="coupon-card" wx:for="{{claimableCoupons}}" wx:key="_id">
          <view class="coupon-card-left">
            <text class="coupon-card-value">{{item.label}}</text>
            <text class="coupon-card-title">{{item.title}}</text>
          </view>
          <view
            class="coupon-card-btn {{item.claimed ? 'claimed' : ''}}"
            bindtap="claimCoupon"
            data-id="{{item._id}}"
            data-claimed="{{item.claimed}}"
            hover-class="{{item.claimed ? 'none' : 'cta-press'}}"
            hover-stay-time="80"
          >{{item.claimed ? '已领取' : '领取'}}</view>
        </view>

        <view class="coupon-section-title" wx:if="{{bestCoupon}}">本单推荐</view>
        <view class="coupon-card active" wx:if="{{bestCoupon}}">
          <view class="coupon-card-left">
            <text class="coupon-card-value">{{bestCoupon.label}}</text>
            <text class="coupon-card-title">{{bestCoupon.title}} · 可省 ¥{{couponSavedLabel}}</text>
          </view>
          <view class="coupon-card-btn claimed">已拥有</view>
        </view>

        <view class="coupon-empty" wx:if="{{!claimableCoupons.length && !bestCoupon}}">
          <text>暂无可用礼券</text>
        </view>
      </scroll-view>
      <view class="coupon-panel-foot">
        <view class="coupon-link-btn" bindtap="goToCoupons" hover-class="cta-press" hover-stay-time="80">我的礼券夹</view>
        <view class="coupon-buy-btn" bindtap="buyNowWithCoupon" hover-class="cta-press" hover-stay-time="80">立即购买</view>
      </view>
    </view>
  </view>

  <coupon-print-mint
    visible="{{showCouponPrint}}"
    title="{{printCoupon.title}}"
    value="{{printCoupon.value}}"
    minSpend="{{printCoupon.minSpend}}"
    expireDate="{{printCoupon.expireDate}}"
    channel="{{printCoupon.channel}}"
    bind:close="closeCouponPrint"
    bind:gowallet="goWalletFromPrint"
  />

  <!-- 海报弹窗 -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>
  <view class="poster-modal" wx:if="{{showPosterModal}}" bindtap="closePosterModal">
    <view class="poster-container" catchtap="true">
      <view class="close-icon-out" bindtap="closePosterModal" hover-class="cta-press" hover-stay-time="80">✕</view>
      <image src="{{posterImage}}" mode="widthFix" class="generated-img"></image>
      <view class="poster-btns"><button class="save-btn" bindtap="savePoster">保存知识卡</button></view>
    </view>
  </view>

  <view class="refund-sheet-mask" wx:if="{{showRefundSheet}}" bindtap="closeRefundSheet" catchtouchmove="true">
    <view class="refund-sheet" catchtap="true">
      <text class="refund-sheet-title">退款说明</text>
      <view class="refund-sheet-body">
        <view class="refund-sheet-para" wx:for="{{refundNoticeRichParagraphs}}" wx:for-item="para" wx:key="idx">
          <text
            wx:for="{{para.segments}}"
            wx:for-item="seg"
            wx:key="i"
            class="refund-sheet-seg {{seg.warn ? 'is-warn' : ''}} {{seg.em ? 'is-em' : ''}} {{seg.strong ? 'is-strong' : ''}}"
          >{{seg.t}}</text>
        </view>
      </view>
      <view class="refund-sheet-btn" bindtap="closeRefundSheet" hover-class="cta-press" hover-stay-time="80">知道了</view>
    </view>
  </view>
  </block>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal）；详见 utils/appModal.js -->
<app-modal id="appModal" />
