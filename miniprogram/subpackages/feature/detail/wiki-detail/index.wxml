<!--subpackages/feature/detail/wiki-detail.wxml-->
<wxs src="../../../../utils/latinDisplay.wxs" module="latin" />
<view class="container">

  <view class="load-error-overlay" wx:if="{{loading}}">
    <text class="load-error-desc">读取档案中…</text>
  </view>

  <view class="load-error-overlay" wx:elif="{{loadError}}">
    <text class="load-error-title">档案加载失败</text>
    <text class="load-error-desc">内容不存在或网络异常，请重试</text>
    <view class="load-error-actions">
      <view class="load-error-btn primary" bindtap="retryLoad" wx:if="{{wikiId}}" hover-class="tap-press" hover-stay-time="80">重新加载</view>
      <view class="load-error-btn" bindtap="goBack" hover-class="tap-press" hover-stay-time="80">返回馆藏</view>
    </view>
  </view>

  <block wx:else>
  <!--
    注册门禁（2026-09-17）：未登录/未注册态**整页灰色模糊**，且**不提供「再看看」**。
    为什么在页面上模糊而不是只弹窗：内容在弹窗后面已经可见时，弹窗只是「提示」；
    摸清后才算门禁。模糊用 filter（与 sensitive-blur-gate 同一手法），
    并 pointer-events:none 防止隔着模糊层点到商品/购买。
  -->
  <view class="wd-gate {{registerGated ? 'is-gated' : ''}}">
  <!-- 1. 沉浸式 Header -->
  <view class="hero-area">
    <image class="hero-img" src="{{wiki.coverImage || fallbackImg}}" mode="aspectFill"></image>
    <view class="hero-overlay"></view>
    
    <view class="hero-text">
      <!-- 区分显示：如果是标本，显示拉丁名；如果是专题，显示副标题或日期 -->
      <text class="latin-lg" wx:if="{{wiki.type !== 'exhibition' && latin.display(wiki.latinName)}}">{{latin.display(wiki.latinName)}}</text>
      <text class="latin-lg" wx:elif="{{wiki.type === 'exhibition'}}">{{latin.display(wiki.latinName) || wiki.subtitle || 'CURATED EXHIBITION'}}</text>
      
      <text class="name-lg">{{wiki.commonName || wiki.title}}</text>
      
      <!-- 仅标本显示分类学（有数据才显示，避免假分类） -->
      <view class="taxonomy-row" wx:if="{{wiki.type !== 'exhibition' && wiki.taxonomy}}">
         <text class="tax-tag" wx:if="{{wiki.taxonomy.kingdom}}">{{wiki.taxonomy.kingdom}}</text>
         <text class="divider" wx:if="{{wiki.taxonomy.kingdom && wiki.taxonomy.class}}">/</text>
         <text class="tax-tag" wx:if="{{wiki.taxonomy.class}}">{{wiki.taxonomy.class}}</text>
      </view>
    </view>
  </view>

  <!-- 2. 正文内容 -->
  <view class="article-body">
    
    <!-- 导语/摘要 -->
    <view class="intro-text" wx:if="{{wiki.brief}}">
      <text>“{{wiki.brief}}”</text>
    </view>

    <view class="wiki-archive" wx:if="{{protectionTags.length || archiveRows.length}}">
      <view class="wiki-prot" wx:if="{{protectionTags.length}}">
        <text class="wiki-archive-label">保护等级</text>
        <view class="wiki-prot-tags">
          <view class="wiki-prot-tag" wx:for="{{protectionTags}}" wx:key="label">
            <text class="wiki-prot-sys">{{item.system}}</text>
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="wiki-archive-row" wx:for="{{archiveRows}}" wx:key="title">
        <text class="wiki-archive-label">{{item.title}}</text>
        <text class="wiki-archive-text">{{item.text}}</text>
      </view>
    </view>

    <!-- 画廊 (标本模式显示) -->
    <scroll-view scroll-x class="gallery-scroll" wx:if="{{wiki.type !== 'exhibition' && wiki.gallery && wiki.gallery.length > 0}}">
      <block wx:for="{{wiki.gallery}}" wx:key="*this">
        <view class="gallery-item" bindtap="previewImage" data-src="{{item}}">
           <image src="{{item}}" mode="aspectFill" lazy-load></image>
        </view>
      </block>
    </scroll-view>

    <!-- 富文本内容 (通用) -->
    <view class="rich-text-container">
      <mp-html 
        content="{{articleContent}}" 
        tag-style="{{tagStyle}}" 
        container-style="color:#D5D1C8;"
      />
    </view>

  </view>

  <!-- 3. 关联藏品 -->
  <view class="commerce-float" wx:if="{{displayProducts.length > 0}}">
    <view class="commerce-title">
      <text>{{ usingAlternative ? 'CATEGORY PICKS' : (wiki.type === 'exhibition' ? 'FEATURED ITEMS' : 'RELATED COLLECTION') }}</text>
      <text class="sub">{{ usingAlternative ? '关联藏品暂不可购，同品类推荐' : (wiki.type === 'exhibition' ? '展品列表' : '馆藏关联') }}</text>
    </view>

    <block wx:for="{{displayProducts}}" wx:key="_relatedKey">
      <view class="product-card-mini" bindtap="goToProduct" data-id="{{item._id}}" data-skuid="{{item.relatedSkuId}}" hover-class="tap-press-soft" hover-stay-time="80">
        <!-- 需求 11：敏感形态模糊 -->
        <!-- ⚠️ 图盒必须自建且**已定位**（.p-thumb-box）：门控组件 :host 是 position:absolute，
             而 .product-card-mini 是 display:flex 且未定位 → 缺此盒封面会被裁掉。 -->
        <view class="p-thumb-box">
          <sensitive-blur-gate
            enabled="{{item.sensitiveEnabled}}"
            product-id="{{item._id}}"
            size="thumb"
          >
            <image src="{{item.images[0] || item.image || item.httpImage}}" mode="aspectFill" class="p-thumb" lazy-load></image>
          </sensitive-blur-gate>
        </view>
        <view class="p-info">
          <text class="p-name">{{item.title}}</text>
          <text class="p-sku" wx:if="{{item.relatedSkuLabel}}">{{item.relatedSkuLabel}}</text>
          <text class="p-latin" wx:elif="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
          <view class="p-craft-tags" wx:if="{{item.craftTags && item.craftTags.length}}">
            <text class="p-craft-tag" wx:for="{{item.craftTags}}" wx:for-item="ctag" wx:key="key">{{ctag.label}}</text>
          </view>
          <text class="p-price">¥{{item.price}}</text>
        </view>
        <view class="btn-buy">选购</view>
      </view>
    </block>
  </view>

  <view class="notes-section" wx:if="{{wiki.type === 'exhibition' && relatedArticles.length > 0}}">
    <view class="notes-head">
      <text class="notes-overline">EXHIBITION NOTES</text>
      <text class="notes-title">专题笔记</text>
    </view>
    <view
      class="notes-item"
      wx:for="{{relatedArticles}}"
      wx:key="_id"
      hover-class="tap-press-soft"
      bindtap="goToRelatedArticle"
      data-id="{{item._id}}"
    >
      <image class="notes-cover" src="{{item.coverImage || fallbackImg}}" mode="aspectFill" lazy-load></image>
      <view class="notes-meta">
        <text class="notes-name">{{item.title}}</text>
        <text class="notes-brief" wx:if="{{item.brief}}">{{item.brief}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar safe-area" wx:if="{{primaryProduct}}">
    <view class="bottom-price">
      <text class="bp-label">馆藏价</text>
      <text class="bp-num">¥{{primaryProduct.price}}</text>
    </view>
    <view class="bottom-buy" bindtap="handleBuyNow" hover-class="bottom-buy-press" hover-stay-time="80">立即购买</view>
  </view>

  <view style="height: 140rpx;"></view>
  </view>

  <!-- 门禁弹窗：给「先不注册」拒绝出口（关掉即离开本页，不解模糊）；点遮罩不关，只认按钮 -->
  <register-auth-dialog
    show="{{registerGated}}"
    overline="SPECIES ARCHIVE"
    title="注册后查看完整档案"
    desc="这是为收藏者准备的物种档案。一键注册即可解锁全文，并把它存进你的山海图鉴。"
    cta="一键注册"
    closable="{{true}}"
    close-text="先不注册"
    mask-closable="{{false}}"
    from="wiki_detail"
    bind:success="onRegisterSuccess"
    bind:close="onRegisterDialogClose"
  />
  </block>
</view>