/* subpackages/feature/detail/index.wxss */
@import "../../../styles/badges.wxss";

/* 1. 全局容器控制：彻底防止左右溢出 */
page {
  background-color: var(--color-bg);
  color: var(--color-text-body);
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  width: 100%;
  overflow-x: hidden; /* 🔴 核心：禁止横向滚动 */
  
  /* 🔴 核心：底部留白 = 底部栏高度 + 安全区 + 间距 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 朋友圈单页：无自建底栏，留白交给微信「前往小程序」 */
.container.is-single-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

view, text, image { box-sizing: border-box; }

.load-error-overlay {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
  gap: 16rpx;
}

.load-error-title {
  color: var(--color-text-primary);
  font-size: 34rpx;
  font-weight: 500;
}

.load-error-desc {
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.load-error-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 480rpx;
}

.load-error-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 1px solid var(--gold);
  color: var(--gold);
  font-size: 28rpx;
}

.load-error-btn.primary {
  background: var(--gold);
  color: var(--color-bg);
  border: none;
}

/* 冷启动骨架：非 modal，Museum 黄铜微光 */
.detail-skel-hero {
  width: 100%;
  height: 100%;
  border-radius: 0;
}
.detail-skel-price {
  width: 220rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
}
.detail-skel-stock {
  width: 160rpx;
  height: 28rpx;
}
.detail-skel-title {
  width: 86%;
  height: 40rpx;
  margin-bottom: 16rpx;
}
.detail-skel-title.short {
  width: 52%;
  height: 28rpx;
  margin-bottom: 0;
}
.detail-skel-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  margin: 0 auto 4rpx;
}

/* 顶部导航 */
.nav-bar-wrap {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 120;
  transition: background 0.2s;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 0 12px;
  box-sizing: border-box;
}
.nav-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0 12px;
}
.nav-right-group {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  margin-left: auto;
  box-sizing: border-box;
}

/* 导航圆形按钮 — 使用 px 与胶囊对齐，分享按钮须 plain + 重置默认 min-height */
.nav-icon-btn {
  width: 32px;
  height: 32px;
  min-width: 32px;
  min-height: 32px;
  max-width: 32px;
  max-height: 32px;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 0;
  box-sizing: border-box;
  background: rgba(31, 29, 26, 0.88);
  border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: visible;
  flex-shrink: 0;
}
.nav-icon-btn:active,
.nav-icon-press { opacity: 0.78; }

button.nav-share-btn {
  /* 覆盖微信 button 默认样式，防止撑成大椭圆 */
  padding: 0;
  margin: 0;
  min-height: 32px;
  line-height: 32px;
  font-weight: normal;
  color: inherit;
  background: rgba(31, 29, 26, 0.88);
}
button.nav-share-btn::after { display: none; border: none; }
.nav-share-hover { background: rgba(196, 167, 108, 0.25) !important; opacity: 1; }

.nav-action-icon {
  width: 18px;
  height: 18px;
  display: block;
  filter: brightness(0) invert(1);
  opacity: 0.92;
  pointer-events: none;
}

/* 敏感形态「掩上/已启视」— 与分享/购物车同列，靠 navPaddingRight 避让胶囊 */
.nav-veil-btn {
  height: 32px;
  min-height: 32px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--gold);
  background: rgba(26, 24, 20, 0.82);
  border: 1px solid rgba(196, 167, 108, 0.45);
  border-radius: 8rpx;
  white-space: nowrap;
}
.nav-veil-press {
  opacity: 0.82;
}

.cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  /* 视觉走全局 .badge-solid-danger；此处只负责定位 */
  z-index: 1;
}

/* 吸顶 Tab */
.sticky-tabs {
  position: fixed;
  left: 0;
  width: 100%;
  z-index: 110;
  display: flex;
  background: rgba(26,24,20,0.96);
  border-bottom: 1px solid rgba(38,35,32,0.8);
  transform: translateY(-100%);
  opacity: 0;
  transition: transform 0.25s, opacity 0.25s;
  backdrop-filter: blur(12px);
}
.sticky-tabs.visible { transform: translateY(0); opacity: 1; }
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--color-text-muted);
  position: relative;
}
.tab-item.active { color: var(--gold); font-weight: 500; }
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--gold);
  border-radius: 2rpx;
}
.tab-count { font-size: 22rpx; margin-left: 4rpx; }

.back-icon {
  flex-shrink: 0;
  background: transparent !important;
  border-color: transparent !important;
  min-width: 36px !important;
  min-height: 36px !important;
  width: 36px !important;
  height: 36px !important;
  max-width: 36px !important;
  max-height: 36px !important;
}
.back-icon .page-nav-back-icon {
  width: 28px;
  height: 28px;
}

/* Hero 轮播 */
.hero-wrapper { position: relative; width: 100%; height: 750rpx; margin-top: 0; }
.hero-wrapper .sb-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}
.hero-swiper { width: 100%; height: 100%; }
.slide-image { width: 100%; height: 100%; }
.img-counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 4;
  background: rgba(26, 24, 20, 0.72);
  color: var(--color-text-body);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 9999px;
}
/* 主图左下：仅合规角标，避开状态栏与返回键 */
.hero-badge-stack {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: calc(100% - 160rpx);
  pointer-events: none;
}
.hero-wrapper .sb-wrap {
  z-index: 6;
}
.hero-overlay {
  position: absolute; bottom: 0; left: 0; width: 100%; height: 30%;
  background: linear-gradient(to bottom, transparent, var(--color-bg));
  pointer-events: none;
  z-index: 2;
}

/* 内容区 */
.content-body {
  padding: 0 24rpx;
  position: relative;
  z-index: 3;
  width: 100%;
}

/* 需求 28：祈福墙入口（头部主图下方）。
   间距作用在**宿主自己的包裹 view** 上（不是组件的 ext-class）：同一元素上组件样式与
   宿主样式都设 margin 时谁生效不保证 —— 切片实测宿主的 margin-top 会被组件样式吃掉。
   一条规则同时给上下间距；主图底部有 30% 高的渐隐（.hero-overlay），
   24rpx 的落点正好在"图化入背景"那一段的下方。 */
.wish-wall-slot {
  margin: 24rpx 0;
}

/* 电商主卡片 */
.commerce-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1px solid rgba(38,35,32,0.8);
  margin-bottom: 24rpx;
}
.commerce-card-unique {
  border-color: rgba(77, 64, 26, 0.95);
  background:
    linear-gradient(135deg, rgba(196, 167, 108, 0.06) 0%, transparent 42%),
    var(--color-bg-card);
}
.price-block { margin-bottom: 24rpx; }
.stock-row { margin-top: 8rpx; }
.stock-label { font-size: 22rpx; color: var(--color-text-secondary); }
.stock-label.warn { color: #E9A23B; }
.stock-label.soldout { color: #D64045; }
.stock-label.unique {
  color: var(--gold);
  letter-spacing: 0.04em;
}

.unique-plate {
  margin-bottom: 28rpx;
}
.unique-plate-frame {
  position: relative;
  padding: 28rpx 32rpx 24rpx;
  border: 1px solid rgba(196, 167, 108, 0.45);
  background: linear-gradient(160deg, rgba(196, 167, 108, 0.1) 0%, rgba(31, 29, 26, 0.95) 55%);
  border-radius: 8rpx;
}
.unique-plate-frame::before {
  content: '';
  position: absolute;
  inset: 6rpx;
  border: 1px solid rgba(196, 167, 108, 0.22);
  border-radius: 4rpx;
  pointer-events: none;
}
.unique-plate-corner {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold);
  opacity: 0.75;
  z-index: 1;
}
.unique-plate-corner.tl { top: 10rpx; left: 10rpx; }
.unique-plate-corner.tr { top: 10rpx; right: 10rpx; }
.unique-plate-corner.bl { bottom: 10rpx; left: 10rpx; }
.unique-plate-corner.br { bottom: 10rpx; right: 10rpx; }
.unique-plate-kicker {
  display: block;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 0.18em;
  color: #8A7530;
  margin-bottom: 10rpx;
}
.unique-plate-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.16em;
  margin-bottom: 12rpx;
  font-family: "Source Han Serif SC", "Noto Serif SC", Georgia, serif;
}
.unique-plate-desc {
  display: block;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.title-block { margin-bottom: 24rpx; }
.tags-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.tag-item {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  font-size: 20rpx;
  background: rgba(196, 167, 108, 0.12);
  color: var(--gold);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(196, 167, 108, 0.35);
  white-space: nowrap;
  box-sizing: border-box;
  letter-spacing: 0.04em;
}
/* 主题名（双层命名的第一层）：详情页做主视觉，标准名降为副行 */
.title-theme {
  display: block;
  font-size: 46rpx;
  font-weight: 600;
  color: var(--color-text-primary, #F5F2EC);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
/* 题记：衬线小字 + 左金线，像展签上的一行说明 */
.title-theme-note {
  display: block;
  margin: 6rpx 0 14rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--brass-800, rgba(196, 167, 108, 0.55));
  font-size: 24rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--color-text-secondary, #A09A90);
}
.title-main.is-sub {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--color-text-secondary, #A09A90);
}
.title-main { font-size: 36rpx; font-weight: 600; color: var(--color-text-primary); line-height: 1.4; display: block; }
.latin-sub { font-size: 24rpx; color: var(--gold); font-style: italic; margin-top: 8rpx; display: block; font-family: Georgia, serif; }

.service-row {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1px solid rgba(38,35,32,0.8);
  flex-wrap: nowrap;
  align-items: center;
  overflow: hidden;
}
.service-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  flex-shrink: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.service-item-press { opacity: 0.7; }
.service-more {
  font-size: 20rpx;
  color: var(--gold);
  margin-left: 4rpx;
  flex-shrink: 0;
}
.service-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold);
}

/* 信息行 */
.info-rows {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  border: 1px solid rgba(38,35,32,0.8);
  margin-bottom: 24rpx;
  overflow: hidden;
}
.info-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1px solid rgba(38,35,32,0.6);
}
.info-row:last-child { border-bottom: none; }
.info-row:active,
.info-row-press { background: var(--color-bg-elevated); }
.info-row.muted .info-value { color: var(--color-text-muted); font-size: 22rpx; }
.info-label { width: 80rpx; font-size: 26rpx; color: var(--color-text-muted); flex-shrink: 0; }
.info-value { flex: 1; font-size: 26rpx; color: var(--color-text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-value.gold { color: var(--gold); }
.shipping-fee-inline {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  gap: 12rpx;
  overflow: visible;
  white-space: normal;
}
.shipping-fee-strike {
  color: var(--color-text-muted);
  font-size: 24rpx;
  text-decoration: line-through;
  font-family: var(--font-mono), monospace;
}
.shipping-free-tag {
  color: var(--gold);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.info-arrow { color: var(--color-text-muted); font-size: 32rpx; margin-left: 8rpx; }

/* 标本养护摘要条 */
.care-strip {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(38, 35, 32, 0.85);
  border-radius: 16rpx;
  overflow: hidden;
}
.coupon-strip:active,
.coupon-strip-press { opacity: 0.85; }
.care-strip:active,
.care-strip-press { opacity: 0.92; }
.care-strip-accent {
  width: 6rpx;
  flex-shrink: 0;
  background: var(--gold);
}
.care-strip-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  align-self: center;
  margin-left: 20rpx;
}
.care-strip-main {
  flex: 1;
  min-width: 0;
  padding: 24rpx 20rpx;
}
.care-strip-overline {
  display: block;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 0.1em;
  margin-bottom: 8rpx;
}
.care-strip-summary {
  display: block;
  /* 养护提醒是顾客最关心的部分（NPS 投诉重点）→ 与区块标题同级，并加重字重 */
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-body);
  line-height: 1.5;
  margin-bottom: 10rpx;
}
.care-strip-tag {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 0.04em;
}
.care-strip-cta {
  align-self: center;
  flex-shrink: 0;
  padding-right: 24rpx;
  font-size: 24rpx;
  color: var(--gold);
}

/* 品牌说明：统一轻量脚注区；摘要一行，点开展开 */
.brand-notes {
  margin-bottom: 24rpx;
  padding: 4rpx 0;
  border-top: 1px solid rgba(77, 64, 26, 0.4);
  border-bottom: 1px solid rgba(77, 64, 26, 0.4);
}
.brand-note {
  padding: 20rpx 4rpx;
}
.brand-note + .brand-note {
  border-top: 1px solid rgba(77, 64, 26, 0.28);
}
.brand-note-press {
  opacity: 0.72;
}
.brand-note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.brand-note-label {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--gold);
  letter-spacing: 0.1em;
}
.brand-note-chevron {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1;
  color: var(--color-text-muted);
  transition: transform 0.2s ease;
}
.brand-note.is-open .brand-note-chevron {
  transform: rotate(90deg);
  color: var(--gold);
}
.brand-note-summary {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}
.brand-note-body {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-body);
  line-height: 1.65;
}

/* 优惠券条 */
.coupon-strip {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, rgba(196,167,108,0.12), rgba(196,167,108,0.04));
  border: 1px solid rgba(196, 167, 108, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.coupon-strip-label {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 44rpx;
  font-size: 24rpx;
  line-height: 1;
  color: var(--gold);
  font-weight: 500;
  flex-shrink: 0;
  padding: 0 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 8rpx;
}
.coupon-strip-scroll {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  white-space: nowrap;
}
.coupon-strip-tags {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  vertical-align: middle;
}
.coupon-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 44rpx;
  padding: 0 16rpx;
  margin-right: 12rpx;
  background: rgba(196, 167, 108, 0.15);
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1;
  color: var(--gold);
  flex-shrink: 0;
}
.coupon-tag.highlight {
  background: rgba(214, 64, 69, 0.12);
  border-color: rgba(214, 64, 69, 0.35);
  color: #E9A23B;
}
.coupon-strip-action {
  display: flex;
  align-items: center;
  height: 44rpx;
  font-size: 24rpx;
  line-height: 1;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  white-space: nowrap;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 优惠券弹层 */
.coupon-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 210;
  display: flex;
  align-items: flex-end;
}
.coupon-panel {
  width: 100%;
  height: 70vh;
  max-height: 70vh;
  background: var(--color-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}
.coupon-panel-head {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1px solid rgba(38,35,32,0.8);
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}
.coupon-panel-body {
  /* 顶栏 + 底栏 CTA + safe-area；明确高度避免 flex:1 在仅 max-height 父级上失效 */
  flex-shrink: 0;
  width: 100%;
  height: calc(70vh - 220rpx - constant(safe-area-inset-bottom));
  height: calc(70vh - 220rpx - env(safe-area-inset-bottom));
  max-height: calc(70vh - 220rpx - constant(safe-area-inset-bottom));
  max-height: calc(70vh - 220rpx - env(safe-area-inset-bottom));
  min-height: 160rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}
.coupon-section-title {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin: 16rpx 0 20rpx;
}
.coupon-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-elevated);
  border: 1px solid rgba(38,35,32,0.8);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.coupon-card.active {
  border-color: rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.08);
}
.coupon-card.disabled {
  opacity: 0.72;
  border-color: rgba(38, 35, 32, 0.9);
}
.coupon-card-left { flex: 1; min-width: 0; }
.coupon-card-value {
  display: block;
  font-size: 32rpx;
  color: var(--gold);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.coupon-card.disabled .coupon-card-value {
  color: var(--color-text-secondary);
}
.coupon-card-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.coupon-card-reason {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #E9A23B;
  letter-spacing: 0.02em;
}
.coupon-card-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 12rpx 28rpx;
  background: var(--gold);
  color: var(--color-bg);
  border-radius: 9999px;
  font-size: 24rpx;
  font-weight: 500;
}
.coupon-card-btn.claimed {
  background: transparent;
  border: 1px solid var(--color-text-muted);
  color: var(--color-text-muted);
}
.coupon-empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 26rpx;
}
.coupon-panel-foot {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(38,35,32,0.8);
}
.coupon-link-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border: 1px solid rgba(196, 167, 108, 0.4);
  color: var(--gold);
  border-radius: 16rpx;
  font-size: 28rpx;
}
.coupon-buy-btn {
  flex: 1.5;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--gold);
  color: var(--color-bg);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* 快捷功能 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  border: 1px solid rgba(38,35,32,0.8);
  padding: 24rpx 0;
  margin-bottom: 48rpx;
}
.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  transition: background 0.2s ease, opacity 0.2s ease;
}
.quick-btn-press { background: var(--color-bg-elevated); opacity: 0.88; }
.quick-icon { width: 40rpx; height: 40rpx; opacity: 0.6; filter: brightness(0) invert(1); }

/* 参数表 */
.params-card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  border: 1px solid rgba(38,35,32,0.8);
  padding: 8rpx 24rpx;
  margin-bottom: 48rpx;
}
.param-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1px dashed rgba(38,35,32,0.8);
}
.param-row:last-child { border-bottom: none; }
.param-k { width: 160rpx; font-size: 24rpx; color: var(--color-text-muted); flex-shrink: 0; }
.param-v { flex: 1; font-size: 24rpx; color: var(--color-text-body); text-align: right; }
.param-v.is-placeholder { color: var(--color-text-secondary); }
.param-v.gold { color: var(--gold); }
.param-v.gold.is-placeholder { color: var(--color-text-secondary); }
.param-v.latin { font-style: italic; color: var(--gold); }

/* 图文详情 — Museum prose */
.detail-content {
  margin-bottom: 48rpx;
  padding: 32rpx 28rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: 24rpx;
}
.detail-prose-rule {
  width: 64rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--gold) 0%, rgba(196, 167, 108, 0.15) 100%);
  margin-bottom: 28rpx;
  border-radius: 4rpx;
}
.detail-para {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--color-text-body);
  text-align: justify;
}
.detail-para--lead {
  font-size: 30rpx;
  color: var(--color-text-primary);
  letter-spacing: 0.02em;
  margin-bottom: 36rpx;
}
.detail-para--body {
  text-indent: 2em;
  margin-bottom: 32rpx;
  padding-bottom: 28rpx;
  border-bottom: 1px solid rgba(196, 167, 108, 0.1);
}
.detail-prose .detail-para--body:last-child,
.detail-prose .detail-para--lead:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}
.detail-seg { color: inherit; }
.detail-seg-latin {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  color: var(--gold);
}
.detail-seg-book {
  color: var(--color-text-primary);
  font-weight: 500;
}
.detail-prose-divider {
  height: 1px;
  margin: 36rpx 0;
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108, 0.35), transparent);
}
.detail-html-wrap {
  margin-top: 8rpx;
  word-break: break-word;
}
.detail-images { margin-top: 32rpx; }
.detail-img {
  width: 100%;
  display: block;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: var(--color-bg-elevated);
  transition: opacity 0.22s ease, transform 0.22s ease;
}
.detail-img:last-child { margin-bottom: 0; }
.detail-img-press {
  opacity: 0.86;
  transform: scale(0.988);
}

/* 多规格图文：规格 Tab + swiper 画廊 */
.detail-gallery { margin-top: 32rpx; }
.detail-spec-tabs {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-bottom: 20rpx;
  width: 100%;
}
.detail-spec-tab {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(160, 154, 144, 0.35);
  font-size: 24rpx;
  color: var(--color-text-body);
  background: transparent;
}
.detail-spec-tab.active {
  background: rgba(196, 167, 108, 0.15);
  border-color: var(--gold);
  color: var(--gold);
}
.detail-spec-tab:active { opacity: 0.85; }
.detail-spec-swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--color-bg-elevated);
  border: 1px solid rgba(38, 35, 32, 0.9);
}
.detail-spec-slide {
  width: 100%;
  height: 520rpx;
  display: block;
  background: var(--color-bg-elevated);
}
.detail-spec-caption {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.detail-spec-caption-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.detail-spec-caption-label {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 500;
}
.detail-spec-caption-size {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--color-text-body);
  word-break: keep-all;
  overflow-wrap: anywhere;
}
.detail-spec-caption-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-mono, monospace);
  padding-top: 2rpx;
}
.detail-shared { margin-top: 28rpx; }
.detail-shared-title {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
}
.detail-shared-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
}
.detail-shared-thumb {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: var(--color-bg-elevated);
  border: 1px solid rgba(38, 35, 32, 0.9);
}

/* 价格 */
.price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx; }
.symbol { font-size: 28rpx; color: var(--gold); margin-right: 8rpx; font-weight: bold; }
.num { font-size: 64rpx; color: var(--gold); font-family: 'DIN', sans-serif; font-weight: bold; }
.vip-box { display: flex; align-items: baseline; }
.vip-badge { background: linear-gradient(90deg, #A8903C, var(--gold)); color: var(--color-bg); font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx; font-weight: bold; margin-left: 8rpx; transform: translateY(-10rpx); }
.origin { font-size: 24rpx; color: #666; text-decoration: line-through; margin-top: 6rpx; }
.stock-label { font-size: 22rpx; color: #666; margin-top: 12rpx; }
.stock-label.active { color: #E9A23B; }
.price-from { font-size: 24rpx; color: var(--color-text-secondary); margin-left: 4rpx; }

.section-title { font-size: 30rpx; color: var(--color-text-secondary); font-weight: 600; letter-spacing: 0.06em; margin-bottom: 24rpx; padding-left: 16rpx; border-left: 6rpx solid var(--gold); }
.section-title.inline { margin-bottom: 0; }
.archive-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-bottom: 60rpx; width: 100%; }
.archive-item { background: var(--color-bg-card); padding: 24rpx; border-radius: 16rpx; border: 1px solid rgba(38, 35, 32, 0.8); display: flex; flex-direction: column; overflow: hidden; }
.archive-item.clickable:active,
.archive-item-press { background: var(--color-bg-elevated); }
.lbl { font-size: 22rpx; color: var(--color-text-muted); margin-bottom: 12rpx; letter-spacing: 1rpx; }
.val { 
  font-size: 26rpx; color: var(--color-text-body); font-weight: 600; 
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; 
}
.val.gold { color: var(--gold); }
.val.is-placeholder {
  color: var(--color-text-secondary);
  font-weight: 500;
}
.val-row { display: flex; justify-content: space-between; align-items: center; }
.arrow { font-size: 24rpx; color: #666; }

/* 科学分类 */
.taxonomy-card { background: var(--color-bg-card); border-radius: 16rpx; padding: 30rpx; margin-bottom: 60rpx; border: 1px solid rgba(38, 35, 32, 0.8); width: 100%; }
.tax-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1px dashed rgba(38, 35, 32, 0.7); width: 100%; }
.tax-row:last-child { border-bottom: none; }
.k { font-size: 24rpx; color: #888; flex-shrink: 0; margin-right: 20rpx; } 
.v { 
  font-size: 24rpx; color: #eee; font-style: italic; 
  text-align: right; 
  flex: 1;
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis; 
}
.tax-row.highlight .v { color: var(--gold); font-weight: bold; }
.taxonomy-empty {
  background: var(--color-bg-card);
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 60rpx;
  border: 1px solid #2a2a2a;
  text-align: center;
}
.taxonomy-empty .muted { font-size: 24rpx; color: var(--color-text-muted); }

.cert-card {
  background: var(--color-bg-card);
  border: 1px solid #4D401A;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 60rpx;
}

.cert-badge {
  padding: 16rpx 30rpx;
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 0.08em;
  border-bottom: 1px solid var(--color-bg-elevated);
  background: rgba(196, 167, 108, 0.08);
}

.cert-body {
  padding: 24rpx;
}

.cert-image {
  width: 100%;
  border-radius: 8rpx;
  border: 1px solid var(--color-bg-elevated);
}

.cert-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}

.cert-tip {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  flex: 1;
}

.cert-action {
  font-size: 22rpx;
  color: var(--gold);
  flex-shrink: 0;
}

.cert-card:active {
  opacity: 0.92;
}

/* 故事卡 */
.story-card { margin-bottom: 60rpx; width: 100%; }
.story-text { font-size: 28rpx; line-height: 1.8; color: var(--color-text-body); text-align: justify; }

/* 推荐滚动 */
.recommend-scroll { display: flex; white-space: nowrap; height: 300rpx; margin-bottom: 40rpx; width: 100%; }
.rec-card { width: 200rpx; flex-shrink: 0; margin-right: 24rpx; display: flex; flex-direction: column; }
.rec-img-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  background: var(--color-bg-elevated);
}
.rec-img-wrap .sb-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.rec-img-wrap image { width: 100%; height: 100%; display: block; }
.rec-card-hover { opacity: 0.92; transform: scale(0.98); }
.rec-name { font-size: 22rpx; color: var(--color-text-body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rec-craft-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 6rpx;
}
.rec-craft-tag {
  font-size: 16rpx;
  line-height: 1.3;
  font-weight: 500;
  letter-spacing: 0.03em;
  color: var(--color-text-secondary);
  background: rgba(196, 167, 108, 0.08);
  border: 1px solid rgba(77, 64, 26, 0.5);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rec-price { font-size: 24rpx; color: var(--gold); margin-top: 4rpx; font-family: var(--font-mono, monospace); }

/* 评价区域 */
.comment-section {
  margin-bottom: 60rpx;
  width: 100%;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 20rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(196, 167, 108,0.1);
  border: 1px solid rgba(196, 167, 108,0.3);
  border-radius: 20rpx;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  transition: background 0.22s ease, transform 0.22s ease;
}

.comment-action.muted {
  background: transparent;
  border-color: #26232066;
  color: var(--color-text-secondary);
  font-weight: 400;
}

.comment-action:active {
  background: rgba(196, 167, 108,0.2);
  transform: scale(0.95);
}

.comment-action.muted:active {
  background: transparent;
  transform: none;
}

.comment-action .arrow {
  font-size: 20rpx;
}

.comment-empty-hint {
  padding: 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.4);
  font-size: 24rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--color-bg-card);
  border-top: 1px solid rgba(38, 35, 32, 0.9);
  display: flex;
  align-items: center;
  z-index: 90;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bottom-icons {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  position: relative;
  padding: 4rpx 0;
  background: transparent;
  line-height: 1.2;
  margin: 0;
  border: none;
}
.contact-btn::after { border: none; }
.contact-btn { padding: 4rpx 0; }

.icon-btn:active,
.icon-btn-press { opacity: 0.75; }

.bar-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  margin-bottom: 4rpx;
  filter: brightness(0) saturate(100%) invert(76%) sepia(66%) saturate(709%) hue-rotate(356deg) brightness(93%) contrast(87%);
}

.bar-txt {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
  line-height: 1.2;
}

.bar-badge {
  position: absolute;
  top: 0;
  right: 4rpx;
  /* 视觉走全局 .badge-solid-danger；此处只负责定位 */
}

.bottom-cta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  gap: 16rpx;
}

.custom-btn,
.gift-btn,
.add-cart-btn {
  flex: 0 0 112rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(196, 167, 108, 0.45);
  border-radius: 16rpx;
  box-sizing: border-box;
}
.custom-btn:active,
.gift-btn:active,
.add-cart-btn:active { opacity: 0.85; }
.custom-btn.disabled,
.gift-btn.disabled,
.add-cart-btn.disabled { opacity: 0.4; pointer-events: none; }
.btn-sub { font-size: 24rpx; color: var(--gold); font-weight: 500; }

.gift-btn {
  background: rgba(196, 167, 108, 0.08);
  border-color: rgba(196, 167, 108, 0.55);
}

.buy-now-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: var(--gold);
  color: var(--color-bg);
  border-radius: 16rpx;
  box-sizing: border-box;
}
.buy-now-btn:active { background: #A8903C; }
.icon-btn.active .bar-txt {
  color: var(--gold);
}
.icon-btn .bar-icon.wish-on {
  opacity: 1;
  filter: none;
}
.icon-btn:not(.active) .bar-icon.wish-on,
.icon-btn:not(.active) .bar-icon {
  opacity: 0.85;
}

.wishlist-cta {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  border-radius: 16rpx;
  background: var(--gold);
  color: var(--color-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.wishlist-cta.on {
  background: transparent;
  border: 1px solid rgba(196, 167, 108, 0.55);
  color: var(--gold);
}
.wishlist-cta .btn-main {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: inherit;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wishlist-cta .btn-wish-sub {
  margin-top: 2rpx;
  font-size: 16rpx;
  opacity: 0.78;
  letter-spacing: 0;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wishlist-cta.on .btn-wish-sub {
  color: var(--color-text-secondary);
  opacity: 1;
}

.deposit-cta {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  border-radius: 16rpx;
  background: transparent;
  border: 1px solid rgba(196, 167, 108, 0.55);
  color: var(--gold);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.deposit-cta:active { opacity: 0.85; }
.deposit-cta.on {
  border-color: rgba(196, 167, 108, 0.35);
  color: var(--color-text-secondary);
}
.deposit-cta .btn-main {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: inherit;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.deposit-cta .btn-wish-sub {
  margin-top: 2rpx;
  font-size: 16rpx;
  opacity: 0.78;
  letter-spacing: 0;
  line-height: 1.2;
  color: var(--color-text-secondary);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cta-skel {
  pointer-events: none;
  background: rgba(196, 167, 108, 0.08) !important;
  border-color: rgba(196, 167, 108, 0.22) !important;
  color: transparent !important;
}
.cta-skel-line {
  border-radius: 6rpx;
  background: rgba(196, 167, 108, 0.18);
}
.cta-skel-main {
  width: 88rpx;
  height: 24rpx;
}
.cta-skel-sub {
  width: 140rpx;
  height: 14rpx;
  margin-top: 8rpx;
}

.buy-now-btn.disabled {
  background: #33302C;
  color: var(--color-text-muted);
  pointer-events: none;
}

.btn-main {
  font-size: 30rpx;
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: 0.05em;
  line-height: 1;
}

/* 🟢 新增：积分提示胶囊样式 */
.point-toast {
  position: fixed;
  left: 50%;
  transform: translateX(-50%) translateY(-150%); /* 默认隐藏 */
  background: rgba(30, 30, 30, 0.9);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(196, 167, 108, 0.3); /* 金色微边框 */
  border-radius: 40rpx;
  padding: 12rpx 30rpx;
  display: flex;
  align-items: center;
  z-index: 999;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.4);
  opacity: 0;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* 弹性动画 */
  pointer-events: none;
}

.point-toast.active {
  transform: translateX(-50%) translateY(0); /* 下滑出现 */
  opacity: 1;
}

.pt-icon {
  color: var(--gold);
  font-size: 24rpx;
  margin-right: 10rpx;
  font-weight: bold;
  animation: spin 3s linear infinite; 
}

.pt-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 弹窗相关 (保持不变) */
.poster-canvas { position: fixed; left: -9999px; top: -9999px; width: 750px; height: 1200px; }
.poster-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); backdrop-filter: blur(15px); z-index: 1000; display: flex; align-items: center; justify-content: center; animation: fadeIn 0.3s ease; }
.poster-container { width: 560rpx; position: relative; display: flex; flex-direction: column; align-items: center; }
.generated-img { width: 100%; border-radius: 12rpx; box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.5); height: auto; }
.poster-btns {
  width: 100%;
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}
.save-btn {
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg);
  font-weight: 500;
  font-size: 28rpx;
  letter-spacing: 0.02em;
  border-radius: var(--radius-lg, 24rpx);
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: none;
}
.save-btn::after {
  border: none;
}
.close-icon-out { position: absolute; top: -80rpx; right: 0; width: 60rpx; height: 60rpx; line-height: 60rpx; text-align: center; font-size: 36rpx; color: #fff; border: 1px solid rgba(255,255,255,0.3); border-radius: 50%; background: rgba(0,0,0,0.5); }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes rotate { from { transform: rotate(0); } to { transform: rotate(360deg); } }

.mask-360 { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.box-360 { width: 600rpx; height: 800rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tip-360 { font-size: 40rpx; color: var(--gold); font-weight: bold; margin-bottom: 60rpx; letter-spacing: 4rpx; }
.hint-360 { color: #666; font-size: 24rpx; margin-top: 60rpx; font-family: monospace; }
.spinner-3d { width: 400rpx; height: 400rpx; position: relative; transform-style: preserve-3d; animation: spin3d 8s linear infinite; }
.spinner-3d image { width: 100%; height: 100%; border-radius: 20rpx; box-shadow: none; border: 2px solid var(--gold); }
@keyframes spin3d { 0% { transform: rotateY(0deg); } 100% { transform: rotateY(360deg); } }

.sku-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.sku-panel {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.sku-head { display: flex; gap: 24rpx; margin-bottom: 32rpx; position: relative; }
.sku-img-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
}
.sku-img-wrap:active { opacity: 0.88; }
.sku-img { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: var(--color-bg-elevated); display: block; }
/* 轻量可点提示：右下角黄铜放大镜 */
.sku-img-hint {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: rgba(26, 24, 20, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.sku-img-hint-icon {
  width: 26rpx;
  height: 26rpx;
  display: block;
}
.sku-meta { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 8rpx; }
.sku-price { font-size: 36rpx; color: var(--gold); font-weight: 600; }
.sku-stock { font-size: 24rpx; color: var(--color-text-secondary); }
.sku-selected { font-size: 24rpx; color: var(--color-text-body); }
.sku-shipping { font-size: 22rpx; color: var(--color-text-secondary); }
.sku-close { position: absolute; right: 0; top: 0; color: var(--color-text-muted); font-size: 36rpx; padding: 8rpx; }
.sku-label { font-size: 24rpx; color: var(--color-text-muted); margin-bottom: 16rpx; display: block; }
.sku-section { margin-bottom: 24rpx; }
.sku-size-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 0 0 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: 12rpx;
}
.sku-size-k {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8A7530;
  letter-spacing: 0.06em;
  padding-top: 2rpx;
}
.sku-size-v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--color-text-body);
  word-break: keep-all;
  overflow-wrap: anywhere;
}
.qty-section { display: flex; align-items: center; justify-content: space-between; }
.qty-stepper { display: flex; align-items: center; gap: 24rpx; }
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 8rpx;
  color: var(--gold);
  font-size: 32rpx;
}
.qty-btn.disabled { opacity: 0.35; pointer-events: none; }
.qty-num { font-size: 28rpx; color: #fff; min-width: 48rpx; text-align: center; font-family: monospace; }
.sku-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sku-pill {
  padding: 12rpx 28rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-body);
}
.sku-pill.active { background: rgba(196, 167, 108, 0.15); border-color: var(--gold); color: var(--gold); }
.sku-pill:active { opacity: 0.82; background: var(--color-bg-elevated); }
.sku-pill.soldout { opacity: 0.35; pointer-events: none; text-decoration: line-through; }
.sku-confirm {
  margin-top: 40rpx;
  background: var(--gold);
  color: var(--color-bg);
  text-align: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.sku-confirm:active { background: #A8903C; }

.refund-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(26, 24, 20, 0.72);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.refund-sheet {
  width: 100%;
  background: var(--color-bg-card);
  border-top: 1px solid #4D401A;
  border-radius: 24rpx 24rpx 0 0;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.refund-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}
.refund-sheet-body {
  margin-bottom: 40rpx;
}
.refund-sheet-para {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.75;
  margin-bottom: 20rpx;
}
.refund-sheet-para:last-child {
  margin-bottom: 0;
}
.refund-sheet-seg.is-em {
  color: var(--gold);
}
.refund-sheet-seg.is-warn {
  color: #E9A23B;
}
.refund-sheet-seg.is-strong {
  font-weight: 600;
}
.refund-sheet-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--gold);
  color: var(--color-bg);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
/* 需求 28：祈福墙入口的样式已随组件迁到 components/WishWallEntry/index.wxss
