/* ═══════════════════════════════════════════════════════════════════════
 * 详情页信息卡 · 三级视觉规范（2026-09-17 定稿）
 *
 * 背景：此前每加一项信息就**再占一行** → 四行同权、留白零散、金色通胀。
 * 规则：新增信息先问「它属于哪一级」，而不是「再放一行」。
 *
 *   L1 主视觉（最亮，一屏只允许两处金）
 *       .title-theme（主题名 46rpx 衬线）/ .num + .symbol（价格，金）
 *       .gift-cta（一键送礼，金色实心）
 *   L2 支撑（次亮，常规字重）
 *       .title-main.is-sub（标准名 30rpx · #CFC9BF）
 *       .title-theme-note（题记 24rpx + 细弱金线）
 *       .gift-scene-chip（场景 chips —— **中性描边**，不得用品牌金）
 *       .discount-chip（省钱标签，金色实心小标签：价格区唯一的金）
 *   L3 弱化（最小/最灰）
 *       .latin-sub（学名，opacity .72）/ .side-stock（库存）/ .service-item（服务承诺）
 *       .tag-item（品类角标）
 *
 * 黄金规则：**L1 之外不得出现品牌亮金（#C4A76C / var(--brass-400)）**；
 *   否则金色通胀 → 页面没有重点。由 check:detail-visual-tiers 守卫钉住。
 * ═══════════════════════════════════════════════════════════════════════ */

/* subpackages/feature/detail/index.wxss */
@import "../../../styles/badges.wxss";

/* 1. 全局容器控制：彻底防止左右溢出 */
page {
  background-color: var(--color-bg);
  color: var(--color-text-body);
  font-family: var(--font-body);
  width: 100%;
  overflow-x: hidden; /* 🔴 核心：禁止横向滚动 */
  
  /* 🔴 核心：底部留白 = 底部栏高度 + 安全区 + 间距 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 朋友圈单页：无自建底栏，留白交给微信「前往小程序」 */
.container.is-single-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

view, text, image { box-sizing: border-box; }

.load-error-overlay {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
  gap: 16rpx;
}

.load-error-title {
  color: var(--color-text-primary);
  font-size: var(--fs-34);
  font-weight: 500;
}

.load-error-desc {
  color: var(--color-text-secondary);
  font-size: var(--fs-26);
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.load-error-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 480rpx;
}

.load-error-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: var(--fs-28);
}

.load-error-btn.primary {
  background: var(--color-primary);
  color: var(--color-bg);
  border: none;
}

/* 冷启动骨架：非 modal，Museum 黄铜微光 */
.detail-skel-hero {
  width: 100%;
  height: 100%;
  border-radius: 0;
}
.detail-skel-price {
  width: 220rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
}
.detail-skel-stock {
  width: 160rpx;
  height: 28rpx;
}
.detail-skel-title {
  width: 86%;
  height: 40rpx;
  margin-bottom: 16rpx;
}
.detail-skel-title.short {
  width: 52%;
  height: 28rpx;
  margin-bottom: 0;
}
.detail-skel-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-sm);
  margin: 0 auto 4rpx;
}

/* 顶部导航 */
.nav-bar-wrap {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 120;
  transition: background var(--dur-fast) var(--ease-standard);
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 0 12px;
  box-sizing: border-box;
}
.nav-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-28);
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0 12px;
}
.nav-right-group {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  margin-left: auto;
  box-sizing: border-box;
}

/* 导航圆形按钮 — 使用 px 与胶囊对齐，分享按钮须 plain + 重置默认 min-height */
.nav-icon-btn {
  width: 32px;
  height: 32px;
  min-width: 32px;
  min-height: 32px;
  max-width: 32px;
  max-height: 32px;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 0;
  box-sizing: border-box;
  background: rgba(31, 29, 26, 0.88);
  border-radius: 50%;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: visible;
  flex-shrink: 0;
}
.nav-icon-btn:active,
.nav-icon-press { opacity: 0.78; }

button.nav-share-btn {
  /* 覆盖微信 button 默认样式，防止撑成大椭圆 */
  padding: 0;
  margin: 0;
  min-height: 32px;
  line-height: 32px;
  font-weight: normal;
  color: inherit;
  background: rgba(31, 29, 26, 0.88);
}
button.nav-share-btn::after { display: none; border: none; }
.nav-share-hover { background: rgba(196, 167, 108, 0.25) !important; opacity: 1; }

.nav-action-icon {
  width: 18px;
  height: 18px;
  display: block;
  filter: brightness(0) invert(1);
  opacity: 0.92;
  pointer-events: none;
}

/* 敏感形态「掩上/已启视」— 与分享/购物车同列，靠 navPaddingRight 避让胶囊 */
.nav-veil-btn {
  height: 32px;
  min-height: 32px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--color-primary);
  background: rgba(26, 24, 20, 0.82);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-sm);
  white-space: nowrap;
}

.cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  /* 视觉走全局 .badge-solid-danger；此处只负责定位 */
  z-index: 1;
}

/* 吸顶 Tab */
.sticky-tabs {
  position: fixed;
  left: 0;
  width: 100%;
  z-index: 110;
  display: flex;
  background: rgba(26,24,20,0.96);
  border-bottom: 1px solid rgba(38,35,32,0.8);
  transform: translateY(-100%);
  opacity: 0;
  transition: transform var(--dur-base) var(--ease-standard), opacity var(--dur-base) var(--ease-standard);
  backdrop-filter: blur(12px);
}
.sticky-tabs.visible { transform: translateY(0); opacity: 1; }
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: var(--fs-28);
  color: var(--color-text-secondary);
  position: relative;
}
.tab-item.active { color: var(--color-primary); font-weight: 500; }
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}
.tab-count { font-size: var(--fs-22); margin-left: 4rpx; }

.back-icon {
  flex-shrink: 0;
  background: transparent !important;
  border-color: transparent !important;
  min-width: 36px !important;
  min-height: 36px !important;
  width: 36px !important;
  height: 36px !important;
  max-width: 36px !important;
  max-height: 36px !important;
}
.back-icon .page-nav-back-icon {
  width: 28px;
  height: 28px;
}

/* Hero 轮播：外层只做定位锚点；高度由 JS 写在 .hero-stage 上 */
.hero-wrapper { position: relative; width: 100%; }
.hero-stage {
  position: relative;
  width: 100%;
  background: var(--color-bg);
  transition: height var(--dur-base) var(--ease-standard);
  overflow: hidden;
}
.hero-stage.is-pending {
  height: 46vh;
  min-height: 42vh;
  max-height: 50vh;
}
.hero-wrapper .sb-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}
.hero-swiper { width: 100%; height: 100%; background: var(--color-bg); }
.slide-image { width: 100%; height: 100%; background: transparent; }
.hero-video { background: #111; }
.hero-live-badge {
  position: absolute; left: 24rpx; bottom: 96rpx; z-index: 4; padding: 4rpx 14rpx; border-radius: var(--radius-lg);
  font-size: var(--fs-20); letter-spacing: 2rpx; color: #fff; background: rgba(26, 24, 20, 0.6); pointer-events: none;
}
.img-counter {
  position: absolute;
  right: 24rpx;
  bottom: 96rpx;
  z-index: 4;
  background: rgba(26, 24, 20, 0.55);
  border: 1rpx solid rgba(212, 188, 133, 0.35);
  color: var(--color-text-body);
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  font-family: var(--font-mono, monospace);
  padding: 4rpx 14rpx;
  border-radius: 9999px;
}
/* 主图左下：仅合规角标，避开状态栏与返回键 */
.hero-badge-stack {
  position: absolute;
  left: 24rpx;
  bottom: 96rpx;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: calc(100% - 160rpx);
  pointer-events: none;
}
/* ⚠️ 2026-10-12 真机：这里原为 z-index: 6，把整张头图（含 swiper）抬到全部叠层（渐隐 2 / 署名·方印·张数 4 / 带证 5）之上，
   底部渐隐自上线起就从未显示过。图层回到 1（与上方首条 .sb-wrap 同值）；罩层打开时叠层自身 wx:if 退场，不再靠压层级遮挡。
   守卫 check:a-flow-polish R9 钉住「叠层 z-index 必须高于头图层」。 */
.hero-wrapper .sb-wrap {
  z-index: 1;
}
/* 底部三段渐隐：180rpx 两段线性在实拍浅底图上收不住，接正文卡处一道硬边 → 拉长到 320rpx、中段先压暗 */
.hero-overlay {
  position: absolute; bottom: 0; left: 0; width: 100%; height: 320rpx;
  background: linear-gradient(to bottom, rgba(26, 24, 20, 0) 0%, rgba(26, 24, 20, 0.55) 48%, rgba(26, 24, 20, 0.92) 80%, var(--color-bg) 100%);
  pointer-events: none;
  z-index: 2;
}
/* 顶部淡影：导航钮压在浅色实拍上时不发虚 */
.hero-topshade {
  position: absolute; top: 0; left: 0; width: 100%; height: 140rpx;
  background: linear-gradient(to bottom, rgba(26, 24, 20, 0.42), rgba(26, 24, 20, 0));
  pointer-events: none;
  z-index: 2;
}
/* 左上馆藏署名水印：两行极小字，半透明，不抢主体 */
.hero-credit {
  position: absolute; top: 24rpx; left: 28rpx; z-index: 4;
  display: flex; flex-direction: column; gap: 2rpx;
  pointer-events: none;
}
.hero-credit-en { font-size: var(--fs-16); letter-spacing: 0.32em; color: rgba(247, 241, 228, 0.72); font-weight: 600; text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.45); }
.hero-credit-zh { font-size: var(--fs-18); letter-spacing: 0.16em; color: rgba(247, 241, 228, 0.6); text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.45); }
/* 右上方印：孤品 / 镇店 —— 金框方章（正文铜牌已撤，这里是唯一标识） */
.hero-seal {
  position: absolute; top: 24rpx; right: 24rpx; z-index: 4;
  width: 76rpx; height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(26, 24, 20, 0.58);
  border: 1rpx solid rgba(212, 188, 133, 0.85);
  border-radius: var(--radius-sm);
  box-shadow: inset 0 0 0 4rpx rgba(26, 24, 20, 0.58), inset 0 0 0 5rpx rgba(212, 188, 133, 0.45);
  pointer-events: none;
}
.hero-seal-t { width: 44rpx; font-size: var(--fs-22); line-height: 1.15; font-weight: 600; letter-spacing: 0.06em; text-align: center; color: #E3C98C; font-family: var(--font-brand, 'Source Han Serif SC', serif); }

/* 内容区：圆角信息卡上叠一头图，和头图底部渐隐接成同一页 */
.content-body {
  padding: 0 24rpx;
  position: relative;
  z-index: 3;
  width: 100%;
  margin-top: -48rpx;
}

/* 需求 28：祈福墙入口（头部主图下方）。
   间距作用在**宿主自己的包裹 view** 上（不是组件的 ext-class）：同一元素上组件样式与
   宿主样式都设 margin 时谁生效不保证 —— 切片实测宿主的 margin-top 会被组件样式吃掉。
   头图底部渐隐，信息卡上叠约 48rpx；这里只留下方间距，避免把卡片再顶开。 */
.wish-wall-slot {
  margin: 24rpx 0;
}

/* 电商主卡片 */
.commerce-card {
  background: var(--color-bg-card);
  border-radius: 32rpx 32rpx 24rpx 24rpx;
  padding: 32rpx;
  border: 1px solid rgba(38,35,32,0.8);
  /* 卡顶边线淡出 + 向上一层同色柔影：与头图底部渐隐接成一片，不再是一道硬边 */
  border-top-color: transparent;
  box-shadow: 0 -28rpx 40rpx -12rpx rgba(26, 24, 20, 0.9);
  margin-bottom: 24rpx;
}
.offer-links {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 8rpx;
}
.offer-link,
.offer-link-dot {
  font-size: var(--fs-26);
  line-height: 1.4;
  color: var(--color-text-secondary);
}
.offer-link {
  padding: 8rpx 4rpx;
}
.commerce-card-unique {
  border-color: rgba(77, 64, 26, 0.95);
  border-top-color: transparent;
  background:
    linear-gradient(135deg, rgba(196, 167, 108, 0.06) 0%, transparent 42%),
    var(--color-bg-card);
}
.price-block { margin-bottom: 24rpx; }
.stock-row { margin-top: 8rpx; }
.stock-label { font-size: var(--fs-22); color: var(--color-text-secondary); }
.stock-label.warn { color: #E9A23B; }
.stock-label.soldout { color: #D64045; }
.stock-label.unique {
  color: var(--color-primary);
  letter-spacing: 0.04em;
}


.title-block { margin-bottom: 24rpx; }
.tags-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.tag-item {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  font-size: var(--fs-20);
  background: rgba(196, 167, 108, 0.12);
  color: var(--color-primary);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  white-space: nowrap;
  box-sizing: border-box;
  letter-spacing: 0.04em;
}
/* 主题名（双层命名的第一层）：详情页做主视觉，标准名降为副行 */
.title-theme {
  display: block;
  font-size: var(--fs-44);
  font-weight: 600;
  color: var(--color-text-primary, #F5F2EC);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
/* 题记：衬线小字 + 左金线，像展签上的一行说明 */
.title-theme-note {
  display: block;
  margin: 6rpx 0 14rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--brass-800, rgba(196, 167, 108, 0.55));
  font-size: var(--fs-24);
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: var(--color-text-secondary, #A09A90);
}
.title-main.is-sub {
  font-size: var(--fs-26);
  font-weight: 400;
  color: var(--color-text-secondary, #A09A90);
}
.title-main { font-size: var(--fs-36); font-weight: 600; color: var(--color-text-primary); line-height: 1.4; display: block; }
.latin-sub { font-size: var(--fs-24); color: var(--color-primary); font-style: italic; margin-top: 8rpx; display: block; font-family: var(--font-latin); }

.service-row {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1px solid rgba(38,35,32,0.8);
  flex-wrap: nowrap;
  align-items: center;
  overflow: hidden;
}
.service-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  flex-shrink: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.service-more {
  font-size: var(--fs-20);
  color: var(--color-primary);
  margin-left: 4rpx;
  flex-shrink: 0;
}
.service-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

/* 信息行 */
.info-rows {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 1px solid rgba(38,35,32,0.8);
  margin-bottom: 24rpx;
  overflow: hidden;
}
.info-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1px solid rgba(38,35,32,0.6);
}
.info-row:last-child { border-bottom: none; }
.info-row:active,
.info-row-press { background: var(--color-bg-elevated); }
/* 运费行（并入原「说明」行）：金额在上、规则小注在下；收起态单行省略，展开态完整换行 */
.ship-row { align-items: flex-start; }
.ship-row .info-label { line-height: 36rpx; }
.ship-row .info-arrow { line-height: 36rpx; }
.info-col { flex: 1; min-width: 0; }
.info-col .info-value { display: flex; line-height: 36rpx; }
.info-note {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.info-note.open { white-space: normal; overflow: visible; text-overflow: clip; }
.rule-arrow { transition: transform var(--dur-fast) var(--ease-standard); }
.rule-arrow.open { transform: rotate(90deg); }
.info-label { width: 80rpx; font-size: var(--fs-26); color: var(--color-text-secondary); flex-shrink: 0; }
.info-value { flex: 1; font-size: var(--fs-26); color: var(--color-text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-value.gold { color: var(--color-primary); }
.shipping-fee-inline {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  gap: 12rpx;
  overflow: visible;
  white-space: normal;
}
.shipping-fee-strike {
  color: var(--color-text-muted);
  font-size: var(--fs-24);
  text-decoration: line-through;
  font-family: var(--font-mono), monospace;
}
.shipping-free-tag {
  color: var(--color-primary);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.info-arrow { color: var(--color-text-secondary); font-size: var(--fs-32); margin-left: 8rpx; }

/* 标本养护摘要条 */
.care-strip {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(38, 35, 32, 0.85);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.coupon-strip:active,
.coupon-strip-press { opacity: 0.85; }
.care-strip:active,
.care-strip-press { opacity: 0.92; }
.care-strip-accent {
  width: 6rpx;
  flex-shrink: 0;
  background: var(--color-primary);
}
.care-strip-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  align-self: center;
  margin-left: 20rpx;
}
.care-strip-main {
  flex: 1;
  min-width: 0;
  padding: 24rpx 20rpx;
}
.care-strip-overline {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-primary);
  letter-spacing: 0.1em;
  margin-bottom: 8rpx;
}
.care-strip-summary {
  display: block;
  /* 养护提醒是顾客最关心的部分（NPS 投诉重点）→ 与区块标题同级，并加重字重 */
  font-size: var(--fs-30);
  font-weight: 500;
  color: var(--color-text-body);
  line-height: 1.5;
  margin-bottom: 10rpx;
}
.care-strip-tag {
  display: inline-block;
  font-size: var(--fs-22);
  letter-spacing: 0.04em;
}
.care-strip-cta {
  align-self: center;
  flex-shrink: 0;
  padding-right: 24rpx;
  font-size: var(--fs-24);
  color: var(--color-primary);
}

/* 品牌说明：统一轻量脚注区；摘要一行，点开展开 */
.brand-notes {
  margin-bottom: 24rpx;
  padding: 4rpx 0;
  border-top: 1px solid rgba(77, 64, 26, 0.4);
  border-bottom: 1px solid rgba(77, 64, 26, 0.4);
}
.brand-note {
  padding: 20rpx 4rpx;
}
.brand-note + .brand-note {
  border-top: 1px solid rgba(77, 64, 26, 0.28);
}
.brand-note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.brand-note-label {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20);
  color: var(--color-primary);
  letter-spacing: 0.1em;
}
.brand-note-chevron {
  flex-shrink: 0;
  font-size: var(--fs-28);
  line-height: 1;
  color: var(--color-text-secondary);
  transition: transform var(--dur-fast) var(--ease-standard);
}
.brand-note.is-open .brand-note-chevron {
  transform: rotate(90deg);
  color: var(--color-primary);
}
.brand-note-summary {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}
.brand-note-body {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-body);
  line-height: 1.65;
}

/* 优惠券条 */
.coupon-strip {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, rgba(196,167,108,0.12), rgba(196,167,108,0.04));
  border: 1rpx solid rgba(196, 167, 108, 0.25);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.coupon-strip-label {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 44rpx;
  font-size: var(--fs-24);
  line-height: 1;
  color: var(--color-primary);
  font-weight: 500;
  flex-shrink: 0;
  padding: 0 12rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: var(--radius-sm);
}
.coupon-strip-scroll {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  white-space: nowrap;
}
.coupon-strip-tags {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  vertical-align: middle;
}
.coupon-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 44rpx;
  padding: 0 16rpx;
  margin-right: 12rpx;
  background: rgba(196, 167, 108, 0.15);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-sm);
  font-size: var(--fs-22);
  line-height: 1;
  color: var(--color-primary);
  flex-shrink: 0;
}
.coupon-tag.highlight {
  background: rgba(214, 64, 69, 0.12);
  border-color: rgba(214, 64, 69, 0.35);
  color: #E9A23B;
}
.coupon-strip-action {
  display: flex;
  align-items: center;
  height: 44rpx;
  font-size: var(--fs-24);
  line-height: 1;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  white-space: nowrap;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 优惠券弹层 */
/* 礼券抽屉：形态 / 头部 / 行 / 底栏取 app.wxss 的 ui-pop-*（docs/弹层视觉规范_2026-10-13.md） */
.coupon-panel { height: 70vh; }
.coupon-panel-body {
  /* 抓手 + 头部约 160rpx、底栏约 140rpx；明确高度避免 flex:1 在仅 max-height 父级上失效（安全区由 ui-pop-sheet 自带） */
  flex-shrink: 0;
  width: 100%;
  height: calc(70vh - 300rpx - env(safe-area-inset-bottom));
  min-height: 160rpx;
  box-sizing: border-box;
}
.coupon-section-title {
  display: block;
  margin: 24rpx 0 4rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.12em;
  color: var(--color-text-secondary);
}
/* 「领取」：发丝金描边小按钮（每屏一个实心金 → 留给「立即购买」）；已领取 / 已拥有为纯文字 */
.coupon-card-btn {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 54rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--pop-hairline);
  border-radius: 28rpx;
  font-size: var(--fs-24);
  color: var(--brass-400);
  white-space: nowrap;
  box-sizing: border-box;
}
.coupon-card-btn.claimed { border-color: transparent; padding: 0; color: var(--color-text-secondary); }
.coupon-buy-btn { flex: 1.5; }

/* 快捷功能 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 1px solid rgba(38,35,32,0.8);
  padding: 24rpx 0;
  margin-bottom: 48rpx;
}
.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  padding: 8rpx 12rpx;
  border-radius: var(--radius-md);
  transition: background var(--dur-fast) var(--ease-standard), opacity var(--dur-fast) var(--ease-standard);
}
.quick-btn-press { background: var(--color-bg-elevated); opacity: 0.88; }
.quick-icon { width: 40rpx; height: 40rpx; opacity: 0.6; filter: brightness(0) invert(1); }

/* 参数表 */
.params-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 1px solid rgba(38,35,32,0.8);
  padding: 8rpx 24rpx;
  margin-bottom: 48rpx;
}
.param-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1px dashed rgba(38,35,32,0.8);
}
.param-row:last-child { border-bottom: none; }
.param-k { width: 160rpx; font-size: var(--fs-24); color: var(--color-text-secondary); flex-shrink: 0; }
.param-v { flex: 1; font-size: var(--fs-24); color: var(--color-text-body); text-align: right; }
.param-v.is-placeholder { color: var(--color-text-secondary); }
.param-v.gold { color: var(--color-primary); }
.param-v.gold.is-placeholder { color: var(--color-text-secondary); }
.param-v.latin { font-style: italic; font-family: var(--font-latin); color: var(--color-primary); }

/* 图文详情 — Museum prose */
.detail-content {
  margin-bottom: 48rpx;
  padding: 32rpx 28rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: var(--radius-lg);
}
.detail-prose-rule {
  width: 64rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--color-primary) 0%, rgba(196, 167, 108, 0.15) 100%);
  margin-bottom: 28rpx;
  border-radius: 4rpx;
}
.detail-para {
  font-size: var(--fs-28);
  line-height: 1.75;
  color: var(--color-text-body);
  text-align: justify;
}
.detail-para--lead {
  font-size: var(--fs-30);
  color: var(--color-text-primary);
  letter-spacing: 0.02em;
  margin-bottom: 36rpx;
}
.detail-para--body {
  text-indent: 2em;
  margin-bottom: 32rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.1);
}
.detail-prose .detail-para--body:last-child,
.detail-prose .detail-para--lead:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}
.detail-seg { color: inherit; }
.detail-seg-latin {
  font-family: var(--font-latin);
  font-style: italic;
  color: var(--color-primary);
}
.detail-seg-book {
  color: var(--color-text-primary);
  font-weight: 500;
}
.detail-prose-divider {
  height: 1px;
  margin: 36rpx 0;
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108, 0.35), transparent);
}
.detail-html-wrap {
  margin-top: 8rpx;
  word-break: break-word;
}
.detail-images { margin-top: 32rpx; }
.detail-img {
  width: 100%;
  display: block;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--color-bg-elevated);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}
.detail-img:last-child { margin-bottom: 0; }
.detail-img-press {
  opacity: 0.86;
  transform: scale(0.988);
}

/* 多规格图文：规格 Tab + swiper 画廊 */
.detail-gallery { margin-top: 32rpx; }
.detail-spec-tabs {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-bottom: 20rpx;
  width: 100%;
}
.detail-spec-tab {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(160, 154, 144, 0.35);
  font-size: var(--fs-24);
  color: var(--color-text-body);
  background: transparent;
}
.detail-spec-tab.active {
  background: rgba(196, 167, 108, 0.15);
  border-color: var(--color-primary);
  color: var(--color-primary);
}
.detail-spec-tab:active { opacity: 0.85; }
/* 高度由 JS 按当前图原始比例给（夹在 SPEC_RATIO_MIN–MAX）；加载前按 4:3 占位脉动，避免布局跳动 */
.detail-spec-swiper {
  width: 100%;
  height: 514rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-elevated);
  border: 1px solid rgba(38, 35, 32, 0.9);
  transition: height var(--dur-base) var(--ease-standard);
}
.detail-spec-swiper.is-loading { animation: ui-sk-pulse 1.2s ease-in-out infinite; }
.detail-spec-slide {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--color-bg-elevated);
}
.detail-spec-caption {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.detail-spec-caption-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.detail-spec-caption-label {
  font-size: var(--fs-24);
  color: var(--color-primary);
  font-weight: 500;
}
.detail-spec-caption-size {
  font-size: var(--fs-24);
  line-height: 1.55;
  color: var(--color-text-body);
  word-break: keep-all;
  overflow-wrap: anywhere;
}
.detail-spec-caption-count {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  font-family: var(--font-mono, monospace);
  padding-top: 2rpx;
}
.detail-shared { margin-top: 28rpx; }
.detail-shared-title {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
}
.detail-shared-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
}
.detail-shared-thumb {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated);
  border: 1px solid rgba(38, 35, 32, 0.9);
}

/* 价格 */
.price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx; }
.symbol { font-size: var(--fs-28); color: var(--color-primary); margin-right: 8rpx; font-weight: bold; }
.num { font-size: 64rpx; color: var(--color-primary); font-family: var(--font-mono); font-weight: bold; }
.vip-box { display: flex; align-items: baseline; }
.vip-badge { background: linear-gradient(90deg, #A8903C, var(--color-primary)); color: var(--color-bg); font-size: var(--fs-20); padding: 2rpx 10rpx; border-radius: var(--radius-sm); font-weight: bold; margin-left: 8rpx; transform: translateY(-10rpx); }
.origin { font-size: var(--fs-24); color: var(--color-text-secondary); text-decoration: line-through; margin-top: 6rpx; }
.stock-label { font-size: var(--fs-22); color: var(--color-text-secondary); margin-top: 12rpx; }
.stock-label.active { color: #E9A23B; }
.price-from { font-size: var(--fs-24); color: var(--color-text-secondary); margin-left: 4rpx; }

/* 分区标题：全站口径（app.wxss .mu-head，眉标 + 主标、无竖条，2026-10-12 拍板）；本页沿用 .section-title / .st-en / .st-zh 类名 */
.section-title { display: flex; flex-direction: column; margin-bottom: 24rpx; padding-bottom: 18rpx; background: linear-gradient(90deg, rgba(196,167,108,.55), rgba(196,167,108,.12) 60%, transparent) left bottom / 100% 1px no-repeat; }
.st-en { font-size: var(--fs-18); line-height: 26rpx; color: var(--brass-400); font-family: var(--font-mono); letter-spacing: .32em; }
.st-zh { margin-top: 6rpx; font-size: 38rpx; line-height: 50rpx; font-weight: 500; color: var(--color-text-primary); font-family: var(--font-brand); letter-spacing: .12em; }
.section-title.inline { margin-bottom: 0; padding-bottom: 0; background: none; }
.archive-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-bottom: 60rpx; width: 100%; }
.archive-item:last-child:nth-child(odd) { grid-column: span 2; }
.archive-item { background: var(--color-bg-card); padding: 24rpx; border-radius: var(--radius-md); border: 1px solid rgba(38, 35, 32, 0.8); display: flex; flex-direction: column; overflow: hidden; }
.archive-item.clickable:active,
.archive-item-press { background: var(--color-bg-elevated); }
.lbl { font-size: var(--fs-22); color: var(--color-text-secondary); margin-bottom: 12rpx; letter-spacing: 1rpx; }
.val { 
  font-size: var(--fs-26); color: var(--color-text-body); font-weight: 600; 
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; 
}
.val.gold { color: var(--color-primary); }
.val.is-placeholder {
  color: var(--color-text-secondary);
  font-weight: 500;
}
.val-row { display: flex; justify-content: space-between; align-items: center; }
.arrow { font-size: var(--fs-24); color: var(--color-text-secondary); }

/* 科学分类 */
.taxonomy-card { background: var(--color-bg-card); border-radius: var(--radius-md); padding: 30rpx; margin-bottom: 60rpx; border: 1px solid rgba(38, 35, 32, 0.8); width: 100%; }
.tax-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1px dashed rgba(38, 35, 32, 0.7); width: 100%; }
.tax-row:last-child { border-bottom: none; }
.k { font-size: var(--fs-24); color: var(--color-text-secondary); flex-shrink: 0; margin-right: 20rpx; } 
.v { 
  font-size: var(--fs-24); color: var(--color-text-body); font-style: italic; 
  text-align: right; 
  flex: 1;
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis; 
}
.tax-row.highlight .v { color: var(--color-primary); font-weight: bold; }
.taxonomy-empty {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 30rpx;
  margin-bottom: 60rpx;
  border: 1px solid #2a2a2a;
  text-align: center;
}
.taxonomy-empty .muted { font-size: var(--fs-24); color: var(--color-text-muted); }

.cert-card {
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 60rpx;
}

.cert-badge {
  padding: 16rpx 30rpx;
  font-size: var(--fs-22);
  color: var(--color-primary);
  letter-spacing: 0.08em;
  border-bottom: 1px solid var(--color-bg-elevated);
  background: rgba(196, 167, 108, 0.08);
}

.cert-body {
  padding: 24rpx;
}

.cert-image {
  width: 100%;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-bg-elevated);
}

.cert-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}

.cert-tip {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  flex: 1;
}

.cert-action {
  font-size: var(--fs-22);
  color: var(--color-primary);
  flex-shrink: 0;
}

.cert-card:active {
  opacity: 0.92;
}

/* 故事卡 */
.story-card { margin-bottom: 60rpx; width: 100%; }
.story-text { font-size: var(--fs-28); line-height: 1.8; color: var(--color-text-body); text-align: justify; }

/* 推荐滚动 */
.recommend-scroll { display: flex; white-space: nowrap; height: 300rpx; margin-bottom: 40rpx; width: 100%; }
.rec-card { width: 200rpx; flex-shrink: 0; margin-right: 24rpx; display: flex; flex-direction: column; }
.rec-img-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 12rpx;
  background: var(--color-bg-elevated);
}
.rec-img-wrap .sb-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.rec-img-wrap image { width: 100%; height: 100%; display: block; }
.rec-card-hover { opacity: 0.92; transform: scale(0.98); }
.rec-name { font-size: var(--fs-22); color: var(--color-text-body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rec-craft-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 6rpx;
}
.rec-craft-tag {
  font-size: var(--fs-16);
  line-height: 1.3;
  font-weight: 500;
  letter-spacing: 0.03em;
  color: var(--color-text-secondary);
  background: rgba(196, 167, 108, 0.08);
  border: 1px solid rgba(77, 64, 26, 0.5);
  border-radius: var(--radius-sm);
  padding: 2rpx 8rpx;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rec-price { font-size: var(--fs-24); color: var(--color-primary); margin-top: 4rpx; font-family: var(--font-mono, monospace); }

/* 评价区域 */
.comment-section {
  margin-bottom: 60rpx;
  width: 100%;
}

/* 评价区：标题与右侧「签收后可在订单中评价」同一行，发丝线归整行（全站分区标题口径） */
.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 30rpx;
  padding: 0 0 18rpx;
  background: linear-gradient(90deg, rgba(196,167,108,.55), rgba(196,167,108,.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(196, 167, 108,0.1);
  border: 1rpx solid rgba(196, 167, 108,0.3);
  border-radius: var(--radius-lg);
  color: var(--color-primary);
  font-size: var(--fs-24);
  font-weight: 700;
  transition: background var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}

.comment-action.muted {
  background: transparent;
  border-color: #26232066;
  color: var(--color-text-secondary);
  font-weight: 400;
}

.comment-action:active {
  background: rgba(196, 167, 108,0.2);
  transform: scale(0.95);
}

.comment-action.muted:active {
  background: transparent;
  transform: none;
}

.comment-action .arrow {
  font-size: var(--fs-20);
}

.comment-empty-hint {
  padding: 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.4);
  font-size: var(--fs-24);
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--color-bg-card);
  border-top: 1px solid rgba(38, 35, 32, 0.9);
  display: flex;
  align-items: center;
  z-index: 90;
  flex-wrap: nowrap;
  padding: 16rpx 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bottom-icons {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  position: relative;
  padding: 4rpx 0;
  background: transparent;
  line-height: 1.2;
  margin: 0;
  border: none;
}
.contact-btn::after { border: none; }
.contact-btn { padding: 4rpx 0; }

.icon-btn:active,
