/* 🟢 新增：积分提示胶囊样式 */
.point-toast {
  position: fixed;
  left: 50%;
  transform: translateX(-50%) translateY(-150%); /* 默认隐藏 */
  background: rgba(30, 30, 30, 0.9);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(196, 167, 108, 0.3); /* 金色微边框 */
  border-radius: 40rpx;
  padding: 12rpx 30rpx;
  display: flex;
  align-items: center;
  z-index: 999;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.4);
  opacity: 0;
  transition: opacity var(--dur-slow) cubic-bezier(0.175, 0.885, 0.32, 1.275), transform var(--dur-slow) cubic-bezier(0.175, 0.885, 0.32, 1.275), color var(--dur-slow) cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color var(--dur-slow) cubic-bezier(0.175, 0.885, 0.32, 1.275), border-color var(--dur-slow) cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow var(--dur-slow) cubic-bezier(0.175, 0.885, 0.32, 1.275); /* 弹性动画 */
  pointer-events: none;
}

.point-toast.active {
  transform: translateX(-50%) translateY(0); /* 下滑出现 */
  opacity: 1;
}

.pt-icon {
  color: var(--color-primary);
  font-size: var(--fs-24);
  margin-right: 10rpx;
  font-weight: bold;
  animation: spin 3s linear infinite; 
}

.pt-text {
  color: #fff;
  font-size: var(--fs-24);
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 弹窗相关 (保持不变) */
.poster-canvas { position: fixed; left: -9999px; top: -9999px; width: 750px; height: 1200px; }
.poster-modal { z-index: 1000; }   /* 仪式卡：ui-pop-mask is-center is-deep */
.poster-container { width: 560rpx; position: relative; display: flex; flex-direction: column; align-items: center; }
.generated-img { width: 100%; border-radius: var(--radius-md); box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.5); height: auto; }
.poster-btns {
  width: 100%;
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}
.save-btn {
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg);
  font-weight: 500;
  font-size: var(--fs-28);
  letter-spacing: 0.02em;
  border-radius: var(--radius-lg, 24rpx);
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: none;
}
.save-btn::after {
  border: none;
}
.close-icon-out { position: absolute; top: -80rpx; right: 0; width: 60rpx; height: 60rpx; line-height: 60rpx; text-align: center; font-size: var(--fs-36); color: #fff; border: 1px solid rgba(255,255,255,0.3); border-radius: 50%; background: rgba(0,0,0,0.5); }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes rotate { from { transform: rotate(0); } to { transform: rotate(360deg); } }

.mask-360 { z-index: 1000; }   /* 仪式卡：ui-pop-mask is-center is-deep */
.box-360 { width: 600rpx; height: 800rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tip-360 { margin-bottom: 56rpx; }
.hint-360 { color: var(--color-text-secondary); font-size: var(--fs-24); margin-top: 60rpx; letter-spacing: 0.08em; }
.spinner-3d { width: 400rpx; height: 400rpx; position: relative; transform-style: preserve-3d; animation: spin3d 8s linear infinite; }
.spinner-3d image { width: 100%; height: 100%; border-radius: var(--radius-lg); box-shadow: none; border: 1rpx solid var(--pop-hairline); }
@keyframes spin3d { 0% { transform: rotateY(0deg); } 100% { transform: rotateY(360deg); } }

/* 规格抽屉：形态取 ui-pop-sheet（遮罩 / 牌面 / 抓手 / 安全区 / 进场）；这里只给内边距 */
.sku-panel { padding: 0 var(--pop-pad-x) calc(32rpx + env(safe-area-inset-bottom)); }
.sku-panel .sku-head { margin-top: 24rpx; }
.sku-head { display: flex; gap: 24rpx; margin-bottom: 32rpx; position: relative; }
.sku-img-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.sku-img-wrap:active { opacity: 0.88; }
.sku-img { width: 160rpx; height: 160rpx; border-radius: var(--radius-md); background: var(--color-bg-elevated); display: block; }
/* 轻量可点提示：右下角黄铜放大镜 */
.sku-img-hint {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-sm);
  background: rgba(26, 24, 20, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.sku-img-hint-icon {
  width: 26rpx;
  height: 26rpx;
  display: block;
}
.sku-meta { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 8rpx; }
.sku-price { font-size: var(--fs-36); color: var(--color-primary); font-weight: 600; }
.sku-stock { font-size: var(--fs-24); color: var(--color-text-secondary); }
.sku-selected { font-size: var(--fs-24); color: var(--color-text-body); }
.sku-shipping { font-size: var(--fs-22); color: var(--color-text-secondary); }
.sku-close { position: absolute; right: 0; top: 0; color: var(--color-text-secondary); font-size: var(--fs-30); line-height: 1; padding: 8rpx; }
/* 热区放大到约 84rpx，字形位置不变（padding 加 16rpx、外移 16rpx） */
.sku-head .sku-close { right: -16rpx; top: -16rpx; padding: 24rpx; }
.sku-label { font-size: var(--fs-24); color: var(--color-text-secondary); margin-bottom: 16rpx; display: block; }
.sku-section { margin-bottom: 24rpx; }
.sku-size-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 0 0 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
}
.sku-size-k {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: #8A7530;
  letter-spacing: 0.06em;
  padding-top: 2rpx;
}
.sku-size-v {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-26);
  line-height: 1.55;
  color: var(--color-text-body);
  word-break: keep-all;
  overflow-wrap: anywhere;
}
.qty-section { display: flex; align-items: center; justify-content: space-between; }
.qty-section .sku-label { margin-bottom: 0; }
.qty-stepper { display: flex; align-items: center; gap: 24rpx; }
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: var(--radius-sm);
  color: var(--color-primary);
  font-size: var(--fs-32);
}
.qty-btn.disabled { opacity: 0.35; pointer-events: none; }
.qty-num { font-size: var(--fs-28); color: #fff; min-width: 48rpx; text-align: center; font-family: var(--font-mono); }
.sku-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sku-pill {
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: var(--radius-sm);
  font-size: var(--fs-26);
  color: var(--color-text-body);
}
.sku-pill.active { background: rgba(196, 167, 108, 0.15); border-color: var(--color-primary); color: var(--color-primary); }
.sku-pill:active { opacity: 0.82; background: var(--color-bg-elevated); }
.sku-pill.soldout { opacity: 0.35; pointer-events: none; text-decoration: line-through; }
.sku-confirm { display: block; flex: none; margin-top: 40rpx; }
.sku-confirm-press { opacity: 0.86; }

/* 退款说明抽屉：形态 / 头部 / 底栏取 ui-pop-*；这里只排正文 */
.refund-sheet-body { padding-bottom: 32rpx; }
.refund-sheet-para {
  display: block;
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  line-height: 1.75;
  margin-bottom: 20rpx;
}
.refund-sheet-para:last-child {
  margin-bottom: 0;
}
.refund-sheet-seg.is-em {
  color: var(--color-primary);
}
.refund-sheet-seg.is-warn {
  color: #E9A23B;
}
.refund-sheet-seg.is-strong {
  font-weight: 600;
}
/* 需求 28：祈福墙入口的样式已随组件迁到 components/WishWallEntry/index.wxss
   （小程序自定义组件默认样式隔离，留在本页既失效又会让人误以为改这里有用） */

/* ── 礼赠面板（头图下方的坪效位）───────────────────────────────────────── */
.gift-panel {
  margin: 8rpx 0 4rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--brass-800, rgba(196, 167, 108, 0.35));
  border-radius: var(--radius-md, 16rpx);
  background: linear-gradient(180deg, rgba(196, 167, 108, 0.06) 0%, rgba(196, 167, 108, 0.02) 100%);
}
.gift-panel-head { display: flex; align-items: baseline; gap: 14rpx; flex-wrap: wrap; }
.gift-panel-title { font-size: var(--fs-28); font-weight: 600; letter-spacing: 2rpx; color: var(--brass-400, #C4A76C); }
.gift-panel-sub { font-size: var(--fs-22); color: var(--color-text-secondary); }
.gift-scene-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin-top: 16rpx; }
.gift-scene-label { font-size: var(--fs-22); color: var(--color-text-secondary); }
.gift-scene-chip {
  padding: 6rpx 18rpx;
  border: 1rpx solid var(--brass-800, rgba(196, 167, 108, 0.45));
  border-radius: 999rpx;
  font-size: var(--fs-22);
  color: var(--brass-400, #C4A76C);
}
.gift-scene-chip-press { background: rgba(196, 167, 108, 0.14); }
/* 2026-10-12 拍板：每屏只留一个实心金主操作（底栏「立即购买」）→ 一键送礼改金色描边，位置 / 大小 / 跳转不变 */
.gift-cta {
  margin-top: 20rpx; height: 76rpx; line-height: 74rpx; text-align: center;
  border-radius: 999rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.7);
  color: var(--color-primary); font-size: var(--fs-28); font-weight: 600; letter-spacing: 2rpx;
}

/* ── 价格行右侧：折扣 + 库存（合并原独立库存行，提升信息密度）────────────── */
.price-side {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.discount-chip {
  padding: 2rpx 12rpx;
  border: 1rpx solid var(--brass-800, rgba(196, 167, 108, 0.5));
  border-radius: 999rpx;
  font-size: var(--fs-20);
  color: var(--brass-400, #C4A76C);
  line-height: 1.5;
}
.side-stock { font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); }
.side-stock.warn { color: #E9A23B; }
.side-stock.soldout { color: #D64045; }
.side-stock.unique { color: var(--color-primary, #C4A76C); letter-spacing: 0.04em; }
/* 行距收紧：主题名/题记/标准名/学名四行之间的呼吸再小一点 */
.title-theme-note { margin: 4rpx 0 10rpx; }
.latin-sub { margin-top: 4rpx; }

/* ── 身份块层级（2026-09-17 美学调整）──────────────────────────────────
 * 主题名(最大·衬线) / 标准名(次大) 同属「主视觉」；题记是评注（金线缩进）；学名最弱。
 * 之前四行同权 → 题记把"名字"与"是什么"劈开，读起来断裂。 */
.title-main {                                  /* 标准名：次视觉，比题记更实 */
  font-size: var(--fs-34);
  font-weight: 500;
  color: var(--color-text-primary, #F5F2EC);
  letter-spacing: 0.5rpx;
}
.title-main.is-sub {                           /* 有主题名时：它是"是什么"，仍要看得清 */
  font-size: var(--fs-30);
  font-weight: 500;
  color: #CFC9BF;
}
.title-theme { margin-bottom: 6rpx; }          /* 与标准名贴紧：同一视线块 */
.title-theme-note {                            /* 评注：缩进 + 金线，与上面留一口气 */
  margin: 12rpx 0 4rpx;
  font-size: var(--fs-24);
}
.latin-sub {                                   /* 学名：最弱，离上一行远一点 */
  margin-top: 10rpx;
  font-size: var(--fs-24);
  opacity: 0.72;
}
/* ── 价格行右侧：与价格基线对齐；折扣改为更强的铜金实心标签 ───────────── */
.price-row { align-items: flex-end; }
/* ¥ 与数字同一基线（2026-10-15）：整行 flex-end 让 28rpx 的 ¥ 贴到 64rpx 数字行框的底，比数字基线低一截、还多隔 8rpx */
.price-row > .symbol, .price-row > .num, .price-row > .price-from, .price-row > .vip-box { align-self: baseline; }
.price-row > .symbol { margin-right: 0; }
.price-side { align-items: flex-end; gap: 8rpx; }
.discount-chip {
  padding: 3rpx 14rpx;
  border: none;
  border-radius: var(--radius-sm);
  background: linear-gradient(90deg, var(--color-primary) 0%, #D9BE86 100%);
  color: #1A1814;
  font-size: var(--fs-20);
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.side-stock { font-size: var(--fs-20); opacity: 0.9; }

/* ── 分隔线与金色收敛（2026-09-17 美学第二轮）────────────────────────────
 * 金色通胀问题：价格 + 折扣标签 + 题记线 + 场景 chips + CTA 曾同时用亮金 ✗
 * 收敛后：**价格与 CTA 最亮**，chips 退为中性描边，题记线保持细弱金。
 */
.card-divider {
  height: 1rpx;
  margin: 18rpx 0 16rpx;
  background: linear-gradient(90deg, rgba(196,167,108,0) 0%, rgba(196,167,108,0.22) 50%, rgba(196,167,108,0) 100%);
}
.gift-scene-chip {
  border-color: rgba(196, 167, 108, 0.26);
  color: #B9B2A6;
  background: rgba(255, 255, 255, 0.02);
}
.gift-scene-chip-press { background: rgba(196, 167, 108, 0.12); }

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .detail-spec-swiper.is-loading,
  .pt-icon,
  .spinner-3d {
    animation: none;
  }
}

/* 实拍影像（2026-10-18 产品负责人点名）：视频号内嵌 16:9；外平台为一行卡片（播放三角 + 标题 + 平台 · 动作） */
.films { margin-bottom: 48rpx; display: flex; flex-direction: column; gap: 16rpx; }
.films-hint { font-size: var(--fs-22); color: var(--color-text-secondary); }
.film-embed {
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #000;
  border: 1px solid rgba(38,35,32,0.8);
}
.film-channel { display: block; width: 100%; height: 388rpx; }
.film-cap {
  display: block;
  padding: 14rpx 20rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
}
.film-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 1px solid rgba(38,35,32,0.8);
}
.film-play {
  position: relative;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx var(--brass-400);
}
.film-play::after {
  content: '';
  position: absolute;
  left: 29rpx;
  top: 22rpx;
  border-left: 22rpx solid var(--brass-400);
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
}
.film-play.is-ext { box-shadow: inset 0 0 0 2rpx rgba(196,167,108,0.45); }
.film-play.is-ext::after { border-left-color: rgba(196,167,108,0.7); }
.film-body { flex: 1; min-width: 0; }
.film-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-body);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.film-meta { display: block; margin-top: 6rpx; font-size: var(--fs-22); color: var(--color-text-secondary); }
.film-go { flex-shrink: 0; font-size: var(--fs-24); color: var(--brass-300); }

/* 主方案 = 同主体视频号（2026-10-18）：主片大幅（视频号实拍多为竖 3:4，取 5:6 折中，contain 不裁）；标题 + 「本馆视频号 · 实拍」 */
.film-embed.is-lead .film-channel { height: 820rpx; }
.film-cap { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.film-cap-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-26);
  color: var(--color-text-body);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.film-cap-k { flex-shrink: 0; font-size: var(--fs-20); letter-spacing: 0.08em; color: var(--brass-300); }
.hero-film-chip {
  position: absolute;
  left: 50%;
  bottom: 96rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 22rpx 8rpx 18rpx;
  transform: translateX(-50%);
  background: rgba(26, 24, 20, 0.62);
  border: 1rpx solid rgba(212, 188, 133, 0.55);
  border-radius: 9999px;
  font-size: var(--fs-22);
  letter-spacing: 0.08em;
  color: var(--brass-200);
}
.hero-film-tri {
  width: 0;
  height: 0;
  border-left: 14rpx solid var(--brass-300);
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
}
