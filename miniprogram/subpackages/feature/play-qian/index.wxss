@import "../play-shared/ritual-play.wxss";

/* ── 今日一签：一只签筒 ──────────────────────────────────────────
   入口不是"一枚瓦片"，而是一只有体积的筒 —— 摇它才有签条出来。
   全部用 CSS 盒子拼（无图片、无 canvas）：真机排版可量、可离线预览。 */
.rp-tube {
  position: relative;
  width: 150rpx;
  height: 210rpx;
}

.rp-tube-body {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 150rpx;
  height: 172rpx;
  border-radius: 10rpx 10rpx 20rpx 20rpx;
  background: linear-gradient(180deg, var(--brass-500) 0%, var(--brass-800) 100%);
  box-shadow: inset 0 4rpx 0 rgba(250, 246, 237, 0.16), inset -10rpx 0 20rpx rgba(0, 0, 0, 0.28);
}

.rp-tube-mouth {
  position: absolute;
  left: -6rpx;
  top: 22rpx;
  width: 162rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--brass-900);
  box-shadow: inset 0 4rpx 8rpx rgba(0, 0, 0, 0.5);
}

.rp-stick {
  position: absolute;
  left: 66rpx;
  top: 12rpx;
  width: 18rpx;
  height: 128rpx;
  border-radius: 9rpx;
  background: linear-gradient(180deg, var(--brass-50) 0%, var(--brass-300) 100%);
  opacity: 0;
  transform: translateY(52rpx);
}

/* 进行态：筒在摇、签在升 —— 只在这里挂动画（入口静止时是一筒安静的签） */
.rp-stage.is-pending .rp-tube {
  animation: rp-tube-shake 0.26s ease-in-out infinite;
}

.rp-stage.is-pending .rp-stick {
  animation: rp-stick-up 1000ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

@keyframes rp-tube-shake {
  0%, 100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}

@keyframes rp-stick-up {
  0% { opacity: 0; transform: translateY(52rpx); }
  55% { opacity: 1; }
  100% { opacity: 1; transform: translateY(-30rpx); }
}

/* ── 结果纸面：竹签（竖长的浅纸，宜/忌分列） ─────────────────────── */
.rp-paper {
  background: linear-gradient(180deg, #F3ECDA 0%, #E6DAC0 100%);
  border: 1rpx solid rgba(122, 92, 44, 0.4);
}

.rp-paper-title {
  font-family: var(--font-brand);
  font-size: var(--fs-44);
  letter-spacing: 0.04em;
}

.rp-paper-sub {
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(122, 92, 44, 0.24);
}
