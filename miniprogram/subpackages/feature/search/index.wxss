/* 搜索 · 检索台（2026-10-18 视觉对齐）
   检索框方角发丝、聚焦金线环；识图鉴定 = 发丝线行 + 方印「鉴」；热门 / 最近 = 方角发丝签；
   结果分类 = 下划线页签；结果 / 同标签藏品 = 发丝线行（宋体名 + 斜体学名 + 等宽价）。页头高度由 js 实测 .sticky-header。 */
page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  background: var(--color-bg, #1A1814);
  color: var(--color-text-primary, #FFFFFF);
}

.page-search {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  position: relative;
  background: var(--color-bg, #1A1814);
  box-sizing: border-box;
  overflow-x: hidden;
}


/* —— 系统导航栏下的检索条 —— */
.sticky-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(26, 24, 20, 0.97);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  overflow: visible;
  box-sizing: border-box;
}

.nav-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx 12rpx;
  box-sizing: border-box;
}

.search-field-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
}

.search-field {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 16rpx 0 22rpx;
  background: #1F1D1A;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
  box-sizing: border-box;
}

.search-field.is-active {
  box-shadow: var(--ring-brass);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.72;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  margin-left: 12rpx;
  background: transparent;
  font-size: var(--fs-28);
  color: #F3ECDD;
  line-height: 1.2;
}

.search-ph {
  color: var(--color-text-muted, #6B6560);
  font-size: var(--fs-24);
}

.clear-btn {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  margin-left: 4rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.04em;
  color: var(--color-text-secondary, #A09A90);
  line-height: 1;
  border-radius: 2rpx;
}

.clear-btn-press {
  color: var(--brass-400, #C4A76C);
  background: rgba(196, 167, 108, 0.1);
}

.identify-divider {
  width: 1rpx;
  height: 28rpx;
  margin: 0 10rpx 0 4rpx;
  flex-shrink: 0;
  background: rgba(196, 167, 108, 0.3);
}

/* 「鉴」= 方印（铜框方章），检索条与空闲区同一枚 */
.identify-btn {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 2rpx rgba(212, 188, 133, 0.6);
}

.identify-btn-press {
  opacity: 0.85;
  background: rgba(196, 167, 108, 0.14);
}

.identify-glyph {
  font-family: var(--font-brand);
  font-size: var(--fs-22);
  font-weight: 700;
  line-height: 1;
  color: var(--brass-200);
}

.cancel-btn {
  flex-shrink: 0;
  padding: 16rpx 4rpx 16rpx 8rpx;
  font-size: var(--fs-26);
  letter-spacing: 0.06em;
  line-height: 1;
  color: var(--brass-300);
}


.scope-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.scope-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  padding: 8rpx 18rpx;
  border-radius: 2rpx;
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass-soft);
}

.scope-label {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.scope-name {
  font-size: var(--fs-24);
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scope-clear {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.scope-clear-press {
  color: var(--brass-400, #C4A76C);
}

/* 联想：挂在检索框下，提交后由 shouldShowSuggestPanel 关闭，不挡结果 */
.suggest-panel {
  position: absolute;
  top: calc(100% + 10rpx);
  left: 0;
  right: 0;
  z-index: 200;
  max-height: 420rpx;
  overflow-y: auto;
  overflow-x: hidden;
  background: #1F1D1A;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.32), 0 16rpx 36rpx rgba(0, 0, 0, 0.5);
}

.suggest-head {
  padding: 16rpx 24rpx 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.suggest-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.suggest-item-press {
  background: rgba(196, 167, 108, 0.06);
}

.suggest-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

.suggest-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-26);
  color: var(--color-text-body, #D5D1C8);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggest-go {
  flex-shrink: 0;
  font-size: var(--fs-20);
  letter-spacing: 0.08em;
  color: var(--brass-300);
}

/* —— 主滚动 —— */
.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  box-sizing: border-box;
  overflow-x: hidden;
}

.scroll-inner {
  width: 100%;
  max-width: 100%;
  padding: 24rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
}

.idle-zone,
.result-zone {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.idle-zone {
  padding: 8rpx 32rpx 0;
}

/* 识图鉴定入口：发丝线行 + 方印（原圆角卡 + 圆章） */
.identify-plate {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 8rpx 0 48rpx;
  padding: 28rpx 4rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  box-sizing: border-box;
}

.identify-plate-press {
  background: rgba(196, 167, 108, 0.05);
}

.identify-plate-mark {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 2rpx rgba(212, 188, 133, 0.65), inset 0 0 0 6rpx #1A1814, inset 0 0 0 7rpx rgba(212, 188, 133, 0.35);
}

.identify-plate-mark .identify-glyph {
  font-size: var(--fs-32);
}

.identify-plate-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.identify-plate-en {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.identify-plate-cn {
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.identify-plate-desc {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.4;
}

.identify-plate-arr {
  flex-shrink: 0;
  font-size: var(--fs-32);
  line-height: 1;
  color: var(--brass-300);
}

.zone-section {
  margin-bottom: 48rpx;
}





.clear-history {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 8rpx 4rpx;
}

.clear-history text {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}

.clear-history-icon {
  width: 24rpx;
  height: 24rpx;
}


.clear-history-press {
  opacity: 0.7;
}
.clear-history-press text {
  color: var(--brass-400, #C4A76C);
}

.chip-matrix {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 热门 / 最近：方角发丝签（原金边胶囊） */
.chip {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-height: 56rpx;
  padding: 0;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3);
  box-sizing: border-box;
}

.chip-hot {
  padding: 10rpx 24rpx;
}

.chip-history {
  padding: 0 8rpx 0 4rpx;
}

.chip-hit {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding: 10rpx 12rpx 10rpx 20rpx;
  max-width: 420rpx;
}

.chip-ghost {
  padding: 10rpx 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.16);
}

.chip-text {
  font-size: var(--fs-24);
  line-height: 1.3;
  color: var(--brass-200);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-history .chip-text { color: var(--color-text-body, #D5D1C8); }

.chip-press {
  opacity: 0.88;
  background: rgba(196, 167, 108, 0.12);
}

.chip-del {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 2rpx;
}

.chip-del-icon {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.7;
}

.chip-del-press {
  background: rgba(196, 167, 108, 0.16);
}

.idle-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 24rpx 24rpx;
  text-align: center;
}

.idle-icon-wrap,
.empty-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.3);
}

.idle-icon,
.empty-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.85;
}

.idle-title,
.empty-title {
  margin-bottom: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  letter-spacing: 0.06em;
  color: #F3ECDD;
}

.idle-desc,
.empty-desc {
  font-size: var(--fs-24);
  color: var(--color-text-secondary, #A09A90);
  line-height: 1.55;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
  height: 76rpx;
  box-sizing: border-box;
}

.filter-row {
  display: inline-flex;
  align-items: stretch;
  height: 76rpx;
  padding: 0 32rpx;
  padding-right: 72rpx;
}

/* 结果分类：下划线页签（原胶囊） */
.filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 76rpx;
  padding: 0 2rpx;
  margin-right: 40rpx;
  flex-shrink: 0;
  border-bottom: 3rpx solid transparent;
  box-sizing: border-box;
}

.filter-label {
  font-size: var(--fs-26);
  color: var(--color-text-secondary, #A09A90);
}

.filter-count {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  font-family: var(--font-mono, monospace);
  min-width: 1em;
}

.filter-pill.active {
  border-bottom-color: var(--brass-400);
}

.filter-pill.active .filter-label {
  color: #F3ECDD;
  font-family: var(--font-brand);
  font-weight: 600;
}

.filter-pill.active .filter-count {
  color: var(--brass-300, #D4BC85);
}

.filter-pill.is-empty .filter-label,
.filter-pill.is-empty .filter-count {
  opacity: 0.55;
}

.filter-pill-press {
  opacity: 0.8;
}

.filter-pad {
  display: inline-block;
  width: 48rpx;
  flex-shrink: 0;
}

.result-zone {
  padding: 0;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 32rpx 24rpx;
}

.meta-count {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
  letter-spacing: 0.04em;
  flex-shrink: 0;
}

.meta-hint {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.meta-line {
  flex: 1;
  height: 1rpx;
  background: rgba(196, 167, 108, 0.14);
}

.archive-list {
  padding: 0 32rpx;
  width: 100%;
  border-top: 0;
  box-sizing: border-box;
}

/* 结果行：发丝线分隔（原圆角卡）；强相关靠「相关」签，不再加框 */
.archive-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  box-sizing: border-box;
  overflow: hidden;
}

.archive-card.is-strong {
  border-bottom-color: rgba(196, 167, 108, 0.22);
}

.archive-card-press {
  background: rgba(196, 167, 108, 0.05);
}

.ac-img {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 4rpx;
  background: #1F1D1A;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
  box-sizing: border-box;
}

.ac-img .sb-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.ac-img-sm {
  width: 120rpx;
  height: 120rpx;
}

.ac-img image {
  width: 100%;
  height: 100%;
  display: block;
}

.ac-img-ph {
  width: 100%;
  height: 100%;
  background:
    linear-gradient(135deg, rgba(196, 167, 108, 0.06), transparent 55%),
    var(--color-bg-elevated, #262320);
}

.ac-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.ac-title {
  flex: 1;
  min-width: 0;
  font-family: var(--font-brand);
  font-size: var(--fs-28);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ac-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.ac-match {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 2rpx;
  box-shadow: var(--ring-brass-soft);
  font-family: var(--font-mono);
  font-size: var(--fs-16);
  letter-spacing: 0.16em;
  color: var(--brass-200);
}

.ac-latin {
  font-family: var(--font-latin);
  font-style: italic;
  font-size: var(--fs-22);
  color: var(--color-text-latin, #C4A76C);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ac-btm {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 2rpx;
}

.ac-type {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.ac-price {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  color: var(--brass-200);
  letter-spacing: 0.02em;
}

.ac-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.ac-craft-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}

.ac-craft-tag {
  padding: 2rpx 10rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.28);
  font-size: var(--fs-18);
  line-height: 1.3;
  letter-spacing: 0.04em;
  white-space: nowrap;
  color: var(--color-text-secondary, #A09A90);
}

.ac-tag-chip {
  max-width: 100%;
  padding: 4rpx 12rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
  font-size: var(--fs-20);
  line-height: 1.3;
  color: var(--color-text-secondary, #A09A90);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ac-tag-chip-press {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.1);
}

.ac-arr {
  flex-shrink: 0;
  padding-left: 4rpx;
  font-size: var(--fs-36);
  line-height: 1;
  color: var(--brass-300);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 48rpx;
  text-align: center;
}

.retry-btn {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: 4rpx;
  box-shadow: var(--ring-brass-soft);
  font-size: var(--fs-26);
  letter-spacing: 0.08em;
  color: var(--brass-200);
}

.retry-btn-press {
  opacity: 0.8;
  background: rgba(196, 167, 108, 0.1);
}

.related-block {
  width: 100%;
  margin-top: 40rpx;
  text-align: left;
}

.related-after-hits {
  padding: 8rpx 32rpx 24rpx;
  box-sizing: border-box;
}

.empty-related {
  padding: 8rpx 0 8rpx;
  box-sizing: border-box;
}

.empty-state .related-block {
  align-self: stretch;
}

.related-head {
  margin-bottom: 20rpx;
}


.related-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--fs-22);
  letter-spacing: 0.12em;
  color: var(--color-text-secondary, #A09A90);
}

.related-chips {
  justify-content: flex-start;
}

.related-list {
  display: flex;
  flex-direction: column;
}

.related-card {
  margin: 0;
}

.related-sk {
  width: 100%;
}

/* 骨架：卡片结构，非整页转圈 */
.skeleton-wrap {
  padding: 8rpx 32rpx 32rpx;
}

.sk-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 192rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  box-sizing: border-box;
}

.sk-compact {
  min-height: 160rpx;
}

.sk-thumb {
  width: 152rpx;
  height: 152rpx;
  flex-shrink: 0;
  border-radius: 4rpx;
  background: #262320;
}

.sk-compact .sk-thumb {
  width: 120rpx;
  height: 120rpx;
}

.sk-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sk-line {
  height: 24rpx;
  border-radius: 2rpx;
  background: #262320;
}

.sk-title {
  width: 68%;
  height: 28rpx;
}

.sk-latin {
  width: 46%;
  height: 22rpx;
}

.sk-meta {
  width: 32%;
  height: 20rpx;
}

.sk-shine {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.04) 0%,
    rgba(196, 167, 108, 0.1) 50%,
    rgba(196, 167, 108, 0.04) 100%
  );
  background-size: 200% 100%;
  animation: shine 1.4s ease infinite;
}

@keyframes shine {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .sk-shine {
    animation: none;
  }
}
