@import "../play-shared/ritual-play.wxss";

/* ── 星座签：一轮星盘 ────────────────────────────────────────────
   12 个格位（数据来自资料页那份常量，页面只画 12 个点）+ 一根指针；
   进行态 = 盘转、指针扫过一周。 */
.rp-wheel {
  position: relative;
  width: 250rpx;
  height: 250rpx;
}

.rp-wheel-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 250rpx;
  height: 250rpx;
  border: 2rpx solid rgba(196, 167, 108, 0.45);
  border-radius: 50%;
  box-shadow: inset 0 0 30rpx rgba(196, 167, 108, 0.16);
}

.rp-dot {
  position: absolute;
  left: 121rpx;
  top: 121rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--brass-300);
  transform-origin: 4rpx 4rpx;
}

.rp-wheel-needle {
  position: absolute;
  left: 123rpx;
  top: 34rpx;
  width: 4rpx;
  height: 116rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, var(--brass-100) 0%, var(--brass-400) 100%);
  transform-origin: 2rpx 91rpx;
}

/* 进行态：盘转 + 指针扫过 */
.rp-stage.is-pending .rp-wheel {
  animation: rp-wheel-spin 1100ms cubic-bezier(0.25, 0.7, 0.3, 1) forwards;
}

.rp-stage.is-pending .rp-wheel-needle {
  animation: rp-needle-sweep 1100ms cubic-bezier(0.25, 0.7, 0.3, 1) forwards;
}

@keyframes rp-wheel-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(180deg); }
}

@keyframes rp-needle-sweep {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(540deg); }
}

/* ── 结果纸面：一格星签（深色签面 + 铜字，与"签/饼"的浅纸刻意区分） ── */
.rp-paper {
  background: linear-gradient(180deg, #24211C 0%, #1B1916 100%);
  border: 1rpx solid rgba(196, 167, 108, 0.38);
}

.rp-paper-overline {
  color: rgba(224, 207, 163, 0.8);
}

.rp-paper-title {
  font-family: var(--font-brand);
  font-size: var(--fs-44);
  color: var(--brass-100);
}

/* 深色签面上的印章字标：改用铜字（shared 里的暗红是为浅纸定的） */
.rp-paper-mark {
  color: rgba(224, 207, 163, 0.9);
  border-color: rgba(196, 167, 108, 0.55);
}

.rp-line {
  color: var(--color-text-body);
}

.rp-note {
  color: rgba(224, 207, 163, 0.62);
  border-top-color: rgba(196, 167, 108, 0.22);
}

.rp-paper-grip-bar {
  background: rgba(224, 207, 163, 0.35);
}
