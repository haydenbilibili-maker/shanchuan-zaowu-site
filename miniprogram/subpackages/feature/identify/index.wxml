<!-- AI 标本鉴定 · 鉴定台（2026-10-17 重构）：取景框是主舞台（点框即拍）→ 门类提示 → 三步 → 最近鉴定（带缩略图）→ 拍摄建议 → 隐私说明。
     云函数 identifySpecimen 调用、埋点、失败文案、等待卡三步、隐私说明位置均不变。 -->
<view class="page">
  <view class="head" catchlongpress="onEasterEggLongPress" data-egg-id="lingyu">
    <view class="head-top">
      <text class="head-eyebrow">AI SPECIMEN LAB · 鉴定台</text>
      <text class="head-free">当前免费</text>
    </view>
    <text class="head-title">拍一张，读懂它</text>
    <text class="head-sub">识别物种 · 写一页博物手记 · 关联馆藏与图鉴。结果仅供参考，以实物为准。</text>
  </view>

  <!-- 取景框：四角括线 + 中心提示；整框可点 = 拍照 -->
  <view
    class="frame {{busy ? 'is-busy' : ''}}"
    bindtap="onFrameTap"
    hover-class="frame-press"
    hover-stay-time="80"
    aria-role="button"
    aria-label="拍照鉴定"
  >
    <view class="frame-corner is-tl" aria-hidden="true"></view>
    <view class="frame-corner is-tr" aria-hidden="true"></view>
    <view class="frame-corner is-bl" aria-hidden="true"></view>
    <view class="frame-corner is-br" aria-hidden="true"></view>
    <view class="frame-cross" aria-hidden="true"></view>
    <image class="frame-ico" src="/assets/icons/camera.png" mode="aspectFit"></image>
    <text class="frame-t">把标本放进框里</text>
    <text class="frame-s">正对 · 柔光 · 主体占满</text>
  </view>

  <view class="actions">
    <button class="btn primary" bindtap="onTakePhoto" disabled="{{busy}}">拍照鉴定</button>
    <view class="album-link" bindtap="onChooseAlbum" hover-class="tap-press" hover-stay-time="80" aria-role="button">从相册选一张 ›</view>
  </view>

  <!-- 门类提示：可选，选了识别更准 -->
  <view class="hint-block" wx:if="{{!busy}}">
    <view class="hint-head">
      <text class="hint-title">它大概是</text>
      <text class="hint-note">可选 · 选了识别更准</text>
    </view>
    <scroll-view scroll-x class="hint-scroll" enable-flex show-scrollbar="{{false}}">
      <view class="hint-inner">
        <view
          class="hint-chip {{categoryHint === item.id ? 'active' : ''}}"
          wx:for="{{categoryHints}}"
          wx:key="id"
          bindtap="onCategoryHint"
          data-id="{{item.id}}"
          hover-class="tap-press"
          hover-stay-time="80"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 三步（与等待卡同名） -->
  <view class="flow">
    <view class="flow-step" wx:for="{{flowSteps}}" wx:key="k">
      <text class="flow-no">{{index + 1}}</text>
      <text class="flow-k">{{item.k}}</text>
      <text class="flow-v">{{item.v}}</text>
    </view>
  </view>

  <view class="recent" wx:if="{{recentList.length && !busy}}">
    <view class="recent-head">
      <view class="sec-head-t">
        <text class="sec-eyebrow">RECENT</text>
        <text class="recent-title">最近鉴定</text>
      </view>
      <view class="recent-link" bindtap="goLog" hover-class="recent-item-press" hover-stay-time="80">
        <text>全部记录 ›</text>
      </view>
    </view>
    <view
      class="recent-item"
      wx:for="{{recentList}}"
      wx:key="_id"
      bindtap="openRecent"
      data-id="{{item._id}}"
      hover-class="recent-item-press"
      hover-stay-time="80"
    >
      <image wx:if="{{item.thumb}}" class="recent-thumb" src="{{item.thumb}}" mode="aspectFill" data-index="{{index}}" binderror="onRecentThumbError"></image>
      <view wx:else class="recent-thumb is-empty"></view>
      <view class="recent-body">
        <text class="recent-name">{{item.name}}</text>
        <text class="recent-latin" wx:if="{{item.latin}}">{{item.latin}}</text>
      </view>
      <text class="recent-time">{{item.timeText}}</text>
    </view>
  </view>

  <view class="ui-pop-mask is-center loading-mask" wx:if="{{busy}}" catchtouchmove="true">
    <!-- 步骤与进度放进加载卡：放在遮罩下面时被压暗，等待 15–60 秒只看得到一个转圈 -->
    <view class="loading-core">
      <view class="scan" aria-hidden="true">
        <view class="scan-corner is-tl"></view>
        <view class="scan-corner is-tr"></view>
        <view class="scan-corner is-bl"></view>
        <view class="scan-corner is-br"></view>
        <view class="scan-line"></view>
      </view>
      <text class="loading-txt">{{loadingText}}</text>
      <view class="steps">
        <view class="step {{loadingStep >= 1 ? 'done' : ''}}">入镜</view>
        <view class="step-line {{loadingStep >= 2 ? 'done' : ''}}"></view>
        <view class="step {{loadingStep >= 2 ? 'done' : ''}}">归档</view>
        <view class="step-line {{loadingStep >= 3 ? 'done' : ''}}"></view>
        <view class="step {{loadingStep >= 3 ? 'done' : ''}}">解读</view>
      </view>
      <view class="progress-bar" wx:if="{{uploadProgress > 0 && uploadProgress < 100}}">
        <view class="progress-fill" style="width: {{uploadProgress}}%;"></view>
      </view>
    </view>
  </view>

  <view class="tips">
    <view class="sec-head-t">
      <text class="sec-eyebrow">FIELD TIPS</text>
      <text class="tip-title">拍摄建议</text>
    </view>
    <view class="tip-grid">
      <view class="tip-cell" wx:for="{{photoTips}}" wx:key="k">
        <text class="tip-k">{{item.k}}</text>
        <text class="tip-v">{{item.v}}</text>
      </view>
    </view>
    <view class="tip-atlas" bindtap="goAtlas" hover-class="tap-press" hover-stay-time="80">识别结果可存入「山海图鉴」，点亮对应的那一页 ›</view>
  </view>

  <!-- 合规：照片会传输至第三方大模型服务；按产品要求置于页面最下方 -->
  <view class="ai-privacy-note">
    <text class="ai-privacy-txt">照片将发送至第三方 AI 服务（阿里云通义千问）用于识别，仅用于本次鉴定与科普生成；如不希望照片被用于该用途，请勿使用本功能。详见「用户隐私保护政策」。</text>
  </view>

  <easter-egg-note id="easterEggNote" />
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal；utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
