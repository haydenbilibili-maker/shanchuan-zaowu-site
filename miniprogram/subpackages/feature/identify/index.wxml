<view class="page">
  <view class="hero" catchlongpress="onEasterEggLongPress" data-egg-id="lingyu">
    <text class="hero-en">AI SPECIMEN LAB</text>
    <text class="hero-cn">拍一张照片，读懂自然</text>
    <text class="hero-sub">视觉识别 + 科普手记 · 关联馆藏档案与可购藏品</text>
  </view>

  <view class="free-banner">
    <text class="free-badge">当前免费</text>
    <text class="free-txt">不限次数体验 · 结果仅供参考，请以实物为准</text>
  </view>

  <view class="hint-block" wx:if="{{!busy}}">
    <text class="hint-title">我猜这是</text>
    <scroll-view scroll-x class="hint-scroll" enable-flex show-scrollbar="{{false}}">
      <view class="hint-inner">
        <view
          class="hint-chip {{categoryHint === item.id ? 'active' : ''}}"
          wx:for="{{categoryHints}}"
          wx:key="id"
          bindtap="onCategoryHint"
          data-id="{{item.id}}"
          hover-class="tap-press"
          hover-stay-time="80"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="actions">
    <button class="btn primary" bindtap="onTakePhoto" disabled="{{busy}}">
      <image class="btn-ico" src="/assets/icons/camera.png" mode="aspectFit" />
      拍照识别
    </button>
    <button class="btn ghost" bindtap="onChooseAlbum" disabled="{{busy}}">从相册选择</button>
  </view>

  <view class="recent" wx:if="{{recentList.length && !busy}}">
    <view class="recent-head">
      <text class="recent-title">最近鉴定</text>
      <view class="recent-link" bindtap="goLog" hover-class="recent-item-press" hover-stay-time="80">
        <text>全部记录 ›</text>
      </view>
    </view>
    <view
      class="recent-item"
      wx:for="{{recentList}}"
      wx:key="_id"
      bindtap="openRecent"
      data-id="{{item._id}}"
      hover-class="recent-item-press"
      hover-stay-time="80"
    >
      <text class="recent-name">{{item.name}}</text>
      <text class="recent-time">{{item.timeText}}</text>
    </view>
  </view>

  <view class="loading-mask" wx:if="{{busy}}">
    <!-- 步骤与进度放进加载卡：放在遮罩下面时被压暗，等待 15–60 秒只看得到一个转圈 -->
    <view class="loading-core">
      <view class="spinner"></view>
      <text class="loading-txt">{{loadingText}}</text>
      <view class="steps">
        <view class="step {{loadingStep >= 1 ? 'done' : ''}}">入镜</view>
        <view class="step-line {{loadingStep >= 2 ? 'done' : ''}}"></view>
        <view class="step {{loadingStep >= 2 ? 'done' : ''}}">归档</view>
        <view class="step-line {{loadingStep >= 3 ? 'done' : ''}}"></view>
        <view class="step {{loadingStep >= 3 ? 'done' : ''}}">解读</view>
      </view>
      <view class="progress-bar" wx:if="{{uploadProgress > 0 && uploadProgress < 100}}">
        <view class="progress-fill" style="width: {{uploadProgress}}%;"></view>
      </view>
    </view>
  </view>

  <view class="tips">
    <text class="tip-title">拍摄建议</text>
    <text class="tip-line" wx:for="{{photoTips}}" wx:key="*this">· {{item}}</text>
    <text class="tip-line">· 识别结果可保存到「我的山海图鉴」</text>
  </view>

  <!-- 合规：照片会传输至第三方大模型服务；按产品要求置于页面最下方 -->
  <view class="ai-privacy-note">
    <text class="ai-privacy-txt">照片将发送至第三方 AI 服务（阿里云通义千问）用于识别，仅用于本次鉴定与科普生成；如不希望照片被用于该用途，请勿使用本功能。详见「用户隐私保护政策」。</text>
  </view>

  <easter-egg-note id="easterEggNote" />
</view>
