.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #1A1814;
  box-sizing: border-box;
}

.share-hero {
  margin-bottom: 24rpx;
  padding: 8rpx 8rpx 0;
}

.share-en {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: #C4A76C;
  font-style: italic;
  margin-bottom: 8rpx;
}

.share-title {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.share-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  color: #A09A90;
}

.canvas-wrap {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.poster-canvas {
  width: 600rpx;
  height: 960rpx;
  background: #1F1D1A;
  border-radius: var(--radius-md);
  border: 1rpx solid #4D401A;
}

.canvas-mask {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 36rpx;
  background: rgba(26, 24, 20, 0.88);
  border: 1rpx solid #4D401A;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: #C4A76C;
}

.spinner.small {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: #C4A76C;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.share-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.share-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #52B788;
}

.share-status-text {
  font-size: 22rpx;
  color: #A09A90;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-row {
  display: flex;
  gap: 12rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  border: none;
  background: #262320;
  color: #D5D1C8;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #C4A76C;
  color: #1A1814;
  font-weight: 500;
}

.btn.ghost {
  background: transparent;
  color: #C4A76C;
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  box-sizing: border-box;
}

.btn.compact {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 24rpx;
}

.btn[disabled] {
  opacity: 0.45;
}
