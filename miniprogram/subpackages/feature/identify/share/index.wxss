.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #1A1814;
  box-sizing: border-box;
}

.share-hero {
  margin-bottom: 24rpx;
  padding: 8rpx 8rpx 0;
}

.share-en {
  display: block;
  font-size: var(--fs-18);
  letter-spacing: 0.14em;
  color: var(--color-primary);
  font-style: italic;
  margin-bottom: 8rpx;
}

.share-title {
  display: block;
  font-size: var(--fs-36);
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.share-desc {
  display: block;
  font-size: var(--fs-24);
  line-height: 1.55;
  color: #A09A90;
}

.canvas-wrap {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.poster-canvas {
  width: 600rpx;
  height: 960rpx;
  background: #1F1D1A;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--brass-800);
}

.canvas-mask {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 36rpx;
  background: rgba(26, 24, 20, 0.88);
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  font-size: var(--fs-24);
  color: var(--color-primary);
}

.spinner.small {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.share-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.share-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-success);
}

.share-status-text {
  font-size: var(--fs-22);
  color: #A09A90;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-row {
  display: flex;
  gap: 12rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  border: none;
  background: #262320;
  color: #D5D1C8;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: var(--color-primary);
  color: #1A1814;
  font-weight: 500;
}

.btn.ghost {
  background: transparent;
  color: var(--color-primary);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  box-sizing: border-box;
}

.btn.compact {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--fs-24);
}

.btn[disabled] {
  opacity: 0.45;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .spinner.small {
    animation: none;
  }
}
