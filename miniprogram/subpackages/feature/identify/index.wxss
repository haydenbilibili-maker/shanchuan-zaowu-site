.page {
  min-height: 100vh;
  width: 100%;
  max-width: 100%;
  padding: 48rpx 32rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
  overflow-x: hidden;
}

.hero {
  margin-bottom: 56rpx;
}

.hero-en {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.35em;
  color: rgba(196, 167, 108, 0.75);
  margin-bottom: 16rpx;
}

.hero-cn {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.hero-sub {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.5;
}

.free-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
  padding: 24rpx 32rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid #4D401A;
  border-radius: 16rpx;
}

.free-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: #1A1814;
  background: #C4A76C;
  padding: 6rpx 14rpx;
  border-radius: 9999px;
}

.free-txt {
  font-size: 24rpx;
  color: #D5D1C8;
  line-height: 1.45;
}

.hint-block {
  margin-bottom: 36rpx;
}

.hint-title {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  margin-bottom: 16rpx;
  letter-spacing: 0.08em;
}

.hint-scroll {
  width: 100%;
  white-space: nowrap;
}

.hint-inner {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding-bottom: 4rpx;
  padding-right: 32rpx;
}

.hint-chip {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #A09A90;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  border-radius: 9999px;
}

.hint-chip.active {
  color: #C4A76C;
  background: rgba(196, 167, 108, 0.12);
  border-color: rgba(196, 167, 108, 0.4);
}

.hint-chip-press {
  opacity: 0.82;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #C4A76C;
  color: #1A1814;
  font-weight: 500;
}

.btn.primary:active {
  background: #A8903C;
}

.btn.ghost {
  background: transparent;
  color: #C4A76C;
  border: 1px solid #C4A76C;
  overflow: visible;
  box-sizing: border-box;
}

.btn.ghost::after {
  border: none;
}

.btn.ghost:active {
  background: rgba(196, 167, 108, 0.08);
}

.btn.link {
  background: transparent;
  color: rgba(196, 167, 108, 0.85);
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.btn[disabled] {
  opacity: 0.45;
}

.btn-ico {
  width: 40rpx;
  height: 40rpx;
}

.progress-wrap {
  margin-top: 40rpx;
}

.progress-bar {
  height: 8rpx;
  background: #262320;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #C4A76C;
  transition: width 0.2s ease;
}

.progress-txt {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #A09A90;
}

.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(26, 24, 20, 0.72);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-core {
  padding: 48rpx 56rpx;
  background: #1F1D1A;
  border-radius: 24rpx;
  border: 1rpx solid #4D401A;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: #C4A76C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-txt {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #D5D1C8;
}

.tips {
  margin-top: 48rpx;
  padding: 32rpx;
  background: #1F1D1A;
  border-radius: 24rpx;
  border: 1rpx solid #262320;
}

.tip-title {
  display: block;
  font-size: 24rpx;
  color: #C4A76C;
  margin-bottom: 16rpx;
}

.tip-line {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  padding: 0 20rpx;
}

.step {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  padding: 8rpx 16rpx;
  border-radius: 9999px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.step.done {
  color: #C4A76C;
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.1);
}

.step-line {
  width: 40rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.12);
}

.step-line.done {
  background: rgba(196, 167, 108, 0.5);
}

.recent {
  margin-top: 48rpx;
  padding: 32rpx;
  background: #1F1D1A;
  border-radius: 24rpx;
  border: 1px solid #262320;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.recent-title {
  font-size: 24rpx;
  color: #C4A76C;
}

.recent-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #6B6560;
}

.recent-link-icon {
  width: 28rpx;
  height: 28rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1px solid #262320;
}

.recent-item:active,
.recent-item-press {
  opacity: 0.85;
}

.recent-name {
  font-size: 26rpx;
  color: #D5D1C8;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.recent-time {
  font-size: 22rpx;
  color: #6B6560;
  flex-shrink: 0;
}

/* 第三方 AI 处理告知（合规）：置于页面最下方，弱化但可读 */
.ai-privacy-note {
  margin: 32rpx 0 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1rpx solid rgba(196, 167, 108, 0.18);
}
.ai-privacy-txt {
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--color-text-muted);
}
