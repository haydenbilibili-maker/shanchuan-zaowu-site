/* subpackages/feature/custom/index.wxss */
page { background: #1A1814; color: #fff; }

view, text, image { box-sizing: border-box; }

.page-custom { min-height: 100vh; position: relative; }

.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.03; z-index: 0;
}

.sticky-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(26, 24, 20, 0.96);
  border-bottom: 1px solid rgba(38, 35, 32, 0.6);
  backdrop-filter: blur(12px);
}

.nav-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 24rpx 0; min-height: 56rpx;
}

.nav-brand {
  flex: 1; min-width: 0; text-align: center; padding: 0 8rpx;
}

.nav-brand .nav-title {
  display: block; font-size: 32rpx; font-weight: 600;
  letter-spacing: 0.06em; color: #FFFFFF;
}

.nav-sub {
  display: block; font-size: 20rpx; color: #C4A76C;
  letter-spacing: 0.1em; margin-top: 4rpx;
}

.nav-motto {
  padding: 12rpx 32rpx 16rpx;
  border-bottom: 1px solid rgba(38, 35, 32, 0.45);
  width: 100%;
}

.motto-primary {
  display: block; font-size: 28rpx; color: #E0CFA3;
  line-height: 1.45; letter-spacing: 0.08em;
  font-family: var(--font-brand);
}

.motto-secondary {
  display: block; margin-top: 6rpx;
  font-size: 22rpx; color: #6B6560; line-height: 1.4;
}

/* 全宽五步进度 — 不受 nav-row 胶囊避让 padding 影响 */
.header-rail-full {
  width: 100%;
  box-sizing: border-box;
  background: rgba(31, 29, 26, 0.92);
  border-bottom: 1px solid rgba(77, 64, 26, 0.35);
  padding: 20rpx 24rpx 24rpx;
}

.atelier-rail {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}

.rail-col {
  flex: 1 1 0;
  width: 0;
  display: flex; flex-direction: column; align-items: center;
}

.rail-top {
  display: flex; align-items: center; width: 100%;
  justify-content: center; position: relative;
  margin-bottom: 10rpx;
}

.rail-dot {
  position: relative; z-index: 2;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #33302C;
  background: #1A1814;
  display: flex; align-items: center; justify-content: center;
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
}

.rail-dot.filled {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.12);
}

.rail-dot.active {
  border-color: #C4A76C;
  background: #C4A76C;
}

.rail-num {
  font-size: 22rpx; font-weight: 600; color: #6B6560;
  font-family: var(--font-mono);
}

.rail-dot.filled .rail-num { color: #C4A76C; }
.rail-dot.active .rail-num { color: #1A1814; }

.rail-line {
  position: absolute; left: calc(50% + 22rpx); right: calc(-50% + 22rpx);
  top: 50%; height: 4rpx; margin-top: -2rpx;
  background: #262320; z-index: 1;
  transition: background var(--dur-base) var(--ease-standard);
}

.rail-line.filled { background: rgba(196, 167, 108, 0.45); }

.rail-label {
  font-size: 22rpx; color: #6B6560; line-height: 1.2;
  text-align: center; transition: color var(--dur-fast) var(--ease-standard);
  white-space: nowrap;
}

.rail-col.past .rail-label { color: #A09A90; }

.rail-col.current .rail-label {
  color: #C4A76C; font-weight: 600; font-size: 24rpx;
}

/* 内容区步骤引导 */
.panel-lead {
  padding: 8rpx 32rpx 24rpx;
  border-bottom: 1px solid rgba(38, 35, 32, 0.55);
  margin-bottom: 8rpx;
}

.panel-lead-head {
  display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx;
}

.panel-title {
  font-size: 36rpx; font-weight: 600; color: #FFFFFF;
}

.panel-index {
  font-size: 24rpx; color: #6B6560;
  font-family: var(--font-mono);
  flex-shrink: 0;
}

.panel-desc {
  display: block; margin-top: 8rpx;
  font-size: 24rpx; color: #A09A90; line-height: 1.5;
}

.main-scroll {
  /* 2026-09-21 分子级审计：底栏 `.footer-bar` 的高度含 `env(safe-area-inset-bottom)`（见本文件 .footer-bar
     的 padding），而这里的预留是**固定 rpx** → 两者不可能同时成立：带 Home Indicator 的机型上
     底栏顶边会压住滚动区末尾（算术见交付报告）。加上同一项 env() 后，「安全区」这一项被抵消。 */
  position: fixed; left: 0; right: 0; bottom: calc(200rpx + env(safe-area-inset-bottom)); box-sizing: border-box;
}

.loading-wrap { padding: 120rpx 0; text-align: center; color: #6B6560; }

.step-panel { padding: 16rpx 32rpx 32rpx; }

.workbench {
  display: flex; gap: 24rpx; padding: 24rpx; margin-bottom: 28rpx;
  background: #1F1D1A; border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
}

.workbench-visual {
  position: relative; width: 168rpx; height: 208rpx; flex-shrink: 0;
}

.workbench-frame {
  position: absolute; inset: 0; z-index: 2; pointer-events: none;
  border: 6rpx solid #C4A76C; border-radius: var(--radius-sm);
  box-shadow: inset 0 0 0 2rpx rgba(196, 167, 108, 0.25);
}

.workbench-img {
  position: absolute; inset: 14rpx; width: calc(100% - 28rpx); height: calc(100% - 28rpx);
  border-radius: 2rpx; background: #262320;
}

.workbench-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }

.workbench-overline {
  font-size: 22rpx; color: #C4A76C;
}

.workbench-species {
  display: block; font-size: 28rpx; font-weight: 600; color: #FFFFFF;
  margin-top: 8rpx; line-height: 1.35;
}

.workbench-latin {
  display: block; font-size: 22rpx; color: #C4A76C; font-style: italic;
  margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.workbench-row {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 16rpx; padding-top: 12rpx;
  border-top: 1px solid rgba(38, 35, 32, 0.7);
}

.workbench-key { font-size: 22rpx; color: #6B6560; }
.workbench-val { font-size: 24rpx; color: #D5D1C8; }
.workbench-val.gold { color: #C4A76C; font-weight: 600; font-family: var(--font-mono); }

.step-context {
  padding: 16rpx 20rpx; margin-bottom: 24rpx;
  background: rgba(196, 167, 108, 0.06); border: 1px solid rgba(77, 64, 26, 0.4);
  border-radius: var(--radius-md);
}

.ctx-line { font-size: 24rpx; color: #A09A90; }

.gift-plate {
  padding: 16rpx 20rpx; margin-bottom: 8rpx;
  background: rgba(196, 167, 108, 0.06); border-left: 4rpx solid #C4A76C;
  border-radius: 0 12rpx 12rpx 0;
}

.gift-plate-desc {
  display: block; font-size: 24rpx; color: #A09A90; line-height: 1.5;
}

.preview-hero {
  display: flex; gap: 24rpx; align-items: center;
  margin-bottom: 28rpx; padding-bottom: 24rpx;
  border-bottom: 1px solid rgba(38, 35, 32, 0.8);
}

.preview-frame {
  position: relative; width: 160rpx; height: 196rpx; flex-shrink: 0;
  border: 5rpx solid #C4A76C; border-radius: var(--radius-sm); padding: 10rpx;
  background: rgba(196, 167, 108, 0.08);
}

.preview-hero-img {
  width: 100%; height: 100%; display: block; background: #262320;
}

.preview-hero-meta { flex: 1; min-width: 0; }

.preview-hero-name {
  display: block; font-size: 32rpx; font-weight: 600; color: #FFFFFF; line-height: 1.35;
}

.preview-hero-latin {
  display: block; font-size: 24rpx; color: #C4A76C; font-style: italic; margin-top: 8rpx;
}

.step-title {
  display: block; font-size: 36rpx; font-weight: 600; margin-bottom: 12rpx;
}

.step-desc {
  display: block; font-size: 24rpx; color: #A09A90; margin-bottom: 28rpx;
}

.search-box {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx 24rpx; background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.8); border-radius: var(--radius-md); margin-bottom: 20rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-spacer { width: 72rpx; flex-shrink: 0; }

.search-input { flex: 1; font-size: 26rpx; color: #D5D1C8; }

.search-clear {
  width: 44rpx; height: 44rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #6B6560; flex-shrink: 0;
}

.pill-scroll { white-space: nowrap; margin-bottom: 24rpx; height: 64rpx; }

.pill {
  display: inline-flex; padding: 12rpx 28rpx; margin-right: 16rpx;
  border-radius: 9999px; border: 1px solid rgba(38, 35, 32, 0.8);
  background: #1F1D1A; font-size: 24rpx; color: #A09A90;
}

.pill.active { border-color: rgba(196,167,108,0.5); color: #C4A76C; background: rgba(196,167,108,0.1); }

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  width: 100%;
}

.product-cell {
  min-width: 0;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.product-cell:active { opacity: 0.92; }

.product-cell.selected {
  border-color: #4D401A;
  background: rgba(196, 167, 108, 0.06);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.25);
}

.product-thumb-wrap {
  position: relative;
  width: 100%;
}

.product-img {
  width: 100%;
  height: 280rpx;
  display: block;
  background: #262320;
}

.custom-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  display: inline-flex;
  align-items: center;
  width: auto;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: #C4A76C;
  background: rgba(26, 24, 20, 0.72);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-sm);
  letter-spacing: 0.04em;
  white-space: nowrap;
  box-sizing: border-box;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.35;
  min-height: 68rpx;
}

.product-latin {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #C4A76C;
  font-style: italic;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product-price {
  font-size: 28rpx;
  color: #C4A76C;
  font-weight: 600;
  font-family: var(--font-mono);
}

.selected-chip {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx; background: rgba(196,167,108,0.08);
  border: 1rpx solid rgba(196,167,108,0.2); border-radius: var(--radius-md); margin-bottom: 24rpx;
}

.selected-chip image { width: 80rpx; height: 80rpx; border-radius: var(--radius-md); }

.option-section { margin-bottom: 28rpx; }

.option-label {
  display: block; font-size: 24rpx; color: #A09A90; margin-bottom: 16rpx;
}

.option-pills { display: flex; flex-wrap: wrap; gap: 12rpx; }

.option-pill {
  padding: 12rpx 24rpx; border-radius: 9999px;
  border: 1px solid rgba(38, 35, 32, 0.8); font-size: 24rpx; color: #D5D1C8;
}

.option-pill.active { border-color: #C4A76C; color: #C4A76C; background: rgba(196,167,108,0.1); }
.option-pill.disabled { opacity: 0.35; pointer-events: none; }

.config-card {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  padding: 24rpx; margin-bottom: 16rpx; background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.8); border-radius: var(--radius-md);
  transition: border-color var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
}

.config-card.active {
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.06);
  box-shadow: inset 3rpx 0 0 #C4A76C;
}

.config-name { display: block; font-size: 28rpx; font-weight: 600; }
.config-desc { display: block; font-size: 22rpx; color: #6B6560; margin-top: 6rpx; }
.config-price { font-size: 24rpx; color: #C4A76C; flex-shrink: 0; }

.toggle-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0; border-bottom: 1px solid rgba(38, 35, 32, 0.6);
  font-size: 26rpx; color: #D5D1C8;
}

.greeting-input {
  width: 100%; min-height: 160rpx; margin: 16rpx 0 24rpx; padding: 20rpx;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: var(--radius-md); font-size: 26rpx; color: #D5D1C8; box-sizing: border-box;
}

.preview-plate {
  padding: 28rpx; background: #FAF6ED; border: 1px solid #E0CFA3;
  border-radius: var(--radius-md); margin-bottom: 32rpx;
}

.preview-row {
  display: flex; justify-content: space-between; gap: 20rpx;
  padding: 12rpx 0; border-bottom: 1px solid rgba(139, 111, 71, 0.15);
}

.preview-label { font-size: 22rpx; color: #8B6F47; }
.preview-value { font-size: 24rpx; color: #6B5A24; text-align: right; flex: 1; }
.preview-value.latin { font-style: italic; color: #C4A76C; }

.price-breakdown {
  padding: 24rpx; background: #1F1D1A; border-radius: var(--radius-lg);
  border: 1px solid rgba(38, 35, 32, 0.8);
}

.price-row {
  display: flex; justify-content: space-between; padding: 12rpx 0;
  font-size: 26rpx; color: #D5D1C8;
}

.price-row.total { border-top: 1px solid rgba(38, 35, 32, 0.8); margin-top: 8rpx; padding-top: 20rpx; }
.price-row .gold { color: #C4A76C; font-weight: 600; font-size: 32rpx; }

.estimate-tip {
  display: block; margin-top: 16rpx; font-size: 22rpx; color: #6B6560; line-height: 1.5;
}
.estimate-tip.refund { color: #C4A76C; }

.empty-hint { text-align: center; padding: 60rpx; color: #6B6560; font-size: 26rpx; }

.section-label {
  display: block; font-size: 22rpx; color: #C4A76C; letter-spacing: 0.08em; margin-bottom: 16rpx;
}

.draft-section { margin-bottom: 28rpx; }

.draft-scroll { white-space: nowrap; }

.draft-card {
  display: inline-flex; align-items: center; margin-right: 16rpx;
  background: #1F1D1A; border: 1px solid rgba(77, 64, 26, 0.5);
  border-radius: var(--radius-md); overflow: hidden; max-width: 320rpx;
}

.draft-main { padding: 20rpx 24rpx; flex: 1; min-width: 0; }

.draft-title {
  display: block; font-size: 24rpx; color: #D5D1C8;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.draft-sub { display: block; font-size: 20rpx; color: #6B6560; margin-top: 4rpx; }

.draft-del {
  width: 56rpx; align-self: stretch; display: flex; align-items: center; justify-content: center;
  color: var(--color-text-secondary); font-size: 32rpx; background: rgba(38, 35, 32, 0.5);
}

.option-hint {
  display: block; font-size: 22rpx; color: #6B6560; margin: -8rpx 0 16rpx;
}

.framer-card {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx; margin-bottom: 16rpx;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: var(--radius-md);
}

.framer-card.active { border-color: #4D401A; background: rgba(196, 167, 108, 0.08); }

.framer-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; }

.framer-main { flex: 1; min-width: 0; }

.framer-meta { text-align: right; flex-shrink: 0; }

.framer-days { display: block; font-size: 20rpx; color: #A09A90; margin-top: 4rpx; }

.share-row { margin-top: 24rpx; }

.btn-share {
  width: 100%; height: 80rpx; line-height: 80rpx;
  background: transparent; color: #C4A76C;
  border: 1px solid #4D401A; border-radius: var(--radius-md); font-size: 26rpx;
}

.btn-share::after { border: none; }

.escalation-section { margin-top: 32rpx; }

.escalation-card {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 28rpx; margin-bottom: 16rpx;
  background: #1F1D1A; border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
}

.escalation-card.ghost { border-color: rgba(38, 35, 32, 0.8); }

.esc-main { flex: 1; min-width: 0; }

.esc-title { display: block; font-size: 28rpx; color: #D5D1C8; font-weight: 500; }

.esc-desc { display: block; font-size: 22rpx; color: #6B6560; margin-top: 6rpx; line-height: 1.5; }

.esc-arrow { font-size: 28rpx; color: #C4A76C; flex-shrink: 0; }

.ar-preview-row {
  display: flex; gap: 16rpx; margin-top: 24rpx; margin-bottom: 8rpx;
}

.step5-ar { margin-top: 0; margin-bottom: 24rpx; }

.btn-ar {
  flex: 1; height: 72rpx; padding: 0;
  background: rgba(196, 167, 108, 0.15); color: #C4A76C;
  border: 1px solid #4D401A; border-radius: var(--radius-md); font-size: 24rpx;
  box-sizing: border-box; overflow: visible;
}

.btn-ar.ghost {
  background: transparent; color: #A09A90; border-color: rgba(38, 35, 32, 0.8);
}

.btn-ar::after { border: none; }

.scroll-pad { height: 40rpx; }

.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 101;
  background: rgba(26, 24, 20, 0.98); border-top: 1px solid rgba(38, 35, 32, 0.8);
  padding: 12rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}

.support-strip {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 20rpx; margin-bottom: 12rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-md);
}

.support-strip:active { opacity: 0.88; }

.support-strip-main { flex: 1; min-width: 0; }

.support-strip-title {
  display: block; font-size: 26rpx; font-weight: 500; color: #D5D1C8;
}

.support-strip-desc {
  display: block; font-size: 22rpx; color: #6B6560;
  margin-top: 4rpx; line-height: 1.4;
}

.support-strip-cta {
  flex-shrink: 0; font-size: 24rpx; color: #C4A76C;
}

.footer-top {
  display: flex; align-items: baseline; justify-content: flex-end;
  min-height: 36rpx; margin-bottom: 8rpx;
}

.footer-support {
  font-size: 24rpx; color: #A09A90; padding: 4rpx 0;
}

.footer-support:active { color: #C4A76C; }

.footer-price {
  display: flex; align-items: baseline; gap: 12rpx; margin-left: auto;
}

.footer-label { font-size: 22rpx; color: #6B6560; }
.footer-val { font-size: 36rpx; color: #C4A76C; font-weight: 600; }

.footer-actions { display: flex; gap: 16rpx; }

.btn-ghost, .btn-primary {
  flex: 1; min-width: 0; height: 84rpx; text-align: center;
  font-size: 28rpx; font-weight: 500; border-radius: var(--radius-md);
  box-sizing: border-box; margin: 0; padding: 0;
}

.btn-ghost {
  background: transparent; color: #C4A76C;
  border: 1rpx solid rgba(196, 167, 108, 0.45); overflow: visible;
}

.btn-primary { background: #C4A76C; color: #1A1814; border: none; overflow: hidden; }
.btn-ghost::after, .btn-primary::after { border: none; }
