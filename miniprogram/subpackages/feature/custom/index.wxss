/* 标本定制 · 定制工坊（2026-10-17 重构）
   页头眉标 + 宋体主标；五步进度 = 等宽编号 + 下划线（不用实心金圆点）；藏品图版 + 图下图注、选中金线环；
   装裱 / 包装 / 标本师 / 升级入口为发丝线行；第 5 步方案签 = 浅纸标本签；实心金只给底栏主按钮。
   页头三段高度与 subpackages/feature/utils/customNav.js 的 mottoHeight(88rpx) / stepBarHeight(148rpx) 对齐，勿改。 */
page { background: #1A1814; color: #F3ECDD; }

view, text, image { box-sizing: border-box; }

.page-custom { min-height: 100vh; position: relative; }

/* —— 页头 —— */
.sticky-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(26, 24, 20, 0.97);
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 32rpx 0;
  min-height: 56rpx;
}

.nav-brand { flex: 1; min-width: 0; padding: 0 8rpx; text-align: center; }

.nav-sub {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.nav-brand .nav-title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-34);
  font-weight: 600;
  letter-spacing: 0.16em;
  color: #F3ECDD;
}

/* 与 customNav.mottoHeight 对齐 */
.nav-motto {
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  text-align: center;
}

.motto-primary {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  letter-spacing: 0.2em;
  color: var(--brass-200);
}

.motto-secondary {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
}

/* 五步进度：与 customNav.stepBarHeight 对齐 */
.header-rail-full {
  width: 100%;
  height: 148rpx;
  padding: 28rpx 24rpx 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.atelier-rail { display: flex; width: 100%; }

.rail-col {
  flex: 1 1 0;
  width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rail-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-bottom: 12rpx;
}

.rail-dot {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx 6rpx;
  background: rgba(26, 24, 20, 0.97);
  border-bottom: 3rpx solid transparent;
  transition: border-color var(--dur-base) var(--ease-standard);
}

.rail-dot.active { border-bottom-color: var(--brass-400); }

.rail-num {
  font-family: var(--font-mono);
  font-size: var(--fs-26);
  letter-spacing: 0.04em;
  color: rgba(160, 154, 144, 0.7);
}

.rail-dot.filled .rail-num { color: var(--brass-300); }
.rail-dot.active .rail-num { color: #F3ECDD; font-weight: 600; }

.rail-line {
  position: absolute;
  left: calc(50% + 34rpx);
  right: calc(-50% + 34rpx);
  top: 50%;
  z-index: 1;
  height: 1rpx;
  margin-top: -4rpx;
  background: rgba(196, 167, 108, 0.16);
  transition: background var(--dur-base) var(--ease-standard);
}

.rail-line.filled { background: rgba(196, 167, 108, 0.5); }

.rail-label {
  font-size: var(--fs-22);
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  color: rgba(160, 154, 144, 0.8);
  transition: color var(--dur-fast) var(--ease-standard);
}

.rail-col.past .rail-label { color: var(--color-text-secondary, #A09A90); }
.rail-col.current .rail-label { color: var(--brass-200); font-weight: 500; }

/* —— 内容区 —— */
.main-scroll {
  /* 2026-09-21 分子级审计：底栏 `.footer-bar` 的高度含 `env(safe-area-inset-bottom)`，这里的预留同步加上，
     带 Home Indicator 的机型上底栏顶边才不会压住滚动区末尾。 */
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading-wrap { padding: 120rpx 0; text-align: center; color: var(--color-text-secondary, #A09A90); }

.panel-lead { padding: 28rpx 32rpx 20rpx; }

.panel-lead-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(196, 167, 108, 0.12) 60%, transparent) left bottom / 100% 1px no-repeat;
}

.panel-title {
  font-family: var(--font-brand);
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: #F3ECDD;
}

.panel-index {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.2em;
  color: var(--brass-300);
}

.panel-desc {
  display: block;
  margin-top: 14rpx;
  font-size: var(--fs-24);
  line-height: 1.55;
  color: var(--color-text-secondary, #A09A90);
}

.step-panel { padding: 8rpx 32rpx 32rpx; }

.section-label {
  display: block;
  margin-bottom: 16rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

/* —— 第 1 步：方案草稿 / 搜索 / 品类 / 藏品 —— */
.draft-section { margin-bottom: 32rpx; }
.draft-scroll { white-space: nowrap; }

.draft-card {
  display: inline-flex;
  align-items: center;
  max-width: 320rpx;
  margin-right: 16rpx;
  overflow: hidden;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.32);
}

.draft-main { flex: 1; min-width: 0; padding: 18rpx 22rpx; }

.draft-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-24);
  font-weight: 600;
  color: #F3ECDD;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-sub { display: block; margin-top: 4rpx; font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); }

.draft-del {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 56rpx;
  border-left: 1rpx solid rgba(196, 167, 108, 0.18);
  font-size: var(--fs-30);
  color: var(--color-text-secondary, #A09A90);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.24);
}

.search-input { flex: 1; background: transparent; font-size: var(--fs-26); color: #F3ECDD; }

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  font-size: var(--fs-32);
  color: var(--color-text-secondary, #A09A90);
}

/* 品类：下划线页签 */
.pill-scroll { height: 76rpx; margin-bottom: 24rpx; white-space: nowrap; }

.pill {
  display: inline-flex;
  margin-right: 36rpx;
  padding: 18rpx 0 14rpx;
  border-bottom: 3rpx solid transparent;
  font-size: var(--fs-26);
  color: var(--color-text-secondary, #A09A90);
}

.pill.active { border-bottom-color: var(--brass-400); color: #F3ECDD; font-weight: 500; }

/* 藏品：图版 + 图下图注；选中 = 金线环 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 32rpx 20rpx;
  width: 100%;
}

.product-cell { min-width: 0; }

.product-cell:active { opacity: 0.9; }

.product-thumb-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 4rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
}

.product-cell.selected .product-thumb-wrap { box-shadow: var(--ring-brass); }

.product-img {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #1F1D1A;
}

.custom-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 2rpx;
  background: rgba(26, 24, 20, 0.78);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.4);
  font-size: var(--fs-18);
  letter-spacing: 0.08em;
  white-space: nowrap;
  color: var(--brass-200);
}

.product-info { padding-top: 14rpx; }

.product-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  font-weight: 600;
  line-height: 1.35;
  color: #F3ECDD;
}

.product-latin {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-latin);
  font-style: italic;
  font-size: var(--fs-20);
  color: var(--color-text-latin, #C4A76C);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; }

.product-price { font-family: var(--font-mono); font-size: var(--fs-26); color: var(--brass-200); }

.empty-hint { padding: 60rpx; text-align: center; font-size: var(--fs-26); color: var(--color-text-secondary, #A09A90); }

/* —— 第 2 步：工作台 —— */
.workbench {
  display: flex;
  gap: 28rpx;
  margin-bottom: 36rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.workbench-visual { position: relative; flex-shrink: 0; width: 168rpx; height: 208rpx; }

/* 框：铜色细框 + 衬纸边，示意装裱 */
.workbench-frame {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  border: 4rpx solid #8B6F47;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 10rpx #E8DFCB;
}

.workbench-img {
  position: absolute;
  inset: 14rpx;
  width: calc(100% - 28rpx);
  height: calc(100% - 28rpx);
  background: #262320;
}

.workbench-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }

.workbench-overline {
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.workbench-species {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  font-weight: 600;
  line-height: 1.35;
  color: #F3ECDD;
}

.workbench-latin {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-latin);
  font-style: italic;
  font-size: var(--fs-22);
  color: var(--color-text-latin, #C4A76C);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workbench-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.workbench-key { font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); }
.workbench-val { font-size: var(--fs-24); color: var(--color-text-body, #D5D1C8); }
.workbench-val.gold { font-family: var(--font-mono); color: var(--brass-200); }

.option-section { margin-bottom: 36rpx; }

.option-label {
  display: block;
  margin-bottom: 16rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.option-hint { display: block; margin: -6rpx 0 16rpx; font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); }

/* 规格：方角发丝签，选中金线环 */
.option-pills { display: flex; flex-wrap: wrap; gap: 14rpx; }

.option-pill {
  padding: 12rpx 26rpx;
  border-radius: 2rpx;
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.24);
  font-size: var(--fs-24);
  color: var(--color-text-body, #D5D1C8);
}

.option-pill.active { box-shadow: var(--ring-brass); background: rgba(196, 167, 108, 0.08); color: var(--brass-200); }
.option-pill.disabled { opacity: 0.35; pointer-events: none; }

/* 框型 / 包装：发丝线行，选中 = 左侧铜签 + 底色 */
.config-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  transition: background var(--dur-fast) var(--ease-standard);
}

.option-section .config-card:first-of-type,
.step-context + .config-card { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.config-card.active { background: rgba(196, 167, 108, 0.06); box-shadow: var(--ring-brass); border-bottom-color: transparent; }

.config-name { display: block; font-family: var(--font-brand); font-size: var(--fs-28); font-weight: 600; color: #F3ECDD; }
.config-desc { display: block; margin-top: 6rpx; font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); }
.config-price { flex-shrink: 0; font-family: var(--font-mono); font-size: var(--fs-24); color: var(--brass-200); }

.framer-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.framer-card.active { background: rgba(196, 167, 108, 0.06); box-shadow: var(--ring-brass); border-bottom-color: transparent; }

.framer-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(196, 167, 108, 0.3);
}

.framer-main { flex: 1; min-width: 0; }
.framer-meta { flex-shrink: 0; text-align: right; }
.framer-days { display: block; margin-top: 4rpx; font-size: var(--fs-20); color: var(--color-text-secondary, #A09A90); }

/* AR 预览：两枚描边钮（实心金留给底栏） */
.ar-preview-row { display: flex; gap: 16rpx; margin: 28rpx 0 36rpx; }
.step5-ar { margin-top: 0; margin-bottom: 28rpx; }

.btn-ar {
  flex: 1;
  height: 72rpx;
  padding: 0;
  overflow: visible;
  border: none;
  border-radius: 4rpx;
  background: rgba(196, 167, 108, 0.08);
  box-shadow: var(--ring-brass-soft);
  font-size: var(--fs-24);
  letter-spacing: 0.06em;
  line-height: 72rpx;
  color: var(--brass-200);
  box-sizing: border-box;
}

.btn-ar.ghost { background: transparent; box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.32); color: var(--color-text-secondary, #A09A90); }
.btn-ar::after { border: none; }

/* —— 第 3 步：方案提示 —— */
.step-context { margin-bottom: 20rpx; padding: 4rpx 0 16rpx; }

.ctx-line { font-size: var(--fs-24); color: var(--color-text-secondary, #A09A90); }

/* —— 第 4 步：赠礼 —— */
.gift-plate { margin-bottom: 8rpx; padding: 4rpx 0 16rpx; }

.gift-plate-desc { display: block; font-size: var(--fs-24); line-height: 1.55; color: var(--color-text-secondary, #A09A90); }

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
  font-size: var(--fs-26);
  color: var(--color-text-body, #D5D1C8);
}

.greeting-input {
  width: 100%;
  min-height: 160rpx;
  margin: 20rpx 0 24rpx;
  padding: 24rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  font-family: var(--font-brand);
  font-size: var(--fs-26);
  line-height: 1.7;
  color: #2E2618;
  box-sizing: border-box;
}

/* —— 第 5 步：预览 —— */
.preview-hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 32rpx;
}

.preview-frame {
  position: relative;
  flex-shrink: 0;
  width: 160rpx;
  height: 196rpx;
  padding: 12rpx;
  border: 4rpx solid #8B6F47;
  border-radius: 2rpx;
  background: #E8DFCB;
}

.preview-hero-img { display: block; width: 100%; height: 100%; background: #262320; }

.preview-hero-meta { flex: 1; min-width: 0; }

.preview-hero-name {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-32);
  font-weight: 600;
  line-height: 1.35;
  color: #F3ECDD;
}

.preview-hero-latin {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-latin);
  font-style: italic;
  font-size: var(--fs-24);
  color: var(--color-text-latin, #C4A76C);
}

/* 方案签：浅纸标本签（铜钉 + 内发丝框 + 墨色两栏行） */
.preview-plate {
  position: relative;
  margin-bottom: 36rpx;
  padding: 44rpx 36rpx 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.42);
}

.preview-plate::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.plate-pin {
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border-radius: 50%;
  background: #B08D57;
}

.plate-eyebrow {
  display: block;
  margin-bottom: 8rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: #8B6F47;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(46, 38, 24, 0.12);
}

.preview-row:last-child { border-bottom: none; }

.preview-label { flex-shrink: 0; font-size: var(--fs-22); color: #8A7F6C; }
.preview-value { flex: 1; text-align: right; font-size: var(--fs-24); color: #2E2618; }
.preview-value.latin { font-family: var(--font-latin); font-style: italic; color: #5A4E3A; }

.price-breakdown { padding: 4rpx 0 0; border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.price-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: var(--fs-26);
  color: var(--color-text-body, #D5D1C8);
}

.price-row.total { margin-top: 8rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(196, 167, 108, 0.14); }
.price-row .gold { font-family: var(--font-mono); font-size: var(--fs-34); font-weight: 600; color: var(--brass-200); }

.estimate-tip { display: block; margin-top: 14rpx; font-size: var(--fs-22); line-height: 1.55; color: var(--color-text-secondary, #A09A90); }
.estimate-tip.refund { color: var(--brass-300); }

/* 升级入口：发丝线行 */
.escalation-section { margin-top: 40rpx; }

.escalation-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.escalation-section .section-label + .escalation-card { border-top: 1rpx solid rgba(196, 167, 108, 0.14); }

.esc-main { flex: 1; min-width: 0; }
.esc-title { display: block; font-family: var(--font-brand); font-size: var(--fs-28); font-weight: 600; color: #F3ECDD; }
.escalation-card.ghost .esc-title { font-family: inherit; font-weight: 400; color: var(--color-text-body, #D5D1C8); }
.esc-desc { display: block; margin-top: 6rpx; font-size: var(--fs-22); line-height: 1.5; color: var(--color-text-secondary, #A09A90); }
.esc-arrow { flex-shrink: 0; font-size: var(--fs-28); color: var(--brass-300); }

.share-row { margin-top: 32rpx; }

.btn-share {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
  border-radius: 4rpx;
  background: transparent;
  box-shadow: var(--ring-brass-soft);
  font-size: var(--fs-26);
  letter-spacing: 0.06em;
  color: var(--brass-300);
}

.btn-share::after { border: none; }

.scroll-pad { height: 40rpx; }

/* —— 底栏：专员一行 + 预估价 + 主按钮（本屏唯一实心金） —— */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  padding: 10rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(26, 24, 20, 0.98);
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.support-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0 14rpx;
}

.support-strip:active { opacity: 0.8; }

.support-strip-main { flex: 1; min-width: 0; display: flex; align-items: baseline; gap: 12rpx; }

.support-strip-title { flex-shrink: 0; font-size: var(--fs-24); color: var(--color-text-body, #D5D1C8); }

.support-strip-desc {
  min-width: 0;
  font-size: var(--fs-20);
  color: var(--color-text-secondary, #A09A90);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.support-strip-cta { flex-shrink: 0; font-size: var(--fs-24); color: var(--brass-300); }

.footer-top { display: flex; align-items: baseline; justify-content: flex-end; min-height: 36rpx; margin-bottom: 8rpx; }

.footer-price { display: flex; align-items: baseline; gap: 12rpx; margin-left: auto; }
.footer-label { font-size: var(--fs-22); color: var(--color-text-secondary, #A09A90); }
.footer-val { font-family: var(--font-mono); font-size: var(--fs-34); font-weight: 600; color: var(--brass-200); }

.footer-actions { display: flex; gap: 16rpx; }

.btn-ghost,
.btn-primary {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 4rpx;
  text-align: center;
  font-size: var(--fs-28);
  font-weight: 500;
  letter-spacing: 0.12em;
  line-height: 84rpx;
  box-sizing: border-box;
}

.btn-ghost {
  overflow: visible;
  border: none;
  background: transparent;
  box-shadow: inset 0 0 0 1rpx rgba(160, 154, 144, 0.4);
  color: var(--color-text-body, #D5D1C8);
}

.btn-primary { overflow: hidden; border: none; background: var(--brass-400); color: #1A1814; font-weight: 600; }

.btn-ghost::after,
.btn-primary::after { border: none; }
