/* subpackages/feature/custom/inquiry/index.wxss */
page { background: #1A1814; color: #fff; }

.page-inquiry { min-height: 100vh; }

.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.03; z-index: 0;
}

.sticky-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(26, 24, 20, 0.96);
  border-bottom: 1px solid rgba(38, 35, 32, 0.6);
}

.nav-row { display: flex; align-items: center; padding: 16rpx 32rpx 20rpx; gap: 16rpx; }
.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.nav-brand { flex: 1; }
.nav-title { display: block; font-size: 34rpx; font-weight: 600; }
.nav-sub { display: block; font-size: 20rpx; color: #C4A76C; letter-spacing: 0.1em; margin-top: 4rpx; }

/* 2026-09-21 分子级审计：底栏 `.footer` 的 padding 含 `env(safe-area-inset-bottom)`，
   而这里的预留是固定 140rpx → 有 Home Indicator 的机型上底栏压住滚动区末尾。补同一项 env()。 */
.main-scroll { position: fixed; left: 0; right: 0; bottom: calc(140rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.loading-wrap { padding: 120rpx 0; text-align: center; color: #6B6560; }

.load-error-box {
  padding: 80rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.load-error-title { color: #FFFFFF; font-size: 32rpx; font-weight: 500; }
.load-error-desc { color: #A09A90; font-size: 26rpx; line-height: 1.5; margin-bottom: 24rpx; }
.load-error-actions { width: 100%; display: flex; flex-direction: column; gap: 20rpx; }
.btn-ghost {
  height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: var(--radius-md); border: 1rpx solid #C4A76C; color: #C4A76C; font-size: 28rpx;
}

.intro-box {
  margin: 24rpx 32rpx; padding: 24rpx;
  background: rgba(196, 167, 108, 0.08); border: 1px solid rgba(77, 64, 26, 0.5);
  border-radius: var(--radius-md); font-size: 26rpx; color: #A09A90; line-height: 1.6;
}

.preview-plate {
  margin: 0 32rpx 24rpx; padding: 28rpx;
  background: #FAF6ED; border: 1px solid #E0CFA3; border-radius: var(--radius-md);
}

.plate-label {
  display: block; font-size: 22rpx; color: #8B6F47; margin-bottom: 16rpx; letter-spacing: 0.06em;
}

.preview-row {
  display: flex; justify-content: space-between; gap: 20rpx;
  padding: 10rpx 0; border-bottom: 1px solid rgba(139, 111, 71, 0.12);
}

.preview-row:last-child { border-bottom: none; }
.preview-label { font-size: 22rpx; color: #8B6F47; }
.preview-value { font-size: 24rpx; color: #6B5A24; text-align: right; flex: 1; }
.preview-value.latin { color: #C4A76C; font-style: italic; }

.form-panel { margin: 0 32rpx; }

.form-row {
  margin-bottom: 28rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx;
}

.form-row.block { flex-direction: column; align-items: stretch; }

.form-label { width: 160rpx; font-size: 26rpx; color: #D5D1C8; flex-shrink: 0; }

.form-input {
  flex: 1; min-width: 200rpx; height: 72rpx; padding: 0 24rpx;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: var(--radius-md); color: #fff; font-size: 28rpx;
}

.form-textarea {
  width: 100%; min-height: 160rpx; padding: 20rpx 24rpx; box-sizing: border-box;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: var(--radius-md); color: #fff; font-size: 28rpx;
}

.form-hint { font-size: 22rpx; color: #6B6560; width: 100%; padding-left: 160rpx; }

.scroll-pad { height: 40rpx; }

.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(26, 24, 20, 0.98); border-top: 1px solid rgba(38, 35, 32, 0.6);
}

.btn-primary {
  background: #C4A76C; color: #1A1814; border: none; border-radius: var(--radius-md);
  font-size: 28rpx; font-weight: 500; height: 88rpx; line-height: 88rpx;
}

.btn-primary::after { border: none; }
