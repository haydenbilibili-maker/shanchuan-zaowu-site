<!--subpackages/feature/custom/inquiry/index.wxml-->
<view class="page-inquiry">
  <view class="grain-overlay"></view>

  <view class="sticky-header" >
    <view class="nav-row">
      <view class="nav-brand">
        <text class="nav-title">企业团购意向</text>
        <text class="nav-sub">ATELIER · ENTERPRISE</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="main-scroll" style="top: {{headerHeight}}px;">
    <view class="loading-wrap" wx:if="{{loading}}"><text>加载方案…</text></view>

    <view class="load-error-box" wx:elif="{{loadError}}">
      <text class="load-error-title">方案加载失败</text>
      <text class="load-error-desc">定制方案无效或已失效，请返回工坊重新配置</text>
      <view class="load-error-actions">
        <view hover-class="tap-press" hover-stay-time="80" class="btn-primary" bindtap="retryLoad" wx:if="{{draftId}}">重新加载</view>
        <view hover-class="tap-press" hover-stay-time="80" class="btn-ghost" bindtap="goCustomHub">返回工坊</view>
      </view>
    </view>

    <block wx:else>
      <view class="intro-box">
        <text>10 件以上定制，由专员一对一报价跟进。提交后无需立即支付，确认方案后再下单。</text>
      </view>

      <view class="preview-plate" wx:if="{{previewLines.length}}">
        <text class="plate-label">当前方案 · {{planTitle}}</text>
        <view class="preview-row" wx:for="{{previewLines}}" wx:key="label">
          <text class="preview-label">{{item.label}}</text>
          <text class="preview-value {{item.latin ? 'latin' : ''}}">{{item.value}}</text>
        </view>
      </view>

      <view class="form-panel">
        <view class="form-row">
          <text class="form-label">定制数量</text>
          <input class="form-input" type="number" value="{{quantity}}" bindinput="onQuantityChange" data-field="quantity"/>
          <text class="form-hint">至少 10 件</text>
        </view>
        <view class="form-row">
          <text class="form-label">单位 / 公司</text>
          <input class="form-input" placeholder="选填" value="{{companyName}}" bindinput="onInput" data-field="companyName"/>
        </view>
        <view class="form-row">
          <text class="form-label">联系人</text>
          <input class="form-input" placeholder="您的姓名" value="{{contactName}}" bindinput="onInput" data-field="contactName"/>
        </view>
        <view class="form-row">
          <text class="form-label">手机号</text>
          <input class="form-input" type="number" maxlength="11" placeholder="便于专员联系" value="{{contactPhone}}" bindinput="onInput" data-field="contactPhone"/>
        </view>
        <view class="form-row block">
          <text class="form-label">补充需求</text>
          <textarea class="form-textarea" placeholder="如：统一包装、分批发货、定制 logo 腰封等" maxlength="300" value="{{message}}" bindinput="onInput" data-field="message"></textarea>
        </view>
      </view>
    </block>

    <view class="scroll-pad"></view>
  </scroll-view>

  <view class="footer safe-area" wx:if="{{!loading && customMeta}}">
    <button class="btn-primary" bindtap="submitInquiry" loading="{{submitting}}" disabled="{{submitting}}">提交团购意向</button>
  </view>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal；utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
