<!--subpackages/feature/custom/index.wxml-->
<wxs module="fmt">
module.exports.priceDelta = function(item) {
  if (!item || !item.priceDelta) return '已含';
  return '+¥' + item.priceDelta;
}
</wxs>
<wxs src="../../../utils/latinDisplay.wxs" module="latin" />

<view class="page-custom">
  <view class="grain-overlay"></view>

  <view class="sticky-header" >
    <view class="nav-row" style="padding-right: {{navPaddingRight}}px;">
      <view class="nav-brand">
        <text class="nav-title">标本定制</text>
        <text class="nav-sub">SPECIMEN CUSTOM</text>
      </view>
    </view>

    <view class="nav-motto">
      <text class="motto-primary">把山海带回家</text>
      <text class="motto-secondary">五步完成方案 · 门店制作约 {{estimatedDays}} 个工作日</text>
    </view>

    <view class="header-rail-full">
      <view class="atelier-rail">
        <view
          class="rail-col {{currentStep > item.id ? 'past' : ''}} {{currentStep === item.id ? 'current' : ''}}"
          wx:for="{{steps}}"
          wx:key="id"
        >
          <view class="rail-top">
            <view class="rail-dot {{currentStep >= item.id ? 'filled' : ''}} {{currentStep === item.id ? 'active' : ''}}">
              <text class="rail-num">{{item.id}}</text>
            </view>
            <view class="rail-line {{currentStep > item.id ? 'filled' : ''}}" wx:if="{{index < steps.length - 1}}"></view>
          </view>
          <text class="rail-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="main-scroll" style="top: {{headerHeight}}px;">
    <view class="loading-wrap" wx:if="{{loading}}">
      <text>加载工坊配置…</text>
    </view>

    <block wx:else>
      <view class="panel-lead" wx:if="{{currentStepMeta}}">
        <view class="panel-lead-head">
          <text class="panel-title">{{currentStepMeta.title}}</text>
          <text class="panel-index">{{currentStep}} / 5</text>
        </view>
        <text class="panel-desc">{{currentStepMeta.desc}}</text>
      </view>

      <!-- Step 1 选标本 -->
      <view class="step-panel" wx:if="{{currentStep === 1}}">
        <view class="draft-section" wx:if="{{drafts.length > 0}}">
          <text class="section-label">我的方案</text>
          <scroll-view scroll-x class="draft-scroll" enable-flex show-scrollbar="{{false}}">
            <view class="draft-card" wx:for="{{drafts}}" wx:key="_id">
              <view hover-class="tap-press" hover-stay-time="80" class="draft-main" bindtap="loadDraft" data-id="{{item._id}}">
                <text class="draft-title">{{item.title}}</text>
                <text class="draft-sub">{{item.specimenTitle}}</text>
              </view>
              <view hover-class="tap-press" hover-stay-time="80" class="draft-del" bindtap="deleteDraft" data-id="{{item._id}}">×</view>
            </view>
          </scroll-view>
        </view>

        <view class="search-box">
          <icon type="search" size="14" color="#6B6560"></icon>
          <input
            class="search-input"
            placeholder="搜索物种、拉丁名或藏品名"
            value="{{searchKeyword}}"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
            confirm-type="search"
          />
          <view hover-class="tap-press" hover-stay-time="80" class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">×</view>
        </view>
        <scroll-view scroll-x class="pill-scroll" enable-flex show-scrollbar="{{false}}">
          <view hover-class="tap-press" hover-stay-time="80"
            class="pill {{activeCategory === item.id ? 'active' : ''}}"
            wx:for="{{categoryPills}}"
            wx:key="id"
            bindtap="switchCategory"
            data-id="{{item.id}}"
          >{{item.label}}</view>
        </scroll-view>
        <view class="product-grid">
          <view
            class="product-cell {{selectedProduct._id === item._id ? 'selected' : ''}}"
            wx:for="{{filteredProducts}}"
            wx:key="_id"
            bindtap="selectProductById" hover-class="tap-press-soft" hover-stay-time="80"
            data-id="{{item._id}}"
          >
            <view class="product-thumb-wrap">
              <image class="product-img" src="{{item.images[0]}}" mode="aspectFill" lazy-load></image>
              <text class="custom-tag">可定制</text>
            </view>
            <view class="product-info">
              <text class="product-name">{{item.title}}</text>
              <text class="product-latin" wx:if="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
              <view class="product-foot">
                <text class="product-price">¥{{item.price}} 起</text>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-hint" wx:if="{{products.length === 0}}">暂无可用藏品，请稍后再来或联系专员</view>
        <view class="empty-hint" wx:elif="{{filteredProducts.length === 0 && searchKeyword}}">未找到「{{searchKeyword}}」，试试其他关键词或切换品类</view>
      </view>

      <!-- Step 2 装裱 -->
      <view class="step-panel" wx:if="{{currentStep === 2}}">
        <view class="workbench" wx:if="{{selectedProduct}}">
          <view class="workbench-visual">
            <view class="workbench-frame"></view>
            <image class="workbench-img" src="{{selectedProduct.images[0]}}" mode="aspectFill"></image>
          </view>
          <view class="workbench-info">
            <text class="workbench-overline">当前方案</text>
            <text class="workbench-species">{{selectedProduct.title}}</text>
            <text class="workbench-latin" wx:if="{{latin.display(selectedProduct.latinName)}}">{{latin.display(selectedProduct.latinName)}}</text>
            <view class="workbench-row">
              <text class="workbench-key">框型</text>
              <text class="workbench-val">{{selectedFrameName}}</text>
            </view>
            <view class="workbench-row">
              <text class="workbench-key">预估</text>
              <text class="workbench-val gold">¥{{totalPreview}}</text>
            </view>
          </view>
        </view>
        <block wx:if="{{dimensionOptions.length}}">
          <view class="option-section" wx:for="{{dimensionOptions}}" wx:key="name">
            <text class="option-label">{{item.name}}</text>
            <view class="option-pills">
              <view hover-class="tap-press" hover-stay-time="80"
                class="option-pill {{selectedSpecs[item.name] === val.value ? 'active' : ''}} {{val.disabled ? 'disabled' : ''}}"
                wx:for="{{item.values}}"
                wx:for-item="val"
                wx:key="value"
                bindtap="selectDimension"
                data-dim="{{item.name}}"
                data-value="{{val.value}}"
              >{{val.value}}</view>
            </view>
          </view>
        </block>
        <view class="option-section">
          <text class="option-label">框型</text>
          <view hover-class="tap-press-soft" hover-stay-time="80"
            class="config-card {{selectedFrameId === item.id ? 'active' : ''}}"
            wx:for="{{frames}}"
            wx:key="id"
            bindtap="selectFrame"
            data-id="{{item.id}}"
          >
            <view class="config-main">
              <text class="config-name">{{item.name}}</text>
              <text class="config-desc">{{item.desc}}</text>
            </view>
            <text class="config-price">{{fmt.priceDelta(item)}}</text>
          </view>
        </view>
        <view class="ar-preview-row">
          <button class="btn-ar" bindtap="goARPreview" data-static="0">AR 试摆装裱</button>
          <button class="btn-ar ghost" bindtap="goARPreview" data-static="1">静态预览</button>
        </view>
        <view class="option-section" wx:if="{{framers.length}}">
          <text class="option-label">指定标本师（可选）</text>
          <text class="option-hint">特邀标本师可能加价并延长交期</text>
          <view hover-class="tap-press-soft" hover-stay-time="80"
            class="framer-card {{selectedFramerId === item.id ? 'active' : ''}}"
            wx:for="{{framers}}"
            wx:key="id"
            bindtap="selectFramer"
            data-id="{{item.id}}"
          >
            <image wx:if="{{item.avatar}}" class="framer-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="framer-main">
              <text class="config-name">{{item.name}}</text>
              <text class="config-desc">{{item.bio || (item.type === 'partner' ? '特邀标本师' : '门店制作')}}</text>
            </view>
            <view class="framer-meta">
              <text class="config-price" wx:if="{{item.priceDelta > 0}}">+¥{{item.priceDelta}}</text>
              <text class="config-price" wx:else>标准</text>
              <text class="framer-days" wx:if="{{item.extraDays > 0}}">+{{item.extraDays}}天</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Step 3 包装 -->
      <view class="step-panel" wx:if="{{currentStep === 3}}">
        <view class="step-context" wx:if="{{selectedProduct}}">
          <text class="ctx-line">{{selectedProduct.title}} · {{selectedFrameName}}</text>
        </view>
        <view hover-class="tap-press-soft" hover-stay-time="80"
          class="config-card {{selectedPackagingId === item.id ? 'active' : ''}}"
          wx:for="{{packaging}}"
          wx:key="id"
          bindtap="selectPackaging"
          data-id="{{item.id}}"
        >
          <view class="config-main">
            <text class="config-name">{{item.name}}</text>
            <text class="config-desc">{{item.desc}}</text>
          </view>
          <text class="config-price">{{fmt.priceDelta(item)}}</text>
        </view>
      </view>

      <!-- Step 4 赠礼 -->
      <view class="step-panel" wx:if="{{currentStep === 4}}">
        <view class="gift-plate">
          <text class="gift-plate-desc">品牌物种卡默认随单；可按需选手写祝福与仪式卡</text>
        </view>
        <view class="toggle-row">
          <text>品牌物种卡（默认随单）</text>
          <switch checked="{{brandCard}}" disabled color="#C4A76C" style="transform:scale(0.75)"/>
        </view>
        <view class="toggle-row">
          <text>手写祝福卡</text>
          <switch checked="{{greetingEnabled}}" bindchange="onGreetingSwitch" color="#C4A76C" style="transform:scale(0.75)"/>
        </view>
        <textarea
          wx:if="{{greetingEnabled}}"
          class="greeting-input"
          placeholder="写给 TA 的话（2-60 字，门店代笔书写）"
          maxlength="60"
          value="{{greeting}}"
          bindinput="onGreetingInput"
        ></textarea>
        <view class="toggle-row">
          <text>箱内仪式卡（自动填入产地信息）</text>
          <switch checked="{{ritualCard}}" bindchange="onRitualSwitch" color="#C4A76C" style="transform:scale(0.75)"/>
        </view>
        <view class="toggle-row">
          <text>匿名送礼（包裹内不含价格清单）</text>
          <switch checked="{{anonymous}}" bindchange="onAnonymousSwitch" color="#C4A76C" style="transform:scale(0.75)"/>
        </view>
      </view>

      <!-- Step 5 预览 -->
      <view class="step-panel" wx:if="{{currentStep === 5}}">
        <view class="preview-hero" wx:if="{{selectedProduct}}">
          <view class="preview-frame">
            <image class="preview-hero-img" src="{{selectedProduct.images[0]}}" mode="aspectFill"></image>
          </view>
          <view class="preview-hero-meta">
            <text class="preview-hero-name">{{selectedProduct.title}}</text>
            <text class="preview-hero-latin" wx:if="{{latin.display(selectedProduct.latinName)}}">{{latin.display(selectedProduct.latinName)}}</text>
          </view>
        </view>
        <view class="preview-plate">
          <view class="preview-row" wx:for="{{previewLines}}" wx:key="label">
            <text class="preview-label">{{item.label}}</text>
            <text class="preview-value {{item.latin ? 'latin' : ''}}">{{item.value}}</text>
          </view>
        </view>
        <view class="price-breakdown">
          <view class="price-row">
            <text>藏品</text>
            <text>¥{{unitPrice}}</text>
          </view>
          <view class="price-row" wx:if="{{customExtraPrice > 0}}">
            <text>装裱与包装</text>
            <text>+¥{{customExtraPrice}}</text>
          </view>
          <view class="price-row total">
            <text>预估合计（运费以确认订单为准）</text>
            <text class="gold">¥{{totalPreview}}</text>
          </view>
          <text class="estimate-tip">预计 {{displayEstimatedDays}} 个工作日内发出 · 支付前可在确认页使用礼券</text>
          <text class="estimate-tip refund">定制藏品按确认方案制作，下单后不接受退款</text>
        </view>
        <view class="ar-preview-row step5-ar">
          <button class="btn-ar" bindtap="goARPreview" data-static="0">AR 试摆装裱效果</button>
          <button class="btn-ar ghost" bindtap="goARPreview" data-static="1">静态墙面试摆</button>
        </view>
        <view class="escalation-section">
          <text class="section-label">需要更多帮助？</text>
          <view hover-class="tap-press-soft" hover-stay-time="80" class="escalation-card" bindtap="goBookStoreVisit">
            <view class="esc-main">
              <text class="esc-title">预约到店确认</text>
              <text class="esc-desc">保存方案后预约入店，与标本师当面确认框型与礼盒</text>
            </view>
            <text class="esc-arrow">→</text>
          </view>
          <view hover-class="tap-press-soft" hover-stay-time="80" class="escalation-card" bindtap="goEnterpriseInquiry">
            <view class="esc-main">
              <text class="esc-title">企业团购意向</text>
              <text class="esc-desc">10 件以上定制，提交意向由专员报价跟进</text>
            </view>
            <text class="esc-arrow">→</text>
          </view>
          <view hover-class="tap-press-soft" hover-stay-time="80" class="escalation-card ghost" bindtap="goToSupport">
            <view class="esc-main">
              <text class="esc-title">联系专员</text>
              <text class="esc-desc">非标尺寸、特殊物料等超纲需求</text>
            </view>
            <text class="esc-arrow">→</text>
          </view>
        </view>
        <view class="share-row">
          <button class="btn-share" bindtap="sharePlan">分享方案（不含价格）</button>
        </view>
      </view>
    </block>

    <view class="scroll-pad"></view>
  </scroll-view>

  <view class="footer-bar safe-area" wx:if="{{!loading}}">
    <view class="support-strip" bindtap="goToSupport" hover-class="tap-press-soft" hover-stay-time="80">
      <view class="support-strip-main">
        <text class="support-strip-title">需要专员协助？</text>
        <text class="support-strip-desc">非标尺寸、特殊物料、交期与到店确认</text>
      </view>
      <text class="support-strip-cta">联系专员 →</text>
    </view>
    <view class="footer-top" wx:if="{{selectedProduct && currentStep > 1}}">
      <view class="footer-price">
        <text class="footer-label">当前方案预估</text>
        <text class="footer-val">¥{{totalPreview}}</text>
      </view>
    </view>
    <view class="footer-actions">
      <button class="btn-ghost" bindtap="goPrev" wx:if="{{currentStep > 1}}">上一步</button>
      <button class="btn-primary" bindtap="goNext" wx:if="{{currentStep < 5}}">下一步</button>
      <button class="btn-primary" bindtap="submitCustomOrder" wx:if="{{currentStep === 5}}">立即定制购买</button>
    </view>
  </view>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal；utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
