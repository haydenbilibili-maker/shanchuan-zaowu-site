<!--subpackages/feature/custom/share/index.wxml-->
<view class="page-share">
  <view class="grain-overlay"></view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <text>加载方案…</text>
  </view>

  <view class="load-error-box" wx:elif="{{loadError}}">
    <text class="load-error-title">方案加载失败</text>
    <text class="load-error-desc">链接无效或已失效</text>
    <view class="load-error-actions">
      <button class="btn-primary" bindtap="retryLoad">重新加载</button>
      <button class="btn-ghost" bindtap="goCustom">去工坊看看</button>
    </view>
  </view>

  <block wx:else>
    <view class="hero">
      <image wx:if="{{specimenImage}}" class="hero-img" src="{{specimenImage}}" mode="aspectFill"></image>
      <view class="hero-mask"></view>
      <view class="hero-text">
        <text class="hero-overline">NATURE'S CREATIONS</text>
        <text class="hero-title">{{title}}</text>
        <text class="hero-sub">一份为你准备的藏品礼物</text>
      </view>
    </view>

    <view class="preview-plate">
      <text class="plate-label">方案摘要</text>
      <view class="preview-row" wx:for="{{previewLines}}" wx:key="label">
        <text class="preview-label">{{item.label}}</text>
        <text class="preview-value {{item.latin ? 'latin' : ''}}">{{item.value}}</text>
      </view>
    </view>

    <view class="tip-box">
      <text>此为礼物预览，不含价格信息。受礼人可据此了解心意，下单需由赠礼人完成。</text>
    </view>

    <view class="footer safe-area">
      <button class="btn-primary" bindtap="goCustom" disabled="{{!draftId}}" wx:if="{{showSpecimenCustom}}">我也要定制</button>
      <button class="btn-ghost" bindtap="goCustom" wx:else>返回工坊</button>
      <button class="btn-ghost" open-type="share" disabled="{{!shareToken}}">转发给 TA</button>
    </view>
  </block>
</view>
