/* subpackages/feature/custom/pet/index.wxss */
@import "../index.wxss";

.page-pet { min-height: 100vh; position: relative; }

/* —— 页头（2026-10-17）：眉标 + 主标 + 一行安心承诺；左对齐，不再居中堆三层 —— */
.page-pet .pet-head {
  padding: 20rpx 32rpx 24rpx;
}

.page-pet .pet-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.page-pet .pet-title {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-34);
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.04em;
  color: #F3ECDD;
}

/* 「无需立即支付」是本页最重要的安心信息（顾客最怕点一下就被扣钱）：
   一枚铜点 + 正文色，不再是胶囊描边条（胶囊在新语言里只给可点的东西） */
.page-pet .pet-assure {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.page-pet .pet-assure-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brass-400);
}

.page-pet .pet-assure-t {
  font-size: var(--fs-24);
  line-height: 1.45;
  color: var(--color-text-body);
}

/* —— 五段进度条：段 = 进度，下方「序号 + 步名」；当前段实心金（本页头唯一一处实心金），
   已走过的段半透金且可点回，未到的段只是一道发丝 —— */
.page-pet .pet-rail {
  display: flex;
  gap: 8rpx;
  padding: 0 32rpx 20rpx;
}

.page-pet .pet-rail-col {
  flex: 1 1 0;
  width: 0;
  padding-top: 8rpx;
}

.page-pet .pet-rail-seg {
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(196, 167, 108, 0.16);
  transition: background-color var(--dur-base) var(--ease-standard);
}

.page-pet .pet-rail-col.is-past .pet-rail-seg { background: rgba(196, 167, 108, 0.5); }
.page-pet .pet-rail-col.is-current .pet-rail-seg { background: var(--brass-400); }

.page-pet .pet-rail-cap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 14rpx;
  min-height: 44rpx;
}

.page-pet .pet-rail-num {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.page-pet .pet-rail-label {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.page-pet .pet-rail-col.is-past .pet-rail-num,
.page-pet .pet-rail-col.is-past .pet-rail-label { color: var(--color-text-body); }

.page-pet .pet-rail-col.is-current .pet-rail-num,
.page-pet .pet-rail-col.is-current .pet-rail-label { color: var(--brass-200); font-weight: 500; }

/* 底栏高度：步骤 1 含固定勾选，其余更矮 */
.page-pet .main-scroll {
  bottom: 188rpx;
}

.page-pet.step-consent .main-scroll {
  bottom: 318rpx;
}

.page-pet .scroll-pad {
  height: 64rpx;
}

.page-pet .panel-lead {
  padding: 28rpx 32rpx 24rpx;
  margin-bottom: 0;
  border-bottom: 1px solid rgba(38, 35, 32, 0.55);
}

.page-pet .panel-title {
  font-size: var(--fs-34);
  letter-spacing: 0.02em;
}

.page-pet .panel-desc {
  margin-top: 10rpx;
  color: #A09A90;
}

.step-enter {
  animation: pet-step-in 0.28s ease-out;
}

@keyframes pet-step-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.page-pet .step-panel {
  padding: 28rpx 32rpx 48rpx;
}

/* —— 知情条款（2026-10-17）：发丝线两栏行（左眉题、右正文），不再是左金条卡片 —— */
.notice-plates {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
  border-top: 1rpx solid rgba(196, 167, 108, 0.16);
}

.notice-plate {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.notice-plate-title {
  flex-shrink: 0;
  width: 168rpx;
  font-size: var(--fs-24);
  font-weight: 600;
  line-height: 1.55;
  letter-spacing: 0.04em;
  color: var(--brass-300);
  font-family: var(--font-brand);
}

.notice-plate-body {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-24);
  color: #D5D1C8;
  line-height: 1.55;
}

.section-label {
  display: block;
  font-size: var(--fs-24);
  font-weight: 500;
  color: #A09A90;
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
}

.section-hint {
  display: block;
  font-size: var(--fs-22);
  color: #6B6560;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.craft-preview { margin-top: 8rpx; margin-bottom: 8rpx; }

.craft-chip {
  padding: 20rpx 24rpx; margin-bottom: 12rpx;
  background: #1F1D1A; border-radius: var(--radius-md);
  border: 1px solid rgba(38, 35, 32, 0.8);
}

.craft-chip.preview {
  opacity: 0.9;
  pointer-events: none;
}

.craft-name { display: block; font-size: var(--fs-26); color: #D5D1C8; }
.craft-weeks { display: block; font-size: var(--fs-22); color: #6B6560; margin-top: 6rpx; }

/* 底栏固定勾选：始终可见，消除「灰按钮猜谜」 */
.consent-dock {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
}

.consent-dock.is-checked {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}

.consent-dock-press {
  background: rgba(196, 167, 108, 0.1);
  border-color: rgba(196, 167, 108, 0.4);
}

.consent-checkbox {
  flex-shrink: 0;
  margin-top: 2rpx;
  transform: scale(1.05);
}

.consent-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.consent-text {
  font-size: var(--fs-26);
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.4;
}

.consent-hint {
  font-size: var(--fs-20);
  color: #A09A90;
  line-height: 1.4;
}

.page-pet .btn-primary.btn-disabled,
.page-pet .btn-primary[disabled] {
  background: #262320 !important;
  color: #6B6560 !important;
  opacity: 1;
}

.form-group { margin-bottom: 36rpx; }

.form-label {
  display: block;
  font-size: var(--fs-24);
  font-weight: 500;
  color: #A09A90;
  letter-spacing: 0.04em;
  margin-bottom: 14rpx;
}

.form-hint {
  display: block;
  font-size: var(--fs-22);
  color: #6B6560;
  line-height: 1.45;
  margin: -4rpx 0 16rpx;
}

.form-ph { color: #6B6560; }

.form-input, .form-picker {
  width: 100%; height: 88rpx; padding: 0 28rpx; box-sizing: border-box;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  color: #FFFFFF;
  line-height: 88rpx;
}

.form-picker.is-placeholder { color: #6B6560; }

.form-textarea {
  width: 100%; min-height: 160rpx; padding: 24rpx 28rpx; box-sizing: border-box;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-md);
  font-size: var(--fs-28);
  color: #FFFFFF;
  line-height: 1.5;
  margin-top: 0;
}

.option-pills { display: flex; flex-wrap: wrap; gap: 16rpx; }

.option-pill {
  min-height: 64rpx;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-md);
  font-size: var(--fs-26);
  color: #A09A90;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.9);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: border-color var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
}

.option-pill-press {
  opacity: 0.88;
  border-color: rgba(196, 167, 108, 0.35);
}

.option-pill.active {
  color: var(--color-primary);
  border-color: var(--color-primary);
  background: rgba(196, 167, 108, 0.12);
  font-weight: 500;
}

.photo-row { display: flex; flex-wrap: wrap; gap: 16rpx; }

.photo-item, .photo-add {
  width: 168rpx; height: 168rpx; border-radius: var(--radius-md); overflow: hidden; position: relative;
}

.photo-item image { width: 100%; height: 100%; background: #262320; }

.photo-del {
  position: absolute; top: 8rpx; right: 8rpx;
  width: 44rpx; height: 44rpx;
  background: rgba(26, 24, 20, 0.78);
  border: 1rpx solid rgba(196, 167, 108, 0.25);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}

.photo-del-x { font-size: var(--fs-28); color: #D5D1C8; line-height: 1; }

.photo-add {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 4rpx;
  background: #1F1D1A;
  border: 1px dashed rgba(196, 167, 108, 0.35);
}

.photo-add-press {
  background: rgba(196, 167, 108, 0.08);
  border-color: rgba(196, 167, 108, 0.55);
}

.photo-add-plus { font-size: var(--fs-40); color: var(--color-primary); line-height: 1; }
.photo-add-label { font-size: var(--fs-22); color: #6B6560; }

.craft-card, .intake-card {
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-md);
  transition: border-color var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
}


.craft-card.active, .intake-card.active {
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.06);
  box-shadow: inset 4rpx 0 0 var(--color-primary);
}

.craft-card-head, .intake-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.craft-card-name, .intake-name {
  display: block;
  font-size: var(--fs-28);
  font-weight: 600;
  color: #FFFFFF;
}

.craft-card-check, .intake-check {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--color-primary);
  letter-spacing: 0.04em;
}

.craft-card-desc, .intake-desc {
  display: block;
  font-size: var(--fs-24);
  color: #A09A90;
  line-height: 1.55;
}

.craft-card-weeks {
  display: block;
  font-size: var(--fs-22);
  color: var(--color-primary);
  margin-top: 14rpx;
  letter-spacing: 0.02em;
}

.submit-tip {
  display: block;
  font-size: var(--fs-22);
  color: #6B6560;
  line-height: 1.55;
  margin-top: 4rpx;
  padding: 20rpx 24rpx;
  background: rgba(196, 167, 108, 0.04);
  border-radius: var(--radius-md);
  border: 1px solid rgba(77, 64, 26, 0.28);
}

.page-pet .preview-plate {
  padding: 28rpx;
  margin-bottom: 36rpx;
  background: #FAF6ED;
  border: 1px solid #E0CFA3;
  border-radius: var(--radius-md);
}

.preview-plate-title {
  display: block;
  font-size: var(--fs-22);
  color: #8B6F47;
  letter-spacing: 0.08em;
  margin-bottom: 12rpx;
}

.page-pet .preview-row {
  display: flex; justify-content: space-between; gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(139, 111, 71, 0.12);
}

.page-pet .preview-row:last-child { border-bottom: none; }
.page-pet .preview-label { font-size: var(--fs-22); color: #8B6F47; flex-shrink: 0; }
.page-pet .preview-value { font-size: var(--fs-24); color: #6B5A24; text-align: right; flex: 1; }

/* 底部：单行联系专员 + 明确启用提示，不抢主 CTA */
.page-pet .footer-bar {
  padding: 14rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(26, 24, 20, 0.98);
  border-top: 1px solid rgba(38, 35, 32, 0.75);
}

.page-pet .footer-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 40rpx;
  margin-bottom: 12rpx;
}

.page-pet .footer-meta-spacer {
  flex: 1;
  min-width: 0;
}

.page-pet .footer-support {
  flex-shrink: 0;
  margin-left: auto;
  font-size: var(--fs-24);
  color: #A09A90;
  letter-spacing: 0.02em;
  padding: 4rpx 0;
}

.footer-support-press {
  color: var(--color-primary);
}

.page-pet .footer-gate {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: var(--fs-22);
  color: #8B6F47;
  line-height: 1.35;
}

.page-pet .footer-gate.is-ready {
  color: #A09A90;
}

.page-pet .footer-actions { gap: 20rpx; }

.page-pet .btn-ghost {
  color: var(--color-primary);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  background: transparent;
}

.btn-ghost-press {
  background: rgba(196, 167, 108, 0.08);
}

.page-pet .btn-primary {
  background: var(--color-primary);
  color: #1A1814;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.btn-primary-press {
  background: #A8903C;
}

/* 需求 13：未上线交接方式置灰（comingSoon）—— 视觉禁用 + 不可点按反馈 */
.intake-card.is-soon {
  opacity: 0.5;
  background: #1B1917;
  border-style: dashed;
}

.intake-card.is-soon .intake-name,
.intake-card.is-soon .intake-desc {
  color: #6B6560;
}

.intake-soon {
  flex-shrink: 0;
  font-size: var(--fs-20);
  line-height: 1;
  padding: 6rpx 12rpx;
  color: #6B6560;
  border: 1rpx solid #3A342A;
  border-radius: 999rpx;
}

/* 需求 14：指定标本师（可选）—— 与标品定制 framer-card 视觉对齐 */
.artisan-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: var(--radius-md);
  transition: border-color var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
}

.artisan-card.active {
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.06);
  box-shadow: inset 4rpx 0 0 var(--color-primary);
}

.artisan-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #262320;
}

.artisan-main { flex: 1; min-width: 0; }

.artisan-name {
  display: block;
  font-size: var(--fs-28);
  font-weight: 600;
  color: #FFFFFF;
}

.artisan-desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: #A09A90;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.artisan-meta { text-align: right; flex-shrink: 0; }

.artisan-price { display: block; font-size: var(--fs-24); color: var(--color-primary); }

.artisan-days { display: block; font-size: var(--fs-20); color: #A09A90; margin-top: 4rpx; }

.artisan-chosen {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-primary);
}
