/* subpackages/feature/custom/pet/status/index.wxss */
page { background: #1A1814; color: #fff; }

.page-status { min-height: 100vh; padding: 0 32rpx 64rpx; }

.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.03; z-index: 0;
}

.header { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0 32rpx; }
.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.title { font-size: var(--fs-34); font-weight: 600; }

.loading-wrap { padding: 120rpx 0; text-align: center; color: #6B6560; }

.empty-wrap { padding: 80rpx 16rpx; text-align: center; }
.empty-title { display: block; font-size: var(--fs-32); font-weight: 500; color: #D5D1C8; margin-bottom: 12rpx; }
.empty-desc { display: block; font-size: var(--fs-24); color: #A09A90; line-height: 1.55; margin-bottom: 40rpx; }
.empty-wrap .btn-primary,
.empty-wrap .btn-ghost { margin-bottom: 16rpx; }

.status-card {
  padding: 32rpx; margin-bottom: 24rpx;
  background: #1F1D1A; border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-lg);
}

.overline { display: block; font-size: var(--fs-20); color: var(--color-primary); letter-spacing: 0.1em; }
.order-no { display: block; font-size: var(--fs-30); font-weight: 600; margin: 12rpx 0; }
.status-badge { display: inline-block; padding: 6rpx 16rpx; font-size: var(--fs-22); color: var(--color-primary); background: rgba(196,167,108,0.12); border-radius: var(--radius-sm); }
/* 状态分三档（2026-10-15）：轮到顾客做事的用铜框高亮，完成用成功色，结束态压暗；其余进行中保持原样 */
.status-badge.is-need_info, .status-badge.is-quoted, .status-badge.is-awaiting_intake {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.2);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.6);
}
.status-badge.is-ready, .status-badge.is-completed {
  color: var(--color-success);
  background: rgba(82, 183, 136, 0.12);
}
.status-badge.is-cancelled, .status-badge.is-declined {
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.05);
}
.status-hint { display: block; margin-top: 16rpx; font-size: var(--fs-24); color: #A09A90; line-height: 1.55; }

.quote-card {
  padding: 28rpx; margin-bottom: 24rpx;
  background: #1F1D1A; border: 1rpx solid rgba(196,167,108,0.35);
  border-radius: var(--radius-lg);
}

.quote-card .btn-primary { margin-top: 20rpx; width: 100%; }

.preview-row.dark { border-bottom-color: rgba(196,167,108,0.12); }
.preview-label.dark { color: #A09A90; }
.preview-value.dark { color: #D5D1C8; }
.preview-value.dark.amount { color: var(--color-primary); font-size: var(--fs-32); font-weight: 600; font-family: var(--font-mono); }

.plate-label.dark { color: var(--color-primary); margin-bottom: 16rpx; }
.plate-label.log { color: #A09A90; }

.booking-plate {
  padding: 24rpx 28rpx; margin-bottom: 24rpx;
  background: rgba(196,167,108,0.06); border: 1px solid rgba(77,64,26,0.4);
  border-radius: var(--radius-md);
}

.booking-info { display: block; font-size: var(--fs-26); color: #D5D1C8; line-height: 1.5; }

.policy-plate {
  padding: 24rpx 28rpx; margin-bottom: 24rpx;
  background: rgba(196,167,108,0.06); border: 1px solid rgba(77,64,26,0.4);
  border-radius: var(--radius-md);
}
.policy-text { display: block; font-size: var(--fs-24); color: #D5D1C8; line-height: 1.65; }

.preview-plate {
  padding: 28rpx; margin-bottom: 24rpx;
  background: #FAF6ED; border: 1px solid #E0CFA3; border-radius: var(--radius-md);
}

.plate-label { display: block; font-size: var(--fs-22); color: #8B6F47; margin-bottom: 16rpx; }

.preview-row {
  display: flex; justify-content: space-between; gap: 16rpx;
  padding: 10rpx 0; border-bottom: 1px solid rgba(139,111,71,0.12);
}
.preview-row:last-child { border-bottom: none; }
.preview-label { font-size: var(--fs-22); color: #8B6F47; }
.preview-value { font-size: var(--fs-24); color: #6B5A24; text-align: right; flex: 1; }

.log-section { margin-bottom: 32rpx; }
/* 进度记录画成一根时间轴（2026-10-15）：左侧细线 + 节点，最新一条节点点亮 —— 读作「一路走到这里」，而不是一摞散落的行 */
.log-item { position: relative; padding: 16rpx 0 24rpx 40rpx; }
.log-item::before { content: ''; position: absolute; left: 9rpx; top: 0; bottom: 0; width: 1rpx; background: rgba(196, 167, 108, 0.24); }
.log-item:first-of-type::before { top: 26rpx; }
.log-item:last-child::before { bottom: auto; height: 26rpx; }
.log-item::after { content: ''; position: absolute; left: 2rpx; top: 20rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--color-bg); box-shadow: inset 0 0 0 2rpx rgba(196, 167, 108, 0.5); }
.log-item:first-of-type::after { background: var(--color-primary); box-shadow: 0 0 0 4rpx rgba(196, 167, 108, 0.16); }
.log-time { display: block; font-size: var(--fs-20); color: var(--color-text-secondary); font-family: var(--font-mono); }
.log-note { display: block; font-size: var(--fs-26); color: #D5D1C8; margin-top: 4rpx; }

.actions { display: flex; flex-direction: column; gap: 16rpx; }

.btn-primary, .btn-ghost {
  height: 88rpx; border-radius: var(--radius-md); font-size: var(--fs-28);
  box-sizing: border-box; margin: 0;
}
.btn-primary { background: var(--color-primary); color: #1A1814; border: none; overflow: hidden; }
.btn-ghost {
  background: transparent; color: var(--color-primary);
  border: 1px solid var(--brass-800); overflow: visible;
}
.btn-primary::after, .btn-ghost::after { border: none; }
