/* subpackages/feature/custom/pet/status/index.wxss */
page { background: #1A1814; color: #fff; }

.page-status { min-height: 100vh; padding: 0 32rpx 64rpx; }

.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.03; z-index: 0;
}

.header { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0 32rpx; }
.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.title { font-size: 34rpx; font-weight: 600; }

.loading-wrap { padding: 120rpx 0; text-align: center; color: #6B6560; }

.empty-wrap { padding: 80rpx 16rpx; text-align: center; }
.empty-title { display: block; font-size: 32rpx; font-weight: 500; color: #D5D1C8; margin-bottom: 12rpx; }
.empty-desc { display: block; font-size: 24rpx; color: #A09A90; line-height: 1.55; margin-bottom: 40rpx; }
.empty-wrap .btn-primary,
.empty-wrap .btn-ghost { margin-bottom: 16rpx; }

.status-card {
  padding: 32rpx; margin-bottom: 24rpx;
  background: #1F1D1A; border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: var(--radius-lg);
}

.overline { display: block; font-size: 20rpx; color: #C4A76C; letter-spacing: 0.1em; }
.order-no { display: block; font-size: 30rpx; font-weight: 600; margin: 12rpx 0; }
.status-badge { display: inline-block; padding: 6rpx 16rpx; font-size: 22rpx; color: #C4A76C; background: rgba(196,167,108,0.12); border-radius: var(--radius-sm); }
.status-hint { display: block; margin-top: 16rpx; font-size: 24rpx; color: #A09A90; line-height: 1.55; }

.quote-card {
  padding: 28rpx; margin-bottom: 24rpx;
  background: #1F1D1A; border: 1rpx solid rgba(196,167,108,0.35);
  border-radius: var(--radius-lg);
}

.quote-card .btn-primary { margin-top: 20rpx; width: 100%; }

.preview-row.dark { border-bottom-color: rgba(196,167,108,0.12); }
.preview-label.dark { color: #A09A90; }
.preview-value.dark { color: #D5D1C8; }
.preview-value.dark.amount { color: #C4A76C; font-size: 32rpx; font-weight: 600; font-family: var(--font-mono); }

.plate-label.dark { color: #C4A76C; margin-bottom: 16rpx; }
.plate-label.log { color: #A09A90; }

.booking-plate {
  padding: 24rpx 28rpx; margin-bottom: 24rpx;
  background: rgba(196,167,108,0.06); border: 1px solid rgba(77,64,26,0.4);
  border-radius: var(--radius-md);
}

.booking-info { display: block; font-size: 26rpx; color: #D5D1C8; line-height: 1.5; }

.policy-plate {
  padding: 24rpx 28rpx; margin-bottom: 24rpx;
  background: rgba(196,167,108,0.06); border: 1px solid rgba(77,64,26,0.4);
  border-radius: var(--radius-md);
}
.policy-text { display: block; font-size: 24rpx; color: #D5D1C8; line-height: 1.65; }

.preview-plate {
  padding: 28rpx; margin-bottom: 24rpx;
  background: #FAF6ED; border: 1px solid #E0CFA3; border-radius: var(--radius-md);
}

.plate-label { display: block; font-size: 22rpx; color: #8B6F47; margin-bottom: 16rpx; }

.preview-row {
  display: flex; justify-content: space-between; gap: 16rpx;
  padding: 10rpx 0; border-bottom: 1px solid rgba(139,111,71,0.12);
}
.preview-row:last-child { border-bottom: none; }
.preview-label { font-size: 22rpx; color: #8B6F47; }
.preview-value { font-size: 24rpx; color: #6B5A24; text-align: right; flex: 1; }

.log-section { margin-bottom: 32rpx; }
.log-item { padding: 16rpx 0; border-bottom: 1px solid rgba(38,35,32,0.6); }
.log-time { display: block; font-size: 20rpx; color: #6B6560; }
.log-note { display: block; font-size: 26rpx; color: #D5D1C8; margin-top: 4rpx; }

.actions { display: flex; flex-direction: column; gap: 16rpx; }

.btn-primary, .btn-ghost {
  height: 88rpx; border-radius: var(--radius-md); font-size: 28rpx;
  box-sizing: border-box; margin: 0;
}
.btn-primary { background: #C4A76C; color: #1A1814; border: none; overflow: hidden; }
.btn-ghost {
  background: transparent; color: #C4A76C;
  border: 1px solid #4D401A; overflow: visible;
}
.btn-primary::after, .btn-ghost::after { border: none; }
