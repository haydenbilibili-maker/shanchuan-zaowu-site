<!--subpackages/feature/custom/pet/status/index.wxml-->
<view class="page-status">
  <view class="grain-overlay"></view>

  <view class="header" >
    <text class="title">伴宠记忆</text>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}"><text>加载工单…</text></view>

  <view class="empty-wrap" wx:elif="{{loadError || !order}}">
    <text class="empty-title">{{missingId ? '工单信息缺失' : '工单暂不可用'}}</text>
    <text class="empty-desc">{{missingId ? '链接可能已失效，请从工单列表进入' : '加载失败，请稍后重试'}}</text>
    <button class="btn-primary" wx:if="{{orderId}}" bindtap="retryLoad">重新加载</button>
    <button class="btn-ghost" bindtap="goMyOrders">查看全部工单</button>
    <button class="btn-ghost" bindtap="goHub">返回工坊</button>
  </view>

  <block wx:elif="{{order}}">
    <view class="status-card">
      <text class="overline">PET MEMORIAL</text>
      <text class="order-no">工单号 {{order.orderNo}}</text>
      <text class="status-badge">{{statusLabel}}</text>
      <text class="status-hint" wx:if="{{order.status === 'need_info' && needInfoNote}}">标本师评估时还需要您补充：{{needInfoNote}}。整理好后点下方「联系专员」发给我们即可。</text>
      <text class="status-hint" wx:elif="{{order.status === 'pending_review' || order.status === 'need_info'}}">意向已收到。标本师将通过电话或微信与您联络，请您注意接听或查看。</text>
      <text class="status-hint" wx:elif="{{order.status === 'declined'}}">很抱歉，这次我们没能承接。{{declineReason ? '原因：' + declineReason : ''}}如有疑问，可以点下方「联系专员」。</text>
      <text class="status-hint" wx:elif="{{order.status === 'quoted'}}">请确认下方报价；确认后我们将安排遗体交接。</text>
      <text class="status-hint" wx:elif="{{canBookIntake}}">请预约到店交接时间，标本师将当面确认。</text>
      <text class="status-hint" wx:elif="{{hasBooking}}">交接已预约：{{bookingText}}</text>
    </view>

    <view class="quote-card" wx:if="{{quoteLines.length}}">
      <text class="plate-label dark">工坊报价</text>
      <view class="preview-row dark" wx:for="{{quoteLines}}" wx:key="label">
        <text class="preview-label dark">{{item.label}}</text>
        <text class="preview-value dark {{item.label === '报价金额' ? 'amount' : ''}}">{{item.value}}</text>
      </view>
      <button
        class="btn-primary"
        wx:if="{{canConfirmQuote}}"
        bindtap="confirmQuote"
        loading="{{confirming}}"
        disabled="{{confirming}}"
      >确认报价</button>
    </view>

    <view class="preview-plate">
      <text class="plate-label">档案摘要</text>
      <view class="preview-row" wx:for="{{summaryLines}}" wx:key="label">
        <text class="preview-label">{{item.label}}</text>
        <text class="preview-value">{{item.value}}</text>
      </view>
    </view>

    <view class="booking-plate" wx:if="{{hasBooking}}">
      <text class="plate-label">交接预约</text>
      <text class="booking-info">{{bookingText}}</text>
    </view>

    <view class="policy-plate">
      <text class="plate-label">寄送与退款</text>
      <text class="policy-text">标本师会在制作过程中通过视频等方式确认方案。成品以顺丰保价寄出；一经发出，不接受非物流原因的退款申请。</text>
    </view>

    <view class="log-section" wx:if="{{history.length}}">
      <text class="plate-label log">进度记录</text>
      <view class="log-item" wx:for="{{history}}" wx:key="time">
        <text class="log-time">{{item.time}}</text>
        <text class="log-note">{{item.note}}</text>
      </view>
    </view>

    <view class="actions">
      <button class="btn-primary" wx:if="{{canBookIntake}}" bindtap="goBookIntake">预约到店交接</button>
      <button class="btn-ghost" bindtap="goSupport">联系专员</button>
      <button class="btn-ghost" bindtap="goMyOrders">全部工单</button>
      <button class="btn-ghost" bindtap="goHub">返回工坊</button>
    </view>
  </block>
</view>

<!-- 全站样式化弹窗宿主（替代 wx.showModal；utils/appModal.js 的 openAppModal 在此查找）；docs/弹层视觉规范_2026-10-13.md -->
<app-modal id="appModal" />
