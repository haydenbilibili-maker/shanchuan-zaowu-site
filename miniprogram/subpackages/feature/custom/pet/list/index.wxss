/* subpackages/feature/custom/pet/list/index.wxss */
page { background: #1A1814; color: #fff; }

.page-list { min-height: 100vh; padding: 0 32rpx 64rpx; }

.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.03; z-index: 0;
}

.header { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0 32rpx; }
.back-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.brand { flex: 1; }
.title { display: block; font-size: var(--fs-34); font-weight: 600; }
.sub { display: block; font-size: var(--fs-20); color: var(--color-primary); letter-spacing: 0.1em; margin-top: 4rpx; }

.loading-wrap { padding: 120rpx 0; text-align: center; color: var(--color-text-secondary); }

.order-card {
  padding: 28rpx; margin-bottom: 20rpx;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: var(--radius-lg);
}

.order-card:active { opacity: 0.92; }

.card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.pet-name { font-size: var(--fs-30); font-weight: 600; flex: 1; }
.status-badge {
  font-size: var(--fs-20); color: var(--color-primary); padding: 4rpx 12rpx;
  background: rgba(196,167,108,0.12); border-radius: var(--radius-sm); flex-shrink: 0;
}

.order-no { display: block; margin-top: 8rpx; font-size: var(--fs-22); color: var(--color-text-secondary); }
.craft-line { display: block; margin-top: 8rpx; font-size: var(--fs-24); color: #A09A90; }

.card-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 16rpx; padding-top: 16rpx; border-top: 1px solid rgba(38,35,32,0.6);
}

.time { font-size: var(--fs-22); color: var(--color-text-secondary); }
.quote { font-size: var(--fs-24); color: var(--color-primary); font-family: var(--font-mono); }

.empty { padding: 120rpx 0; text-align: center; }
.empty-title { display: block; font-size: var(--fs-32); font-weight: 500; margin-bottom: 12rpx; }
.empty-desc { display: block; font-size: var(--fs-24); color: #A09A90; line-height: 1.55; margin-bottom: 40rpx; }

.btn-primary {
  width: 320rpx; height: 88rpx; line-height: 88rpx;
  background: var(--color-primary); color: #1A1814; border-radius: var(--radius-md); font-size: var(--fs-28); border: none;
}
.btn-primary::after { border: none; }

/* 状态分三档（2026-10-15）：轮到顾客做事的用铜框高亮，完成用成功色，结束态压暗；其余进行中保持原样 */
.status-badge.is-need_info, .status-badge.is-quoted, .status-badge.is-awaiting_intake {
  color: var(--brass-200);
  background: rgba(196, 167, 108, 0.2);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.6);
}
.status-badge.is-ready, .status-badge.is-completed {
  color: var(--color-success);
  background: rgba(82, 183, 136, 0.12);
}
.status-badge.is-cancelled, .status-badge.is-declined {
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.05);
}
