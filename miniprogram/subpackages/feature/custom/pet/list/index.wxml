<!--subpackages/feature/custom/pet/list/index.wxml-->
<view class="page-list">
  <view class="grain-overlay"></view>

  <view class="header" >
    <view class="brand">
      <text class="title">伴宠工单</text>
      <text class="sub">PET MEMORIAL ORDERS</text>
    </view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}"><text>加载中…</text></view>

  <block wx:elif="{{orders.length}}">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="_id"
      bindtap="goDetail"
      data-id="{{item._id}}"
    >
      <view class="card-top">
        <text class="pet-name">{{item.petTitle}}</text>
        <text class="status-badge">{{item.statusLabel}}</text>
      </view>
      <text class="order-no">{{item.orderNo}}</text>
      <text class="craft-line" wx:if="{{item.craftName}}">{{item.craftName}}</text>
      <view class="card-foot">
        <text class="time">{{item.formatTime}}</text>
        <text class="quote" wx:if="{{item.quoteText}}">{{item.quoteText}}</text>
      </view>
    </view>
  </block>

  <view class="empty" wx:else>
    <text class="empty-title">{{canApply ? '暂无伴宠工单' : '伴宠记忆暂未开放'}}</text>
    <text class="empty-desc">{{canApply ? '提交制作意向后，进度与报价将显示在这里' : '已有工单仍可通过消息通知查看；新意向提交稍后再来'}}</text>
    <button class="btn-primary" bindtap="goApply" wx:if="{{canApply}}">了解伴宠记忆</button>
  </view>
</view>
