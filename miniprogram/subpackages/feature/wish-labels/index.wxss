/* 马上有 · 心愿签（2026-10-13 重做）：博物黑 + 纸质标本签 + 发丝金；值对齐评审稿（mock px × 2 = rpx） */
page {
  background: #151412;
  --paper: #F3ECDD;
  --paper-2: #E8DFCB;
  --ink: #2E2618;
  --hand: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", serif;
}

/* 顶栏：透明，叠在实拍上 */
.wl-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 40; display: flex; align-items: center; padding-left: 16rpx; box-sizing: content-box; }
.wl-nav-back .page-nav-back-icon { width: 28px; height: 28px; }

/* 闸门态 */
.wl-state { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding-left: 48rpx; padding-right: 48rpx; }
.wl-state-title { font-family: var(--font-brand); font-size: var(--fs-34); color: var(--color-text-primary); letter-spacing: .12em; }
.wl-state-desc { font-size: var(--fs-24); color: var(--color-text-secondary); }
.wl-sk-title { width: 260rpx; height: 40rpx; }

.wl-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }

/* ① 展品首屏 */
.wl-hero { position: relative; height: 940rpx; overflow: hidden; background: #0E0D0B; }
.wl-hero-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.wl-hero-shade { position: absolute; inset: 0; z-index: 2; background: linear-gradient(180deg, rgba(21,20,18,.55) 0%, rgba(21,20,18,0) 22%, rgba(21,20,18,0) 46%, rgba(21,20,18,.6) 74%, #151412 100%); }
.wl-credit { position: absolute; left: 40rpx; z-index: 3; display: flex; flex-direction: column; gap: 2rpx; }
.wl-credit-en { font-size: var(--fs-16); letter-spacing: .32em; color: rgba(247,241,228,.75); font-weight: 600; }
.wl-credit-zh { font-size: var(--fs-18); letter-spacing: .16em; color: rgba(247,241,228,.6); }
/* 2026-10-15 质感第 5 轮：署名叠在实拍的灯带上会被吃掉 → 一层中性暗影托字（不是金色辉光） */
.wl-credit-en, .wl-credit-zh { text-shadow: 0 2rpx 8rpx rgba(0,0,0,.55); }
.wl-exhibit-tag { position: absolute; right: 36rpx; z-index: 3; display: flex; flex-direction: column; align-items: center; padding: 10rpx 14rpx; border: 1rpx solid rgba(212,188,133,.8); background: rgba(21,20,18,.5); font-family: var(--font-mono); font-size: var(--fs-16); line-height: 1.5; letter-spacing: .14em; color: #E3C98C; }

.wl-intro { position: relative; z-index: 4; margin-top: -184rpx; padding: 0 44rpx; display: flex; flex-direction: column; }
.wl-kicker { font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .32em; color: var(--brass-400); }
.wl-title { margin-top: 12rpx; font-family: var(--font-brand); font-size: 80rpx; line-height: 1.15; font-weight: 500; letter-spacing: .2em; color: var(--color-text-primary); }
.wl-sub { margin-top: 18rpx; font-size: var(--fs-26); line-height: 1.75; color: var(--color-text-body); }
.wl-sub.is-note { margin-top: 4rpx; font-size: var(--fs-22); color: var(--color-text-secondary); }

/* 最新三张露角 */
.wl-peek { margin-top: 40rpx; white-space: nowrap; }
.wl-peek-row { display: inline-flex; gap: 20rpx; padding: 14rpx 44rpx 24rpx; }
.wl-mini { position: relative; flex-shrink: 0; width: 236rpx; padding: 18rpx 20rpx 16rpx; box-sizing: border-box; background: linear-gradient(170deg, var(--paper), var(--paper-2)); border-radius: var(--radius-sm); color: var(--ink); box-shadow: 0 16rpx 36rpx rgba(0,0,0,.4); display: flex; flex-direction: column; }
.wl-mini::before { content: ''; position: absolute; top: -6rpx; left: 50%; width: 12rpx; height: 12rpx; margin-left: -6rpx; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #F0E6CC, #A8903C); }
.wl-mini-no { font-family: var(--font-mono); font-size: 15rpx; letter-spacing: .14em; color: var(--brass-600); }
.wl-mini-text { margin-top: 8rpx; font-family: var(--hand); font-size: var(--fs-30); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wl-mini-by { margin-top: 10rpx; padding-top: 8rpx; border-top: 1rpx solid rgba(138,117,48,.25); font-size: var(--fs-16); color: #7C6E55; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ④ 墙 */
.wl-wall { margin-top: 32rpx; padding: 0 32rpx; }
.wl-seg { display: flex; gap: 36rpx; padding-bottom: 8rpx; }
.wl-seg-item { position: relative; min-height: 56rpx; line-height: 56rpx; font-size: var(--fs-26); color: var(--color-text-secondary); }
.wl-seg-item.is-on { color: var(--color-text-primary); font-weight: 500; }
.wl-seg-item.is-on::after { content: ''; position: absolute; left: 0; right: 0; bottom: 2rpx; height: 3rpx; background: var(--brass-400); }
.wl-notice { margin-bottom: 20rpx; font-size: var(--fs-22); color: var(--color-text-secondary); }

.wl-cols { display: flex; gap: 24rpx; align-items: flex-start; }
.wl-col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 24rpx; }
.wl-sk-card { height: 200rpx; }
.wl-sk-card.short { height: 150rpx; }

.wl-label { position: relative; padding: 24rpx 24rpx 20rpx; background: linear-gradient(170deg, var(--paper), var(--paper-2)); border-radius: var(--radius-sm); color: var(--ink); box-shadow: 0 20rpx 44rpx rgba(0,0,0,.45); }
.wl-label::before { content: ''; position: absolute; inset: 8rpx; border: 1rpx solid rgba(138,117,48,.28); pointer-events: none; }
.wl-label::after { content: ''; position: absolute; top: -6rpx; left: 50%; width: 14rpx; height: 14rpx; margin-left: -7rpx; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #F0E6CC, #A8903C); }
.wl-label.is-mine { box-shadow: 0 0 0 3rpx rgba(196,167,108,.9), 0 24rpx 52rpx rgba(0,0,0,.5); }
.wl-label.is-hidden { opacity: .62; }
.wl-label.is-fresh { animation: wl-pin .62s cubic-bezier(.2,.9,.3,1.2) both; }
@keyframes wl-pin { 0% { opacity: 0; transform: translateY(-40rpx) rotate(-3deg) scale(1.04); } 100% { opacity: 1; transform: none; } }
.wl-label-top { display: flex; justify-content: space-between; align-items: center; min-height: 26rpx; }
.wl-label-no { font-family: var(--font-mono); font-size: 15rpx; letter-spacing: .16em; color: var(--brass-600); }
.wl-label-tag { padding: 0 8rpx; font-size: var(--fs-16); line-height: 26rpx; letter-spacing: .12em; color: var(--brass-700); border: 1rpx solid rgba(107,90,36,.5); }
.wl-label-text { display: block; margin: 14rpx 0 18rpx; font-family: var(--hand); font-size: 38rpx; line-height: 1.35; word-break: break-all; }
.wl-label-text.is-long { font-size: var(--fs-30); }
.wl-label-by { display: flex; justify-content: space-between; gap: 12rpx; padding-top: 12rpx; border-top: 1rpx solid rgba(138,117,48,.25); font-size: 17rpx; color: #7C6E55; }
.wl-label-author { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 空态 / 失败态：画成一张还没写的空白标本签（虚线发丝框 + 顶上一枚别针），而不是一行孤零零的字 */
.wl-empty { position: relative; display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin: 8rpx 0 0; padding: 72rpx 40rpx 64rpx; border: 1rpx dashed rgba(196,167,108,.38); border-radius: var(--radius-sm); background: rgba(243,236,221,.03); font-size: var(--fs-26); color: var(--color-text-body); text-align: center; }
.wl-empty::before { content: ''; position: absolute; top: -7rpx; left: 50%; width: 14rpx; height: 14rpx; margin-left: -7rpx; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #F0E6CC, #A8903C); }
.wl-empty-sub { font-size: var(--fs-22); color: var(--color-text-secondary); }
.wl-capped { display: block; margin-top: 32rpx; text-align: center; font-size: var(--fs-22); color: var(--color-text-secondary); letter-spacing: .08em; }

/* 按钮：唯一实心金 + 描边次级 */
.wl-foot { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; align-items: center; gap: 28rpx; padding: 24rpx 36rpx calc(24rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(21,20,18,0), #151412 30%); }
.wl-primary { flex: 1; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 46rpx; background: linear-gradient(155deg, #E6D3A1, var(--color-primary) 55%, #A8903C); color: #1A1814; font-size: var(--fs-30); font-weight: 600; letter-spacing: .12em; white-space: nowrap; }
.wl-primary.is-off { background: transparent; color: rgba(212,188,133,.6); border: 1rpx solid rgba(196,167,108,.36); line-height: 90rpx; }
.wl-link { flex-shrink: 0; font-size: 25rpx; color: var(--brass-300); letter-spacing: .08em; white-space: nowrap; padding: 16rpx 0; }
.wl-ghost-btn { padding: 0 36rpx; min-height: 72rpx; line-height: 72rpx; text-align: center; border: 1rpx solid rgba(196,167,108,.55); border-radius: 36rpx; color: var(--brass-300); font-size: var(--fs-26); letter-spacing: .08em; background: rgba(196,167,108,.06); }
.wl-ghost-btn.wide { flex: 1; }
.wl-ghost-btn.is-done { color: var(--color-text-secondary); border-color: rgba(196,167,108,.24); }

/* ③ 弹层 */
.wl-mask { position: fixed; inset: 0; z-index: 60; background: rgba(10,9,7,.72); animation: wl-fade var(--dur-base) var(--ease-standard) both; }
@keyframes wl-fade { from { opacity: 0; } to { opacity: 1; } }
.wl-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 61; padding: 24rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); background: #1A1814; border-radius: 40rpx 40rpx 0 0; border-top: 1rpx solid rgba(196,167,108,.3); animation: wl-up var(--dur-slow) var(--ease-out-soft) both; }
/* 弹层从屏底整张升起（原 40rpx 小位移 + 0.4 起始透明 = 半透明一闪），遮罩同时淡入 */
@keyframes wl-up { from { transform: translateY(100%); } to { transform: none; } }
.wl-grab { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: #3A352D; margin: 0 auto 28rpx; }
.wl-close { font-size: var(--fs-40); line-height: 1; color: var(--color-text-secondary); padding: 0 0 8rpx 24rpx; }

.wl-paper { position: relative; padding: 32rpx 36rpx 28rpx; background: linear-gradient(170deg, var(--paper), var(--paper-2)); border-radius: var(--radius-sm); color: var(--ink); box-shadow: 0 36rpx 80rpx rgba(0,0,0,.5); }
.wl-paper::before { content: ''; position: absolute; inset: 12rpx; border: 1rpx solid rgba(138,117,48,.35); pointer-events: none; }
.wl-paper::after { content: ''; position: absolute; top: -8rpx; left: 50%; width: 18rpx; height: 18rpx; margin-left: -9rpx; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #F4ECD4, #A8903C 70%); box-shadow: 0 4rpx 8rpx rgba(0,0,0,.4); }
.wl-paper-top { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 17rpx; letter-spacing: .18em; color: var(--brass-600); }
.wl-paper-ttl { display: block; margin-top: 16rpx; text-align: center; font-family: var(--font-brand); font-size: var(--fs-24); letter-spacing: .3em; color: #5A4A28; }
.wl-paper-input { position: relative; z-index: 1; width: 100%; min-height: 96rpx; margin: 28rpx 0 20rpx; font-family: var(--hand); font-size: 56rpx; line-height: 1.3; text-align: center; color: var(--ink); }
.wl-paper-ph { color: rgba(46,38,24,.32); }
.wl-paper-wish { display: block; margin: 32rpx 0 24rpx; text-align: center; font-family: var(--hand); font-size: 56rpx; line-height: 1.3; word-break: break-all; }
.wl-paper-grid { display: flex; gap: 28rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(138,117,48,.3); }
.wl-paper-field { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.wl-paper-field .k { font-size: var(--fs-18); letter-spacing: .06em; color: #7C6E55; }
.wl-paper-field .v { font-size: 23rpx; font-weight: 500; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 四个灵感词一行排下（原 16rpx 间距 + 24rpx 内边距在 670rpx 宽里第四个必折行） */
.wl-inspo { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 36rpx; }
.wl-inspo-k { font-family: var(--font-mono); font-size: var(--fs-18); letter-spacing: .24em; color: var(--color-text-secondary); margin-right: 0; }
.wl-inspo-chip { padding: 10rpx 18rpx; border: 1rpx solid rgba(196,167,108,.4); border-radius: 28rpx; font-size: var(--fs-24); color: #E0CFA3; }
.wl-sheet-line { display: flex; justify-content: space-between; margin: 28rpx 0 32rpx; font-size: var(--fs-22); color: var(--color-text-secondary); }
.wl-count { font-family: var(--font-mono); }

.wl-card-acts { display: flex; gap: 20rpx; margin-top: 40rpx; }
.wl-share { flex: 1; margin: 0; padding: 0; min-height: 72rpx; line-height: 72rpx; border-radius: 36rpx; background: transparent; border: 1rpx solid rgba(196,167,108,.36); color: var(--color-text-body); font-size: var(--fs-26); letter-spacing: .08em; }
.wl-share::after { border: 0; }

/* 语音（2026-10-13 选附 ≤ 15 秒）：录音条 = 描边次级（实心金仍只给「别上墙」）；签上播放钮 = 纸面上的细铜小签 */
.wl-voice { margin-top: 28rpx; }
.wl-voice-hold { display: flex; align-items: center; justify-content: center; gap: 14rpx; min-height: 80rpx; border: 1rpx dashed rgba(196,167,108,.45); border-radius: 40rpx; font-size: var(--fs-24); color: var(--brass-300); letter-spacing: .04em; }
.wl-voice-hold.is-rec { border-style: solid; border-color: rgba(212,188,133,.85); background: rgba(196,167,108,.1); color: #F0E2B8; }
.wl-voice-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--brass-400); }
.wl-voice-hold.is-rec .wl-voice-dot { background: #E8927C; animation: wl-rec 1s ease-in-out infinite; }
@keyframes wl-rec { 50% { opacity: .3; } }
.wl-voice-chip { display: flex; align-items: center; gap: 24rpx; }
.wl-voice-play { flex: 1; display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 80rpx; border: 1rpx solid rgba(196,167,108,.55); border-radius: 40rpx; font-size: var(--fs-24); color: var(--brass-300); background: rgba(196,167,108,.06); }
.wl-voice-play.is-on { background: rgba(196,167,108,.16); }
.wl-voice-del { flex-shrink: 0; padding: 16rpx 8rpx; font-size: var(--fs-24); color: var(--color-text-secondary); }
.wl-voice-note { display: block; margin-top: 12rpx; text-align: center; font-size: var(--fs-20); color: var(--color-text-secondary); }
.wl-voice-ico { width: 0; height: 0; border-top: 9rpx solid transparent; border-bottom: 9rpx solid transparent; border-left: 14rpx solid currentColor; }
.wl-label-voice { display: inline-flex; align-items: center; gap: 10rpx; margin: -6rpx 0 16rpx; padding: 6rpx 16rpx; min-height: 44rpx; border: 1rpx solid rgba(107,90,36,.45); border-radius: var(--radius-lg); font-family: var(--font-mono); font-size: var(--fs-18); color: var(--brass-700); }
.wl-label-voice.is-on { background: rgba(196,167,108,.22); }
.wl-label-voice.is-big { display: flex; justify-content: center; margin: 0 0 24rpx; min-height: 64rpx; font-family: inherit; font-size: var(--fs-24); }
.wl-paper-note { display: block; margin: -8rpx 0 20rpx; text-align: center; font-size: var(--fs-20); color: #7C6E55; }

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .wl-voice-hold.is-rec .wl-voice-dot {
    animation: none;
  }
}
