@import "../play-shared/ritual-play.wxss";

/* ── 拆签饼：一枚对半合拢的签饼 ───────────────────────────────────
   入口是"一件可以掰开的东西"：两半之间有一道缝，掰开才有纸条。 */
.rp-shell {
  position: relative;
  width: 230rpx;
  height: 180rpx;
}

.rp-shell-half {
  position: absolute;
  top: 20rpx;
  width: 112rpx;
  height: 140rpx;
  background: linear-gradient(160deg, var(--brass-200) 0%, var(--brass-400) 62%, var(--brass-600) 100%);
  box-shadow: inset 0 3rpx 0 rgba(250, 246, 237, 0.4);
}

.rp-shell-half.is-left {
  left: 0;
  border-radius: 70rpx 8rpx 8rpx 70rpx;
}

.rp-shell-half.is-right {
  right: 0;
  border-radius: 8rpx 70rpx 70rpx 8rpx;
}

/* 缝：合拢时那道折痕（不是描边，是凹进去的一道） */
.rp-shell-half.is-left::after,
.rp-shell-half.is-right::after {
  content: "";
  position: absolute;
  top: 14rpx;
  width: 2rpx;
  height: 112rpx;
  background: rgba(48, 40, 16, 0.55);
}

.rp-shell-half.is-left::after { right: 0; }
.rp-shell-half.is-right::after { left: 0; }

.rp-shell-slip {
  position: absolute;
  left: 84rpx;
  top: 46rpx;
  width: 62rpx;
  height: 96rpx;
  background: var(--brass-50);
  border-radius: 4rpx;
  opacity: 0;
  transform: scaleY(0.6);
}

/* 进行态：两半分开、纸条露出来 */
.rp-stage.is-pending .rp-shell-half.is-left {
  animation: rp-shell-left 800ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

.rp-stage.is-pending .rp-shell-half.is-right {
  animation: rp-shell-right 800ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

.rp-stage.is-pending .rp-shell-slip {
  animation: rp-slip-out 800ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
}

@keyframes rp-shell-left {
  0% { transform: translateX(0) rotate(0deg); }
  100% { transform: translateX(-26rpx) rotate(-9deg); }
}

@keyframes rp-shell-right {
  0% { transform: translateX(0) rotate(0deg); }
  100% { transform: translateX(26rpx) rotate(9deg); }
}

@keyframes rp-slip-out {
  0% { opacity: 0; transform: scaleY(0.6); }
  100% { opacity: 1; transform: scaleY(1); }
}

/* ── 结果纸面：一张窄纸条（签条一句 + 轻建议一句） ─────────────────── */
.rp-paper {
  padding: 30rpx 26rpx 26rpx;
  background: linear-gradient(180deg, #F5EFDF 0%, #E9DFC8 100%);
  border: 1rpx solid rgba(122, 92, 44, 0.34);
}

.rp-cookie-line {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-36);
  line-height: 1.4;
  color: #2A2418;
}

.rp-cookie-advice {
  display: block;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: rgba(58, 50, 38, 0.8);
  border-left: 4rpx solid rgba(122, 92, 44, 0.4);
}
