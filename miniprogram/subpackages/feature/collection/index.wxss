page {
  width: 100%;
  overflow-x: hidden;
  background: #1A1814;
}

.page {
  min-height: 100vh;
  width: 100%;
  padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
  overflow-x: hidden;
}

.hero {
  margin-bottom: 8rpx;
}

.hero-en {
  display: block;
  font-size: var(--fs-20);
  letter-spacing: 0.28em;
  color: rgba(196, 167, 108, 0.7);
  margin-bottom: 12rpx;
}

.hero-cn {
  display: block;
  font-size: var(--fs-48);
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.08em;
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-24);
  color: #A09A90;
  line-height: 1.6;
}

.progress {
  margin: 40rpx 0 24rpx;
  padding: 28rpx 32rpx;
  background: #1F1D1A;
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-lg);
}

.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.progress-label {
  font-size: var(--fs-22);
  color: #A09A90;
  letter-spacing: 0.12em;
}

.progress-num {
  font-size: var(--fs-36);
  color: var(--color-primary);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.bar {
  margin-top: 16rpx;
  height: 8rpx;
  background: #262320;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--color-primary);
  transition: width var(--dur-slow) var(--ease-standard);
}

.progress-note {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.series {
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.series-inner {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 12rpx;
}

.series-chip {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  background: #1F1D1A;
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
}

.series-chip.on {
  border-color: var(--color-primary);
  background: #262320;
}

.series-name {
  display: block;
  font-size: var(--fs-24);
  color: #E0CFA3;
}

.series-count {
  font-size: var(--fs-20);
  color: #A09A90;
  margin-right: 8rpx;
}

.series-done {
  font-size: var(--fs-20);
  color: var(--color-primary);
}

.series-blurb {
  display: block;
  margin: 0 0 20rpx;
  padding: 0 4rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.browse-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 8rpx 0 12rpx;
}

.browse-t {
  font-size: var(--fs-22);
  letter-spacing: 0.16em;
  color: #A09A90;
}

.browse-link {
  font-size: var(--fs-22);
  color: var(--color-primary);
}

.tabs {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.tabs-inner {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 12rpx;
}

.tab {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: var(--fs-24);
  color: #A09A90;
  background: #1F1D1A;
  border: 1rpx solid #262320;
  border-radius: 999rpx;
}

.tab.on {
  color: #1A1814;
  background: var(--color-primary);
  font-weight: 500;
}

.rarity-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.rarity-chip {
  padding: 8rpx 20rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  border: 1rpx solid #262320;
  border-radius: var(--radius-sm);
}

.rarity-chip.on {
  color: var(--color-primary);
  border-color: var(--brass-800);
}


.error,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 24rpx;
  text-align: center;
  color: #A09A90;
  font-size: var(--fs-26);
  gap: 16rpx;
}

.error-t,
.empty-t {
  font-size: var(--fs-30);
  color: #FFFFFF;
}

.error-s,
.empty-s {
  font-size: var(--fs-24);
  color: #A09A90;
  line-height: 1.6;
}

.empty-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn-brass {
  margin-top: 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  background: var(--color-primary);
  color: #1A1814;
  font-size: var(--fs-26);
  border: none;
  border-radius: var(--radius-md);
}

.btn-brass::after { border: none; }

.btn-ghost {
  margin-top: 12rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: var(--fs-26);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
}

.btn-ghost::after { border: none; }

.grid {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
}

.col {
  flex: 1;
  width: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.col + .col {
  margin-left: 16rpx;
}

.card {
  position: relative;
  width: 100%;
  min-width: 0;
  margin-bottom: 16rpx;
  background: #1F1D1A;
  border: 1rpx solid #262320;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-sizing: border-box;
  transition: opacity var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
}

.card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: var(--brass-800);
  z-index: 1;
}

.tone-insecta .card-accent { background: var(--color-insecta); }
.tone-plantae .card-accent { background: #6DA34D; }
.tone-minerals .card-accent { background: #7B68AE; }
.tone-marine .card-accent { background: var(--color-marine); }
.card.dim .card-accent { opacity: 0.35; }

.card-silver { border-color: #8A8A8A; }
.card-gold { border-color: var(--color-primary); }
.card.dim { opacity: 0.78; }
.card-press {
  opacity: 0.9;
  transform: scale(0.985);
}

.card-plate {
  position: relative;
  height: 200rpx;
  background: linear-gradient(165deg, #1C1A16 0%, #151310 100%);
  border-bottom: 1rpx solid #262320;
}

.card-no {
  position: absolute;
  top: 16rpx;
  left: 20rpx;
  font-size: var(--fs-20);
  letter-spacing: 0.14em;
  color: rgba(196, 167, 108, 0.85);
}

.card-cat {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}

.card-spot {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  font-size: var(--fs-18);
  letter-spacing: 0.12em;
  color: rgba(196, 167, 108, 0.75);
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-sm);
}

.silhouette {
  position: absolute;
  left: 50%;
  top: 52%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, #2A2620 0%, #171512 72%);
  border: 1rpx solid #302810;
  display: flex;
  align-items: center;
  justify-content: center;
}

.silhouette-ring {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid var(--brass-800);
  opacity: 0.7;
}

.plate-mark {
  position: absolute;
  left: 50%;
  top: 52%;
  transform: translate(-50%, -50%);
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-sm);
  background: rgba(196, 167, 108, 0.06);
}

.plate-mark-en {
  font-size: var(--fs-18);
  letter-spacing: 0.22em;
  color: rgba(196, 167, 108, 0.75);
}

.card-body {
  min-width: 0;
  padding: 16rpx 16rpx 20rpx;
}

.card-name {
  display: block;
  min-width: 0;
  font-size: var(--fs-26);
  color: #D5D1C8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card.lit .card-name { color: #FFFFFF; }

.card-latin {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-20);
  font-style: italic; font-family: var(--font-latin);
  color: var(--color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-origin {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #302810;
}

.dot.on { background: var(--color-primary); }
.card-silver .dot.on { background: #C8C8C8; }

.card-rarity {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
  letter-spacing: 0.06em;
}

/* 骨架 */
.skel-card {
  pointer-events: none;
  border-color: #262320;
}

.skel-plate {
  height: 180rpx;
  background: #171512;
}

.skel-line {
  height: 22rpx;
  margin: 20rpx 16rpx 0;
  background: #262320;
  border-radius: var(--radius-sm);
  animation: pulse 1.2s ease-in-out infinite;
}

.skel-line.short {
  width: 55%;
  margin-bottom: 24rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.dock {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: row;
  z-index: 20;
}

.dock-btn {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: var(--fs-24);
  color: var(--color-primary);
  background: #1F1D1A;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
}

.dock-btn + .dock-btn {
  margin-left: 12rpx;
}

.dock-btn.primary {
  background: var(--color-primary);
  color: #1A1814;
  font-weight: 500;
  border: none;
}


.notes {
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  background: #1F1D1A;
  border: 1rpx solid #262320;
  border-radius: var(--radius-lg);
}

.notes-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.notes-t {
  font-size: var(--fs-22);
  letter-spacing: 0.16em;
  color: #A09A90;
}

.notes-more {
  font-size: var(--fs-22);
  color: var(--color-primary);
}

.note {
  padding: 16rpx 0;
  border-top: 1rpx solid #262320;
}


.note-title {
  display: block;
  font-size: var(--fs-26);
  color: #E8E4DC;
}

.note.wild .note-title {
  color: #A09A90;
}

.note-meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}





/* 解锁仪式卡：ui-pop-mask is-center is-deep + ui-pop-dialog（docs/弹层视觉规范_2026-10-13.md）；这里只排卡内藏品信息 */
.unlock-mask { z-index: 40; }
.unlock-sheet { text-align: center; }
.unlock-cta { display: block; flex: none; margin-top: 40rpx; }
.unlock-name {
  display: block;
  margin-top: 28rpx;
  font-size: var(--fs-32);
  color: #E8E4DC;
}

.unlock-latin {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  font-style: italic; font-family: var(--font-latin);
  color: var(--color-primary);
}

.unlock-msg {
  display: block;
  margin-top: 20rpx;
  font-size: var(--fs-24);
  color: #A09A90;
  line-height: 1.6;
}


.unlock-later {
  display: block;
  margin-top: 24rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .skel-line {
    animation: none;
  }
}
