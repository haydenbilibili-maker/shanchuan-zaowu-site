page { background: #1A1814; }

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #1A1814;
  box-sizing: border-box;
}

/* 采集日志（2026-10-17 随图鉴重设计）：眉标 + 宋体主标；两种记录是下划线页签，不再是两块实心金按钮 */
.en {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.cn {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-44);
  letter-spacing: 0.1em;
  color: #F3ECDD;
  font-weight: 600;
}

.sub {
  display: block;
  margin-top: 12rpx;
  margin-bottom: 16rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.back-atlas {
  display: inline-block;
  margin-bottom: 24rpx;
  font-size: var(--fs-24);
  color: var(--brass-300);
}

.modes {
  display: flex;
  gap: 40rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.16);
}

.mode {
  height: 76rpx;
  line-height: 76rpx;
  font-size: var(--fs-28);
  color: var(--color-text-secondary);
  border-bottom: 4rpx solid transparent;
  margin-bottom: -1rpx;
}

.mode.on {
  color: var(--brass-200);
  border-bottom-color: var(--brass-400);
  font-weight: 500;
}

/* 统计：两个大数字 + 发丝分隔（不再是卡片） */
.stats {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 8rpx 0 24rpx;
}

.stat-box {
  flex: 1;
  min-width: 0;
}

.stat-num {
  display: block;
  font-family: var(--font-mono);
  font-size: 56rpx;
  color: var(--brass-200);
}

.stat-lbl {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  margin-right: 40rpx;
  background: rgba(196, 167, 108, 0.2);
}

.cats {
  width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.cats-inner {
  display: inline-flex;
  padding-bottom: 16rpx;
}

.cat {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  font-size: var(--fs-24);
  color: #A09A90;
  background: #1F1D1A;
  border: 1rpx solid #262320;
  border-radius: 9999px;
}

.cat + .cat { margin-left: 12rpx; }

.cat.on {
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.loading,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 0;
  text-align: center;
  color: #A09A90;
  font-size: var(--fs-26);
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}



.empty-t {
  display: block;
  color: #FFFFFF;
  font-size: var(--fs-30);
  margin-bottom: 12rpx;
}

.empty-s {
  display: block;
  font-size: var(--fs-24);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.record {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #262320;
}


.thumb {
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #171512;
  border: 1rpx solid #262320;
}

.thumb-img {
  width: 168rpx;
  height: 168rpx;
}

.thumb-empty {
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, #2A2620 0%, #171512 70%);
}

.record-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.record-top {
  display: flex;
  align-items: baseline;
}

.record-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-30);
  color: #FFFFFF;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record.wild .record-name { color: #A09A90; }

.record-mark {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: var(--fs-20);
  color: var(--color-primary);
  letter-spacing: 0.06em;
}

.record-latin {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  font-style: italic; font-family: var(--font-latin);
  color: var(--color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta,
.record-tax {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.record-excerpt {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.55;
  color: #D5D1C8;
  overflow: hidden;
}

.record-fact {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: #A09A90;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #262320;
}

.row-title {
  display: block;
  font-size: var(--fs-30);
  color: #E8E4DC;
}

.row.wild .row-title { color: #A09A90; }

.row-meta,
.row-time {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}

.btn-brass {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  background: var(--color-primary);
  color: #1A1814;
  font-size: var(--fs-28);
  border: none;
  border-radius: var(--radius-md);
}

.btn-brass::after { border: none; }

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .spinner {
    animation: none;
  }
}
