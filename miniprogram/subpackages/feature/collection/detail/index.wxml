<wxs src="../../../../utils/latinDisplay.wxs" module="latin" />
<view class="page {{locked && !loading && !loadError ? 'has-dock' : ''}} {{!locked && !loading && !loadError ? 'has-share' : ''}}">
  <view class="loading" wx:if="{{loading}}">
    <view class="skel-plate"></view>
    <view class="skel-block">
      <view class="skel-line"></view>
      <view class="skel-line mid"></view>
      <view class="skel-line short"></view>
    </view>
    <text class="loading-t">展开这一页…</text>
  </view>

  <view class="error" wx:elif="{{loadError}}">
    <text class="error-t">这一页暂时读不到</text>
    <button class="btn-brass" bindtap="loadCard">再试一次</button>
    <text class="link" bindtap="goAtlas" hover-class="tap-press" hover-stay-time="80">返回图鉴</text>
  </view>

  <block wx:else>
    <view class="crumb">
      <text class="crumb-link" bindtap="goAtlas" hover-class="tap-press" hover-stay-time="80">山海图鉴</text>
      <text class="crumb-sep">/</text>
      <text class="crumb-cur">{{locked ? '未记录' : (card.nameZh || '卡片')}}</text>
    </view>

    <!-- 图版（2026-10-17 重设计）：点亮 = 一整张浅纸标本签（铜别针 + 内发丝框 + 刻版线描 + 名称 / 学名 / 编号）；
         未点亮 = 虚线空位，只露编号（不剧透形态）。 -->
    <view class="plate {{locked ? 'is-blank' : 'is-lit'}} {{card.rarity === 'legendary' && !locked ? 'is-legend' : ''}}">
      <block wx:if="{{!locked}}">
        <view class="plate-pin" aria-hidden="true"></view>
        <view class="plate-top">
          <text class="plate-no">PLATE No.{{card.no}}</text>
          <text class="plate-rare" wx:if="{{card.rareMark}}">{{card.rareMark}}</text>
        </view>
        <image class="plate-art" src="{{card.plate}}" mode="aspectFit" wx:if="{{card.plate}}"></image>
        <text class="plate-name">{{card.nameZh}}</text>
        <text class="plate-latin" wx:if="{{card.nameLatin}}">{{card.nameLatin}}</text>
        <view class="plate-meta">
          <text wx:if="{{card.category}}">{{card.category}}</text>
          <text class="dot-sep" wx:if="{{card.category && seriesText}}">·</text>
          <text wx:if="{{seriesText}}">{{seriesText}}</text>
          <block wx:if="{{card.hasSpot}}">
            <text class="dot-sep" wx:if="{{card.category || seriesText}}">·</text>
            <text>馆内印记</text>
          </block>
        </view>
      </block>
      <block wx:else>
        <text class="blank-no">{{card.no || '—'}}</text>
        <text class="blank-t">这一页还空着</text>
        <text class="blank-spot" wx:if="{{card.hasSpot}}">馆内可寻</text>
      </block>
    </view>
    <text class="method-line" wx:if="{{methodText && !locked}}">{{methodText}}</text>

    <view class="locked-note" wx:if="{{locked}}">
      <text class="essay">它在馆里，等被看见。扫到印记或拍照采集之后，这一页才会把产地、习性、柜位与那段话写给你。</text>
    </view>

    <view class="collect-dock dual" wx:if="{{locked}}">
      <view class="dock-half" bindtap="onScan" hover-class="tap-press-soft" hover-stay-time="80">
        <text class="collect-dock-t ghost">发现印记</text>
      </view>
      <view class="dock-half primary" bindtap="goIdentify" hover-class="tap-press-soft" hover-stay-time="80">
        <text class="collect-dock-t">拍照采集</text>
      </view>
    </view>

    <block wx:else>
      <view class="essay-block" wx:if="{{card.essay}}">
        <text class="sec-eyebrow">NOTE</text>
        <text class="essay">{{card.essay}}</text>
      </view>

      <view class="facts">
        <view class="fact" wx:for="{{facts}}" wx:key="k">
          <text class="fact-k">{{item.k}}</text>
          <view class="fact-row" wx:if="{{item.k === '印记码'}}">
            <text class="fact-v mono">{{item.v}}</text>
            <text class="fact-copy" bindtap="copyImprint" hover-class="tap-press" hover-stay-time="80">复制</text>
          </view>
          <text class="fact-v" wx:else>{{item.v}}</text>
        </view>
      </view>

      <view class="related" wx:if="{{relatedProducts.length}}">
        <view class="related-head">
          <text class="sec-t">关联藏品</text>
          <text class="related-more" bindtap="goGallery" hover-class="tap-press" hover-stay-time="80">去馆藏</text>
        </view>
        <view
          class="product"
          wx:for="{{relatedProducts}}"
          wx:key="_id"
          bindtap="goProduct"
          data-id="{{item._id}}"
          hover-class="tap-press"
          hover-stay-time="80"
        >
          <image wx:if="{{item.image}}" class="product-img" src="{{item.image}}" mode="aspectFill" />
          <view wx:else class="product-img empty"></view>
          <view class="product-body">
            <text class="product-title">{{item.title}}</text>
            <text class="product-latin" wx:if="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
            <text class="product-price" wx:if="{{item.priceText}}">¥{{item.priceText}}</text>
          </view>
        </view>
      </view>

      <view class="related soft" wx:else>
        <view class="related-head">
          <text class="sec-t">关联藏品</text>
        </view>
        <text class="related-empty">馆藏里暂未挂上对应 SKU。可先去同品类看看。</text>
        <view class="related-cta" bindtap="goGallery" hover-class="tap-press-soft" hover-stay-time="80">浏览馆藏</view>
      </view>

      <view class="logs">
        <view class="logs-head">
          <text class="sec-t">采集记录</text>
          <text class="logs-more" bindtap="goLogs" hover-class="tap-press" hover-stay-time="80">全部足迹</text>
        </view>
        <block wx:if="{{hasLogs}}">
          <view class="log" wx:for="{{logs}}" wx:key="id">
            <view class="log-row">
              <text class="log-m" wx:if="{{item.methodLabel}}">{{item.methodLabel}}</text>
              <text class="log-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
            </view>
            <text class="log-p" wx:if="{{item.place}}">{{item.place}}</text>
          </view>
        </block>
        <text class="logs-empty" wx:else>还没有采集记录。下一次扫码或拍照，会写在这里。</text>
      </view>

      <view class="share-dock">
        <button class="btn-share" open-type="share" hover-class="btn-share-press" hover-stay-time="80">把这一页寄出去</button>
      </view>
    </block>
  </block>

  <view class="ui-pop-mask is-center is-deep unlock-mask" wx:if="{{justUnlocked}}" catchtouchmove="closeCeremony">
    <view class="ui-pop-dialog unlock-sheet">
      <view class="ui-pop-head is-center">
        <text class="ui-pop-kicker">PAGE TURNED</text>
        <text class="ui-pop-title">这一页被翻开了</text>
      </view>
      <text class="unlock-name">{{card.nameZh}}</text>
      <text class="unlock-latin" wx:if="{{card.nameLatin}}">{{card.nameLatin}}</text>
      <view class="ui-pop-btn is-primary unlock-cta" bindtap="closeCeremony" hover-class="tap-press" hover-stay-time="80">看这一页</view>
    </view>
  </view>
</view>
