page { background: #1A1814; }

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
}

.page.has-dock,
.page.has-share {
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.crumb {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.crumb-link {
  font-size: var(--fs-22);
  color: var(--color-primary);
  letter-spacing: 0.04em;
}

.crumb-sep {
  font-size: var(--fs-22);
  color: #4A4540;
}

.crumb-cur {
  font-size: var(--fs-22);
  color: #A09A90;
}

.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx 120rpx;
  color: #A09A90;
  gap: 20rpx;
  text-align: center;
}

.skel-plate {
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-lg);
  background: #1F1D1A;
  border: 1rpx solid #262320;
  animation: pulse 1.2s ease-in-out infinite;
}

.skel-block {
  width: 100%;
  margin-top: 24rpx;
}

.skel-line {
  height: 28rpx;
  margin-bottom: 16rpx;
  background: #262320;
  border-radius: var(--radius-sm);
  animation: pulse 1.2s ease-in-out infinite;
}

.skel-line.mid { width: 72%; }
.skel-line.short { width: 48%; }

.loading-t {
  margin-top: 24rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

@keyframes pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.error-t { color: #FFFFFF; font-size: var(--fs-30); }

.link {
  font-size: var(--fs-24);
  color: var(--color-primary);
}

/* —— 图版（2026-10-17）：点亮 = 浅纸标本签；未点亮 = 虚线空位 —— */
.plate {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 56rpx 40rpx 44rpx;
  box-sizing: border-box;
  border-radius: 4rpx;
  overflow: hidden;
}

.plate.is-lit {
  background: linear-gradient(180deg, #F3ECDD, #E8DFCB);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.45);
}

.plate.is-lit::before {
  content: '';
  position: absolute;
  inset: 16rpx;
  border: 1rpx solid rgba(46, 38, 24, 0.22);
  pointer-events: none;
}

.plate.is-legend::before { border-color: rgba(176, 141, 87, 0.8); }

.plate-pin {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  margin-left: -10rpx;
  border-radius: 50%;
  background: #B08D57;
}

.plate-top {
  align-self: stretch;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.plate-no {
  font-family: var(--font-mono);
  font-size: var(--fs-20);
  letter-spacing: 0.16em;
  color: #8A7F6C;
}

.plate-rare {
  padding: 0 10rpx;
  line-height: 32rpx;
  font-size: var(--fs-20);
  color: #8B6F47;
  border: 1rpx solid rgba(139, 111, 71, 0.5);
  border-radius: 4rpx;
}

.plate-art {
  width: 360rpx;
  height: 360rpx;
  margin-top: 12rpx;
}

.plate-name {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #2E2618;
  text-align: center;
}

.plate-latin {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-latin);
  font-style: italic;
  font-size: var(--fs-24);
  color: #8B6F47;
  text-align: center;
}

.plate-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(46, 38, 24, 0.18);
  font-size: var(--fs-22);
  color: #5E5444;
}

.dot-sep { color: #8A7F6C; }

.plate.is-blank {
  min-height: 520rpx;
  justify-content: center;
  border: 2rpx dashed rgba(196, 167, 108, 0.24);
}

.blank-no {
  font-family: var(--font-mono);
  font-size: 96rpx;
  color: rgba(196, 167, 108, 0.42);
}

.blank-t {
  margin-top: 16rpx;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
}

.blank-spot {
  margin-top: 12rpx;
  font-size: var(--fs-22);
  color: var(--brass-300);
  letter-spacing: 0.08em;
}

.sec-eyebrow {
  display: block;
  margin-bottom: 16rpx;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  letter-spacing: 0.24em;
  color: var(--brass-300);
}

.locked-note,
.essay-block {
  margin: 40rpx 0 32rpx;
}

/* 那段话：宋体、宽行距 —— 图鉴的正文 */
.essay {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  line-height: 1.9;
  color: #E0DAD0;
}

.facts {
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

/* 事实条：发丝线两栏行（左签名、右正文） */
.fact {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.14);
}

.fact-k {
  flex-shrink: 0;
  width: 112rpx;
  font-size: var(--fs-22);
  line-height: 1.6;
  letter-spacing: 0.08em;
  color: var(--color-text-secondary);
}

.fact-row { flex: 1; min-width: 0; }

.fact-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.fact-v {
  display: block;
  font-size: var(--fs-26);
  color: #D5D1C8;
  line-height: 1.6;
  flex: 1;
  min-width: 0;
}

.fact-v.mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.06em;
  color: var(--color-primary);
}

.fact-copy {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--color-primary);
  letter-spacing: 0.06em;
  padding: 4rpx 0;
}


.related {
  margin-top: 56rpx;
}

.related.soft {
  border-color: rgba(38, 35, 32, 0.66);
}

.related-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.related-more {
  font-size: var(--fs-24);
  color: var(--color-primary);
  letter-spacing: 0.04em;
  flex-shrink: 0;
  margin-left: 24rpx;
}


.related-empty {
  display: block;
  font-size: var(--fs-24);
  color: #6B6560;
  line-height: 1.55;
}

.related-cta {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--fs-26);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-md);
}

.product {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0 0;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
}

.product + .product {
  margin-top: 24rpx;
}


.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  background: #171512;
  flex-shrink: 0;
}

.product-img.empty {
  border: 1rpx solid #302810;
}

.product-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-top: 4rpx;
}

.product-title {
  font-size: var(--fs-28);
  line-height: 1.4;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-latin {
  margin-top: 8rpx;
  font-size: var(--fs-22);
  line-height: 1.35;
  font-style: italic; font-family: var(--font-latin);
  color: var(--color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  margin-top: 12rpx;
  font-size: var(--fs-26);
  line-height: 1.2;
  color: #D5D1C8;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
}

.logs { margin-top: 56rpx; }

.logs-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.logs-more {
  font-size: var(--fs-24);
  color: var(--color-primary);
  letter-spacing: 0.04em;
}

.sec-t {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-30);
  letter-spacing: 0.08em;
  color: #F3ECDD;
}

.logs > .sec-t {
  margin-bottom: 8rpx;
}

.logs-empty {
  display: block;
  margin-top: 16rpx;
  font-size: var(--fs-24);
  color: #6B6560;
  line-height: 1.55;
}

.log {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(38, 35, 32, 0.5);
}

.log:last-child {
  border-bottom: none;
}

.log-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.log-m {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-26);
  line-height: 1.35;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-time {
  flex-shrink: 0;
  font-size: var(--fs-22);
  line-height: 1.35;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.log-p {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-22);
  line-height: 1.35;
  color: var(--color-text-secondary);
}

.btn-brass {
  margin-top: 32rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  background: var(--color-primary);
  color: #1A1814;
  font-size: var(--fs-28);
  border: none;
  border-radius: var(--radius-md);
}

.btn-brass::after { border: none; }

.collect-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 实底底栏（2026-10-17）：浮空按钮下滚过的正文会从缝里露出来 */
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #1A1814;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  z-index: 20;
  display: flex;
}

.collect-dock.dual .dock-half {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1F1D1A;
  border: 1rpx solid var(--color-primary);
}

.collect-dock.dual .dock-half + .dock-half {
  margin-left: 16rpx;
}

.collect-dock.dual .dock-half.primary {
  background: var(--color-primary);
  border: none;
}

.collect-dock-t {
  font-size: var(--fs-28);
  font-weight: 500;
  color: #1A1814;
  letter-spacing: 0.04em;
}

.collect-dock-t.ghost {
  color: var(--color-primary);
}


.method-line {
  display: block;
  text-align: center;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  letter-spacing: 0.08em;
}

.share-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 实底底栏（2026-10-17）：浮空按钮下滚过的正文会从缝里露出来 */
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #1A1814;
  border-top: 1rpx solid rgba(196, 167, 108, 0.14);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
}

/* WeChat 原生 button 默认按文案缩宽，需强制重置 */
.share-dock .btn-share,
button.btn-share {
  width: 100% !important;
  max-width: 100%;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--color-primary) !important;
  color: #1A1814 !important;
  font-size: var(--fs-28);
  font-weight: 500;
  letter-spacing: 0.04em;
  border: none;
  border-radius: var(--radius-md);
  text-align: center;
}

.share-dock .btn-share::after,
button.btn-share::after {
  border: none !important;
}

.btn-share-press {
  background: #A8903C !important;
  color: #1A1814 !important;
}





/* 解锁仪式卡：ui-pop-mask is-center is-deep + ui-pop-dialog（docs/弹层视觉规范_2026-10-13.md）；这里只排卡内藏品信息 */
.unlock-mask { z-index: 40; }
.unlock-sheet { text-align: center; }
.unlock-cta { display: block; flex: none; margin-top: 40rpx; }
.unlock-name {
  display: block;
  margin-top: 28rpx;
  font-size: var(--fs-32);
  color: #E8E4DC;
}

.unlock-latin {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  font-style: italic; font-family: var(--font-latin);
  color: var(--color-primary);
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .skel-plate,
  .skel-line {
    animation: none;
  }
}
