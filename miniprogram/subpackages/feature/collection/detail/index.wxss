page { background: #1A1814; }

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #1A1814;
}

.page.has-dock,
.page.has-share {
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.crumb {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.crumb-link {
  font-size: 22rpx;
  color: #C4A76C;
  letter-spacing: 0.04em;
}

.crumb-sep {
  font-size: 22rpx;
  color: #4A4540;
}

.crumb-cur {
  font-size: 22rpx;
  color: #A09A90;
}

.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx 120rpx;
  color: #A09A90;
  gap: 20rpx;
  text-align: center;
}

.skel-plate {
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
  background: #1F1D1A;
  border: 1rpx solid #262320;
  animation: pulse 1.2s ease-in-out infinite;
}

.skel-block {
  width: 100%;
  margin-top: 24rpx;
}

.skel-line {
  height: 28rpx;
  margin-bottom: 16rpx;
  background: #262320;
  border-radius: 8rpx;
  animation: pulse 1.2s ease-in-out infinite;
}

.skel-line.mid { width: 72%; }
.skel-line.short { width: 48%; }

.loading-t {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #6B6560;
}

@keyframes pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.error-t { color: #FFFFFF; font-size: 30rpx; }

.link {
  font-size: 24rpx;
  color: #C4A76C;
}

.plate {
  position: relative;
  padding: 40rpx 32rpx 36rpx;
  background: #1F1D1A;
  border: 1rpx solid #4D401A;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.plate-rim {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 16rpx;
  bottom: 16rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.18);
  border-radius: 16rpx;
  pointer-events: none;
}

.plate-silver { border-color: #8A8A8A; }
.plate-gold { border-color: #C4A76C; }
.plate.dim { opacity: 0.9; }

.tone-insecta .plate-rim { border-color: rgba(82, 183, 136, 0.22); }
.tone-plantae .plate-rim { border-color: rgba(109, 163, 77, 0.22); }
.tone-minerals .plate-rim { border-color: rgba(123, 104, 174, 0.22); }
.tone-marine .plate-rim { border-color: rgba(91, 143, 185, 0.22); }

.plate-en {
  position: relative;
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.28em;
  color: rgba(196, 167, 108, 0.65);
}

.plate-no {
  position: relative;
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #C4A76C;
  letter-spacing: 0.12em;
}

.silhouette.big {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 32rpx auto;
  border-radius: 50%;
  background: radial-gradient(circle, #2A2620 0%, #171512 70%);
  border: 1rpx solid #302810;
  display: flex;
  align-items: center;
  justify-content: center;
}

.silhouette-ring {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 1rpx solid #4D401A;
  opacity: 0.75;
}

.plate-mark-block {
  position: relative;
  display: inline-block;
  margin: 28rpx 0 0;
  padding: 12rpx 24rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: 8rpx;
  background: rgba(196, 167, 108, 0.06);
}

.plate-mark-en {
  font-size: 18rpx;
  letter-spacing: 0.22em;
  color: rgba(196, 167, 108, 0.8);
}

.plate-name {
  position: relative;
  display: block;
  margin-top: 24rpx;
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.plate-latin {
  position: relative;
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-style: italic;
  color: #C4A76C;
}

.meta {
  position: relative;
  display: flex;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #A09A90;
}

.dot-sep { color: #4A4540; }

.meta-spot {
  color: #C4A76C;
  letter-spacing: 0.04em;
}

.dots {
  position: relative;
  display: flex;
  gap: 8rpx;
  margin-top: 20rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #302810;
}

.dot.on { background: #C4A76C; }
.plate-silver .dot.on { background: #C8C8C8; }

.locked-note,
.essay-block {
  margin-bottom: 32rpx;
}

.essay {
  display: block;
  font-size: 30rpx;
  line-height: 1.75;
  color: #D5D1C8;
}

.facts {
  border-top: 1rpx solid #262320;
  padding-top: 8rpx;
}

.fact {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #262320;
}

.fact-k {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: #6B6560;
  margin-bottom: 8rpx;
}

.fact-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.fact-v {
  display: block;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.6;
  flex: 1;
  min-width: 0;
}

.fact-v.mono {
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.06em;
  color: #C4A76C;
}

.fact-copy {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #C4A76C;
  letter-spacing: 0.06em;
  padding: 4rpx 0;
}


.related {
  margin-top: 48rpx;
  padding: 32rpx;
  background: #1F1D1A;
  border: 1rpx solid rgba(38, 35, 32, 0.66);
  border-radius: 24rpx;
}

.related.soft {
  border-color: rgba(38, 35, 32, 0.66);
}

.related-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.related-more {
  font-size: 24rpx;
  color: #C4A76C;
  letter-spacing: 0.04em;
  flex-shrink: 0;
  margin-left: 24rpx;
}


.related-empty {
  display: block;
  font-size: 24rpx;
  color: #6B6560;
  line-height: 1.55;
}

.related-cta {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #C4A76C;
  border: 1rpx solid #C4A76C;
  border-radius: 16rpx;
}

.product {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0 0;
  border-top: 1rpx solid rgba(38, 35, 32, 0.66);
}

.product + .product {
  margin-top: 24rpx;
}


.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #171512;
  flex-shrink: 0;
}

.product-img.empty {
  border: 1rpx solid #302810;
}

.product-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-top: 4rpx;
}

.product-title {
  font-size: 28rpx;
  line-height: 1.4;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-latin {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  font-style: italic;
  color: #C4A76C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.2;
  color: #D5D1C8;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
}

.logs { margin-top: 48rpx; }

.logs-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.logs-more {
  font-size: 24rpx;
  color: #C4A76C;
  letter-spacing: 0.04em;
}

.sec-t {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.16em;
  color: #A09A90;
}

.logs > .sec-t {
  margin-bottom: 8rpx;
}

.logs-empty {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6B6560;
  line-height: 1.55;
}

.log {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(38, 35, 32, 0.5);
}

.log:last-child {
  border-bottom: none;
}

.log-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.log-m {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.35;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-time {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.35;
  color: #6B6560;
  font-variant-numeric: tabular-nums;
}

.log-p {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #6B6560;
}

.btn-brass {
  margin-top: 32rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  background: #C4A76C;
  color: #1A1814;
  font-size: 28rpx;
  border: none;
  border-radius: 16rpx;
}

.btn-brass::after { border: none; }

.collect-dock {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
}

.collect-dock.dual .dock-half {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1F1D1A;
  border: 1rpx solid #C4A76C;
}

.collect-dock.dual .dock-half + .dock-half {
  margin-left: 16rpx;
}

.collect-dock.dual .dock-half.primary {
  background: #C4A76C;
  border: none;
}

.collect-dock-t {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1814;
  letter-spacing: 0.04em;
}

.collect-dock-t.ghost {
  color: #C4A76C;
}


.series-line,
.method-line {
  position: relative;
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #C4A76C;
  letter-spacing: 0.08em;
}

.method-line { color: #A09A90; }

.share-dock {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
}

/* WeChat 原生 button 默认按文案缩宽，需强制重置 */
.share-dock .btn-share,
button.btn-share {
  width: 100% !important;
  max-width: 100%;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #C4A76C !important;
  color: #1A1814 !important;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  border: none;
  border-radius: 16rpx;
  text-align: center;
}

.share-dock .btn-share::after,
button.btn-share::after {
  border: none !important;
}

.btn-share-press {
  background: #A8903C !important;
  color: #1A1814 !important;
}

.unlock-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(26, 24, 20, 0.92);
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.unlock-sheet {
  width: 100%;
  background: #1F1D1A;
  border: 1rpx solid #4D401A;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.unlock-en {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.28em;
  color: rgba(196, 167, 108, 0.7);
}

.unlock-title {
  display: block;
  margin-top: 16rpx;
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.unlock-name {
  display: block;
  margin-top: 28rpx;
  font-size: 32rpx;
  color: #E8E4DC;
}

.unlock-latin {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-style: italic;
  color: #C4A76C;
}

.unlock-cta {
  margin-top: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #C4A76C;
  color: #1A1814;
  font-size: 28rpx;
  border-radius: 16rpx;
}

