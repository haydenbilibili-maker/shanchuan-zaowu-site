<!-- 山海图鉴 · 卷一（2026-10-17 重设计）：卷首 → 卷章 → 图版（三列标本册）→ 近期足迹；底部「发现印记 / 拍照采集」。
     未点亮的页只露编号（不剧透形态）；点亮的页是一张浅纸标本签 + 刻版线描。 -->
<view class="page">
  <!-- 卷首：大数字 + 每页一格的刻度 + 一句下一步 -->
  <view class="cover">
    <text class="cover-eyebrow">ATLAS · VOL. I · 卷一</text>
    <text class="cover-title">山海图鉴</text>
    <view class="cover-count" wx:if="{{!loading}}">
      <text class="cover-num">{{stats.unlocked}}</text>
      <text class="cover-total">/ {{stats.total}} 页已翻开</text>
    </view>
    <view class="ticks" wx:if="{{!loading && ticks.length}}" aria-hidden="true">
      <view class="tick {{item.lit ? 'is-lit' : ''}}" wx:for="{{ticks}}" wx:key="no"></view>
    </view>
    <text class="cover-hint" wx:if="{{!loading && nextHint}}">{{nextHint}}</text>
  </view>

  <!-- 卷章：三个系列 = 三章，各自的进度；点一章只看这一章 -->
  <view class="chapters" wx:if="{{stats.series.length && !loading}}">
    <view class="sec-head">
      <text class="sec-eyebrow">CHAPTERS</text>
      <text class="sec-title">卷章</text>
    </view>
    <view
      class="chapter {{seriesFilter === item.id ? 'is-on' : ''}}"
      wx:for="{{stats.series}}"
      wx:key="id"
      bindtap="onSeries"
      data-id="{{item.id}}"
      hover-class="tap-press-soft"
      hover-stay-time="80"
      aria-role="button"
      aria-label="{{item.name}}，已翻开 {{item.got}} / {{item.total}}"
    >
      <text class="chapter-no">{{index + 1}}</text>
      <view class="chapter-main">
        <text class="chapter-name">{{item.name}}</text>
        <text class="chapter-blurb" wx:if="{{item.blurb}}">{{item.blurb}}</text>
      </view>
      <text class="chapter-done" wx:if="{{item.complete}}">已齐</text>
      <text class="chapter-count" wx:else>{{item.got}}/{{item.total}}</text>
    </view>
  </view>

  <!-- 图版：门类一行（带各自进度）+ 三列标本册 -->
  <view class="sec-head plates-head" wx:if="{{!loading}}">
    <view class="sec-head-t">
      <text class="sec-eyebrow">PLATES</text>
      <text class="sec-title">图版</text>
    </view>
    <text class="sec-link" bindtap="goNotes" hover-class="tap-press" hover-stay-time="80">采集日志 ›</text>
  </view>

  <scroll-view scroll-x class="cats" enable-flex show-scrollbar="{{false}}" wx:if="{{!loading && categories.length}}">
    <view class="cats-inner">
      <view
        class="cat {{filter === item.id && !seriesFilter ? 'is-on' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="onFilter"
        data-id="{{item.id}}"
        hover-class="tap-press"
        hover-stay-time="80"
      >
        <text class="cat-name">{{item.label}}</text>
        <text class="cat-count">{{item.got}}/{{item.total}}</text>
      </view>
    </view>
  </scroll-view>
  <text class="series-blurb" wx:if="{{seriesBlurb && !loading}}">{{seriesBlurb}}</text>

  <!-- 骨架：用 data 数组，避免内联 {{[1,2,3]}} 在部分基础库/编译器上踩坑 -->
  <view class="album skel" wx:if="{{loading}}">
    <view class="slot skel-slot" wx:for="{{skelPlates}}" wx:key="*this"></view>
  </view>

  <view class="error" wx:elif="{{loadError}}">
    <text class="error-t">图鉴这一册还没打开</text>
    <text class="error-s">请稍后重试。馆里的世界还在。</text>
    <button class="btn-brass" bindtap="loadCatalog">再试一次</button>
  </view>

  <view class="empty" wx:elif="{{filterEmpty}}">
    <text class="empty-t">这一格还是空的</text>
    <text class="empty-s">换一个门类，或回到全部。</text>
    <button class="btn-brass" bindtap="clearFilters">看全部</button>
  </view>

  <view class="empty" wx:elif="{{catalogEmpty}}">
    <text class="empty-t">卷一尚未装订</text>
    <text class="empty-s">稍后再来。也可先去馆里走走，或拍照采集。</text>
    <view class="empty-actions">
      <button class="btn-ghost" bindtap="onScan">发现印记</button>
      <button class="btn-brass" bindtap="goIdentify" wx:if="{{showAiIdentify}}">拍照采集</button>
    </view>
  </view>

  <view class="album" wx:else>
    <view
      class="slot {{item.unlocked ? 'is-lit' : 'is-blank'}} {{item.rarity === 'legendary' && item.unlocked ? 'is-legend' : ''}}"
      wx:for="{{filtered}}"
      wx:key="id"
      bindtap="onOpen"
      data-id="{{item.id}}"
      hover-class="slot-press"
      hover-stay-time="80"
      aria-role="button"
      aria-label="{{item.unlocked ? item.nameZh : '未记录的一页'}}，编号 {{item.no}}"
    >
      <block wx:if="{{item.unlocked}}">
        <view class="slot-pin" aria-hidden="true"></view>
        <text class="slot-no">No.{{item.no}}</text>
        <text class="slot-rare" wx:if="{{item.rareMark}}">{{item.rareMark}}</text>
        <image class="slot-plate" src="{{item.plate}}" mode="aspectFit" wx:if="{{item.plate}}"></image>
        <text class="slot-name">{{item.nameZh}}</text>
        <text class="slot-latin" wx:if="{{item.nameLatin}}">{{item.nameLatin}}</text>
      </block>
      <block wx:else>
        <text class="slot-blank-no">{{item.no}}</text>
        <text class="slot-blank-t">未记录</text>
        <text class="slot-spot" wx:if="{{item.hasSpot}}">馆内可寻</text>
      </block>
    </view>
  </view>

  <!-- 近期足迹：最近三笔，全部去采集日志 -->
  <view class="notes" wx:if="{{recentNotes.length && !loading}}">
    <view class="sec-head">
      <view class="sec-head-t">
        <text class="sec-eyebrow">FIELD NOTES</text>
        <text class="sec-title">近期足迹</text>
      </view>
      <text class="sec-link" bindtap="goNotes" hover-class="tap-press" hover-stay-time="80">全部 ›</text>
    </view>
    <view
      class="note {{item.wild ? 'wild' : ''}}"
      wx:for="{{recentNotes}}"
      wx:key="id"
      bindtap="onOpenNote"
      data-id="{{item.speciesId}}"
      hover-class="tap-press-soft"
      hover-stay-time="80"
    >
      <text class="note-title">{{item.title}}</text>
      <text class="note-meta">{{item.metaText}}</text>
    </view>
  </view>

  <view class="dock">
    <view class="dock-btn" bindtap="onScan" hover-class="tap-press-soft" hover-stay-time="80">发现印记</view>
    <view class="dock-btn primary" bindtap="goIdentify" hover-class="tap-press-soft" hover-stay-time="80" wx:if="{{showAiIdentify}}">拍照采集</view>
  </view>

  <view class="ui-pop-mask is-center is-deep unlock-mask" wx:if="{{unlockSheet.show}}" catchtouchmove="onUnlockStay">
    <view class="ui-pop-dialog unlock-sheet">
      <view class="ui-pop-head is-center">
        <text class="ui-pop-kicker">PAGE TURNED</text>
        <text class="ui-pop-title">这一页被翻开了</text>
      </view>
      <text class="unlock-name">{{unlockSheet.nameZh}}</text>
      <text class="unlock-latin" wx:if="{{unlockSheet.nameLatin}}">{{unlockSheet.nameLatin}}</text>
      <text class="unlock-msg">{{unlockSheet.msg}}</text>
      <view class="ui-pop-btn is-primary unlock-cta" bindtap="onUnlockOpen" hover-class="tap-press" hover-stay-time="80">去看这一页</view>
      <view class="unlock-later" bindtap="onUnlockStay" hover-class="tap-press" hover-stay-time="80">先留在图鉴</view>
    </view>
  </view>
</view>
