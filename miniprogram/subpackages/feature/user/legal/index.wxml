<!--subpackages/feature/user/legal/index.wxml-->
<view class="account-page page-legal">
  <view class="grain-overlay"></view>

  <view
    class="account-nav legal-nav"
    style=" padding-right: {{navPaddingRight}}px;"
  >
    <view class="account-nav-row">
      <view class="account-nav-brand">
        <text class="account-nav-title">{{doc.title}}</text>
        <text class="account-nav-sub">{{doc.subtitle}}</text>
      </view>
    </view>
  </view>

  <scroll-view
    scroll-y
    class="account-scroll legal-scroll"
    show-scrollbar="{{false}}"
    style="top: {{headerBlockPx}}px; height: {{scrollHeightPx}}px;"
  >
    <view class="legal-meta account-section-card">
      <text class="legal-brand">山海造物 · NATURE'S CREATIONS</text>
      <text class="legal-updated">更新日期：{{doc.updatedAt}}</text>
      <text class="legal-intro">把山海带回家。以下条款适用于本微信小程序及相关会员服务。</text>
    </view>

    <view class="legal-section account-section-card" wx:for="{{doc.sections}}" wx:key="heading">
      <text class="legal-heading">{{item.heading}}</text>
      <text class="legal-para" wx:for="{{item.paragraphs}}" wx:for-item="para" wx:key="*this">{{para}}</text>
    </view>

    <view class="legal-footer-note">
      <text>如需纸质版本或进一步说明，请联系门店专员。</text>
      <view class="legal-support-link" hover-class="legal-support-press" bindtap="goSupport">联系专员 →</view>
    </view>

    <view class="account-scroll-pad"></view>
  </scroll-view>
</view>
