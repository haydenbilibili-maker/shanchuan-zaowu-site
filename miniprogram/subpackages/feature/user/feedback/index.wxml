<!--subpackages/feature/user/feedback/index.wxml-->
<view class="account-page page-feedback">
  <view class="grain-overlay"></view>

  <view
    class="account-nav"
    style=" padding-right: {{navPaddingRight}}px;"
  >
    <view class="account-nav-row">
      <view class="account-nav-brand">
        <text class="account-nav-title">反馈与建议</text>
        <text class="account-nav-sub">FEEDBACK</text>
      </view>
    </view>
  </view>

  <scroll-view
    scroll-y
    class="account-scroll"
    show-scrollbar="{{false}}"
    style="top: {{headerBlockPx}}px; height: {{scrollHeightPx}}px;"
  >
    <view class="account-section-card fb-intro">
      <text class="fb-intro-text">你的每一条建议，都会帮助我们把藏品与体验做得更好。提交后可在「山海有信」查看回执。</text>
    </view>

    <view class="account-section-card">
      <view class="account-section-label">反馈类型</view>
      <view class="account-chip-row">
        <view
          class="account-chip {{activeCategory === item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          hover-class="account-chip-press"
          bindtap="selectCategory"
          data-id="{{item.id}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="account-section-card">
      <view class="account-section-label">详细描述</view>
      <textarea
        class="fb-textarea"
        placeholder="请描述你的建议或遇到的问题（至少 5 字）"
        maxlength="500"
        value="{{messageText}}"
        bindinput="onMessageInput"
        show-confirm-bar="{{false}}"
      ></textarea>
      <text class="fb-counter">{{messageText.length}}/500</text>
    </view>

    <view class="account-section-card">
      <view class="account-field">
        <text class="account-field-label">联系电话（选填）</text>
        <input
          class="account-field-input"
          type="number"
          maxlength="11"
          placeholder="便于我们必要时联系您"
          value="{{contactPhone}}"
          bindinput="onPhoneInput"
        />
      </view>
    </view>

    <view class="account-section-card fb-links">
      <view class="fb-link-row" hover-class="fb-link-press" bindtap="openLegal" data-type="terms">
        <text class="fb-link-label">用户服务协议</text>
        <text class="fb-link-arrow">→</text>
      </view>
      <view class="fb-link-row" hover-class="fb-link-press" bindtap="openLegal" data-type="privacy">
        <text class="fb-link-label">隐私政策</text>
        <text class="fb-link-arrow">→</text>
      </view>
      <view class="fb-link-row last" hover-class="fb-link-press" bindtap="goSupport">
        <text class="fb-link-label">需要订单/售后帮助？联系专员</text>
        <text class="fb-link-arrow">→</text>
      </view>
    </view>

    <view class="account-scroll-pad"></view>
  </scroll-view>

  <view class="account-footer account-footer-safe">
    <view class="account-btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submitFeedback">
      {{submitting ? '提交中…' : '提交反馈'}}
    </view>
  </view>
</view>
