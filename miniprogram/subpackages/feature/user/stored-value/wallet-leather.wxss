/* 皮质钱包卡（我的钱包 / 确认订单共用）— 蟒皮：馆藏底纹 + 鳞格叠层，博物馆暗色 */
.wallet-leather-card {
  position: relative;
  box-sizing: border-box;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(107, 90, 36, 0.48);
  background-color: var(--color-bg);
  background-image:
    radial-gradient(ellipse 108% 92% at 50% 52%, transparent 32%, rgba(26, 24, 20, 0.78) 100%),
    radial-gradient(ellipse 58% 42% at 12% 78%, rgba(20, 18, 16, 0.62) 0%, transparent 72%),
    radial-gradient(ellipse 52% 40% at 92% 18%, rgba(26, 24, 20, 0.52) 0%, transparent 68%),
    linear-gradient(
      166deg,
      rgba(44, 37, 29, 0.84) 0%,
      rgba(34, 29, 23, 0.52) 40%,
      rgba(28, 25, 21, 0.45) 58%,
      rgba(20, 18, 16, 0.8) 100%
    ),
    linear-gradient(0deg, rgba(139, 111, 71, 0.2), rgba(139, 111, 71, 0.1));
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  overflow: hidden;
  transition: border-color 0.2s ease;
  box-shadow:
    inset 0 0 0 2rpx rgba(77, 64, 26, 0.32),
    inset 0 0 0 7rpx rgba(38, 32, 26, 0.38);
}
.wallet-leather-card.is-on {
  border-color: rgba(196, 167, 108, 0.62);
  box-shadow:
    inset 0 0 0 2rpx rgba(196, 167, 108, 0.22),
    inset 0 0 0 7rpx rgba(38, 32, 26, 0.38);
}
.wallet-leather-card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2rpx;
  z-index: 2;
  pointer-events: none;
  background: linear-gradient(90deg, transparent 6%, rgba(212, 188, 133, 0.42) 50%, transparent 94%);
}
.wallet-leather-card::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(118deg, transparent 36%, rgba(224, 207, 163, 0.08) 50%, transparent 64%),
    linear-gradient(
      180deg,
      rgba(212, 188, 133, 0.11) 0%,
      transparent 20%,
      transparent 76%,
      rgba(20, 18, 16, 0.38) 100%
    ),
    radial-gradient(ellipse 44% 34% at 26% 46%, rgba(26, 24, 20, 0.58) 0%, transparent 74%),
    radial-gradient(ellipse 38% 30% at 70% 54%, rgba(22, 20, 17, 0.54) 0%, transparent 70%),
    radial-gradient(ellipse 30% 24% at 54% 26%, rgba(30, 26, 22, 0.42) 0%, transparent 72%),
    radial-gradient(ellipse 34% 26% at 40% 80%, rgba(20, 18, 16, 0.48) 0%, transparent 68%),
    repeating-linear-gradient(
      45deg,
      rgba(212, 188, 133, 0.05) 0,
      rgba(212, 188, 133, 0.05) 1rpx,
      transparent 1rpx,
      transparent 7rpx,
      rgba(26, 24, 20, 0.34) 7rpx,
      rgba(26, 24, 20, 0.34) 8rpx,
      transparent 8rpx,
      transparent 14rpx
    ),
    repeating-linear-gradient(
      -45deg,
      rgba(196, 167, 108, 0.04) 0,
      rgba(196, 167, 108, 0.04) 1rpx,
      transparent 1rpx,
      transparent 7rpx,
      rgba(26, 24, 20, 0.3) 7rpx,
      rgba(26, 24, 20, 0.3) 8rpx,
      transparent 8rpx,
      transparent 14rpx
    );
}
.wallet-leather-card__inner {
  position: relative;
  z-index: 3;
  padding: 40rpx 36rpx 32rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(212, 188, 133, 0.08),
    inset 0 -2rpx 0 rgba(20, 18, 16, 0.48);
}
.wallet-leather-card__inner::before {
  content: '';
  position: absolute;
  inset: 14rpx;
  border: 1rpx dashed rgba(77, 64, 26, 0.32);
  border-radius: calc(var(--radius-lg) - 10rpx);
  pointer-events: none;
}
.wallet-leather-card__inner::after {
  content: '';
  position: absolute;
  top: 32rpx;
  right: 36rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  pointer-events: none;
  background: radial-gradient(circle at 32% 28%, var(--brass-300), var(--brass-600) 62%, var(--brass-800));
  border: 1rpx solid rgba(107, 90, 36, 0.85);
  opacity: 0.78;
}
.wallet-leather-card--checkout {
  margin-bottom: 20rpx;
}
.wallet-leather-card--checkout .wallet-leather-card__inner {
  padding: 24rpx 32rpx 28rpx;
}
.wallet-leather-card--checkout .wallet-leather-card__inner::after {
  top: 24rpx;
  right: 28rpx;
  width: 12rpx;
  height: 12rpx;
}
.wallet-leather-card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: 36rpx;
}
.wallet-leather-card--checkout .wallet-leather-card__head {
  margin-bottom: 16rpx;
}
.wallet-leather-card__head-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
}
.wallet-leather-card__head--inline {
  margin-bottom: 16rpx;
}
.wallet-leather-card__head--inline .wallet-leather-tag {
  letter-spacing: 0.18em;
  color: var(--brass-600);
}
.wallet-leather-brand {
  font-family: var(--font-brand);
  font-size: 28rpx;
  color: var(--brass-300);
  letter-spacing: 0.08em;
}
.wallet-leather-tag {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--brass-700);
  font-weight: 500;
}
.wallet-leather-title-muted {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}
.wallet-leather-overline {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
}
.wallet-leather-card--checkout .wallet-leather-overline {
  font-size: 22rpx;
  letter-spacing: 0.06em;
  margin-bottom: 6rpx;
}
.wallet-leather-balance-row {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-bottom: 20rpx;
  min-height: 72rpx;
}
.wallet-leather-card--checkout .wallet-leather-balance-row {
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 0;
}
.wallet-leather-currency {
  font-family: var(--font-mono);
  font-size: 32rpx;
  color: var(--brass-400);
  padding-bottom: 10rpx;
  font-weight: 600;
}
.wallet-leather-card--checkout .wallet-leather-currency {
  font-size: 28rpx;
  padding-bottom: 0;
}
.wallet-leather-balance {
  font-family: var(--font-mono);
  font-size: 72rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1;
  letter-spacing: -0.02em;
}
.wallet-leather-card--checkout .wallet-leather-balance {
  font-size: 44rpx;
  line-height: 1.05;
  letter-spacing: 0.02em;
}
.wallet-leather-meta {
  display: flex;
  align-items: center;
  min-height: 32rpx;
  margin-bottom: 28rpx;
}
.wallet-leather-member {
  font-family: var(--font-mono);
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--brass-400);
  letter-spacing: 0.06em;
}
.wallet-leather-plate,
.wallet-leather-seam {
  border-top: 1rpx dashed rgba(77, 64, 26, 0.55);
  padding-top: 20rpx;
}
.wallet-leather-plate-text {
  font-size: 18rpx;
  letter-spacing: 0.12em;
  color: var(--brass-700);
}
.wallet-leather-balance-block {
  margin-bottom: 12rpx;
}
