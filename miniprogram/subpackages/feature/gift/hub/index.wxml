<!-- 礼赠主入口 · 场景选礼 + 馆藏挑礼 · Museum 纸面 -->
<view class="page {{paneReady ? 'pane-ready' : ''}}" wx:if="{{allowed}}">
  <scroll-view scroll-y class="scroll" enhanced show-scrollbar="{{false}}">
    <view class="hero-plate">
      <view class="hero-content">
        <view class="hero-over-row">
          <text class="overline">NATURE'S CREATIONS · GIFT</text>
        </view>
        <text class="hero-brand">山海造物</text>
        <text class="title">礼赠</text>
        <text class="desc">先选人生节点，柜中会按场景备妥藏品；也可直接去馆藏慢慢挑。</text>
      </view>
    </view>

    <!-- 从人情账本带入：为谁选礼 -->
    <view class="for-whom" wx:if="{{forWhom}}">
      <view class="signal-light lamp-brass"></view>
      <view class="for-whom-copy">
        <text class="for-whom-over">FOR</text>
        <text class="for-whom-name">正在为 {{forWhom}} 选礼</text>
      </view>
    </view>

    <!-- 场景选择 -->
    <view class="scene-block">
      <text class="section-overline">OCCASION</text>
      <text class="section-title">为哪一个时刻</text>
      <view class="scene-chips">
        <view
          class="scene-chip {{activeScene === item.key ? 'on' : ''}}"
          wx:for="{{scenes}}"
          wx:key="key"
          data-key="{{item.key}}"
          hover-class="tap-press"
          hover-stay-time="70"
          bindtap="onSceneTap"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
      <text class="scene-guide" wx:if="{{sceneGuide}}">{{sceneGuide}}</text>
    </view>

    <!-- 柜中备妥：双列扫选 -->
    <view class="match-block" wx:if="{{activeScene}}">
      <view class="match-head">
        <view class="match-titles">
          <text class="section-overline">CABINET</text>
          <view class="match-title-row">
            <text class="section-title tight">柜中备妥</text>
            <text
              class="match-link"
              bindtap="onRefreshBatch"
              hover-class="tap-press"
              hover-stay-time="70"
              wx:if="{{products.length && !loadingProducts}}"
            >换一批</text>
          </view>
        </view>
      </view>
      <text class="match-hint" wx:if="{{usedFallback && products.length}}">场景标签尚少，已混入可礼赠藏品作补充</text>

      <view class="match-loading" wx:if="{{loadingProducts}}">
        <view class="skel-grid">
          <view class="skel-card" wx:for="{{skelRows}}" wx:key="*this">
            <view class="skel-cover"></view>
            <view class="skel-line"></view>
            <view class="skel-line mid"></view>
          </view>
        </view>
        <text class="muted skel-hint">正在从柜中取出…</text>
      </view>

      <view class="match-empty paper-state" wx:elif="{{productsError}}">
        <view class="empty-mark paper-empty" aria-hidden="true">
          <view class="empty-ring"></view>
          <view class="signal-light lamp-warn"></view>
        </view>
        <text class="empty-title">柜门片刻未开</text>
        <text class="muted">{{productsError}}</text>
        <text class="match-link" bindtap="onRefreshBatch">再试一次</text>
      </view>

      <view class="product-grid" wx:elif="{{products.length}}">
        <view
          class="product-card"
          wx:for="{{products}}"
          wx:key="_id"
          data-id="{{item._id}}"
          hover-class="tap-press-soft"
          hover-stay-time="80"
          bindtap="onProductTap"
        >
          <view class="product-card-inner">
            <view class="product-cover-wrap">
              <!-- 需求 11：敏感形态模糊 -->
              <sensitive-blur-gate
                enabled="{{item.sensitiveEnabled}}"
                product-id="{{item._id}}"
                size="card"
              >
                <!-- 封面：云文件 ID 或缩略链都直接给 <image>；加载失败就让它露出深色占位底，不留破图 -->
                <image
                  wx:if="{{item.cover && !item.coverBroken}}"
                  class="product-cover"
                  src="{{item.cover}}"
                  mode="aspectFill"
                  lazy-load
                  binderror="onCoverError"
                  data-index="{{index}}"
                ></image>
              </sensitive-blur-gate>
              <text class="product-badge scene" wx:if="{{item.matchSource === 'scene'}}">场景</text>
              <text class="product-badge fallback" wx:else>荐</text>
              <protected-badge
                wx:if="{{item.isProtected}}"
                show="{{true}}"
                size="xs"
                corner="bl"
              />
            </view>
            <view class="product-body">
              <text class="product-theme" wx:if="{{item.themeName}}">{{item.themeName}}</text>
              <text class="product-theme-note" wx:if="{{item.themeName && item.themeNote}}">{{item.themeNote}}</text>
              <text class="product-title {{item.themeName ? 'is-sub' : ''}}">{{item.title}}</text>
              <text class="product-price">¥{{item.priceLabel}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="match-empty paper-state" wx:else>
        <view class="empty-mark paper-empty" aria-hidden="true">
          <view class="empty-ring"></view>
        </view>
        <text class="empty-title">这一格暂无匹配</text>
        <text class="muted">可换一批，或去馆藏慢慢挑</text>
        <view class="match-empty-actions">
          <text class="match-link" bindtap="onRefreshBatch">换一批</text>
          <text class="match-link" bindtap="goBrowse">去馆藏</text>
        </view>
      </view>
    </view>

    <view class="steps" wx:if="{{!activeScene}}">
      <view class="steps-head">
        <text class="section-overline">PATH</text>
        <text class="section-title tight">三步送出</text>
      </view>
      <view class="step">
        <text class="step-num">01</text>
        <view class="step-body">
          <text class="step-title">选场景或进馆藏</text>
          <text class="step-desc">场景会优先匹配带标签的藏品</text>
        </view>
      </view>
      <view class="step">
        <text class="step-num">02</text>
        <view class="step-body">
          <text class="step-title">写下礼笺</text>
          <text class="step-desc">可按关系或场景方向落笔</text>
        </view>
      </view>
      <view class="step">
        <text class="step-num">03</text>
        <view class="step-body">
          <text class="step-title">支付并交给 TA</text>
          <text class="step-desc">默认邀请 TA 填写地址</text>
        </view>
      </view>
    </view>

    <view class="cta-block">
      <view class="btn-primary" hover-class="btn-primary-press" hover-stay-time="80" bindtap="goBrowse">去馆藏挑选</view>
      <view class="btn-secondary" hover-class="btn-secondary-press" hover-stay-time="80" bindtap="goBack">返回工坊</view>
    </view>
    <view class="scroll-pad"></view>
  </scroll-view>
</view>

<view class="page checking" wx:else>
  <view class="state-block">
    <view class="state-mark paper-empty" aria-hidden="true">
      <view class="empty-ring"></view>
      <view class="state-seal" aria-hidden="true"></view>
    </view>
    <text class="state-over">GIFT</text>
    <text class="muted">{{checking ? '柜门轻启…' : '礼赠暂未开放'}}</text>
    <text class="state-hint" wx:if="{{!checking}}">可稍后再来，或先回工坊逛逛</text>
  </view>
</view>
