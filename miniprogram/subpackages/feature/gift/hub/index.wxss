/* 礼赠 Hub · Museum Mode · 场景双列扫选 · 与「我的礼赠」纸面语言对齐 */
page {
  background: #1A1814;
  color: #FFFFFF;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}
.page.pane-ready {
  opacity: 1;
  transform: translateY(0);
}

.scroll {
  height: 100vh;
  /* 底留白用 .scroll-pad spacer，勿把 safe-area 写在 scroll-view padding-bottom */
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.checking {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  min-height: 100vh;
  opacity: 1;
  transform: none;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  text-align: center;
  max-width: 480rpx;
}

.state-mark {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-md);
  margin-bottom: 4rpx;
}

.state-seal {
  width: 36rpx;
  height: 36rpx;
  border: 2px solid rgba(196, 167, 108, 0.55);
  border-radius: 50%;
  position: relative;
  z-index: 2;
}

.state-over {
  font-size: var(--fs-18);
  color: #8A7530;
  letter-spacing: 0.16em;
}

.state-hint {
  font-size: var(--fs-22);
  color: #6B6560;
  line-height: 1.45;
}

.muted {
  color: #A09A90;
  font-size: var(--fs-26);
}

/* 纸面纤维 / 压花 / 标本水印 */
.paper-fiber {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.12;
  z-index: 0;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.35' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}
.paper-fiber.fine {
  opacity: 0.07;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='2.1' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}
.paper-emboss {
  position: absolute;
  inset: 12rpx;
  pointer-events: none;
  z-index: 0;
  border: 1rpx solid rgba(196, 167, 108, 0.22);
  border-radius: var(--radius-sm);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.55);
}
.specimen-wm {
  position: absolute;
  right: -28rpx;
  bottom: -36rpx;
  width: 180rpx;
  height: 180rpx;
  border: 14rpx solid rgba(26, 24, 20, 0.045);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.specimen-wm::after {
  content: '';
  position: absolute;
  inset: 28rpx;
  border: 2px solid rgba(26, 24, 20, 0.05);
  border-radius: 50%;
}
.specimen-wm.sm {
  width: 100rpx;
  height: 100rpx;
  right: -12rpx;
  bottom: -16rpx;
  border-width: 8rpx;
}

.hero-plate {
  position: relative;
  overflow: hidden;
  padding: 28rpx 26rpx 24rpx;
  background: linear-gradient(165deg, #FAF6ED 0%, #F2EDE4 48%, #EDE6DA 100%);
  border: 1px solid #E0CFA3;
  border-radius: var(--radius-md);
  margin-bottom: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.85);
}
.hero-content { position: relative; z-index: 2; }
.hero-over-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
  min-height: 32rpx;
}
.overline {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-18);
  color: #8A7530;
  letter-spacing: 0.12em;
  line-height: 1.3;
}
.hero-brand {
  display: block;
  font-size: var(--fs-20);
  color: #A8903C;
  letter-spacing: 0.16em;
  font-family: var(--font-brand);
  margin-bottom: 4rpx;
}
.title {
  display: block;
  font-size: var(--fs-44);
  font-weight: 600;
  color: #6B5A24;
  font-family: var(--font-brand);
  margin-bottom: 10rpx;
  letter-spacing: 0.04em;
}
.desc {
  display: block;
  font-size: var(--fs-24);
  color: #6B6560;
  line-height: 1.6;
}
.hero-seal.metal {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2px solid #C4A76C;
  background: linear-gradient(145deg, #E0CFA3 0%, #C4A76C 48%, #8A7530 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.hero-seal-inner {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(250, 246, 237, 0.55);
}

/* 为谁选礼 */
.for-whom {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  background: linear-gradient(135deg, rgba(196, 167, 108, 0.12) 0%, rgba(38, 35, 32, 0.4) 100%);
}
.for-whom .signal-light { box-shadow: none; flex-shrink: 0; }
.for-whom-copy { flex: 1; min-width: 0; }
.for-whom-over {
  display: block;
  font-size: var(--fs-16);
  color: #8A7530;
  letter-spacing: 0.14em;
  margin-bottom: 4rpx;
}
.for-whom-name {
  display: block;
  font-size: var(--fs-28);
  color: #E0CFA3;
  font-family: var(--font-brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 流程内小节标题（全站第二级口径）：等宽眉标 + 宋体主标；第一级见 app.wxss .mu-head */
.section-overline {
  display: block;
  font-size: var(--fs-18);
  line-height: 26rpx;
  color: var(--brass-400);
  font-family: var(--font-mono);
  letter-spacing: .32em;
  margin-bottom: 6rpx;
}

.section-title {
  display: block;
  font-size: var(--fs-32);
  line-height: 44rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: .08em;
  margin-bottom: 20rpx;
  font-family: var(--font-brand);
}

.section-title.tight {
  margin-bottom: 0;
}

.scene-block {
  margin-bottom: 28rpx;
}

.scene-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.scene-chip {
  padding: 14rpx 22rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: 999rpx;
  background: transparent;
  min-height: 64rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.scene-chip text {
  font-size: var(--fs-24);
  color: #A09A90;
  letter-spacing: 0.02em;
}

.scene-chip.on {
  border-color: #C4A76C;
  background: rgba(196, 167, 108, 0.14);
}

.scene-chip.on text {
  color: #C4A76C;
}


.scene-guide {
  display: block;
  font-size: var(--fs-24);
  color: #D5D1C8;
  line-height: 1.55;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-md);
  background: rgba(38, 35, 32, 0.55);
  border: 1px solid rgba(77, 64, 26, 0.35);
}

.match-block {
  margin-bottom: 40rpx;
  padding-top: 24rpx;
  border-top: 1px solid rgba(38, 35, 32, 0.9);
}

.match-head {
  margin-bottom: 4rpx;
}

.match-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.match-link {
  flex-shrink: 0;
  font-size: var(--fs-24);
  color: #C4A76C;
  letter-spacing: 0.04em;
  padding: 4rpx 0;
  border-bottom: 1rpx solid rgba(196, 167, 108, 0.4);
}

.match-hint {
  display: block;
  font-size: var(--fs-22);
  color: #6B6560;
  margin-bottom: 16rpx;
  line-height: 1.45;
}

.match-loading,
.match-empty {
  padding: 28rpx 0;
}

.match-empty.paper-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12rpx;
  padding: 40rpx 16rpx;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-md);
  margin-bottom: 4rpx;
}
.empty-mark.paper-empty {
  background: linear-gradient(160deg, #FAF6ED 0%, #F2EDE4 100%);
  border: 1px solid #E0CFA3;
}
.empty-ring {
  width: 56rpx;
  height: 56rpx;
  border: 2px solid rgba(196, 167, 108, 0.4);
  border-radius: 50%;
  position: relative;
  z-index: 1;
}
.paper-empty .signal-light {
  position: absolute;
  z-index: 2;
  box-shadow: none;
}
.empty-title {
  font-size: var(--fs-28);
  color: #FFFFFF;
  font-family: var(--font-brand);
}

.match-empty-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
  margin-top: 12rpx;
  justify-content: center;
}

/* 骨架 */
.skel-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.skel-card {
  width: 50%;
  box-sizing: border-box;
  padding: 0 8rpx 16rpx;
}
.skel-cover {
  width: 100%;
  padding-top: 100%;
  border-radius: 12rpx 12rpx 0 0;
  background: linear-gradient(90deg, #262320 0%, #2e2a26 50%, #262320 100%);
  background-size: 200% 100%;
  animation: skelShine 1.2s ease infinite;
}
.skel-line {
  height: 20rpx;
  margin: 14rpx 12rpx 0;
  border-radius: var(--radius-sm);
  background: linear-gradient(90deg, #262320 0%, #2e2a26 50%, #262320 100%);
  background-size: 200% 100%;
  animation: skelShine 1.2s ease infinite;
}
.skel-line.mid { width: 55%; margin-bottom: 16rpx; }
.skel-hint {
  display: block;
  text-align: center;
  margin-top: 8rpx;
  font-size: var(--fs-24);
}
@keyframes skelShine {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* 双列：用 padding 分栏，避免 flex+gap 把 50% 撑成单列 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.product-card {
  width: 50%;
  box-sizing: border-box;
  padding: 0 8rpx 16rpx;
}

.product-card-inner {
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: inset 0 1rpx 0 rgba(224, 207, 163, 0.06);
}

.product-cover-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #262320;
}

.product-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.product-badge {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  font-size: var(--fs-18);
  letter-spacing: 0.04em;
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
  line-height: 1.4;
}

.product-badge.scene {
  color: #1A1814;
  background: rgba(196, 167, 108, 0.92);
  border: none;
}

.product-badge.fallback {
  color: #A09A90;
  background: rgba(26, 24, 20, 0.72);
  border: 1px solid rgba(106, 101, 96, 0.55);
}

.product-body {
  padding: 14rpx 14rpx 16rpx;
}

/* 主题名（双层命名）：礼赠卡主视觉，标准名降为副行 —— 送礼时「这句话」比物种名更打动人 */
.product-theme {
  display: block;
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--color-text-primary, #F5F2EC);
  letter-spacing: 1rpx;
}
/* 题记：两行截断（卡片窄，长句不撑破） */
.product-theme-note {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 4rpx 0 6rpx;
  font-size: var(--fs-20);
  line-height: 1.5;
  color: var(--color-text-muted, #8A857C);
}
.product-title.is-sub {
  font-size: var(--fs-22);
  color: var(--color-text-secondary, #A09A90);
}
.product-title {
  display: block;
  font-size: var(--fs-24);
  color: #FFFFFF;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  color: #C4A76C;
  font-family: var(--font-mono);
}

.steps {
  margin-bottom: 36rpx;
  padding: 22rpx 20rpx 8rpx;
  border-radius: var(--radius-md);
  border: 1px solid rgba(77, 64, 26, 0.45);
  background: linear-gradient(165deg, #241f18 0%, #1F1D1A 100%);
}
.steps-head {
  margin-bottom: 8rpx;
  padding: 0 4rpx;
}

.step {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1px solid rgba(38, 35, 32, 0.85);
}

.step:last-child {
  border-bottom: none;
}

.step-num {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  font-weight: 600;
  color: #C4A76C;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-md);
  font-family: var(--font-mono);
  background: rgba(196, 167, 108, 0.06);
}

.step-body {
  flex: 1;
  min-width: 0;
}

.step-title {
  display: block;
  font-size: var(--fs-28);
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.step-desc {
  display: block;
  font-size: var(--fs-24);
  color: #A09A90;
  line-height: 1.5;
}

.cta-block {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

.btn-primary {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #D4BC85 0%, #C4A76C 48%, #A8903C 100%);
  color: #1A1814;
  font-size: var(--fs-30);
  font-weight: 500;
  letter-spacing: 0.04em;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(224, 207, 163, 0.4);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.35);
}

.btn-primary-press {
  background: #A8903C;
}

.btn-secondary {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #C4A76C;
  font-size: var(--fs-28);
  border: 1rpx solid rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-md);
}

.btn-secondary-press {
  opacity: 0.85;
  background: rgba(196, 167, 108, 0.06);
}

.scroll-pad {
  width: 100%;
  height: calc(64rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .skel-cover,
  .skel-line {
    animation: none;
  }
}
