<view class="page" wx:if="{{ready}}">
  <!-- 封缄信封：标本纸 + 封舌 + 蜡封「封」 -->
  <view class="envelope breathe">
    <view class="envelope-cast" aria-hidden="true"></view>
    <view class="envelope-flap" aria-hidden="true">
      <!-- 内里衬纸：填满翻盖 V 形负空间，勿露 page 纯黑 -->
      <view class="envelope-pocket"></view>
      <view class="envelope-pocket-well"></view>
      <view class="envelope-flap-face"></view>
      <view class="envelope-flap-shade"></view>
      <view class="envelope-crease crease-l"></view>
      <view class="envelope-crease crease-r"></view>
    </view>
    <view class="wax-seal" aria-hidden="true">
      <view class="wax-glow"></view>
      <view class="wax-rim"></view>
      <view class="wax-ring"></view>
      <view class="wax-core"></view>
      <view class="wax-highlight"></view>
      <text class="wax-seal-text">封</text>
    </view>
    <view class="envelope-body">
      <view class="envelope-mouth" aria-hidden="true"></view>
      <view class="envelope-grain" aria-hidden="true"></view>
      <text class="overline">{{heroOverline}}</text>
      <text class="title">{{heroTitle}}</text>
      <text class="desc">{{heroDesc}}</text>
      <text class="expire" wx:if="{{expireHint}}">{{expireHint}}</text>
    </view>
  </view>

  <view class="claim-card" wx:if="{{showPickupClaim}}">
    <text class="claim-label">门店妥投码</text>
    <text class="claim-code">{{claimCode}}</text>
    <text class="claim-hint">{{claimHint}}</text>
    <canvas
      wx:if="{{claimStatus !== 'claimed'}}"
      type="2d"
      id="giftClaimQr"
      class="claim-qr"
      style="width: 320rpx; height: 320rpx;"
    ></canvas>
    <text class="claim-payload" wx:if="{{claimStatus !== 'claimed'}}">专员扫码 GIFT:{{claimCode}}</text>
  </view>

  <!-- 点任意处立即显示全文并停音（产品负责人确认的手感） -->
  <view class="card-preview" wx:if="{{cardBody || hasVoice}}" bindtap="finishTyping">
    <view class="card-preview-head">
      <text class="card-hint">已封入礼笺</text>
      <view class="mini-seal" aria-hidden="true">山海</view>
    </view>
    <text class="card-body" wx:if="{{cardBody}}">{{cardBody}}</text>
    <!-- 自己录的那段话要能在这里**回放**（2026-09-21 产品负责人真机反馈）。
         ⚠️ 这一行原来是纯文本「含语音 · 0:05」，不可点 —— 语音发出去之后，录制者再无任何环节能听到它。
         现在它是播放/暂停控件（与收礼页共用 createGiftPlayer）。`catchtap` 避免冒泡到 finishTyping。 -->
    <view
      class="card-voice is-playable {{voicePlaying ? 'is-playing' : ''}}"
      wx:if="{{hasVoice}}"
      catchtap="toggleVoice"
      hover-class="tap-press"
      hover-stay-time="70"
      aria-role="button"
      aria-label="{{voicePlaying ? '暂停我录的祝福语' : '播放我录的祝福语'}}"
    >
      <view class="voice-play-icon {{voiceLoading ? 'is-loading' : ''}}" aria-hidden="true">{{voicePlaying ? '❙❙' : '▶'}}</view>
      <text class="voice-play-text">{{voicePlaying ? '正在播我说的话' : '听一听我录的话'}} · {{voiceDurationLabel}}</text>
    </view>
    <text class="voice-error" wx:if="{{voiceError}}">{{voiceError}}</text>
    <text class="card-sig" wx:if="{{cardSignature}}">— {{cardSignature}}</text>
  </view>

  <!-- 音效开关：与编排页/收礼页共用同一个静音偏好 -->
  <view class="sfx-bar">
    <view class="tool-btn" catchtap="toggleSfxMute" aria-role="button" aria-label="{{sfxMuted ? '开启音效' : '静音'}}">
      <view class="icon-sound {{sfxMuted ? 'off' : 'on'}}" aria-hidden="true"></view>
      <text>{{sfxMuted ? '已静音' : '音效'}}</text>
    </view>
  </view>

  <!-- 离屏：分享封面（微信 imageUrl）；失败则无图降级 -->
  <canvas
    type="2d"
    id="giftShareCanvas"
    class="share-canvas-off"
    style="width: 500px; height: 400px;"
  ></canvas>

  <view class="actions">
    <button
      class="btn-primary share-btn"
      open-type="share"
      hover-class="btn-primary-press"
      hover-stay-time="80"
      wx:if="{{canShare}}"
    >{{shareCta}}</button>
    <view
      class="btn-primary proxy-fill-btn"
      hover-class="btn-primary-press"
      hover-stay-time="80"
      bindtap="openProxySheet"
      wx:if="{{canProxyAddress && selfTreat}}"
    >填写我的收货地址</view>
    <view
      class="proxy-fill-line"
      hover-class="tap-press"
      hover-stay-time="80"
      bindtap="openProxySheet"
      wx:elif="{{canProxyAddress}}"
    >
      <text class="proxy-fill-label">已经拿到 TA 的地址，或是送给自己？</text>
      <text class="proxy-fill-cta">我来填写收货地址</text>
    </view>
    <view class="actions-secondary" wx:if="{{canNudge}}">
      <view
        class="btn-secondary"
        hover-class="btn-secondary-press"
        hover-stay-time="80"
        bindtap="goOrder"
      >查看礼赠进度</view>
      <view
        class="btn-ghost"
        hover-class="btn-ghost-press"
        hover-stay-time="80"
        bindtap="nudge"
      >再轻轻提醒一声</view>
    </view>
    <view
      class="btn-secondary btn-secondary-solo"
      hover-class="btn-secondary-press"
      hover-stay-time="80"
      bindtap="goOrder"
      wx:else
    >查看礼赠进度</view>
    <view
      class="btn-secondary btn-secondary-solo"
      hover-class="btn-secondary-press"
      hover-stay-time="80"
      bindtap="goVoucher"
      wx:if="{{voucherReady}}"
    >查看赠予凭证</view>
    <view class="verify-line" wx:if="{{verify && verify.claimMode === 'link'}}" bindtap="openClaimSheet">
      <text class="verify-line-label">凭礼笺领取</text>
      <text class="verify-line-val">{{claimLineText}} · 管理</text>
    </view>
    <view class="verify-line {{verify.receiverVerify ? '' : 'warn'}}" wx:elif="{{verify && (verify.receiverVerify || verify.editable)}}" bindtap="openVerifySheet">
      <text class="verify-line-label">{{verify.receiverVerify ? verifyLabel : '建议补填受礼人手机号'}}</text>
      <text class="verify-line-val">{{verify.receiverVerify ? '尾号 ' + verify.phoneTail : '防礼笺被他人领走'}}{{verify.editable ? (verify.receiverVerify ? ' · 修改' : ' · 去填写') : ''}}</text>
    </view>
    <text class="subscribe-hint" wx:if="{{claimTip}}">{{claimTip}}</text>
    <text class="subscribe-hint" wx:if="{{subscribeHint}}">{{subscribeHint}}</text>
  </view>
</view>

<view class="page checking" wx:else>
  <view class="state-block">
    <view class="state-seal" aria-hidden="true"></view>
    <text class="state-title" wx:if="{{errorMsg}}">礼笺未能备妥</text>
    <text class="muted">{{errorMsg || '礼笺正在备妥…'}}</text>
    <view class="btn-secondary" wx:if="{{errorMsg}}" bindtap="bootstrap">再试一次</view>
  </view>
</view>

<phone-sheet
  show="{{verifySheet}}"
  title="{{verifyCopy.title}}"
  desc="{{verifyCopy.desc}}"
  quickText="{{verifyCopy.quickText}}"
  clearText="{{verifyCopy.clearText}}"
  confirmText="保存"
  busy="{{verifyBusy}}"
  error="{{verifyError}}"
  bindconfirm="onVerifyPhone"
  bindquick="onVerifyUseAddress"
  bindclear="onVerifyClear"
  bindclose="closeVerifySheet"
/>

<proxy-address-sheet
  show="{{proxySheet}}"
  orderId="{{orderId}}"
  by="giver"
  selfTreat="{{selfTreat}}"
  bind:done="onProxyDone"
  bind:close="closeProxySheet"
/>

<claim-sheet
  show="{{claimSheet}}"
  state="{{verify}}"
  busy="{{verifyBusy}}"
  error="{{verifyError}}"
  bindpasscode="onClaimPasscode"
  bindreset="onClaimReset"
  bindusephone="onClaimUsePhone"
  bindclose="closeClaimSheet"
/>
