.pa-mask {
  z-index:900;
}
.ui-pop-sheet.pa-panel {
  max-height:88vh;
  overflow-y:auto;
  box-sizing:border-box;
  padding:12rpx var(--pop-pad-x) calc(40rpx + env(safe-area-inset-bottom));
  display:flex;
  flex-direction:column;
}
.pa-desc{margin-top:14rpx;font-size:var(--fs-24);line-height:1.7;color:#B8AD98}
.pa-no{margin-top:10rpx;font-size:var(--fs-22);color:#9A8F7C;letter-spacing:1rpx}
.pa-import{margin-top:24rpx;display:flex;align-items:center;justify-content:space-between;padding:20rpx 26rpx;background:rgba(196,167,108,0.08);border:2rpx solid rgba(196,167,108,0.28);border-radius:var(--radius-md);font-size:var(--fs-26);color:var(--color-primary)}
.pa-chev{width:12rpx;height:12rpx;border-top:2px solid var(--color-primary);border-right:2px solid var(--color-primary);transform:rotate(45deg);opacity:0.7}
.pa-field{margin-top:16rpx;padding:20rpx 26rpx;background:#1A1814;border:2rpx solid rgba(196,167,108,0.22);border-radius:14rpx}
.pa-label{display:block;font-size:var(--fs-22);color:#9A8F7C;margin-bottom:10rpx;letter-spacing:2rpx}
.pa-input{display:block;width:100%;min-height:40rpx;font-size:var(--fs-28);color:#F3ECDD}
.pa-textarea{width:100%;height:120rpx;font-size:var(--fs-28);color:#F3ECDD}
.pa-placeholder{color:#6B6560}
.pa-error{margin-top:16rpx;font-size:var(--fs-24);line-height:1.6;color:#E8927C}
.pa-btn {
  flex: none;
  margin-top:28rpx;
}
.pa-btn.is-busy{opacity:0.6}
.pa-cancel{margin-top:18rpx;text-align:center;font-size:var(--fs-26);color:#9A8F7C;padding:8rpx 0}
.pa-paste{margin-top:24rpx;padding:20rpx 26rpx;background:rgba(196,167,108,0.08);border:2rpx dashed rgba(196,167,108,0.45);border-radius:14rpx}
.pa-paste-head{display:flex;align-items:center;justify-content:space-between}
.pa-paste-head .pa-label{margin-bottom:0;color:var(--color-primary)}
.pa-paste-clip{font-size:var(--fs-24);color:var(--color-primary);padding:6rpx 18rpx;border:2rpx solid rgba(196,167,108,0.45);border-radius:999rpx}
.pa-paste-box{margin-top:14rpx;width:100%;height:120rpx;font-size:var(--fs-26);line-height:1.6;color:#F3ECDD}
.pa-paste-foot{margin-top:12rpx;display:flex;align-items:center;justify-content:flex-end;gap:16rpx}
.pa-paste-tip{flex:1;font-size:var(--fs-22);line-height:1.6;color:#B8AD98}
.pa-paste-tip.is-partial{color:#E8927C}
.pa-paste-btn{flex:none;height:56rpx;line-height:56rpx;padding:0 32rpx;border-radius:28rpx;background:var(--color-primary);color:#1A1814;font-size:var(--fs-26);font-weight:500}

/* 弹层规范（docs/弹层视觉规范_2026-10-13.md）：遮罩 / 牌面 / 抓手 / 眉标 / 主标 / 按钮取 ui-pop-*；抓手在内边距里，抵掉上边距 */
.pa-grip { margin-bottom: 28rpx; }
