.pa-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:900;background:rgba(10,9,7,0.72);display:flex;align-items:flex-end}
.pa-panel{width:100%;max-height:88vh;overflow-y:auto;box-sizing:border-box;padding:44rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));background:#1F1D1A;border-top:2rpx solid rgba(196,167,108,0.45);border-radius:28rpx 28rpx 0 0;display:flex;flex-direction:column}
.pa-over{font-size:20rpx;letter-spacing:6rpx;color:#C4A76C}
.pa-title{margin-top:12rpx;font-size:34rpx;font-weight:600;color:#F3ECDD}
.pa-desc{margin-top:14rpx;font-size:24rpx;line-height:1.7;color:#B8AD98}
.pa-no{margin-top:10rpx;font-size:22rpx;color:#9A8F7C;letter-spacing:1rpx}
.pa-import{margin-top:24rpx;display:flex;align-items:center;justify-content:space-between;padding:20rpx 26rpx;background:rgba(196,167,108,0.08);border:2rpx solid rgba(196,167,108,0.28);border-radius:14rpx;font-size:26rpx;color:#C4A76C}
.pa-chev{width:12rpx;height:12rpx;border-top:2px solid #C4A76C;border-right:2px solid #C4A76C;transform:rotate(45deg);opacity:0.7}
.pa-field{margin-top:16rpx;padding:20rpx 26rpx;background:#1A1814;border:2rpx solid rgba(196,167,108,0.22);border-radius:14rpx}
.pa-label{display:block;font-size:22rpx;color:#9A8F7C;margin-bottom:10rpx;letter-spacing:2rpx}
.pa-input{display:block;width:100%;min-height:40rpx;font-size:28rpx;color:#F3ECDD}
.pa-textarea{width:100%;height:120rpx;font-size:28rpx;color:#F3ECDD}
.pa-placeholder{color:#6B6560}
.pa-error{margin-top:16rpx;font-size:24rpx;line-height:1.6;color:#E8927C}
.pa-btn{margin-top:28rpx;height:88rpx;line-height:88rpx;text-align:center;border-radius:44rpx;background:#C4A76C;color:#1A1814;font-size:30rpx;font-weight:500}
.pa-btn.is-busy{opacity:0.6}
.pa-cancel{margin-top:18rpx;text-align:center;font-size:26rpx;color:#9A8F7C;padding:8rpx 0}
.pa-paste{margin-top:24rpx;padding:20rpx 26rpx;background:rgba(196,167,108,0.08);border:2rpx dashed rgba(196,167,108,0.45);border-radius:14rpx}
.pa-paste-head{display:flex;align-items:center;justify-content:space-between}
.pa-paste-head .pa-label{margin-bottom:0;color:#C4A76C}
.pa-paste-clip{font-size:24rpx;color:#C4A76C;padding:6rpx 18rpx;border:2rpx solid rgba(196,167,108,0.45);border-radius:999rpx}
.pa-paste-box{margin-top:14rpx;width:100%;height:120rpx;font-size:26rpx;line-height:1.6;color:#F3ECDD}
.pa-paste-foot{margin-top:12rpx;display:flex;align-items:center;justify-content:flex-end;gap:16rpx}
.pa-paste-tip{flex:1;font-size:22rpx;line-height:1.6;color:#B8AD98}
.pa-paste-tip.is-partial{color:#E8927C}
.pa-paste-btn{flex:none;height:56rpx;line-height:56rpx;padding:0 32rpx;border-radius:28rpx;background:#C4A76C;color:#1A1814;font-size:26rpx;font-weight:500}
