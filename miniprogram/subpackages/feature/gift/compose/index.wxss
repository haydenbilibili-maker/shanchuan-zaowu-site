/* 礼赠编排 · Museum Mode
   iPhone：不用 flex:1 + height:0 给 scroll-view（会塌成 0 → 中部黑屏）。
   page / .page 给明确高度；.scroll 用 calc + JS 实测 px 兜底。 */
page {
  background: #1A1814;
  color: #FFFFFF;
  height: 100vh;
  height: 100%;
  overflow: hidden;
}

.page {
  height: 100vh;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.checking {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.muted {
  color: #A09A90;
  font-size: 26rpx;
  line-height: 1.55;
  text-align: center;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}

.state-title {
  font-size: 30rpx;
  color: #D5D1C8;
  font-weight: 500;
}

.state-cta {
  margin-top: 12rpx;
  min-width: 280rpx;
  text-align: center;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.btn-secondary {
  color: #C4A76C;
  border: 1px solid rgba(196, 167, 108, 0.55);
  background: transparent;
}

.btn-ghost {
  color: #A09A90;
  border: 1px solid rgba(96, 90, 80, 0.45);
  background: transparent;
}

.state-seal {
  width: 48rpx;
  height: 48rpx;
  border: 2px solid rgba(196, 167, 108, 0.45);
  border-radius: 50%;
  margin-bottom: 8rpx;
  animation: seal-breathe 2.4s ease-in-out infinite;
}

@keyframes seal-breathe {
  0%, 100% { opacity: 0.45; transform: scale(0.96); }
  50% { opacity: 0.9; transform: scale(1); }
}

.scroll {
  flex: none;
  width: 100%;
  min-height: 420rpx;
  /* 步骤轨约 96rpx；底栏 fixed 叠在下方，由 .scroll-pad 留白 */
  height: calc(100vh - 96rpx);
  height: calc(100% - 96rpx);
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.rite-intro {
  margin-bottom: 28rpx;
}

.rite-overline {
  display: block;
  font-size: 20rpx;
  color: #6B6560;
  letter-spacing: 0.14em;
  margin-bottom: 10rpx;
}

.rite-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: #FFFFFF;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  margin-bottom: 12rpx;
}

.rite-desc {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.6;
}

.step-rail {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 12rpx;
  background: rgba(26, 24, 20, 0.96);
  border-bottom: 1px solid rgba(38, 35, 32, 0.85);
  z-index: 12;
}

.step-rail.sticky {
  position: relative;
  flex-shrink: 0;
}

.step-rail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.38;
  transition: opacity 0.25s ease;
}

.step-rail-item.on,
.step-rail-item.done {
  opacity: 1;
}

.step-rail-num {
  font-size: 20rpx;
  color: #6B6560;
  letter-spacing: 0.08em;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}

.step-rail-item.on .step-rail-num,
.step-rail-item.done .step-rail-num {
  color: #C4A76C;
}

.step-rail-label {
  font-size: 22rpx;
  color: #6B6560;
}

.step-rail-item.on .step-rail-label {
  color: #D5D1C8;
}

.step-rail-item.done .step-rail-label {
  color: #A09A90;
}

.step-rail-line {
  flex: 1;
  height: 1px;
  margin: 0 16rpx 28rpx;
  background: rgba(77, 64, 26, 0.35);
  transition: background 0.25s ease;
}

.step-rail-line.on {
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.55), rgba(77, 64, 26, 0.25));
}

.product-row {
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: 16rpx;
  margin-bottom: 0;
}

.product-cover-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #262320;
}

.product-cover {
  width: 100%;
  height: 100%;
  display: block;
  background: #262320;
}

.product-meta {
  flex: 1;
  min-width: 0;
}

.product-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.product-latin {
  display: block;
  font-size: 22rpx;
  color: #C4A76C;
  font-style: italic;
  margin-bottom: 12rpx;
}

.product-price {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #C4A76C;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
  margin-bottom: 6rpx;
}

.product-sku {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
}

.section {
  margin-bottom: 40rpx;
}

.section-overline {
  display: block;
  font-size: 20rpx;
  color: #6B6560;
  letter-spacing: 0.12em;
  margin-bottom: 8rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.delivery-main,
.delivery-item {
  padding: 28rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.delivery-main.active,
.delivery-item.active {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.06);
}

.delivery-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.delivery-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.delivery-tag {
  font-size: 20rpx;
  color: #1A1814;
  background: #C4A76C;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.delivery-desc {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.55;
}

.other-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1px solid rgba(196, 167, 108, 0.42);
  border-radius: 16rpx;
  background: rgba(196, 167, 108, 0.04);
}
.other-toggle.is-open { padding: 16rpx 24rpx; }
.other-toggle-main { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.other-toggle-title { font-size: 22rpx; color: #A09A90; }
.other-toggle-names { font-size: 28rpx; font-weight: 500; color: #C4A76C; }
.other-toggle-act {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border: 1px solid rgba(196, 167, 108, 0.55);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #C4A76C;
}

.store-pick { margin-top: 16rpx; }
.store-pick-label {
  display: block; font-size: 22rpx; color: #6B6560; margin-bottom: 12rpx;
}
.store-chip {
  display: inline-flex; align-items: center;
  padding: 12rpx 24rpx; margin: 0 12rpx 12rpx 0;
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 12rpx; font-size: 24rpx; color: #D5D1C8;
}
.store-chip.on {
  border-color: #C4A76C; color: #C4A76C;
  background: rgba(196, 167, 108, 0.08);
}
.store-empty { font-size: 24rpx; color: #6B6560; }

.verify-set {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  background: #1F1D1A;
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
}
.verify-set-label { font-size: 24rpx; letter-spacing: 2rpx; color: #C4A76C; }
.verify-set-input {
  margin-top: 14rpx;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: #2A2621;
  color: #F3ECDD;
  font-size: 30rpx;
}
.verify-set-ph { color: #7D7466; font-size: 26rpx; }
.verify-set-hint { margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; color: #9A8F7C; }
.verify-set-req { color: #E8927C; letter-spacing: 0; }
.verify-set.is-error { border-color: #E8927C; }
.verify-set-err { margin-top: 10rpx; font-size: 24rpx; color: #E8927C; }
.verify-set-tip { color: #9A8F7C; letter-spacing: 0; font-size: 22rpx; }
.claim-switch { margin-top: 14rpx; font-size: 24rpx; color: #C4A76C; text-decoration: underline; }
.self-exit { display: block; margin-top: 18rpx; }
.claim-opt { margin-top: 16rpx; display: flex; align-items: center; }
.claim-check { width: 30rpx; height: 30rpx; flex-shrink: 0; border: 1px solid #C4A76C; border-radius: 6rpx; margin-right: 14rpx; }
.claim-opt.on .claim-check { background: #C4A76C; box-shadow: inset 0 0 0 5rpx #1F1D1A; }
.claim-opt-t { font-size: 24rpx; color: #E6DCC8; line-height: 1.5; }

.pack-note {
  margin-top: 8rpx;
  padding: 20rpx 22rpx;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: 16rpx;
}

.pack-note-label {
  display: block;
  font-size: 20rpx;
  color: #C4A76C;
  letter-spacing: 0.1em;
  margin-bottom: 10rpx;
}

.pack-note-body {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.65;
}

.scene-note-block {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  background: #1F1D1A;
  border: 1px solid #4D401A;
  border-radius: 16rpx;
}

.scene-note-label {
  display: block;
  font-size: 22rpx;
  color: #C4A76C;
  letter-spacing: 0.04em;
  margin-bottom: 8rpx;
}

.scene-note-guide {
  display: block;
  font-size: 24rpx;
  color: #D5D1C8;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.scene-note-chip {
  display: inline-flex;
  padding: 10rpx 22rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #A09A90;
}

.scene-note-chip.on {
  color: #C4A76C;
  border-color: #C4A76C;
  background: rgba(196, 167, 108, 0.08);
}

.note-preset-wrap {
  width: 100%;
  margin-bottom: 20rpx;
}

/* 关系 chip 换行铺开（原来是不换行的横向滚动，角色一多后面的就看不见了） */
.note-preset-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 2rpx 0 4rpx;
}

.note-preset {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border: 1px solid rgba(196, 167, 108, 0.28);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #A09A90;
  letter-spacing: 0.02em;
  background: transparent;
}

.note-preset:active,
.note-preset-press {
  color: #C4A76C;
  border-color: rgba(196, 167, 108, 0.55);
}

.note-preset.on {
  color: #C4A76C;
  border-color: #C4A76C;
  background: rgba(196, 167, 108, 0.08);
}

.envelope-shell {
  position: relative;
  padding: 20rpx 16rpx 16rpx;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.65);
  border-radius: 16rpx;
}

.envelope-flap {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 10rpx;
  border-bottom: 1px solid rgba(196, 167, 108, 0.28);
  pointer-events: none;
}

.envelope-caption {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #6B6560;
  letter-spacing: 0.08em;
}

.voice-rite {
  margin-top: 20rpx;
  padding: 20rpx 20rpx 8rpx;
  border-top: 1px dashed rgba(196, 167, 108, 0.35);
}

.voice-rite-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.voice-rite-label {
  font-size: 20rpx;
  color: #8A7530;
  letter-spacing: 0.12em;
}

.voice-rite-hint {
  font-size: 20rpx;
  color: #A09A90;
}

.voice-hold {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 1px solid rgba(138, 117, 48, 0.45);
  border-radius: 12rpx;
  background: rgba(250, 246, 237, 0.65);
  font-size: 26rpx;
  color: #8A7530;
  letter-spacing: 0.04em;
}

.voice-hold.recording {
  border-color: #C4A76C;
  background: rgba(196, 167, 108, 0.12);
  color: #6B5A24;
}

.voice-hold.will-cancel {
  border-color: rgba(214, 64, 69, 0.55);
  background: rgba(214, 64, 69, 0.08);
  color: #D64045;
}

.voice-hold.busy {
  opacity: 0.5;
  pointer-events: none;
}

.voice-slide-hint {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: #A09A90;
  letter-spacing: 0.06em;
}

.voice-brass {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C4A76C;
  flex-shrink: 0;
}

.voice-brass.pulse,
.voice-hold.recording .voice-brass {
  animation: brass-pulse 1s ease-in-out infinite;
}

@keyframes brass-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.65;
  }
}

.voice-ready {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.voice-play {
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 24rpx;
  border: 1px solid rgba(138, 117, 48, 0.45);
  border-radius: 12rpx;
  background: rgba(250, 246, 237, 0.65);
  font-size: 26rpx;
  color: #8A7530;
  box-sizing: border-box;
}

.voice-play.on {
  border-color: #C4A76C;
  color: #6B5A24;
}

.voice-dur {
  margin-left: auto;
  font-size: 22rpx;
  color: #A09A90;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}

.voice-actions {
  display: flex;
  gap: 16rpx;
}

.voice-hold-mini,
.voice-delete {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.voice-hold-mini {
  border: 1px solid rgba(138, 117, 48, 0.4);
  color: #8A7530;
}

.voice-hold-mini.recording {
  border-color: #C4A76C;
  color: #6B5A24;
}

.voice-hold-mini.will-cancel {
  border-color: rgba(214, 64, 69, 0.55);
  color: #D64045;
}

.voice-delete {
  border: 1px solid rgba(160, 154, 144, 0.45);
  color: #A09A90;
}

.card-plate {
  padding: 32rpx;
  background: #F2EDE4;
  border: 1px solid #E0CFA3;
  border-radius: 12rpx;
  transform-origin: 50% 40%;
  position: relative;
  overflow: hidden;
}

.card-plate-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 2;
}

/* 标本纸底纹：宋体「山海」，对齐铜牌语义（禁 emoji） */
.watermark {
  position: absolute;
  /* 偏出署名区，避免与落款叠成双影 */
  bottom: -28rpx;
  right: -36rpx;
  font-size: 120rpx;
  opacity: 0.045;
  pointer-events: none;
  transform: rotate(-12deg);
  z-index: 1;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  line-height: 1;
  letter-spacing: 0.08em;
  color: #1A1814;
  font-weight: 600;
}

.watermark.light {
  opacity: 0.04;
  color: #1A1814;
}

.wax-seal {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border: 2px solid #C4A76C;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108, 0.1);
  margin-top: -4rpx;
  position: relative;
  z-index: 2;
}

.wax-seal-text {
  font-size: 18rpx;
  color: #8A7530;
  letter-spacing: 0.04em;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
}

.card-plate.writing {
  animation: paper-settle 0.85s ease-out;
}

@keyframes paper-settle {
  0% {
    transform: translateY(6rpx) rotate(-0.35deg);
  }
  45% {
    transform: translateY(-2rpx) rotate(0.12deg);
  }
  100% {
    transform: translateY(0) rotate(0);
  }
}

.card-to {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
  margin-bottom: 16rpx;
  transition: opacity 0.35s ease;
}

.card-to.intimate {
  opacity: 1;
}

.card-to.editing .card-to-input {
  border-bottom-color: rgba(196, 167, 108, 0.55);
}

.card-to-prefix {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8A7530;
  letter-spacing: 0.1em;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
}

.card-to-dot {
  flex-shrink: 0;
  margin: 0 8rpx;
  font-size: 20rpx;
  color: #C4A76C;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
}

.card-to-input {
  flex: 1;
  min-width: 0;
  height: 40rpx;
  font-size: 26rpx;
  color: #6B5A24;
  letter-spacing: 0.04em;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  border-bottom: 1px solid transparent;
  padding: 0 0 2rpx;
  transition: border-color 0.25s ease;
}

.card-to-placeholder {
  color: #A09A90;
  font-size: 24rpx;
  letter-spacing: 0.06em;
}

.card-write-view {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}

.card-write-text {
  /* 手写体：直接写字面量栈（不依赖 var() —— iOS 实测 var 未生效 ✗） */
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  font-size: 28rpx;
  line-height: 1.65;
  color: #33302C;
  /* 用户亲手写下的内容 → 手写体令牌（系统字体栈、零体积；iOS 汉仪手写体/签笔，Android 落衬线兜底） */
  /* 墨色由浅入深：整段落笔过程中缓缓沉着 */
  animation: ink-deepen 2.4s ease-out forwards;
}

@keyframes ink-deepen {
  0% {
    color: #8B8070;
    opacity: 0.72;
  }
  35% {
    color: #5C5346;
    opacity: 0.9;
  }
  100% {
    color: #33302C;
    opacity: 1;
  }
}

.card-write-cursor {
  display: inline;
  font-size: 28rpx;
  line-height: 1.65;
  color: #8A7530;
  font-family: Georgia, serif;
  opacity: 0;
  margin-left: 2rpx;
}

.card-write-cursor.on {
  animation: cursor-blink 1s steps(1, end) infinite;
}

@keyframes cursor-blink {
  0%,
  45% {
    opacity: 0.7;
  }
  50%,
  100% {
    opacity: 0;
  }
}

/* 题记层：藏品题记（四字主题名 + 一句话），与正文叠加 —— 它是礼笺的「题」，不占正文 */
.card-epigraph {
  margin: 0 0 18rpx;
  padding: 14rpx 18rpx;
  border-left: 5rpx solid var(--brass-400, #C4A76C);
  background: rgba(196, 167, 108, 0.06);
  border-radius: 0 var(--radius-sm, 8rpx) var(--radius-sm, 8rpx) 0;
}
.card-epigraph-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--brass-400, #C4A76C);
  margin-bottom: 6rpx;
}
.card-epigraph-note {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary, #A09A90);
}
.card-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #33302C;
  line-height: 1.65;
  background: transparent;
  position: relative;
  z-index: 2;
}

.card-placeholder {
  color: #A09A90;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 2;
}

.card-count {
  font-size: 22rpx;
  color: #A09A90;
}
/* 正文字数：count 与"为什么有上限"的提示（2026-09-21：上限由打印尺寸反推，140 字） */
.card-count-wrap { display: flex; align-items: baseline; gap: var(--space-1); flex-wrap: wrap; }
.card-count.is-full { color: var(--brass-400); font-weight: 600; }
.card-count-hint { font-size: var(--fs-20); color: var(--color-text-muted); }


.card-sig-label {
  font-size: 22rpx;
  color: #8A7530;
}

.card-sig-wrap {
  position: relative;
  z-index: 3;
  border-top: 1px solid #E0CFA3;
  padding-top: 12rpx;
  transition: border-color 0.3s ease, transform 0.35s ease;
}

.card-sig-wrap.focused {
  border-top-color: #C4A76C;
  transform: translateY(-2rpx);
}

.card-sig-wrap.just-signed .card-sig {
  animation: sig-settle 0.65s ease-out;
}

@keyframes sig-settle {
  0% {
    opacity: 0.55;
    transform: translateY(4rpx);
  }
  55% {
    opacity: 1;
    transform: translateY(-1rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-sig {
  width: 100%;
  height: 64rpx;
  font-size: 30rpx;
  color: #33302C;
  /* 手写感：同构预约票贵宾名 .val-calligraphy */
  font-family: 'Times New Roman', Georgia, 'Source Han Serif SC', serif;
  font-style: italic;
  letter-spacing: 0.03em;
}

.sig-nick-chip {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  padding: 6rpx 14rpx;
  border: 1px solid rgba(196, 167, 108, 0.45);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #8A7530;
  letter-spacing: 0.04em;
  background: rgba(242, 237, 228, 0.92);
}

.sig-nick-chip:active {
  opacity: 0.7;
}

/* 2026-09-17：隐价勾选原本是 32rpx 纯色方块、没有任何对勾，真机上很难看出「已隐藏」是否开着。
   现在：勾选框放大 + CSS 画勾 + 选中整行点亮（未选中同样内边距/边框，切换不跳版）。 */
/* 「换一句」+ 句序标：与礼赠 hub 的「换一批」同款视觉（金色下划线小链接） */
.note-shuffle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 6rpx 4rpx 0;
}

.note-shuffle-count {
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 0.04em;
}

.note-shuffle {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #C4A76C;
  letter-spacing: 0.04em;
  padding: 6rpx 0;
  border-bottom: 1px solid rgba(196, 167, 108, 0.4);
}

.privacy-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  box-sizing: border-box;
  transition: background-color 0.18s ease, border-color 0.18s ease;
}

.privacy-row.is-on {
  background: rgba(196, 167, 108, 0.1);
  border-color: rgba(196, 167, 108, 0.34);
}

.check {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.7);
  border-radius: 10rpx;
  box-sizing: border-box;
}

.check.on {
  background: #C4A76C;
  border-color: #C4A76C;
}

/* 对勾：CSS 画（不依赖字体/emoji），左+下边框旋转 45°，整体居中随尺寸自适应 */
.check::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 46%;
  width: 18rpx;
  height: 9rpx;
  border-left: 4rpx solid #241F17;
  border-bottom: 4rpx solid #241F17;
  transform: translate(-50%, -50%) rotate(-45deg);
  opacity: 0;
}

.check.on::after {
  opacity: 1;
}

.privacy-text {
  font-size: 26rpx;
  color: #A09A90;
}

.privacy-row.is-on .privacy-text {
  color: var(--color-text-primary, #FFFFFF);
  font-weight: 500;
}

.scroll-pad {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #1F1D1A;
  border-top: 1px solid rgba(38, 35, 32, 0.9);
  z-index: 20;
}

.bottom-price {
  flex: 1;
  min-width: 0;
}

.bottom-label {
  display: block;
  font-size: 20rpx;
  color: #A09A90;
  margin-bottom: 4rpx;
}

.bottom-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #C4A76C;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}

/* 会员价（裁决 46-a）：折后价主显，原价划掉；底色沿用底栏 #1F1D1A */
.bottom-value-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.bottom-origin {
  font-size: 24rpx;
  color: #A09A90;
  text-decoration: line-through;
}

.bottom-note {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #A09A90;
}

.pay-btn {
  flex: 0 0 280rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #C4A76C;
  color: #1A1814;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  border-radius: 16rpx;
}

.pay-btn:active,
.pay-btn-press {
  background: #A8903C;
}

.pay-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 平台锁定隐价时的只读行 */
.privacy-row-locked { opacity: .92; }

/* 平台锁定态（不可更改）本身也要一眼看懂：文案按「已隐藏」的确认口径加重 */
.privacy-txt {
  font-size: 26rpx;
  color: var(--color-text-primary, #FFFFFF);
  font-weight: 500;
}


/* 落笔/展示态：整段文本渲染（不用逐字 span —— iOS 会逐帧重播动画导致回跳闪白） */
.card-note-display {
  display: block;
  font-family: 'ShanhaiHand', "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, "楷体", "Songti SC", serif;
  min-height: 200rpx;
  white-space: pre-wrap;   /* 保留换行：textarea 里换行，展示时也要换行 */
  color: #33302C;
}

/* ── 音效开关（2026-09-19）──
   样式逐字取自 receive/index.wxss（那套已过对比度棘轮），不自己配色。 */
.sfx-bar { display: flex; justify-content: flex-end; padding: 0 24rpx 8rpx; }
.tool-btn {
  display: flex; align-items: center; gap: 10rpx;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(77, 64, 26, 0.7);
  border-radius: 12rpx;
  background: var(--color-bg-card);
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.icon-sound {
  width: 22rpx; height: 22rpx; border-radius: 50%;
  border: 1.5px solid var(--gold); box-sizing: border-box; position: relative;
}
.icon-sound.on::after {
  content: ''; position: absolute; left: 50%; top: 50%;
  width: 8rpx; height: 8rpx; margin: -4rpx 0 0 -4rpx;
  border-radius: 50%; background: var(--gold);
}
.icon-sound.off { opacity: 0.45; border-color: var(--color-text-muted); }
