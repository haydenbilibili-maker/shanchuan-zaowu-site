<!-- 礼赠编排 · 博物柜仪式（落笔/语音区仅外围增强，正文逻辑不动）
     2026-10-12 分步：01 选礼（藏品 + 送给谁）→ 02 写笺（称呼 / 礼笺 / 署名 / 语音）→ 03 交付（交付方式 / 手机号 / 隐价 / 包装）→ 支付 -->
<wxs src="../../../../utils/latinDisplay.wxs" module="latin" />
<view class="page" wx:if="{{allowed && product}}">
  <!-- 页面关了系统侧滑（index.json）：左缘右滑在第 2、3 步回上一步，第 1 步离开 -->
  <page-edge-back ext-class="compose-edge" bind:back="onEdgeBack" disabled="{{voiceRecording}}" />

  <!-- 步骤轨：当前步高亮；已到过的步可点回 -->
  <view class="step-rail sticky">
    <view
      class="step-rail-item {{activeStep === 1 ? 'on' : ''}} {{activeStep !== 1 ? 'done' : ''}}"
      data-step="1"
      bindtap="onRailTap"
      hover-class="{{activeStep !== 1 ? 'tap-press' : 'none'}}"
      hover-stay-time="80"
      aria-role="button"
      aria-label="第 1 步 选礼"
    >
      <text class="step-rail-num">01</text>
      <text class="step-rail-label">选礼</text>
    </view>
    <view class="step-rail-line {{maxStep > 1 ? 'on' : ''}}"></view>
    <view
      class="step-rail-item {{activeStep === 2 ? 'on' : ''}} {{maxStep >= 2 && activeStep !== 2 ? 'done' : ''}}"
      data-step="2"
      bindtap="onRailTap"
      hover-class="{{maxStep >= 2 && activeStep !== 2 ? 'tap-press' : 'none'}}"
      hover-stay-time="80"
      aria-role="button"
      aria-label="第 2 步 写笺"
    >
      <text class="step-rail-num">02</text>
      <text class="step-rail-label">写笺</text>
    </view>
    <view class="step-rail-line {{maxStep > 2 ? 'on' : ''}}"></view>
    <view
      class="step-rail-item {{activeStep === 3 ? 'on' : ''}} {{maxStep >= 3 && activeStep !== 3 ? 'done' : ''}}"
      data-step="3"
      bindtap="onRailTap"
      hover-class="{{maxStep >= 3 && activeStep !== 3 ? 'tap-press' : 'none'}}"
      hover-stay-time="80"
      aria-role="button"
      aria-label="第 3 步 交付"
    >
      <text class="step-rail-num">03</text>
      <text class="step-rail-label">交付</text>
    </view>
  </view>

  <!-- 音效开关（2026-09-19）：与收礼页共用同一个静音偏好（存储键 gift_receive_sfx_muted）；第 2、3 步左侧是页内「上一步」 -->
  <view class="sfx-bar">
    <view
      class="tool-btn step-back"
      wx:if="{{activeStep > 1}}"
      bindtap="onStepBack"
      hover-class="tap-press"
      hover-stay-time="80"
      aria-role="button"
      aria-label="上一步"
    >
      <text>‹ 上一步 · {{activeStep === 2 ? '选礼' : '写笺'}}</text>
    </view>
    <view class="tool-btn" catchtap="toggleSfxMute" aria-role="button" aria-label="{{sfxMuted ? '开启音效' : '静音'}}">
      <view class="icon-sound {{sfxMuted ? 'off' : 'on'}}" aria-hidden="true"></view>
      <text>{{sfxMuted ? '已静音' : '音效'}}</text>
    </view>
  </view>

  <scroll-view
    scroll-y
    class="scroll"
    style="{{scrollStyle}}"
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{phoneScrollId}}"
    scroll-with-animation
  >
    <view id="composeTop"></view>
    <!-- ═══ 第 1 步 · 选礼 ═══ -->
    <block wx:if="{{activeStep === 1}}">
    <view class="rite-intro">
      <text class="rite-overline">FROM THE CABINET</text>
      <text class="rite-title">从柜中取出，封笺赠予</text>
      <text class="rite-desc">分三步：选好藏品与送给谁、写下礼笺，再选定交付方式——像递出一件值得郑重的东西。</text>
    </view>

    <!-- 01 已选标本 -->
    <view class="section sec-specimen">
      <text class="section-overline">SPECIMEN</text>
      <text class="section-title">柜中这一件</text>
      <view class="product-row">
        <view class="product-cover-wrap">
          <image class="product-cover" src="{{cover}}" mode="aspectFill"></image>
          <protected-badge product="{{product}}" size="xs" corner="bl" />
        </view>
        <view class="product-meta">
          <text class="product-title">{{product.title}}</text>
          <text class="product-latin" wx:if="{{latin.display(product.latinName)}}">{{latin.display(product.latinName)}}</text>
          <text class="product-price">¥{{displayPrice}}</text>
          <text class="product-sku" wx:if="{{skuLabel}}">{{skuLabel}} · ×{{count}}</text>
        </view>
      </view>
    </view>

    <!-- 01 送给谁：关系决定第 2 步起草的推荐礼笺；「犒劳自己」让第 3 步交付固定为寄给我 -->
    <view class="section sec-relation">
      <text class="section-overline">FOR WHOM</text>
      <text class="section-title">这份礼送给谁</text>
      <text class="section-hint">选一个关系，下一步按它起草礼笺（可改写）；也可以不选，自己写。</text>
      <!-- 2026-09-21：关系从 8 个扩到 20 个（giftNotePresets.js 实为 20 组 × 3 句）。
           原来这里是**横向 scroll**（white-space: nowrap），一屏只露得出前 5–6 个 ——
           后面新增的「老师 / 领导 / 长辈」等于藏起来了，那「拓展角色」就白做。
           改成**换行铺开**，一屏看得见（⚠️ 原注释写「两行」与实测不符：20 个 chip 换行后
           窄屏**实测约 4 行**，见 2026-09-21 审计 P3-23 —— 已订正）。 -->
      <view class="note-preset-wrap">
        <view class="note-preset-row">
          <view
            class="note-preset {{activeNotePresetId === item.id ? 'on' : ''}}"
            wx:for="{{notePresets}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onNotePresetTap" hover-class="note-preset-press" hover-stay-time="80"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
      <text class="relation-self-note" wx:if="{{selfTreat}}">犒劳自己：藏品寄到你的收货地址，地址与手机号在结算页填写。</text>
    </view>
    </block>

    <!-- ═══ 第 2 步 · 写笺 ═══ -->
    <block wx:elif="{{activeStep === 2}}">
    <!-- 02 礼笺：信封外壳包裹（不改 textarea / 落笔动画结构） -->
    <view class="section sec-letter">
      <text class="section-overline">LETTER</text>
      <text class="section-title">写下礼笺</text>

      <!-- 场景导语（独立；不改下方关系预设 / 落笔 / 语音结构） -->
      <view class="scene-note-block" wx:if="{{activeScene}}">
        <text class="scene-note-label">场景 · {{sceneLabel}}</text>
        <text class="scene-note-guide" wx:if="{{sceneGuide}}">{{sceneGuide}}</text>
        <view
          class="scene-note-chip {{activeNotePresetId === scenePresetId ? 'on' : ''}}"
          bindtap="onSceneNoteTap"
          wx:if="{{sceneNoteHint}}"
        >
          <text>用场景语向</text>
        </view>
      </view>

      <!-- 关系在第 1 步选；这里只标出当前关系，没选时给一条回第 1 步的路 -->
      <view class="note-relation-row">
        <block wx:for="{{notePresets}}" wx:key="id">
          <text class="note-relation" wx:if="{{item.id === activeNotePresetId}}">按「{{item.label}}」起草</text>
        </block>
        <text class="note-relation-back" wx:if="{{!activeNotePresetId}}" data-step="1" bindtap="onRailTap">想要推荐句？回「选礼」挑个关系 ›</text>
      </view>

      <!-- 2026-09-17：一个关系现在有多句候选 —— 这里给出「换一句」与句序（第 2/3 句）。
           顾客原话：「点进去好几次都是同样一段话，也没有更新的标」。 -->
      <view class="note-shuffle-row" wx:if="{{activeNotePresetId && noteVariantTotal > 1}}">
        <text class="note-shuffle-count">第 {{noteVariantLabel}} 句</text>
        <text class="note-shuffle" bindtap="onNoteShuffle">换一句 ↻</text>
      </view>

      <view class="envelope-shell">
        <view class="envelope-flap"></view>
        <view class="card-plate {{noteWriting ? 'writing' : ''}}">
          <!-- 标本纸底纹：黄铜纹样，禁 emoji -->
          <view class="watermark light" aria-hidden="true">山海</view>
          <view class="card-plate-head">
            <view class="card-to {{noteWriting ? 'intimate' : ''}} {{recipientEditing ? 'editing' : ''}}">
              <text class="card-to-prefix">写给</text>
              <text class="card-to-dot">·</text>
              <input
                class="card-to-input"
                maxlength="20"
                placeholder="{{recipientPlaceholder}}"
                placeholder-class="card-to-placeholder"
                value="{{recipientName}}"
                focus="{{recipientEditing}}"
                bindinput="onRecipientInput"
                bindfocus="onRecipientFocus"
                bindblur="onRecipientBlur"
                catchtap="onRecipientTap"
              />
            </view>
            <view class="wax-seal" aria-hidden="true">
              <text class="wax-seal-text">山海</text>
            </view>
          </view>
          <!-- 题记层：为该藏品写的固定一句，与正文（场景/关系/手写）**叠加**展示，互不替换 -->
          <view class="card-epigraph" wx:if="{{product.themeName && product.themeNote}}">
            <text class="card-epigraph-name">{{product.themeName}}</text>
            <text class="card-epigraph-note">{{product.themeNote}}</text>
          </view>

          <!-- 落笔动画：**整段文本**渲染（逐字 span 会让 iOS 每帧重播动画 → 回跳闪白 ✗）+ 可点打断 -->
          <view
            wx:if="{{noteWriting}}"
            class="card-write-view"
            bindtap="onCardAreaTap"
          >
            <text class="card-write-text">{{cardBody}}</text><text
              class="card-write-cursor {{showWriteCursor ? 'on' : ''}}"
            >|</text>
          </view>
          <!-- 未聚焦：用手写体 text 展示（textarea 在 iOS 不支持 font-family，只能聚焦时用） -->
          <text
            wx:elif="{{!cardFocused}}"
            class="card-write-text card-note-display"
            bindtap="focusCardInput"
          >{{cardBody || placeholderNote}}</text>
          <textarea
            wx:else
            class="card-input"
            focus="{{cardFocused}}"
            maxlength="{{noteMaxChars}}"
            placeholder="这段日子里你帮了太多。柜中挑了一件安静的藏品……"
            placeholder-class="card-placeholder"
            value="{{cardBody}}"
            bindinput="onCardInput"
            bindfocus="onCardFocus"
            bindblur="onCardBlur"
          />
          <view class="card-foot">
            <view class="card-count-wrap">
              <text class="card-count {{cardBody.length >= noteMaxChars ? 'is-full' : ''}}">{{cardBody.length}}/{{noteMaxChars}}</text>
              <!-- 快到上限才提示（平时不占版面）：说清"为什么有上限"——礼笺要印在贴纸上 -->
              <text class="card-count-hint" wx:if="{{cardBody.length >= noteMaxChars - 20}}">{{noteLimitHint}}</text>
            </view>
            <text class="card-sig-label">署名</text>
          </view>
          <view class="card-sig-wrap {{sigFocused ? 'focused' : ''}} {{sigJustSigned ? 'just-signed' : ''}}">
            <input
              class="card-sig"
              type="nickname"
              maxlength="20"
              placeholder="你的署名"
              placeholder-class="card-placeholder"
              value="{{cardSignature}}"
              bindinput="onSigInput"
              bindfocus="onSigFocus"
              bindblur="onSigBlur"
            />
            <view
              class="sig-nick-chip"
              wx:if="{{wxNickName && !cardSignature}}"
              catchtap="onUseNickName" hover-class="tap-press" hover-stay-time="80"
            >
              <text>用微信昵称</text>
            </view>
          </view>
        </view>

        <!-- 语音礼笺：与文字并存；逻辑见 giftVoice.js -->
        <view class="voice-rite">
          <view class="voice-rite-head">
            <text class="voice-rite-label">VOICE</text>
            <text class="voice-rite-hint">也可留下一段声音，至多 {{voiceMaxSec}} 秒</text>
          </view>

          <view class="voice-ready" wx:if="{{voiceFileID}}">
            <view wx:if="{{voiceUploading}}" class="voice-hold busy">
              <view class="voice-brass"></view>
              <text>收录中…</text>
            </view>
            <block wx:else>
              <view
                wx:if="{{!voiceRecording}}"
                class="voice-play {{voicePlaying ? 'on' : ''}}"
                bindtap="onVoicePlayTap"
              >
                <view class="voice-brass {{voicePlaying ? 'pulse' : ''}}"></view>
                <text>{{voicePlaying ? '暂停' : '试听'}}</text>
                <text class="voice-dur">{{voiceDurationLabel}}</text>
              </view>
              <view class="voice-actions">
                <view
                  class="voice-hold-mini {{voiceRecording ? 'recording' : ''}} {{voiceWillCancel ? 'will-cancel' : ''}}"
                  hover-stop-propagation="{{true}}"
                  catchtouchstart="onVoiceHoldStart"
                  catchtouchmove="onVoiceHoldMove"
                  catchtouchend="onVoiceHoldEnd"
                  catchtouchcancel="onVoiceHoldCancel"
                >
                  <text wx:if="{{voiceWillCancel}}">松开取消</text>
                  <text wx:elif="{{voiceRecording}}">松手结束 · {{voiceRecordSec}}s</text>
                  <text wx:else>重录</text>
                </view>
                <view
                  wx:if="{{!voiceRecording}}"
                  class="voice-delete"
                  bindtap="onVoiceDeleteTap"
                >
                  <text>删除</text>
                </view>
              </view>
              <text wx:if="{{voiceRecording && !voiceWillCancel}}" class="voice-slide-hint">上滑取消</text>
            </block>
          </view>

          <view
            wx:else
            class="voice-hold {{voiceRecording ? 'recording' : ''}} {{voiceUploading ? 'busy' : ''}} {{voiceWillCancel ? 'will-cancel' : ''}}"
            hover-stop-propagation="{{true}}"
            catchtouchstart="onVoiceHoldStart"
            catchtouchmove="onVoiceHoldMove"
            catchtouchend="onVoiceHoldEnd"
            catchtouchcancel="onVoiceHoldCancel"
          >
            <view class="voice-brass"></view>
            <text wx:if="{{voiceUploading}}">收录中…</text>
            <text wx:elif="{{voiceWillCancel}}">松开取消</text>
            <text wx:elif="{{voiceRecording}}">松手结束 · {{voiceRecordSec}}s</text>
            <text wx:else>按住说话</text>
          </view>
          <text
            wx:if="{{!voiceFileID && voiceRecording && !voiceWillCancel}}"
            class="voice-slide-hint"
          >上滑取消</text>
        </view>

        <text class="envelope-caption">藏品纸礼笺 · 封缄后再交付</text>
      </view>
    </view>
    </block>

    <!-- ═══ 第 3 步 · 交付 ═══ -->
    <block wx:else>
    <!-- 03 交付方式 -->
    <view class="section sec-delivery">
      <text class="section-overline">DELIVERY</text>
      <text class="section-title">{{selfTreat ? '寄到哪里' : '怎样交给 TA'}}</text>
      <block wx:if="{{selfTreat}}">
      <view class="delivery-main active">
        <view class="delivery-head">
          <text class="delivery-name">寄到我的收货地址</text>
          <text class="delivery-tag">犒劳自己</text>
        </view>
        <text class="delivery-desc">下一步和普通下单一样，填写你的收货地址与手机号，藏品直接寄给你。</text>
      </view>
      <text class="claim-switch self-exit" bindtap="exitSelfTreat">其实是送给别人？改为送礼方式 ›</text>
      </block>
      <block wx:else>
      <view
        class="delivery-main {{deliveryType === 'invite_address' ? 'active' : ''}}"
        data-type="invite_address"
        bindtap="onSelectDelivery"
      >
        <view class="delivery-head">
          <text class="delivery-name">邀请 TA 填写地址</text>
          <text class="delivery-tag">推荐</text>
        </view>
        <text class="delivery-desc">支付后分享领取卡，由 TA 启封礼笺并留下去处，馆员再启程</text>
      </view>

      <view class="other-toggle {{showOtherDelivery ? 'is-open' : ''}}" bindtap="toggleOtherDelivery" hover-class="tap-press" hover-stay-time="80">
        <view class="other-toggle-main">
          <text class="other-toggle-title">{{showOtherDelivery ? '其他交付方式' : '还有 ' + otherDeliveries.length + ' 种交付方式可选'}}</text>
          <text class="other-toggle-names" wx:if="{{!showOtherDelivery}}">{{otherDeliveryNames}}</text>
        </view>
        <text class="other-toggle-act">{{showOtherDelivery ? '收起 ▴' : '展开 ▾'}}</text>
      </view>

      <view class="other-list" wx:if="{{showOtherDelivery}}">
        <view
          class="delivery-item {{deliveryType === item.id ? 'active' : ''}}"
          wx:for="{{otherDeliveries}}"
          wx:key="id"
          data-type="{{item.id}}"
          bindtap="onSelectDelivery"
        >
          <text class="delivery-name">{{item.name}}</text>
          <text class="delivery-desc">{{item.desc}}</text>
        </view>
      </view>

      <view class="store-pick" wx:if="{{deliveryType === 'store_pickup' && storePickupEnabled}}">
        <text class="store-pick-label">自提门店</text>
        <view
          class="store-chip {{selectedStoreId === item.storeId ? 'on' : ''}}"
          wx:for="{{stores}}"
          wx:key="storeId"
          data-id="{{item.storeId}}"
          data-name="{{item.name}}"
          bindtap="onSelectStore"
        >
          <text>{{item.name}}</text>
        </view>
        <text class="store-empty" wx:if="{{!stores.length}}">这有店暂未就绪，稍后再选或换其他交付</text>
      </view>

      <!-- 受礼人手机号：直寄 TA 必填；填址 / 自提 / 寄给我推荐填写，也可凭礼笺领取（同 CLAIM_LINK_DELIVERY） -->
      <view id="receiverPhoneField" class="verify-set {{receiverPhoneError ? 'is-error' : ''}}">
        <block wx:if="{{claimLink && deliveryType !== 'ship_to_receiver'}}">
        <text class="verify-set-label">凭礼笺领取 <text class="verify-set-tip">不需要 TA 的手机号</text></text>
        <text class="verify-set-hint" wx:if="{{deliveryType === 'ship_to_self'}}">藏品照常寄到你处；TA 点礼笺「收下」后礼记在 TA 名下，订单结束前可作废换链接。不能发朋友圈。</text>
        <text class="verify-set-hint" wx:else>TA 打开礼笺后点「收下」才算领取，一份只能一人收下；收下前你可随时作废并换新链接。为防扩散，这份礼笺不能发朋友圈。</text>
        <view class="claim-opt {{claimPasscode ? 'on' : ''}}" bindtap="toggleClaimPasscode" hover-class="tap-press-soft" hover-stay-time="80">
          <view class="claim-check"></view>
          <text class="claim-opt-t">加 6 位领取口令（只你看得到，TA 输对才能收下）</text>
        </view>
        <text class="claim-switch" bindtap="toggleClaimLink">知道 TA 的手机号？改为手机号核验（更安全）</text>
        </block>
        <block wx:else>
        <text class="verify-set-label">受礼人手机号 <text class="verify-set-req" wx:if="{{deliveryType === 'ship_to_receiver'}}">* 必填</text><text class="verify-set-tip" wx:else>推荐填写</text></text>
        <input
          class="verify-set-input"
          type="number"
          maxlength="11"
          placeholder="TA 的 11 位手机号"
          placeholder-class="verify-set-ph"
          value="{{receiverPhone}}"
          focus="{{receiverPhoneFocus}}"
          bindinput="onReceiverPhoneInput"
        />
        <text class="verify-set-err" wx:if="{{receiverPhoneError}}">{{receiverPhoneError}}</text>
        <text class="verify-set-hint">用于受礼人领取时核验身份，防止礼笺被他人领走；仅存加密值与尾号。</text>
        <text class="claim-switch" wx:if="{{deliveryType !== 'ship_to_receiver'}}" bindtap="toggleClaimLink">不知道 TA 的手机号？凭礼笺领取 ›</text>
        </block>
      </view>
      </block>

      <view class="privacy-row privacy-row-locked is-on" wx:if="{{allowHidePriceToggle === false}}">
        <view class="check on"></view>
        <text class="privacy-txt">价格已隐藏（平台设定，不可更改）</text>
      </view>

      <!-- 2026-09-17：整行加 is-on 点亮（勾选框太小、只有填色很难看出「已隐藏」是开着的） -->
      <view class="privacy-row {{hidePrice ? 'is-on' : ''}}" bindtap="toggleHidePrice" wx:else>
        <view class="check {{hidePrice ? 'on' : ''}}"></view>
        <text class="privacy-text">对受礼人隐藏成交价（推荐）</text>
      </view>

      <view class="pack-note">
        <text class="pack-note-label">{{packagingLabel}}</text>
        <text class="pack-note-body">{{packagingNote}}</text>
      </view>
    </view>
    </block>

    <view class="scroll-pad"></view>
  </scroll-view>

  <view class="bottom-bar safe-area">
    <view class="bottom-price">
      <text class="bottom-label">备妥应付</text>
      <view class="bottom-value-row">
        <text class="bottom-value">¥{{payablePrice}}</text>
        <text class="bottom-origin" wx:if="{{memberDiscounted}}">¥{{displayPrice}}</text>
      </view>
      <text class="bottom-note" wx:if="{{memberDiscounted}}">{{memberLevelName}}会员价 · 以结算页为准</text>
    </view>
    <!-- 第 1、2 步只有「下一步」；支付只在第 3 步出现 -->
    <view wx:if="{{activeStep < 3}}" class="pay-btn" bindtap="onStepNext" hover-class="pay-btn-press" hover-stay-time="80">
      <text>下一步 · {{activeStep === 1 ? '写笺' : '交付'}}</text>
    </view>
    <view wx:else class="pay-btn {{paying ? 'disabled' : ''}}" bindtap="goPay" hover-class="pay-btn-press" hover-stay-time="80">
      <text>{{paying ? '备妥中…' : '支付并备妥'}}</text>
    </view>
  </view>
</view>

<view class="page checking" wx:elif="{{checking || loading}}">
  <view class="state-block">
    <view class="state-seal" aria-hidden="true"></view>
    <text class="muted">柜门轻启，正在备妥…</text>
  </view>
</view>

<view class="page checking" wx:else>
  <view class="state-block">
    <text class="state-title">暂无法打开礼赠</text>
    <text class="muted">{{loadError || '请从馆藏详情再次进入'}}</text>
    <view class="btn-secondary state-cta" bindtap="leaveCompose">返回</view>
    <view class="btn-ghost state-cta" bindtap="goBrowseFromError">去馆藏看看</view>
  </view>
</view>

<!-- 统一主视觉轻提示宿主：放最外层容器之外，避免被任何 filter/transform 影响定位 -->
<app-toast
  show="{{toastShow}}"
  overline="{{toastOverline}}"
  title="{{toastTitle}}"
  desc="{{toastDesc}}"
  duration="{{toastDuration}}"
  bind:close="onToastClose"
/>
