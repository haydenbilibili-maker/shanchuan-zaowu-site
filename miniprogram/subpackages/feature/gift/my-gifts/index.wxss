/* 我的礼赠 · 人情账本质感 · Museum Mode */
page {
  background: #1A1814;
  color: #FFFFFF;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity 0.28s ease, transform 0.28s ease;
}
.page.pane-ready {
  opacity: 1;
  transform: translateY(0);
}

.checking {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  min-height: 100vh;
  opacity: 1;
  transform: none;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
  max-width: 520rpx;
}

.state-mark {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.state-seal {
  width: 36rpx;
  height: 36rpx;
  border: 2px solid rgba(196, 167, 108, 0.55);
  border-radius: 50%;
  position: relative;
  z-index: 2;
  box-shadow: inset 0 0 0 6rpx rgba(250, 246, 237, 0.35);
}

.state-over {
  font-size: 18rpx;
  color: #8A7530;
  letter-spacing: 0.16em;
}

.state-hint {
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.45;
}

.state-back {
  margin-top: 12rpx;
  min-width: 240rpx;
}

.muted { color: #A09A90; font-size: 26rpx; }

/* —— 纸面纤维 / 压花 / 标本水印（贯穿页头·铜牌·空态） —— */
.paper-fiber {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.12;
  z-index: 0;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.35' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}
.paper-fiber.fine {
  opacity: 0.07;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='2.1' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23f)'/%3E%3C/svg%3E");
}
/* 暗底铜牌：纤维改为黄铜轻噪，勿 multiply 压黑 */
.brass-plate > .paper-fiber,
.plate-card > .paper-fiber {
  opacity: 0.18;
  mix-blend-mode: soft-light;
}
.paper-emboss {
  position: absolute;
  inset: 12rpx;
  pointer-events: none;
  z-index: 0;
  border: 1px solid rgba(196, 167, 108, 0.22);
  border-radius: 10rpx;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.55);
}
.paper-emboss.tight {
  inset: 8rpx;
  border-radius: 8rpx;
}
.specimen-wm,
.specimen-watermark {
  position: absolute;
  right: -28rpx;
  bottom: -36rpx;
  width: 200rpx;
  height: 200rpx;
  border: 16rpx solid rgba(26, 24, 20, 0.045);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.specimen-wm::after,
.specimen-watermark::after {
  content: '';
  position: absolute;
  inset: 28rpx;
  border: 2px solid rgba(26, 24, 20, 0.05);
  border-radius: 50%;
}
.specimen-watermark.sm,
.specimen-wm.sm {
  width: 120rpx;
  height: 120rpx;
  right: -16rpx;
  bottom: -20rpx;
  border-width: 10rpx;
}
.specimen-watermark.dark,
.specimen-wm.dark {
  border-color: rgba(196, 167, 108, 0.06);
}
.specimen-watermark.dark::after,
.specimen-wm.dark::after {
  border-color: rgba(196, 167, 108, 0.07);
}

/* —— 标本纸页头 —— */
.hero-plate {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  margin: 16rpx 32rpx 8rpx;
  padding: 22rpx 24rpx 18rpx;
  background:
    linear-gradient(165deg, #FAF6ED 0%, #F2EDE4 48%, #EDE6DA 100%);
  border: 1px solid #E0CFA3;
  border-radius: 16rpx;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.85);
}
.hero-content { position: relative; z-index: 2; }
/* overline + 状态灯 + 右铜钉同一行，钉不悬空 */
.hero-over-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
  min-height: 36rpx;
}
/* 纸面页头上的灯：光晕克制，避免在 Brass-50 上发糊 */
.hero-plate .signal-light {
  box-shadow: none;
  flex-shrink: 0;
}
.hero-over {
  font-size: 18rpx;
  color: #8A7530;
  letter-spacing: 0.14em;
  line-height: 1.3;
  min-width: 0;
}
.hero-brand {
  display: block;
  font-size: 20rpx;
  color: #A8903C;
  letter-spacing: 0.16em;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  line-height: 1.3;
  margin-bottom: 4rpx;
}
.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #6B5A24;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  letter-spacing: 0.04em;
  line-height: 1.25;
}
.hero-seal.metal,
.hero-metal-seal {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: auto;
  border: 2px solid #C4A76C;
  background: linear-gradient(145deg, #E0CFA3 0%, #C4A76C 48%, #8A7530 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.45);
}
.hero-seal-inner,
.hero-metal-inner {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(250, 246, 237, 0.55);
  border: 1px solid rgba(138, 117, 48, 0.35);
}
.hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A09A90;
  line-height: 1.45;
}
.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1px solid rgba(196, 167, 108, 0.22);
}
.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  min-width: 0;
}
.hero-stat-n {
  font-size: 26rpx;
  color: #8A7530;
  font-weight: 600;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
  line-height: 1.2;
}
.hero-stat.hot .hero-stat-n { color: #C47A1A; }
.hero-stat-l {
  font-size: 18rpx;
  color: #8B6F47;
  letter-spacing: 0.06em;
  line-height: 1.2;
}
.hero-stat-div {
  width: 1px;
  height: 32rpx;
  background: rgba(196, 167, 108, 0.22);
  flex-shrink: 0;
}

/* 页头待办焦点：主路径一眼可点 */
.todo-focus {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(233, 162, 59, 0.42);
  background: linear-gradient(135deg, rgba(233, 162, 59, 0.12) 0%, rgba(196, 167, 108, 0.08) 100%);
}
.todo-focus-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.todo-focus-left .signal-light {
  margin-top: 8rpx;
  box-shadow: none;
}
.todo-focus-copy { flex: 1; min-width: 0; }
.todo-focus-title {
  display: block;
  font-size: 24rpx;
  color: #6B5A24;
  font-weight: 500;
  line-height: 1.35;
}
.todo-focus-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8B6F47;
  line-height: 1.4;
}
.todo-focus-cta {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8A7530;
  letter-spacing: 0.04em;
  padding: 10rpx 4rpx 10rpx 12rpx;
  font-weight: 500;
}

/* —— 主分区 Tab —— */
.hub-tabs {
  display: flex;
  flex-shrink: 0;
  margin: 8rpx 32rpx 0;
  padding: 6rpx;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: 14rpx;
}
.hub-tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 10rpx;
  transition: background 0.2s ease;
}
.hub-tab.on {
  background: rgba(196, 167, 108, 0.14);
  box-shadow: inset 0 0 0 1px rgba(196, 167, 108, 0.28);
}
.hub-tab-lbl {
  font-size: 28rpx;
  color: #A09A90;
  letter-spacing: 0.08em;
}
.hub-tab.on .hub-tab-lbl {
  color: #C4A76C;
  font-weight: 500;
}
.hub-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}
.hub-n {
  min-width: 28rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  color: #6B6560;
  background: rgba(38, 35, 32, 0.9);
  border-radius: 999rpx;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}
.hub-n.hot { color: #1A1814; background: #E9A23B; }
.hub-tab.on .hub-n { color: #1A1814; background: #C4A76C; }
.hub-tab.on .hub-n.hot { background: #E9A23B; }
.hub-badge .signal-light,
.hub-lamp {
  transform: scale(0.9);
  box-shadow: none;
}

.pane {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  animation: paneFade 0.22s ease;
}
.pane.hide { display: none; }
@keyframes paneFade {
  from { opacity: 0.55; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* —— 往来子 Tab —— */
.sub-tabs {
  display: flex;
  flex-shrink: 0;
  padding: 12rpx 32rpx 0;
  gap: 8rpx;
}
.sub-tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-bottom: 3rpx solid transparent;
}
.sub-tab text { font-size: 26rpx; color: #A09A90; }
.sub-tab.on text { color: #C4A76C; font-weight: 500; }
.sub-tab.on { border-bottom-color: #C4A76C; }
.sub-n {
  font-size: 18rpx;
  color: #6B6560;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}
.sub-tab.on .sub-n { color: #A8903C; }

.filter-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 8rpx 32rpx 0;
  padding: 12rpx 20rpx;
  background: rgba(196, 167, 108, 0.1);
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 12rpx;
}
.filter-chip .signal-light { box-shadow: none; }
.filter-chip-txt {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #C4A76C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filter-chip-clear {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #A09A90;
  padding: 4rpx 8rpx;
}

.segments {
  flex-shrink: 0;
  width: 100%;
  white-space: nowrap;
  padding: 16rpx 28rpx 8rpx;
  box-sizing: border-box;
}
.seg {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  margin-right: 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.28);
  border-radius: 999rpx;
  vertical-align: middle;
  box-sizing: border-box;
}
.seg.on {
  border-color: #C4A76C;
  background: rgba(196, 167, 108, 0.14);
}
.seg-label { font-size: 22rpx; color: #A09A90; }
.seg.on .seg-label { color: #C4A76C; }
.seg-n {
  font-size: 18rpx;
  color: #6B6560;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}

.scroll {
  /* 禁止 flex:1 + height:0（iPhone scroll-view 会塌成空白）；高度由 scrollStyle 写入 */
  flex-shrink: 0;
  width: 100%;
  height: calc(100vh - 420rpx);
  min-height: 240px;
  padding: 12rpx 32rpx 0;
  box-sizing: border-box;
}
.scroll.alone { padding-top: 20rpx; }
/* 底栏：上12 + 按钮88 + 下16 ≈ 116rpx；再加页脚余量与 safe-area。
   必须用 spacer（scroll-view 的 padding-bottom 在真机上不可靠滚出遮挡） */
.dock-pad {
  height: calc(148rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.dim { opacity: 0.72; transition: opacity 0.2s ease; }

/* —— 骨架 —— */
.skel-list {
  padding: 12rpx 0 40rpx;
}
.skel-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: 16rpx;
}
.skel-cover {
  width: 136rpx;
  height: 136rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #262320 0%, #2e2a26 50%, #262320 100%);
  background-size: 200% 100%;
  animation: skelShine 1.2s ease infinite;
  flex-shrink: 0;
}
.skel-body { flex: 1; padding-top: 8rpx; }
.skel-line {
  height: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #262320 0%, #2e2a26 50%, #262320 100%);
  background-size: 200% 100%;
  animation: skelShine 1.2s ease infinite;
}
.skel-line.short { width: 40%; }
.skel-line.mid { width: 70%; }
.skel-plate {
  height: 140rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(77, 64, 26, 0.35);
  background: linear-gradient(90deg, #1F1D1A 0%, #262320 50%, #1F1D1A 100%);
  background-size: 200% 100%;
  animation: skelShine 1.2s ease infinite;
}
.skel-hint {
  display: block;
  text-align: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6B6560;
}
@keyframes skelShine {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* —— 空态 —— */
.list-error,
.empty {
  padding: 64rpx 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 14rpx;
}
.empty-mark {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}
.empty-mark.paper-empty {
  background: linear-gradient(160deg, #FAF6ED 0%, #F2EDE4 100%);
  border: 1px solid #E0CFA3;
}
.empty-ring {
  width: 64rpx;
  height: 64rpx;
  border: 2px solid rgba(196, 167, 108, 0.4);
  border-radius: 50%;
  position: relative;
  z-index: 1;
}
.empty-ring.emboss-ring {
  box-shadow: inset 0 0 0 1px rgba(250, 246, 237, 0.4);
}
.empty-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #C4A76C;
}
.empty-bar {
  position: absolute;
  width: 28rpx;
  height: 2px;
  background: rgba(196, 167, 108, 0.55);
}
.paper-empty .signal-light {
  position: absolute;
  z-index: 2;
}
.empty-title {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
  font-family: 'Source Han Serif SC', Georgia, serif;
}
.empty-over {
  font-size: 18rpx;
  color: #8A7530;
  letter-spacing: 0.16em;
  margin-bottom: -4rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.6;
  max-width: 460rpx;
}
.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  width: 100%;
}
.link {
  font-size: 26rpx;
  color: #C4A76C;
  border-bottom: 1px solid rgba(196, 167, 108, 0.4);
  padding-bottom: 2rpx;
  margin-top: 8rpx;
}

.btn-brass {
  min-width: 280rpx;
  height: 80rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #C4A76C;
  color: #1A1814;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  border-radius: 16rpx;
}
.btn-brass-press { background: #A8903C; }
.btn-brass.disabled { opacity: 0.55; pointer-events: none; }
.btn-ghost {
  min-width: 280rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C4A76C;
  font-size: 26rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 16rpx;
}
.btn-ghost.danger { color: #D64045; border-color: rgba(214, 64, 69, 0.4); }

/* —— 往来卡片 · 金属描边 —— */
.card,
.metal-card {
  position: relative;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: 16rpx;
  overflow: hidden;
}
.metal-edge {
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 3rpx;
  background: linear-gradient(180deg, transparent, #C4A76C 30%, #E0CFA3 50%, #C4A76C 70%, transparent);
  opacity: 0.55;
  pointer-events: none;
}
.card-attention {
  border-color: rgba(196, 167, 108, 0.45);
  background: linear-gradient(180deg, #241f18 0%, #1F1D1A 100%);
}
.card-attention .metal-edge {
  opacity: 0.85;
  animation: edgePulse 2.4s ease-in-out infinite;
}
@keyframes edgePulse {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.95; }
}
.card-urgent {
  border-color: rgba(233, 162, 59, 0.55);
}
/* 已取消 / 已退款等失效终态：整体降饱和，缩略图灰度，标题与价格去 brass */
.card-inactive {
  opacity: 0.72;
  border-color: rgba(38, 35, 32, 0.95);
  background: #1c1a17;
}
.card-inactive .metal-edge {
  opacity: 0.18;
  background: linear-gradient(180deg, transparent, #6B6560 30%, #A09A90 50%, #6B6560 70%, transparent);
}
.card-inactive .cover-wrap::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 12rpx;
  background: rgba(26, 24, 20, 0.28);
  pointer-events: none;
  z-index: 1;
}
.card-inactive .cover {
  filter: grayscale(1);
  opacity: 0.78;
  border-color: rgba(107, 101, 96, 0.35);
}
.card-inactive .cover.placeholder {
  border-color: rgba(107, 101, 96, 0.35);
  background: linear-gradient(160deg, #262320 0%, #1a1814 100%);
}
.card-inactive .cover-plate {
  border-color: rgba(107, 101, 96, 0.4);
  background: rgba(107, 101, 96, 0.12);
}
.card-inactive .role-chip {
  border-color: rgba(107, 101, 96, 0.4);
  color: #6B6560;
  background: rgba(26, 24, 20, 0.7);
}
.card-inactive .role-chip.received {
  border-color: rgba(107, 101, 96, 0.4);
  color: #6B6560;
}
.card-inactive .voice-badge {
  border-color: rgba(107, 101, 96, 0.4);
  opacity: 0.7;
}
.card-inactive .status-plate {
  background: rgba(38, 35, 32, 0.85);
  border-color: rgba(107, 101, 96, 0.28);
}
.card-inactive .status,
.card-inactive .status.hot {
  color: #6B6560;
}
.card-inactive .title {
  color: #A09A90;
}
.card-inactive .snippet {
  color: #6B6560;
}
.card-inactive .meta,
.card-inactive .time,
.card-inactive .expire {
  color: #6B6560;
}
.card-inactive .price {
  color: #6B6560;
}
.card-inactive .actions .act.primary {
  background: rgba(160, 154, 144, 0.35);
  color: #A09A90;
}
.card-inactive .actions .act.ghost {
  color: #6B6560;
  border-color: rgba(107, 101, 96, 0.4);
}
.card-press { opacity: 0.88; transform: scale(0.99); }
.card-inactive.card-press { opacity: 0.62; }

.cover-wrap {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
}
.role-chip {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  z-index: 2;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  letter-spacing: 0.04em;
  border-radius: 6rpx;
  background: rgba(26, 24, 20, 0.78);
  border: 1px solid rgba(196, 167, 108, 0.45);
  color: #C4A76C;
}
.role-chip.received {
  border-color: rgba(45, 90, 63, 0.55);
  color: #52B788;
}
.cover {
  width: 136rpx;
  height: 136rpx;
  border-radius: 12rpx;
  background: #262320;
  display: block;
  border: 1px solid rgba(77, 64, 26, 0.55);
  box-sizing: border-box;
}
.cover.placeholder {
  border: 1px solid rgba(196, 167, 108, 0.35);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #262320 0%, #1F1D1A 100%);
}
.cover-plate {
  width: 36rpx;
  height: 36rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 6rpx;
  background: linear-gradient(145deg, rgba(224, 207, 163, 0.2), rgba(138, 117, 48, 0.12));
}
.voice-badge {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(26, 24, 20, 0.8);
  border: 1px solid rgba(196, 167, 108, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.voice-icon { width: 20rpx; height: 20rpx; }

.body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.status-line { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.status-plate {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  max-width: 70%;
  padding: 4rpx 12rpx 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1px solid rgba(196, 167, 108, 0.22);
}
.status-plate .signal-light { box-shadow: none; }
/* 信号灯交由 app.wxss .signal-light；勿在本页重写色板 */
.status { font-size: 22rpx; color: #A09A90; letter-spacing: 0.02em; }
.status.hot { color: #C4A76C; }
.expire { flex-shrink: 0; font-size: 20rpx; color: #A09A90; max-width: 46%; text-align: right; }
.expire.urgent { color: #E9A23B; }
.title {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.snippet {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8B6F47;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: Georgia, 'Source Han Serif SC', serif;
  font-style: italic;
}
.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A09A90;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meta.recipient {
  color: #C4A76C;
  letter-spacing: 0.02em;
  font-weight: 500;
}

/* 履约微轨 */
.prog-rail {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 4rpx;
  margin-top: 14rpx;
  padding: 10rpx 4rpx 2rpx;
}
.prog-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  position: relative;
}
.prog-step:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: calc(50% + 10rpx);
  right: calc(-50% + 10rpx);
  height: 1px;
  background: rgba(77, 64, 26, 0.65);
}
.prog-step.done:not(:last-child)::after {
  background: rgba(196, 167, 108, 0.55);
}
.prog-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #262320;
  border: 1px solid rgba(107, 101, 96, 0.7);
  box-sizing: border-box;
  z-index: 1;
}
.prog-step.done .prog-dot {
  background: #C4A76C;
  border-color: #C4A76C;
}
.prog-step.current .prog-dot {
  background: #E9A23B;
  border-color: #E9A23B;
  box-shadow: 0 0 6rpx rgba(233, 162, 59, 0.45);
}
.prog-lbl {
  font-size: 16rpx;
  color: #6B6560;
  letter-spacing: 0.02em;
  text-align: center;
  line-height: 1.2;
}
.prog-step.done .prog-lbl { color: #A09A90; }
.prog-step.current .prog-lbl { color: #C4A76C; }

.row-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
}
.time {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #A09A90;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}
.price {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #C4A76C;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}

/* 往来卡操作行：与日子铜牌 plate-acts 同为两端铺满，主按钮略宽 */
.actions {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid rgba(196, 167, 108, 0.14);
}
.actions .act {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: 0.04em;
}
.actions .act.primary {
  flex: 1.55;
}
.actions .act.ghost {
  flex: 0.85;
  max-width: 200rpx;
}
.act {
  min-height: 64rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  letter-spacing: 0.02em;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.act.primary { background: #C4A76C; color: #1A1814; font-weight: 500; }
.act.primary.glow {
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.35),
    0 0 0 1rpx rgba(224, 207, 163, 0.35);
}
.act-primary-press { background: #A8903C; }
.act.ghost {
  background: transparent;
  color: #C4A76C;
  border: 1px solid rgba(196, 167, 108, 0.45);
}
.act-ghost-press { opacity: 0.8; background: rgba(196, 167, 108, 0.06); }

.list-foot { padding: 28rpx 0 8rpx; text-align: center; }
.scroll-pad { height: 24rpx; }
/* 与 .scroll-pad 同用时需压过上面的 24rpx，否则底栏仍会挡页脚 */
.scroll-pad.dock-pad {
  height: calc(148rpx + env(safe-area-inset-bottom));
}

/* —— 分区头 —— */
.panel-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.panel-titles { flex: 1; min-width: 0; }
.ph-over-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}
.ph-over {
  font-size: 20rpx;
  color: #8A7530;
  letter-spacing: 0.14em;
}
.ph-title {
  display: block;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  font-family: 'Source Han Serif SC', Georgia, serif;
}
.ph-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6B6560;
  line-height: 1.4;
}
.ph-btn {
  height: 64rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  color: #C4A76C;
  border: 1px solid rgba(196, 167, 108, 0.45);
  border-radius: 12rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.ph-btn.metal {
  background: linear-gradient(160deg, rgba(196, 167, 108, 0.12) 0%, rgba(77, 64, 26, 0.2) 100%);
  border-color: rgba(196, 167, 108, 0.55);
  box-shadow: inset 0 1rpx 0 rgba(224, 207, 163, 0.18);
}
.ph-btn-press { background: rgba(196, 167, 108, 0.14); }

.people-head {
  position: relative;
  overflow: hidden;
  align-items: center;
  padding: 22rpx 22rpx 20rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(224, 207, 163, 0.28);
  background: linear-gradient(165deg, #241f18 0%, #1F1D1A 55%, #1c1a16 100%);
}
.people-head .dates-head-paper {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  opacity: 0.5;
}
.people-head .panel-titles,
.people-head .ph-btn {
  position: relative;
  z-index: 1;
}
.people-head .ph-title { color: #E0CFA3; }
.people-head .ph-hint { color: #8B6F47; }

.section-label {
  display: block;
  font-size: 20rpx;
  color: #8A7530;
  letter-spacing: 0.1em;
  margin: 4rpx 0 16rpx;
}
.section-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 4rpx 0 16rpx;
}
.section-label-row .section-label { margin: 0; }
.section-label-row .signal-light { box-shadow: none; }

/* —— 日子分区头 · 标本纸铜牌 —— */
.dates-head {
  position: relative;
  overflow: hidden;
  align-items: center;
  padding: 22rpx 22rpx 20rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(224, 207, 163, 0.35);
  background: linear-gradient(165deg, #241f18 0%, #1F1D1A 55%, #1c1a16 100%);
}
.dates-head-paper {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  opacity: 0.55;
  background: linear-gradient(160deg, rgba(250, 246, 237, 0.07) 0%, transparent 55%);
}
.dates-head-paper .paper-fiber {
  opacity: 0.14;
  mix-blend-mode: soft-light;
}
.dates-head-paper .paper-emboss {
  border-color: rgba(196, 167, 108, 0.16);
  box-shadow: inset 0 1rpx 0 rgba(224, 207, 163, 0.12);
}
.dates-head .panel-titles,
.dates-head .ph-btn {
  position: relative;
  z-index: 1;
}
.dates-head .ph-title {
  color: #E0CFA3;
  letter-spacing: 0.03em;
}
.dates-head .ph-hint { color: #8B6F47; }
.dates-head .signal-light { box-shadow: none; }

/* —— 铜牌档案 —— */
.plate-card,
.brass-plate {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(224, 207, 163, 0.06) 0%, transparent 28%),
    linear-gradient(165deg, #262018 0%, #1F1D1A 48%, #1a1814 100%);
  border: 1px solid rgba(196, 167, 108, 0.38);
  border-radius: 16rpx;
  padding: 26rpx 24rpx 22rpx;
  margin-bottom: 18rpx;
  box-shadow: inset 0 1rpx 0 rgba(224, 207, 163, 0.1);
}
.plate-emboss {
  position: absolute;
  inset: 10rpx;
  border: 1px solid rgba(196, 167, 108, 0.16);
  border-radius: 10rpx;
  pointer-events: none;
  z-index: 0;
  box-shadow:
    inset 0 0 0 1px rgba(77, 64, 26, 0.22),
    inset 0 1rpx 0 rgba(224, 207, 163, 0.08);
}
.plate-card > .plate-top,
.plate-card > .plate-acts,
.plate-card > .act {
  position: relative;
  z-index: 1;
}
.plate-card.hot { border-color: rgba(233, 162, 59, 0.55); }
.plate-card.near { border-color: rgba(196, 167, 108, 0.5); }

.plate-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 0;
  padding-bottom: 18rpx;
}
.plate-avatar {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: linear-gradient(160deg, #FAF6ED 0%, #F2EDE4 100%);
  border: 1px solid #E0CFA3;
  color: #8A7530;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: 'Source Han Serif SC', Georgia, serif;
  overflow: hidden;
}
.plate-avatar-shine {
  position: absolute;
  left: -20%;
  top: -40%;
  width: 70%;
  height: 60%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.35), transparent 70%);
  pointer-events: none;
}
.plate-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}
.plate-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.plate-name {
  font-size: 30rpx;
  color: #E0CFA3;
  font-weight: 500;
  font-family: 'Source Han Serif SC', Georgia, serif;
  line-height: 1.4;
  letter-spacing: 0.02em;
}
.plate-tag {
  font-size: 18rpx;
  color: #C4A76C;
  padding: 6rpx 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 6rpx;
  background: rgba(196, 167, 108, 0.08);
  letter-spacing: 0.06em;
  line-height: 1.2;
  box-sizing: border-box;
}
.plate-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}
.plate-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A09A90;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.plate-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6B6560;
}
.plate-meta.soft {
  margin-top: 0;
  color: #A09A90;
  font-size: 22rpx;
}
.plate-acts {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
  padding-top: 18rpx;
  border-top: 1px solid rgba(196, 167, 108, 0.14);
}
.plate-acts .act {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: 0.04em;
  box-sizing: border-box;
}
.plate-acts.triple .act {
  padding: 0 10rpx;
  font-size: 22rpx;
}
/* 日子卡：主操作铺满，次要「编辑」收窄右贴 */
.date-plate .plate-acts .act.primary {
  flex: 1.55;
}
.date-plate .plate-acts .act.ghost {
  flex: 0.85;
  max-width: 200rpx;
}
.date-plate .act.primary.metal {
  background: linear-gradient(160deg, #D4BC85 0%, #C4A76C 48%, #A8903C 100%);
  color: #1A1814;
  border: 1px solid rgba(224, 207, 163, 0.4);
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.42),
    inset 0 -1rpx 0 rgba(138, 117, 48, 0.28);
}
.date-plate .act.ghost {
  border-color: rgba(196, 167, 108, 0.48);
  color: #D4BC85;
  background: rgba(196, 167, 108, 0.04);
}

/* —— 日子徽标 · 压花铜牌纸面 —— */
.date-badge {
  position: relative;
  width: 148rpx;
  min-height: 116rpx;
  padding: 12rpx 10rpx 12rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: linear-gradient(160deg, #FAF6ED 0%, #F2EDE4 55%, #EDE6DA 100%);
  border: 1px solid #E0CFA3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
  overflow: hidden;
  box-shadow:
    inset 0 1rpx 0 rgba(250, 246, 237, 0.95),
    inset 0 -1rpx 0 rgba(196, 167, 108, 0.18);
}
.date-badge-inner {
  position: absolute;
  inset: 6rpx;
  border: 1px solid rgba(196, 167, 108, 0.28);
  border-radius: 8rpx;
  pointer-events: none;
}
.date-badge .signal-light {
  position: relative;
  z-index: 1;
  margin-bottom: 4rpx;
}
.date-badge.paper .signal-light.hollow {
  border-color: #8A7530;
}
.date-badge.hot {
  border-color: rgba(233, 162, 59, 0.75);
  background: linear-gradient(160deg, #FAF6ED 0%, #F5E8D0 100%);
}
.date-badge.near {
  border-color: rgba(196, 167, 108, 0.7);
}
.date-badge.soft {
  background: #262320;
  border-color: rgba(77, 64, 26, 0.55);
  box-shadow: none;
}
.date-badge-year {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  color: #8A7530;
  letter-spacing: 0.06em;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
  line-height: 1.2;
}
.date-badge-md {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: #6B5A24;
  font-weight: 500;
  font-family: 'Source Han Serif SC', Georgia, serif;
  line-height: 1.35;
  text-align: center;
  letter-spacing: 0.02em;
}
.date-badge-until {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #8B6F47;
  letter-spacing: 0.02em;
}
.date-badge-until.hot { color: #C47A1A; font-weight: 500; }
.date-badge-until.near { color: #8A7530; }

.date-plate.hot {
  background:
    linear-gradient(180deg, rgba(233, 162, 59, 0.08) 0%, transparent 32%),
    linear-gradient(165deg, #2a2218 0%, #1F1D1A 58%, #1a1814 100%);
}

.date-plate .plate-body {
  gap: 12rpx;
  justify-content: center;
  padding-top: 2rpx;
}

.near-block { margin-bottom: 28rpx; }

/* 临近焦点条 */
.spotlight {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(233, 162, 59, 0.45);
  background: linear-gradient(135deg, #2a2218 0%, #1F1D1A 70%);
}
.spotlight-paper {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.35;
}
.spotlight-paper .paper-fiber {
  opacity: 0.2;
  mix-blend-mode: soft-light;
}
.spotlight-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  position: relative;
  z-index: 1;
}
.spotlight-left .signal-light { margin-top: 10rpx; }
.spotlight-copy { flex: 1; min-width: 0; }
.spotlight-until {
  display: block;
  font-size: 20rpx;
  color: #E9A23B;
  letter-spacing: 0.06em;
  margin-bottom: 6rpx;
}
.spotlight-title {
  display: block;
  font-size: 30rpx;
  color: #E0CFA3;
  font-family: 'Source Han Serif SC', Georgia, serif;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.spotlight-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8B6F47;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.spotlight-cta {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  min-height: 72rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #D4BC85 0%, #C4A76C 48%, #A8903C 100%);
  color: #1A1814;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: 1px solid rgba(224, 207, 163, 0.35);
}

.dates-empty { padding-top: 72rpx; }
.dates-empty-mark {
  width: 112rpx;
  height: 112rpx;
}
.dates-empty-mark .signal-light {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 50%;
  margin: -6rpx 0 0 -6rpx;
}

/* —— 半屏表单 —— */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(26, 24, 20, 0.72);
  z-index: 40;
  opacity: 0;
  transition: opacity 0.22s ease;
}
.sheet-mask.on { opacity: 1; }

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  background: linear-gradient(180deg, #241f18 0%, #1F1D1A 18%, #1F1D1A 100%);
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1px solid rgba(196, 167, 108, 0.28);
  /* 底安全区用 sheet-safe spacer，勿只靠 padding-bottom */
  padding: 16rpx 32rpx 0;
  box-sizing: border-box;
  height: auto;
  max-height: 86vh;
  overflow-y: auto;
  transform: translateY(24rpx);
  opacity: 0;
  transition: transform 0.24s ease, opacity 0.24s ease;
}
.sheet-safe {
  width: 100%;
  height: calc(40rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
.sheet.on {
  transform: translateY(0);
  opacity: 1;
}
.sheet-handle {
  width: 64rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(160, 154, 144, 0.35);
  margin: 0 auto 20rpx;
}
.sheet-over {
  display: block;
  font-size: 20rpx;
  color: #8A7530;
  letter-spacing: 0.14em;
  margin-bottom: 8rpx;
}
.sheet-title {
  display: block;
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 500;
  font-family: 'Source Han Serif SC', Georgia, serif;
  margin-bottom: 28rpx;
}
.field { margin-bottom: 24rpx; }
.field.row2 { display: flex; gap: 20rpx; }
.field.half { flex: 1; margin-bottom: 0; }
.field-lbl {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  margin-bottom: 12rpx;
}
.field-input {
  height: 84rpx;
  padding: 0 24rpx;
  background: #262320;
  border: 1px solid rgba(77, 64, 26, 0.45);
  border-radius: 12rpx;
  color: #FFFFFF;
  font-size: 28rpx;
}
.field-picker {
  min-height: 84rpx;
  padding: 0 24rpx;
  background: #262320;
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 12rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.field-picker.is-placeholder { color: #6B6560; }
.field-picker-chev {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #A09A90;
  border-bottom: 2rpx solid #A09A90;
  transform: rotate(45deg);
  margin-top: -6rpx;
  flex-shrink: 0;
}
.field-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #A09A90;
  line-height: 1.45;
}
.import-field { margin-top: -4rpx; }
.import-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.28);
  background: linear-gradient(160deg, rgba(250, 246, 237, 0.06) 0%, rgba(196, 167, 108, 0.05) 100%);
}
.import-copy { flex: 1; min-width: 0; }
.import-title {
  display: block;
  font-size: 26rpx;
  color: #E0CFA3;
}
.import-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6B6560;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.import-cta {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #C4A76C;
  letter-spacing: 0.04em;
}
.chip-scroll { width: 100%; white-space: nowrap; }
.chip-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
}
.chip-row.wrap { flex-wrap: wrap; white-space: normal; }
.chip-row.wrap .chip {
  padding: 12rpx 20rpx;
  font-size: 22rpx;
}
.chip {
  padding: 14rpx 22rpx;
  border: 1px solid rgba(196, 167, 108, 0.3);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #A09A90;
  flex-shrink: 0;
}
.chip.on {
  border-color: #C4A76C;
  color: #C4A76C;
  background: rgba(196, 167, 108, 0.12);
}
.sheet-acts {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
  align-items: stretch;
}
.sheet-acts .btn-brass,
.sheet-acts .btn-ghost {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* 底部常驻选礼 */
.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 12rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(26, 24, 20, 0) 0%, rgba(26, 24, 20, 0.92) 28%, #1A1814 100%);
  pointer-events: none;
}
.dock-btn {
  pointer-events: auto;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: linear-gradient(160deg, #D4BC85 0%, #C4A76C 48%, #A8903C 100%);
  border-radius: 16rpx;
  border: 1px solid rgba(224, 207, 163, 0.4);
  box-shadow: inset 0 1rpx 0 rgba(250, 246, 237, 0.35);
}
.dock-btn-press { background: #A8903C; }
.dock-over {
  font-size: 16rpx;
  color: rgba(26, 24, 20, 0.55);
  letter-spacing: 0.14em;
}
.dock-lbl {
  font-size: 28rpx;
  color: #1A1814;
  font-weight: 500;
  letter-spacing: 0.04em;
}

/* ── 需求 31：已退款 / 已取消折叠进券包 ─────────────────────────────────
 *
 * 与礼券夹（subpackages/business/coupons）**同一套券包语言**：
 *   3 张错位迷你券（最前一张提亮并打 3 个孔）+ 计数 + CSS 折角箭头 + 展开动画 + aria。
 * 券夹是这套语言的源头；此处保持逐字对齐，避免两页各长一套。
 */

.pouch {
  margin: 10rpx 0 8rpx;
}

.pouch-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  background: #1F1D1A;
  border: 1rpx solid #262320;
  border-radius: 16rpx;
  transition: border-color 0.24s ease;
}

.pouch-head.is-open {
  border-color: #3A342A;
}

.pouch-head-press {
  background: #232120;
}

/* 券包堆叠：三张错位迷你券，最前一张带打眼 —— 一眼看出「这里压着一叠废券」 */
.pouch-stack {
  position: relative;
  width: 68rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.pouch-ticket {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 52rpx;
  height: 36rpx;
  box-sizing: border-box;
  border: 1rpx solid #3A342A;
  border-radius: 6rpx;
  background: #2A2724;
  transform-origin: 50% 100%;
}

.pouch-ticket.t3 {
  transform: translate(8rpx, -12rpx) rotate(7deg);
  opacity: 0.5;
}

.pouch-ticket.t2 {
  transform: translate(4rpx, -6rpx) rotate(-4deg);
  opacity: 0.78;
}

/* 最前一张提亮一档：小尺寸下若和前两张同色，整叠会糊成一块 */
.pouch-ticket.t1 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border-color: #4A4232;
  background: #363128;
}

.pouch-hole {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #12100D;
}

.pouch-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.pouch-title {
  font-size: 26rpx;
  color: #D5D1C8;
  letter-spacing: 0.02em;
}

.pouch-sub {
  font-size: 22rpx;
  color: #6B6560;
}

/* 折叠箭头：CSS 折角（比字符箭头转动更可控），收起朝下 / 展开朝上 */
.pouch-arrow {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin-right: 6rpx;
  border-right: 2rpx solid #6B6560;
  border-bottom: 2rpx solid #6B6560;
  transform: rotate(45deg) translate(-4rpx, -4rpx);
  transition: transform 0.24s ease, border-color 0.24s ease;
}

.pouch-arrow.open {
  transform: rotate(-135deg) translate(-4rpx, -4rpx);
  border-color: #C4A76C;
}

.pouch-body {
  animation: pouch-in 0.26s ease both;
}

@keyframes pouch-in {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.pouch-foot {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: #4F4A45;
}

/* 往来分层小标题：只在同屏既有在途又有失效时才出现 */
.flow-section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 4rpx 16rpx;
}

.flow-section-label {
  font-size: 24rpx;
  color: #C4A76C;
  letter-spacing: 0.08em;
}

.flow-section-n {
  font-size: 20rpx;
  color: #6B6560;
}

.flow-section-rule {
  flex: 1;
  height: 1px;
  background: rgba(196, 167, 108, 0.16);
}

/* 在途清空、只剩失效券包时的说明条（不留「空白 + 券包」的困惑） */
.flow-empty-note {
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  border: 1rpx dashed #3A342A;
  border-radius: 16rpx;
}

.flow-empty-note-main {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
}

.flow-empty-note-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #6B6560;
}

.card-hit.is-folded {
  opacity: 0.62;
}

/* 领取核验芯片（送出侧，只显示尾号） */
.verify-chip {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1px dashed rgba(196, 167, 108, 0.5);
  font-size: 22rpx;
  color: #B8AD98;
}
.verify-chip.on { border-style: solid; color: #C4A76C; }
.verify-chip.warn { border: 1px solid #E8927C; color: #E8927C; }
