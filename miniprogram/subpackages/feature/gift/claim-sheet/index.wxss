.cs-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:900;background:rgba(10,9,7,0.72);display:flex;align-items:flex-end}
.cs-panel{width:100%;box-sizing:border-box;padding:44rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));background:#1F1D1A;border-top:2rpx solid rgba(196,167,108,0.45);border-radius:28rpx 28rpx 0 0;display:flex;flex-direction:column}
.cs-over{font-size:20rpx;letter-spacing:6rpx;color:#C4A76C}
.cs-title{margin-top:12rpx;font-size:34rpx;font-weight:600;color:#F3ECDD}
.cs-desc{margin-top:14rpx;font-size:24rpx;line-height:1.7;color:#B8AD98}
.cs-row{margin-top:28rpx;padding:24rpx 26rpx;border:2rpx solid rgba(196,167,108,0.3);border-radius:14rpx;display:flex;flex-direction:column}
.cs-k{font-size:22rpx;letter-spacing:2rpx;color:#C4A76C}
.cs-v{margin-top:10rpx;font-size:28rpx;line-height:1.6;color:#F3ECDD}
.cs-code{margin-top:10rpx;font-size:52rpx;letter-spacing:14rpx;font-weight:600;color:#F3ECDD}
.cs-mini{margin-top:10rpx;font-size:22rpx;line-height:1.6;color:#9A8F7C}
.cs-center{text-align:center}
.cs-notice{margin-top:18rpx;font-size:24rpx;line-height:1.6;color:#E6DCC8}
.cs-error{margin-top:14rpx;font-size:24rpx;color:#E8927C}
.cs-btn{margin-top:32rpx;height:88rpx;line-height:88rpx;text-align:center;border-radius:44rpx;border:2rpx solid #C4A76C;color:#C4A76C;font-size:28rpx}
.cs-btn.is-warn{background:#E8927C;border-color:#E8927C;color:#1A1814;font-size:24rpx}
.cs-btn.is-busy{opacity:0.6}
.cs-btn-press{opacity:0.85}
.cs-link{margin-top:22rpx;text-align:center;font-size:26rpx;color:#C4A76C}
.cs-row .cs-link{text-align:left}
.cs-link-muted{color:#9A8F7C}
