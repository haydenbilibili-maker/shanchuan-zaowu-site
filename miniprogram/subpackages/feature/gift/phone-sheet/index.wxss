.ps-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:900;background:rgba(10,9,7,0.72);display:flex;align-items:flex-end}
.ps-panel{width:100%;box-sizing:border-box;padding:44rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));background:#1F1D1A;border-top:2rpx solid rgba(196,167,108,0.45);border-radius:28rpx 28rpx 0 0;display:flex;flex-direction:column}
.ps-over{font-size:20rpx;letter-spacing:6rpx;color:#C4A76C}
.ps-title{margin-top:12rpx;font-size:34rpx;font-weight:600;color:#F3ECDD}
.ps-desc{margin-top:14rpx;font-size:24rpx;line-height:1.7;color:#B8AD98}
.ps-input{margin-top:32rpx;height:92rpx;padding:0 28rpx;border:2rpx solid rgba(196,167,108,0.5);border-radius:12rpx;background:#2A2621;color:#F3ECDD;font-size:34rpx;letter-spacing:4rpx}
.ps-ph{color:#7D7466;letter-spacing:0;font-size:28rpx}
.ps-error{margin-top:14rpx;font-size:24rpx;color:#E8927C}
.ps-btn{margin-top:32rpx;height:88rpx;line-height:88rpx;text-align:center;border-radius:44rpx;background:#C4A76C;color:#1A1814;font-size:30rpx;font-weight:600}
.ps-btn.is-busy{opacity:0.6}
.ps-btn-press{opacity:0.85}
.ps-link{margin-top:24rpx;text-align:center;font-size:26rpx;color:#C4A76C}
.ps-link-muted{color:#9A8F7C}
