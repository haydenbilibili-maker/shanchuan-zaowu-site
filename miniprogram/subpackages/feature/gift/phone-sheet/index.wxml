<view class="ui-pop-mask ps-mask" wx:if="{{show}}" bindtap="onClose" catchtouchmove="noop">
  <view class="ui-pop-sheet ps-panel" catchtap="noop">
    <view class="ui-pop-grip ps-grip"></view>
    <text class="ui-pop-kicker">{{overline}}</text>
    <text class="ui-pop-title">{{title}}</text>
    <text class="ps-desc" wx:if="{{desc}}">{{desc}}</text>
    <input
      class="ps-input"
      type="number"
      maxlength="11"
      placeholder="{{placeholder}}"
      placeholder-class="ps-ph"
      value="{{value}}"
      focus="{{show}}"
      bindinput="onInput"
      bindconfirm="onConfirm"
    />
    <text class="ps-error" wx:if="{{localError || error}}">{{localError || error}}</text>
    <view class="ui-pop-btn is-primary ps-btn {{busy ? 'is-busy' : ''}}" hover-class="ps-btn-press" hover-stay-time="80" bindtap="onConfirm">{{busy ? '请稍候…' : confirmText}}</view>
    <view hover-class="tap-press" hover-stay-time="80" class="ps-link" wx:if="{{quickText}}" bindtap="onQuick">{{quickText}}</view>
    <view hover-class="tap-press" hover-stay-time="80" class="ps-link ps-link-muted" wx:if="{{clearText}}" bindtap="onClear">{{clearText}}</view>
    <view hover-class="tap-press" hover-stay-time="80" class="ps-link ps-link-muted" bindtap="onClose">取消</view>
  </view>
</view>
