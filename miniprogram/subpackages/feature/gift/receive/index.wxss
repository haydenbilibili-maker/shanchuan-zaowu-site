page { background: var(--color-bg); color: #fff; }
.page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.checking {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
.muted { color: var(--color-text-secondary); font-size: var(--fs-26); text-align: center; line-height: 1.55; }
.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
}
.state-title { font-size: var(--fs-30); color: var(--color-text-body); font-weight: 500; }
.state-seal {
  width: 48rpx;
  height: 48rpx;
  border: 2px solid rgba(196, 167, 108, 0.45);
  border-radius: 50%;
  animation: seal-breathe 2.4s ease-in-out infinite;
}
@keyframes seal-breathe {
  0%, 100% { opacity: 0.45; transform: scale(0.96); }
  50% { opacity: 0.9; transform: scale(1); }
}

/* —— 送礼人等待 / 回执 —— */
.sender-stage {
  padding-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.sender-seal {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sender-seal-ring {
  position: absolute;
  inset: 0;
  border: 2px solid rgba(196, 167, 108, 0.5);
  border-radius: 50%;
  animation: seal-breathe 2.8s ease-in-out infinite;
}
.sender-stage.phase-waiting_open .sender-seal-ring,
.sender-stage.phase-waiting_address .sender-seal-ring,
.sender-stage.phase-waiting_pickup .sender-seal-ring {
  border-color: rgba(196, 167, 108, 0.65);
}
.sender-stage.phase-expired .sender-seal-ring {
  border-color: rgba(160, 154, 144, 0.45);
  animation: none;
  opacity: 0.7;
}
.sender-seal-glyph {
  font-family: var(--font-brand);
  font-size: var(--fs-40);
  color: var(--color-primary);
  letter-spacing: 0.04em;
}
.sender-stage .stage-over {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  letter-spacing: 0.14em;
  margin-bottom: 16rpx;
}
.sender-stage .stage-title {
  display: block;
  font-size: var(--fs-40);
  color: var(--color-text-primary);
  font-weight: 500;
  margin-bottom: 20rpx;
  line-height: 1.35;
}
.sender-desc {
  display: block;
  font-size: var(--fs-26);
  color: var(--color-text-secondary);
  line-height: 1.65;
  padding: 0 12rpx;
  margin-bottom: 40rpx;
}
.sender-specimen {
  width: 100%;
  margin-bottom: 8rpx;
}
.sender-actions {
  width: 100%;
  margin-top: 24rpx;
}
.sender-actions .share-btn {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 0;
  border: none;
  line-height: 88rpx;
}
.sender-actions .share-btn::after {
  border: none;
}
.sender-actions .btn-secondary {
  margin-bottom: 20rpx;
}

/* —— 礼盒开封仪式 —— */
.box-stage {
  padding-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stage-toolbar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.tool-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border: 1px solid rgba(77, 64, 26, 0.7);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
}
.icon-sound {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 1.5px solid var(--color-primary);
  box-sizing: border-box;
  position: relative;
}
.icon-sound.on::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: -4rpx 0 0 -4rpx;
  border-radius: 50%;
  background: var(--color-primary);
}
.icon-sound.off {
  opacity: 0.45;
  border-color: var(--color-text-muted);
}
.icon-sound.off::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 9rpx;
  width: 16rpx;
  height: 1.5px;
  background: var(--color-text-muted);
  transform: rotate(-42deg);
}
.tool-skip {
  font-size: var(--fs-22);
  color: var(--color-text-muted);
  letter-spacing: 0.04em;
  padding: 10rpx 8rpx;
}

.box-scene {
  position: relative;
  width: 560rpx;
  height: 500rpx;
  perspective: 1400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.box-glow {
  position: absolute;
  left: 50%;
  top: 42%;
  width: 420rpx;
  height: 280rpx;
  margin: -140rpx 0 0 -210rpx;
  background: radial-gradient(
    ellipse at center,
    rgba(196, 167, 108, 0.14) 0%,
    rgba(138, 117, 48, 0.06) 42%,
    transparent 72%
  );
  pointer-events: none;
  animation: glow-breathe 4.6s ease-in-out infinite;
}
.phase-seal .box-glow,
.phase-lid .box-glow,
.phase-done .box-glow {
  animation: none;
  opacity: 0.55;
}
@keyframes glow-breathe {
  0%, 100% { opacity: 0.72; transform: scale(0.98); }
  50% { opacity: 1; transform: scale(1.04); }
}
.box-shadow {
  position: absolute;
  bottom: 48rpx;
  left: 50%;
  width: 380rpx;
  height: 42rpx;
  margin-left: -190rpx;
  background: radial-gradient(ellipse at center, rgba(26, 24, 20, 0.72) 0%, transparent 74%);
  transition: transform 0.7s var(--ease-standard), opacity 0.7s var(--ease-standard);
}
.phase-lid .box-shadow,
.phase-done .box-shadow {
  transform: scaleX(1.1);
  opacity: 0.5;
}

.gift-box {
  position: relative;
  width: 400rpx;
  height: 288rpx;
  transform-style: preserve-3d;
  animation: box-idle 4.2s ease-in-out infinite;
}
.phase-seal .gift-box,
.phase-lid .gift-box,
.phase-done .gift-box {
  animation: none;
}
@keyframes box-idle {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-8rpx) scale(1.012); }
}

.box-inner {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 30rpx;
  bottom: 30rpx;
  background: linear-gradient(165deg, #F2EDE4 0%, #E8E0D2 100%);
  border-radius: var(--radius-sm);
  overflow: hidden;
  z-index: 1;
}
.inner-letter {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 36rpx;
  bottom: 36rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-sm);
  background: linear-gradient(180deg, #FAF6ED 0%, #F2EDE4 100%);
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  opacity: 0.55;
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard);
}
.phase-lid .inner-letter,
.phase-done .inner-letter {
  opacity: 1;
  transform: translateY(-8rpx);
}
.inner-line {
  height: 6rpx;
  background: rgba(138, 117, 48, 0.28);
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}
.inner-line.short { width: 55%; }
.inner-seal {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 40rpx;
  height: 40rpx;
  border: 1.5px solid rgba(196, 167, 108, 0.55);
  border-radius: 50%;
}

.box-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 186rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  z-index: 2;
  background:
    linear-gradient(118deg, rgba(224, 207, 163, 0.18) 0%, transparent 28%),
    linear-gradient(165deg, #9A7A4A 0%, #7A5F38 28%, #5C4528 62%, #3E2F1C 100%);
  border: 1px solid rgba(77, 64, 26, 0.92);
  box-sizing: border-box;
  box-shadow:
    inset 0 1px 0 rgba(224, 207, 163, 0.22),
    inset 0 -10rpx 18rpx rgba(26, 24, 20, 0.28);
}
.box-wood {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.box-wood.grain-a {
  opacity: 0.42;
  background:
    repeating-linear-gradient(
      93deg,
      transparent 0,
      transparent 9rpx,
      rgba(26, 24, 20, 0.16) 9rpx,
      rgba(26, 24, 20, 0.16) 11rpx,
      transparent 11rpx,
      transparent 22rpx,
      rgba(224, 207, 163, 0.07) 22rpx,
      rgba(224, 207, 163, 0.07) 23rpx
    );
}
.box-wood.grain-b {
  opacity: 0.28;
  background:
    radial-gradient(ellipse at 18% 40%, rgba(48, 40, 16, 0.22) 0%, transparent 42%),
    radial-gradient(ellipse at 82% 70%, rgba(26, 24, 20, 0.28) 0%, transparent 38%),
    repeating-linear-gradient(
      88deg,
      transparent 0,
      transparent 28rpx,
      rgba(138, 117, 48, 0.12) 28rpx,
      rgba(138, 117, 48, 0.12) 30rpx
    );
}
.box-bevel {
  position: absolute;
  inset: 8rpx;
  border: 1rpx solid rgba(224, 207, 163, 0.14);
  border-radius: var(--radius-sm);
  pointer-events: none;
}
.box-edge {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 14rpx;
  background: linear-gradient(180deg, rgba(224, 207, 163, 0.42), transparent);
}
.box-corner {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-radius: 3rpx;
  background: linear-gradient(135deg, #D4BC85 0%, #A8903C 48%, #6B5A24 100%);
  opacity: 0.85;
  z-index: 3;
}
.box-corner.tl { left: 14rpx; top: 14rpx; }
.box-corner.tr { right: 14rpx; top: 14rpx; }
.box-corner.bl { left: 14rpx; bottom: 14rpx; }
.box-corner.br { right: 14rpx; bottom: 14rpx; }
.box-plate {
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  transform: translateX(-50%);
  z-index: 7;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.55);
  border-radius: var(--radius-sm);
  background: linear-gradient(180deg, rgba(48, 40, 16, 0.82), rgba(26, 24, 20, 0.88));
  box-shadow:
    inset 0 1px 0 rgba(224, 207, 163, 0.22),
    0 2rpx 8rpx rgba(26, 24, 20, 0.35);
}
.plate-tagline {
  font-size: var(--fs-22);
  color: rgba(240, 230, 204, 0.95);
  letter-spacing: 0.12em;
  white-space: nowrap;
  font-family: var(--font-brand);
  font-weight: 500;
}

/* 封带：黄铜束带，勿大红；竖带止于铭牌上方 */
.ribbon-v,
.ribbon-h {
  z-index: 4;
  opacity: 0.96;
  overflow: hidden;
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard);
  box-shadow: 0 2rpx 8rpx rgba(26, 24, 20, 0.28);
}
.ribbon-v {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 78rpx;
  width: 36rpx;
  margin-left: -18rpx;
  border-radius: 0 0 4rpx 4rpx;
  background:
    linear-gradient(90deg,
      #4D401A 0%,
      #8A7530 18%,
      #E0CFA3 42%,
      var(--color-primary) 50%,
      #A8903C 58%,
      #6B5A24 82%,
      #302810 100%
    );
}
.ribbon-h {
  position: absolute;
  left: 0;
  right: 0;
  top: 52%;
  height: 36rpx;
  margin-top: -18rpx;
  background:
    linear-gradient(180deg,
      #4D401A 0%,
      #8A7530 18%,
      #E0CFA3 42%,
      var(--color-primary) 50%,
      #A8903C 58%,
      #6B5A24 82%,
      #302810 100%
    );
}
.ribbon-sheen {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    115deg,
    transparent 0%,
    transparent 38%,
    rgba(250, 246, 237, 0.28) 48%,
    transparent 58%,
    transparent 100%
  );
  animation: ribbon-sheen 5.2s ease-in-out infinite;
  pointer-events: none;
}
.phase-seal .ribbon-sheen,
.phase-lid .ribbon-sheen,
.phase-done .ribbon-sheen {
  animation: none;
}
@keyframes ribbon-sheen {
  0%, 100% { transform: translateX(-30%); opacity: 0.35; }
  50% { transform: translateX(30%); opacity: 0.7; }
}
.phase-seal .ribbon-v,
.phase-lid .ribbon-v,
.phase-done .ribbon-v {
  opacity: 0;
  transform: translateY(-24rpx) scaleY(0.2);
}
.phase-seal .ribbon-h,
.phase-lid .ribbon-h,
.phase-done .ribbon-h {
  opacity: 0;
  transform: scaleX(0.15);
}

/* 盒盖：铰链向上翻开 */
.box-lid {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 148rpx;
  z-index: 6;
  transform-origin: top center;
  transform: translateZ(0) rotateX(0deg);
  transition: transform 0.72s cubic-bezier(0.22, 0.61, 0.36, 1);
  transform-style: preserve-3d;
}
.lid-face {
  position: absolute;
  inset: 0;
  border-radius: 14rpx 14rpx 8rpx 8rpx;
  overflow: hidden;
  background:
    linear-gradient(118deg, rgba(224, 207, 163, 0.22) 0%, transparent 32%),
    linear-gradient(165deg, #B89A58 0%, #8B6F47 36%, #6B5435 68%, #4A3A24 100%);
  border: 1px solid rgba(77, 64, 26, 0.92);
  box-sizing: border-box;
  backface-visibility: hidden;
  box-shadow:
    inset 0 1px 0 rgba(250, 246, 237, 0.2),
    inset 0 -8rpx 16rpx rgba(26, 24, 20, 0.22);
}
.lid-wood {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.lid-wood.grain-a {
  opacity: 0.38;
  background:
    repeating-linear-gradient(
      89deg,
      transparent 0,
      transparent 11rpx,
      rgba(26, 24, 20, 0.15) 11rpx,
      rgba(26, 24, 20, 0.15) 13rpx
    );
}
.lid-wood.grain-b {
  opacity: 0.22;
  background:
    radial-gradient(ellipse at 70% 30%, rgba(250, 246, 237, 0.12) 0%, transparent 45%),
    repeating-linear-gradient(
      94deg,
      transparent 0,
      transparent 26rpx,
      rgba(138, 117, 48, 0.14) 26rpx,
      rgba(138, 117, 48, 0.14) 28rpx
    );
}
.lid-bevel {
  position: absolute;
  inset: 10rpx;
  border: 1rpx solid rgba(224, 207, 163, 0.16);
  border-radius: var(--radius-sm);
  pointer-events: none;
}
.lid-brass-line {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 22rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(224, 207, 163, 0.65), transparent);
  z-index: 2;
}
.lid-panel {
  position: absolute;
  left: 50%;
  top: 40rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 88%;
  opacity: 0.55;
  z-index: 2;
  pointer-events: none;
}
.lid-panel-en {
  font-size: var(--fs-18);
  color: rgba(250, 246, 237, 0.82);
  letter-spacing: 0.16em;
  font-weight: 500;
  white-space: nowrap;
  font-family: Georgia, 'Source Han Serif SC', serif;
}
.lid-inner {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #3A3228 0%, #2A241C 100%);
  transform: rotateX(180deg);
  backface-visibility: hidden;
  border-radius: var(--radius-md);
}
.phase-lid .box-lid,
.phase-done .box-lid {
  transform: translateZ(24rpx) rotateX(-118deg);
}
.phase-done .gift-box {
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard);
  opacity: 0.88;
}

/* 封缄展翅蝴蝶：subpackages/feature/gift/assets/gift-butterfly.gif（214×166 横幅） */
.brass-butterfly {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 216rpx;
  height: 168rpx;
  margin: -84rpx 0 0 -108rpx;
  z-index: 8;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard);
  animation: butterfly-idle 4.2s ease-in-out infinite;
  pointer-events: none;
}
.phase-seal .brass-butterfly,
.phase-lid .brass-butterfly,
.phase-done .brass-butterfly {
  animation: none;
  opacity: 0;
  transform: translateY(-36rpx) scale(1.06);
}
@keyframes butterfly-idle {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-4rpx) scale(1.02); }
}
.butterfly-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 150rpx;
  height: 110rpx;
  margin: -55rpx 0 0 -75rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(196, 167, 108, 0.2) 0%, transparent 72%);
  animation: butterfly-glow 4.2s ease-in-out infinite;
  pointer-events: none;
}
.phase-seal .butterfly-glow,
.phase-lid .butterfly-glow,
.phase-done .butterfly-glow {
  animation: none;
}
@keyframes butterfly-glow {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.55; }
}
.butterfly-img {
  position: relative;
  z-index: 2;
  width: 200rpx;
  height: 155rpx;
  transform: translateY(-4rpx);
}

.stage-copy {
  margin-top: 12rpx;
  text-align: center;
  padding: 0 16rpx;
  max-width: 560rpx;
}
.stage-over {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  letter-spacing: 0.16em;
  margin-bottom: 18rpx;
}
.stage-title {
  display: block;
  font-size: 38rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  font-family: var(--font-brand);
  margin-bottom: 16rpx;
  line-height: 1.4;
}
.stage-sub {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.5;
}
.tap-hint {
  margin-top: 40rpx;
  text-align: center;
  font-size: var(--fs-22);
  color: var(--color-text-muted);
  letter-spacing: 0.06em;
}

.letter {
  position: relative;
  padding: 48rpx 36rpx;
  background: #F2EDE4;
  border: 1px solid #E0CFA3;
  border-radius: var(--radius-md);
  min-height: 360rpx;
  overflow: hidden;
  animation: letter-reveal 0.55s ease-out;
}
@keyframes letter-reveal {
  0% { opacity: 0; transform: translateY(16rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
.letter-watermark {
  position: absolute;
  /* 圆心再偏出纸角，避免与署名叠心 */
  right: -56rpx;
  bottom: -64rpx;
  width: 220rpx;
  height: 220rpx;
  border: 18rpx solid rgba(26, 24, 20, 0.035);
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}
.letter-watermark::after {
  content: '';
  position: absolute;
  inset: 28rpx;
  border: 2px solid rgba(26, 24, 20, 0.04);
  border-radius: 50%;
}
.letter-over {
  display: block; font-size: var(--fs-20); color: #8A7530;
  letter-spacing: 0.14em; margin-bottom: 16rpx;
  position: relative; z-index: 2;
}
.letter-to {
  display: block;
  font-size: var(--fs-24);
  color: #6B5A24;
  letter-spacing: 0.06em;
  margin-bottom: 20rpx;
  font-family: var(--font-brand);
  position: relative;
  z-index: 2;
  opacity: 0;
  transform: translateY(6rpx);
  transition: opacity var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-standard);
}
.letter-to.shown {
  opacity: 1;
  transform: translateY(0);
}
.letter-body-wrap {
  position: relative;
  z-index: 2;
  min-height: 1.75em;
}
.letter-body {
  display: inline;
  font-size: var(--fs-30);
  color: #33302C;
  line-height: 1.75;
  font-family: Georgia, 'Source Han Serif SC', serif;
}
.letter-body.writing {
  color: #5C5346;
}
.letter-cursor {
  display: inline;
  font-size: var(--fs-28);
  line-height: 1.75;
  color: rgba(138, 117, 48, 0.35);
  font-family: var(--font-latin);
  margin-left: 2rpx;
  opacity: 0;
  vertical-align: baseline;
}
.letter-cursor.on {
  /* 极淡呼吸，避免狂闪廉价感 */
  animation: letter-cursor-soft 1.6s ease-in-out infinite;
}
@keyframes letter-cursor-soft {
  0%,
  100% {
    opacity: 0.12;
  }
  50% {
    opacity: 0.38;
  }
}
.letter-sig {
  display: block;
  margin-top: 36rpx;
  /* 上移并让出右下印章圆心，避免「山海」竖影叠字 */
  margin-bottom: 12rpx;
  padding-right: 76rpx;
  text-align: right;
  font-size: var(--fs-28);
  color: #8A7530;
  font-family: 'Times New Roman', Georgia, 'Source Han Serif SC', serif;
  font-style: italic;
  position: relative;
  z-index: 3;
  /* 标本纸晕边：压住底纹透字，不盖住纸面质感 */
  text-shadow:
    0 0 10rpx rgba(242, 237, 228, 0.95),
    0 0 18rpx rgba(242, 237, 228, 0.85);
  opacity: 0;
}
.letter-sig.shown {
  animation: letter-sig-in 0.65s ease forwards;
}
@keyframes letter-sig-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.seal-mark {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 56rpx;
  height: 56rpx;
  border: 1.5px solid rgba(196, 167, 108, 0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-16);
  color: var(--color-primary);
  letter-spacing: 0.06em;
  font-family: var(--font-brand);
  opacity: 0.32;
  z-index: 1;
  pointer-events: none;
}

.voice-rite {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--color-bg-card);
  border: 1rpx solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-md);
}
.voice-rite-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.voice-rite-label {
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  letter-spacing: 0.12em;
}
.voice-rite-hint {
  font-size: var(--fs-20);
  color: var(--color-text-secondary);
}
.voice-play {
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.06);
  font-size: var(--fs-26);
  color: var(--color-primary);
  box-sizing: border-box;
}
.voice-play.on {
  border-color: var(--color-primary);
  color: #E0CFA3;
}
.voice-play.busy {
  opacity: 0.55;
  pointer-events: none;
}
.voice-brass {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}
.voice-brass.pulse {
  animation: brass-pulse 1s ease-in-out infinite;
}
@keyframes brass-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.3); opacity: 0.65; }
}
.voice-dur {
  margin-left: auto;
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  font-family: var(--font-mono);
}

.specimen {
  display: flex; gap: 24rpx;
  margin-top: 32rpx; padding: 24rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
}
.specimen-img-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-elevated);
}
.specimen-img { width: 100%; height: 100%; display: block; background: var(--color-bg-elevated); }
.specimen-title { display: block; font-size: var(--fs-28); font-weight: 500; color: #fff; margin-bottom: 8rpx; }
.specimen-latin { display: block; font-size: var(--fs-22); color: var(--color-primary); font-style: italic; font-family: var(--font-latin); margin-bottom: 12rpx; }
.specimen-price {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-primary);
  font-family: var(--font-mono);
  margin-bottom: 8rpx;
}
.specimen-hint { display: block; font-size: var(--fs-22); color: var(--color-text-muted); }

.share-lock {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-md);
  text-align: center;
}
.share-lock-title {
  display: block;
  font-size: var(--fs-28);
  color: var(--color-text-body);
  font-weight: 500;
  margin-bottom: 12rpx;
}
.share-lock-desc {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.pickup-card {
  margin-bottom: 20rpx;
  padding: 32rpx 28rpx;
  background: var(--color-bg-card);
  border: 1rpx solid rgba(196, 167, 108, 0.4);
  border-radius: var(--radius-md);
  text-align: center;
}
.pickup-label {
  display: block;
  font-size: var(--fs-20);
  color: var(--color-text-muted);
  letter-spacing: 0.1em;
  margin-bottom: 16rpx;
}
.pickup-code {
  display: block;
  font-size: var(--fs-44);
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 0.12em;
  font-family: var(--font-mono);
  margin-bottom: 16rpx;
}
.pickup-hint {
  display: block;
  font-size: var(--fs-24);
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: 12rpx;
}
.pickup-copy {
  display: block;
  font-size: var(--fs-22);
  color: #8A7530;
}

.actions { margin-top: 48rpx; }
.btn-primary, .btn-done {
  height: 88rpx; display: flex; align-items: center; justify-content: center;
  background: var(--color-primary); color: var(--color-bg); font-size: var(--fs-30); font-weight: 500;
  border-radius: var(--radius-md); margin-bottom: 20rpx;
  letter-spacing: 0.02em;
  box-sizing: border-box;
}
.btn-primary-press {
  background: #A8903C !important;
}
.btn-done { background: var(--color-bg-elevated); color: var(--color-text-secondary); }

.addr-done {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  width: 100%;
}

.addr-masked {
  font-size: var(--fs-22);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.4;
}

.after-gift-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 28rpx;
  width: 100%;
}
.after-gift-actions .btn-primary {
  margin-bottom: 0;
}
.btn-secondary {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--color-primary);
  font-size: var(--fs-28);
  letter-spacing: 0.02em;
  border: 1rpx solid rgba(196, 167, 108, 0.42);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}
.btn-secondary-press {
  background: rgba(196, 167, 108, 0.12);
  border-color: rgba(196, 167, 108, 0.7);
}

.btn-ghost {
  height: 72rpx; display: flex; align-items: center; justify-content: center;
  color: var(--color-text-secondary); font-size: var(--fs-26);
}
.btn-ghost.state-cta {
  margin-top: 36rpx;
  min-width: 280rpx;
  padding: 0 32rpx;
  border: 1px solid rgba(96, 90, 80, 0.5);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.hero-plate {
  padding: 40rpx 32rpx; background: #F2EDE4; border: 1px solid #E0CFA3; border-radius: var(--radius-md);
}
.overline {
  display: block; font-size: var(--fs-20); color: #8A7530;
  letter-spacing: 0.14em; margin-bottom: 12rpx;
}
.title { display: block; font-size: var(--fs-40); color: #8A7530; font-weight: 600; margin-bottom: 16rpx; }
.desc { display: block; font-size: var(--fs-26); color: var(--color-text-muted); line-height: 1.65; }

/* 持有期服务卡：受礼人收下即持有人 */
.holder-card {
  margin-top: 40rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid var(--border-gold);
  border-radius: var(--radius-md);
  background: var(--primary-light);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.holder-over { font-size: var(--fs-20); color: var(--color-primary); letter-spacing: 4rpx; }
.holder-title { font-size: var(--fs-30); color: var(--color-text-primary); font-family: var(--font-brand); }
.holder-desc { font-size: var(--fs-24); color: var(--color-text-secondary); line-height: 1.6; }
.holder-actions { margin-top: 16rpx; display: flex; flex-direction: column; gap: 12rpx; }

/* 领取核验 */
 .verify-card{margin-bottom:24rpx;padding:32rpx 32rpx 28rpx;border:1rpx solid rgba(196,167,108,0.45);border-radius:var(--radius-lg);background:#1F1D1A;display:flex;flex-direction:column}
.verify-over{font-size:var(--fs-20);letter-spacing:6rpx;color:#C4A76C}
.verify-title{margin-top:10rpx;font-size:var(--fs-32);font-weight:600;color:#F3ECDD}
.verify-desc{margin:12rpx 0 28rpx;font-size:var(--fs-24);line-height:1.7;color:#B8AD98}
.verify-card .btn-primary.is-busy{opacity:0.6}
.verify-alt{margin-top:22rpx;text-align:center;font-size:var(--fs-26);color:#C4A76C}
.verify-error{margin-top:16rpx;text-align:center;font-size:var(--fs-24);color:#E8927C}
.claim-input{margin:0 0 20rpx;height:84rpx;padding:0 24rpx;border:2rpx solid rgba(196,167,108,0.45);border-radius:var(--radius-md);background:#2A2621;color:#F3ECDD;font-size:var(--fs-28)}
.claim-input.is-code{font-size:var(--fs-36);letter-spacing:10rpx}
.claim-ph{color:#7D7466;letter-spacing:0;font-size:var(--fs-24)}

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .state-seal,
  .sender-seal-ring,
  .box-glow,
  .gift-box,
  .ribbon-sheen,
  .brass-butterfly,
  .butterfly-glow,
  .letter-cursor.on,
  .voice-brass.pulse {
    animation: none;
  }
}
