# 复制为本目录下的 pay.env.local 后填写（pay.env.local 已 gitignore，勿提交）
#   cp scripts/pay.env.example scripts/pay.env.local
#
# 仅供本地核对与打印控制台操作指引；不会自动写入云端。
# 真实商户号请在「云开发控制台 → 云函数 → 环境变量」手动配置。
# 禁止把 WX_PAY_SUB_MCH_ID / AppSecret / API Key 写入 cloudbaserc.json 或小程序源码。

WX_PAY_SUB_MCH_ID=你的10位商户号mchid

# 生产禁止开启；不要取消下一行注释，也不要设为 1
# ALLOW_MOCK_PAY=0
