        "manager/purchase-orders/index",
        "framer/index",
        "about/index",
        "ar/index",
        "booking/index",
        "store-zone/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["business"]
    },
    "pages/custom/index": {
      "network": "all",
      "packages": ["business"]
    },
    "pages/store/index": {
      "network": "all",
      "packages": ["business"]
    },
    "pages/user/index": {
      "network": "all",
      "packages": ["business"]
    }
  },
  "requiredPrivateInfos": [
    "chooseAddress"
  ],
  "permission": {
    "scope.camera": {
      "desc": "用于 AR 试摆与 AI 标本鉴定拍照，将藏品或标本清晰摄入画面"
    },
    "scope.writePhotosAlbum": {
      "desc": "用于保存AR合成照片"
    }
  }
}
