.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  background: #1A1814;
  box-sizing: border-box;
}

.toolbar {
  margin-bottom: 20rpx;
}

.hint {
  font-size: 22rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.45);
}

.canvas-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.poster-canvas {
  width: 600rpx;
  height: 960rpx;
  background: #1A1814;
  border-radius: 12rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
}

.loading-inline {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: rgba(196, 167, 108, 0.85);
}

.spinner.small {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: #C4A76C;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
  background: rgba(255, 255, 255, 0.06);
  color: #e8e4dc;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: linear-gradient(90deg, #8A7530, #C4A76C);
  color: #1a1208;
  font-weight: 600;
}

.btn.ghost {
  border: 1rpx solid rgba(196, 167, 108, 0.3);
}

.btn[disabled] {
  opacity: 0.45;
}
