.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: radial-gradient(ellipse 80% 50% at 50% 0%, #1a1a22 0%, #1A1814 55%);
}

.hero {
  margin-bottom: 56rpx;
}

.hero-en {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.35em;
  color: rgba(196, 167, 108, 0.75);
  margin-bottom: 16rpx;
}

.hero-cn {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #f5f0e6;
  margin-bottom: 16rpx;
}

.hero-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.42);
  line-height: 1.5;
}

.free-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding: 20rpx 24rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1rpx solid rgba(196, 167, 108, 0.25);
  border-radius: 16rpx;
}

.free-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: #1A1814;
  background: #C4A76C;
  padding: 6rpx 14rpx;
  border-radius: 9999px;
}

.free-txt {
  font-size: 22rpx;
  color: rgba(213, 209, 200, 0.85);
  line-height: 1.45;
}

.hint-block {
  margin-bottom: 36rpx;
}

.hint-title {
  display: block;
  font-size: 22rpx;
  color: #A09A90;
  margin-bottom: 16rpx;
  letter-spacing: 0.08em;
}

.hint-scroll {
  width: 100%;
  white-space: nowrap;
}

.hint-inner {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.hint-chip {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #A09A90;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(38, 35, 32, 0.9);
  border-radius: 9999px;
}

.hint-chip.active {
  color: #C4A76C;
  background: rgba(196, 167, 108, 0.12);
  border-color: rgba(196, 167, 108, 0.4);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: linear-gradient(90deg, #A8903C 0%, #C4A76C 50%, #8A7530 100%);
  color: #1a1208;
  font-weight: 600;
}

.btn.ghost {
  background: rgba(255, 255, 255, 0.06);
  color: #e8e4dc;
  border: 1rpx solid rgba(196, 167, 108, 0.35);
}

.btn.link {
  background: transparent;
  color: rgba(196, 167, 108, 0.85);
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.btn[disabled] {
  opacity: 0.45;
}

.btn-ico {
  width: 40rpx;
  height: 40rpx;
}

.progress-wrap {
  margin-top: 40rpx;
}

.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #8d7340, #C4A76C);
  transition: width 0.2s ease;
}

.progress-txt {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-core {
  padding: 48rpx 56rpx;
  background: rgba(26, 26, 30, 0.95);
  border-radius: 20rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: #C4A76C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-txt {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.tips {
  margin-top: 64rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
}

.tip-title {
  display: block;
  font-size: 24rpx;
  color: #C4A76C;
  margin-bottom: 16rpx;
}

.tip-line {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  padding: 0 20rpx;
}

.step {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  padding: 8rpx 16rpx;
  border-radius: 9999px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.step.done {
  color: #C4A76C;
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.1);
}

.step-line {
  width: 40rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.12);
}

.step-line.done {
  background: rgba(196, 167, 108, 0.5);
}

.recent {
  margin-top: 48rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1px solid rgba(38, 35, 32, 0.8);
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.recent-title {
  font-size: 24rpx;
  color: #C4A76C;
}

.recent-link {
  font-size: 22rpx;
  color: #6B6560;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.recent-item:active {
  opacity: 0.85;
}

.recent-name {
  font-size: 26rpx;
  color: #D5D1C8;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.recent-time {
  font-size: 22rpx;
  color: #6B6560;
  flex-shrink: 0;
}
