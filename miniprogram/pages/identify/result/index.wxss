.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 100rpx;
  box-sizing: border-box;
  background: #1A1814;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: rgba(255, 255, 255, 0.55);
  font-size: 26rpx;
  gap: 24rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: #C4A76C;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.actions {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.act {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.act::after {
  border: none;
}

.act.primary {
  background: linear-gradient(90deg, #8A7530, #C4A76C);
  color: #1a1208;
  font-weight: 600;
}

.act.ghost {
  background: rgba(255, 255, 255, 0.06);
  color: #e8e4dc;
  border: 1rpx solid rgba(196, 167, 108, 0.3);
}

.act[disabled] {
  opacity: 0.45;
}

.retake-block {
  margin-top: 24rpx;
}

.retake-primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
  background: linear-gradient(90deg, #8A7530, #C4A76C);
  color: #1a1208;
  font-weight: 600;
}

.retake-primary::after {
  border: none;
}

.alt-strip {
  margin-top: 28rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.8);
}

.alt-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.alt-item {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.alt-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.alt-zh {
  display: block;
  font-size: 28rpx;
  color: #D5D1C8;
}

.alt-latin {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-style: italic;
  color: #C4A76C;
}

.fallback-block {
  margin-top: 32rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  border: 1rpx solid rgba(38, 35, 32, 0.8);
}

.fallback-tip {
  display: block;
  font-size: 24rpx;
  color: #A09A90;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.fallback-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.act.compact {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.product-strip {
  margin-top: 40rpx;
}

.strip-title {
  display: block;
  font-size: 24rpx;
  color: rgba(196, 167, 108, 0.85);
  letter-spacing: 0.12em;
  margin-bottom: 20rpx;
}

.strip-scroll {
  width: 100%;
  white-space: nowrap;
}

.strip-inner {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

.p-card {
  width: 200rpx;
  flex-shrink: 0;
}

.p-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #1a1a1a;
}

.p-name {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  white-space: normal;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.p-price {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #C4A76C;
  font-weight: 600;
  font-family: var(--font-mono, monospace);
}

.wiki-strip {
  margin-top: 32rpx;
}

.wiki-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: 16rpx;
}

.wiki-row:active {
  background: #262320;
}

.wiki-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #262320;
  flex-shrink: 0;
}

.wiki-meta {
  flex: 1;
  min-width: 0;
}

.wiki-title {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.wiki-latin {
  display: block;
  font-size: 22rpx;
  color: #C4A76C;
  font-style: italic;
  margin-top: 4rpx;
}

.wiki-brief {
  display: block;
  font-size: 22rpx;
  color: #6B6560;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wiki-arrow {
  color: #6B6560;
  font-size: 32rpx;
}

.foot-links {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: rgba(196, 167, 108, 0.75);
  padding-bottom: 24rpx;
}

.foot-links .dot {
  color: #4A4540;
}

.again {
  display: none;
}

.fb-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.fb-panel {
  width: 100%;
  max-width: 640rpx;
  padding: 36rpx 28rpx;
  background: #1a1a1e;
  border-radius: 20rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.25);
}

.fb-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #f5f0e6;
  margin-bottom: 12rpx;
}

.fb-tip {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: 24rpx;
}

.fb-input {
  height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  color: #e8e4dc;
  font-size: 28rpx;
}

.fb-area {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  color: #e8e4dc;
  font-size: 26rpx;
}

.fb-actions {
  display: flex;
  gap: 20rpx;
}

.fb-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.fb-btn::after {
  border: none;
}

.fb-btn.cancel {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.75);
}

.fb-btn.ok {
  background: linear-gradient(90deg, #8A7530, #C4A76C);
  color: #1a1208;
  font-weight: 600;
}
