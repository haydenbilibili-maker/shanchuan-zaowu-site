<view class="page">
  <view class="loading" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>加载中…</text>
  </view>

  <block wx:else>
    <species-card
      imageUrl="{{displayImage}}"
      speciesInfo="{{speciesInfo}}"
      aiContent="{{aiContent}}"
      confidenceLevel="{{confidenceLevel}}"
      showConfidence="{{true}}"
      rootCategoryTag="{{rootCategoryTag}}"
    />

    <!-- 备选物种 P1 -->
    <view class="alt-strip" wx:if="{{alternatives.length > 0}}">
      <text class="strip-title">也可能是</text>
      <view class="alt-list">
        <view class="alt-item" wx:for="{{alternatives}}" wx:key="species_name_zh">
          <text class="alt-zh">{{item.species_name_zh}}</text>
          <text class="alt-latin" wx:if="{{item.species_name_latin}}">{{item.species_name_latin}}</text>
        </view>
      </view>
    </view>

    <!-- 低置信度：重拍主行动 -->
    <view class="retake-block" wx:if="{{confidenceLevel === 'low' || speciesInfo.is_specimen === false}}">
      <button class="act retake-primary" bindtap="onRetake">重新拍摄</button>
    </view>

    <!-- 馆藏档案关联 -->
    <view class="wiki-strip" wx:if="{{relatedWiki.length > 0}}">
      <text class="strip-title">馆藏档案</text>
      <view
        class="wiki-row"
        wx:for="{{relatedWiki}}"
        wx:key="_id"
        bindtap="onWikiTap"
        data-id="{{item._id}}"
      >
        <image class="wiki-thumb" src="{{item.coverImage || displayImage}}" mode="aspectFill" />
        <view class="wiki-meta">
          <text class="wiki-title">{{item.title}}</text>
          <text class="wiki-latin" wx:if="{{item.latinName}}">{{item.latinName}}</text>
          <text class="wiki-brief" wx:if="{{item.brief}}">{{item.brief}}</text>
        </view>
        <text class="wiki-arrow">›</text>
      </view>
    </view>

    <!-- 相关商品 -->
    <view class="product-strip" wx:if="{{relatedProducts.length > 0}}">
      <text class="strip-title">相关藏品</text>
      <scroll-view scroll-x class="strip-scroll" enable-flex show-scrollbar="{{false}}">
        <view class="strip-inner">
          <view
            class="p-card"
            wx:for="{{relatedProducts}}"
            wx:key="_id"
            bindtap="onProductTap"
            data-id="{{item._id}}"
          >
            <image class="p-img" src="{{item.cover}}" mode="aspectFill" />
            <text class="p-name">{{item.title}}</text>
            <text class="p-price" wx:if="{{item.price}}">¥{{item.price}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 无关联兜底 -->
    <view class="fallback-block" wx:if="{{showFallback}}">
      <text class="fallback-tip">暂未匹配到馆藏档案或可购藏品，你可以浏览同类内容或咨询专员。</text>
      <view class="fallback-actions">
        <button class="act ghost compact" bindtap="onGoGallery">去馆藏看同类</button>
        <button class="act ghost compact" bindtap="onExpertHelp">鉴定疑问 · 联系专员</button>
      </view>
    </view>

    <view class="actions">
      <button class="act primary" bindtap="onSaveAtlas" disabled="{{saving || speciesInfo.is_specimen === false}}">
        {{bookmarked ? '已加入图鉴' : '保存到我的图鉴'}}
      </button>
      <button class="act ghost" bindtap="onGoGallery" wx:if="{{speciesInfo.is_specimen !== false}}">
        去馆藏看同类
      </button>
      <button class="act ghost" bindtap="onGoShare">分享鉴定海报</button>
      <button
        class="act ghost"
        wx:if="{{relatedProducts.length > 0}}"
        bindtap="onViewProducts"
      >查看相关商品</button>
      <button class="act ghost" bindtap="openFeedback" wx:if="{{recordId}}">识别纠错</button>
      <button class="act ghost" bindtap="onExpertHelp" wx:if="{{!showFallback}}">鉴定疑问</button>
    </view>

    <view class="foot-links">
      <text bindtap="onGoAtlas">我的自然图鉴</text>
      <text class="dot">·</text>
      <text bindtap="onRetake">再拍一张</text>
    </view>
  </block>

  <view class="fb-mask" wx:if="{{showFeedback}}" catchtap="closeFeedback">
    <view class="fb-panel" catchtap="noop">
      <text class="fb-title">识别纠错</text>
      <text class="fb-tip">帮助我们改进模型，请填写您认为更准确的中文名（可选填备注）。</text>
      <input
        class="fb-input"
        placeholder="您认为正确的中文名"
        value="{{feedbackZh}}"
        bindinput="onFeedbackZh"
      />
      <textarea
        class="fb-area"
        placeholder="补充说明（可选）"
        value="{{feedbackNote}}"
        bindinput="onFeedbackNote"
        maxlength="500"
      />
      <view class="fb-actions">
        <button class="fb-btn cancel" bindtap="closeFeedback">取消</button>
        <button class="fb-btn ok" bindtap="submitFeedback" loading="{{feedbackSubmitting}}">提交</button>
      </view>
    </view>
  </view>
</view>
