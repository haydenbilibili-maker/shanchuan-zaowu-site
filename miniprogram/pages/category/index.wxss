/* pages/category/index.wxss — 极简全宽布局 */
page { background-color: var(--color-bg); color: var(--color-text-primary, #FFFFFF); height: 100vh; width: 100%; overflow: hidden; overflow-x: hidden; }
view, text, image, scroll-view { box-sizing: border-box; }
.page-ency { height: 100%; width: 100%; max-width: 100%; position: relative; overflow-x: hidden; background-color: var(--color-bg); }
.grain-overlay { position: fixed; inset: 0; pointer-events: none; z-index: 1; opacity: 0.35; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E"); }

/* ===== 吸顶头部 ===== */
.sticky-header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(26,24,20,.98); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(38,35,32,.45); padding-bottom: 16rpx; pointer-events: none; }
.sticky-header .nav-row,
.sticky-header .search-row,
.sticky-header .category-wrap,
.sticky-header .sub-category-wrap,
.sticky-header .cat-pill,
.sticky-header .filter-entry,
.sticky-header .filter-entry-wrap,
.sticky-header .cat-filter-row,
.sticky-header .cat-filter-block { pointer-events: auto; }
.nav-row { padding: 16rpx 32rpx 4rpx; }
.nav-brand { display: flex; align-items: baseline; gap: 16rpx; }
.nav-title { font-size: 40rpx; font-weight: 600; color: var(--color-text-primary); letter-spacing: 0.08em; font-family: var(--font-brand, serif); }
.nav-sub { font-size: 22rpx; color: var(--color-text-muted); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.search-row { margin: 12rpx 32rpx 0; height: 72rpx; min-height: 72rpx; background: var(--color-bg-card); border: 1px solid rgba(38,35,32,.5); border-radius: 16rpx; display: flex; align-items: center; padding: 0 8rpx 0 24rpx; gap: 12rpx; overflow: hidden; flex-shrink: 0; }
.search-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; height: 100%; }
.search-main:active,
.search-main-press { opacity: 0.82; }
.search-identify { flex-shrink: 0; display: flex; align-items: center; gap: 6rpx; padding: 0 16rpx; height: 56rpx; border-radius: 12rpx; background: rgba(196,167,108,.12); border: 1px solid rgba(196,167,108,.35); transition: transform 0.16s ease, background 0.16s ease; }
.search-identify-active { opacity: 1; transform: scale(0.96); background: rgba(196,167,108,.2); }
.search-identify text { font-size: 22rpx; color: var(--gold); font-weight: 500; }
.search-identify-ico { width: 28rpx; height: 28rpx; }
.search-placeholder { font-size: 26rpx; color: var(--color-text-muted); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.2; }
.category-wrap { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; align-content: flex-start; gap: 12rpx 16rpx; padding: 12rpx 8rpx 8rpx 24rpx; box-sizing: border-box; }
.cat-filter-block { padding-bottom: 4rpx; }
.cat-filter-row { display: flex; align-items: flex-start; padding-right: 0; }
.sub-category-block { margin-top: 8rpx; padding: 0 24rpx 10rpx; border-top: 1px solid rgba(77,64,26,.35); }
.sub-category-head { display: flex; align-items: center; gap: 16rpx; padding: 10rpx 0 12rpx; }
.sub-category-label { font-size: 20rpx; font-weight: 500; color: var(--color-text-muted); letter-spacing: 0.14em; flex-shrink: 0; }
.sub-category-rule { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(77,64,26,.55) 0%, rgba(38,35,32,.2) 100%); }
.sub-category-wrap { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 8rpx 12rpx; }
.cat-pill-l1 { height: 56rpx; padding: 0 30rpx; }
.cat-pill-l1 text { font-size: 28rpx; font-weight: 500; letter-spacing: 0.04em; }
.cat-pill-l1.active { background: rgba(196,167,108,.18); border-color: var(--gold); box-shadow: 0 0 0 1px rgba(196,167,108,.12); }

/* 二级：小圆角 chip，弱对比，选中仅描边+字色 */
.cat-chip-l2 { display: inline-flex; align-items: center; justify-content: center; min-height: 44rpx; padding: 6rpx 18rpx; border-radius: 8rpx; background: var(--color-bg-card); border: 1px solid rgba(38,35,32,.85); max-width: 100%; }
.cat-chip-l2 text { font-size: 22rpx; color: var(--color-text-secondary); line-height: 1.25; }
.cat-chip-l2.active { background: rgba(196,167,108,.06); border-color: rgba(196,167,108,.45); }
.cat-chip-l2.active text { color: var(--gold); font-weight: 500; }
.cat-chip-l2-press { opacity: 0.88; transform: scale(0.98); }
.filter-entry-wrap { flex-shrink: 0; display: flex; align-items: flex-start; padding: 12rpx 20rpx 8rpx 12rpx; position: relative; z-index: 2; }
.filter-entry-wrap::before { content: ''; position: absolute; left: 0; top: 20rpx; bottom: 16rpx; width: 1px; background: rgba(77,64,26,.45); }
.filter-entry { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; padding: 0; border-radius: 9999px; background: var(--color-bg-elevated); border: 1px solid rgba(38,35,32,.9); position: relative; }
.filter-entry-ico { width: 36rpx; height: 36rpx; display: block; }
.filter-entry.on { background: rgba(196,167,108,.18); border-color: var(--gold); }
.filter-entry-press { transform: scale(0.96); opacity: 0.9; }
.filter-badge { position: absolute; top: -8rpx; right: -6rpx; min-width: 28rpx; height: 28rpx; padding: 0 6rpx; border-radius: 9999px; background: var(--gold); color: var(--color-bg); font-size: 18rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; line-height: 1; box-sizing: border-box; }
.filter-summary { margin-left: 16rpx; flex: 1; min-width: 0; font-size: 22rpx; color: var(--gold); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cat-pill { display: inline-flex; align-items: center; justify-content: center; height: 56rpx; padding: 0 28rpx; border-radius: 9999px; background: var(--color-bg-elevated); border: 1px solid rgba(38,35,32,.9); flex-shrink: 0; max-width: 100%; transition: transform 0.16s ease, border-color 0.16s ease; }
.cat-pill text { font-size: 26rpx; color: var(--color-text-secondary); white-space: nowrap; }
.cat-pill.active { background: rgba(196,167,108,.15); border-color: var(--gold); }
.cat-pill.active text { color: var(--gold); font-weight: 500; }
.cat-pill:active { opacity: 1; transform: scale(0.96); }
.cat-pill-press { opacity: 1; transform: scale(0.96); border-color: rgba(196,167,108,.55); }
.cat-pill-custom { border-color: rgba(196,167,108,.45); background: rgba(196,167,108,.08); }
.cat-pill-custom text { color: var(--gold); font-weight: 500; }

/* ===== 主滚动区 ===== */
.main-scroll { position: fixed; left: 0; right: 0; bottom: 0; z-index: 2; background: var(--color-bg); }
.feed-wrap { padding: 24rpx 24rpx 0; }
.scroll-bottom-pad { height: var(--tabbar-offset); }

/* ===== 区块标题 ===== */
.feed-block { margin-bottom: 40rpx; }
.block-head { display: flex; align-items: baseline; margin-bottom: 24rpx; padding: 0 8rpx 16rpx; border-bottom: 1px solid #4D401A; }
.block-title { font-size: 30rpx; font-weight: 500; color: var(--color-text-primary); letter-spacing: 0.08em; padding-left: 12rpx; border-left: 2rpx solid var(--gold); }
.block-meta { margin-left: auto; font-size: 22rpx; color: var(--color-text-muted); }
.block-swipe-hint { margin-left: 16rpx; font-size: 20rpx; color: var(--color-text-muted); letter-spacing: 0.04em; }

/* ===== 标本档案 · 单篇 swiper ===== */
.archive-block { margin-bottom: 16rpx; }
.archive-block .block-head { margin-bottom: 12rpx; }
.archive-swiper { width: 100%; height: 176rpx; }
.archive-swiper-item { box-sizing: border-box; padding-right: 12rpx; }
.archive-card { display: flex; align-items: center; gap: 16rpx; height: 152rpx; padding: 16rpx 20rpx; background: var(--color-bg-card); border: 1px solid rgba(38,35,32,.8); border-radius: 16rpx; box-sizing: border-box; overflow: hidden; transition: transform 0.22s ease, background 0.22s ease, border-color 0.22s ease; }
.archive-card-active { background: var(--color-bg-elevated); transform: scale(0.98); border-color: rgba(196,167,108,.4); }
.archive-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: var(--color-bg-elevated); flex-shrink: 0; }
.archive-body { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 6rpx; }
.archive-title { font-size: 28rpx; font-weight: 500; color: var(--color-text-primary); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.archive-enter { flex-shrink: 0; font-size: 36rpx; color: rgba(196,167,108,.45); line-height: 1; padding-left: 4rpx; }
.product-block { padding-top: 8rpx; border-top: none; margin-top: 8rpx; }
.product-block .block-head { margin-bottom: 16rpx; }

/* ===== 内容列表行（左图右文，保留供其它页复用） ===== */
.tag-type { display: inline-flex; align-items: center; align-self: flex-start; width: auto; box-sizing: border-box; font-size: 20rpx; color: var(--gold); padding: 4rpx 12rpx; border: 1px solid rgba(196,167,108,.35); border-radius: 8rpx; white-space: nowrap; line-height: 1.3; }
.content-latin { font-size: 22rpx; color: var(--gold); font-style: italic; margin-top: 6rpx; font-family: Georgia, serif; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ===== 商品双列网格 ===== */
.product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
/* 同行两卡等高（grid 拉伸）+ 信息区纵向，价格沉底对齐 */
.product-cell { display: flex; flex-direction: column; background: var(--color-bg-card); border: 1px solid rgba(38,35,32,.8); border-radius: 16rpx; overflow: hidden; transition: transform 0.22s ease, border-color 0.22s ease; }
.product-cell-press { transform: scale(0.98); border-color: rgba(196,167,108,.4); }
.product-cell:active { transform: scale(0.98); }
.product-cover { position: relative; flex-shrink: 0; width: 100%; aspect-ratio: 3 / 4; overflow: hidden; background: var(--color-bg-elevated); }
.product-cover .sb-wrap { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.product-cover-img { width: 100%; height: 100%; display: block; transition: filter 0.2s ease; }

/* 售罄：仅压暗图片区，不整卡发灰 */
.product-cell.is-soldout .product-cover-img { filter: grayscale(0.32) brightness(0.9); }
.soldout-veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(26,24,20,.32); pointer-events: none; z-index: 1; }
.soldout-stamp { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-18deg); z-index: 2; padding: 10rpx 26rpx; border: 2rpx solid rgba(196,167,108,.62); border-radius: 8rpx; background: rgba(26,24,20,.58); pointer-events: none; }
.soldout-stamp-text { font-size: 26rpx; font-weight: 600; letter-spacing: 0.2em; color: rgba(196,167,108,.92); }

.product-info { flex: 1; display: flex; flex-direction: column; padding: 16rpx; }
.product-name { font-size: 26rpx; color: var(--color-text-body); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 68rpx; }
/* 主题名：与首页「为你推荐」小卡同款（「」黄铜衬线，「 悬挂半字） */
.product-theme { margin-top: 6rpx; font-size: 22rpx; line-height: 32rpx; color: var(--brass-300); font-family: var(--font-brand); text-indent: -0.5em; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.product-latin { font-size: 20rpx; color: var(--gold); font-style: italic; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.product-craft-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.product-craft-tag { font-size: 18rpx; line-height: 1.3; font-weight: 500; letter-spacing: 0.04em; color: var(--color-text-secondary); background: rgba(196,167,108,.08); border: 1px solid rgba(77,64,26,.5); border-radius: 8rpx; padding: 2rpx 10rpx; white-space: nowrap; }
.product-foot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 12rpx; }
.product-price { font-size: 30rpx; color: var(--gold); font-weight: 600; font-family: var(--font-mono, monospace); }
.product-soldout { font-size: 20rpx; color: var(--color-text-secondary); letter-spacing: 0.08em; }

/* ===== 空态 / 加载 ===== */
.empty-tip {
  text-align: center;
  padding: 64rpx 24rpx;
  font-size: 24rpx;
  /* 2026-09-21 分子级审计：--color-text-muted 在不透明底 --color-bg-card 上仅 2.93（AA 需 4.5）
     → 与 ProductList / 首页空态统一到 --color-text-secondary（6.02） */
  color: var(--color-text-secondary);
  border: 1px dashed rgba(77,64,26,.45);
  border-radius: 16rpx;
}
.list-footer { text-align: center; padding: 32rpx; font-size: 24rpx; color: var(--color-text-secondary); }
.list-footer.muted { color: #4A4540; font-size: 22rpx; }
.skeleton-wrap { padding: 24rpx; }
.sk-line { height: 32rpx; background: var(--color-bg-elevated); border-radius: 8rpx; margin-bottom: 16rpx; }
.sk-line.short { width: 40%; }
.sk-card { height: 200rpx; background: var(--color-bg-elevated); border-radius: 16rpx; margin-bottom: 16rpx; }
.sk-shine { animation: sk-pulse 1.2s ease-in-out infinite; }
@keyframes sk-pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 0.85; }
}

/* ===== 整页错误态（分类树/首屏馆藏加载失败）===== */
/* 与 .main-scroll 同一定位（fixed + top 内联），保证替换内容区时不跳版 */
.page-error { position: fixed; left: 0; right: 0; bottom: 0; z-index: 2; background: var(--color-bg); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 60rpx 120rpx; }
.page-error-mark { width: 132rpx; height: 132rpx; border-radius: 50%; border: 1rpx solid var(--gold, #C4A76C); display: flex; align-items: center; justify-content: center; opacity: .55; }
.page-error-glyph { font-size: 30rpx; letter-spacing: .12em; color: var(--gold, #C4A76C); }
.page-error-title { margin-top: 44rpx; font-size: 32rpx; color: var(--color-text-primary); }
.page-error-desc { margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; text-align: center; color: var(--color-text-muted); }
.page-error-btn { margin-top: 44rpx; padding: 18rpx 60rpx; border-radius: 999rpx; border: 1rpx solid var(--gold, #C4A76C); font-size: 26rpx; color: var(--gold, #C4A76C); }
.page-error-btn-press { opacity: .7; }
