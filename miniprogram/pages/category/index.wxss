/* pages/category/index.wxss — 极简全宽布局 */

page {
  background-color: #1A1814;
  color: var(--color-text-primary, #FFFFFF);
  height: 100vh;
  overflow: hidden;
}

view, text, image, scroll-view { box-sizing: border-box; }

.page-ency {
  height: 100%;
  position: relative;
}

.grain-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  opacity: 0.35;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
}

/* ===== 吸顶头部 ===== */
.sticky-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(26, 24, 20, 0.98);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(38, 35, 32, 0.9);
  padding-bottom: 16rpx;
  pointer-events: none;
}

.sticky-header .nav-row,
.sticky-header .search-row,
.sticky-header .category-scroll,
.sticky-header .cat-pill {
  pointer-events: auto;
}

.nav-row {
  padding: 8rpx 32rpx 0;
}

.nav-brand {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  font-family: var(--font-brand, serif);
}

.nav-sub {
  font-size: 22rpx;
  color: #6B6560;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-row {
  margin: 12rpx 32rpx 0;
  height: 72rpx;
  min-height: 72rpx;
  background: #262320;
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 24rpx;
  gap: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.search-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 100%;
}

.search-main:active { opacity: 0.88; }

.search-identify {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 16rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: rgba(196, 167, 108, 0.12);
  border: 1px solid rgba(196, 167, 108, 0.35);
}

.search-identify-active { opacity: 0.85; }

.search-identify text {
  font-size: 22rpx;
  color: #C4A76C;
  font-weight: 500;
}

.search-identify-ico {
  width: 28rpx;
  height: 28rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #6B6560;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
}

.category-scroll {
  width: 100%;
  padding: 12rpx 24rpx 4rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 9999px;
  background: #262320;
  border: 1px solid rgba(38, 35, 32, 0.9);
  flex-shrink: 0;
}

.cat-pill text {
  font-size: 26rpx;
  color: #A09A90;
  white-space: nowrap;
}

.cat-pill.active {
  background: rgba(196, 167, 108, 0.15);
  border-color: #C4A76C;
}

.cat-pill.active text {
  color: #C4A76C;
  font-weight: 500;
}

.cat-pill-custom {
  border-color: rgba(196, 167, 108, 0.45);
  background: rgba(196, 167, 108, 0.08);
}

.cat-pill-custom text {
  color: #C4A76C;
  font-weight: 500;
}

.cat-scroll-pad {
  width: 16rpx;
  flex-shrink: 0;
  display: inline-block;
}

/* ===== 主滚动区 ===== */
.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  background: #1A1814;
}

.feed-wrap {
  padding: 16rpx 24rpx 0;
}

.scroll-bottom-pad {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* ===== 区块标题 ===== */
.feed-block {
  margin-bottom: 40rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  padding-left: 16rpx;
  border-left: 4rpx solid #C4A76C;
}

.block-meta {
  margin-left: auto;
  font-size: 22rpx;
  color: #6B6560;
}

.block-swipe-hint {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #6B6560;
  letter-spacing: 0.04em;
}

/* ===== 标本档案 · 单篇 swiper ===== */
.archive-block {
  margin-bottom: 16rpx;
}

.archive-block .block-head {
  margin-bottom: 12rpx;
}

.archive-swiper {
  width: 100%;
  height: 200rpx;
}

.archive-swiper-item {
  box-sizing: border-box;
  padding-right: 12rpx;
}

.archive-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 152rpx;
  padding: 16rpx 20rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: 16rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.archive-card-active {
  background: #262320;
}

.archive-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #262320;
  flex-shrink: 0;
}

.archive-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.archive-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.archive-enter {
  flex-shrink: 0;
  font-size: 36rpx;
  color: rgba(196, 167, 108, 0.45);
  line-height: 1;
  padding-left: 4rpx;
}

.product-block {
  padding-top: 0;
  border-top: none;
  margin-top: 0;
}

.product-block .block-head {
  margin-bottom: 16rpx;
}

/* ===== 内容列表行（左图右文，保留供其它页复用） ===== */
.content-row {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: 16rpx;
}

.content-row-active {
  background: #262320;
}

.content-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #262320;
  flex-shrink: 0;
}

.content-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.content-tags {
  margin-bottom: 8rpx;
}

.tag-type {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  width: fit-content;
  max-width: 100%;
  box-sizing: border-box;
  font-size: 20rpx;
  line-height: 1.3;
  color: #C4A76C;
  padding: 4rpx 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 8rpx;
  white-space: nowrap;
  background: rgba(196, 167, 108, 0.06);
}

.content-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.content-latin {
  font-size: 22rpx;
  color: #C4A76C;
  font-style: italic;
  margin-top: 6rpx;
  font-family: Georgia, serif;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-brief {
  font-size: 24rpx;
  color: #6B6560;
  margin-top: 8rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.content-cta {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.content-cta text:first-child {
  font-size: 22rpx;
  color: #C4A76C;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cta-arrow {
  color: #6B6560;
  font-size: 28rpx;
}

/* ===== 商品双列网格 ===== */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.product-cell {
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: 16rpx;
  overflow: hidden;
}

.product-cell:active {
  opacity: 0.9;
}

.product-img {
  width: 100%;
  height: 320rpx;
  background: #262320;
  display: block;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 68rpx;
}

.product-latin {
  font-size: 20rpx;
  color: #6B6560;
  font-style: italic;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product-price {
  font-size: 30rpx;
  color: #C4A76C;
  font-weight: 600;
  font-family: var(--font-mono, monospace);
}

.product-soldout {
  font-size: 20rpx;
  color: #D64045;
}

/* ===== 空态 / 加载 ===== */
.empty-tip {
  text-align: center;
  padding: 48rpx 0;
  font-size: 24rpx;
  color: #6B6560;
}

.list-footer {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #A09A90;
}

.list-footer.muted {
  color: #4A4540;
  font-size: 22rpx;
}

.skeleton-wrap {
  padding: 24rpx;
}

.sk-line {
  height: 32rpx;
  background: #262320;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.sk-line.short { width: 40%; }

.sk-card {
  height: 200rpx;
  background: #262320;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.sk-shine {
  animation: sk-pulse 1.2s ease-in-out infinite;
}

@keyframes sk-pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 0.85; }
}
