<!--pages/category/index.wxml-->
<wxs src="../../utils/latinDisplay.wxs" module="latin" />
<view class="page-ency">
  <view class="grain-overlay"></view>

  <!-- 吸顶：标题 + 搜索 + 品类 -->
  <view class="sticky-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-row">
      <view class="nav-brand">
        <text class="nav-title">馆藏</text>
        <text class="nav-sub" wx:if="{{!listLoading}}">{{currentSubtitle}}</text>
      </view>
    </view>
    <view class="search-row">
      <view class="search-main" bindtap="goSearch" hover-class="search-main-press" hover-stay-time="80">
        <icon type="search" size="14" color="#6B6560"></icon>
        <text class="search-placeholder">{{keyword || '搜索藏品与档案'}}</text>
      </view>
      <view class="search-identify" bindtap="goIdentify" hover-class="search-identify-active" hover-stay-time="80" wx:if="{{showAiIdentify}}">
        <image class="search-identify-ico" src="/assets/icons/camera.png" mode="aspectFit" />
        <text>AI 鉴定</text>
      </view>
    </view>
    <view class="cat-filter-block">
      <view class="cat-filter-row">
        <view class="category-wrap">
          <view
            class="cat-pill cat-pill-l1 {{currentId === item._id ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="_id"
            bindtap="switchCategory"
            data-item="{{item}}"
            hover-class="cat-pill-press"
            hover-stay-time="80"
          >
            <text>{{item.shortName}}</text>
          </view>
          <view class="cat-pill cat-pill-custom" bindtap="goCustom" hover-class="cat-pill-press" hover-stay-time="80" wx:if="{{showSpecimenCustom}}">
            <text>定制</text>
          </view>
        </view>
        <view class="filter-entry-wrap">
          <view
            class="filter-entry {{filterActiveCount > 0 ? 'on' : ''}}"
            bindtap="openFilterPanel"
            hover-class="filter-entry-press"
            hover-stay-time="80"
            aria-role="button"
            aria-label="筛选"
          >
            <image
              class="filter-entry-ico"
              src="{{filterActiveCount > 0 ? '/assets/icons/filter-on.png' : '/assets/icons/filter.png'}}"
              mode="aspectFit"
              aria-hidden="true"
            />
            <view class="filter-badge" wx:if="{{filterActiveCount > 0}}">{{filterActiveCount}}</view>
          </view>
        </view>
      </view>
      <view class="sub-category-block" wx:if="{{subCategories.length && currentId !== 'all'}}">
        <view class="sub-category-head">
          <text class="sub-category-label">{{subRowLabel}}</text>
          <view class="sub-category-rule"></view>
        </view>
        <view class="sub-category-wrap">
          <view
            class="cat-chip-l2 {{!currentSubId ? 'active' : ''}}"
            bindtap="switchSubCategory"
            data-id=""
            hover-class="cat-chip-l2-press"
            hover-stay-time="80"
          >
            <text>本馆全部</text>
          </view>
          <view
            class="cat-chip-l2 {{currentSubId === item._id ? 'active' : ''}}"
            wx:for="{{subCategories}}"
            wx:key="_id"
            bindtap="switchSubCategory"
            data-id="{{item._id}}"
            data-name="{{item.name}}"
            hover-class="cat-chip-l2-press"
            hover-stay-time="80"
          >
            <text>{{item.displayName}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 主内容区 -->
  <!-- 整页错误态：分类树或首屏馆藏加载失败（区分「加载失败」与「该品类档案筹备中」） -->
  <view class="page-error" wx:if="{{pageError}}" style="top: {{headerHeight}}px;">
    <view class="page-error-mark">
      <text class="page-error-glyph">山海</text>
    </view>
    <text class="page-error-title">馆藏暂时无法抵达</text>
    <text class="page-error-desc">{{pageErrorMsg}}</text>
    <view class="page-error-btn" bindtap="onRetryLoad" hover-class="page-error-btn-press" hover-stay-time="80">重新加载</view>
  </view>

  <scroll-view
    wx:else
    scroll-y
    class="main-scroll"
    style="top: {{headerHeight}}px;"
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation
    bindscrolltolower="onFeedScrollToLower"
    lower-threshold="120"
  >
    <view class="skeleton-wrap" wx:if="{{listLoading}}">
      <view class="sk-line sk-shine"></view>
      <view class="sk-line sk-shine short"></view>
      <view class="sk-card sk-shine"></view>
      <view class="sk-card sk-shine"></view>
    </view>

    <view class="feed-wrap" wx:else>
      <!-- A 区：标本档案（首屏仅突出最新一篇，横滑查看更多） -->
      <view class="feed-block archive-block" wx:if="{{showSpecimenArchive && (showContentSection || contentItems.length)}}">
        <view class="block-head">
          <text class="block-title">标本档案</text>
          <text class="block-swipe-hint" wx:if="{{contentTotal > 1}}">左滑更多</text>
          <text class="block-meta" wx:if="{{contentTotal > 0}}">{{contentTotal}} 篇</text>
        </view>

        <swiper
          wx:if="{{contentItems.length}}"
          class="archive-swiper"
          indicator-dots="{{contentTotal > 1}}"
          indicator-color="rgba(255,255,255,0.15)"
          indicator-active-color="#C4A76C"
          next-margin="48rpx"
          bindchange="onArchiveSwiperChange"
        >
          <swiper-item wx:for="{{contentItems}}" wx:key="_id" class="archive-swiper-item">
            <view class="archive-card" hover-class="archive-card-active" bindtap="goToWikiDetail" data-id="{{item._id}}">
              <image class="archive-thumb" src="{{item.coverImage || fallbackImg}}" mode="aspectFill" lazy-load binderror="onFeedImageError" data-kind="content" data-id="{{item._id}}"></image>
              <view class="archive-body">
                <view class="tag-type">{{item.typeLabel}}</view>
                <text class="archive-title">{{item.title}}</text>
                <text class="content-latin" wx:if="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
              </view>
              <text class="archive-enter">›</text>
            </view>
          </swiper-item>
        </swiper>

        <view class="empty-tip" wx:if="{{contentItems.length === 0}}">该品类档案筹备中</view>
      </view>

      <!-- B 区：可购藏品 -->
      <view id="productBlock" class="feed-block product-block" wx:if="{{orphanProducts.length || !showContentSection || filterActiveCount > 0}}">
        <view class="block-head">
          <text class="block-title">{{showContentSection ? '本类可购' : '可购藏品'}}</text>
          <text class="filter-summary" wx:if="{{filterSummary}}" bindtap="openFilterPanel">{{filterSummary}}</text>
          <text class="block-meta" wx:if="{{orphanTotal >= 0 && (filterActiveCount > 0 || orphanTotal > 0)}}">{{orphanTotal}} 件</text>
        </view>

        <view class="product-grid">
          <view
            class="product-cell {{item.soldOut ? 'is-soldout' : ''}}"
            wx:for="{{orphanProducts}}"
            wx:key="_id"
            bindtap="goToProductFromFeed"
            data-id="{{item._id}}"
            hover-class="product-cell-press"
            hover-stay-time="80"
          >
            <view class="product-cover">
              <sensitive-blur-gate
                enabled="{{item.sensitiveBlur}}"
                product-id="{{item._id}}"
                size="card"
              >
                <image
                  class="product-cover-img"
                  src="{{item.displayImage || fallbackImg}}"
                  mode="aspectFill"
                  lazy-load
                  binderror="onFeedImageError"
                  data-kind="product"
                  data-id="{{item._id}}"
                ></image>
              </sensitive-blur-gate>
              <view class="soldout-veil" wx:if="{{item.soldOut}}"></view>
              <view class="soldout-stamp" wx:if="{{item.soldOut}}">
                <text class="soldout-stamp-text">售罄</text>
              </view>
            </view>
            <view class="product-info">
              <text class="product-name">{{item.title}}</text>
              <text class="product-theme" wx:if="{{item.themeName}}">「{{item.themeName}}」</text>
              <text class="product-latin" wx:if="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
              <view class="product-craft-tags" wx:if="{{item.craftTags && item.craftTags.length}}">
                <text class="product-craft-tag" wx:for="{{item.craftTags}}" wx:for-item="tag" wx:key="key">{{tag.label}}</text>
              </view>
              <view class="product-foot">
                <text class="product-price">¥{{item.price}}</text>
                <text class="product-soldout" wx:if="{{item.soldOut}}">售罄</text>
              </view>
            </view>
          </view>
        </view>

        <view class="empty-tip" wx:if="{{orphanProducts.length === 0}}">暂无可购藏品</view>
      </view>

      <view class="list-footer" wx:if="{{loadingMore}}">加载中…</view>
      <view class="list-footer muted" wx:elif="{{!hasMoreContent && !hasMoreProducts && (contentItems.length || orphanProducts.length)}}">— 已经到底了 —</view>
    </view>

    <view class="scroll-bottom-pad"></view>
  </scroll-view>
  <easter-egg-note id="easterEggNote" />
  <product-filter-panel
    visible="{{filterPanelVisible}}"
    root-name="{{filterRootName}}"
    category-options="{{filterCategoryOptions}}"
    applied="{{appliedFilters}}"
    bindclose="closeFilterPanel"
    bindconfirm="onFilterConfirm"
  />
</view>
