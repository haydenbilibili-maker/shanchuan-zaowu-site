<!--pages/detail/wiki-detail.wxml-->
<view class="container">
  
  <!-- 1. 沉浸式 Header -->
  <view class="hero-area">
    <image class="hero-img" src="{{wiki.coverImage || fallbackImg}}" mode="aspectFill"></image>
    <view class="hero-overlay"></view>
    
    <view class="hero-text">
      <!-- 区分显示：如果是标本，显示拉丁名；如果是专题，显示副标题或日期 -->
      <text class="latin-lg" wx:if="{{wiki.type !== 'exhibition'}}">{{wiki.latinName}}</text>
      <text class="latin-lg" wx:else>{{wiki.subtitle || 'CURATED EXHIBITION'}}</text>
      
      <text class="name-lg">{{wiki.commonName || wiki.title}}</text>
      
      <!-- 仅标本显示分类学 -->
      <view class="taxonomy-row" wx:if="{{wiki.type !== 'exhibition'}}">
         <text class="tax-tag">{{wiki.taxonomy.kingdom || 'ANIMALIA'}}</text>
         <text class="divider">/</text>
         <text class="tax-tag">{{wiki.taxonomy.class || 'INSECTA'}}</text>
      </view>
    </view>

    <view class="back-btn" style="top: {{statusBarHeight + 10}}px" bindtap="goBack">
      <text style="margin-bottom:4rpx;">←</text>
    </view>
  </view>

  <!-- 2. 正文内容 -->
  <view class="article-body">
    
    <!-- 导语/摘要 -->
    <view class="intro-text" wx:if="{{wiki.brief}}">
      <text>“{{wiki.brief}}”</text>
    </view>

    <!-- 画廊 (标本模式显示) -->
    <scroll-view scroll-x class="gallery-scroll" wx:if="{{wiki.type !== 'exhibition' && wiki.gallery && wiki.gallery.length > 0}}">
      <block wx:for="{{wiki.gallery}}" wx:key="*this">
        <view class="gallery-item" bindtap="previewImage" data-src="{{item}}">
           <image src="{{item}}" mode="aspectFill"></image>
        </view>
      </block>
    </scroll-view>

    <!-- 富文本内容 (通用) -->
    <view class="rich-text-container">
      <mp-html 
        content="{{articleContent}}" 
        tag-style="{{tagStyle}}" 
        container-style="color:#ccc;"
      />
    </view>

  </view>

  <!-- 3. 关联藏品 -->
  <view class="commerce-float" wx:if="{{displayProducts.length > 0}}">
    <view class="commerce-title">
      <text>{{ usingAlternative ? 'CATEGORY PICKS' : (wiki.type === 'exhibition' ? 'FEATURED ITEMS' : 'RELATED COLLECTION') }}</text>
      <text class="sub">{{ usingAlternative ? '关联藏品暂不可购，同品类推荐' : (wiki.type === 'exhibition' ? '展品列表' : '馆藏关联') }}</text>
    </view>

    <block wx:for="{{displayProducts}}" wx:key="_id">
      <view class="product-card-mini" bindtap="goToProduct" data-id="{{item._id}}">
        <image src="{{item.images[0]}}" mode="aspectFill" class="p-thumb"></image>
        <view class="p-info">
          <text class="p-name">{{item.title}}</text>
          <text class="p-latin">{{item.latinName}}</text>
          <text class="p-price">¥{{item.price}}</text>
        </view>
        <view class="btn-buy">选购</view>
      </view>
    </block>
  </view>

  <view class="bottom-bar safe-area" wx:if="{{primaryProduct}}">
    <view class="bottom-price">
      <text class="bp-label">馆藏价</text>
      <text class="bp-num">¥{{primaryProduct.price}}</text>
    </view>
    <view class="bottom-buy" bindtap="handleBuyNow">立即购买</view>
  </view>

  <view style="height: 140rpx;"></view>
</view>