/* pages/detail/index.wxss */

/* 1. 全局容器控制：彻底防止左右溢出 */
page {
  background-color: #1A1814;
  color: #ffffff;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  width: 100%;
  overflow-x: hidden; /* 🔴 核心：禁止横向滚动 */
  
  /* 🔴 核心：底部留白 = 底部栏高度 + 安全区 + 间距 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

view, text, image { box-sizing: border-box; }

/* 顶部导航 */
.nav-bar-wrap {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 120;
  transition: background 0.2s;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  box-sizing: border-box;
}
.nav-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0 12px;
}
.nav-right-group {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  margin-left: auto;
}

/* 导航圆形按钮 — 使用 px 与胶囊对齐，分享按钮须 plain + 重置默认 min-height */
.nav-icon-btn {
  width: 32px;
  height: 32px;
  min-width: 32px;
  min-height: 32px;
  max-width: 32px;
  max-height: 32px;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 0;
  box-sizing: border-box;
  background: rgba(31, 29, 26, 0.88);
  border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: visible;
  flex-shrink: 0;
}

button.nav-share-btn {
  /* 覆盖微信 button 默认样式，防止撑成大椭圆 */
  padding: 0;
  margin: 0;
  min-height: 32px;
  line-height: 32px;
  font-weight: normal;
  color: inherit;
  background: rgba(31, 29, 26, 0.88);
}
button.nav-share-btn::after { display: none; border: none; }
.nav-share-hover { background: rgba(196, 167, 108, 0.25) !important; opacity: 1; }

.nav-action-icon {
  width: 18px;
  height: 18px;
  display: block;
  filter: brightness(0) invert(1);
  opacity: 0.92;
  pointer-events: none;
}

.cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 16px;
  height: 16px;
  line-height: 16px;
  padding: 0 4px;
  background: #D64045;
  color: #fff;
  font-size: 10px;
  text-align: center;
  border-radius: 9999px;
  font-weight: 600;
  z-index: 1;
}

/* 吸顶 Tab */
.sticky-tabs {
  position: fixed;
  left: 0;
  width: 100%;
  z-index: 110;
  display: flex;
  background: rgba(26,24,20,0.96);
  border-bottom: 1px solid rgba(38,35,32,0.8);
  transform: translateY(-100%);
  opacity: 0;
  transition: transform 0.25s, opacity 0.25s;
  backdrop-filter: blur(12px);
}
.sticky-tabs.visible { transform: translateY(0); opacity: 1; }
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6B6560;
  position: relative;
}
.tab-item.active { color: #C4A76C; font-weight: 500; }
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #C4A76C;
  border-radius: 2rpx;
}
.tab-count { font-size: 22rpx; margin-left: 4rpx; }

.back-icon {
  flex-shrink: 0;
}
.back-arrow {
  font-size: 18px;
  line-height: 1;
  color: #fff;
  font-weight: 500;
}

/* Hero 轮播 */
.hero-wrapper { position: relative; width: 100%; height: 750rpx; margin-top: 0; }
.hero-swiper { width: 100%; height: 100%; }
.slide-image { width: 100%; height: 100%; }
.img-counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 4;
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 9999px;
}
.hero-overlay {
  position: absolute; bottom: 0; left: 0; width: 100%; height: 30%;
  background: linear-gradient(to bottom, transparent, #1A1814);
  pointer-events: none;
}

/* 内容区 */
.content-body {
  padding: 0 24rpx;
  position: relative;
  z-index: 3;
  width: 100%;
}

/* 电商主卡片 */
.commerce-card {
  background: #1F1D1A;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1px solid rgba(38,35,32,0.8);
  margin-bottom: 24rpx;
}
.price-block { margin-bottom: 24rpx; }
.stock-row { margin-top: 8rpx; }
.stock-label { font-size: 22rpx; color: #A09A90; }
.stock-label.warn { color: #E9A23B; }
.stock-label.soldout { color: #D64045; }

.title-block { margin-bottom: 24rpx; }
.tags-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.tag-item {
  font-size: 20rpx;
  background: rgba(196, 167, 108, 0.12);
  color: #C4A76C;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(196, 167, 108, 0.35);
}
.tag-item.treasure { border-color: #C4A76C; }
.tag-item.one-of-a-kind {
  background: rgba(214, 64, 69, 0.12);
  color: #D64045;
  border-color: rgba(214, 64, 69, 0.4);
}
.title-main { font-size: 36rpx; font-weight: 600; color: #fff; line-height: 1.4; display: block; }
.latin-sub { font-size: 24rpx; color: #C4A76C; font-style: italic; margin-top: 8rpx; display: block; font-family: Georgia, serif; }

.service-row {
  display: flex;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1px solid rgba(38,35,32,0.8);
  flex-wrap: wrap;
}
.service-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #A09A90;
}
.service-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C4A76C;
}

/* 信息行 */
.info-rows {
  background: #1F1D1A;
  border-radius: 16rpx;
  border: 1px solid rgba(38,35,32,0.8);
  margin-bottom: 24rpx;
  overflow: hidden;
}
.info-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1px solid rgba(38,35,32,0.6);
}
.info-row:last-child { border-bottom: none; }
.info-row:active { background: rgba(255,255,255,0.03); }
.info-row.muted .info-value { color: #6B6560; font-size: 22rpx; }
.info-label { width: 80rpx; font-size: 26rpx; color: #6B6560; flex-shrink: 0; }
.info-value { flex: 1; font-size: 26rpx; color: #D5D1C8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-value.gold { color: #C4A76C; }
.info-arrow { color: #6B6560; font-size: 32rpx; margin-left: 8rpx; }

/* 标本养护摘要条 */
.care-strip {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
  background: #1F1D1A;
  border: 1px solid rgba(38, 35, 32, 0.85);
  border-radius: 16rpx;
  overflow: hidden;
}
.care-strip:active { opacity: 0.92; }
.care-strip-accent {
  width: 6rpx;
  flex-shrink: 0;
  background: #C4A76C;
}
.care-strip-main {
  flex: 1;
  min-width: 0;
  padding: 24rpx 20rpx;
}
.care-strip-overline {
  display: block;
  font-size: 18rpx;
  color: #C4A76C;
  letter-spacing: 0.1em;
  margin-bottom: 8rpx;
}
.care-strip-summary {
  display: block;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.5;
  margin-bottom: 10rpx;
}
.care-strip-tag {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 0.04em;
}
.care-strip-cta {
  align-self: center;
  flex-shrink: 0;
  padding-right: 24rpx;
  font-size: 24rpx;
  color: #C4A76C;
}

/* 优惠券条 */
.coupon-strip {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, rgba(196,167,108,0.12), rgba(196,167,108,0.04));
  border: 1px solid rgba(196, 167, 108, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.coupon-strip:active { opacity: 0.85; }
.coupon-strip-label {
  font-size: 24rpx;
  color: #C4A76C;
  font-weight: 500;
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.4);
  border-radius: 8rpx;
}
.coupon-strip-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  height: 48rpx;
  display: flex;
  align-items: center;
}
.coupon-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  background: rgba(196, 167, 108, 0.15);
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #C4A76C;
  flex-shrink: 0;
}
.coupon-tag.highlight {
  background: rgba(214, 64, 69, 0.12);
  border-color: rgba(214, 64, 69, 0.35);
  color: #E9A23B;
}
.coupon-strip-action {
  font-size: 24rpx;
  color: #A09A90;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 优惠券弹层 */
.coupon-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 210;
  display: flex;
  align-items: flex-end;
}
.coupon-panel {
  width: 100%;
  max-height: 70vh;
  background: #1F1D1A;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}
.coupon-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1px solid rgba(38,35,32,0.8);
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}
.coupon-panel-body {
  flex: 1;
  max-height: 50vh;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}
.coupon-section-title {
  font-size: 24rpx;
  color: #6B6560;
  margin: 16rpx 0 20rpx;
}
.coupon-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #262320;
  border: 1px solid rgba(38,35,32,0.8);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.coupon-card.active {
  border-color: rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.08);
}
.coupon-card-left { flex: 1; min-width: 0; }
.coupon-card-value {
  display: block;
  font-size: 32rpx;
  color: #C4A76C;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.coupon-card-title {
  font-size: 24rpx;
  color: #A09A90;
}
.coupon-card-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 12rpx 28rpx;
  background: #C4A76C;
  color: #1A1814;
  border-radius: 9999px;
  font-size: 24rpx;
  font-weight: 500;
}
.coupon-card-btn.claimed {
  background: transparent;
  border: 1px solid #6B6560;
  color: #6B6560;
}
.coupon-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #6B6560;
  font-size: 26rpx;
}
.coupon-panel-foot {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(38,35,32,0.8);
}
.coupon-link-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border: 1px solid rgba(196, 167, 108, 0.4);
  color: #C4A76C;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.coupon-buy-btn {
  flex: 1.5;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #C4A76C;
  color: #1A1814;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* 快捷功能 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  background: #1F1D1A;
  border-radius: 16rpx;
  border: 1px solid rgba(38,35,32,0.8);
  padding: 24rpx 0;
  margin-bottom: 48rpx;
}
.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #A09A90;
}
.quick-icon { width: 40rpx; height: 40rpx; opacity: 0.6; filter: brightness(0) invert(1); }

/* 参数表 */
.params-card {
  background: #1F1D1A;
  border-radius: 16rpx;
  border: 1px solid rgba(38,35,32,0.8);
  padding: 8rpx 24rpx;
  margin-bottom: 48rpx;
}
.param-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1px dashed rgba(38,35,32,0.8);
}
.param-row:last-child { border-bottom: none; }
.param-k { width: 160rpx; font-size: 24rpx; color: #6B6560; flex-shrink: 0; }
.param-v { flex: 1; font-size: 24rpx; color: #D5D1C8; text-align: right; }
.param-v.gold { color: #C4A76C; }
.param-v.latin { font-style: italic; color: #C4A76C; }

/* 图文详情 */
.detail-content { margin-bottom: 48rpx; }
.detail-rich { margin-top: 24rpx; }
.detail-images { margin-top: 24rpx; }
.detail-img { width: 100%; display: block; margin-bottom: 16rpx; border-radius: 12rpx; }

/* 价格 */
.price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx; }
.symbol { font-size: 28rpx; color: #C4A76C; margin-right: 8rpx; font-weight: bold; }
.num { font-size: 64rpx; color: #C4A76C; font-family: 'DIN', sans-serif; font-weight: bold; }
.vip-box { display: flex; align-items: baseline; }
.vip-badge { background: linear-gradient(90deg, #A8903C, #C4A76C); color: #1A1814; font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx; font-weight: bold; margin-left: 8rpx; transform: translateY(-10rpx); }
.origin { font-size: 24rpx; color: #666; text-decoration: line-through; margin-top: 6rpx; }
.stock-label { font-size: 22rpx; color: #666; margin-top: 12rpx; }
.stock-label.active { color: #E9A23B; }
.price-from { font-size: 24rpx; color: #A09A90; margin-left: 4rpx; }

.section-title { font-size: 24rpx; color: #888; font-weight: bold; letter-spacing: 4rpx; margin-bottom: 30rpx; padding-left: 20rpx; border-left: 6rpx solid #C4A76C; }
.section-title.inline { margin-bottom: 0; }
.archive-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-bottom: 60rpx; width: 100%; }
.archive-item { background: #1F1D1A; padding: 24rpx; border-radius: 12rpx; border: 1px solid #2a2a2a; display: flex; flex-direction: column; overflow: hidden; }
.archive-item.clickable:active { background: #2a2a2a; }
.lbl { font-size: 20rpx; color: #666; margin-bottom: 12rpx; letter-spacing: 1rpx; }
.val { 
  font-size: 26rpx; color: #eee; font-weight: bold; 
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; 
}
.val.gold { color: #C4A76C; }
.val-row { display: flex; justify-content: space-between; align-items: center; }
.arrow { font-size: 24rpx; color: #666; }

/* 科学分类 */
.taxonomy-card { background: #1F1D1A; border-radius: 12rpx; padding: 30rpx; margin-bottom: 60rpx; border: 1px solid #2a2a2a; width: 100%; }
.tax-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1px dashed #333; width: 100%; }
.tax-row:last-child { border-bottom: none; }
.k { font-size: 24rpx; color: #888; flex-shrink: 0; margin-right: 20rpx; } 
.v { 
  font-size: 24rpx; color: #eee; font-style: italic; 
  text-align: right; 
  flex: 1;
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis; 
}
.tax-row.highlight .v { color: #C4A76C; font-weight: bold; }
.taxonomy-empty {
  background: #1F1D1A;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 60rpx;
  border: 1px solid #2a2a2a;
  text-align: center;
}
.taxonomy-empty .muted { font-size: 24rpx; color: #6B6560; }

.cert-card {
  background: #1F1D1A;
  border: 1px solid #4D401A;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 60rpx;
}

.cert-badge {
  padding: 16rpx 30rpx;
  font-size: 22rpx;
  color: #C4A76C;
  letter-spacing: 0.08em;
  border-bottom: 1px solid #262320;
  background: rgba(196, 167, 108, 0.08);
}

.cert-body {
  padding: 24rpx;
}

.cert-image {
  width: 100%;
  border-radius: 8rpx;
  border: 1px solid #262320;
}

.cert-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}

.cert-tip {
  font-size: 22rpx;
  color: #A09A90;
  flex: 1;
}

.cert-action {
  font-size: 22rpx;
  color: #C4A76C;
  flex-shrink: 0;
}

.cert-card:active {
  opacity: 0.92;
}

/* 故事卡 */
.story-card { margin-bottom: 60rpx; width: 100%; }
.story-text { font-size: 28rpx; line-height: 1.8; color: #ccc; text-align: justify; }

/* 推荐滚动 */
.recommend-scroll { display: flex; white-space: nowrap; height: 260rpx; margin-bottom: 40rpx; width: 100%; }
.rec-card { width: 200rpx; flex-shrink: 0; margin-right: 24rpx; display: flex; flex-direction: column; }
.rec-card image { width: 200rpx; height: 200rpx; border-radius: 12rpx; margin-bottom: 12rpx; background: #222; }
.rec-name { font-size: 22rpx; color: #aaa; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rec-price { font-size: 24rpx; color: #C4A76C; margin-top: 4rpx; font-family: var(--font-mono, monospace); }

/* 评价区域 */
.comment-section {
  margin-bottom: 60rpx;
  width: 100%;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 20rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(196, 167, 108,0.1);
  border: 1px solid rgba(196, 167, 108,0.3);
  border-radius: 20rpx;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.3s;
}

.comment-action:active {
  background: rgba(196, 167, 108,0.2);
  transform: scale(0.95);
}

.comment-action .arrow {
  font-size: 20rpx;
}

.comment-empty-hint {
  padding: 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.4);
  font-size: 24rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #1F1D1A;
  border-top: 1px solid rgba(38, 35, 32, 0.9);
  display: flex;
  align-items: center;
  z-index: 90;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bottom-icons {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  position: relative;
  padding: 4rpx 0;
  background: transparent;
  line-height: 1.2;
  margin: 0;
  border: none;
}
.contact-btn::after { border: none; }
.contact-btn { padding: 4rpx 0; }

.icon-btn:active { opacity: 0.75; }

.bar-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
  margin-bottom: 4rpx;
  filter: brightness(0) saturate(100%) invert(76%) sepia(66%) saturate(709%) hue-rotate(356deg) brightness(93%) contrast(87%);
}
.bar-icon-active { filter: none; }

.bar-txt {
  font-size: 18rpx;
  color: #A09A90;
  white-space: nowrap;
  line-height: 1.2;
}

.bar-badge {
