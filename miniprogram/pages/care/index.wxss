/* pages/care/index.wxss */
@import './care-common.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.page-care {
  min-height: 100vh;
  position: relative;
}

/* ── Hero ── */
.hero {
  padding: var(--space-2) 0 var(--space-4);
}

.hero-overline {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.16em;
  margin-bottom: 12rpx;
}

.hero-tagline {
  display: block;
  font-size: 34rpx;
  color: var(--brass-200);
  letter-spacing: 0.06em;
  line-height: 1.45;
  font-family: var(--font-brand);
}

.hero-divider {
  width: 48rpx;
  height: 2rpx;
  background: var(--brass-400);
  margin: 20rpx 0 16rpx;
  opacity: 0.7;
}

.hero-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.65;
}

.hero-stat {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-3);
  padding: 12rpx 24rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-full);
}

.stat-num {
  font-family: var(--font-mono);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brass-400);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.stat-arrow {
  font-size: 24rpx;
  color: var(--brass-400);
}

/* ── 季节提示 ── */
.season-banner {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-3);
  margin-bottom: var(--space-4);
  background: rgba(45, 90, 63, 0.1);
  border: 1px solid rgba(45, 90, 63, 0.32);
  border-radius: var(--radius-md);
}

.season-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.season-pulse {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-forest);
  animation: carePulse 2.4s ease-in-out infinite;
}

.season-body {
  flex: 1;
  min-width: 0;
}

.season-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-forest);
  letter-spacing: 0.06em;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.season-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-body);
  line-height: 1.55;
}

/* ── 藏品卡片 ── */
.specimen-card {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border-highlight);
  border-radius: var(--radius-lg);
  transition: background 0.2s, border-color 0.2s;
}

.specimen-frame {
  padding: 4rpx;
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.specimen-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: calc(var(--radius-md) - 4rpx);
  display: block;
  background: var(--color-bg-elevated);
}

.specimen-thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph-letter {
  font-size: 36rpx;
  color: var(--brass-400);
  font-family: var(--font-brand);
}

.specimen-main {
  flex: 1;
  min-width: 0;
}

.specimen-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.specimen-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}

.specimen-tag {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
}

.specimen-date {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.specimen-summary {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 10rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.specimen-chevron {
  flex-shrink: 0;
  padding-top: 8rpx;
  font-size: 36rpx;
  color: var(--brass-400);
  line-height: 1;
  opacity: 0.75;
}

/* ── 空态 ── */
.empty-card {
  padding: var(--space-6) var(--space-4);
  background: var(--color-bg-card);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-lg);
  text-align: center;
}

.empty-icon-ring {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto var(--space-4);
  border-radius: 50%;
  border: 1px solid var(--brass-800);
  background: rgba(196, 167, 108, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-letter {
  font-size: 40rpx;
  font-family: var(--font-brand);
  color: var(--brass-400);
}

.empty-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.55;
  margin-bottom: var(--space-4);
}

.empty-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
  background: var(--brass-400);
  color: var(--color-bg);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  letter-spacing: 0.04em;
}

/* ── 品类网格 ── */
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.category-card {
  position: relative;
  display: flex;
  align-items: stretch;
  min-height: 168rpx;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: background 0.2s, border-color 0.2s;
}

.category-card.wide {
  grid-column: 1 / -1;
  min-height: 128rpx;
}

.cat-stripe {
  width: 6rpx;
  flex-shrink: 0;
  opacity: 0.85;
}

.cat-inner {
  flex: 1;
  min-width: 0;
  padding: var(--space-3) var(--space-2) var(--space-3) var(--space-3);
}

.cat-overline {
  display: block;
  font-size: 18rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.1em;
  margin-bottom: 8rpx;
}

.cat-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.cat-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.cat-arrow {
  display: flex;
  align-items: center;
  padding-right: 16rpx;
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.65;
}

/* ── 日常要点（手风琴） ── */
.tip-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.tip-item {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  border-left: 4rpx solid var(--brass-800);
  transition: border-color 0.25s, background 0.25s;
}

.tip-item.expanded {
  border-left-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.04);
}

.tip-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.12);
  color: var(--brass-400);
  font-size: 22rpx;
  font-family: var(--font-mono);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-body {
  flex: 1;
  min-width: 0;
}

.tip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.tip-title {
  font-size: 26rpx;
  color: var(--color-text-body);
  font-weight: 500;
}

.tip-toggle {
  font-size: 28rpx;
  color: var(--brass-400);
  line-height: 1;
  flex-shrink: 0;
}

.tip-desc-wrap {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, margin-top 0.3s ease;
}

.tip-item.expanded .tip-desc-wrap {
  max-height: 160rpx;
  margin-top: 12rpx;
}

.tip-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.care-support {
  margin-bottom: var(--space-3);
}
