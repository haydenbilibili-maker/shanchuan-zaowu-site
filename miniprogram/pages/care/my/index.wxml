<!--pages/care/my/index.wxml-->
<view class="page-my-care">
  <view class="grain-overlay"></view>

  <view class="header care-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="care-back" hover-class="care-back-hover" bindtap="goBack">
      <text class="care-back-icon">←</text>
    </view>
    <view class="care-brand">
      <text class="care-title">我的藏品养护</text>
      <text class="care-sub">MY SPECIMENS</text>
    </view>
    <view class="care-header-spacer"></view>
  </view>

  <scroll-view
    scroll-y
    class="main-scroll care-scroll"
    show-scrollbar="{{false}}"
    style="top: {{scrollTopPx}}px; height: {{scrollHeightPx}}px;"
  >
    <view class="care-skeleton" wx:if="{{loading}}">
      <view class="sk-block sk-hero"></view>
      <view class="sk-block sk-row" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>

    <view class="care-content {{pageReady ? 'ready' : ''}}" wx:else>
      <view class="intro care-enter care-enter-d1">
        <text class="intro-overline">YOUR COLLECTION</text>
        <text class="intro-text">已签收藏品按订单聚合，点击可查看对应品类养护指南与装裱补充说明</text>
      </view>

      <view class="list care-enter care-enter-d2" wx:if="{{specimens.length}}">
        <view class="list-count">{{specimens.length}} 件藏品</view>
        <view
          class="spec-card"
          wx:for="{{specimens}}"
          wx:key="key"
          hover-class="care-card-hover"
          bindtap="openSpecimen"
          data-category="{{item.category}}"
          data-order-id="{{item.orderId}}"
          data-product-id="{{item.productId}}"
        >
          <view class="spec-frame">
            <image class="spec-cover" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}"></image>
            <view class="spec-cover placeholder" wx:else>
              <text class="cover-letter">{{item.categoryOverline[0]}}</text>
            </view>
          </view>
          <view class="spec-body">
            <text class="spec-title">{{item.title}}</text>
            <view class="spec-tags">
              <text class="tag-cat" style="color: {{item.categoryColor}}; border-color: {{item.categoryColor}}33; background: {{item.categoryColor}}12;">{{item.categoryLabel}}</text>
              <text class="tag-custom" wx:if="{{item.isCustom}}">定制</text>
              <text class="tag-date" wx:if="{{item.receiveTimeText}}">{{item.receiveTimeText}}</text>
            </view>
            <text class="spec-framing" wx:if="{{item.framingName}}">装裱：{{item.framingName}}</text>
            <text class="spec-summary">{{item.careSummary}}</text>
          </view>
          <view class="spec-chevron"><text>›</text></view>
        </view>
      </view>

      <view class="empty care-enter care-enter-d2" wx:else>
        <view class="empty-icon-ring">
          <text class="empty-icon-letter">藏</text>
        </view>
        <text class="empty-title">还没有已签收藏品</text>
        <text class="empty-desc">确认收货后，藏品会出现在这里，并匹配对应养护指南</text>
        <view class="empty-btn" bindtap="goToHub" hover-class="care-press">浏览品类养护 →</view>
      </view>
    </view>

    <view class="care-scroll-pad"></view>
  </scroll-view>
</view>
