<!--pages/care/guide/index.wxml-->
<view class="page-guide">
  <view class="grain-overlay"></view>

  <view class="header care-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="care-back" hover-class="care-back-hover" bindtap="goBack">
      <text class="care-back-icon">←</text>
    </view>
    <view class="care-brand">
      <text class="care-title">{{guide.title || '养护指南'}}</text>
      <text class="care-sub">{{guide.overline || 'CARE GUIDE'}}</text>
    </view>
    <view class="care-header-badge" style="border-color: {{categoryColor}}44;">
      <view class="care-header-dot" style="background: {{categoryColor}};"></view>
    </view>
  </view>

  <scroll-view
    scroll-y
    class="main-scroll care-scroll"
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollIntoView}}"
    style="top: {{scrollTopPx}}px; height: {{scrollHeightPx}}px;"
  >
    <view class="care-skeleton" wx:if="{{loading}}">
      <view class="sk-block sk-plate"></view>
      <view class="sk-block sk-section" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>

    <view class="care-content {{pageReady ? 'ready' : ''}}" wx:else>
      <view class="context-bar care-enter care-enter-d1" wx:if="{{contextTitle}}">
        <text class="ctx-label">您的藏品</text>
        <text class="ctx-title">{{contextTitle}}</text>
        <text class="ctx-framing" wx:if="{{framingName}}">装裱：{{framingName}}</text>
      </view>

      <view class="summary-plate care-enter care-enter-d2">
        <text class="plate-overline">养护摘要</text>
        <text class="plate-summary">{{guide.summary}}</text>
        <text class="plate-draft" wx:if="{{guide.disclaimer}}">{{guide.disclaimer}}</text>
      </view>

      <!-- 目录导航 -->
      <view class="toc-wrap care-enter care-enter-d3" wx:if="{{contentSections.length > 1}}">
        <text class="toc-label">本页目录</text>
        <scroll-view scroll-x class="toc-scroll" enable-flex show-scrollbar="{{false}}">
          <view
            class="toc-chip {{activeSection === item.key ? 'active' : ''}}"
            wx:for="{{contentSections}}"
            wx:key="key"
            bindtap="jumpToSection"
            data-key="{{item.key}}"
            hover-class="care-press"
          >{{item.title}}</view>
        </scroll-view>
      </view>

      <view
        class="section-block care-enter"
        wx:for="{{contentSections}}"
        wx:key="key"
        id="section-{{item.key}}"
        style="animation-delay: {{0.06 * index + 0.2}}s;"
      >
        <view
          class="block-head"
          bindtap="toggleSection"
          data-key="{{item.key}}"
          hover-class="care-card-hover"
        >
          <text class="block-index">{{index + 1}}</text>
          <text class="block-title">{{item.title}}</text>
          <text class="block-toggle">{{collapsedSections[item.key] ? '+' : '−'}}</text>
        </view>
        <view class="block-content {{collapsedSections[item.key] ? 'collapsed' : ''}}">
          <text class="block-body">{{item.body}}</text>
          <view class="checklist" wx:if="{{item.tips && item.tips.length}}">
            <view class="check-row" wx:for="{{item.tips}}" wx:for-item="tip" wx:key="*this">
              <view class="check-mark"></view>
              <text class="check-text">{{tip}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="warning-block care-enter care-enter-d4" wx:if="{{warningSection}}">
        <view class="warning-head">
          <view class="warning-icon">!</view>
          <text class="warning-label">异常信号</text>
        </view>
        <text class="warning-body">{{warningSection.body}}</text>
        <view class="warning-list" wx:if="{{warningSection.tips && warningSection.tips.length}}">
          <view class="warning-item" wx:for="{{warningSection.tips}}" wx:key="*this">
            <text class="warning-dot">·</text>
            <text class="warning-tip">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="section-block framing-addon care-enter care-enter-d5" wx:if="{{framingTips.length}}">
        <text class="block-title standalone">装裱补充</text>
        <view class="checklist">
          <view class="check-row" wx:for="{{framingTips}}" wx:key="*this">
            <view class="check-mark brass"></view>
            <text class="check-text">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="action-row care-enter care-enter-d5" wx:if="{{orderId}}">
        <view class="action-btn secondary" hover-class="care-press" bindtap="goToCertificate">收藏证书</view>
        <view class="action-btn primary" hover-class="care-press" bindtap="goToSupport">联系专员</view>
      </view>

      <view
        class="care-support care-enter care-enter-d6"
        hover-class="care-support-hover"
        bindtap="goToSupport"
        wx:else
      >
        <view class="care-support-main">
          <text class="care-support-title">需要专员协助？</text>
          <text class="care-support-desc">若出现返潮、变色、框体松动等情况，请勿自行拆框</text>
        </view>
        <text class="care-support-cta">→</text>
      </view>

      <view class="footer-note care-enter care-enter-d6">
        <text>内容由门店标本师维护 · 山川造物 Nature's Creations</text>
      </view>
    </view>

    <view class="care-scroll-pad"></view>
  </scroll-view>
</view>
