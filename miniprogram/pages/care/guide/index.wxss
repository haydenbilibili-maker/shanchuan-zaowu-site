/* pages/care/guide/index.wxss */
@import '../care-common.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.page-guide {
  min-height: 100vh;
  position: relative;
}

.care-title {
  font-size: 34rpx;
  line-height: 1.35;
}

.sk-plate {
  height: 180rpx;
  margin-bottom: var(--space-4);
}

.sk-section {
  height: 200rpx;
  margin-bottom: var(--space-3);
}

.context-bar {
  padding: var(--space-3);
  margin: var(--space-2) 0 var(--space-3);
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid var(--color-border-highlight);
  border-radius: var(--radius-md);
  border-left: 4rpx solid var(--brass-400);
}

.ctx-label {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.06em;
}

.ctx-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-body);
  margin-top: 8rpx;
  font-weight: 500;
}

.ctx-framing {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.summary-plate {
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  background: rgba(250, 246, 237, 0.06);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
  position: relative;
}

.summary-plate::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 1px solid rgba(196, 167, 108, 0.12);
  border-radius: calc(var(--radius-lg) - 8rpx);
  pointer-events: none;
}

.plate-overline {
  display: block;
  font-size: 20rpx;
  color: var(--color-wood);
  letter-spacing: 0.08em;
  margin-bottom: 10rpx;
}

.plate-summary {
  display: block;
  font-size: 30rpx;
  color: var(--brass-200);
  font-weight: 600;
  line-height: 1.45;
  font-family: var(--font-brand);
}

.plate-draft {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ── 目录 ── */
.toc-wrap {
  margin-bottom: var(--space-4);
}

.toc-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.1em;
  margin-bottom: 12rpx;
}

.toc-scroll {
  white-space: nowrap;
}

.toc-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  color: var(--color-text-secondary);
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}

.toc-chip.active {
  border-color: var(--brass-800);
  color: var(--brass-400);
  background: rgba(196, 167, 108, 0.08);
}

.section-block {
  margin-bottom: var(--space-4);
  padding: var(--space-3);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.block-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.block-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.12);
  color: var(--brass-400);
  font-size: 20rpx;
  font-family: var(--font-mono);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.block-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.block-title.standalone {
  display: block;
  margin-bottom: var(--space-3);
}

.block-toggle {
  font-size: 28rpx;
  color: var(--brass-400);
  flex-shrink: 0;
  padding: 0 8rpx;
}

.block-content {
  overflow: hidden;
  max-height: 2000rpx;
  transition: max-height 0.35s ease, opacity 0.25s ease, margin-top 0.25s ease;
  opacity: 1;
  margin-top: 16rpx;
}

.block-content.collapsed {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
}

.block-body {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
  margin-bottom: 16rpx;
}

.checklist {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.check-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.check-mark {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  border: 2rpx solid var(--color-forest);
  margin-top: 8rpx;
  flex-shrink: 0;
}

.check-mark.brass {
  border-color: var(--brass-400);
}

.check-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-body);
  line-height: 1.55;
}

.warning-block {
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  background: rgba(214, 64, 69, 0.08);
  border: 1px solid rgba(214, 64, 69, 0.25);
  border-left: 4rpx solid var(--color-error);
  border-radius: var(--radius-md);
}

.warning-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.warning-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(214, 64, 69, 0.15);
  color: var(--color-error);
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 32rpx;
}

.warning-label {
  font-size: 24rpx;
  color: var(--color-error);
  font-weight: 600;
}

.warning-body {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-body);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.warning-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.warning-item {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.warning-dot {
  color: var(--color-error);
  font-size: 28rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.warning-tip {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.framing-addon {
  border-bottom: none;
}

.action-row {
  display: flex;
  gap: var(--space-3);
  margin: var(--space-4) 0;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: opacity 0.2s, transform 0.2s;
}

.action-btn.primary {
  background: var(--brass-400);
  color: var(--color-bg);
}

.action-btn.secondary {
  background: transparent;
  border: 1px solid var(--brass-400);
  color: var(--brass-400);
}

.footer-note {
  text-align: center;
  padding: var(--space-2) 0;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.care-support {
  margin: var(--space-2) 0 var(--space-4);
}
