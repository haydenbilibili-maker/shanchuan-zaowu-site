/* pages/community/publish/index.wxss */
page {
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.page-publish {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.pub-nav {
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg);
  padding-left: 28rpx;
  box-sizing: border-box;
}

.pub-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-side {
  min-width: 120rpx;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  padding: 12rpx 0;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 0 16rpx;
}

.nav-side-right {
  /* 与左侧「取消」等宽，保证标题居中 */
}

.pub-scroll {
  flex: 1;
  box-sizing: border-box;
}

.media-section {
  padding: 28rpx 28rpx 8rpx;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-cell,
.media-add {
  width: calc(33.333% - 8rpx);
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.media-cell {
  background: var(--color-bg-elevated);
}

.media-img {
  width: 100%;
  height: 100%;
}

.media-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(26, 24, 20, 0.72);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.media-cover-tag {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  font-size: 18rpx;
  color: var(--color-bg);
  background: var(--brass-400);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
}

.media-add {
  border: 1px dashed var(--color-border-highlight);
  background: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.media-add text {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.add-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.55;
}

.media-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.video-cover-box {
  position: relative;
  width: 240rpx;
  height: 320rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-card);
  border: 1px dashed var(--color-border-highlight);
  margin-bottom: 24rpx;
}

.video-cover-img {
  width: 100%;
  height: 100%;
}

.video-cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.video-cover-badge {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  font-size: 20rpx;
  color: var(--color-bg);
  background: var(--brass-400);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.editor-section {
  padding: 16rpx 28rpx 24rpx;
  border-bottom: 1px solid var(--color-border);
}

.title-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  padding: 16rpx 0;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 16rpx;
}

.body-input {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--color-text-body);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.tags-section,
.category-section {
  padding: 24rpx 28rpx;
  border-bottom: 1px solid var(--color-border);
}

.section-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-chip {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
}

.tag-chip.on {
  color: var(--brass-400);
  border-color: var(--color-border-highlight);
  background: rgba(196, 167, 108, 0.1);
}

.tag-input,
.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.form-row {
  margin-top: 8rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--brass-400);
  margin-bottom: 12rpx;
}

.cat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cat-chip {
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
}

.cat-chip.on {
  color: var(--brass-400);
  border-color: var(--color-border-highlight);
  background: rgba(196, 167, 108, 0.1);
}

.ph {
  color: var(--color-text-muted);
}

.scroll-pad {
  height: 32rpx;
}

.pub-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--color-bg) 70%, rgba(26, 24, 20, 0));
  border-top: 1px solid var(--color-border);
  z-index: 20;
}

.footer-submit {
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-muted);
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border);
}

.footer-submit.ready {
  color: var(--color-bg);
  background: var(--brass-400);
  border-color: var(--brass-400);
  font-weight: 600;
}

.footer-submit.ready:active {
  background: var(--brass-500);
}
