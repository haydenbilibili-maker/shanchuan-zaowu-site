/* pages/community/index.wxss — Museum Mode */
page {
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.page-community {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* ── 页头 ── */
.page-header {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 20rpx;
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg);
  position: relative;
  z-index: 10;
}

.header-left,
.header-right {
  width: 72rpx;
  flex-shrink: 0;
}

.header-brand {
  flex: 1;
  text-align: center;
}

.brand-cn {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  letter-spacing: 0.06em;
}

.brand-en {
  display: block;
  font-size: 18rpx;
  color: var(--brass-400);
  letter-spacing: 0.14em;
  margin-top: 6rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-text-secondary);
}

.nav-search {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}

.nav-search-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.72;
}

.nav-search:active {
  opacity: 0.85;
}

/* ── 理念条 ── */
.hero-strip {
  padding: 28rpx 32rpx 24rpx;
  border-bottom: 1px solid var(--color-border);
}

.hero-line {
  display: block;
  font-size: 26rpx;
  color: var(--brass-200);
  font-family: var(--font-brand);
  letter-spacing: 0.12em;
  margin-bottom: 8rpx;
}

.hero-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.04em;
}

/* ── Tab ── */
.tab-bar {
  display: flex;
  background: var(--color-bg-card);
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 9;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 20rpx;
  position: relative;
}

.tab-cn {
  font-size: 28rpx;
  color: var(--color-text-muted);
  font-weight: 500;
  transition: color 0.2s;
}

.tab-en {
  font-size: 16rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.12em;
  margin-top: 4rpx;
  opacity: 0.7;
}

.tab-item.active .tab-cn {
  color: var(--brass-400);
  font-weight: 600;
}

.tab-item.active .tab-en {
  color: var(--brass-600);
  opacity: 1;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 3rpx;
  background: var(--brass-400);
  border-radius: 2rpx;
}

/* ── 主内容区 ── */
.main-body {
  flex: 1;
}

.content-panel {
  padding: 16rpx 12rpx 120rpx;
  animation: panelIn 0.25s ease;
}

@keyframes panelIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.scroll-foot {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* ── 小红书式双流瀑布 ── */
.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 8rpx;
}

.waterfall-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.note-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--color-border);
}

.note-card:active {
  opacity: 0.92;
}

.note-cover {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: var(--color-bg-elevated);
}

.note-cover.ratio-tall { padding-top: 133%; }
.note-cover.ratio-square { padding-top: 100%; }
.note-cover.ratio-wide { padding-top: 75%; }

.note-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.note-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 18rpx;
  color: var(--color-bg);
  background: var(--color-forest);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.note-play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 24, 20, 0.22);
}

.play-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--brass-400);
  color: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding-left: 4rpx;
}

.note-title {
  padding: 14rpx 16rpx 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.note-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
}

.note-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.note-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border-highlight);
  color: var(--brass-400);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.note-name {
  font-size: 22rpx;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-like {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.like-icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.55;
}

/* ── 发布 FAB ── */
.fab-publish {
  position: fixed;
  left: 50%;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.fab-inner {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brass-400);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(26, 24, 20, 0.85);
}

.fab-publish:active .fab-inner {
  background: var(--brass-500);
  transform: scale(0.96);
}

.fab-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) saturate(100%);
}

.fab-label {
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.08em;
}

/* ── 专题 ── */
.exhibition-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.exhibition-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border-highlight);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.exhibition-card:active {
  background: var(--color-bg-elevated);
}

.exhibition-cover {
  width: 100%;
  height: 320rpx;
  background: var(--color-bg-elevated);
}

.exhibition-body {
  padding: 28rpx 28rpx 32rpx;
}

.exhibition-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  margin-bottom: 10rpx;
}

.exhibition-latin {
  display: block;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.exhibition-brief {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-body);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.exhibition-more {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--brass-400);
  letter-spacing: 0.04em;
}

/* ── 空状态 ── */
.state-box {
  text-align: center;
  padding: 80rpx 40rpx;
  background: var(--color-bg-card);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-lg);
}

.state-box.grid-full {
  width: 100%;
}

.state-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.state-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

