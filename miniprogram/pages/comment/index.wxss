/* pages/comment/index.wxss */
page {
  background-color: #1A1814;
  color: #fff;
  /* 🟢 取消左右阻尼感 */
  overscroll-behavior-x: none;
  overflow-x: hidden;
  height: 100vh;
}

.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

.scroll-container {
  flex: 1;
  height: 0; /* 重要：让 flex 正确计算高度 */
  overflow-y: auto;
}

.content-wrapper {
  padding: 0;
  padding-bottom: 40rpx;
  min-height: 100%;
}

/* 底部间距，避免内容被按钮遮挡 */
.bottom-spacer {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: calc(88rpx + env(safe-area-inset-top));
  background: linear-gradient(180deg, rgba(0,0,0,0.98), rgba(10,10,10,0.95));
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
  backdrop-filter: blur(12px);
}

.back-btn {
  position: absolute;
  left: 30rpx;
  font-size: 36rpx;
  color: rgba(196, 167, 108,0.9);
  padding: 10rpx;
  font-weight: bold;
  transition: all 0.3s;
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.4);
}

.back-btn:active {
  color: #C4A76C;
  transform: scale(0.9);
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.6);
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 1rpx;
}

/* 顶部信息 */
.header-section {
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.target-info {
  display: flex;
  gap: 24rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(15,15,15,0.85));
  border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.6);
  transition: all 0.3s;
}

.target-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  border: 1px solid rgba(196, 167, 108,0.2);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
}

.target-details {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.target-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.target-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  font-style: italic;
}

/* 评分 */
.rating-section {
  margin-bottom: 30rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(15,15,15,0.85));
  border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.6);
  margin-left: 30rpx;
  margin-right: 30rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #C4A76C;
  margin-bottom: 30rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.3);
}

.rating-stars {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  justify-content: center;
  padding: 20rpx 0;
}

.star {
  font-size: 64rpx;
  color: rgba(255,255,255,0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  filter: drop-shadow(0 2rpx 8rpx rgba(0,0,0,0.3));
}

.star:active {
  transform: scale(0.9);
}

.star.active {
  color: #C4A76C;
  text-shadow: 
    0 0 20rpx rgba(196, 167, 108,0.8),
    0 0 40rpx rgba(196, 167, 108,0.5);
  transform: scale(1.15);
  filter: drop-shadow(0 4rpx 16rpx rgba(196, 167, 108,0.6));
}

.rating-hint {
  font-size: 26rpx;
  color: #C4A76C;
  font-family: 'DIN', sans-serif;
  text-align: center;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.4);
}

/* 评价内容 */
.content-section {
  margin-bottom: 30rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(15,15,15,0.85));
  border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.6);
  margin-left: 30rpx;
  margin-right: 30rpx;
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  padding: 24rpx;
  background: rgba(0,0,0,0.4);
  border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.8;
  box-sizing: border-box;
  transition: all 0.3s;
}

.content-input:focus {
  border-color: rgba(196, 167, 108,0.5);
  background: rgba(0,0,0,0.5);
  box-shadow: none;
}

.input-placeholder {
  color: rgba(255,255,255,0.3);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  margin-top: 12rpx;
  font-family: 'DIN', sans-serif;
}

/* 图片上传 */
.image-section {
  margin-bottom: 30rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(15,15,15,0.85));
  border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.6);
  margin-left: 30rpx;
  margin-right: 30rpx;
}

.image-upload {
  margin-top: 20rpx;
}

.image-list {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.uploaded-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(196, 167, 108,0.2);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
  transition: all 0.3s;
}

.uploaded-image:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, rgba(255,77,79,0.95), rgba(255,50,50,0.9));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 
    0 4rpx 12rpx rgba(255,0,0,0.4),
    0 2rpx 6rpx rgba(0,0,0,0.3);
  transition: all 0.2s;
  z-index: 10;
  border: 2px solid rgba(255,255,255,0.3);
}

.delete-btn:active {
  transform: scale(0.9);
  box-shadow: 
    0 2rpx 8rpx rgba(255,0,0,0.5),
    0 1rpx 4rpx rgba(0,0,0,0.4);
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2px dashed rgba(196, 167, 108,0.3);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108,0.03);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.upload-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.1), rgba(196, 167, 108,0.05));
  opacity: 0;
  transition: opacity 0.3s;
}

.upload-btn:active {
  border-color: #C4A76C;
  background: rgba(196, 167, 108,0.1);
  transform: scale(0.98);
}

.upload-btn:active::before {
  opacity: 1;
}

.upload-icon {
  font-size: 48rpx;
  color: rgba(196, 167, 108,0.6);
  margin-bottom: 8rpx;
  font-weight: 300;
  position: relative;
  z-index: 1;
}

.upload-text {
  font-size: 22rpx;
  color: rgba(196, 167, 108,0.7);
  position: relative;
  z-index: 1;
  font-weight: 600;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(10,10,10,0.98), rgba(0,0,0,0.99));
  backdrop-filter: blur(24px);
  border-top: 1px solid rgba(196, 167, 108,0.2);
  box-shadow: 
    0 -4rpx 24rpx rgba(0,0,0,0.6),
    0 -2rpx 8rpx rgba(196, 167, 108,0.1);
  z-index: 100;
  /* 确保按钮在最上层 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #A8903C, #C4A76C);
  background-size: 200% 100%;
  color: #1A1814;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  border: 2px solid rgba(196, 167, 108,0.6);
  box-shadow: 
    0 8rpx 24rpx rgba(196, 167, 108, 0.5),
    0 4rpx 12rpx rgba(0, 0, 0, 0.5),
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.4),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  animation: btn-golden-shine 3s ease-in-out infinite;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 重置 button 默认样式 */
  padding: 0;
  margin: 0;
  line-height: 1;
}

@keyframes btn-golden-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.submit-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.3), transparent, rgba(255,255,255,0.1));
  opacity: 0;
  transition: opacity 0.4s;
  pointer-events: none;
  border-radius: inherit;
}

.submit-btn:active {
  transform: scale(0.97);
  box-shadow: 
    0 6rpx 18rpx rgba(196, 167, 108, 0.6),
    0 3rpx 9rpx rgba(0, 0, 0, 0.6),
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.5),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.4);
  border-color: rgba(196, 167, 108, 0.8);
}

.submit-btn:active::before {
  opacity: 1;
}

.submit-btn.submitting {
  opacity: 0.8;
  animation: none;
  cursor: not-allowed;
}

.submit-btn.submitting::before {
  opacity: 0.3;
}

.submit-btn[disabled] {
  background: linear-gradient(135deg, #333, #444, #333);
  color: #666;
  box-shadow: none;
  animation: none;
  border-color: #555;
  cursor: not-allowed;
}

.submit-btn[disabled]::before {
  opacity: 0;
}

