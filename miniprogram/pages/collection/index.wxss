.page {
  min-height: 100vh;
  padding: 24rpx 20rpx 80rpx;
  background: #1A1814;
  box-sizing: border-box;
}

.stats {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(196, 167, 108, 0.12);
}

.stat-box {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #C4A76C;
}

.stat-lbl {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.08);
}

.tabs {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.tab-inner {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 8rpx 4rpx 16rpx;
}

.tab {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.05);
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}

.tab.on {
  color: #1a1208;
  background: linear-gradient(90deg, #A8903C, #C4A76C);
  font-weight: 600;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: rgba(255, 255, 255, 0.5);
  font-size: 26rpx;
  gap: 20rpx;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: #C4A76C;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-t {
  display: block;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-bottom: 12rpx;
}

.empty-s {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.go {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  padding: 0 48rpx;
  font-size: 28rpx;
  background: linear-gradient(90deg, #8A7530, #C4A76C);
  color: #1a1208;
  font-weight: 600;
  border: none;
}

.go::after {
  border: none;
}

.waterfall {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wc-card {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(196, 167, 108, 0.1);
}

.wc-img {
  width: 100%;
  height: 280rpx;
  display: block;
  background: #1A1814;
}

.wc-name {
  display: block;
  padding: 16rpx 16rpx 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.35;
}
