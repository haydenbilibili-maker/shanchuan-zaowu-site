/* pages/cart/index.wxss — Museum Mode v2 */
page {
  /* 字面量优先：iOS Tab 切换时比 CSS 变量更早可用 */
  background: var(--color-bg);
  background-color: var(--color-bg);
  color: var(--color-text-primary);
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  min-height: 100%;
}

.page-cart {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: var(--tabbar-offset);
  box-sizing: border-box;
  overflow-x: hidden;
  background-color: var(--color-bg);
}

.page-cart.has-items {
  /* 结算栏 + 礼券凸起 + 运费行；真正避让由 scrollHeight 测量保证 */
  padding-bottom: calc(var(--tabbar-offset) + 220rpx);
}

.cart-top {
  position: relative;
  z-index: 10;
  background: var(--color-bg);
  flex-shrink: 0;
}

.cart-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-4) var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.header-left { flex: 1; min-width: 0; }
.header-actions { flex-shrink: 0; }
.header-title { display: flex; flex-direction: column; }

.title-cn {
  font-size: 36rpx;
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
}

.title-en {
  font-size: 18rpx;
  color: var(--brass-400);
  letter-spacing: 0.14em;
  margin-top: 6rpx;
}

.header-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.text-btn {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}

.filter-bar {
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-2) 0;
  width: 100%;
  box-sizing: border-box;
}

.filter-scroll {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  padding: 0 var(--space-4);
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  gap: 6rpx;
  padding: 10rpx 28rpx;
  margin-right: var(--space-2);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.filter-chip.active {
  background: var(--brass-400);
  border-color: var(--brass-400);
  color: var(--color-bg);
  font-weight: 500;
}

.filter-chip:active,
.filter-chip-press { opacity: 0.82; transform: scale(0.97); }

.filter-pad {
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.chip-count { font-size: 20rpx; opacity: 0.75; }

/* 真机：fixed 滚动区，避免 flex:1 + height:0 坍缩；须低于 .cart-top */
.scroll-panel {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 1;
  box-sizing: border-box;
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.scanner {
  width: 60%;
  height: 2rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(to right, transparent, var(--brass-400), transparent);
  animation: scan 1.5s infinite;
}

@keyframes scan {
  0% { opacity: 0; width: 0; }
  50% { opacity: 1; width: 60%; }
  100% { opacity: 0; width: 0; }
}

.loading-box text {
  font-size: 22rpx;
  color: var(--brass-400);
  letter-spacing: 0.08em;
}

.cart-scroll {
  /* height 由 inline style top/bottom 决定 */
}
.slot-list { padding: var(--space-4); }

.invalid-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 var(--space-4) var(--space-3);
  padding: var(--space-3);
  background: rgba(214, 64, 69, 0.08);
  border: 1px solid rgba(214, 64, 69, 0.35);
  border-radius: var(--radius-md);
}

.invalid-text { font-size: 24rpx; color: var(--color-error); }

.invalid-action {
  font-size: 24rpx;
  color: var(--brass-400);
  padding: 4rpx 16rpx;
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-sm);
}

.slot-container {
  margin-bottom: var(--space-3);
  width: 100%;
  overflow: hidden;
  position: relative;
}
.slot-container:last-child { margin-bottom: 0; }

.swipe-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.cart-card {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  padding: var(--space-3);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
}

.swipe-wrapper.active .cart-card { transform: translateX(-120rpx); }

.cart-card-press { opacity: 0.92; }

.cart-card.selected {
  border-color: var(--brass-800);
  /* 必须用不透明底，避免透出背后的「移除」层 */
  background:
    linear-gradient(0deg, rgba(196, 167, 108, 0.1), rgba(196, 167, 108, 0.1)),
    var(--color-bg-card);
}

.cart-card.invalid { opacity: 0.72; }

.gold-checkbox {
  width: 40rpx;
  height: 40rpx;
  margin-right: var(--space-3);
  margin-top: 4rpx;
  flex-shrink: 0;
  border: 1px solid var(--brass-800);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-elevated);
}

.gold-checkbox.checked {
  background: var(--brass-400);
  border-color: var(--brass-400);
}

.gold-checkbox.disabled { opacity: 0.35; }
.gold-checkbox.sm { width: 32rpx; height: 32rpx; margin-right: var(--space-2); margin-top: 0; }
.tick { width: 22rpx; height: 22rpx; }
.tick image { width: 100%; height: 100%; }

.card-body { flex: 1; display: flex; min-width: 0; }

.thumb-wrap {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  margin-right: var(--space-3);
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--color-border);
}

.thumb { width: 100%; height: 100%; background: var(--color-bg-elevated); }

/* 缩略图缺图占位（2026-09-20 新增）：与 .thumb 同尺寸同底，让"缺图"读得出来。
   此前 onCartThumbError 清空 src 后模板没有 wx:else → 那一格直接空白。 */
.thumb-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-elevated);
}

.thumb-ph-icon { width: 44rpx; height: 44rpx; opacity: 0.8; }

.thumb-mask {
  position: absolute;
  inset: 0;
  background: rgba(26, 24, 20, 0.72);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mask-cn { font-size: 22rpx; color: var(--color-text-secondary); font-weight: 500; }
.mask-en { font-size: 16rpx; color: var(--color-text-muted); margin-top: 4rpx; letter-spacing: 0.1em; }

.info-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 144rpx;
}

.name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latin {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-style: italic;
  color: var(--color-text-latin);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sku-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}

.invalid-reason {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-error);
}

.info-btm {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-2);
}

.price {
  font-family: var(--font-mono);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brass-400);
}

.qty-stepper {
  display: flex;
  align-items: center;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.qty-btn {
  width: 52rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brass-400);
  font-size: 28rpx;
  background: var(--color-bg-elevated);
}

.qty-btn.disabled { opacity: 0.35; }
.qty-btn:active { background: rgba(196, 167, 108, 0.12); }

.qty-val {
  min-width: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-body);
  font-family: var(--font-mono);
}

.swipe-action {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  width: 120rpx;
  padding-left: 16rpx;
  box-sizing: border-box;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.swipe-wrapper.active .swipe-action {
  z-index: 2;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.remove-btn {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(214, 64, 69, 0.15);
  border: 1px solid rgba(214, 64, 69, 0.4);
  border-radius: var(--radius-md);
}

.remove-btn:active {
  background: rgba(214, 64, 69, 0.22);
}

.remove-icon { width: 32rpx; height: 32rpx; margin-bottom: 4rpx; }
.remove-txt { font-size: 20rpx; color: var(--color-error); }

.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-4) var(--space-4) var(--space-8);
  box-sizing: border-box;
  overflow-y: auto;
}

.empty-hero {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: var(--space-4);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.75;
}

.empty-overline {
  display: block;
  font-size: 18rpx;
  color: var(--brass-400);
  letter-spacing: 0.16em;
  margin-bottom: var(--space-2);
}

.empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
  letter-spacing: 0.04em;
}

.empty-desc {
  display: block;
  max-width: 520rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
  margin-bottom: var(--space-5);
}

.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  width: 100%;
}

.empty-cta-primary {
  width: 100%;
  max-width: 420rpx;
  padding: var(--space-3) var(--space-6);
  background: var(--brass-400);
  border-radius: var(--radius-md);
  text-align: center;
  box-sizing: border-box;
}

.empty-cta-primary text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-bg);
  letter-spacing: 0.06em;
}

.empty-cta-primary:active,
.empty-cta-press {
  background: var(--brass-500);
}

.empty-cta-secondary {
  padding: var(--space-2) var(--space-4);
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-md);
}

.empty-cta-secondary text {
  font-size: 26rpx;
  color: var(--brass-400);
  letter-spacing: 0.04em;
}

.empty-cta-secondary:active,
.empty-cta-secondary-press {
  opacity: 0.82;
  background: rgba(196, 167, 108, 0.08);
}

.recommend-section {
  padding: 0 var(--space-4) var(--space-4);
  width: 100%;
  box-sizing: border-box;
}
.recommend-section.empty-rec {
  flex-shrink: 0;
  width: 100%;
  margin-top: var(--space-2);
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border);
}
.section-head { margin-bottom: var(--space-3); }

.section-label {
  display: block;
  font-size: 22rpx;
  color: var(--brass-400);
  letter-spacing: 0.1em;
}

.section-sub {
  display: block;
  font-size: 18rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.12em;
  margin-top: 4rpx;
}

.recommend-scroll {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
}

.rec-card {
  display: inline-block;
  flex-shrink: 0;
  width: 220rpx;
  margin-right: var(--space-3);
  vertical-align: top;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.rec-card-hover { opacity: 0.92; transform: scale(0.98); }

.rec-img-wrap {
  width: 100%;
  height: 220rpx;
  background: var(--color-bg-elevated);
  overflow: hidden;
}

.rec-img {
  width: 100%;
  height: 220rpx;
  display: block;
}

.rec-img-ph {
  width: 100%;
  height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: var(--color-bg-elevated);
}

/* 2026-09-20：原 `opacity: 0.45` 的图标压在 --color-bg-elevated(#262320) 深底上 ≈ 看不见，
   加载失败时用户看到的是**深色空块**，会被当成渲染 bug（真机反馈）。
   抬到 0.8 + 补一行文案，让"缺图"这件事自己说出来。 */
.rec-img-ph-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.8;
}

/* 用 --color-text-secondary（#A09A90，深面 5.6~6.35 ✓）而不是 --color-text-muted ——
   后者在小程序深面上实测 2.72~3.09，低于正文阈值 4.5（见 check:mp-contrast）。 */
.rec-img-ph-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.rec-body { padding: var(--space-2) var(--space-3) var(--space-3); }

.rec-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-latin {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-latin);
  font-style: italic;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-price {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: 26rpx;
  color: var(--brass-400);
}

/* 推荐流滚到底时的呼吸留白（礼券 overhang 已计入 scrollBottom） */
.scroll-spacer { height: 48rpx; }

.checkout-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--tabbar-offset);
  z-index: 100;
  padding: 0 var(--space-4) var(--space-3);
  /* 实色底：运费行与结算区同属一块，不再像挤在底栏与 tabBar 缝里 */
  background: var(--color-bg);
  box-sizing: border-box;
}

.coupon-chip {
  position: absolute;
  top: -44rpx;
  right: var(--space-4);
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-bottom: none;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  font-size: 20rpx;
  color: var(--brass-400);
}
.coupon-chip-press { opacity: 0.82; }

.coupon-icon { width: 24rpx; height: 24rpx; }

.bar-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
}

.select-all { display: flex; align-items: center; flex-shrink: 0; }
.select-label { font-size: 24rpx; color: var(--color-text-body); }
.total-block { flex: 1; min-width: 0; text-align: right; }
.total-row { margin-bottom: 4rpx; }
.total-hint { font-size: 20rpx; color: var(--color-text-muted); margin-left: 8rpx; }

.total-main {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
}

.total-label { font-size: 22rpx; color: var(--color-text-secondary); }

.total-val {
  font-family: var(--font-mono);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--brass-400);
}

.shipping-hint-row {
  margin-top: 10rpx;
  padding: 0 8rpx 4rpx;
  text-align: center;
}

.shipping-hint {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.02em;
  line-height: 1.45;
  word-break: keep-all;
  overflow-wrap: anywhere;
}

.checkout-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: var(--space-3) var(--space-4);
  background: var(--brass-400);
  color: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 500;
}

.checkout-btn.disabled {
  background: var(--color-bg-elevated);
  color: var(--color-text-muted);
}

.checkout-btn-hover { background: var(--brass-500); }
.checkout-btn:active { background: var(--brass-500); }

.checkout-count { font-size: 22rpx; opacity: 0.85; }

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(26, 24, 20, 0.65);
}

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
}

.sheet-drag-handle {
  width: 64rpx;
  height: 6rpx;
  margin: var(--space-3) auto var(--space-2);
  background: var(--color-border);
  border-radius: var(--radius-full);
}

.sheet-header {
  padding: 0 var(--space-4) var(--space-3);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.sheet-list {
  flex-shrink: 0;
  width: 100%;
  height: 56vh;
  max-height: 56vh;
  min-height: 200rpx;
  padding: 0 var(--space-4) var(--space-4);
  box-sizing: border-box;
}

.sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}

.sheet-item.selected {
  border-color: var(--brass-400);
  background: rgba(196, 167, 108, 0.10);
}

.sheet-item.disabled {
  opacity: 0.45;
  border-color: var(--color-border);
  background: var(--color-bg-card);
}

.sheet-item-press { background: var(--color-bg-elevated); }
.sheet-item.selected.sheet-item-press { background: rgba(196, 167, 108, 0.14); }
.sheet-item-name { flex: 1; font-size: 28rpx; color: var(--color-text-body); }
.sheet-item.selected .sheet-item-name { color: var(--color-text-primary); }

.cp-left { display: flex; align-items: center; gap: var(--space-3); flex: 1; min-width: 0; }

.cp-val {
  font-family: var(--font-mono);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--brass-400);
  min-width: 80rpx;
}

.cp-meta { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.cp-name { font-size: 26rpx; color: var(--color-text-primary); }
.cp-cond { font-size: 22rpx; color: var(--color-text-muted); }

.radio {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--color-text-muted);
  border-radius: 50%;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio.checked {
  border-color: var(--brass-400);
}

.radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--brass-400);
}

/* 礼券项：本单实际可省 / 不可用原因 */
.cp-save { margin-top: 4rpx; font-size: 21rpx; color: var(--gold, #C4A76C); }
.cp-save.is-off { color: var(--color-text-muted, #8A847C); }

/* === 需求 1：结账台「顺手带走一件」（吧台口香糖位） ===
 * 放在 .checkout-bar 内部 → 随结算栏一起固定在底部，不随清单滚走；
 * 配色沿用馆藏铜金语言（与礼券 chip / 结算按钮同一层），不复用推荐位卡片以免混淆「推荐」与「顺手件」。 */
.addon-strip {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--brass-800);
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(196, 167, 108, 0.12) 0%, rgba(196, 167, 108, 0.03) 100%);
  box-sizing: border-box;
}

.addon-press {
  opacity: 0.72;
}

.addon-thumb-wrap {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.04);
}

.addon-thumb {
  display: block;
  width: 100%;
  height: 100%;
}

.addon-thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.addon-thumb-ph-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
}

.addon-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.addon-title {
  font-size: 25rpx;
  color: var(--color-text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.addon-reason {
  font-size: 19rpx;
  color: var(--brass-300);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.addon-price {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 26rpx;
  color: var(--gold);
}

.addon-cta {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--gold);
  color: #1A1814;
  font-size: 23rpx;
  font-weight: 500;
}

.addon-cta-press {
  opacity: 0.82;
}

.addon-close {
  flex-shrink: 0;
  padding: 0 6rpx 0 2rpx;
  font-size: 32rpx;
  line-height: 1;
  color: var(--color-text-muted);
}

/* === 需求 2/3：免邮凑单行（未达包邮门槛时替代纯规则文案） === */
.freeship-row {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.freeship-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.freeship-gap {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 0.02em;
}

.freeship-rule {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 19rpx;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 进度轨：复用成长里程的语言（细轨 + 铜金填充），不用原生 progress */
.freeship-track {
  position: relative;
  width: 100%;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(196, 167, 108, 0.16);
  overflow: hidden;
}

.freeship-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.6) 0%, var(--gold) 100%);
  transition: width 0.28s ease;
}

.freeship-filler {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border: 1rpx dashed rgba(196, 167, 108, 0.45);
  border-radius: var(--radius-md);
  background: rgba(196, 167, 108, 0.06);
}

.freeship-filler-press {
  background: rgba(196, 167, 108, 0.16);
}

.freeship-filler-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.freeship-filler-cta {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brass-300);
}
