<!--pages/cart/index.wxml-->
<wxs src="../../utils/latinDisplay.wxs" module="latin" />
<view class="page-cart {{!loading && cartList.length > 0 ? 'has-items' : ''}}" style="padding-top: {{statusBarHeight}}px;">

  <view class="cart-top">
  <!-- 顶部（navigationStyle:custom，与其它 Tab 统一，避免 iOS 切 Tab 白闪） -->
  <view class="cart-header">
    <view class="header-left">
      <view class="header-title">
        <text class="title-en">SHOPPING CART</text>
        <text class="title-cn">购物车</text>
      </view>
      <text class="header-meta" wx:if="{{!loading && cartList.length > 0}}">{{cartList.length}} 件待结算</text>
      <text class="header-meta" wx:elif="{{!loading && currentFolder !== 'all'}}">当前：{{currentFolderName}}</text>
    </view>
    <view class="header-actions" wx:if="{{!loading && currentFolder !== 'all'}}">
      <view class="text-btn" bindtap="switchToAll" hover-class="tap-press" hover-stay-time="80">返回全部</view>
    </view>
  </view>

  <!-- 分类筛选 -->
  <view class="filter-bar" wx:if="{{!loading && (folders.length > 0 || currentFolder !== 'all' || cartList.length > 0)}}">
    <scroll-view scroll-x class="filter-scroll" enable-flex show-scrollbar="{{false}}">
      <view class="filter-chip {{currentFolder === 'all' ? 'active' : ''}}" bindtap="switchFolder" data-folder="all" hover-class="filter-chip-press" hover-stay-time="80">全部</view>
      <view class="filter-chip {{currentFolder === 'product' ? 'active' : ''}}" bindtap="switchFolder" data-folder="product" hover-class="filter-chip-press" hover-stay-time="80">藏品</view>
      <view class="filter-chip {{currentFolder === 'activity' ? 'active' : ''}}" bindtap="switchFolder" data-folder="activity" hover-class="filter-chip-press" hover-stay-time="80">活动</view>
      <view class="filter-chip {{currentFolder === 'course' ? 'active' : ''}}" bindtap="switchFolder" data-folder="course" hover-class="filter-chip-press" hover-stay-time="80">课程</view>
      <block wx:for="{{folders}}" wx:key="_id">
        <view class="filter-chip {{currentFolder === item._id ? 'active' : ''}}" bindtap="switchFolder" data-folder="{{item._id}}" hover-class="filter-chip-press" hover-stay-time="80">
          <text>{{item.name}}</text>
          <text class="chip-count" wx:if="{{item.itemCount}}">({{item.itemCount}})</text>
        </view>
      </block>
      <view class="filter-pad"></view>
    </scroll-view>
  </view>
  </view>

  <!-- Loading -->
  <view class="loading-box scroll-panel" wx:if="{{loading}}" style="top: {{scrollTopPx}}px; height: {{scrollHeightPx}}px;">
    <view class="scanner"></view>
    <text>正在整理清单…</text>
  </view>

  <block wx:else>
    <!-- 有商品 -->
    <scroll-view
      scroll-y
      class="cart-scroll scroll-panel"
      wx:if="{{cartList.length > 0}}"
      show-scrollbar="{{false}}"
      style="top: {{scrollTopPx}}px; height: {{scrollHeightPx}}px;"
    >
      <view class="invalid-banner" wx:if="{{invalidCount > 0}}">
        <text class="invalid-text">{{invalidCount}} 件藏品已失效</text>
        <text class="invalid-action" bindtap="clearInvalidItems">清理</text>
      </view>

      <view class="slot-list">
        <block wx:for="{{cartList}}" wx:key="id">
          <view class="slot-container">
            <view
              class="swipe-wrapper {{item.isTouchMove ? 'active' : ''}}"
              bindtouchstart="touchstart"
              bindtouchmove="touchmove"
              data-index="{{index}}"
            >
              <view
                class="cart-card {{item.selected ? 'selected' : ''}} {{item.invalid ? 'invalid' : ''}}"
                bindtap="toggleSelect"
                data-index="{{index}}"
                hover-class="tap-press-soft"
                hover-stay-time="80"
              >
                <view class="gold-checkbox {{item.selected ? 'checked' : ''}} {{item.stock <= 0 || item.invalid ? 'disabled' : ''}}">
                  <view class="tick" wx:if="{{item.selected}}">
                    <image src="/assets/icons/done.png" mode="aspectFit"></image>
                  </view>
                </view>

                <view class="card-body">
                  <view class="thumb-wrap" catchtap="goToDetail" data-id="{{item.productId}}" hover-class="tap-press-soft" hover-stay-time="80">
                    <image class="thumb" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load binderror="onCartThumbError" data-index="{{index}}"></image>
                    <view class="thumb-ph" wx:else>
                      <image class="thumb-ph-icon" src="/assets/icons/box.png" mode="aspectFit"></image>
                    </view>
                    <protected-badge
                      wx:if="{{item.isProtected}}"
                      show="{{true}}"
                      size="xs"
                      corner="bl"
                    />
                    <view class="thumb-mask" wx:if="{{item.invalid}}">
                      <text class="mask-cn">失效</text>
                    </view>
                    <view class="thumb-mask sold" wx:elif="{{item.stock <= 0}}">
                      <text class="mask-cn">售罄</text>
                      <text class="mask-en">SOLD</text>
                    </view>
                  </view>

                  <view class="info-col">
                    <view class="info-top" catchtap="goToDetail" data-id="{{item.productId}}" hover-class="tap-press-soft" hover-stay-time="80">
                      <text class="name">{{item.title}}</text>
                      <text class="latin" wx:if="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
                      <text class="sku-tag" wx:if="{{item.skuLabel}}">{{item.skuLabel}}</text>
                      <text class="invalid-reason" wx:if="{{item.invalid}}">{{item.invalidReason}}</text>
                    </view>
                    <view class="info-btm">
                      <text class="price">¥{{item.price}}</text>
                      <view class="qty-stepper" catchtap="noop" wx:if="{{!item.invalid && item.stock > 0}}">
                        <view class="qty-btn {{item.count <= 1 ? 'disabled' : ''}}" catchtap="changeCount" hover-class="qty-btn-press" hover-stay-time="80" data-index="{{index}}" data-type="minus">−</view>
                        <text class="qty-val">{{item.count}}</text>
                        <view class="qty-btn {{item.count >= item.stock ? 'disabled' : ''}}" catchtap="changeCount" hover-class="qty-btn-press" hover-stay-time="80" data-index="{{index}}" data-type="add">+</view>
                      </view>
                    </view>
                  </view>
                </view>
              </view>

              <view class="swipe-action" catchtap="deleteItem" data-index="{{index}}" hover-class="tap-press" hover-stay-time="80">
                <view class="remove-btn">
                  <image class="remove-icon" src="/assets/icons/delete.png" mode="aspectFit"></image>
                  <text class="remove-txt">移除</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- 推荐 -->
      <view class="recommend-section" wx:if="{{collectionRecommendations.length > 0 && currentFolder === 'all'}}">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">YOU MAY ALSO LIKE</text><text class="mu-cn">你可能也喜欢</text></view></view>
        <scroll-view scroll-x class="recommend-scroll" enable-flex show-scrollbar="{{false}}">
          <view class="rec-card" wx:for="{{collectionRecommendations}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" hover-class="rec-card-hover">
            <view class="rec-img-wrap">
              <!-- 需求 11：敏感形态模糊（收藏推荐位此前封面直出） -->
              <sensitive-blur-gate
                enabled="{{item.sensitiveEnabled}}"
                product-id="{{item._id}}"
                size="card"
              >
                <image
                  class="rec-img"
                  wx:if="{{item.image || item.httpImage}}"
                  src="{{item.image || item.httpImage}}"
                  mode="aspectFill"
                  lazy-load
                  binderror="onRecommendImageError"
                  data-index="{{index}}"
                ></image>
                <view class="rec-img-ph" wx:else>
                  <image class="rec-img-ph-icon" src="/assets/icons/box.png" mode="aspectFit"></image>
                  <text class="rec-img-ph-text">暂无封面</text>
                </view>
              </sensitive-blur-gate>
            </view>
            <view class="rec-body">
              <text class="rec-title">{{item.title}}</text>
              <text class="rec-latin" wx:if="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
              <text class="rec-price">¥{{item.price}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="scroll-spacer"></view>
    </scroll-view>

    <!-- 空状态 -->
    <view class="empty-section scroll-panel" wx:else style="top: {{scrollTopPx}}px; height: {{scrollHeightPx}}px;">
      <view class="empty-hero">
        <view class="empty-icon-wrap">
          <image class="empty-icon" src="/assets/icons/tab-cart.png" mode="aspectFit"></image>
        </view>
        <text class="empty-overline">YOUR CART</text>
        <text class="empty-title" wx:if="{{loadError}}">购物车加载失败</text>
        <text class="empty-title" wx:elif="{{currentFolder === 'all'}}">购物车是空的</text>
        <text class="empty-title" wx:else>该分类暂无藏品</text>
        <text class="empty-desc" wx:if="{{loadError}}">请检查网络后重试</text>
        <text class="empty-desc" wx:elif="{{currentFolder === 'all'}}">在馆藏或藏品详情页加入购物车，待结算的藏品会出现在这里</text>
        <text class="empty-desc" wx:else>切换上方分类标签查看，或返回全部列表</text>
        <view class="empty-actions">
          <view class="empty-cta-primary" wx:if="{{loadError}}" bindtap="loadCollection" hover-class="empty-cta-press">
            <text>重新加载</text>
          </view>
          <view class="empty-cta-primary" wx:else bindtap="goHome" hover-class="empty-cta-press">
            <text>去逛逛</text>
          </view>
          <view class="empty-cta-secondary" wx:if="{{!loadError && currentFolder === 'all'}}" bindtap="goCategory" hover-class="empty-cta-secondary-press" hover-stay-time="80">
            <text>浏览馆藏</text>
          </view>
          <view class="empty-cta-secondary" wx:elif="{{!loadError}}" bindtap="switchToAll" hover-class="empty-cta-secondary-press" hover-stay-time="80">
            <text>返回全部</text>
          </view>
        </view>
      </view>

      <view class="recommend-section empty-rec" wx:if="{{collectionRecommendations.length > 0 && currentFolder === 'all'}}">
        <view class="mu-head"><view class="mu-head-t"><text class="mu-en">FOR YOU</text><text class="mu-cn">为你推荐</text></view></view>
        <scroll-view scroll-x class="recommend-scroll" enable-flex show-scrollbar="{{false}}">
          <view class="rec-card" wx:for="{{collectionRecommendations}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" hover-class="rec-card-hover">
            <view class="rec-img-wrap">
              <image
                class="rec-img"
                wx:if="{{item.image || item.httpImage}}"
                src="{{item.image || item.httpImage}}"
                mode="aspectFill"
                lazy-load
                binderror="onRecommendImageError"
                data-index="{{index}}"
              ></image>
              <view class="rec-img-ph" wx:else>
                <image class="rec-img-ph-icon" src="/assets/icons/box.png" mode="aspectFit"></image>
              </view>
            </view>
            <view class="rec-body">
              <text class="rec-title">{{item.title}}</text>
              <text class="rec-price">¥{{item.price}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="scroll-spacer empty-spacer"></view>
    </view>
  </block>

  <!-- 底部结算栏 -->
  <view class="checkout-bar safe-area" wx:if="{{!loading && cartList.length > 0}}">
    <!-- 需求 1：结账台「顺手带走一件」——像吧台口香糖，一次点按带走（¥10 以下优先，其次 ¥50 以下） -->
    <view class="addon-strip" wx:if="{{addonPick && addonText}}">
      <view class="addon-thumb-wrap" bindtap="goToDetail" data-id="{{addonPick.id}}" hover-class="tap-press" hover-stay-time="80">
        <image class="addon-thumb" wx:if="{{addonPick.image}}" src="{{addonPick.image}}" mode="aspectFill" lazy-load></image>
        <view class="addon-thumb-ph" wx:else>
          <image class="addon-thumb-ph-icon" src="/assets/icons/box.png" mode="aspectFit"></image>
        </view>
      </view>
      <view class="addon-copy" bindtap="goToDetail" data-id="{{addonPick.id}}" hover-class="tap-press" hover-stay-time="80">
        <text class="addon-title">{{addonText.title}}</text>
        <text class="addon-reason">{{addonText.reason}}</text>
      </view>
      <text class="addon-price">{{addonText.priceText}}</text>
      <view class="addon-cta" catchtap="takeCheckoutAddon" hover-class="tap-press" hover-stay-time="80">
        <text>{{addonText.cta}}</text>
      </view>
      <view class="addon-close" catchtap="dismissCheckoutAddon" hover-class="tap-press" hover-stay-time="80">×</view>
    </view>
    <!-- 2026-10-19 产品负责人「购物车整体质感优化，交互提升」：底部原来叠四层（漂浮礼券标签 + 顺手带走 + 结算栏 + 运费行）。
         包邮进度挪到结算栏上方（一条线）；礼券入口并进合计下方；结算栏顶部渐隐接清单。计算与流程一概不动。 -->
    <!-- 需求 2/3：免邮凑单 —— 未达包邮门槛时把「还差多少 + 加哪一件」说清；已包邮则回落到规则文案 -->
    <view class="freeship-row" wx:if="{{freeShip && !freeShip.reached}}">
      <view class="freeship-head">
        <text class="freeship-gap">{{freeShip.gapTitle}}</text>
        <text class="freeship-rule">{{freeShip.detailText}}</text>
      </view>
      <view class="freeship-track">
        <view class="freeship-fill" style="width: {{freeShip.progress}}%;"></view>
      </view>
      <view
        class="freeship-filler"
        wx:if="{{freeShip.filler}}"
        catchtap="takeGapFiller"
        hover-class="freeship-filler-press"
        hover-stay-time="80"
      >
        <text class="freeship-filler-text">{{freeShip.fillerText}}</text>
        <text class="freeship-filler-cta">加购 →</text>
      </view>
    </view>
    <view class="shipping-hint-row" wx:elif="{{shippingHint}}">
      <text class="shipping-hint">{{shippingHint}}</text>
    </view>

    <view class="bar-main">
      <view class="select-all" bindtap="toggleSelectAll" hover-class="tap-press" hover-stay-time="80">
        <view class="gold-checkbox sm {{allSelected ? 'checked' : ''}}">
          <view class="tick" wx:if="{{allSelected}}"><image src="/assets/icons/done.png" mode="aspectFit"></image></view>
        </view>
        <text class="select-label">全选</text>
      </view>

      <view class="total-block">
        <view class="total-main">
          <text class="total-label">合计</text>
          <text class="total-val" wx:if="{{selectedCount > 0}}">¥{{finalPrice}}</text>
          <text class="total-empty" wx:else>未选藏品</text>
        </view>
        <view class="total-row">
          <text class="total-hint" wx:if="{{vipSaved > 0}}">会员 -¥{{vipSaved}}</text>
          <view class="coupon-chip" bindtap="openCouponModal" hover-class="tap-press" hover-stay-time="80">
            <image class="coupon-icon" src="/assets/icons/coupon.png" mode="aspectFit"></image>
            <text wx:if="{{selectedCoupon && selectedCoupon.type === 'freeShipping'}}">免邮券</text>
            <text wx:elif="{{selectedCoupon && couponSaved > 0}}">礼券 -¥{{couponSaved}}</text>
            <text wx:elif="{{selectedCoupon}}">已选礼券</text>
            <text wx:else>礼券 · 选择</text>
            <text class="coupon-arr">›</text>
          </view>
        </view>
      </view>

      <view class="checkout-btn {{selectedCount === 0 ? 'disabled' : ''}}" bindtap="handleCheckout" hover-class="{{selectedCount === 0 ? '' : 'checkout-btn-hover'}}">
        <text>付款入藏</text>
        <text class="checkout-count" wx:if="{{selectedCount > 0}}">({{selectedCount}})</text>
      </view>
    </view>
  </view>

  <!-- 优惠券弹窗 -->
  <view class="ui-pop-mask coupon-mask" wx:if="{{showCouponModal}}" bindtap="closeCouponModal" catchtouchmove="true">
    <view class="ui-pop-sheet" catchtap="true">
      <view class="ui-pop-grip"></view>
      <view class="ui-pop-head">
        <text class="ui-pop-kicker">COUPONS</text>
        <text class="ui-pop-title">选择礼券</text>
        <text class="ui-pop-close" bindtap="closeCouponModal">✕</text>
      </view>
      <!-- 列表区按条数定高（券行约 156rpx、「不使用」行 112rpx），满 4 张再封顶 56vh：券少时不再空出半屏 -->
      <scroll-view scroll-y class="sheet-list" style="height: {{coupons.length >= 4 ? '56vh' : (coupons.length * 156 + 136) + 'rpx'}};" enhanced show-scrollbar="{{false}}">
        <view class="ui-pop-body">
          <view class="ui-pop-row {{!selectedCoupon ? 'is-on' : ''}}" bindtap="selectCoupon" data-index="-1" hover-class="tap-press-soft" hover-stay-time="80">
            <view class="ui-pop-row-main"><text class="ui-pop-row-t">不使用礼券</text></view>
            <view class="ui-pop-radio {{!selectedCoupon ? 'is-on' : ''}}"></view>
          </view>
          <view
            wx:for="{{coupons}}"
            wx:key="_id"
            class="ui-pop-row {{couponBaseAmount < item.minSpend ? 'is-off' : ''}} {{selectedCoupon._id === item._id ? 'is-on' : ''}}"
            bindtap="selectCoupon"
            data-index="{{index}}"
            hover-class="tap-press-soft"
            hover-stay-time="80"
          >
            <text class="ui-pop-row-lead">{{item.faceLabel || ('¥' + item.value)}}</text>
            <view class="ui-pop-row-main">
              <text class="ui-pop-row-t">{{item.title}}</text>
              <text class="ui-pop-row-d">{{item.minSpend > 0 ? '满 ¥' + item.minSpend + ' 可用' : '无门槛'}}</text>
              <text class="ui-pop-row-note" wx:if="{{item._save > 0}}">本单可省 ¥{{item._save}}</text>
              <text class="ui-pop-row-note is-off" wx:elif="{{item._reason}}">{{item._reason}}</text>
            </view>
            <view class="ui-pop-radio {{selectedCoupon._id === item._id ? 'is-on' : ''}}"></view>
          </view>
          <view class="ui-pop-empty" wx:if="{{!coupons.length}}">暂无可用礼券</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

<!-- 全站样式化轻提示（替代 wx.showToast）；详见 components/AppToast -->
<app-toast
  show="{{toastShow}}"
  overline="{{toastOverline}}"
  title="{{toastTitle}}"
  desc="{{toastDesc}}"
  duration="{{toastDuration}}"
  bind:close="onToastClose"
/>

<!-- 全站样式化弹窗宿主（替代 wx.showModal）；详见 utils/appModal.js -->
<app-modal id="appModal" />
