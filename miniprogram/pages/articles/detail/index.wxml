<!--pages/articles/detail/index.wxml-->
<view class="container">
  
  <!-- 1. 沉浸式 Header / 多图笔记 -->
  <view class="hero-area" wx:if="{{!article.images || article.images.length <= 1}}">
    <image class="hero-img" src="{{article.coverImage}}" mode="aspectFill" lazy-load></image>
    <view class="hero-overlay"></view>
    
    <view class="hero-text">
      <view class="article-category">
        <image class="category-icon" 
               src="{{categoryIcon}}" 
               mode="aspectFit"></image>
        <text>{{article.category === 'knowledge' ? '标本知识' : article.category === 'art' ? '艺术鉴赏' : article.category === 'craft' ? '制作工艺' : '藏品故事'}}</text>
      </view>
      <text class="article-title">{{article.title}}</text>
      <view class="article-meta">
        <text class="meta-item">{{article.author}}</text>
        <text class="meta-divider">•</text>
        <text class="meta-item">{{article.createTime ? (article.createTime < 86400000 ? '今日' : article.createTime < 604800000 ? '本周' : '更早') : ''}}</text>
      </view>
    </view>

    <view class="back-btn" style="top: {{statusBarHeight + 10}}px" bindtap="goBack">
      <text>←</text>
    </view>
  </view>

  <view class="note-gallery" wx:if="{{article.images && article.images.length > 1}}">
    <swiper class="gallery-swiper" indicator-dots indicator-color="rgba(255,255,255,0.3)" indicator-active-color="#C4A76C">
      <swiper-item wx:for="{{article.images}}" wx:key="*this">
        <image class="gallery-img" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
    <view class="gallery-head">
      <view class="article-category">
        <image class="category-icon" src="{{categoryIcon}}" mode="aspectFit"></image>
        <text>{{article.category === 'knowledge' ? '标本知识' : article.category === 'art' ? '艺术鉴赏' : article.category === 'craft' ? '制作工艺' : '藏品故事'}}</text>
      </view>
      <text class="article-title gallery-title">{{article.title}}</text>
      <view class="article-meta">
        <text class="meta-item">{{article.author}}</text>
      </view>
    </view>
    <view class="back-btn gallery-back" style="top: {{statusBarHeight + 10}}px" bindtap="goBack">
      <text>←</text>
    </view>
  </view>

  <!-- 2. 正文内容 -->
  <view class="article-body">
    
    <!-- 摘要 -->
    <view class="intro-text" wx:if="{{article.brief}}">
      <text>"{{article.brief}}"</text>
    </view>

    <!-- 标签 -->
    <view class="tags-container" wx:if="{{article.tags && article.tags.length > 0}}">
      <text class="tag-item" wx:for="{{article.tags}}" wx:key="*this">{{item}}</text>
    </view>

    <!-- 富文本内容 -->
    <view class="rich-text-container">
      <mp-html 
        content="{{article.content}}" 
        tag-style="{{tagStyle}}" 
        container-style="color:#ccc;"
      />
    </view>

    <!-- 视频播放 -->
    <view class="video-container" wx:if="{{article.videoUrl}}">
      <video 
        id="article-video"
        src="{{article.videoUrl}}" 
        controls 
        poster="{{article.coverImage}}" 
        class="article-video"
        bindplay="onVideoPlay"
        bindpause="onVideoPause"
        bindended="onVideoEnd"
        show-center-play-btn="{{true}}"
        enable-play-gesture="{{true}}"
        show-play-btn="{{true}}"
        show-fullscreen-btn="{{true}}"
        show-progress="{{true}}"
        object-fit="contain"
      ></video>
      <view class="video-controls" wx:if="{{showVideoControls}}">
        <view class="control-item" bindtap="toggleVideoSpeed">
          <text>{{videoSpeed}}x</text>
        </view>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-bar">
      <view class="stat-item">
        <image class="stat-icon" src="{{iconView}}" mode="aspectFit"></image>
        <text class="stat-value">{{article.stats.views || 0}}</text>
      </view>
      <view class="stat-item" bindtap="toggleLike">
        <image class="stat-icon {{isLiked ? 'liked' : ''}}" 
               src="{{isLiked ? iconLikeActive : iconLike}}" 
               mode="aspectFit"></image>
        <text class="stat-value">{{article.stats.likes || 0}}</text>
      </view>
      <view class="stat-item" bindtap="toggleCollect">
        <image class="stat-icon {{isCollected ? 'collected' : ''}}" 
               src="{{isCollected ? iconCollectActive : iconCollect}}" 
               mode="aspectFit"></image>
        <text class="stat-value">收藏</text>
      </view>
    </view>

  </view>

  <!-- 3. 相关文章推荐 -->
  <view class="related-section" wx:if="{{relatedArticles.length > 0}}">
      <view class="section-head">
        <text class="section-overline">RELATED</text>
        <text class="section-title">相关推荐</text>
      </view>
    <view class="related-list">
      <view class="related-item" wx:for="{{relatedArticles}}" wx:key="_id" 
            bindtap="goToRelatedArticle" data-id="{{item._id}}">
        <image class="related-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
        <view class="related-content">
          <text class="related-title">{{item.title}}</text>
          <text class="related-brief" wx:if="{{item.brief}}">{{item.brief}}</text>
          <view class="related-stats">
            <view class="related-stat">
              <image class="related-stat-icon" src="{{iconView}}" mode="aspectFit"></image>
              <text>{{item.stats.views || 0}}</text>
            </view>
            <view class="related-stat">
              <image class="related-stat-icon" src="{{iconLike}}" mode="aspectFit"></image>
              <text>{{item.stats.likes || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view style="height: 100rpx;"></view>

</view>

