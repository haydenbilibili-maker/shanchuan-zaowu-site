<!--pages/store/index.wxml-->
<view class="page-store">
  <view class="grain-overlay"></view>

  <view class="sticky-top" style="padding-top: {{statusBarHeight}}px; padding-right: {{navPaddingRight}}px;">
    <view class="store-switcher" bindtap="toggleStorePicker">
      <view class="switcher-main">
        <text class="switcher-label">ZHEIYUSHAN · STORE</text>
        <text class="switcher-name">{{store.name || '这有店'}}</text>
        <text class="switcher-sub" wx:if="{{store}}">{{store.locationLabel}} · {{store.roleLabel}}</text>
      </view>
      <text class="switcher-arrow">{{storePickerOpen ? '▲' : '▼'}}</text>
    </view>
    <scroll-view scroll-x class="store-pills" wx:if="{{stores.length > 1 && store}}" enhanced show-scrollbar="{{false}}">
      <view
        class="store-pill {{item.storeId === store.storeId ? 'active' : ''}}"
        wx:for="{{stores}}"
        wx:key="storeId"
        bindtap="quickSelectStore"
        data-id="{{item.storeId}}"
      >
        <text class="pill-name">{{item.name}}</text>
        <text class="pill-loc">{{item.locationLabel}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="picker-mask" wx:if="{{storePickerOpen}}" bindtap="closeStorePicker"></view>
  <view class="picker-sheet {{storePickerOpen ? 'open' : ''}}" style="padding-top: {{statusBarHeight + 8}}px;">
    <text class="picker-title">选择门店</text>
    <view
      class="picker-item {{item.storeId === store.storeId ? 'active' : ''}}"
      wx:for="{{stores}}"
      wx:key="storeId"
      bindtap="selectStore"
      data-id="{{item.storeId}}"
    >
      <image wx:if="{{item.coverImage}}" class="picker-thumb" src="{{item.coverImage}}" mode="aspectFill"></image>
      <view class="picker-body">
        <text class="picker-name">{{item.name}}</text>
        <text class="picker-loc">{{item.locationLabel}}</text>
        <text class="picker-role">{{item.roleLabel}}</text>
      </view>
      <text class="picker-check" wx:if="{{item.storeId === store.storeId}}">✓</text>
    </view>
  </view>

  <scroll-view scroll-y class="main-scroll" style="top: {{scrollTop}}px;" wx:if="{{!loading && store}}">
    <view class="hero" bindtap="previewHero">
      <image wx:if="{{store.coverImage}}" class="hero-img" src="{{store.coverImage}}" mode="aspectFill"></image>
      <view class="hero-placeholder" wx:else></view>
      <view class="hero-mask"></view>
      <view class="hero-closed-badge" wx:if="{{bookingClosedToday}}">
        <text>{{closedReasonLabel || '今日店休'}}</text>
      </view>
      <view class="hero-text">
        <text class="hero-overline">{{store.nameEn}}</text>
        <text class="hero-title">{{store.name}}</text>
        <text class="hero-tagline">{{store.heroTagline}}</text>
        <view class="hero-hours-row">
          <text class="hero-hours">{{store.hoursText}}</text>
          <text class="status-dot {{bookingClosedToday ? 'closed' : store.openStatus.statusClass}}"></text>
          <text class="status-label {{bookingClosedToday ? 'closed' : store.openStatus.statusClass}}">
            {{bookingClosedToday ? (closedReasonLabel || '今日店休') : store.openStatus.label}}
          </text>
        </view>
        <text class="hero-preview-hint" wx:if="{{store.coverImage}}">轻触查看大图</text>
      </view>
    </view>

    <view class="action-row">
      <view class="action-btn" bindtap="openMap" hover-class="action-btn-hover">
        <image class="action-icon-img" src="/assets/icons/map.png" mode="aspectFit"></image>
        <text>导航</text>
      </view>
      <view class="action-btn" bindtap="callStore" hover-class="action-btn-hover">
        <image class="action-icon-img" src="/assets/icons/phone.png" mode="aspectFit"></image>
        <text>电话</text>
      </view>
      <view
        class="action-btn primary {{bookingClosedToday ? 'disabled' : ''}}"
        bindtap="goBooking"
        data-tab="0"
        hover-class="{{bookingClosedToday ? '' : 'action-btn-primary-hover'}}"
      >
        <text>{{bookingClosedToday ? '暂不可约' : '预约参观'}}</text>
      </view>
    </view>
    <text class="booking-closed-hint" wx:if="{{bookingClosedToday}}">今日暂停预约，导航与电话咨询仍可用</text>

    <view class="section section-compact">
      <view class="section-header-compact">
        <view class="title-group">
          <text class="t-cn">展陈导览</text>
          <text class="t-en">EXHIBITION</text>
        </view>
      </view>
      <view class="zone-grid">
        <view
          class="zone-card"
          wx:for="{{store.zones}}"
          wx:key="zoneId"
          bindtap="goZone"
          data-id="{{item.zoneId}}"
        >
          <image wx:if="{{item.coverImage}}" class="zone-bg" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="zone-overlay"></view>
          <view class="zone-content">
            <text class="zone-overline" style="color: {{item.color}}">{{item.overline}}</text>
            <text class="zone-title">{{item.title}}</text>
            <text class="zone-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section section-compact" wx:if="{{hasExperienceProducts || experienceLoading}}">
      <view class="section-header-compact">
        <view class="title-group">
          <text class="t-cn">店内可体验</text>
          <text class="t-en">IN STORE</text>
        </view>
      </view>
      <scroll-view scroll-x class="exp-scroll" enhanced show-scrollbar="{{false}}">
        <view class="exp-track">
          <view
            class="exp-card"
            wx:for="{{experienceProducts}}"
            wx:key="_id"
            bindtap="goExperienceProduct"
            data-id="{{item._id}}"
            hover-class="exp-card-hover"
          >
            <image class="exp-img" src="{{item.image}}" mode="aspectFill"></image>
            <view class="exp-body">
              <text class="exp-title">{{item.title}}</text>
              <text class="exp-latin" wx:if="{{item.latinName}}">{{item.latinName}}</text>
              <text class="exp-price">¥{{item.priceText}}</text>
            </view>
          </view>
          <view class="exp-loading" wx:if="{{experienceLoading}}">
            <text>加载中…</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="section section-compact" wx:if="{{hasActivities}}">
      <view class="section-header-compact">
        <view class="title-group">
          <text class="t-cn">本店活动</text>
          <text class="t-en">EVENTS</text>
        </view>
      </view>
      <view class="section-card section-card-pad">
        <view
          class="activity-card"
          wx:for="{{storeActivities}}"
          wx:key="_id"
          bindtap="goActivity"
          data-type="{{item.type === 'handcraft_course' || item.type === 'course' ? 'course' : 'activity'}}"
          hover-class="activity-card-hover"
        >
        <view class="activity-main">
          <text class="activity-tag">{{item.type === 'handcraft_course' || item.type === 'course' ? '手作课程' : '特别活动'}}</text>
          <text class="activity-title">{{item.title}}</text>
          <text class="activity-meta">{{item.date}} {{item.time || ''}}</text>
        </view>
        <text class="activity-arr">报名 →</text>
        </view>
      </view>
    </view>

    <view class="section section-compact">
      <view class="section-header-compact">
        <view class="title-group">
          <text class="t-cn">本店服务</text>
          <text class="t-en">IN-STORE</text>
        </view>
      </view>
      <view class="section-card">
        <view
          class="service-row {{index === store.services.length - 1 ? 'last' : ''}}"
          wx:for="{{store.services}}"
          wx:key="id"
          wx:for-index="index"
          bindtap="goService"
          data-tab="{{item.tab}}"
          data-path="{{item.path}}"
          hover-class="service-row-hover"
        >
          <text class="service-name">{{item.label}}</text>
          <text class="service-arr">→</text>
        </view>
      </view>
    </view>

    <view class="section section-compact info-section" wx:if="{{store.walkingGuide}}">
      <view class="section-header-compact">
        <view class="title-group">
          <text class="t-cn">双店动线</text>
          <text class="t-en">WALKING GUIDE</text>
        </view>
      </view>
      <view class="walking-plate">
        <view class="walking-head" bindtap="toggleWalkingGuide">
          <view class="walking-head-main">
            <text class="walking-headline">{{store.walkingGuide.headline}}</text>
            <text class="walking-peer" wx:if="{{store.walkingGuide.peerName}}">前往 {{store.walkingGuide.peerName}} · {{store.walkingGuide.peerLocation}}</text>
          </view>
          <text class="walking-toggle">{{walkingGuideOpen ? '−' : '+'}}</text>
        </view>
        <view class="walking-body" wx:if="{{walkingGuideOpen}}">
          <view class="walking-step" wx:for="{{store.walkingGuide.steps}}" wx:key="*this">
            <text class="walking-step-num">{{index + 1}}</text>
            <text class="walking-step-text">{{item}}</text>
          </view>
          <text class="walking-tip" wx:if="{{store.walkingGuide.tip}}">{{store.walkingGuide.tip}}</text>
          <view class="walking-peer-btn" bindtap="goPeerStore" hover-class="walking-peer-btn-hover">
            <text>切换到 {{store.walkingGuide.peerName}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section section-compact info-section">
      <view class="section-header-compact">
        <view class="title-group">
          <text class="t-cn">到店指南</text>
          <text class="t-en">VISIT</text>
        </view>
      </view>

      <view class="info-plate">
        <view class="plate-accent"></view>

        <view class="plate-header">
          <view class="plate-title-wrap">
            <text class="plate-overline">{{store.roleLabel}} · {{store.locationLabel}}</text>
            <text class="plate-title">{{store.name}}</text>
          </view>
          <view class="plate-status-badge {{bookingClosedToday ? 'closed' : store.openStatus.statusClass}}">
            <text class="status-dot {{bookingClosedToday ? 'closed' : store.openStatus.statusClass}}"></text>
            <text>{{bookingClosedToday ? (closedReasonLabel || '今日店休') : store.openStatus.label}}</text>
          </view>
        </view>

        <view class="plate-intro-wrap" bindtap="toggleIntro">
          <text class="plate-intro {{introExpanded ? 'expanded' : ''}}">{{store.intro}}</text>
          <text class="plate-intro-toggle">{{introExpanded ? '收起' : '展开'}}</text>
        </view>

        <view class="info-map-wrap" bindtap="openMap">
          <map
            class="info-map"
            latitude="{{store.latitude}}"
            longitude="{{store.longitude}}"
            markers="{{store.mapMarkers}}"
            enable-scroll="{{false}}"
            enable-zoom="{{false}}"
            show-location="{{false}}"
          ></map>
          <view class="info-map-mask">
            <text class="info-map-cta">TAP TO NAVIGATE · 点击导航</text>
          </view>
        </view>

        <view class="info-grid">
          <view class="info-cell info-cell-full" bindtap="copyAddress" hover-class="info-cell-hover">
            <text class="cell-label">地址 · ADDRESS</text>
            <text class="cell-val">{{store.address}}</text>
            <text class="cell-action">复制</text>
          </view>

          <view class="info-cell">
            <text class="cell-label">商场 · MALL</text>
            <text class="cell-val">{{store.mallName}}</text>
          </view>
          <view class="info-cell">
            <text class="cell-label">楼层 · FLOOR</text>
            <text class="cell-val">{{store.floor}}</text>
          </view>

          <view class="info-cell">
            <text class="cell-label">营业 · HOURS</text>
            <text class="cell-val">{{store.hoursText}}</text>
          </view>
          <view class="info-cell info-cell-tap" bindtap="callStore" hover-class="info-cell-hover">
            <text class="cell-label">电话 · TEL</text>
            <text class="cell-val cell-val-gold">{{store.phone}}</text>
            <text class="cell-action">拨打</text>
          </view>
          <view class="info-cell info-cell-tap" bindtap="copyWebsite" hover-class="info-cell-hover">
            <text class="cell-label">官网 · WEB</text>
            <text class="cell-val cell-val-gold">{{brandWebsite}}</text>
            <text class="cell-action">复制</text>
          </view>
        </view>

        <view class="visit-tips" wx:if="{{store.visitTips.length}}">
          <view class="tips-head" bindtap="toggleTips">
            <text class="tips-label">到店提示 · NOTES</text>
            <text class="tips-toggle">{{tipsExpanded ? '−' : '+'}}</text>
          </view>
          <view class="tips-list" wx:if="{{tipsExpanded}}">
            <view class="tips-item" wx:for="{{store.visitTips}}" wx:key="*this">
              <text class="tips-dot"></text>
              <text class="tips-text">{{item}}</text>
            </view>
          </view>
        </view>

        <view class="feature-tags">
          <text class="feature-tag" wx:for="{{store.features}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="scroll-pad"></view>
  </scroll-view>

  <view
    class="checkin-fab {{checkInLoading ? 'loading' : ''}} {{checkedInToday ? 'done' : ''}}"
    wx:if="{{!loading && store}}"
    bindtap="onCheckIn"
    hover-class="{{checkedInToday ? '' : 'checkin-fab-hover'}}"
  >
    <text class="checkin-fab-label">{{checkedInToday ? '今日已签到' : '我已到店'}}</text>
  </view>

  <view class="lbs-mask" wx:if="{{lbsSheetOpen}}" bindtap="dismissLbsSheet"></view>
  <view class="lbs-sheet {{lbsSheetOpen ? 'open' : ''}}" wx:if="{{lbsSuggestStore}}">
    <text class="lbs-title">您附近</text>
    <text class="lbs-store-name">{{lbsSuggestStore.name}}</text>
    <text class="lbs-meta">{{lbsSuggestStore.locationLabel}} · {{lbsSuggestStore.distanceText}}</text>
    <text class="lbs-desc">是否切换到该门店？</text>
    <view class="lbs-actions">
      <view class="lbs-btn secondary" bindtap="dismissLbsSheet">暂不</view>
      <view class="lbs-btn primary" bindtap="confirmLbsSwitch">切换</view>
    </view>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}"><text>加载门店...</text></view>
</view>
