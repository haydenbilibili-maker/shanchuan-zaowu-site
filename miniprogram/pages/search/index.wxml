<!--pages/search/index.wxml-->
<view class="container">
  
  <!-- 1. 顶部：全息检索栏 -->
  <view class="search-header" style="padding-top: {{statusBarHeight}}px">
    <view class="header-inner">
      <view class="back-btn" bindtap="goBack">✕</view>
      
      <view class="search-input-wrapper">
        <view class="search-input-box {{keyword.length > 0 ? 'active' : ''}}">
          <view class="input-glare"></view>
          <icon type="search" size="14" color="{{keyword.length > 0 ? '#C4A76C' : '#666'}}"></icon>
          <input 
            class="input" 
            placeholder="{{scopeCategoryName ? scopeCategoryName + ' · 搜索档案与藏品' : '搜索标本档案与藏品'}}" 
            placeholder-class="ph-style"
            value="{{keyword}}"
            bindinput="onInput"
            bindconfirm="doSearch"
            bindfocus="onInputFocus"
            confirm-type="search"
            focus="{{true}}"
          />
          <view class="clear-btn" wx:if="{{keyword.length > 0}}" bindtap="clearInput">清除</view>
        </view>
        
        <!-- 搜索建议下拉框 -->
        <view class="suggestions-box" wx:if="{{showSuggestions && suggestions.length > 0}}">
          <block wx:for="{{suggestions}}" wx:key="*this">
            <view class="suggestion-item" bindtap="selectSuggestion" data-text="{{item}}">
              <icon type="search" size="12" color="#999"></icon>
              <text class="suggestion-text">{{item}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
    <view class="scope-row" wx:if="{{scopeCategoryName}}">
      <view class="scope-chip">
        <text class="scope-label">范围</text>
        <text class="scope-name">{{scopeCategoryName}}</text>
      </view>
      <view class="scope-clear" bindtap="clearCategoryScope">全部品类</view>
    </view>
  </view>

  <!-- 2. 内容区 -->
  <scroll-view scroll-y="true" class="search-body" enable-flex="true">
    
    <!-- A. 默认状态 -->
    <view class="default-zone" wx:if="{{!isSearching}}">
      <view class="zone-section">
        <view class="section-title">
          <view class="title-left">
            <text class="cn">热门检索</text>
            <text class="en">TRENDING</text>
          </view>
        </view>
        <view class="chip-matrix">
          <block wx:for="{{hotKeys}}" wx:key="*this">
            <view class="chip hot" bindtap="tapHotKey" data-text="{{item}}">
              <view class="chip-corner"></view>
              <text class="chip-text"># {{item}}</text>
            </view>
          </block>
          <!-- 加载状态 -->
          <view class="chip loading" wx:if="{{loadingHotKeys}}">
            <text class="chip-text">加载中...</text>
          </view>
        </view>
      </view>

      <view class="zone-section" wx:if="{{historyList.length > 0}}">
        <view class="section-title">
          <view class="title-left">
            <text class="cn">检索日志</text>
            <text class="en">HISTORY LOG</text>
          </view>
          <view class="trash-icon" bindtap="clearHistory"><image src="/assets/icons/delete.png" mode="aspectFit"></image></view>
        </view>
        <view class="chip-matrix">
          <block wx:for="{{historyList}}" wx:key="timestamp">
            <view class="chip history-chip" bindtap="tapHistory" data-text="{{item.keyword}}">
              <text class="chip-text">{{item.keyword}}</text>
              <!-- 显示相对时间 -->
              <text class="chip-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
            </view>
          </block>
        </view>
      </view>

      <!-- 空状态提示 -->
      <view class="empty-hint" wx:if="{{historyList.length === 0}}">
        <view class="hint-icon"><image src="/assets/icons/search.png" mode="aspectFit" class="icon-gold"></image></view>
        <text class="hint-text">开始你的探索之旅</text>
        <text class="hint-sub">输入关键词搜索，或点击热门标签</text>
      </view>
    </view>

    <!-- B. 搜索结果 -->
    <view class="result-zone" wx:else>
      
      <!-- 扫描层 -->
      <view class="scan-overlay" wx:if="{{isScanning}}">
         <view class="laser-beam"></view><view class="scan-grid"></view>
      </view>

      <!-- Loading -->
      <view class="loading-box" wx:if="{{loading}}">
        <view class="loader-ring"></view><text>正在检索...</text>
      </view>

      <block wx:else>
        <view class="result-filter">
          <view class="filter-chip {{resultMode === 'all' ? 'active' : ''}}" bindtap="switchResultMode" data-mode="all">全部</view>
          <view class="filter-chip {{resultMode === 'product' ? 'active' : ''}}" bindtap="switchResultMode" data-mode="product">商品</view>
        </view>

        <block wx:if="{{resultMode === 'product'}}">
          <product-list keyword="{{keyword}}" category="{{scopeCategory}}" page-size="{{12}}" bind:itemtap="goToProduct" />
        </block>

        <block wx:else>
        <view class="result-meta" wx:if="{{resultList.length > 0}}">
          <text>找到 {{resultList.length}} 条结果</text><view class="meta-line"></view>
        </view>

        <!-- 混合结果列表 -->
        <view class="archive-list">
          <block wx:for="{{resultList}}" wx:key="_id">
            <view 
              class="archive-card slide-in" 
              style="animation-delay: {{index * 0.05}}s"
              bindtap="goToTarget" 
              data-id="{{item._id}}" 
              data-type="{{item.type}}">
              
              <view class="ac-img">
                <image src="{{item.image}}" mode="aspectFill"></image>
                <view class="ac-mask"></view>
              </view>
              
              <view class="ac-info">
                <view class="ac-top">
                  <text class="ac-latin">{{item.subTitle}}</text>
                  <text class="ac-title">{{item.title}}</text>
                </view>
                <view class="ac-btm">
                  <view class="tag {{item.type}}">{{item.tag}}</view>
                  <!-- 价格仅针对商品和活动 -->
                  <text class="ac-price" wx:if="{{item.price}}">¥{{item.price}}</text>
                </view>
              </view>
              
              <view class="ac-arr">→</view>
            </view>
          </block>
        </view>

        <view class="empty-state" wx:if="{{resultList.length === 0}}">
          <view class="empty-icon">∅</view>
          <text>未找到匹配结果</text><text class="empty-sub">未检索到相关档案</text>
        </view>
        </block>
      </block>

    </view>

  </scroll-view>
</view>