/* pages/search/index.wxss */
page { 
  background-color: #1A1814; 
  color: #fff; 
  font-family: "PingFang SC", sans-serif; 
  height: 100%; 
  overflow: hidden; 
}
view, text, image, input, scroll-view { box-sizing: border-box; }

.container { height: 100%; display: flex; flex-direction: column; }

/* 顶部栏 */
.search-header { 
  width: 100%; 
  padding: 20rpx 30rpx; 
  background: linear-gradient(180deg, rgba(0,0,0,0.98), rgba(10,10,10,0.95)); 
  border-bottom: 1px solid rgba(196, 167, 108,0.15); 
  z-index: 10;
  backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
}
.header-inner { 
  display: flex; 
  align-items: center; 
  height: 80rpx;
  position: relative;
}

.search-input-wrapper {
  flex: 1;
  position: relative;
}

.scope-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.scope-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 20rpx;
  background: rgba(196, 167, 108, 0.12);
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: 9999px;
}

.scope-label {
  font-size: 20rpx;
  color: #6B6560;
}

.scope-name {
  font-size: 24rpx;
  color: #C4A76C;
}

.scope-clear {
  font-size: 22rpx;
  color: #A09A90;
  padding: 8rpx 12rpx;
}

.scope-clear:active {
  color: #C4A76C;
}
.back-btn { 
  font-size: 36rpx; 
  color: rgba(196, 167, 108,0.9); 
  padding: 10rpx 24rpx 10rpx 0; 
  font-weight: bold; 
  transition: all 0.3s;
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.4);
}
.back-btn:active {
  color: var(--gold);
  transform: scale(0.9);
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.6);
}

.search-input-box {
  flex: 1; 
  height: 76rpx; 
  background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(20,20,20,0.85)); 
  border: 2px solid rgba(196, 167, 108,0.2); 
  border-radius: 38rpx; 
  display: flex; 
  align-items: center; 
  padding: 0 28rpx; 
  position: relative; 
  overflow: visible; 
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.5),
    0 0 16rpx rgba(196, 167, 108,0.05),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(12px);
}
.search-input-box.active { 
  border-color: rgba(196, 167, 108,0.5); 
  box-shadow: 
    0 6rpx 20rpx rgba(0,0,0,0.6),
    0 0 24rpx rgba(196, 167, 108,0.25),
    inset 0 1rpx 3rpx rgba(255,255,255,0.1);
}
.input-glare {
  position: absolute; 
  top: 0; 
  left: -100%; 
  width: 50%; 
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108,0.15), rgba(255,255,255,0.1), rgba(196, 167, 108,0.15), transparent);
  transform: skewX(-20deg); 
  pointer-events: none;
  z-index: 0;
}
.search-input-box.active .input-glare { animation: scanMove 2.5s infinite linear; }
@keyframes scanMove { 0% { left: -100%; } 100% { left: 200%; } }
.input { 
  flex: 1; 
  font-size: 28rpx; 
  color: #fff; 
  margin-left: 16rpx; 
  height: 100%; 
  font-family: 'DIN'; 
  letter-spacing: 1.5rpx; 
  position: relative;
  z-index: 1;
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.2);
}
.ph-style { 
  color: rgba(196, 167, 108,0.4); 
  letter-spacing: 2rpx; 
  font-size: 24rpx; 
}
.clear-btn { 
  color: rgba(196, 167, 108,0.7); 
  font-size: 22rpx; 
  font-weight: bold; 
  padding: 10rpx 16rpx; 
  border-radius: 8rpx;
  transition: all 0.3s;
  position: relative;
  z-index: 1;
}
.clear-btn:active {
  color: var(--gold);
  background: rgba(196, 167, 108,0.1);
  transform: scale(0.95);
}

/* 搜索建议下拉框 */
.suggestions-box {
  position: absolute;
  top: calc(100% + 12rpx);
  left: 0;
  right: 0;
  background: linear-gradient(135deg, rgba(0,0,0,0.98), rgba(15,15,15,0.95));
  border: 2px solid rgba(196, 167, 108,0.35);
  border-radius: 24rpx;
  padding: 12rpx 0;
  backdrop-filter: blur(20px) saturate(180%);
  box-shadow: 
    0 12rpx 32rpx rgba(0,0,0,0.8),
    0 0 40rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 3rpx rgba(255,255,255,0.1),
    inset 0 -1rpx 2rpx rgba(0,0,0,0.3);
  z-index: 200;
  max-height: 480rpx;
  overflow-y: auto;
  animation: slideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.suggestion-item {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-bottom: 1px solid rgba(196, 167, 108,0.08);
  position: relative;
  overflow: hidden;
}

.suggestion-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(180deg, var(--gold), rgba(196, 167, 108,0.6));
  opacity: 0;
  transition: opacity 0.3s;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item:active {
  background: linear-gradient(90deg, rgba(196, 167, 108,0.15), rgba(196, 167, 108,0.05));
  transform: translateX(8rpx);
  border-bottom-color: rgba(196, 167, 108,0.2);
}

.suggestion-item:active::before {
  opacity: 1;
}

.suggestion-item icon {
  margin-right: 20rpx;
  opacity: 0.5;
  transition: all 0.3s;
}

.suggestion-item:active icon {
  opacity: 0.9;
  color: var(--gold);
}

.suggestion-text {
  font-size: 28rpx;
  color: #fff;
  letter-spacing: 1.5rpx;
  flex: 1;
  font-weight: 500;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.5);
  transition: all 0.3s;
}

.suggestion-item:active .suggestion-text {
  color: var(--gold);
  text-shadow: 
    0 0 12rpx rgba(196, 167, 108,0.6),
    0 1rpx 3rpx rgba(0,0,0,0.5);
}

/* 内容区 */
.search-body { flex: 1; width: 100%; }
.default-zone { 
  padding: 50rpx 30rpx 80rpx; 
  animation: fadeInUp 0.6s ease-out;
}
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.zone-section { 
  margin-bottom: 70rpx; 
  animation: fadeInUp 0.6s ease-out;
  animation-fill-mode: both;
}
.zone-section:nth-child(1) { animation-delay: 0.1s; }
.zone-section:nth-child(2) { animation-delay: 0.2s; }
.section-title { 
  display: flex; 
  justify-content: space-between; 
  align-items: flex-end; 
  margin-bottom: 32rpx; 
  border-left: 6rpx solid var(--gold); 
  padding-left: 24rpx; 
  position: relative;
  padding-bottom: 8rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, var(--gold), rgba(196, 167, 108,0.7), var(--gold));
  box-shadow: 
    0 0 16rpx rgba(196, 167, 108,0.5),
    inset 0 0 8rpx rgba(255,255,255,0.1);
  animation: borderGlow 2s ease-in-out infinite;
}
@keyframes borderGlow {
  0%, 100% { opacity: 0.8; }
  50% { opacity: 1; }
}
.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, var(--gold), transparent);
  box-shadow: none;
}
.title-left { display: flex; flex-direction: column; }
.cn { 
  font-size: 32rpx; 
  font-weight: 900; 
  color: #fff; 
  line-height: 1.2; 
  margin-bottom: 8rpx; 
  font-family: 'Times New Roman', serif;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
  letter-spacing: 1rpx;
}
.en { 
  font-family: 'DIN'; 
  font-size: 20rpx; 
  color: var(--gold); 
  letter-spacing: 3rpx; 
  font-weight: bold; 
  text-shadow: 
    0 0 12rpx rgba(196, 167, 108,0.4),
    0 1rpx 3rpx rgba(0,0,0,0.5);
}
.trash-icon { 
  width: 32rpx; 
  height: 32rpx; 
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(196, 167, 108,0.7); 
  padding: 12rpx; 
  border-radius: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: rgba(196, 167, 108,0.05);
  border: 1px solid rgba(196, 167, 108,0.2);
  backdrop-filter: blur(8px);
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
}
.trash-icon image {
  width: 32rpx;
  height: 32rpx;
}
.trash-icon:active {
  color: var(--gold);
  background: rgba(196, 167, 108,0.15);
  border-color: rgba(196, 167, 108,0.4);
  transform: scale(0.92);
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.4),
    0 0 16rpx rgba(196, 167, 108,0.3),
    inset 0 1rpx 3rpx rgba(255,255,255,0.1);
}
.chip-matrix { 
  display: flex; 
  flex-wrap: wrap; 
  gap: 20rpx; 
  margin-top: 8rpx;
}
.chip {
  background: linear-gradient(135deg, rgba(0,0,0,0.9), rgba(15,15,15,0.85)); 
  border: 2px solid rgba(196, 167, 108,0.25); 
  padding: 18rpx 36rpx;
  font-size: 26rpx; 
  color: rgba(196, 167, 108,0.9); 
  border-radius: 32rpx; 
  position: relative; 
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); 
  overflow: hidden;
  box-shadow: 
    0 6rpx 16rpx rgba(0,0,0,0.6),
    0 0 20rpx rgba(196, 167, 108,0.08),
    inset 0 1rpx 3rpx rgba(255,255,255,0.08);
  backdrop-filter: blur(12px) saturate(150%);
  font-weight: 700;
  letter-spacing: 1.5rpx;
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 历史搜索芯片样式（支持时间显示） */
.history-chip {
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 28rpx;
  gap: 6rpx;
}

.chip-text {
  line-height: 1.4;
}

.chip-time {
  font-size: 20rpx;
  color: rgba(196, 167, 108,0.5);
  font-weight: 400;
  line-height: 1;
  font-family: 'DIN', sans-serif;
  letter-spacing: 0.5rpx;
}

.chip::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.25), rgba(196, 167, 108,0.08), rgba(196, 167, 108,0.25));
  background-size: 200% 100%;
  opacity: 0;
  transition: opacity 0.4s;
  animation: chipShine 3s ease-in-out infinite;
}
@keyframes chipShine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
.chip:active { 
  background: linear-gradient(135deg, rgba(196, 167, 108,0.98), rgba(196, 167, 108,0.9)); 
  color: #1A1814; 
  border-color: var(--gold); 
  box-shadow: 
    0 0 32rpx rgba(196, 167, 108,0.7),
    0 8rpx 20rpx rgba(0,0,0,0.6),
    inset 0 1rpx 4rpx rgba(255,255,255,0.4),
    inset 0 -1rpx 2rpx rgba(0,0,0,0.2);
  transform: scale(0.97) translateY(-2rpx);
}
.chip:active::before {
  opacity: 0.8;
}
.chip.hot { 
  border-color: rgba(196, 167, 108,0.4); 
  color: rgba(196, 167, 108,1); 
  box-shadow: 
    0 6rpx 18rpx rgba(0,0,0,0.6),
    0 0 24rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 3rpx rgba(255,255,255,0.1);
  position: relative;
}
.chip.hot::after {
  content: 'HOT';
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: linear-gradient(135deg, var(--gold), rgba(196, 167, 108,0.8));
  color: #1A1814;
  font-size: 16rpx;
  font-weight: 900;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-family: 'DIN', sans-serif;
  letter-spacing: 1rpx;
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.5),
    0 0 12rpx rgba(196, 167, 108,0.5);
  transform: rotate(12deg);
  z-index: 1;
}
.chip-corner {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 24rpx 24rpx 0;
  border-color: transparent rgba(196, 167, 108,0.4) transparent transparent;
  filter: drop-shadow(0 0 8rpx rgba(196, 167, 108,0.3));
}

.chip-text {
  position: relative;
  z-index: 1;
  white-space: nowrap;
}

/* 结果区域 */
.result-zone { padding: 0 30rpx 60rpx; position: relative; }
.scan-overlay { 
  position: absolute; 
  top: 0; 
  left: 0; 
  width: 100%; 
  height: 100%; 
  pointer-events: none; 
  z-index: 5; 
  overflow: hidden; 
}
.laser-beam {
  position: absolute; 
  top: 0; 
  left: 0; 
  width: 100%; 
  height: 3rpx;
  background: linear-gradient(to right, transparent, var(--gold), rgba(196, 167, 108,0.8), var(--gold), transparent);
  box-shadow: 
    0 0 24rpx rgba(196, 167, 108,0.8),
    0 0 12rpx rgba(196, 167, 108,0.6); 
  opacity: 0.9; 
  animation: beamScan 2s ease-in-out infinite;
}
@keyframes beamScan { 
  0% { top: 0; opacity: 0; } 
  20% { opacity: 1; } 
  80% { opacity: 1; } 
  100% { top: 100%; opacity: 0; } 
}
.loading-box { 
  text-align: center; 
  padding-top: 120rpx; 
  opacity: 0.9; 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
}
.loader-ring {
  width: 48rpx; 
  height: 48rpx; 
  border: 4rpx solid rgba(196, 167, 108,0.2); 
  border-top-color: var(--gold);
  border-radius: 50%; 
  animation: spin 1s linear infinite; 
  margin-bottom: 24rpx;
  box-shadow: none;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-box text { 
  font-family: 'DIN'; 
  font-size: 22rpx; 
  letter-spacing: 4rpx; 
  color: var(--gold); 
  text-shadow: 
    0 0 12rpx rgba(196, 167, 108,0.5),
    0 1rpx 3rpx rgba(0,0,0,0.5);
  font-weight: 700;
}
.result-filter {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}
.filter-chip {
  font-size: 24rpx;
  color: #6B6560;
  padding: 10rpx 28rpx;
  border: 1px solid rgba(38, 35, 32, 0.6);
  border-radius: 9999px;
}
.filter-chip.active {
  color: #C4A76C;
  border-color: rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.08);
}
.result-meta { 
  display: flex; 
  align-items: center; 
  margin: 30rpx 0; 
  font-family: 'DIN'; 
  font-size: 22rpx; 
  color: rgba(196, 167, 108,0.7); 
  letter-spacing: 2rpx; 
  font-weight: 600;
}
.meta-line { 
  flex: 1; 
  height: 1px; 
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108,0.2), transparent); 
  margin-left: 20rpx; 
}

.archive-card {
  display: flex; 
  align-items: center; 
  background: linear-gradient(135deg, rgba(0,0,0,0.95), rgba(15,15,15,0.9)); 
  padding: 28rpx; 
  border: 2px solid rgba(196, 167, 108,0.2); 
  border-radius: 20rpx;
  margin-bottom: 28rpx; 
  position: relative; 
  z-index: 2; 
  opacity: 0;
  box-shadow: 
    0 8rpx 24rpx rgba(0,0,0,0.6),
    0 0 20rpx rgba(196, 167, 108,0.08),
    inset 0 1rpx 3rpx rgba(255,255,255,0.08),
    inset 0 -1rpx 2rpx rgba(0,0,0,0.3);
  backdrop-filter: blur(12px) saturate(150%);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}
.archive-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(196, 167, 108,0.1), transparent);
  transition: left 0.6s;
}
.archive-card:active::before {
  left: 100%;
}
.slide-in { animation: slideIn 0.5s ease-out forwards; }
@keyframes slideIn { 
  from { opacity: 0; transform: translateX(30rpx); } 
  to { opacity: 1; transform: translateX(0); } 
}

.ac-img { 
  width: 140rpx; 
  height: 140rpx; 
  position: relative; 
  margin-right: 28rpx; 
  background: #1A1814; 
  border: 2px solid rgba(196, 167, 108,0.2); 
  flex-shrink: 0; 
  border-radius: 12rpx; 
  overflow: hidden;
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.6),
    0 0 16rpx rgba(196, 167, 108,0.1);
}
.ac-img image { 
  width: 100%; 
  height: 100%; 
  transition: transform 0.4s;
}
.archive-card:active .ac-img image {
  transform: scale(1.1);
}
.ac-mask { 
  position: absolute; 
  top: 0; 
  left: 0; 
  width: 100%; 
  height: 100%; 
  box-shadow: inset 0 0 20rpx rgba(0,0,0,0.6); 
  pointer-events: none;
}

.ac-info { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
  justify-content: center; 
  min-width: 0;
  overflow: hidden;
}
.ac-top { margin-bottom: 12rpx; }
.ac-latin { 
  display: block; 
  font-family: 'Times New Roman', serif; 
  font-style: italic; 
  font-size: 22rpx; 
  color: var(--gold); 
  margin-bottom: 6rpx; 
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis; 
  text-shadow: 
    0 0 12rpx rgba(196, 167, 108,0.4),
    0 1rpx 3rpx rgba(0,0,0,0.5);
  font-weight: 500;
}
.ac-title { 
  font-size: 30rpx; 
  color: #fff; 
  font-weight: 700; 
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.5);
  letter-spacing: 0.5rpx;
}

.ac-btm { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.tag { 
  font-size: 18rpx; 
  color: rgba(196, 167, 108,0.7); 
  border: 1.5px solid rgba(196, 167, 108,0.3); 
  padding: 4rpx 12rpx; 
  border-radius: 6rpx; 
  background: rgba(196, 167, 108,0.05);
  font-weight: 600;
  letter-spacing: 1rpx;
}
/* 🟢 类型标签颜色区分 */
.tag.activity { 
  color: var(--gold); 
  border-color: rgba(196, 167, 108,0.5); 
  background: rgba(196, 167, 108,0.1);
  box-shadow: none;
}
.tag.framer { 
  color: rgba(255,255,255,0.8); 
  border-color: rgba(255,255,255,0.2); 
  background: rgba(255,255,255,0.05);
}
.ac-price { 
  font-family: 'DIN'; 
  font-size: 26rpx; 
  color: var(--gold); 
  font-weight: 700;
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.3);
}

.ac-arr { 
  color: rgba(196, 167, 108,0.4); 
  font-size: 28rpx; 
  margin-left: 20rpx; 
  transition: all 0.4s;
  font-weight: bold;
}
.archive-card:active { 
  border-color: rgba(196, 167, 108,0.5); 
  box-shadow: 
    0 12rpx 32rpx rgba(0,0,0,0.8),
    0 0 36rpx rgba(196, 167, 108,0.3),
    inset 0 1rpx 4rpx rgba(255,255,255,0.15),
    inset 0 -1rpx 3rpx rgba(0,0,0,0.4);
  transform: translateY(-4rpx) scale(0.99);
}
.archive-card:active .ac-arr { 
  color: var(--gold); 
  transform: translateX(4rpx);
  text-shadow: 0 0 12rpx rgba(196, 167, 108,0.6);
}

.empty-state { 
  text-align: center; 
  padding-top: 150rpx; 
  color: rgba(196, 167, 108,0.5); 
}
.empty-icon { 
  width: 80rpx; 
  height: 80rpx; 
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx; 
  color: rgba(196, 167, 108,0.3);
  filter: drop-shadow(0 0 16rpx rgba(196, 167, 108,0.2));
}
.empty-icon image {
  width: 80rpx;
  height: 80rpx;
}
.empty-state text:first-of-type {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.5);
}
.empty-sub { 
  font-size: 24rpx; 
  margin-top: 12rpx; 
  display: block; 
  color: rgba(196, 167, 108,0.4);
  font-family: 'DIN';
  letter-spacing: 2rpx;
}

/* 空状态提示 */
.empty-hint {
  text-align: center;
  padding: 100rpx 40rpx;
  margin-top: 60rpx;
}

.hint-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  opacity: 0.6;
  filter: drop-shadow(0 0 20rpx rgba(196, 167, 108,0.3));
  animation: iconFloat 3s ease-in-out infinite;
}
.hint-icon > view {
  width: 120rpx;
  height: 120rpx;
}

@keyframes iconFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.hint-text {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}

.hint-sub {
  font-size: 24rpx;
  color: rgba(196, 167, 108,0.5);
  font-family: 'DIN', sans-serif;
  letter-spacing: 1.5rpx;
  display: block;
  line-height: 1.6;
}

/* Chip文本样式 */
.chip-text {
  position: relative;
  z-index: 1;
}