/* pages/custom/orders/index.wxss */
page { background: #1A1814; color: #fff; }

.page-orders { min-height: 100vh; padding: 0 32rpx 64rpx; position: relative; }

.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.03; z-index: 0;
}

.header { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0 24rpx; }

.back-btn { font-size: 32rpx; color: #A09A90; width: 72rpx; flex-shrink: 0; }

.brand { flex: 1; }

.title { display: block; font-size: 40rpx; font-weight: 600; }

.sub {
  display: block; font-size: 20rpx; color: #C4A76C;
  letter-spacing: 0.12em; margin-top: 8rpx;
}

.intro { margin-bottom: 32rpx; }

.intro-text { font-size: 26rpx; color: #A09A90; line-height: 1.6; }

.loading-wrap { padding: 80rpx 0; text-align: center; color: #6B6560; }

.section { margin-bottom: 40rpx; }

.section-label {
  display: block; font-size: 22rpx; color: #C4A76C;
  letter-spacing: 0.08em; margin-bottom: 16rpx;
}

.item-card {
  display: flex; align-items: center; gap: 16rpx;
  padding: 28rpx 24rpx; margin-bottom: 16rpx;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.85);
  border-radius: 16rpx;
}

.item-card:active { opacity: 0.92; background: rgba(196, 167, 108, 0.04); }

.item-main { flex: 1; min-width: 0; }

.item-title {
  display: block; font-size: 28rpx; font-weight: 500; color: #D5D1C8;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.item-sub {
  display: block; font-size: 22rpx; color: #6B6560; margin-top: 6rpx;
}

.item-arrow { font-size: 24rpx; color: #C4A76C; flex-shrink: 0; }

.item-meta { font-size: 22rpx; color: #6B6560; flex-shrink: 0; }

.empty-inline { padding: 32rpx 24rpx; text-align: center; }

.empty-text { display: block; font-size: 26rpx; color: #A09A90; }

.empty-hint { display: block; font-size: 22rpx; color: #6B6560; margin-top: 8rpx; }

.empty-all { padding: 80rpx 0; text-align: center; }

.empty-title { display: block; font-size: 30rpx; color: #D5D1C8; margin-bottom: 12rpx; }

.empty-desc {
  display: block; font-size: 24rpx; color: #6B6560;
  line-height: 1.55; margin-bottom: 32rpx; padding: 0 24rpx;
}

.btn-primary {
  display: inline-block; padding: 0 48rpx; height: 84rpx; line-height: 84rpx;
  background: #C4A76C; color: #1A1814; font-size: 28rpx; font-weight: 500;
  border-radius: 16rpx; border: none;
}

.btn-primary::after { border: none; }
