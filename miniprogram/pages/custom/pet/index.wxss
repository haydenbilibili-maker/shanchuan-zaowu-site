/* pages/custom/pet/index.wxss */
@import "../index.wxss";

.page-pet { min-height: 100vh; position: relative; }

.page-pet .main-scroll {
  bottom: 220rpx;
}

.page-pet .scroll-pad {
  height: 48rpx;
}

.notice-box {
  padding: 24rpx; margin-bottom: 28rpx;
  background: rgba(196, 167, 108, 0.06);
  border: 1px solid rgba(77, 64, 26, 0.4);
  border-radius: 16rpx;
}

.notice-item { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.notice-item:last-child { margin-bottom: 0; }
.notice-dot { color: #C4A76C; flex-shrink: 0; }
.notice-text { font-size: 24rpx; color: #A09A90; line-height: 1.55; flex: 1; }

.craft-preview { margin-bottom: 28rpx; }

.craft-chip {
  padding: 16rpx 20rpx; margin-bottom: 12rpx;
  background: #1F1D1A; border-radius: 12rpx;
  border: 1px solid rgba(38, 35, 32, 0.8);
}

.craft-chip.preview {
  opacity: 0.88;
  pointer-events: none;
}

.craft-name { display: block; font-size: 26rpx; color: #D5D1C8; }
.craft-weeks { display: block; font-size: 22rpx; color: #6B6560; margin-top: 4rpx; }

.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 8rpx;
  background: rgba(31, 29, 26, 0.6);
  border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: 12rpx;
}

.consent-checkbox {
  flex-shrink: 0;
  margin-top: 4rpx;
  transform: scale(1.05);
}

.consent-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #D5D1C8;
  line-height: 1.55;
}

.btn-primary.btn-disabled,
.btn-primary[disabled] {
  background: #262320 !important;
  color: #6B6560 !important;
  opacity: 1;
}

.form-group { margin-bottom: 28rpx; }
.form-label { display: block; font-size: 24rpx; color: #A09A90; margin-bottom: 12rpx; }

.form-input, .form-picker {
  width: 100%; height: 80rpx; padding: 0 24rpx; box-sizing: border-box;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: 12rpx; font-size: 28rpx; color: #fff; line-height: 80rpx;
}

.form-textarea {
  width: 100%; min-height: 140rpx; padding: 20rpx 24rpx; box-sizing: border-box;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8);
  border-radius: 12rpx; font-size: 28rpx; color: #fff; margin-top: 12rpx;
}

.option-pills { display: flex; flex-wrap: wrap; gap: 12rpx; }

.option-pill {
  padding: 12rpx 24rpx; border-radius: 9999px;
  font-size: 24rpx; color: #A09A90;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8);
}

.option-pill.active {
  color: #C4A76C; border-color: #4D401A;
  background: rgba(196, 167, 108, 0.1);
}

.photo-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-item, .photo-add {
  width: 160rpx; height: 160rpx; border-radius: 12rpx; overflow: hidden; position: relative;
}
.photo-item image { width: 100%; height: 100%; }
.photo-del {
  position: absolute; top: 0; right: 0; width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,0.6); color: #fff; text-align: center; line-height: 44rpx;
}
.photo-add {
  display: flex; align-items: center; justify-content: center;
  background: #1F1D1A; border: 1px dashed rgba(196, 167, 108, 0.35);
  font-size: 48rpx; color: #6B6560;
}

.craft-card {
  padding: 24rpx; margin-bottom: 16rpx;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8); border-radius: 16rpx;
}
.craft-card.active { border-color: #4D401A; background: rgba(196, 167, 108, 0.08); }
.craft-card-name { display: block; font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
.craft-card-desc { display: block; font-size: 24rpx; color: #A09A90; line-height: 1.5; }
.craft-card-weeks { display: block; font-size: 22rpx; color: #C4A76C; margin-top: 12rpx; }

.intake-card {
  padding: 24rpx; margin-bottom: 16rpx;
  background: #1F1D1A; border: 1px solid rgba(38, 35, 32, 0.8); border-radius: 16rpx;
}
.intake-card.active { border-color: #4D401A; background: rgba(196, 167, 108, 0.08); }
.intake-name { display: block; font-size: 28rpx; font-weight: 500; margin-bottom: 8rpx; }
.intake-desc { display: block; font-size: 24rpx; color: #A09A90; line-height: 1.5; }

.submit-tip { display: block; font-size: 22rpx; color: #6B6560; line-height: 1.5; margin-top: 8rpx; }

.page-pet .preview-plate {
  padding: 24rpx; margin-bottom: 28rpx;
  background: #FAF6ED; border: 1px solid #E0CFA3; border-radius: 16rpx;
}
.page-pet .preview-row {
  display: flex; justify-content: space-between; gap: 16rpx;
  padding: 10rpx 0; border-bottom: 1px solid rgba(139, 111, 71, 0.12);
}
.page-pet .preview-row:last-child { border-bottom: none; }
.page-pet .preview-label { font-size: 22rpx; color: #8B6F47; }
.page-pet .preview-value { font-size: 24rpx; color: #6B5A24; text-align: right; flex: 1; }
