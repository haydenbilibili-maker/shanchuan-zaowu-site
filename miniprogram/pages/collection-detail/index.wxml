<!--pages/collection/detail/detail.wxml-->
<view class="container">

<!-- 1. 自定义导航栏 (吸顶 + 渐变) -->
<view class="custom-nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px; background: rgba(18, 18, 18, {{headerOpacity}});">
  <view class="nav-content" style="height: {{navBarHeight}}px;">
    <view class="back-btn" bindtap="goBack">
      <text class="icon-arrow">←</text>
    </view>
    <!-- 标题随透明度显现 -->
    <text class="nav-title" style="opacity: {{headerOpacity}}">{{wiki.cn_name}}</text>
  </view>
</view>

<!-- 2. 视差头部 (Parallax Header) -->
<view class="parallax-header">
  <!-- 背景图：绑定动态 transform -->
  <image class="header-bg" src="{{wiki.main_image}}" mode="aspectFill" style="{{parallaxStyle}}"></image>
  <view class="header-mask"></view> <!-- 渐变遮罩 -->
  
  <!-- 头部信息 (相对定位，随页面滚动) -->
  <view class="header-info">
    <view class="tags-row">
      <text class="tag" wx:for="{{wiki.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <text class="latin-name">{{wiki.latin_name}}</text>
    <text class="cn-name">{{wiki.cn_name}}</text>
    
    <view class="stats-row">
      <view class="stat-item">
        <image src="/assets/icons/eye.png" mode="aspectFit" class="icon-gold" style="width: 24rpx; height: 24rpx;"></image>
        <text>{{wiki.stats.views}} 阅读</text>
      </view>
      <view class="stat-item">
        <image src="/assets/icons/heart.png" mode="aspectFit" class="icon-gold" style="width: 24rpx; height: 24rpx;"></image>
        <text>{{wiki.stats.likes}} 收藏</text>
      </view>
    </view>
  </view>
</view>

<!-- 3. 正文内容区 (白色背景容器 / 或深色背景) -->
<view class="content-body">
  
<!-- A. 富文本文章 -->
<view class="article-container">
      <!-- 🟢 替换为 mp-html，支持更丰富的样式和交互 -->
      <mp-html 
        content="{{articleContent}}" 
        tag-style="{{tagStyle}}" 
        container-style="color:#ccc; font-size:15px; line-height:1.8;"
      />
    </view>

  <!-- B. 知识画廊 (横向滚动) -->
  <view class="section-block" wx:if="{{galleryImages.length > 0}}">
    <view class="section-title">VISUAL ARCHIVE / 影像档案</view>
    <scroll-view scroll-x class="gallery-scroll" enable-flex>
      <block wx:for="{{galleryImages}}" wx:key="*this">
        <view class="gallery-item" bindtap="previewGallery" data-src="{{item}}">
           <image src="{{item}}" mode="aspectFill"></image>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- C. 关联藏品 (玻璃拟态卡片) -->
  <view class="section-block" wx:if="{{relatedProducts.length > 0}}">
    <view class="section-title">RELATED COLLECTION / 馆藏关联</view>
    <block wx:for="{{relatedProducts}}" wx:key="_id">
      <view class="product-card-glass" bindtap="goToProduct" data-id="{{item._id}}">
        <image class="p-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="p-info">
          <text class="p-name">{{item.title}}</text>
          <text class="p-price">{{item.price}}</text>
        </view>
        <view class="p-btn">查看</view>
      </view>
    </block>
  </view>

  <!-- 底部留白 -->
  <view style="height: 100rpx;"></view>

</view>

</view>