<!--pages/atelier/index.wxml — 标本工坊 Tab-->
<view class="page-hub">
  <view class="grain-overlay"></view>

  <view class="hero">
    <image class="hero-bg" src="{{heroImage}}" mode="aspectFill"></image>
    <view class="hero-mask"></view>
    <!-- 品牌标题 + slogan 同左缘、锚在 hero 下缘，读成一块构图；避开顶栏胶囊 -->
    <view class="hero-content">
      <view class="brand">
        <text class="title">标本工坊</text>
        <text class="sub">NATURE'S ATELIER</text>
      </view>
      <view class="hero-copy">
        <text class="hero-tagline">把山海带回家</text>
        <text class="hero-desc">星宸标本工作室 · 鉴定、定制、礼赠与伴宠记忆，在同一盏暖光下完成</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="intro">
      <text class="intro-overline">CHOOSE YOUR PATH</text>
      <text class="intro-text">{{introText}}</text>
    </view>

    <!-- 四功能宫格：编号固定（01 礼赠 / 02 定制 / 03 鉴定 / 04 伴宠），
         某一格开关关闭只是不渲染，其余编号不漂移 -->
    <view class="feature-grid">
      <view
        class="feature-tile {{item.highlight ? 'highlight' : ''}}"
        wx:for="{{tiles}}"
        wx:key="key"
        hover-class="tile-press"
        hover-stay-time="80"
        bindtap="onFeatureTap"
        data-key="{{item.key}}"
      >
        <view class="tile-head">
          <text class="tile-no">{{item.no}}</text>
          <text class="tile-overline">{{item.overline}}</text>
        </view>
        <text class="tile-title">{{item.title}}</text>
        <text class="tile-desc">{{item.desc}}</text>
        <text class="tile-arrow">→</text>
      </view>
    </view>
    <view class="feature-empty" wx:if="{{!tiles.length}}">工坊服务逐步开放，敬请留意。</view>

    <view class="orders-section">
      <text class="section-overline">MY ORDERS</text>
      <text class="section-title">进度查询</text>
      <view class="orders-grid">
        <view class="order-tile" bindtap="goPetOrders" wx:if="{{showPetMemorial}}">
          <text class="order-tile-label">伴宠工单</text>
          <text class="order-tile-desc">查看评估进度与报价</text>
          <text class="order-tile-arrow">→</text>
        </view>
        <view class="order-tile" bindtap="goCustomOrders" wx:if="{{showSpecimenCustom}}">
          <text class="order-tile-label">定制订单</text>
          <text class="order-tile-desc">方案草稿与已下定制单</text>
          <text class="order-tile-arrow">→</text>
        </view>
      </view>
      <text class="orders-empty" wx:if="{{!showPetMemorial && !showSpecimenCustom}}">暂无可查询的工单</text>
    </view>

    <!-- 标本师招募统一入口：我的 → 联系专员 → 标本师招募 -->
  </view>
</view>
