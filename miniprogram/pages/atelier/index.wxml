<!--pages/atelier/index.wxml — 标本工坊 Tab-->
<view class="page-hub">
  <view class="grain-overlay"></view>

  <view class="hero">
    <image class="hero-bg" src="{{heroImage}}" mode="aspectFill"></image>
    <view class="hero-mask"></view>
    <!-- 品牌标题 + slogan 同左缘、锚在 hero 下缘，读成一块构图；避开顶栏胶囊 -->
    <view class="hero-content">
      <view class="brand">
        <text class="title">标本工坊</text>
        <text class="sub">NATURE'S ATELIER</text>
      </view>
      <view class="hero-copy">
        <text class="hero-tagline">把山海带回家</text>
        <text class="hero-desc">星宸标本工作室 · 装裱、定制与伴宠记忆，在同一盏暖光下完成</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="intro">
      <text class="intro-overline">CHOOSE YOUR PATH</text>
      <text class="intro-text">{{showSpecimenCustom && showPetMemorial ? '选一条适合你的路径。标本定制即时选配；伴宠记忆需专员评估后承接。' : (showPetMemorial ? '伴宠记忆需专员评估后承接。标本定制将在开放后于此承接。' : (showSpecimenCustom ? '标本定制即时选配。伴宠记忆将在开放后于此承接。' : '工坊服务逐步开放，敬请留意。'))}}</text>
    </view>

    <view class="fork-card" bindtap="goGift" wx:if="{{showGift}}">
      <view class="fork-icon">01</view>
      <view class="fork-body">
        <text class="fork-overline">GIFT</text>
        <text class="fork-title">礼赠</text>
        <text class="fork-desc">从柜中取出一件山海，封笺赠予——先备妥再请 TA 留下去处</text>
      </view>
      <text class="fork-arrow">→</text>
    </view>

    <view class="fork-card" bindtap="goStandard" wx:if="{{showSpecimenCustom}}">
      <view class="fork-icon">{{showGift ? '02' : '01'}}</view>
      <view class="fork-body">
        <text class="fork-overline">SPECIMEN CUSTOM</text>
        <text class="fork-title">标本定制</text>
        <text class="fork-desc">从馆藏藏品选型，配框、配盒、写卡片，线上下单</text>
      </view>
      <text class="fork-arrow">→</text>
    </view>

    <view class="fork-card highlight" bindtap="goPet" wx:if="{{showPetMemorial}}">
      <view class="fork-icon">{{showGift && showSpecimenCustom ? '03' : (showGift || showSpecimenCustom ? '02' : '01')}}</view>
      <view class="fork-body">
        <text class="fork-overline">PET MEMORIAL</text>
        <text class="fork-title">伴宠记忆</text>
        <text class="fork-desc">为已逝伙伴申请藏品制作，提交意向后由工坊评估工艺与周期</text>
      </view>
      <text class="fork-arrow">→</text>
    </view>

    <view class="orders-section">
      <text class="section-overline">MY ORDERS</text>
      <text class="section-title">进度查询</text>
      <view class="orders-grid">
        <view class="order-tile" bindtap="goPetOrders" wx:if="{{showPetMemorial}}">
          <text class="order-tile-label">伴宠工单</text>
          <text class="order-tile-desc">查看评估进度与报价</text>
          <text class="order-tile-arrow">→</text>
        </view>
        <view class="order-tile" bindtap="goCustomOrders" wx:if="{{showSpecimenCustom}}">
          <text class="order-tile-label">定制订单</text>
          <text class="order-tile-desc">方案草稿与已下定制单</text>
          <text class="order-tile-arrow">→</text>
        </view>
      </view>
    </view>

    <!-- 标本师招募统一入口：我的 → 联系专员 → 标本师招募 -->
  </view>
</view>
