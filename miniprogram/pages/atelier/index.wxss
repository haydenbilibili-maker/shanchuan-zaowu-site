/* pages/atelier/index.wxss — Museum Mode 标本工坊 Tab */
page { background: var(--color-bg); color: #fff; }

.page-hub {
  min-height: 100vh;
  position: relative;
  background-color: var(--color-bg);
  /* 为自定义 TabBar 留底，避免末项被挡 */
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.grain-overlay {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.03; z-index: 0;
}

.hero {
  position: relative;
  height: 640rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
}

/* 下重上轻 + 左侧极轻暗角，保字可读，不挡全幅实景 */
.hero-mask {
  position: absolute; inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(26, 24, 20, 0.42) 0%,
      rgba(26, 24, 20, 0.12) 42%,
      rgba(26, 24, 20, 0) 72%
    ),
    linear-gradient(
      180deg,
      rgba(26, 24, 20, 0.28) 0%,
      rgba(26, 24, 20, 0.22) 38%,
      rgba(26, 24, 20, 0.72) 72%,
      var(--color-bg) 100%
    );
}

.hero-content {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 40rpx 56rpx;
  box-sizing: border-box;
}

.brand {
  text-align: left;
  margin-bottom: 28rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  font-family: var(--font-brand, 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif);
  color: var(--color-text-primary);
  letter-spacing: 0.06em;
  line-height: 1.28;
}

.sub {
  display: block;
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 0.2em;
  margin-top: 16rpx;
  line-height: 1.4;
}

.hero-copy {
  padding: 0;
  max-width: 640rpx;
}

.hero-tagline {
  display: block;
  font-size: 30rpx;
  color: #E0CFA3;
  letter-spacing: 0.14em;
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.body { padding: 8rpx 32rpx 64rpx; position: relative; z-index: 1; }

.intro { margin-bottom: 36rpx; }

.intro-overline {
  display: block; font-size: 20rpx; color: var(--color-text-muted);
  letter-spacing: 0.14em; margin-bottom: 12rpx;
}

.intro-text { font-size: 26rpx; color: var(--color-text-secondary); line-height: 1.65; }

.fork-card {
  position: relative;
  display: flex; align-items: flex-start; gap: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(38, 35, 32, 0.9);
  border-radius: 24rpx;
}

.fork-card.highlight {
  border-color: rgba(77, 64, 26, 0.65);
  background: rgba(196, 167, 108, 0.06);
}

.fork-card:active { opacity: 0.92; }

.fork-icon {
  flex-shrink: 0;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 600; color: var(--gold);
  background: rgba(196, 167, 108, 0.12);
  border: 1px solid rgba(196, 167, 108, 0.25);
  border-radius: 12rpx;
  font-family: 'JetBrains Mono', 'DM Mono', monospace;
}

.fork-body { flex: 1; min-width: 0; padding-right: 40rpx; }

.fork-overline {
  display: block; font-size: 20rpx; color: var(--color-text-muted);
  letter-spacing: 0.1em; margin-bottom: 10rpx;
}

.fork-card.highlight .fork-overline { color: var(--gold); }

.fork-title {
  display: block; font-size: 34rpx; font-weight: 600;
  margin-bottom: 10rpx; color: var(--color-text-primary);
}

.fork-desc {
  display: block; font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.55;
}

.fork-arrow {
  position: absolute; right: 28rpx; top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx; color: var(--gold);
}

.orders-section {
  margin-top: 48rpx;
  padding-top: 36rpx;
  border-top: 1px solid rgba(38, 35, 32, 0.8);
}

.section-overline {
  display: block; font-size: 20rpx; color: var(--color-text-muted);
  letter-spacing: 0.14em; margin-bottom: 8rpx;
}

.section-title {
  display: block; font-size: 30rpx; font-weight: 600;
  color: var(--color-text-body); margin-bottom: 24rpx;
}

.orders-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx;
}

.order-tile {
  position: relative;
  padding: 28rpx 24rpx;
  background: var(--color-bg-card);
  border: 1px solid rgba(38, 35, 32, 0.85);
  border-radius: 16rpx;
  min-height: 160rpx;
}

.order-tile:active { opacity: 0.9; background: rgba(196, 167, 108, 0.04); }

.order-tile-label {
  display: block; font-size: 28rpx; font-weight: 600; color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.order-tile-desc {
  display: block; font-size: 22rpx; color: var(--color-text-muted); line-height: 1.45;
  padding-right: 32rpx;
}

.order-tile-arrow {
  position: absolute; right: 20rpx; bottom: 24rpx;
  font-size: 24rpx; color: var(--gold);
}
