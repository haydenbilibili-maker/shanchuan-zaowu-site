<!--pages/user/index.wxml-->
<!-- padding-top：自定义导航下避让状态栏 + 胶囊（onLoad 用 menu.bottom+6，与购物车页一致） -->
<view class="container" style="padding-top: {{statusBarHeight}}px;">

  <!-- 本机已退出：重新进入入口 -->
  <view class="logout-banner stagger-item" wx:if="{{isLocalLoggedOut}}" style="animation-delay: 0s;">
    <view class="logout-banner-body" bindtap="onResumeLoginTap" hover-class="logout-banner-press" hover-stay-time="80">
      <view class="logout-banner-text">
        <text class="logout-banner-title">已退出本机登录</text>
        <text class="logout-banner-desc">点此重新载入藏家档案与会员权益</text>
      </view>
      <text class="logout-banner-cta">重新进入 →</text>
    </view>
  </view>

  <!-- 新用户引导条（可关闭，不强制跳转） -->
  <view class="onboard-banner stagger-item" wx:if="{{showOnboardingBanner && !isLocalLoggedOut}}" style="animation-delay: 0s;" hover-class="onboard-banner-press">
    <view class="onboard-banner-body" bindtap="startOnboarding">
      <view class="onboard-ring" style="background: conic-gradient(from -90deg, #C4A76C {{profileScore}}%, rgba(196,167,108,0.12) 0);">
        <view class="onboard-ring-inner"><text class="onboard-ring-val">{{profileScore}}</text></view>
      </view>
      <view class="onboard-banner-text">
        <text class="onboard-banner-title">领取你的新客礼</text>
        <text class="onboard-banner-desc">授权手机号即可完成注册，礼券即时放入账户</text>
      </view>
      <text class="onboard-banner-cta">领取</text>
    </view>
    <view class="onboard-banner-close" catchtap="dismissOnboardingBanner">×</view>
  </view>

  <!-- 注册礼包补领（完成注册但发放失败/未打标） -->
  <view class="onboard-banner gift-repair-banner stagger-item" wx:if="{{showGiftRepairBanner && !isLocalLoggedOut && !showOnboardingBanner}}" style="animation-delay: 0s;" hover-class="onboard-banner-press">
    <view class="onboard-banner-body" bindtap="repairWelcomeGift">
      <view class="onboard-banner-text">
        <text class="onboard-banner-title">新客礼待放入</text>
        <text class="onboard-banner-desc">礼券可一键补领，不会重复发放</text>
      </view>
      <text class="onboard-banner-cta">{{giftRepairing ? '补领中' : '补领'}}</text>
    </view>
    <view class="onboard-banner-close" catchtap="dismissGiftRepairBanner">×</view>
  </view>
  
  <user-vip-card
    card-flipped="{{cardFlipped}}"
    card-skin-class="{{cardSkinClass}}"
    specimen-emoji="{{specimenEmoji}}"
    has-checked-in="{{hasCheckedIn}}"
    user-info="{{userInfo}}"
    level-name="{{levelName}}"
    discount-rate="{{discountRate}}"
    discount-text="{{discountText}}"
    profile-score="{{profileScore}}"
    growth-is-max="{{growthIsMax}}"
    growth-value-display="{{growthValueDisplay}}"
    next-threshold="{{nextThreshold}}"
    next-threshold-display="{{nextThresholdDisplay}}"
    growth-gap-line="{{growthGapLine}}"
    growth-perk-delta="{{growthPerkDelta}}"
    progress-width="{{progressWidth}}"
    member-no="{{memberNo}}"
    card-birthday="{{cardBirthday}}"
    card-consumption-display="{{cardConsumptionDisplay}}"
    statistics="{{statistics}}"
    card-points-display="{{cardPointsDisplay}}"
    card-interest-tags="{{cardInterestTags}}"
    card-persona="{{cardPersona}}"
    specimen-name="{{specimenName}}"
    specimen-latin="{{specimenLatin}}"
    card-pending="{{cardPending}}"
    card-guest="{{cardGuest}}"
    guest-logged-out="{{guestLoggedOut}}"
    bind:toggleflip="toggleCardFlip"
    bind:checkin="doCheckIn"
    bind:showmembercode="showMemberCode"
    bind:changeavatar="onChangeAvatar"
    bind:goprofile="goToProfile"
    bind:showlevelbenefits="showLevelBenefits"
    bind:goprofilefromback="goToProfileFromCardBack"
    bind:guestcta="onGuestCardCta"
    bind:easteregg="onVipCardEasterEgg"
  />


  <!-- 个人资产：钱包（含券夹）· 证书 · 积分 · 礼赠；用 view 避免 scroll-view 裁切角标 -->
  <view
    class="assets-panel stagger-item"
    style="animation-delay: 0.1s;"
  >
    <view class="assets-track">
      <!-- 钱包开启：快捷行首位为钱包；关闭且预约开启时回退为预约（与馆藏服务互斥，避免双入口） -->
      <view class="asset-item asset-item-wallet" hover-class="asset-item-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="storedValue" wx:if="{{showStoredValue}}">
        <view class="as-icon-wrap">
          <image class="as-icon" src="/assets/icons/wallet_gold.png"></image>
          <view class="badge-outline-brass badge-sm as-badge-pos {{couponBadgeWide ? 'badge-wide' : ''}} badge-enter" wx:if="{{couponBadgeText}}">
            <text>{{couponBadgeText}}</text>
          </view>
        </view>
        <text class="as-lbl">我的钱包</text>
      </view>
      <view class="asset-item" hover-class="asset-item-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="visitBooking" wx:elif="{{showBookingEntry}}">
        <view class="as-icon-wrap">
          <image class="as-icon" src="/assets/icons/calendar_gold.png"></image>
          <view class="badge-outline-brass badge-sm as-badge-pos badge-enter" wx:if="{{bookingCount > 0}}">
            <text>{{bookingCount > 99 ? '99+' : bookingCount}}</text>
          </view>
        </view>
        <text class="as-lbl">预约</text>
      </view>

      <view class="v-divider" wx:if="{{showStoredValue || showBookingEntry}}"></view>

      <view class="asset-item" hover-class="asset-item-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="certificate">
        <!-- 2026-09-17：证书数量搬到 icon 右上角角标（原为 icon 与文案之间的数字） -->
        <view class="as-icon-wrap">
          <image class="as-icon" src="/assets/icons/medal_gold.png"></image>
          <view class="badge-outline-brass badge-sm as-badge-pos badge-enter" wx:if="{{certificateCount > 0}}">
            <text>{{certificateCount > 99 ? '99+' : certificateCount}}</text>
          </view>
        </view>
        <text class="as-lbl">我的证书</text>
      </view>

      <view class="v-divider"></view>

      <!-- 2026-09-17：积分已并入「我的钱包」（钱包/礼券夹/积分 三 tab），
           此处改为「我的档案」（原藏家档案入口上移，避免同一入口出现两次） -->
      <view class="asset-item" hover-class="asset-item-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="profile">
        <view class="as-icon-wrap">
          <!-- 2026-09-17：改用真金素材 user_gold.png（与 wallet_gold/medal_gold/gift 同为 #D4AF37）。
               原做法是白灰 user.png + 滤镜，且滤镜那条例外把 opacity 提到 1，而 .as-icon 统一是 0.8
               → 同屏对比必然有色差（真机实测确认）。真素材 + 同一 opacity 才是同色值。 -->
          <image class="as-icon" src="/assets/icons/user_gold.png"></image>
          <!-- 宽角标：容纳「100%」；未注册/骨架态不显示（不谎报 0%） -->
          <view
            class="badge-outline-brass badge-sm badge-wide as-badge-pos badge-enter"
            wx:if="{{!cardPending && !cardGuest}}"
          >
            <text>{{profileScore}}%</text>
          </view>
        </view>
        <text class="as-lbl">我的档案</text>
      </view>

      <block wx:if="{{showGift}}">
        <view class="v-divider"></view>
        <view class="asset-item" hover-class="asset-item-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="myGifts">
          <view class="as-icon-wrap">
          <image class="as-icon" src="/assets/icons/gift.png"></image>
          <view class="badge-outline-brass badge-sm as-badge-pos badge-enter" wx:if="{{giftTodoCount > 0}}">
            <text>{{giftTodoCount > 99 ? '99+' : giftTodoCount}}</text>
          </view>
          </view>
          <text class="as-lbl">我的礼赠</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 🟢 数据统计预览面板（showMyDataModule 控制显隐） -->
  <view class="panel-box stagger-item" style="animation-delay: 0.15s;" wx:if="{{showMyDataModule}}">
    <view class="panel-head" bindtap="showStatistics" hover-class="panel-head-press" hover-stay-time="80">
      <text class="ph-title">我的数据</text>
      <text class="ph-en">STATISTICS</text>
      <text class="ph-more">查看详情 ›</text>
    </view>
    <view class="stats-preview">
      <view class="stat-item">
        <text class="stat-val">{{statistics.viewCount || 0}}</text>
        <text class="stat-label">浏览</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-val">{{statistics.collectCount || 0}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-val">{{statistics.shareCount || 0}}</text>
        <text class="stat-label">分享</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-val">{{statistics.orderCount || 0}}</text>
        <text class="stat-label">订单</text>
      </view>
    </view>
  </view>

  <!-- 4. 藏品订单 (矩阵入口) -->
  <view class="panel-box stagger-item" style="animation-delay: 0.3s;">
    <view class="panel-head" bindtap="handleMenuClick" data-path="orders" hover-class="panel-head-press" hover-stay-time="80">
      <text class="ph-title">藏品订单</text>
      <text class="ph-en">ORDERS</text>
      <text class="ph-more">全部订单 ›</text>
    </view>
    <view class="order-matrix">
      <view class="om-item" bindtap="goToOrderList" data-type="pay" hover-class="om-item-press" hover-stay-time="80">
        <image class="om-icon" src="/assets/icons/pay.png"></image><text>待付款</text>
      </view>
      <view class="om-item" bindtap="goToOrderList" data-type="paid" hover-class="om-item-press" hover-stay-time="80">
        <image class="om-icon" src="/assets/icons/ship.png"></image><text>待发货</text>
      </view>
      <view class="om-item" bindtap="goToOrderList" data-type="shipped" hover-class="om-item-press" hover-stay-time="80">
        <image class="om-icon" src="/assets/icons/deliver.png"></image><text>待收货</text>
      </view>
      <view class="om-item" bindtap="goToOrderList" data-type="received" hover-class="om-item-press" hover-stay-time="80">
        <image class="om-icon icon-gold" src="/assets/icons/done.png"></image><text>已签收</text>
      </view>
      <view class="om-item" bindtap="goToOrderList" data-type="refund" hover-class="om-item-press" hover-stay-time="80">
        <image class="om-icon" src="/assets/icons/refund.png"></image><text>售后</text>
      </view>
    </view>
  </view>

  <!-- 员工工作台（仅有任一工作台权限时展示；插在订单与馆藏服务之间） -->
  <view class="panel-box workbench-panel stagger-item" style="animation-delay: 0.32s;" wx:if="{{workbenchTiles.length > 0}}">
    <view class="panel-head">
      <text class="ph-title">工作台</text>
      <text class="ph-en">WORKBENCH</text>
      <view
        class="wb-marquee"
        wx:if="{{workbenchMarqueeShow}}"
        hover-class="wb-marquee-press"
        hover-stay-time="80"
        catchtap="onWorkbenchMarqueeTap"
      >
        <view class="wb-marquee-fade"></view>
        <view class="wb-marquee-mask">
          <view class="wb-marquee-track" style="animation-duration: {{workbenchMarqueeDuration}};">
            <text class="wb-marquee-text">{{workbenchMarqueeText}}</text>
            <text class="wb-marquee-text">{{workbenchMarqueeText}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="wb-matrix">
      <view
        class="wb-tile {{item.key === 'workflow' ? 'wb-tile-info' : ''}}"
        hover-class="wb-tile-press"
        hover-stay-time="80"
        bindtap="onWorkbenchTileTap"
        data-key="{{item.key}}"
        data-kind="{{item.kind}}"
        data-workspace="{{item.workspace}}"
        wx:for="{{workbenchTiles}}"
        wx:key="key"
      >
        <view class="wb-tile-top">
          <image class="wb-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <view class="badge-info badge-sm {{item.badgeWide ? 'badge-wide' : ''}} badge-enter" wx:if="{{item.badgeText}}">
            <text>{{item.badgeText}}</text>
          </view>
        </view>
        <text class="wb-cn">{{item.title}}</text>
        <text class="wb-en">{{item.en}}</text>
      </view>
    </view>
  </view>

  <!-- 3. 馆藏服务 -->
  <view class="panel-box stagger-item" style="animation-delay: 0.2s;">
    <view class="panel-head">
      <text class="ph-title">馆藏服务</text>
      <text class="ph-en">SERVICES</text>
    </view>
    <view class="service-list">
      <!-- 需求 21 / 2026-09-17：藏家档案入口已上移到资产区（原「我的积分」位置），
           此处不再重复渲染同一入口 -->
      <!-- 履约与消息（订单/积分/钱包已在上方资产区）；预约与快捷行互斥，仅钱包占快捷位时下沉至此 -->
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="visitBooking" wx:if="{{showBookingEntry && showStoredValue}}">
        <image class="m-img gold" src="/assets/icons/calendar_gold.png"></image>
        <view class="m-info">
          <text class="m-cn">预约参观</text>
          <text class="m-en">BOOK A VISIT · 参观 / 工坊</text>
        </view>
        <text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="address">
        <image class="m-img silver" src="/assets/icons/map.png"></image>
        <view class="m-info"><text class="m-cn">地址管理</text><text class="m-en">ADDRESS</text></view><text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="orderClaim">
        <image class="m-img gold" src="/assets/icons/list.png"></image>
        <view class="m-info">
          <text class="m-cn">订单认领</text>
          <text class="m-en">ORDER CLAIM · 小票 / 外部订单兑积分</text>
        </view>
        <text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="goToMessages">
        <image class="m-img gold" src="/assets/icons/message.png"></image>
        <view class="m-info">
          <text class="m-cn">山海有信</text>
          <text class="m-en">MESSAGES</text>
        </view>
        <view class="badge-solid-danger badge-inline {{messageBadgeWide ? 'badge-wide' : ''}} badge-enter" wx:if="{{messageBadgeText}}">
          <text>{{messageBadgeText}}</text>
        </view>
        <text class="m-arr">→</text>
      </view>

      <!-- 馆藏与内容 -->
      <view class="menu-row section-start" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="collection" wx:if="{{showAtlas}}">
        <image class="m-img native" src="/assets/icons/atlas.png" mode="aspectFit"></image>
        <view class="m-info"><text class="m-cn">我的山海图鉴</text><text class="m-en">MY ATLAS</text></view>
        <text class="meta-progress badge-inline" wx:if="{{atlasStats.total}}">{{atlasStats.unlocked}}/{{atlasStats.total}}</text>
        <text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="wishlist">
        <image class="m-img gold" src="/assets/icons/heart.png" mode="aspectFit"></image>
        <view class="m-info"><text class="m-cn">收藏与候补</text><text class="m-en">SAVED & WAITLIST</text></view>
        <text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="goToAchievements" wx:if="{{showAchievements}}">
        <image class="m-img gold" src="/assets/icons/medal_gold.png"></image>
        <view class="m-info">
          <text class="m-cn">我的成就</text>
          <text class="m-en">ACHIEVEMENTS</text>
        </view>
        <!-- 描边金：仅「较上次进入后的新点亮」，非已点亮总数 -->
        <view class="badge-outline-brass badge-inline {{achievementBadgeWide ? 'badge-wide' : ''}} badge-enter" wx:if="{{achievementBadgeText}}">
          <text>{{achievementBadgeText}}</text>
        </view>
        <text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="goToCare">
        <image class="m-img native" src="/assets/icons/care.png" mode="aspectFit"></image>
        <view class="m-info"><text class="m-cn">标本养护</text><text class="m-en">SPECIMEN CARE</text></view><text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="identify" wx:if="{{showAiIdentify}}">
        <image class="m-img gold" src="/assets/icons/camera.png"></image>
        <view class="m-info"><text class="m-cn">AI 标本鉴定</text><text class="m-en">AI IDENTIFY · 当前免费</text></view>
        <text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="goToCommunity" wx:if="{{showUserCommunity}}">
        <image class="m-img gold" src="/assets/icons/article-tab.png"></image>
        <view class="m-info"><text class="m-cn">山海社区</text><text class="m-en">SHANHAI COMMUNITY</text></view><text class="m-arr">→</text>
      </view>

      <!-- 售后与支持 -->
      <view class="menu-row section-start" hover-class="menu-row-press" hover-stay-time="80" bindtap="goToSupport">
        <image class="m-img silver" src="/assets/icons/service.png"></image>
        <view class="m-info"><text class="m-cn">联系专员</text><text class="m-en">SUPPORT</text></view><text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="feedback">
        <image class="m-img gold" src="/assets/icons/message.png"></image>
        <view class="m-info"><text class="m-cn">反馈与建议</text><text class="m-en">FEEDBACK</text></view><text class="m-arr">→</text>
      </view>

      <!-- 门店运营与品牌 -->
      <view class="menu-row section-start" hover-class="menu-row-press" hover-stay-time="80" bindtap="goToStore" wx:if="{{showStore}}">
        <image class="m-img gold" src="/assets/icons/store.png"></image>
        <view class="m-info"><text class="m-cn">这有店</text><text class="m-en">STORE</text></view><text class="m-arr">→</text>
      </view>
      <view class="menu-row {{showStore ? '' : 'section-start'}}" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="group">
        <image class="m-img silver" src="/assets/icons/group.png"></image>
        <view class="m-info"><text class="m-cn">官方社群</text><text class="m-en">COMMUNITY</text></view><text class="m-arr">→</text>
      </view>
      <view class="menu-row" hover-class="menu-row-press" hover-stay-time="80" bindtap="handleMenuClick" data-path="about">
        <image class="m-img silver" src="/assets/icons/store.png"></image>
        <view class="m-info"><text class="m-cn">关于品牌</text><text class="m-en">ABOUT US</text></view><text class="m-arr">→</text>
      </view>
    </view>
  </view>

  <view class="copyright">
    <text class="cr-line">把山海带回家</text>
    <text class="cr-line en">NATURE'S CREATIONS</text>
    <view class="cr-legal">
      <text class="cr-link" hover-class="cr-link-press" bindtap="goToLegal" data-type="terms">用户协议</text>
      <text class="cr-dot">·</text>
      <text class="cr-link" hover-class="cr-link-press" bindtap="goToLegal" data-type="privacy">隐私政策</text>
      <text class="cr-dot">·</text>
      <text class="cr-link" hover-class="cr-link-press" bindtap="goToFeedback">反馈建议</text>
    </view>
  </view>

  <!-- 会员码与权益（核销成功态与券夹亮码共用 PassRedeemCard） -->
  <!-- catchtouchmove 仅挡遮罩穿透；弹层本体可滚，勿绑在父级 -->
  <view class="qr-mask" wx:if="{{showQrModal}}" bindtap="closeMemberCode">
    <view class="qr-mask-blocker" catchtouchmove="preventPassClose" catchtap="closeMemberCode"></view>
    <view class="qr-content pop-in {{passState === 'redeemed' ? 'is-redeemed' : ''}}" catchtap="preventPassClose">

      <view class="qr-header">
        <text class="qr-overline">{{passState === 'redeemed' ? 'REDEEMED' : 'MEMBER PASS'}}</text>
        <text class="qr-title">{{passState === 'redeemed' ? '核销成功' : '会员通行码'}}</text>
        <view class="qr-level-badge" wx:if="{{passState !== 'redeemed'}}">{{levelName}}</view>
        <view class="qr-close" bindtap="closeMemberCode">关闭</view>
      </view>

      <view class="pass-coupon-banner" wx:if="{{passState !== 'redeemed' && passCouponHint}}">
        <view class="signal-light lamp-brass blink"></view>
        <text class="pass-coupon-banner-text">{{passCouponHint}}</text>
      </view>

      <!-- 核销成功结果卡 -->
      <view class="pass-redeem-wrap" wx:if="{{passState === 'redeemed'}}">
        <pass-redeem-card
          title="{{redeemTitle || '门店礼券'}}"
          value-text="{{redeemValueText}}"
          animating="{{redeemAnimating}}"
          note="门店礼券已核销 · 可关闭本页"
        />
        <view class="pass-done-btn" hover-class="pass-done-btn-press" bindtap="closeMemberCode">完成</view>
      </view>

      <block wx:else>
        <view class="pass-qr-stage">
          <view class="pass-qr-empty" wx:if="{{passState === 'guest'}}">登录后可生成动态会员码</view>
          <view class="pass-qr-empty-wrap" wx:elif="{{passState === 'error'}}">
            <text class="pass-qr-empty">{{passErrorMsg || '会员码暂时无法生成'}}</text>
            <text class="pass-qr-retry" catchtap="refreshMemberPass">重新获取</text>
          </view>
          <view class="pass-qr-frame" wx:else>
            <canvas
              type="2d"
              id="memberPassQrCanvas"
              class="pass-qr-canvas"
              style="width: 264rpx; height: 264rpx;"
            ></canvas>
          </view>
          <view class="pass-qr-plate" wx:if="{{memberNo && memberNo !== 'MT-0000-0000'}}">
            <text class="pass-qr-id">{{memberNo}}</text>
            <view class="pass-qr-meta" wx:if="{{passState === 'ready'}}">
              <view class="signal-light {{passCountdown <= 0 ? '' : (passCountdown <= 10 ? 'danger blink' : (passCountdown <= 30 ? 'warn blink' : 'blink'))}}"></view>
              <text class="pass-qr-timer">{{passCountdown}}s</text>
            </view>
          </view>
        </view>

        <scroll-view scroll-y class="qr-privileges" enhanced show-scrollbar="{{false}}">
          <view class="privilege-head">
            <text class="privilege-overline">CURRENT BENEFIT</text>
            <text class="privilege-title">当前权益</text>
          </view>
          <view class="pass-perk-grid">
            <view class="pass-perk-chip" wx:for="{{currentLevelPerkItems}}" wx:key="label">
              <view class="pass-perk-icon-wrap">
                <image class="pass-perk-icon icon-gold" src="{{item.icon}}" mode="aspectFit"></image>
              </view>
              <text class="pass-perk-label">{{item.label}}</text>
            </view>
            <view class="pass-perk-empty" wx:if="{{currentLevelPerkItems.length === 0}}">暂无已解锁权益</view>
          </view>
          <view class="pass-level-link" catchtap="openLevelFromPass">查看等级详情</view>
          <view class="qr-tips">{{passCouponHint ? '请专员扫码核销礼券' : '出示此码以享受门店权益'}}</view>
          <view class="qr-tips sub">动态验证码，请勿截图转发</view>
          <view class="qr-tips sub" wx:if="{{passCouponHint}}">专员核销后，本页将自动提示成功</view>
        </scroll-view>
      </block>

    </view>
  </view>

  <!-- 🟢 官方社群二维码弹窗 -->
  <view class="group-mask {{showGroupModal ? 'active' : ''}}" bindtap="closeGroupModal" wx:if="{{showGroupModal}}"> 
    <view class="group-content slide-up" catchtap="true"> 
      
      <!-- 顶部标题 -->
      <view class="group-header">
        <view class="group-close" catchtap="closeGroupModal">✕</view>
        <text class="group-title">官方社群</text>
        <text class="group-subtitle">COMMUNITY</text>
      </view> 
      
      <!-- 二维码区域 -->
      <view class="group-qr-box">
        <view class="qr-frame">
          <image 
            class="group-qr-img" 
            src="{{communityQrUrl}}" 
            mode="aspectFit"
            binderror="onQrError"
          ></image>
          <view class="qr-scan-line"></view>
        </view>
      </view> 

      <!-- 底部说明 -->
      <view class="group-footer">
         <view class="group-tips">
           <view class="tip-icon"><image src="/assets/icons/phone.png" mode="aspectFit" class="icon-gold"></image></view>
           <text class="tip-text">扫码添加微信助手</text>
         </view>
         <view class="group-desc">
           <text>添加后，助手将邀您进入官方服务微信群</text>
         </view>
      </view>

    </view> 
  </view>

  <!-- 🟢 数据统计弹窗 -->
  <view class="statistics-mask {{showStatisticsModal ? 'active' : ''}}" bindtap="closeStatistics" wx:if="{{showStatisticsModal}}">
    <view class="statistics-content slide-up" catchtap="true">
      <!-- 头部 -->
      <view class="statistics-header">
        <view class="statistics-close" catchtap="closeStatistics">✕</view>
        <text class="statistics-title">我的数据</text>
        <text class="statistics-subtitle">STATISTICS</text>
      </view>

      <!-- 内容区域 -->
      <scroll-view scroll-y="true" class="statistics-body">
        <!-- 我的数据 -->
        <view class="stat-section">
          <view class="section-title">
            <text class="title-cn">我的数据</text>
            <text class="title-en">MY DATA</text>
          </view>
          <view class="stat-grid">
            <view class="stat-card">
              <view class="card-icon"><image src="/assets/icons/eye.png" mode="aspectFit" class="icon-gold"></image></view>
              <text class="card-val">{{statistics.viewCount || 0}}</text>
              <text class="card-label">浏览数</text>
            </view>
            <view class="stat-card">
              <view class="card-icon"><image src="/assets/icons/heart.png" mode="aspectFit" class="icon-gold"></image></view>
              <text class="card-val">{{statistics.collectCount || 0}}</text>
              <text class="card-label">收藏数</text>
            </view>
            <view class="stat-card">
              <view class="card-icon"><image src="/assets/icons/share.png" mode="aspectFit" class="icon-gold"></image></view>
              <text class="card-val">{{statistics.shareCount || 0}}</text>
              <text class="card-label">分享数</text>
            </view>
            <view class="stat-card">
              <view class="card-icon"><image src="/assets/icons/search.png" mode="aspectFit" class="icon-gold"></image></view>
              <text class="card-val">{{statistics.searchCount || 0}}</text>
              <text class="card-label">搜索数</text>
            </view>
          </view>
        </view>

        <!-- 消费统计 -->
        <view class="stat-section">
          <view class="section-title">
            <text class="title-cn">消费统计</text>
            <text class="title-en">CONSUMPTION</text>
          </view>
          <view class="stat-list">
            <view class="stat-row">
              <text class="row-label">总消费</text>
              <text class="row-value gold">¥{{statistics.totalConsumption || '0.00'}}</text>
            </view>
            <view class="stat-row">
              <text class="row-label">订单数</text>
              <text class="row-value">{{statistics.orderCount || 0}} 笔</text>
            </view>
            <view class="stat-row">
              <text class="row-label">平均客单价</text>
              <text class="row-value">¥{{statistics.avgOrderValue || '0.00'}}</text>
            </view>
          </view>
        </view>

        <!-- 学习记录 -->
        <view class="stat-section">
          <view class="section-title">
            <text class="title-cn">学习记录</text>
            <text class="title-en">LEARNING</text>
          </view>
          <view class="stat-grid">
            <view class="stat-card">
              <view class="card-icon"><image src="/assets/icons/knowledge.png" mode="aspectFit" class="icon-gold"></image></view>
              <text class="card-val">{{statistics.courseCount || 0}}</text>
              <text class="card-label">完成课程</text>
            </view>
            <view class="stat-card">
              <view class="card-icon"><image src="/assets/icons/medal_gold.png" mode="aspectFit" class="icon-gold"></image></view>
              <text class="card-val">{{statistics.certificateCount || 0}}</text>
              <text class="card-label">获得证书</text>
            </view>
          </view>
        </view>

        <!-- 收藏分类 -->
        <view class="stat-section">
          <view class="section-title">
            <text class="title-cn">收藏分类</text>
            <text class="title-en">COLLECTIONS</text>
          </view>
          <view class="stat-list">
            <view class="stat-row">
              <text class="row-label">藏品</text>
              <text class="row-value">{{statistics.collectionByType.product || 0}} 件</text>
            </view>
            <view class="stat-row">
              <text class="row-label">活动</text>
              <text class="row-value">{{statistics.collectionByType.activity || 0}} 个</text>
            </view>
            <view class="stat-row">
              <text class="row-label">课程</text>
              <text class="row-value">{{statistics.collectionByType.course || 0}} 门</text>
            </view>
          </view>
        </view>

        <!-- 活跃度 -->
        <view class="stat-section">
          <view class="section-title">
            <text class="title-cn">活跃度</text>
            <text class="title-en">ACTIVITY</text>
          </view>
          <view class="stat-list">
            <view class="stat-row">
              <text class="row-label">最后活跃</text>
              <text class="row-value">{{formattedLastActive}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <member-level-modal
    visible="{{showLevelModal}}"
    level="{{level}}"
    card-skin-class="{{cardSkinClass}}"
    specimen-emoji="{{specimenEmoji}}"
    level-name="{{levelName}}"
    next-threshold="{{nextThreshold}}"
    progress-percent="{{progressPercent}}"
    progress-width="{{progressWidth}}"
    growth-value="{{growthValue}}"
    next-level-preview="{{nextLevelPreview}}"
    level-benefits="{{levelBenefits}}"
    bind:close="closeLevelModal"
  />

  <!-- 等级升级铭牌动效 -->
  <view class="level-up-mask {{showLevelUp ? 'active' : ''}}" wx:if="{{showLevelUp}}" bindtap="closeLevelUp">
    <view class="level-up-plate" catchtap="true">
      <view class="level-up-shine"></view>
      <text class="level-up-overline">LEVEL UP</text>
      <text class="level-up-lv">Lv{{levelUpLevel}}</text>
      <text class="level-up-name">{{levelUpName}}</text>
      <text class="level-up-hint">新权益已解锁，可在会员码中查看</text>
      <view class="level-up-btn" bindtap="closeLevelUp">继续探索</view>
    </view>
  </view>

  <!-- 生日卡 -->
  <view class="birthday-card-mask {{showBirthdayCard ? 'active' : ''}}" wx:if="{{showBirthdayCard}}" bindtap="closeBirthdayCard">
    <view class="birthday-card-plate" catchtap="true">
      <view class="birthday-card-rule" aria-hidden="true"></view>
      <text class="birthday-card-overline">BIRTHDAY NOTE</text>
      <text class="birthday-card-title">生日快乐</text>
      <text class="birthday-card-body" wx:if="{{birthdayGiftInfo.alreadyGranted}}">
        礼券已在账户里：{{birthdayGiftInfo.points}} 积分，以及 {{birthdayGiftInfo.couponCount}} 张满 {{birthdayGiftInfo.minSpend}} 减 {{birthdayGiftInfo.couponValue}} 的礼券。本月内慢慢挑一件喜欢的即可。
      </text>
      <text class="birthday-card-body" wx:else>
        山海造物为你备好了生日礼券：{{birthdayGiftInfo.points}} 积分（不计入成长值），以及 {{birthdayGiftInfo.couponCount}} 张满 {{birthdayGiftInfo.minSpend}} 减 {{birthdayGiftInfo.couponValue}} 的礼券{{birthdayGiftInfo.expireDate ? '，有效期至 ' + birthdayGiftInfo.expireDate : '，本月内可用'}}。
      </text>
      <view class="birthday-card-actions">
        <view class="birthday-card-btn secondary" bindtap="closeBirthdayCard">收下了</view>
        <view class="birthday-card-btn primary" bindtap="goBirthdayCoupons">查看我的礼券夹</view>
      </view>
    </view>
  </view>

  <easter-egg-note id="easterEggNote" />
  <!-- 统一主视觉提示（欢迎回来等）：原生 toast 与本产品视觉脱节，见 components/AppToast -->
  <app-toast
    show="{{toastShow}}"
    overline="{{toastOverline}}"
    title="{{toastTitle}}"
    desc="{{toastDesc}}"
    duration="{{toastDuration}}"
    bind:close="onToastClose"
  />
</view>
