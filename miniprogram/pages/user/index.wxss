  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  animation: badgePulse 2s ease-in-out infinite;
  box-shadow: none;
}

/* 站内信红点提示 */
.message-badge {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, rgba(255,77,79,0.9), rgba(255,77,79,0.7));
  border: 2px solid rgba(255,77,79,0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  animation: messageBadgePulse 2s ease-in-out infinite;
  box-shadow: 0 0 16rpx rgba(255,77,79,0.5);
}
@keyframes messageBadgePulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 16rpx rgba(255,77,79,0.5);
  }
  50% {
    transform: scale(1.1);
    box-shadow: 0 0 24rpx rgba(255,77,79,0.7);
  }
}
.badge-dot {
  font-size: 20rpx;
  color: #fff;
  font-weight: 900;
  font-family: var(--font-din);
  letter-spacing: 0;
  animation: numberBounce 0.5s ease-out;
}
@keyframes badgePulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: none;
  }
  50% {
    transform: scale(1.1);
    box-shadow: none;
  }
}
.badge-count {
  font-size: 20rpx;
  color: var(--gold);
  font-weight: 900;
  font-family: var(--font-din);
  letter-spacing: 0;
  animation: numberBounce 0.5s ease-out;
}
@keyframes numberBounce {
  0% {
    opacity: 0;
    transform: scale(0) rotate(-180deg);
  }
  50% {
    transform: scale(1.2) rotate(0deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

