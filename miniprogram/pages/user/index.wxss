/* pages/user/index.wxss */
/* 继承 app.wxss */

.container { padding: 0 30rpx 40rpx; }

/* === 1. 会员卡 === */
.vip-card-container {
  width: 100%; 
  height: 408rpx; 
  margin-top: 30rpx; 
  margin-bottom: 50rpx;
}

.vip-card-stage {
  width: 100%;
  height: 100%;
  position: relative;
}

.vip-card {
  width: 100%; 
  height: 100%;
  border-radius: 24rpx; 
  position: absolute;
  top: 0;
  left: 0;
  overflow: hidden;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.45);
  box-shadow: none;
  padding: 32rpx 36rpx 28rpx;
  display: flex; 
  flex-direction: column; 
  box-sizing: border-box;
  transition: opacity 0.32s ease, transform 0.32s ease;
}

.vip-card-front {
  z-index: 2;
  opacity: 1;
  transform: scale(1);
  justify-content: flex-start;
}

.vip-card-back {
  z-index: 1;
  opacity: 0;
  transform: scale(0.98);
  pointer-events: none;
  padding: 0;
  justify-content: flex-start;
}

.vip-card-container.is-flipped .vip-card-front {
  opacity: 0;
  transform: scale(0.98);
  pointer-events: none;
  z-index: 1;
}

.vip-card-container.is-flipped .vip-card-back {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
  z-index: 2;
}

/* 动态光效 - 增强金色光泽 */
.card-shine {
  position: absolute; 
  top: -100%; 
  left: -100%; 
  width: 300%; 
  height: 300%;
  background: linear-gradient(
    115deg, 
    transparent 38%, 
    rgba(255,255,255,0.05) 42%, 
    rgba(196, 167, 108,0.15) 48%, 
    rgba(255,255,255,0.05) 52%, 
    transparent 58%
  );
  animation: sheen 8s infinite linear; 
  pointer-events: none; 
  z-index: 1;
}
@keyframes sheen { 
  0% { transform: translate(0, 0); } 
  100% { transform: translate(50%, 50%); } 
}

.bg-texture {
  position: absolute; 
  top: 0; 
  left: 0; 
  width: 100%; 
  height: 100%; 
  opacity: 0.15;
  background-image: radial-gradient(rgba(196, 167, 108,0.3) 1px, transparent 1px); 
  background-size: 24rpx 24rpx;
  z-index: 0;
}

/* 顶部品牌与操作 - 黑金质感优化 */
.card-top { 
  position: relative; 
  z-index: 2; 
  display: flex; 
  justify-content: space-between; 
  align-items: flex-start; 
}
.org-name { 
  display: flex; 
  flex-direction: column; 
}
.org-name .cn { 
  font-size: 30rpx; 
  font-weight: 600; 
  color: #fff; 
  letter-spacing: 0.2em;
  margin-bottom: 6rpx;
  text-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.8),
    0 1rpx 4rpx rgba(0,0,0,0.6);
}
.org-name .en { 
  font-family: var(--font-din); 
  font-size: 18rpx; 
  color: var(--gold); 
  letter-spacing: 0.12em; 
  margin-bottom: 6rpx; 
  font-weight: 600;
}
.org-name .tagline {
  font-size: 20rpx;
  color: rgba(213, 209, 200, 0.9);
  letter-spacing: 0.18em;
  font-weight: 400;
}

/* 签到胶囊 (黑金质感玻璃态) */
.action-pill {
  display: flex; 
  align-items: center;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.15), rgba(196, 167, 108,0.08));
  border: 1.5px solid rgba(196, 167, 108,0.4);
  border-radius: 32rpx; 
  padding: 8rpx 18rpx; 
  backdrop-filter: blur(10px);
  box-shadow: 
    0 4rpx 12rpx rgba(0,0,0,0.3),
    0 0 16rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  transition: all 0.3s;
}
.action-pill:active {
  background: linear-gradient(135deg, rgba(196, 167, 108,0.22), rgba(196, 167, 108,0.12));
  border-color: rgba(196, 167, 108,0.6);
  transform: scale(0.97);
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.4),
    0 0 20rpx rgba(196, 167, 108,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.15);
}
.ap-icon { width: 26rpx; height: 26rpx; margin-right: 10rpx; filter: brightness(1.2); }
.ap-text { 
  font-size: 24rpx; 
  color: var(--gold); 
  font-weight: 800;
  letter-spacing: 2rpx;
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.3);
}
.ap-line { 
  width: 1px; 
  height: 24rpx; 
  background: rgba(196, 167, 108,0.3); 
  margin: 0 18rpx; 
}
.qr-btn { 
  display: flex; 
  align-items: center;
  padding: 4rpx;
  border-radius: 50%;
  transition: all 0.3s;
}
.qr-btn:active {
  background: rgba(196, 167, 108,0.15);
  transform: scale(0.9);
}
.qr-icon { 
  width: 32rpx; 
  height: 32rpx; 
  filter: invert(1) brightness(1.5) sepia(1) hue-rotate(15deg) saturate(2);
}

/* 中部 · 藏家身份 */
.card-main {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 0;
  padding: 8rpx 0 12rpx;
}

/* 用户信息行 */
.user-info-row { display: flex; align-items: center; flex: 1; }
.text-meta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}
.nick-row { 
  display: flex; 
  align-items: center; 
  margin-bottom: 10rpx; 
}
.nick-input { 
  font-size: 36rpx; 
  color: #fff; 
  font-weight: 900; 
  width: auto; 
  min-width: 100rpx; 
  max-width: 300rpx; 
  height: 44rpx; 
  min-height: 44rpx;
  text-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.8),
    0 1rpx 4rpx rgba(0,0,0,0.6);
  letter-spacing: 1rpx;
}
.ph { 
  color: rgba(255,255,255,0.4); 
  font-size: 28rpx; 
  font-weight: 600;
}
.edit-icon { font-size: 20rpx; color: #666; margin-left: 8rpx; }

.badge-row { 
  display: flex; 
  align-items: center; 
  gap: 14rpx; 
}
.badge-pill {
  font-size: 20rpx; 
  color: #1A1814; 
  background: linear-gradient(135deg, #A8903C 0%, #C4A76C 100%);
  background-size: 200% 100%;
  padding: 6rpx 16rpx; 
  border-radius: 8rpx; 
  font-weight: 800;
  letter-spacing: 2rpx;
  box-shadow: 
    0 4rpx 12rpx rgba(196, 167, 108,0.5),
    0 2rpx 6rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.3);
  border: 1px solid rgba(196, 167, 108,0.5);
  position: relative;
  overflow: hidden;
  animation: badge-shine 3s ease-in-out infinite;
}
@keyframes badge-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
.rate-tag {
  font-size: 20rpx; 
  color: rgba(196, 167, 108,0.9); 
  border: 1.5px solid rgba(196, 167, 108,0.4);
  padding: 6rpx 14rpx; 
  border-radius: 8rpx;
  background: linear-gradient(135deg, rgba(196, 167, 108,0.12), rgba(196, 167, 108,0.06));
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 
    0 2rpx 8rpx rgba(0,0,0,0.3),
    inset 0 1rpx 2rpx rgba(255,255,255,0.05);
  backdrop-filter: blur(8px);
  text-shadow: 0 0 8rpx rgba(196, 167, 108,0.3);
}

/* 底部 · 成长进度 */
.card-footer {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  padding-top: 22rpx;
  border-top: 1px solid rgba(196, 167, 108, 0.12);
}

.growth-panel {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
  padding-left: 44rpx;
}

.growth-panel.is-max {
  margin-bottom: 0;
}

.growth-lead {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.growth-num {
  font-family: var(--font-mono);
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1;
}

.growth-label {
  font-size: 22rpx;
  color: rgba(213, 209, 200, 0.72);
  letter-spacing: 0.08em;
}

.growth-target {
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: rgba(196, 167, 108, 0.55);
}

.growth-status {
  font-size: 22rpx;
  color: rgba(196, 167, 108, 0.78);
  letter-spacing: 0.06em;
  flex-shrink: 0;
}

.growth-status.is-max {
  color: var(--brass-400);
  font-weight: 500;
}

.card-flip-glyph {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 36rpx;
  height: 28rpx;
  opacity: 0.28;
  pointer-events: none;
}

.flip-layer {
  position: absolute;
  border: 1px solid rgba(196, 167, 108, 0.45);
  border-radius: 4rpx;
  background: rgba(196, 167, 108, 0.05);
}

.flip-layer-back {
  width: 28rpx;
  height: 20rpx;
  left: 8rpx;
  bottom: 0;
}

.flip-layer-front {
  width: 28rpx;
  height: 20rpx;
  left: 0;
  bottom: 6rpx;
}

.progress-track { 
  width: calc(100% - 44rpx); 
  margin-left: 44rpx;
  height: 6rpx; 
  background: linear-gradient(90deg, rgba(0,0,0,0.6), rgba(20,20,20,0.4));
  border-radius: 6rpx; 
  overflow: hidden;
  border: 1px solid rgba(196, 167, 108,0.2);
  box-shadow: 
    inset 0 2rpx 4rpx rgba(0,0,0,0.4),
    0 0 8rpx rgba(196, 167, 108,0.1);
}
.progress-bar { 
  height: 100%; 
  background: linear-gradient(90deg, #8A7530, #C4A76C, #E0CFA3, #C4A76C, #8A7530);
  background-size: 200% 100%;
  box-shadow: inset 0 1rpx 2rpx rgba(255,255,255,0.12);
  animation: progress-shine 2s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}
.progress-bar::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: progress-sweep 2s ease-in-out infinite;
}
@keyframes progress-shine {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
@keyframes progress-sweep {
  0% { left: -100%; }
  100% { left: 100%; }
}

.member-no-inline {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-shrink: 0;
}

.card-flip-hint {
  font-size: 18rpx;
  color: rgba(196, 167, 108, 0.45);
  letter-spacing: 0.06em;
  flex-shrink: 0;
}

.card-flip-hint.back {
  color: rgba(196, 167, 108, 0.55);
}
.member-no-label {
  font-size: 18rpx;
  color: rgba(196, 167, 108, 0.55);
  letter-spacing: 0.14em;
  font-weight: 500;
  flex-shrink: 0;
  font-family: var(--font-din);
}
.member-no-code {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* === 会员卡背板 · 藏家铭牌 === */
.cb-stripe {
  flex-shrink: 0;
  width: 100%;
  height: 44rpx;
  background: linear-gradient(180deg, #14120f, #1e1a14);
  border-bottom: 1px solid rgba(196, 167, 108, 0.18);
  position: relative;
  z-index: 2;
}

.cb-stripe::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.1) 0,
    rgba(196, 167, 108, 0.1) 2rpx,
    transparent 2rpx,
    transparent 10rpx
  );
}

.cb-body {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
  padding: 20rpx 32rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  overflow: hidden;
}

.cb-head-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.cb-head-main {
  flex: 1;
  min-width: 0;
}

.cb-overline {
  display: block;
  font-size: 16rpx;
  color: var(--brass-400);
  letter-spacing: 0.14em;
  margin-bottom: 4rpx;
}

.cb-title {
  display: block;
  font-size: 30rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  line-height: 1.2;
}

.cb-member {
  font-size: 20rpx;
  font-family: var(--font-mono);
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.08em;
  flex-shrink: 0;
  text-align: right;
}

.cb-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 18rpx;
  background: rgba(31, 29, 26, 0.9);
  border: 1px solid rgba(196, 167, 108, 0.16);
  border-radius: var(--radius-md);
}

.cb-row-label,
.cb-tags-label {
  font-size: 18rpx;
  color: rgba(196, 167, 108, 0.65);
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.cb-row-content {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.cb-row-val {
  display: block;
  font-size: 28rpx;
  font-family: var(--font-mono);
  color: var(--brass-400);
  font-weight: 600;
  line-height: 1.2;
}

.cb-row-sub {
  display: block;
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cb-row-link {
  font-size: 22rpx;
  color: var(--brass-400);
  flex-shrink: 0;
}

.cb-birthday-row.today {
  border-color: rgba(196, 167, 108, 0.4);
  background: rgba(196, 167, 108, 0.08);
}

.cb-birthday-row.today .cb-row-val {
  color: #fff;
}

.cb-stats-row {
  display: flex;
  align-items: stretch;
  gap: 10rpx;
}

.cb-stat-cell {
  flex: 1;
  min-width: 0;
  padding: 12rpx 8rpx;
  text-align: center;
  background: rgba(31, 29, 26, 0.9);
  border: 1px solid rgba(196, 167, 108, 0.14);
  border-radius: var(--radius-md);
}

.cb-stat-val {
  display: block;
  font-size: 24rpx;
  font-family: var(--font-mono);
  color: #fff;
  font-weight: 600;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cb-stat-label {
  display: block;
  font-size: 16rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.cb-tags-block {
  min-height: 0;
  flex-shrink: 1;
}

.cb-tag-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 8rpx;
}

.cb-tag-inner {
  display: inline-flex;
  gap: 8rpx;
}

.cb-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  border: 1px solid;
  font-size: 20rpx;
  flex-shrink: 0;
}

.cb-persona {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cb-tags-empty {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.card-back-foot {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 32rpx 24rpx;
  border-top: 1px solid rgba(196, 167, 108, 0.1);
}

.cb-since {
  font-size: 20rpx;
  color: rgba(196, 167, 108, 0.55);
  letter-spacing: 0.04em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

/* === 2. 仪表盘 === */
.stats-panel {
  display: flex; justify-content: space-around; align-items: center;
  padding: 36rpx 0; margin-bottom: 40rpx;
  background: #1F1D1A; border-radius: 20rpx; border: 1px solid var(--border-light);
}
.stat-block { display: flex; flex-direction: column; align-items: center; flex: 1; }
.s-val { font-family: var(--font-din); font-size: 44rpx; font-weight: bold; color: #fff; margin-bottom: 4rpx; }
.s-val.gold { color: var(--gold); text-shadow: 0 0 10rpx rgba(196, 167, 108,0.2); }
.s-key { font-size: 22rpx; color: #666; }
.v-sep { width: 1px; height: 30rpx; background: #333; }

/* 4宫格资产 */
.assets-panel {
  display: flex; justify-content: space-between; align-items: center;
  background: #1F1D1A; border-radius: 20rpx; padding: 30rpx 0; margin-bottom: 30rpx;
  border: 1px solid rgba(255,255,255,0.05);
}
.asset-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.as-icon { width: 40rpx; height: 40rpx; margin-bottom: 8rpx; opacity: 0.8; }
.as-val { font-family: 'DIN'; font-size: 32rpx; font-weight: bold; color: #fff; margin-bottom: 4rpx; }
.as-lbl { font-size: 20rpx; color: #666; }
.v-divider { width: 1px; height: 40rpx; background: #333; }

/* 会员权益 */
.benefits-grid { display: flex; justify-content: space-between; padding: 20rpx 10rpx; }
.benefit-item { display: flex; flex-direction: column; align-items: center; opacity: 0.3; filter: grayscale(1); transition: all 0.3s; }
.benefit-item.active { opacity: 1; filter: grayscale(0); }
.b-icon-box { 
  width: 80rpx; height: 80rpx; background: rgba(196, 167, 108,0.1); 
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; margin-bottom: 12rpx; border: 1px solid rgba(196, 167, 108,0.3);
  color: #C4A76C;
}
.benefit-item text { font-size: 20rpx; color: #aaa; }
.benefit-item.active text { color: #C4A76C; font-weight: bold; }


/* === 3. 服务菜单 (保持原样，微调间距) === */
.panel-box { 
  margin-bottom: 40rpx; 
  background: #1F1D1A; 
  border-radius: 20rpx; 
  border: 1px solid var(--border-light);
  padding: 32rpx;
  box-sizing: border-box;
}
.panel-head { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 24rpx; 
  border-left: 6rpx solid var(--gold); 
  padding-left: 20rpx;
}
.ph-title { font-size: 28rpx; font-weight: 900; color: #eee; }
.ph-more { font-family: var(--font-din); font-size: 20rpx; color: #666; }

/* 数据统计预览样式 */
.stats-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0;
  padding: 20rpx 0;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.stat-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold);
  font-family: var(--font-din);
  letter-spacing: 1rpx;
  line-height: 1;
  animation: numberCountUp 0.6s ease-out;
}
@keyframes numberCountUp {
  from {
    opacity: 0;
    transform: translateY(10rpx) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  letter-spacing: 1rpx;
}
.stat-divider {
  width: 1px;
  height: 60rpx;
  background: linear-gradient(to bottom, transparent, rgba(196, 167, 108,0.3), transparent);
  flex-shrink: 0;
}

.order-matrix {
  display: flex; justify-content: space-between;
  background: #1F1D1A; padding: 36rpx 20rpx; border-radius: 20rpx;
  border: 1px solid var(--border-light);
}
.om-item { display: flex; flex-direction: column; align-items: center; width: 20%; opacity: 0.9; }
.om-item:active { opacity: 0.6; }
.om-icon { width: 48rpx; height: 48rpx; margin-bottom: 16rpx; filter: invert(1); opacity: 0.7; }
.om-item text { font-size: 22rpx; color: #999; }

/* 列表式菜单 */
.service-list { background: #1F1D1A; border-radius: 20rpx; border: 1px solid var(--border-light); overflow: hidden; }
.menu-row {
  display: flex; align-items: center; padding: 32rpx;
  border-bottom: 1px solid rgba(255,255,255,0.03); position: relative;
}
.menu-row:last-child { border-bottom: none; }
.menu-row.section-start {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}
.menu-row:active { background: rgba(255,255,255,0.05); }

