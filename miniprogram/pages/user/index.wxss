  background: linear-gradient(135deg, #C4A76C, #bfa15f); 
  padding: 40rpx; text-align: center; color: #1A1814; 
  display: flex; flex-direction: column; align-items: center;
}
.qr-header text { font-weight: 900; font-size: 36rpx; letter-spacing: 4rpx; font-family: 'DIN'; }
.qr-level-badge {
  margin-top: 10rpx; font-size: 22rpx; background: rgba(0,0,0,0.1);
  padding: 4rpx 16rpx; border-radius: 20rpx; font-weight: bold;
}

/* 二维码区 */
.qr-box { 
  padding: 60rpx; display: flex; justify-content: center; background: #fff; 
  border-bottom: 1px dashed #ccc; /* 票据撕裂线效果 */
  position: relative;
}
/* 左右缺口 */
.qr-box::before, .qr-box::after {
  content: ''; position: absolute; bottom: -16rpx; width: 32rpx; height: 32rpx;
  background: #1a1a1a; border-radius: 50%;
}
.qr-box::before { left: -16rpx; }
.qr-box::after { right: -16rpx; }

.qr-code-img { width: 380rpx; height: 380rpx; }

/* 权益区 */
.qr-privileges { padding: 40rpx 30rpx; background: #1a1a1a; }
.privilege-title { 
  text-align: center; font-size: 20rpx; color: #666; letter-spacing: 4rpx; margin-bottom: 30rpx; font-family: 'DIN';
}

.p-grid { display: flex; justify-content: space-between; }
.p-item { 
  display: flex; flex-direction: column; align-items: center; 
  opacity: 0.3; filter: grayscale(1); transition: all 0.3s; 
}
.p-item.active { opacity: 1; filter: grayscale(0); }

.p-icon { 
  width: 70rpx; height: 70rpx; background: rgba(196, 167, 108,0.1); 
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  margin-bottom: 10rpx; border: 1px solid rgba(196, 167, 108,0.3);
}
.p-icon image {
  width: 40rpx;
  height: 40rpx;
}
.p-icon .icon-discount,
.p-icon .icon-drink,
.p-icon .icon-gift {
  width: 40rpx;
  height: 40rpx;
}
.p-item text { font-size: 20rpx; color: #aaa; }
.p-item.active text { color: #C4A76C; }

.qr-tips { text-align: center; margin-top: 40rpx; font-size: 20rpx; color: #555; }

/* 动画 */
.pop-in { animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
@keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }

/* ==================== 官方社群二维码弹窗 ==================== */
.group-mask { 
  position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
  background: rgba(0,0,0,0.85); backdrop-filter: blur(20px); 
  z-index: 1001; display: flex; align-items: center; justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.group-mask.active {
  opacity: 1;
  pointer-events: auto;
}

.group-content { 
  width: 640rpx; 
  background: linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%); 
  border-radius: 32rpx; 
  overflow: hidden; 
  border: 1.5px solid rgba(196, 167, 108,0.3); 
  box-shadow: 
    0 40rpx 80rpx rgba(0,0,0,0.9),
    0 0 40rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1); 
  display: flex; 
  flex-direction: column;
  transform: translateY(100rpx) scale(0.9);
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.group-mask.active .group-content {
  transform: translateY(0) scale(1);
}

/* 头部 */
.group-header { 
  background: linear-gradient(135deg, rgba(196, 167, 108,0.2), rgba(196, 167, 108,0.05)); 
  padding: 40rpx 40rpx 30rpx; 
  text-align: center; 
  position: relative;
  border-bottom: 1px solid rgba(196, 167, 108,0.2);
}
.group-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.8);
  font-size: 32rpx;
  font-weight: 300;
  transition: all 0.3s;
  border: 1px solid rgba(255,255,255,0.1);
}
.group-close:active {
  background: rgba(255,255,255,0.2);
  transform: scale(0.95);
}
.group-title { 
  font-size: 40rpx; 
  font-weight: 900; 
  color: #fff; 
  letter-spacing: 2rpx; 
  display: block;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}
.group-subtitle { 
  font-family: 'DIN'; 
  font-size: 20rpx; 
  color: var(--gold); 
  letter-spacing: 4rpx; 
  text-transform: uppercase;
  opacity: 0.8;
}

/* 二维码区域 */
.group-qr-box { 
  padding: 60rpx 40rpx; 
  display: flex; 
  justify-content: center; 
  align-items: center;
  background: #fff;
  position: relative;
  overflow: hidden;
}
.qr-frame {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 
    0 8rpx 24rpx rgba(0,0,0,0.2),
    inset 0 0 0 4rpx rgba(196, 167, 108,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.group-qr-img { 
  width: 440rpx; 
  height: 440rpx; 
  border-radius: 8rpx;
}
.qr-scan-line {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  height: 2rpx;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(196, 167, 108,0.6) 50%, 
    transparent 100%
  );
  animation: scanLine 2s ease-in-out infinite;
  box-shadow: none;
}
@keyframes scanLine {
  0%, 100% { 
    top: 20rpx; 
    opacity: 0.6;
  }
  50% { 
    top: calc(100% - 22rpx); 
    opacity: 1;
  }
}

/* 底部说明 */
.group-footer { 
  padding: 40rpx 30rpx; 
  background: #1a1a1a;
  text-align: center;
}
.group-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}
.tip-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tip-icon .icon-phone {
  width: 32rpx;
  height: 32rpx;
}
.tip-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.group-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  line-height: 1.6;
}

/* 滑入动画 */
.slide-up {
  animation: slideUpModal 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes slideUpModal {
  from { 
    transform: translateY(100rpx) scale(0.9); 
    opacity: 0; 
  }
  to { 
    transform: translateY(0) scale(1); 
    opacity: 1; 
  }
}

/* === 数据统计弹窗样式 === */
.statistics-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(10px);
  z-index: 1002;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.statistics-mask.active {
  opacity: 1;
  pointer-events: auto;
}
.statistics-content {
  width: 85%;
  max-width: 600rpx;
  max-height: 80vh;
  background: linear-gradient(135deg, rgba(0,0,0,0.95) 0%, rgba(20,20,20,0.9) 100%);
  border: 2px solid rgba(196, 167, 108,0.3);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.8);
  display: flex;
  flex-direction: column;
  position: relative;
}
.statistics-header {
  position: relative;
  padding: 40rpx 30rpx 30rpx;
  text-align: center;
  border-bottom: 1px solid rgba(196, 167, 108,0.2);
}
.statistics-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  transition: opacity 0.3s;
}
.statistics-close:active {
  opacity: 0.6;
}
.statistics-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 8rpx;
}
.statistics-subtitle {
  font-size: 20rpx;
  color: rgba(196, 167, 108,0.8);
  letter-spacing: 4rpx;
  text-transform: uppercase;
  display: block;
}
.statistics-body {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.statistics-body::-webkit-scrollbar {
  width: 6rpx;
}
.statistics-body::-webkit-scrollbar-track {
  background: rgba(0,0,0,0.2);
  border-radius: 3rpx;
}
.statistics-body::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(196, 167, 108,0.6), rgba(196, 167, 108,0.4));
  border-radius: 3rpx;
}
.stat-section {
  margin-bottom: 40rpx;
}
.section-title {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid rgba(196, 167, 108,0.2);
}
.title-cn {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 6rpx;
}
.title-en {
  font-size: 18rpx;
  color: rgba(196, 167, 108,0.7);
  letter-spacing: 3rpx;
  text-transform: uppercase;
}
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.stat-card {
  padding: 24rpx;
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s;
}
.stat-card:active {
  transform: scale(0.97);
  background: rgba(196, 167, 108,0.1);
  border-color: rgba(196, 167, 108,0.3);
}
.card-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12rpx;
}
.card-icon image {
  width: 48rpx;
  height: 48rpx;
}
.card-icon .icon-eye,
.card-icon .icon-search {
  width: 48rpx;
  height: 48rpx;
}
.card-val {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(196, 167, 108,0.9);
  font-family: var(--font-din);
  display: block;
  margin-bottom: 8rpx;
  animation: numberCountUp 0.6s ease-out;
}
.card-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}
.stat-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(196, 167, 108,0.2);
  border-radius: 12rpx;
}
.stat-row-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 1rpx;
}
.stat-row-value {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(196, 167, 108,0.9);
  font-family: var(--font-din);
  letter-spacing: 1rpx;
}

/* 藏家档案条 */
.profile-archive {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--color-border-highlight);
  border-radius: var(--radius-lg);
}

.archive-label {
  display: block;
  font-size: 22rpx;
  color: var(--brass-400);
  letter-spacing: 0.08em;
  margin-bottom: 6rpx;
}

.archive-score {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-family: var(--font-mono);
  margin-bottom: 8rpx;
}

.archive-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }

.archive-tag {
  font-size: 20rpx;
  color: var(--brass-400);
  padding: 2rpx 12rpx;
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-full);
}

.archive-hint {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.archive-arrow {
  font-size: 24rpx;
  color: var(--brass-400);
  flex-shrink: 0;
}

.avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  margin-right: 28rpx;
  border-radius: 50%;
  border: 2px solid rgba(196, 167, 108, 0.5);
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-wrap .avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.nick-display {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
}

.profile-edit-hint {
  font-size: 36rpx;
  color: var(--brass-400);
  opacity: 0.6;
  margin-left: 12rpx;
}

.profile-score-bar {
  height: 4rpx;
  background: rgba(196, 167, 108, 0.15);
  border-radius: 4rpx;
  margin: 20rpx 0 0;
  overflow: hidden;
}

.profile-score-fill {
  height: 100%;
  background: var(--brass-400);
  border-radius: 4rpx;
}

.qr-canvas {
  width: 360rpx;
  height: 360rpx;
  display: block;
  margin: 0 auto;
}

.pass-countdown {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--brass-400);
  margin-top: 12rpx;
}

.pass-member-no {
  display: block;
  text-align: center;
  font-size: 24rpx;
  font-family: var(--font-mono);
  color: rgba(255,255,255,0.75);
  margin-top: 8rpx;
  letter-spacing: 0.06em;
}

.qr-tips.sub {
  font-size: 20rpx;
  opacity: 0.65;
  margin-top: 4rpx;
}

/* 新用户引导条 */
.onboard-banner {
  position: relative;
  margin: 24rpx 0 8rpx;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
}

.onboard-banner-body {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding-right: 48rpx;
}

.onboard-ring {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.onboard-ring-inner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.onboard-ring-val {
  font-size: 20rpx;
  font-family: var(--font-mono);
  color: var(--brass-400);
  font-weight: 600;
}

.onboard-banner-text {
  flex: 1;
  min-width: 0;
}

.onboard-banner-title {
  display: block;
  font-size: 28rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  margin-bottom: 6rpx;
}

.onboard-banner-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.onboard-banner-cta {
  font-size: 24rpx;
  color: var(--brass-400);
  flex-shrink: 0;
}

.onboard-banner-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-text-muted);
  line-height: 1;
}

/* 档案条环形进度 */
.profile-archive {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.archive-ring-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.archive-ring-inner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.archive-ring-val {
  font-size: 22rpx;
  font-family: var(--font-mono);
  color: var(--brass-400);
  font-weight: 600;
}

.archive-left {
  flex: 1;
  min-width: 0;
}

/* 会员码权益列表 */
.pass-perk-list {
  margin-bottom: var(--space-3);
  text-align: left;
  padding: 0 var(--space-2);
}

.pass-perk-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.pass-perk-dot {
  color: var(--brass-400);
  font-size: 24rpx;
  line-height: 1.4;
}

.pass-perk-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  line-height: 1.4;
}

.pass-level-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--brass-400);
  padding: var(--space-2) 0;
  margin-bottom: var(--space-2);
  border-top: 1px solid rgba(196,167,108,0.15);
  border-bottom: 1px solid rgba(196,167,108,0.15);
}

.next-level-preview {
  margin-top: var(--space-3);
  padding: var(--space-3);
  background: rgba(196,167,108,0.06);
  border: 1px solid rgba(196,167,108,0.2);
  border-radius: var(--radius-md);
  text-align: center;
}

.nlp-label {
  display: block;
  font-size: 24rpx;
  color: var(--brass-400);
  font-weight: 600;
  margin-bottom: 6rpx;
}

.nlp-meta {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 等级升级铭牌 */
.level-up-mask {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(26, 24, 20, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
  box-sizing: border-box;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
}

.level-up-mask.active {
  opacity: 1;
  pointer-events: auto;
}

.level-up-plate {
  width: 100%;
  max-width: 560rpx;
  padding: var(--space-6) var(--space-4);
  background: var(--color-bg-card);
  border: 1px solid var(--brass-800);
  border-radius: var(--radius-lg);
  text-align: center;
  position: relative;
  overflow: hidden;
  animation: levelUpIn 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes levelUpIn {
  from { transform: scale(0.85) translateY(40rpx); opacity: 0; }
  to { transform: scale(1) translateY(0); opacity: 1; }
}

.level-up-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(115deg, transparent 40%, rgba(196,167,108,0.12) 50%, transparent 60%);
  animation: sheen 3s infinite linear;
  pointer-events: none;
}

.level-up-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.2em;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.level-up-lv {
  display: block;
  font-size: 72rpx;
  font-family: var(--font-mono);
  color: var(--brass-400);
  font-weight: 700;
  line-height: 1;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.level-up-name {
  display: block;
  font-size: 36rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.level-up-hint {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: var(--space-4);
  position: relative;
  z-index: 1;
}

.level-up-btn {
  height: 80rpx;
  line-height: 80rpx;
  background: var(--brass-400);
  color: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}