/* pages/user/messages/index.wxss */
page {
  background: var(--color-bg, #1A1814);
  color: var(--color-text-primary, #FFFFFF);
}

.page-msg {
  min-height: 100vh;
  position: relative;
  background: var(--color-bg, #1A1814);
}

.grain-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  z-index: 0;
}

/* 吸顶头部 */
.sticky-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(26, 24, 20, 0.96);
  border-bottom: 1px solid rgba(38, 35, 32, 0.6);
  backdrop-filter: blur(12px);
  pointer-events: none;
}

.sticky-header .back-btn,
.sticky-header .mark-read-btn,
.sticky-header .filter-scroll,
.sticky-header .filter-pill {
  pointer-events: auto;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 12rpx;
  gap: 16rpx;
}

.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-text-secondary, #A09A90);
  flex-shrink: 0;
}

.nav-brand {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-title {
  font-family: var(--font-brand, 'Source Han Serif SC', serif);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
  letter-spacing: 0.06em;
}

.nav-sub {
  font-size: 20rpx;
  color: var(--brass-400, #C4A76C);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.mark-read-btn {
  padding: 10rpx 20rpx;
  border: 1px solid rgba(196, 167, 108, 0.35);
  border-radius: var(--radius-full, 9999px);
  flex-shrink: 0;
}

.mark-read-btn text {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  font-weight: 500;
}

.mark-read-placeholder {
  width: 120rpx;
  flex-shrink: 0;
}

/* 分类 Pill */
.filter-scroll {
  white-space: nowrap;
  padding: 12rpx 32rpx 28rpx;
  height: 96rpx;
  box-sizing: border-box;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-full, 9999px);
  border: 1px solid rgba(38, 35, 32, 0.8);
  background: var(--color-bg-card, #1F1D1A);
}

.filter-pill text {
  font-size: 24rpx;
  color: var(--color-text-secondary, #A09A90);
  font-weight: 500;
}

.filter-pill.active {
  border-color: rgba(196, 167, 108, 0.5);
  background: rgba(196, 167, 108, 0.12);
}

.filter-pill.active text {
  color: var(--brass-400, #C4A76C);
}

.filter-pad {
  display: inline-block;
  width: 16rpx;
}

/* 主滚动区 */
.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  box-sizing: border-box;
}

.scroll-top-pad {
  height: 32rpx;
  flex-shrink: 0;
}

/* 骨架屏 */
.skeleton-wrap {
  padding: 16rpx 32rpx 32rpx;
}

.sk-card {
  height: 160rpx;
  border-radius: var(--radius-lg, 24rpx);
  margin-bottom: 24rpx;
  background: var(--color-bg-card, #1F1D1A);
}

.sk-shine {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.04) 0%,
    rgba(196, 167, 108, 0.09) 50%,
    rgba(196, 167, 108, 0.04) 100%
  );
  background-size: 200% 100%;
  animation: shine 1.4s ease infinite;
}

@keyframes shine {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.25;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--color-text-body, #D5D1C8);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted, #6B6560);
}

/* 消息列表 */
.message-list {
  padding: 16rpx 32rpx 48rpx;
}

.message-item {
  position: relative;
  display: flex;
  gap: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-card, #1F1D1A);
  border: 1px solid rgba(38, 35, 32, 0.6);
  border-radius: var(--radius-lg, 24rpx);
}

.message-item:active {
  opacity: 0.92;
}

.message-item.unread {
  border-color: rgba(196, 167, 108, 0.35);
  background: linear-gradient(135deg, rgba(31, 29, 26, 1) 0%, rgba(38, 35, 28, 0.95) 100%);
}

.unread-dot {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--brass-400, #C4A76C);
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(196, 167, 108, 0.5);
}

.message-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1px solid rgba(38, 35, 32, 0.8);
  background: rgba(196, 167, 108, 0.08);
  margin-left: 8rpx;
}

.message-icon-wrap.cat-booking { background: rgba(91, 143, 185, 0.12); border-color: rgba(91, 143, 185, 0.25); }
.message-icon-wrap.cat-order { background: rgba(196, 167, 108, 0.12); border-color: rgba(196, 167, 108, 0.25); }
.message-icon-wrap.cat-activity { background: rgba(123, 104, 174, 0.12); border-color: rgba(123, 104, 174, 0.25); }
.message-icon-wrap.cat-system { background: rgba(45, 90, 63, 0.12); border-color: rgba(45, 90, 63, 0.25); }

.message-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.85;
}

.message-body {
  flex: 1;
  min-width: 0;
}

.message-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.title-row {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.type-tag {
  font-size: 20rpx;
  color: var(--brass-600, #8A7530);
  letter-spacing: 0.05em;
  font-weight: 500;
}

.message-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-time {
  font-size: 20rpx;
  color: var(--color-text-muted, #6B6560);
  flex-shrink: 0;
  font-family: var(--font-mono, monospace);
}

.message-preview {
  font-size: 24rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.message-foot {
  margin-top: 12rpx;
}

.action-hint {
  font-size: 22rpx;
  color: var(--brass-400, #C4A76C);
  letter-spacing: 0.02em;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--brass-400, #C4A76C);
}

.load-more.muted {
  color: var(--color-text-muted, #6B6560);
}

/* 详情弹层 */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(26, 24, 20, 0.75);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.detail-mask.active {
  opacity: 1;
  pointer-events: all;
}

.detail-sheet {
  width: 100%;
  max-height: 78vh;
  background: var(--color-bg-card, #1F1D1A);
  border-top: 1px solid rgba(196, 167, 108, 0.25);
  border-radius: var(--radius-xl, 32rpx) var(--radius-xl, 32rpx) 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.28s ease;
}

.detail-mask.active .detail-sheet {
  transform: translateY(0);
}

.sheet-handle {
  width: 64rpx;
  height: 6rpx;
  background: rgba(196, 167, 108, 0.3);
  border-radius: 3rpx;
  margin: 16rpx auto 0;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.detail-type {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--brass-400, #C4A76C);
}

.detail-type.cat-booking { color: #5B8FB9; }
.detail-type.cat-order { color: var(--brass-400, #C4A76C); }
.detail-type.cat-activity { color: #7B68AE; }
.detail-type.cat-system { color: #2D5A3F; }

.detail-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-secondary, #A09A90);
}

.detail-scroll {
  flex: 1;
  padding: 0 32rpx 24rpx;
  max-height: 50vh;
  box-sizing: border-box;
}

.detail-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary, #FFFFFF);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.detail-time {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted, #6B6560);
  font-family: var(--font-mono, monospace);
}

.detail-divider {
  height: 1px;
  background: rgba(38, 35, 32, 0.8);
  margin: 24rpx 0;
}

.detail-content {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-body, #D5D1C8);
  line-height: 1.75;
  white-space: pre-wrap;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(38, 35, 32, 0.8);
}

.btn-secondary,
.btn-primary {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-md, 16rpx);
  border: none;
}

.btn-secondary {
  background: transparent;
  color: var(--color-text-body, #D5D1C8);
  border: 1px solid rgba(38, 35, 32, 0.8);
}

.btn-primary {
  background: var(--brass-400, #C4A76C);
  color: var(--color-bg, #1A1814);
}

.btn-secondary::after,
.btn-primary::after {
  border: none;
}
