<!--pages/user/messages/index.wxml-->
<view class="page-msg">
  <view class="grain-overlay"></view>

  <!-- 吸顶头部 -->
  <view class="sticky-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-row">
      <view class="back-btn" bindtap="goBack">←</view>
      <view class="nav-brand">
        <text class="nav-title">山海有信</text>
        <text class="nav-sub" wx:if="{{unreadCount > 0}}">{{unreadCount}} 条未读</text>
        <text class="nav-sub" wx:else>MESSAGES</text>
      </view>
      <view class="mark-read-btn" bindtap="markAllRead" wx:if="{{unreadCount > 0}}">
        <text>全部已读</text>
      </view>
      <view class="mark-read-placeholder" wx:else></view>
    </view>

    <!-- 分类筛选 -->
    <scroll-view scroll-x class="filter-scroll" enable-flex show-scrollbar="{{false}}">
      <view
        class="filter-pill {{activeCategory === item.id ? 'active' : ''}}"
        wx:for="{{filterTabs}}"
        wx:key="id"
        bindtap="switchCategory"
        data-id="{{item.id}}"
      >
        <text>{{item.label}}</text>
      </view>
      <view class="filter-pad"></view>
    </scroll-view>
  </view>

  <scroll-view
    scroll-y
    class="main-scroll"
    style="top: {{headerHeight}}px;"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onReachBottom"
    lower-threshold="80"
    refresher-background="transparent"
  >
    <view class="scroll-top-pad"></view>
    <!-- 骨架屏 -->
    <view class="skeleton-wrap" wx:if="{{loading}}">
      <view class="sk-card sk-shine" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{messages.length === 0}}">
      <image class="empty-icon" src="/assets/icons/message.png" mode="aspectFit"></image>
      <text class="empty-text">暂无消息</text>
      <text class="empty-desc">预约、订单与活动通知会出现在这里</text>
    </view>

    <!-- 消息列表 -->
    <view class="message-list" wx:else>
      <view
        class="message-item {{item.isUnread ? 'unread' : ''}}"
        wx:for="{{messages}}"
        wx:key="_id"
        bindtap="viewMessage"
        bindlongpress="onLongPressDelete"
        data-id="{{item._id}}"
        data-index="{{index}}"
      >
        <view class="unread-dot" wx:if="{{item.isUnread}}"></view>

        <view class="message-icon-wrap cat-{{item.category || 'other'}}">
          <image class="message-icon" src="{{item.categoryIcon}}" mode="aspectFit"></image>
        </view>

        <view class="message-body">
          <view class="message-head">
            <view class="title-row">
              <text class="type-tag">{{item.typeName}}</text>
              <text class="message-title">{{item.title}}</text>
            </view>
            <text class="message-time">{{item.formattedTime}}</text>
          </view>
          <text class="message-preview">{{item.content}}</text>
          <view class="message-foot" wx:if="{{item.actionUrl}}">
            <text class="action-hint">{{item.actionLabel || '查看详情'}} →</text>
          </view>
        </view>
      </view>

      <view class="load-more" wx:if="{{loadingMore}}">
        <text>加载中...</text>
      </view>
      <view class="load-more muted" wx:elif="{{!hasMore && messages.length > 0}}">
        <text>— 已显示全部 —</text>
      </view>
    </view>
  </scroll-view>

  <!-- 详情弹层 -->
  <view class="detail-mask {{showDetail ? 'active' : ''}}" bindtap="closeDetail" wx:if="{{showDetail}}">
    <view class="detail-sheet" catchtap="true">
      <view class="sheet-handle"></view>
      <view class="detail-header">
        <text class="detail-type cat-{{selectedMessage.category || 'other'}}">{{selectedMessage.typeName}}</text>
        <view class="detail-close" bindtap="closeDetail">✕</view>
      </view>

      <scroll-view scroll-y class="detail-scroll">
        <text class="detail-title">{{selectedMessage.title}}</text>
        <text class="detail-time">{{selectedMessage.formattedTime}}</text>
        <view class="detail-divider"></view>
        <text class="detail-content">{{selectedMessage.content}}</text>
      </scroll-view>

      <view class="detail-actions">
        <button class="btn-secondary" bindtap="deleteMessage">删除</button>
        <button
          class="btn-primary"
          bindtap="handleAction"
          wx:if="{{selectedMessage.actionUrl}}"
        >{{selectedMessage.actionLabel || '查看详情'}}</button>
        <button class="btn-primary" bindtap="closeDetail" wx:else>关闭</button>
      </view>
    </view>
  </view>
</view>
