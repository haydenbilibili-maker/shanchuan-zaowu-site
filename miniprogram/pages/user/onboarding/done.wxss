@import '../user-account.wxss';

page {
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
}

.page-done {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.done-ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(40rpx);
}

.done-ambient-a {
  top: 18%;
  left: 50%;
  width: 420rpx;
  height: 420rpx;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(196, 167, 108, 0.14) 0%, transparent 70%);
}

.done-ambient-b {
  bottom: 12%;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(196, 167, 108, 0.08) 0%, transparent 70%);
}

.done-card {
  width: 100%;
  max-width: 660rpx;
  padding: 56rpx 40rpx 44rpx;
  background: linear-gradient(165deg, rgba(31, 29, 26, 0.98) 0%, rgba(22, 20, 17, 0.96) 100%);
  border: 1px solid rgba(196, 167, 108, 0.28);
  border-radius: 28rpx;
  text-align: center;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
  box-shadow:
    0 24rpx 64rpx rgba(0, 0, 0, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.done-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(circle at 50% 0%, rgba(196, 167, 108, 0.1) 0%, transparent 52%);
  pointer-events: none;
}

.done-icon-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 28rpx;
}

.done-icon-glow {
  position: absolute;
  inset: -16rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(196, 167, 108, 0.22) 0%, transparent 72%);
  animation: doneGlow 3.2s ease-in-out infinite;
}

@keyframes doneGlow {
  0%, 100% { opacity: 0.55; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.06); }
}

.done-icon-ring {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.45);
  background: linear-gradient(145deg, rgba(196, 167, 108, 0.16), rgba(196, 167, 108, 0.04));
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  box-shadow:
    0 8rpx 28rpx rgba(0, 0, 0, 0.35),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.1);
}

.done-icon {
  font-size: 40rpx;
  color: var(--brass-400);
}

.done-overline {
  display: block;
  font-size: 20rpx;
  color: var(--brass-400);
  letter-spacing: 0.18em;
  margin-bottom: 16rpx;
}

.done-title {
  display: block;
  font-size: 48rpx;
  font-family: var(--font-brand);
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  line-height: 1.35;
  letter-spacing: 0.02em;
}

.done-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.done-features {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.done-feat-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: var(--brass-400);
  border: 1px solid rgba(196, 167, 108, 0.28);
  border-radius: var(--radius-full);
  background: rgba(196, 167, 108, 0.06);
}

.feat-icon {
  font-size: 14rpx;
  opacity: 0.85;
}

.done-reward-plate {
  padding: var(--space-3) var(--space-4);
  margin-bottom: 32rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1px solid rgba(196, 167, 108, 0.25);
  border-radius: var(--radius-md);
}

.done-reward-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.08em;
  margin-bottom: 6rpx;
}

.done-reward {
  font-size: 24rpx;
  color: var(--brass-400);
}

.done-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.done-btn-primary {
  margin-bottom: 0;
  background: linear-gradient(135deg, #b8983f 0%, var(--brass-400) 48%, #d4bc82 100%);
  box-shadow:
    0 8rpx 24rpx rgba(196, 167, 108, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
  font-weight: 600;
  letter-spacing: 0.04em;
}

.done-btn-ghost {
  height: 76rpx;
  border-color: rgba(196, 167, 108, 0.22);
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.02);
}
