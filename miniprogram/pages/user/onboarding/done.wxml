<!--pages/user/onboarding/done.wxml-->
<view
  class="page-done account-page"
  style="padding-top: {{pagePadTop}}px; padding-bottom: {{pagePadBottom}}px; padding-left: {{pagePadX}}px; padding-right: {{pagePadX}}px;"
>
  <view class="grain-overlay"></view>
  <view class="done-ambient done-ambient-a"></view>
  <view class="done-ambient done-ambient-b"></view>

  <view class="done-card care-enter">
    <view class="done-icon-wrap">
      <view class="done-icon-glow"></view>
      <view class="done-icon-ring">
        <text class="done-icon">✦</text>
      </view>
    </view>

    <text class="done-overline">WELCOME</text>
    <text class="done-title">欢迎{{displayName ? '，' + displayName : '，藏家'}}</text>
    <text class="done-desc">你的藏家档案已建立。会员卡、养护指南与山海有信，都会在这里与你相遇。</text>

    <view class="done-features">
      <view class="done-feat-pill">
        <text class="feat-icon">◆</text>
        <text>会员卡</text>
      </view>
      <view class="done-feat-pill">
        <text class="feat-icon">◆</text>
        <text>养护指南</text>
      </view>
      <view class="done-feat-pill">
        <text class="feat-icon">◆</text>
        <text>山海有信</text>
      </view>
    </view>

    <view class="done-reward-plate" wx:if="{{hasReward}}">
      <text class="done-reward-label">完成奖励</text>
      <text class="done-reward">完善资料奖励已发放至账户</text>
    </view>

    <view class="done-actions">
      <view class="account-btn-primary done-btn-primary" bindtap="goHome">进入我的</view>
      <view class="account-btn-ghost done-btn-ghost" bindtap="goProfile">查看资料</view>
    </view>
  </view>
</view>
