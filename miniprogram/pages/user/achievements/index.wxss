/* pages/user/achievements/index.wxss - 精简黑金博物馆风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1A1814 0%, #1A1814 50%, #1A1814 100%);
  position: relative;
  overflow-x: hidden;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(196, 167, 108, 0.2);
  z-index: 100;
  box-sizing: border-box;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 20rpx;
  transition: opacity 0.3s;
}

.back-btn:active {
  opacity: 0.6;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  transition: opacity 0.3s;
}

.share-btn:active {
  opacity: 0.6;
}

.share-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.share-icon image {
  width: 100%;
  height: 100%;
}

.content {
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 成就总览卡片 - 简洁黑金风格 */
.overview-card {
  position: relative;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.8) 0%, rgba(20, 20, 20, 0.6) 100%);
  border: 1.5px solid rgba(196, 167, 108, 0.3);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.5);
}

.overview-bg-glow,
.overview-bg-pattern {
  display: none;
}

.overview-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 顶部标题区域 */
.overview-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.overview-icon-wrapper {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.overview-icon-bg {
  display: none;
}

.overview-icon {
  position: relative;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
}

.overview-icon-ring {
  display: none;
}

.overview-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.title-main {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.title-sub {
  font-size: 20rpx;
  color: rgba(196, 167, 108, 0.8);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 统计数据 */
.overview-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  padding: 28rpx 16rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 20rpx;
  border: 1px solid rgba(196, 167, 108, 0.2);
  box-sizing: border-box;
  overflow: hidden;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  padding: 0 4rpx;
  position: relative;
  z-index: 1;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.stat-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108, 0.15);
  border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.3);
}

.stat-icon-wrapper::before {
  display: none;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
}

.stat-val {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(196, 167, 108, 0.9);
  line-height: 1;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

.stat-divider {
  width: 1px;
  height: 70rpx;
  background: linear-gradient(to bottom, transparent 0%, rgba(196, 167, 108, 0.3) 50%, transparent 100%);
}

/* 进度条区域 */
.overview-progress-wrapper {
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
  gap: 16rpx;
}

.progress-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.progress-percent {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(196, 167, 108, 0.9);
  letter-spacing: 1rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.overview-progress {
  width: 100%;
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 6rpx;
  overflow: hidden;
  border: 1px solid rgba(196, 167, 108, 0.2);
  box-sizing: border-box;
}

.progress-fill {
  position: relative;
  height: 100%;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.8), rgba(196, 167, 108, 0.95));
  border-radius: 6rpx;
  transition: width 1s ease;
  overflow: hidden;
}

.progress-shine,
.progress-glow {
  display: none;
}

/* 奖励信息 */
.overview-reward {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  background: rgba(196, 167, 108, 0.1);
  border: 1px solid rgba(196, 167, 108, 0.3);
  border-radius: 20rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
}

.overview-reward::before {
  display: none;
}

.reward-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(196, 167, 108, 0.2);
  border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.4);
  flex-shrink: 0;
}

.reward-icon-main {
  width: 32rpx;
  height: 32rpx;
}

.reward-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  position: relative;
  z-index: 1;
}

.reward-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.reward-value {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(196, 167, 108, 0.9);
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 成就分类区域 */
.achievements-section {
  margin-bottom: 50rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
  padding: 20rpx 0;
  padding-bottom: 24rpx;
  border-bottom: 2px solid rgba(196, 167, 108, 0.2);
  position: relative;
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
}

.section-header::before,
.section-header::after {
  display: none;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.section-title {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  position: relative;
  z-index: 1;
}

.title-cn {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.title-en {
  font-size: 20rpx;
  color: rgba(196, 167, 108, 0.7);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.section-count {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  background: rgba(196, 167, 108, 0.1);
  border: 1px solid rgba(196, 167, 108, 0.3);
  border-radius: 16rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.count-unlocked {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(196, 167, 108, 0.9);
  white-space: nowrap;
  flex-shrink: 0;
}

.count-separator {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  white-space: nowrap;
  flex-shrink: 0;
}

.count-total {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  white-space: nowrap;
  flex-shrink: 0;
}

/* 成就网格 */
.achievements-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
}

/* 成就卡片 - 简洁风格 */
.achievement-item {
  position: relative;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.6) 0%, rgba(20, 20, 20, 0.4) 100%);
  border: 1.5px solid rgba(196, 167, 108, 0.25);
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  transition: all 0.3s;
  overflow: hidden;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.achievement-item::before {
  display: none;
}

.achievement-bg-glow,
.achievement-bg-pattern {
  display: none;
}

.achievement-item.unlocked {
  border-color: rgba(196, 167, 108, 0.5);
  background: linear-gradient(135deg, rgba(196, 167, 108, 0.15) 0%, rgba(196, 167, 108, 0.08) 100%);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.5);
}

.achievement-item.locked {
  opacity: 0.6;
  filter: grayscale(0.3);
}

.achievement-item:active {
  transform: scale(0.98);
}

/* 状态角标 */
.achievement-status {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 3;
}

.status-badge {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.status-badge.unlocked {
  background: rgba(196, 167, 108, 0.3);
  border: 1.5px solid rgba(196, 167, 108, 0.5);
}

.status-badge.locked {
  background: rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.status-icon {
  width: 24rpx;
  height: 24rpx;
}

.status-badge.locked .status-icon {
  opacity: 0.3;
  width: 20rpx;
  height: 20rpx;
}

/* 图标区域 */
.achievement-icon-wrapper {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  margin-bottom: 8rpx;
}

.achievement-icon-bg {
  display: none;
}

.achievement-icon {
  position: relative;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
}

.achievement-icon-ring,
.achievement-icon-shine {
  display: none;
}

/* 信息区域 */
.achievement-info {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 100%;
}

.achievement-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1.5rpx;
  text-align: center;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.achievement-item.unlocked .achievement-name {
  color: rgba(196, 167, 108, 0.9);
}

.achievement-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 0.5rpx;
  text-align: center;
  line-height: 1.5;
  min-height: 60rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  word-break: break-word;
}

/* 进度条 */
.achievement-progress {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
}

.progress-header-mini {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-bottom: 4rpx;
}

.progress-label-mini {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-percent-mini {
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(196, 167, 108, 0.8);
  white-space: nowrap;
  flex-shrink: 0;
}

.progress-bar-mini {
  width: 100%;
  height: 6rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 3rpx;
  overflow: hidden;
  border: 1px solid rgba(196, 167, 108, 0.2);
}

.progress-fill-mini {
  position: relative;
  height: 100%;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.7), rgba(196, 167, 108, 0.9));
  border-radius: 3rpx;
  transition: width 0.6s ease;
  overflow: hidden;
}

.progress-shine-mini {
  display: none;
}

.progress-text {
  font-size: 18rpx;
  color: rgba(196, 167, 108, 0.8);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

/* 奖励徽章 */
.achievement-reward {
  width: 100%;
  display: flex;
  justify-content: center;
}

.reward-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(196, 167, 108, 0.15);
  border: 1px solid rgba(196, 167, 108, 0.3);
  border-radius: 12rpx;
}

.reward-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.reward-text {
  font-size: 20rpx;
  color: rgba(196, 167, 108, 0.9);
  font-weight: 600;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 32rpx;
  min-height: 400rpx;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.3;
}
.empty-icon image {
  width: 100rpx;
  height: 100rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
  text-align: center;
  word-wrap: break-word;
  max-width: 100%;
  box-sizing: border-box;
}

.retry-btn {
  margin-top: 20rpx;
  padding: 20rpx 40rpx;
  background: rgba(196, 167, 108, 0.15);
  border: 1.5px solid rgba(196, 167, 108, 0.3);
  border-radius: 20rpx;
  color: rgba(196, 167, 108, 0.9);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.3s;
}

.retry-btn:active {
  transform: scale(0.95);
  background: rgba(196, 167, 108, 0.2);
}

/* 骨架屏样式 */
.skeleton-container {
  width: 100%;
  padding: 0;
}

.skeleton-card {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(196, 167, 108, 0.2);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.skeleton-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.skeleton-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.1) 0%, rgba(196, 167, 108, 0.2) 50%, rgba(196, 167, 108, 0.1) 100%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

.skeleton-title {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.1) 0%, rgba(196, 167, 108, 0.2) 50%, rgba(196, 167, 108, 0.1) 100%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

.skeleton-line.long {
  width: 70%;
}

.skeleton-line.short {
  width: 50%;
}

.skeleton-stats {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.skeleton-stat {
  flex: 1;
  height: 100rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.1) 0%, rgba(196, 167, 108, 0.2) 50%, rgba(196, 167, 108, 0.1) 100%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

.skeleton-progress {
  height: 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.1) 0%, rgba(196, 167, 108, 0.2) 50%, rgba(196, 167, 108, 0.1) 100%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

.skeleton-section {
  margin-bottom: 40rpx;
}

.skeleton-section-header {
  height: 70rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.1) 0%, rgba(196, 167, 108, 0.2) 50%, rgba(196, 167, 108, 0.1) 100%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
  margin-bottom: 24rpx;
}

.skeleton-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.skeleton-item {
  height: 260rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.1) 0%, rgba(196, 167, 108, 0.2) 50%, rgba(196, 167, 108, 0.1) 100%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* 成就详情弹窗 - 简洁风格 */
.achievement-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(10px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.achievement-modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.95) 0%, rgba(20, 20, 20, 0.9) 100%);
  border: 2px solid rgba(196, 167, 108, 0.4);
  border-radius: 32rpx;
  padding: 50rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.8);
  transform: scale(0.9) translateY(40rpx);
  transition: transform 0.3s;
  overflow: hidden;
  box-sizing: border-box;
  margin: 0 auto;
}

.achievement-modal.show .modal-content {
  transform: scale(1) translateY(0);
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  border: 1px solid rgba(196, 167, 108, 0.2);
  transition: all 0.3s;
  z-index: 10;
}

.modal-close:active {
  transform: scale(0.9);
  background: rgba(196, 167, 108, 0.2);
}

.modal-icon-wrapper {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.modal-icon-bg {
  display: none;
}

.modal-icon {
  position: relative;
  z-index: 1;
  width: 88rpx;
  height: 88rpx;
}

.modal-icon-ring {
  display: none;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
  letter-spacing: 1rpx;
}

.modal-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.modal-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(196, 167, 108, 0.2);
  border-radius: 20rpx;
}

.info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 1rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(196, 167, 108, 0.9);
}

.info-reward {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.modal-progress {
  width: 100%;
  margin-top: 8rpx;
}

.modal-progress-track {
  width: 100%;
  height: 10rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 5rpx;
  overflow: hidden;
  border: 1px solid rgba(196, 167, 108, 0.2);
}

.modal-progress-fill {
  position: relative;
  height: 100%;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.8), rgba(196, 167, 108, 0.95));
  border-radius: 5rpx;
  transition: width 0.6s ease;
  overflow: hidden;
}

.modal-progress-shine {
  display: none;
}

.modal-status {
  text-align: center;
  padding: 20rpx;
  background: rgba(196, 167, 108, 0.15);
  border: 1.5px solid rgba(196, 167, 108, 0.4);
  border-radius: 20rpx;
}

.modal-status.locked {
  background: rgba(0, 0, 0, 0.4);
  border-color: rgba(255, 255, 255, 0.15);
}

.status-text {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(196, 167, 108, 0.9);
  letter-spacing: 1.5rpx;
  margin-left: 8rpx;
}

.modal-status.locked .status-text {
  color: rgba(255, 255, 255, 0.5);
}

.status-icon-small {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.modal-status {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-status.locked .status-icon-small {
  opacity: 0.5;
}

/* 弹窗操作按钮 */
.modal-actions {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
  gap: 20rpx;
}

.modal-share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 36rpx;
  background: rgba(196, 167, 108, 0.15);
  border: 1.5px solid rgba(196, 167, 108, 0.4);
  border-radius: 24rpx;
  transition: all 0.3s;
}

.modal-share-btn:active {
  transform: scale(0.95);
  background: rgba(196, 167, 108, 0.2);
}

.share-icon-small {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}
.share-icon-small image {
  width: 100%;
  height: 100%;
}

.share-text {
  font-size: 24rpx;
  color: rgba(196, 167, 108, 0.9);
  font-weight: 600;
  letter-spacing: 1.5rpx;
}

/* 成就解锁动画 - 简化 */
.unlock-animation {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(15px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.unlock-animation.show {
  opacity: 1;
  visibility: visible;
}

.unlock-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.95) 0%, rgba(20, 20, 20, 0.9) 100%);
  border: 2px solid rgba(196, 167, 108, 0.5);
  border-radius: 32rpx;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.9);
  transform: scale(0.9) translateY(40rpx);
  transition: transform 0.4s;
  box-sizing: border-box;
  margin: 0 auto;
}

.unlock-animation.show .unlock-content {
  transform: scale(1) translateY(0);
}

.unlock-icon-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.unlock-icon-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(196, 167, 108, 0.2);
  border-radius: 50%;
  filter: blur(20rpx);
}

.unlock-icon {
  position: relative;
  z-index: 1;
  width: 120rpx;
  height: 120rpx;
}

.unlock-icon-ring {
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  width: calc(100% + 40rpx);
  height: calc(100% + 40rpx);
  border: 2px solid rgba(196, 167, 108, 0.4);
  border-radius: 50%;
}

.unlock-title {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(196, 167, 108, 0.9);
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 3rpx;
}

.unlock-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: 2rpx;
}

.unlock-reward {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 40rpx;
  background: rgba(196, 167, 108, 0.15);
  border: 1.5px solid rgba(196, 167, 108, 0.4);
  border-radius: 24rpx;
  margin-bottom: 40rpx;
}

.unlock-reward .reward-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.reward-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 1.5rpx;
}

.reward-value {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(196, 167, 108, 0.9);
  letter-spacing: 1.5rpx;
}

.unlock-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.unlock-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: rgba(196, 167, 108, 0.15);
  border: 1.5px solid rgba(196, 167, 108, 0.4);
  border-radius: 24rpx;
  color: rgba(196, 167, 108, 0.9);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1.5rpx;
  transition: all 0.3s;
}

.unlock-btn:active {
  transform: scale(0.95);
  background: rgba(196, 167, 108, 0.2);
}

.unlock-btn.share {
  background: rgba(196, 167, 108, 0.2);
  border-color: rgba(196, 167, 108, 0.5);
}
