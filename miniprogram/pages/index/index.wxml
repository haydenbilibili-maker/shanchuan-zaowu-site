<wxs src="../../utils/latinDisplay.wxs" module="latin" />
<view class="container {{isSinglePage ? 'is-single-page' : ''}}">
  
  <!-- 🔧 重写：状态栏占位，防止内容被遮挡；单页模式改用微信固定顶栏 -->
  <view class="status-bar-placeholder" wx:if="{{!isSinglePage}}" style="height: {{navTop}}px;"></view>
  
  <view class="nav-fixed-wrapper" wx:if="{{!isSinglePage}}" style="top: {{navTop}}px;">
    <view class="nav-bar">
      <view class="header-capsule {{isScrolled ? 'hidden' : ''}}" bindtap="handleSearch" hover-class="header-capsule-press" hover-stay-time="80">
        <view class="brand-part" catchlongpress="onEasterEggLongPress" data-egg-id="zhulong">
          <image class="brand-mark" src="/assets/brand/seal-outline.png" mode="aspectFit"></image>
          <text class="brand-cn">山海造物</text>
        </view>
        <view class="v-divider"></view>
        <view class="search-part">
          <icon type="search" size="12" color="rgba(255,255,255,0.6)"></icon>
          <text>搜索藏品…</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 🔧 重写：内容顶部占位，避免内容被导航栏遮挡 -->
  <view class="content-spacer" wx:if="{{!isSinglePage}}" style="height: {{navTop + 44}}px;"></view>

  <!-- 整页错误态：关键内容全部加载失败时替换内容区（区分「加载失败」与「内容为空」） -->
  <view class="page-error" wx:if="{{pageError}}">
    <view class="page-error-mark">
      <text class="page-error-glyph">山海</text>
    </view>
    <text class="page-error-title">内容暂时无法抵达</text>
    <text class="page-error-desc">{{pageErrorMsg}}</text>
    <view class="page-error-btn" bindtap="onRetryLoad" hover-class="tap-press" hover-stay-time="80">重新加载</view>
    <text class="page-error-hint">也可以下拉刷新</text>
  </view>

  <!-- 内容全在满屏 scroll-view 里，页面级下拉刷新几乎碰不到 → 由 scroll-view 自带下拉承接 -->
  <scroll-view
    wx:else
    scroll-y
    class="main-scroll"
    bindscroll="onPageScroll"
    enable-back-to-top
    refresher-enabled="{{!isSinglePage}}"
    refresher-threshold="64"
    refresher-default-style="white"
    refresher-background="#1A1814"
    refresher-triggered="{{homeRefreshing}}"
    bindrefresherrefresh="onHomeRefresherRefresh"
  >
    
    <!-- 馆员问候（2026-10-18 方向池 ★★）：一行小字，时段问候 + 门店营业状态；门店数据到了才出现 -->
    <view class="home-greet" wx:if="{{homeGreeting.word}}">
      <text class="home-greet-w">{{homeGreeting.word}}</text>
      <text class="home-greet-l" wx:if="{{homeGreeting.line}}">{{homeGreeting.line}}</text>
    </view>

    <!-- 轮播图模块：有直播时首位抢插「直播中」帧；无直播时恢复 baseBanners -->
    <view class="hero-section" wx:if="{{showBanners || (showLive && liveSession && liveSession.pullUrl)}}">
      <!-- 骨架屏 -->
      <view class="skeleton-banner" wx:if="{{loadingBanners}}">
        <view class="sk-banner-item"></view>
      </view>
      <!-- 实际内容 -->
      <swiper
        wx:else
        class="hero-swiper"
        current="{{currentBannerIndex}}"
        autoplay="{{heroAutoplay}}"
        circular="{{banners.length > 1}}"
        interval="{{banners[0] && banners[0].isLive ? 8000 : 6000}}"
        duration="450"
        indicator-dots="{{false}}"
        bindchange="onSwiperChange"
      >
        <block wx:for="{{banners}}" wx:key="id">
          <swiper-item>
            <view hover-class="tap-press-soft" hover-stay-time="80"
              class="hero-item {{item.isLive ? 'hero-live' : ''}}"
              catchtap="onBannerTap"
              data-item="{{item}}"
              data-id="{{item.id}}"
              data-link="{{item.link}}"
            >
              <image class="hero-img" src="{{item.image}}" mode="aspectFill" lazy-load="{{index > 0}}" />
              <view class="hero-mask-vignette"></view>
              <!-- 直播信号叠层：加深蒙版 + 细线框 + 扫描线 + 信号条 -->
              <block wx:if="{{item.isLive}}">
                <view class="hero-live-mask"></view>
                <view class="hero-live-frame">
                  <view class="hero-live-scan"></view>
                  <view class="hero-live-signal-bars">
                    <view class="bar"></view>
                    <view class="bar"></view>
                    <view class="bar"></view>
                  </view>
                </view>
              </block>
              <view class="hero-content slide-up-anim">
                <view class="hero-badge {{item.isLive ? 'live' : ''}}">
                  <view class="signal-light live blink" wx:if="{{item.isLive}}"></view>
                  <text>{{item.badge || '精选'}}</text>
                </view>
                <text class="h-title">{{item.title}}</text>
                <text class="h-sub" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
                <view class="hero-live-cta" wx:if="{{item.isLive}}">进入直播间 ›</view>
              </view>
            </view>
          </swiper-item>
        </block>
      </swiper>
      <view class="dots-row">
        <block wx:for="{{banners}}" wx:key="id">
           <view class="dot-line {{currentBannerIndex === index ? 'active' : ''}} {{item.isLive ? 'live' : ''}}">
             <view class="progress" wx:if="{{currentBannerIndex === index}}"></view>
           </view>
        </block>
      </view>
    </view>

    <!-- 祈福墙入口（2026-09-20）：banner 正下方，以「弹幕跑马灯」形式露出**真实**心愿。
         三条口径：
         ① 间距由**宿主自己的包裹 view** 给（与详情页同约定：ext-class 只留给改皮肤 ——
            同一元素上组件样式与宿主样式撞 margin 时谁生效不保证）；
         ② 开关 `showMaShangYou` 缺字段默认关 → 包裹层一起 `wx:if`，否则关掉时会留一段空槽；
         ③ 跑马灯文案由 `loadWishWallMarquee` 取**默认墙**的真实心愿；取不到就只有入口、不放跑马灯
            （**绝不编造**）。 -->
    <view class="wish-wall-slot-home" wx:if="{{showMaShangYou}}">
      <wish-wall-entry
        enabled="{{showMaShangYou}}"
        defaultWall="{{true}}"
        from="home"
        compact="{{true}}"
        tone="ink"
        wishes="{{wishWallWishes}}"
      />
    </view>

    <!-- 灵动球（博物标本室） -->
    <view class="section-box orbs-section orbs-first" wx:if="{{showCategories}}">
      <view class="section-header-row section-header-compact">
        <view class="title-group">
          <text class="t-cn">博物藏品室</text>
          <text class="t-en">SPECIMEN ARCHIVES</text>
        </view>
      </view>
      
      <view class="orb-matrix">
        <block wx:for="{{categories}}" wx:key="_id">
          <view class="orb-wrapper {{currentOrbId === item._id ? 'active' : (currentOrbId ? 'dimmed' : '')}}" 
                bindtap="onOrbClick" 
                data-id="{{item._id}}"
                hover-class="tap-press-soft"
                hover-stay-time="80">
            <view class="orb-sphere floating" style="animation-delay: {{index * 0.4}}s;">
               <view class="orb-inner-light"></view>
               <view class="orb-texture"></view>
               <view class="orb-ring"></view>
               <view class="orb-particle"></view>
               <view class="orb-highlight"></view>
               <text class="orb-icon">{{item.icon}}</text>
            </view>
            <view class="orb-active-ring" wx:if="{{currentOrbId === item._id}}"></view>
            <view class="orb-shadow floating-shadow" style="animation-delay: {{index * 0.4}}s;"></view>
            <view class="orb-meta">
              <text class="cn">{{item.displayName}}</text>
              <text class="en">{{item.enName}}</text>
            </view>
          </view>
        </block>
      </view>

      <view class="orb-expansion-panel {{orbExpanded ? 'expanded' : ''}}">
         <view class="panel-line-top"></view>
         <scroll-view scroll-x class="orb-product-scroll" enable-flex bindscrolltolower="loadMoreOrbData" lower-threshold="80">
            <view class="orb-loader" wx:if="{{orbLoading}}">
               <view class="sk-card"></view><view class="sk-card"></view><view class="sk-card"></view>
            </view>
            <block wx:else>
              <view class="orb-empty" wx:if="{{orbProducts.length === 0}}">
                <text>该品类暂无上架藏品</text>
              </view>
              <!-- 需求 11：横滑容器是 flex 行，故用包裹层承载 flex-shrink:0（不能直接用 block） -->
              <view class="orb-item" wx:for="{{orbProducts}}" wx:key="_id">
                <view class="op-card" catchtap="goToDetail" data-id="{{item._id}}" hover-class="op-card-press" hover-stay-time="80">
                   <view class="op-img-box">
                      <sensitive-blur-gate
                        enabled="{{item.sensitiveEnabled}}"
                        product-id="{{item._id}}"
                        size="card"
                      >
                        <image class="op-img" src="{{item.image}}" mode="aspectFill" lazy-load></image>
                      </sensitive-blur-gate>
                      <view class="op-rare-tag" wx:if="{{item.productRarity === 'rare' || item.productRarity === 'legendary'}}">珍稀</view>
                   </view>
                   <view class="op-info">
                      <text class="op-title text-cut">{{item.title}}</text>
                      <text class="op-latin text-cut" wx:if="{{latin.display(item.latinName)}}">{{latin.display(item.latinName)}}</text>
                      <view class="op-bot">
                        <text class="op-price">¥{{item.price}}</text>
                        <view class="op-btn">+</view>
                      </view>
                   </view>
                </view>
              </view>
              <view class="orb-loading-more" wx:if="{{orbLoadingMore}}">加载中</view>
              <view class="op-more-card" catchtap="goToCategory" data-id="{{currentOrbId}}" hover-class="op-card-press" hover-stay-time="80">
                 <text class="txt">查看全部</text><text class="arr">→</text>
              </view>
              <view style="width: 30rpx; flex-shrink: 0;"></view>
            </block>
         </scroll-view>
      </view>
    </view>

    <!-- 为你推荐（2026-09-27 全面升级）：展签大卡 + 三件一组；取数/三态/换一批/埋点都在组件里。
         口径见 docs/首页为你推荐_全面升级_2026-09-27.md -->
    <view class="section-box" wx:if="{{showRecommendations}}">
      <home-reco id="homeReco" wall-on="{{showMaShangYou}}" bind:itemtap="goToDetail" bind:more="onRecoMore" />
    </view>

    <!-- 最新入库 -->
    <view class="section-box section-compact home-feed-section" wx:if="{{showNewArrivals}}">
      <view class="section-header-row section-header-compact">
        <view class="title-group">
          <text class="t-cn">最新入库</text>
          <text class="t-en">NEW ARRIVALS</text>
        </view>
      </view>
      <product-list id="newArrivalsList" page-size="{{6}}" auto-fill-max="{{1}}" bind:itemtap="goToDetail" />
    </view>

    <!-- 标本工坊（进入视口中部后暂停上方商品流分页） -->
    <view class="section-box atelier-section home-below-feed-anchor">
      <view class="section-header-row section-header-compact atelier-header-row">
        <view class="title-group">
          <text class="t-cn">标本工坊</text>
          <text class="t-en">NATURE'S ATELIER</text>
        </view>
      </view>
      <view class="atelier-card-pro" bindtap="goToCustom" hover-class="tap-press-soft" hover-stay-time="80">
        <image class="atelier-hero-img" src="{{atelierHeroImage}}" mode="aspectFill" lazy-load />
        <view class="atelier-hero-mask"></view>
        <view class="atelier-content">
          <text class="atelier-badge">{{workshopStoreName}}</text>
          <text class="atelier-tagline">把山海带回家</text>
          <text class="atelier-desc">装裱定制与伴宠记忆，在同一盏暖光下完成</text>
          <view class="atelier-paths">
            <view class="atelier-path-chip" wx:if="{{showSpecimenCustom}}">标本定制</view>
            <view class="atelier-path-chip soft" wx:if="{{showPetMemorial}}">伴宠记忆</view>
          </view>
          <view class="atelier-cta-row">
            <text class="atelier-cta">进入工坊</text>
            <text class="atelier-cta-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 专题展览 -->
    <view class="section-box" wx:if="{{showCollections}}">
      <view class="section-header-row section-header-compact">
        <view class="title-group">
          <text class="t-cn">专题展览</text>
          <text class="t-en">EXHIBITIONS</text>
        </view>
        <view class="more-link" bindtap="goToCategory" wx:if="{{!loadingCollections}}" hover-class="more-link-press" hover-stay-time="80">查看全部 →</view>
      </view>
      <!-- 骨架屏 -->
      <view class="skeleton-exhibitions" wx:if="{{loadingCollections}}">
        <view class="sk-exhibit-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
      </view>
      <!-- 实际内容 -->
      <scroll-view wx:elif="{{collections.length > 0}}" scroll-x class="exhibit-scroll" enable-flex show-scrollbar="{{false}}">
        <block wx:for="{{collections}}" wx:key="_id">
          <view class="exhibit-card-pro" bindtap="goToCollectionDetail" data-id="{{item._id}}" hover-class="exhibit-card-press" hover-stay-time="80">
            <image class="ec-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
            <view class="ec-overlay"></view>
            <view class="ec-info">
               <view class="ec-tag">专题</view>
               <text class="ec-title">{{item.title}}</text>
               <text class="ec-brief text-cut" wx:if="{{item.brief}}">{{item.brief}}</text>
            </view>
            <view class="ec-hover-mask"></view>
          </view>
        </block>
        <view style="width: 30rpx; flex-shrink: 0;"></view>
      </scroll-view>
      <view class="section-empty" wx:else>专题筹备中</view>
    </view>

    <!-- 名师手作模块 -->
    <view class="section-box" wx:if="{{showFramers}}">
      <view class="section-header-row section-header-compact"><view class="title-group"><text class="t-cn">名师手作</text><text class="t-en">ARTIST SPOTLIGHT</text></view></view>
      <!-- 骨架屏 -->
      <view class="skeleton-artists" wx:if="{{loadingFramers}}">
        <view class="sk-artist-card" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
      </view>
      <!-- 实际内容 -->
      <scroll-view wx:elif="{{framers.length > 0}}" scroll-x class="artist-scroll" enable-flex show-scrollbar="{{false}}">
        <block wx:for="{{framers}}" wx:key="_id">
          <view class="artist-card-v3" bindtap="goToFramer" data-id="{{item._id}}" hover-class="tap-press-soft" hover-stay-time="80">
             <!-- 图片容器 -->
             <view class="ac-image-wrapper">
               <image class="ac-bg" src="{{item.avatar}}" mode="aspectFill" lazy-load></image>
               <!-- 图片渐变遮罩 -->
               <view class="ac-image-overlay"></view>
             </view>
             <!-- 底部信息栏（独立于图片） -->
             <view class="ac-info-bar">
               <view class="ac-info-content">
                 <text class="ac-name">{{item.name}}</text>
                 <text class="ac-title">{{item.title}}</text>
               </view>
             </view>
          </view>
        </block>
        <view style="width: 32rpx; flex-shrink: 0;"></view>
      </scroll-view>
      <view class="section-empty" wx:else>名师档案筹备中</view>
    </view>

    <!-- 标本师招募常驻条（置于名师手作下方）— 博物柜铭牌式 -->
    <view
      class="recruit-rail"
      catchtap="goToFramerRecruit"
      hover-class="tap-press-soft"
      hover-stay-time="80"
      hover-stop-propagation="{{true}}"
    >
      <view class="rr-body">
        <text class="rr-kicker">FRAMER RECRUIT</text>
        <text class="rr-title">标本师招募</text>
        <text class="rr-desc">门店渠道 · 小程序上架 · 分成合作</text>
      </view>
      <text class="rr-go">了解合作 ›</text>
    </view>

    <!-- 近期活动模块 -->
    <view class="section-box" wx:if="{{showActivities && activities.length > 0}}">
      <view class="section-header-row section-header-compact">
        <view class="title-group">
          <text class="t-cn">近期活动</text>
          <text class="t-en">UPCOMING EVENTS</text>
        </view>
      </view>
      
      <scroll-view scroll-x class="ticket-scroll-view" enable-flex>
        <block wx:for="{{activities}}" wx:key="_id">
          <view class="rich-ticket" bindtap="goToBooking" hover-class="rich-ticket-press" hover-stay-time="80">
             <view class="ticket-stub">
                <view class="stub-header"><text class="stub-label">ADMIT ONE</text></view>
                <view class="stub-date"><text class="sd-day">{{item.day}}</text><text class="sd-month">{{item.month}}</text></view>
                <view class="stub-footer"><view class="barcode">||| |||| ||</view></view>
                <view class="rip-line"></view>
             </view>
             <view class="ticket-main">
                <image class="tm-bg" src="{{item.cover}}" mode="aspectFill" lazy-load></image>
                <view class="tm-mask"></view>
                <view class="tm-content">
                   <view class="tm-top">
                     <text class="tm-type">EVENT</text>
                     <view class="tm-status {{item.status === 'open' ? 'active' : ''}}">{{item.status === 'open' ? '报名中' : '已结束'}}</view>
                   </view>
                   <view class="tm-mid">
                     <text class="tm-title text-cut-2">{{item.title}}</text>
                     <view class="tm-loc-row"><icon type="location" size="10" color="#A09A90"></icon><text class="tm-loc">{{item.location}}</text></view>
                   </view>
                   <view class="tm-bot">
                      <text class="tm-price" wx:if="{{item.price > 0}}">¥{{item.price}}</text>
                      <text class="tm-price free" wx:else>免费</text>
                      <view class="tm-btn">→</view>
                   </view>
                </view>
                <view class="notch top"></view><view class="notch bottom"></view>
             </view>
          </view>
        </block>
        <view style="width: 30rpx; flex-shrink:0;"></view>
      </scroll-view>
    </view>

    <view class="footer-slogan">
      <view class="f-line"></view>
      <view class="f-text-wrap">
        <image class="f-mark" src="/assets/brand/seal-standard.png" mode="aspectFit"></image>
        <text class="f-tagline">把山海带回家</text>
        <text class="f-text">NATURE'S CREATIONS · EST. 2026</text>
        <text class="f-single-page-note" wx:if="{{isSinglePage}}">朋友圈预览 · 可下滑浏览内容</text>
      </view>
      <view class="f-line"></view>
    </view>
    
    <view class="scroll-bottom-pad"></view>
  </scroll-view>
  <easter-egg-note id="easterEggNote" />
</view>