  width: 100%; 
  height: 100%; 
  filter: brightness(0.75) contrast(1.2) saturate(1.1) grayscale(0.2) sepia(0.1); 
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  object-fit: cover;
