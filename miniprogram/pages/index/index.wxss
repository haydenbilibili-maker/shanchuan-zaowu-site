/* pages/index/index.wxss */
.container { padding-bottom: 120rpx; background: var(--color-bg); position: relative; }

/* 🔧 重写：状态栏占位 */
.status-bar-placeholder {
  width: 100%;
  max-width: 100vw;
  background: transparent;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 998;
  box-sizing: border-box;
}

/* 🔧 重写：内容顶部占位，避免被导航栏遮挡 */
.content-spacer {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 🔧 重写：主滚动区域 */
.main-scroll {
  width: 100%;
  height: calc(100vh - 120rpx);
  box-sizing: border-box;
}

/* 全局图片质感滤镜（与 app 富文本图一致偏暖） */
image {
    filter: brightness(0.9) contrast(1.1) saturate(1.1);
    transition: filter 0.3s;
}

/* ==================== 1. 顶部导航 (经典胶囊复刻) - 重写：修复拉伸问题 ==================== */
.nav-fixed-wrapper {
  position: fixed; 
  top: 0; 
  left: 0; 
  width: 100%; 
  max-width: 100vw; /* 🔧 重写：限制最大宽度 */
  z-index: 999;
  height: 80px; 
  pointer-events: none;
  box-sizing: border-box;
  overflow: hidden; /* 🔧 重写：防止内容溢出 */
}

.nav-bar {
  display: flex; 
  align-items: center; 
  padding-left: 30rpx;
  padding-right: 30rpx;
  height: 44px; 
  width: 100%; 
  max-width: 100%; /* 🔧 重写：限制最大宽度 */
  pointer-events: auto;
  box-sizing: border-box;
  position: relative; /* 🔧 重写：使用相对定位 */
}

/* 核心：导航胶囊 — 柜木深底 + 细黄铜边 */
.header-capsule {
  display: inline-flex; align-items: center;
  background: rgba(31, 29, 26, 0.9);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(196, 167, 108, 0.22);
  border-radius: 32rpx;
  height: 64rpx; 
  padding: 0 16rpx 0 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 24, 20, 0.42);
  transition: all 0.3s ease;
  max-width: 420rpx;
}
.header-capsule.hidden { opacity: 0; transform: translateY(-20px); pointer-events: none; }
.header-capsule:active { background: rgba(38, 35, 32, 0.92); transform: scale(0.98); }

/* 品牌部分 */
.brand-part { display: flex; flex-direction: column; justify-content: center; margin-right: 16rpx; }
.brand-en-wrap { display: flex; flex-direction: column; line-height: 1; margin-bottom: 4rpx; }
.brand-en { font-family: 'DIN', sans-serif; font-size: 12rpx; color: var(--primary); font-weight: bold; letter-spacing: 0.12em; line-height: 1.15; }
.brand-en-second { margin-top: 2rpx; }
.brand-cn { font-size: 24rpx; color: var(--color-text-primary); font-weight: 600; letter-spacing: 0.12em; line-height: 1; }

/* 分割线 */
.v-divider { width: 1px; height: 24rpx; background: rgba(255,255,255,0.2); margin-right: 16rpx; }

/* 搜索部分 */
.search-part { display: flex; align-items: center; opacity: 0.8; }
.search-part icon { margin-right: 8rpx; }
.search-part text { font-size: 24rpx; color: rgba(255,255,255,0.7); letter-spacing: 1rpx; }


/* ==================== 2. Banner ==================== */
/* 首屏 Hero：约 38vh，留出推荐 / 金刚位自然露出 */
.hero-section {
  height: 500rpx;
  position: relative;
  margin-bottom: 32rpx;
}
.section-box.recommend-top { margin-top: 0; margin-bottom: 56rpx; }

.orbs-section.orbs-first {
  margin-top: 0;
  margin-bottom: 48rpx;
}

/* 区块标题 — 左对齐紧凑（提升首屏平效） */
.section-header-compact {
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 14rpx;
  border-bottom: 1px solid rgba(196, 167, 108, 0.12);
}

.section-header-compact .title-group {
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
}

.section-header-compact .t-cn {
  font-size: 32rpx;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.section-header-compact .t-en {
  font-size: 18rpx;
  letter-spacing: 0.14em;
  margin-top: 0;
  opacity: 0.72;
}

.section-box.section-compact {
  margin-bottom: 56rpx;
}

/* 金刚位快捷入口 — Museum Mode 统一黄铜语义 */
.quick-grid-section {
  margin-top: 0;
  margin-bottom: 48rpx;
}

.quick-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 12rpx;
  padding: 32rpx 20rpx 28rpx;
  background: #1F1D1A;
  border: 1px solid rgba(77, 64, 26, 0.22);
  border-radius: 24rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.quick-item-hover {
  opacity: 0.92;
}

.quick-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(196, 167, 108, 0.08);
  border: 1px solid rgba(196, 167, 108, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  box-sizing: border-box;
}

.quick-item-hover .quick-icon-wrap {
  background: rgba(196, 167, 108, 0.14);
  border-color: rgba(196, 167, 108, 0.38);
}

.quick-icon {
  width: 48rpx;
  height: 48rpx;
}

.quick-label {
  font-size: 22rpx;
  color: #D5D1C8;
  text-align: center;
  line-height: 1.35;
  letter-spacing: 0.02em;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-badge {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  z-index: 2;
  font-size: 16rpx;
  font-weight: 600;
  color: #1A1814;
  background: #C4A76C;
  padding: 4rpx 10rpx;
  border-radius: 9999px;
  line-height: 1.3;
  white-space: nowrap;
  border: 1px solid rgba(26, 24, 20, 0.85);
}

.hero-swiper, .hero-item, .hero-img { width: 100%; height: 100%; }
.hero-img { object-fit: cover; filter: brightness(0.88); }
.hero-mask-vignette {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(26, 24, 20, 0.05) 0%, rgba(26, 24, 20, 0.35) 55%, var(--color-bg) 100%);
  pointer-events: none;
}
.hero-content {
  position: absolute;
  bottom: 64rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.hero-badge { background: var(--primary); color: #1A1814; font-size: 18rpx; font-weight: 900; padding: 4rpx 12rpx; border-radius: 4rpx; margin-bottom: 12rpx; letter-spacing: 2rpx; }
.h-title {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--color-text-primary);
  line-height: 1.15;
  margin-bottom: 8rpx;
  font-family: Georgia, 'Times New Roman', serif;
  text-shadow: 0 6rpx 20rpx rgba(26, 24, 20, 0.55);
}
.h-sub { font-size: 20rpx; color: rgba(255,255,255,0.78); letter-spacing: 2rpx; font-family: 'DIN'; }
.slide-up-anim { animation: slideUp 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; opacity: 0; transform: translateY(20px); }
@keyframes slideUp { to { opacity: 1; transform: translateY(0); } }
.dots-row { position: absolute; bottom: 28rpx; left: 32rpx; display: flex; gap: 8rpx; }
.dot-line { width: 40rpx; height: 4rpx; background: rgba(255,255,255,0.2); border-radius: 2rpx; overflow: hidden; }
.dot-line.active { background: rgba(255,255,255,0.4); }
.progress { width: 100%; height: 100%; background: var(--primary); animation: progress 6s linear forwards; }
@keyframes progress { from { width: 0; } to { width: 100%; } }

/* ==================== 3. 灵动球 (Specimen Orbs) ==================== */
.section-box { margin-bottom: 90rpx; padding: 0 30rpx; }

.orb-matrix { display: flex; justify-content: space-around; padding: 0 10rpx; position: relative; z-index: 10; }

.orb-matrix-services {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1px solid rgba(196, 167, 108, 0.1);
}

.orb-wrapper-service:active {
  transform: scale(0.96);
  opacity: 0.88;
}

.orb-wrapper { display: flex; flex-direction: column; align-items: center; width: 150rpx; position: relative; transition: all 0.4s ease; }
.orb-wrapper.active { transform: scale(1.1); z-index: 20; }
.orb-wrapper.active .orb-sphere { border-color: rgba(196, 167, 108, 0.45); box-shadow: inset 0 0 24rpx rgba(0,0,0,0.65); }
.orb-wrapper.dimmed { opacity: 0.4; transform: scale(0.95); }
.orb-active-ring { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 130rpx; height: 130rpx; border: 2rpx solid var(--primary); border-radius: 50%; animation: ripple 1.5s infinite; pointer-events: none; }
@keyframes ripple { 0% { transform: translateX(-50%) scale(1); opacity: 0.8; } 100% { transform: translateX(-50%) scale(1.3); opacity: 0; } }

.orb-sphere { width: 120rpx; height: 120rpx; border-radius: 50%; position: relative; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.08), rgba(26,24,20,0.98)); box-shadow: inset 0 0 28rpx rgba(0,0,0,0.75), inset 2rpx 2rpx 8rpx rgba(255,255,255,0.06); border: 1px solid rgba(38,35,32,0.5); margin-bottom: 24rpx; transform-style: preserve-3d; backdrop-filter: blur(4px); }
.orb-sphere::before { content: ''; position: absolute; top: -10%; left: -10%; right: -10%; bottom: -10%; border: 1px solid rgba(196, 167, 108, 0.2); border-radius: 50%; border-top-color: transparent; border-bottom-color: transparent; transform: rotateX(60deg) rotateY(0deg); animation: orbit 8s linear infinite; pointer-events: none; }
.orb-icon { font-size: 52rpx; position: relative; z-index: 10; filter: drop-shadow(0 4rpx 10rpx rgba(0,0,0,0.5)); animation: iconBreathe 4s ease-in-out infinite; }
.orb-texture { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 50% 50%, rgba(196, 167, 108,0.15), transparent 70%); filter: blur(15rpx); opacity: 0.6; animation: texturePulse 6s ease-in-out infinite; }
.orb-ring { position: absolute; width: 140%; height: 140%; border-radius: 50%; border: 1px solid rgba(196, 167, 108, 0.15); border-top-color: rgba(196, 167, 108, 0.6); border-bottom-color: transparent; transform: rotateX(75deg) rotateY(15deg); pointer-events: none; }
.orb-highlight { position: absolute; top: 15%; left: 20%; width: 20rpx; height: 10rpx; background: rgba(255,255,255,0.6); border-radius: 50%; filter: blur(2rpx); transform: rotate(-45deg); opacity: 0.7; }

/* 动画定义 */
.floating { animation: float 6s ease-in-out infinite; }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12rpx); } }
.orb-shadow { width: 60rpx; height: 10rpx; background: rgba(0,0,0,0.6); border-radius: 50%; position: absolute; top: 140rpx; filter: blur(8rpx); z-index: -1; animation: shadowBreath 6s ease-in-out infinite; }
@keyframes shadowBreath { 0%, 100% { transform: scale(1); opacity: 0.6; } 50% { transform: scale(0.7); opacity: 0.3; } }
@keyframes texturePulse { 0%, 100% { transform: scale(0.8); opacity: 0.4; } 50% { transform: scale(1.1); opacity: 0.7; } }
@keyframes iconBreathe { 0%, 100% { transform: scale(1); filter: drop-shadow(0 4rpx 10rpx rgba(0,0,0,0.45)); } 50% { transform: scale(1.04); filter: drop-shadow(0 6rpx 12rpx rgba(0,0,0,0.5)); } }
@keyframes orbit { from { transform: rotateX(60deg) rotateZ(0deg); } to { transform: rotateX(60deg) rotateZ(360deg); } }

.orb-meta { text-align: center; }
.orb-meta .cn { font-size: 26rpx; color: var(--color-text-body); font-weight: 900; display: block; letter-spacing: 2rpx; text-shadow: 0 2rpx 6rpx rgba(26, 24, 20, 0.55); }
.orb-meta .en { font-size: 14rpx; color: #666; font-family: 'DIN'; letter-spacing: 1rpx; margin-top: 6rpx; display: block; text-transform: uppercase; font-weight: bold; }

/* 灵动球展开面板 */
.orb-expansion-panel { width: 100%; height: 0; opacity: 0; overflow: hidden; transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1); margin-top: 20rpx; background: rgba(255,255,255,0.03); border-radius: 16rpx; }
.orb-expansion-panel.expanded { height: 400rpx; opacity: 1; margin-top: 40rpx; padding-bottom: 24rpx; }
.panel-line-top { width: 100%; height: 1px; background: linear-gradient(90deg, transparent, var(--primary), transparent); margin-bottom: 20rpx; opacity: 0.5; }
.orb-product-scroll { width: 100%; height: 100%; display: flex; padding: 0 20rpx; box-sizing: border-box; }
.orb-loader { display: flex; }
.sk-card { width: 220rpx; height: 300rpx; background: #1a1a1a; margin-right: 20rpx; border-radius: 12rpx; animation: pulse 1.5s infinite; }

.op-card { width: 220rpx; height: 340rpx; margin-right: 24rpx; flex-shrink: 0; background: #1F1D1A; border-radius: 12rpx; overflow: hidden; border: 1px solid rgba(255,255,255,0.05); position: relative; display: flex; flex-direction: column; }
.op-card:active { border-color: var(--primary); transform: scale(0.98); }
.op-img-box { width: 100%; height: 200rpx; background: #1A1814; position: relative; flex-shrink: 0; }
.op-img { width: 100%; height: 100%; }
.op-rare-tag { position: absolute; top: 8rpx; left: 8rpx; font-size: 14rpx; color: #1A1814; background: var(--primary); padding: 2rpx 8rpx; border-radius: 4rpx; font-weight: bold; }
.op-info { flex: 1; min-height: 0; padding: 10rpx 12rpx 12rpx; display: flex; flex-direction: column; justify-content: flex-start; gap: 4rpx; overflow: hidden; }
.op-title { font-size: 22rpx; color: #ddd; font-weight: bold; line-height: 1.3; }
.op-latin { font-size: 16rpx; color: #666; font-style: italic; line-height: 1.2; flex-shrink: 0; }
.op-bot { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 4rpx; }
.op-price { font-family: 'DIN'; font-size: 24rpx; color: var(--primary); font-weight: bold; }
.op-btn { width: 36rpx; height: 36rpx; border-radius: 50%; border: 1px solid #444; color: var(--color-text-primary); font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.op-more-card { width: 100rpx; height: 340rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255,255,255,0.02); border-radius: 12rpx; flex-shrink: 0; }
.op-more-card .txt { font-size: 18rpx; color: var(--primary); writing-mode: vertical-rl; letter-spacing: 4rpx; font-weight: bold; }
.op-more-card .arr { color: #666; font-size: 24rpx; margin-top: 10rpx; }


/* ==================== 4. 🟢 近期活动 (票根修复) ==================== */
.section-header-row { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40rpx; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 20rpx; }
.title-group { display: flex; flex-direction: column; }
.t-cn { 
  font-size: 38rpx; 
  font-weight: 900; 
  color: var(--color-text-primary); 
  letter-spacing: 2rpx; 
  font-family: 'Times New Roman', serif;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}
.t-en { 
  font-size: 22rpx; 
  color: var(--gold); 
  font-family: 'DIN'; 
  letter-spacing: 4rpx; 
  font-weight: bold; 
  margin-top: 8rpx;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.45);
}

/* 🟢 ticket-scroll-view 必须是 flex 容器且不换行 */
.ticket-scroll-view { display: flex; padding-left: 30rpx; white-space: nowrap; height: 280rpx; width: 100%; }

.rich-ticket { display: inline-flex; width: 640rpx; height: 220rpx; margin-right: 30rpx; position: relative; flex-shrink: 0; filter: drop-shadow(0 10rpx 20rpx rgba(0,0,0,0.6)); transition: transform 0.2s; }
.rich-ticket:active { transform: scale(0.98); }

.ticket-stub { width: 180rpx; background: #dcdcdc; border-radius: 20rpx 0 0 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; border-right: 2rpx dashed #999; }
.stub-header { transform: rotate(-90deg); position: absolute; left: -20rpx; top: 50%; }
.stub-label { font-family: 'DIN'; font-size: 18rpx; font-weight: bold; color: rgba(0,0,0,0.3); letter-spacing: 4rpx; }
.stub-date { text-align: center; margin-top: -20rpx; }
.sd-day { font-size: 56rpx; font-weight: 900; color: var(--primary); font-family: 'DIN'; display: block; line-height: 1; text-shadow: none; }
.sd-month { font-size: 22rpx; font-weight: bold; color: #888; text-transform: uppercase; letter-spacing: 2rpx; margin-top: 6rpx; display: block; }
.stub-footer { position: absolute; bottom: 20rpx; width: 100%; text-align: center; }
.barcode { font-family: monospace; font-size: 16rpx; transform: scaleY(2); opacity: 0.7; color: #1A1814; letter-spacing: 2rpx; }
.rip-line { position: absolute; right: -1rpx; top: 0; bottom: 0; border-left: 2rpx dashed #555; height: 100%; z-index: 2; }

.ticket-main { flex: 1; background: #1F1D1A; border-radius: 0 20rpx 20rpx 0; position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); border-left: none; }
.tm-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; filter: grayscale(0.5) brightness(0.6); }
.tm-mask { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(26, 24, 20, 0.94) 0%, rgba(26, 24, 20, 0.55) 100%); }
.tm-content { position: relative; z-index: 2; padding: 24rpx 30rpx; height: 100%; display: flex; flex-direction: column; justify-content: space-between; white-space: normal; }
.tm-top { display: flex; justify-content: space-between; align-items: flex-start; }
.tm-type { font-size: 16rpx; color: #1A1814; background: var(--primary); padding: 4rpx 12rpx; border-radius: 4rpx; font-weight: 900; letter-spacing: 2rpx; }
.tm-status { font-size: 20rpx; color: var(--color-text-primary); border: 1px solid rgba(255,255,255,0.3); padding: 4rpx 16rpx; border-radius: 20rpx; font-weight: bold; }
.tm-status.active { color: #52B788; border-color: #52B788; background: rgba(82, 183, 136, 0.12); animation: pulse 2s infinite; }
.tm-mid { margin-top: 10rpx; }
.tm-title { font-size: 34rpx; font-weight: 900; color: var(--color-text-primary); line-height: 1.2; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 10rpx; text-shadow: 0 4rpx 12rpx rgba(26, 24, 20, 0.55); }
.tm-loc-row { display: flex; align-items: center; }
.tm-loc { font-size: 22rpx; color: #ccc; margin-left: 8rpx; }
.tm-bot { display: flex; justify-content: space-between; align-items: flex-end; }
.tm-price { font-family: 'DIN'; font-size: 40rpx; color: var(--primary); font-weight: bold; }
.tm-price.free { color: var(--color-text-primary); font-size: 32rpx; }
.tm-btn { width: 60rpx; height: 60rpx; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; color: var(--color-text-primary); font-size: 28rpx; backdrop-filter: blur(5px); }
.notch { position: absolute; left: -14rpx; width: 28rpx; height: 28rpx; background: var(--color-bg); border-radius: 50%; z-index: 3; box-shadow: inset -2rpx 0 4rpx rgba(26, 24, 20, 0.45); }
.notch.top { top: -14rpx; } .notch.bottom { bottom: -14rpx; }

/* ==================== 专题展览样式优化 - 杂志质感 ==================== */
.exhibit-scroll { 
  display: flex; 
  padding-left: 30rpx; 
  white-space: nowrap; 
  height: 380rpx; 
  align-items: center;
}
.exhibit-card-pro { 
  display: inline-block; 
  width: 640rpx; 
  height: 360rpx; 
  margin-right: 28rpx; 
  position: relative; 
  border-radius: 24rpx; 
  overflow: hidden; 
  box-shadow: 
    0 16rpx 48rpx rgba(0,0,0,0.55),
    0 4rpx 16rpx rgba(0,0,0,0.35),
    inset 0 1rpx 1rpx rgba(255,255,255,0.06);
  border: 1px solid rgba(77, 64, 26, 0.35);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
  background: #1A1814;
}
.exhibit-card-pro:active {
  transform: scale(0.97) translateY(-2rpx);
  box-shadow: 
    0 12rpx 36rpx rgba(0,0,0,0.65),
    0 2rpx 12rpx rgba(0,0,0,0.45),
    inset 0 1rpx 1rpx rgba(255,255,255,0.08);
  border-color: rgba(77, 64, 26, 0.55);
}

.ec-img { 
  width: 100%; 
  height: 100%; 
  filter: brightness(0.7) contrast(1.15) saturate(1.1) sepia(0.1); 
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  object-fit: cover;
  transform-origin: center;
}
.exhibit-card-pro:active .ec-img { 
  transform: scale(1.1); 
  filter: brightness(0.85) contrast(1.25) saturate(1.2) sepia(0.15); 
}

.ec-overlay { 
  position: absolute; 
  inset: 0; 
  background: linear-gradient(
    to top, 
    rgba(0,0,0,0.92) 0%, 
    rgba(0,0,0,0.75) 25%,
    rgba(0,0,0,0.5) 50%,
    rgba(0,0,0,0.2) 70%, 
    transparent 85%
  ); 
  transition: opacity 0.5s;
  z-index: 1;
}
.exhibit-card-pro:active .ec-overlay {
  opacity: 0.95;
}

/* 杂志风格的装饰性边框 */
.exhibit-card-pro::before {
  content: '';
  position: absolute;
  inset: 0;
