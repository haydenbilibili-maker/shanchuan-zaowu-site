/* ==================== 名师手作样式 - 全新重构（分离式设计） ==================== */
.artist-scroll { 
  display: flex; 
  padding: 0; 
  white-space: nowrap; 
  height: 420rpx; 
  width: 100%;
  box-sizing: border-box;
  align-items: flex-start;
}
.artist-scroll::-webkit-scrollbar {
  display: none;
}

/* 卡片容器 - 分离式设计：图片 + 信息栏 */
.artist-card-v3 { 
  display: inline-flex;
  flex-direction: column;
  width: 280rpx; 
  margin-right: 24rpx; 
  flex-shrink: 0;
  transition: transform 0.25s ease;
}

.artist-card-v3:active,
.artist-card-press {
  transform: scale(0.98);
}

/* 图片容器 - 独立区域，不包含文字 */
.ac-image-wrapper {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
  background: var(--color-bg-card);
  border: 1px solid var(--color-bg-elevated);
  border-bottom: none;
}

.ac-bg { 
  width: 100%; 
  height: 100%; 
  filter: brightness(0.8) contrast(1.15) saturate(1.05) grayscale(0.15); 
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  object-fit: cover;
  object-position: center center;
}

.artist-card-v3:active .ac-bg { 
  filter: brightness(0.9) contrast(1.25) saturate(1.15) grayscale(0); 
  transform: scale(1.08); 
}

/* 图片渐变遮罩 - 底部轻微渐变，不遮挡主体 */
.ac-image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(
    to top,
    rgba(26, 24, 20, 0.4) 0%,
    rgba(26, 24, 20, 0.18) 50%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 1;
}

/* 信息栏 - 独立于图片，位于下方 */
.ac-info-bar {
  width: 100%;
  background: var(--color-bg-card);
  border: 1px solid var(--color-bg-elevated);
  border-top: none;
  border-radius: 0 0 20rpx 20rpx;
  padding: 20rpx 18rpx;
  position: relative;
  overflow: hidden;
}

.artist-card-v3:active .ac-info-bar {
  border-color: rgba(196, 167, 108, 0.4);
}

/* 信息内容 */
.ac-info-content {
  text-align: center;
  position: relative;
  z-index: 2;
}

.ac-name { 
  font-size: 30rpx; 
  color: var(--color-text-primary); 
  font-weight: 700; 
  display: block; 
  margin-bottom: 6rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  letter-spacing: 1.5rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ac-title { 
  font-size: 18rpx; 
  color: var(--gold); 
  display: block;
  font-family: 'DIN', sans-serif;
  font-weight: 600;
  letter-spacing: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
  opacity: 0.9;
}

/* 装饰性元素 */
.ac-info-decoration {
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity: 0.6;
  box-shadow: none;
  transition: all 0.4s;
}

.artist-card-v3:active .ac-info-decoration {
  width: 70rpx;
  opacity: 0.9;
  box-shadow: none;
}

.artist-card-v3::before { display: none; }

/* 旧样式保留（向后兼容，如果还有使用 artist-card-v2 的地方） */

