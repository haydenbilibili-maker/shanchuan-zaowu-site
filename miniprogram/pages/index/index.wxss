/* ==================== 名师手作样式 - 全新重构（分离式设计） ==================== */
.artist-scroll { 
  display: flex; 
  padding: 0 30rpx; 
  white-space: nowrap; 
  height: 420rpx; 
  align-items: flex-start;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.artist-scroll::-webkit-scrollbar {
  display: none;
}

/* 卡片容器 - 分离式设计：图片 + 信息栏 */
.artist-card-v3 { 
  display: inline-flex;
  flex-direction: column;
  width: 280rpx; 
  margin-right: 24rpx; 
  flex-shrink: 0;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.artist-card-v3:active {
  transform: translateY(-6rpx) scale(0.98);
}

/* 图片容器 - 独立区域，不包含文字 */
.ac-image-wrapper {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
  background: #1A1814;
  box-shadow: 
    0 12rpx 32rpx rgba(0,0,0,0.6),
    0 4rpx 12rpx rgba(0,0,0,0.4),
    0 0 20rpx rgba(196, 167, 108,0.15),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  border: 2px solid rgba(196, 167, 108,0.2);
  border-bottom: none;
}

.ac-bg { 
  width: 100%; 
  height: 100%; 
  filter: brightness(0.8) contrast(1.15) saturate(1.05) grayscale(0.15); 
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  object-fit: cover;
  object-position: center center;
}

.artist-card-v3:active .ac-bg { 
  filter: brightness(0.9) contrast(1.25) saturate(1.15) grayscale(0); 
  transform: scale(1.08); 
}

/* 图片渐变遮罩 - 底部轻微渐变，不遮挡主体 */
.ac-image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.4) 0%,
    rgba(0,0,0,0.2) 50%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 1;
}

/* 信息栏 - 独立于图片，位于下方 */
.ac-info-bar {
  width: 100%;
  background: linear-gradient(
    135deg,
    rgba(10,10,10,0.98),
    rgba(20,20,20,0.95),
    rgba(10,10,10,0.98)
  );
  backdrop-filter: blur(16px) saturate(180%);
  border: 2px solid rgba(196, 167, 108,0.3);
  border-top: none;
  border-radius: 0 0 20rpx 20rpx;
  padding: 20rpx 18rpx;
  box-shadow: 
    0 8rpx 24rpx rgba(0,0,0,0.7),
    0 4rpx 12rpx rgba(0,0,0,0.5),
    0 0 20rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 2rpx rgba(255,255,255,0.1);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.artist-card-v3:active .ac-info-bar {
  border-color: rgba(196, 167, 108,0.5);
  box-shadow: 
    0 12rpx 32rpx rgba(0,0,0,0.8),
    0 0 28rpx rgba(196, 167, 108,0.3),
    inset 0 1rpx 3rpx rgba(255,255,255,0.15);
  transform: translateY(-2rpx);
}

/* 信息内容 */
.ac-info-content {
  text-align: center;
  position: relative;
  z-index: 2;
}

.ac-name { 
  font-size: 30rpx; 
  color: var(--color-text-primary); 
  font-weight: 900; 
  display: block; 
  margin-bottom: 6rpx;
  font-family: 'Times New Roman', serif;
  text-shadow: 
    0 2rpx 6rpx rgba(0,0,0,0.9),
    0 1rpx 3rpx rgba(0,0,0,0.7),
    0 0 10rpx rgba(196, 167, 108,0.15);
  letter-spacing: 1.5rpx;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ac-title { 
  font-size: 18rpx; 
  color: var(--gold); 
  display: block;
  font-family: 'DIN', sans-serif;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 
    0 0 10rpx rgba(196, 167, 108,0.5),
    0 0 5rpx rgba(196, 167, 108,0.3),
    0 1rpx 2rpx rgba(0,0,0,0.8);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
  opacity: 0.9;
}

/* 装饰性元素 */
.ac-info-decoration {
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity: 0.6;
  box-shadow: none;
  transition: all 0.4s;
}

.artist-card-v3:active .ac-info-decoration {
  width: 70rpx;
  opacity: 0.9;
  box-shadow: none;
}

/* 金色光泽扫过效果 */
.artist-card-v3::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(196, 167, 108,0.12),
    transparent
  );
  transition: left 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  z-index: 10;
  border-radius: 20rpx;
}

.artist-card-v3:active::before {
  left: 100%;
}

/* 旧样式保留（向后兼容，如果还有使用 artist-card-v2 的地方） */
.artist-card-v2 { 
  display: inline-block; 
  width: 300rpx; 
  height: 360rpx; 
  margin-right: 32rpx; 
  position: relative; 
  border-radius: 24rpx; 
  overflow: hidden; 
  box-shadow: 
    0 16rpx 48rpx rgba(0,0,0,0.7),
    0 6rpx 20rpx rgba(0,0,0,0.5),
    0 0 24rpx rgba(196, 167, 108,0.2),
    inset 0 1rpx 3rpx rgba(255,255,255,0.12),
    inset 0 -1rpx 2rpx rgba(0,0,0,0.4);
  border: 2px solid rgba(196, 167, 108,0.25);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
  background: #1A1814;
  cursor: pointer;
  /* 确保图片和文字分层清晰 */
  isolation: isolate;
}
.artist-card-v2:active {
  transform: scale(0.96) translateY(-4rpx);
  box-shadow: 
    0 12rpx 40rpx rgba(0,0,0,0.8),
    0 4rpx 16rpx rgba(0,0,0,0.6),
    0 0 36rpx rgba(196, 167, 108,0.35),
    inset 0 2rpx 4rpx rgba(255,255,255,0.18),
    inset 0 -1rpx 3rpx rgba(0,0,0,0.5);
  border-color: rgba(196, 167, 108,0.5);
}

.ac-bg { 
  width: 100%; 
  height: 100%; 
  filter: brightness(0.75) contrast(1.2) saturate(1.1) grayscale(0.2) sepia(0.1); 
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  object-fit: cover;
  object-position: center top;
  transform-origin: center top;
}
.artist-card-v2:active .ac-bg { 
  filter: brightness(0.85) contrast(1.3) saturate(1.2) grayscale(0) sepia(0.15); 
  transform: scale(1.1); 
}

/* 杂志风格的装饰性边框 */
.artist-card-v2::before {
  content: '';
  position: absolute;
  inset: 0;
  border: 1px solid rgba(196, 167, 108,0.15);
  border-radius: 20rpx;
  pointer-events: none;
  z-index: 3;
  opacity: 0;
  transition: opacity 0.5s;
}
.artist-card-v2:active::before {
