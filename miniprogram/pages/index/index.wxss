.ac-image-overlay { position: absolute; left: 0; right: 0; bottom: 0; height: 44%; z-index: 1; pointer-events: none; background: linear-gradient(to bottom, rgba(31,29,26,0), rgba(31,29,26,.45) 58%, rgba(31,29,26,.9)); }
.ac-info-bar { width: 100%; padding: 18rpx 18rpx 20rpx; border-top: none; border-radius: 0 0 6rpx 6rpx; background: var(--color-bg-card); }
.ac-info-content { text-align: center; }
.ac-name { display: block; font-size: var(--fs-30); line-height: 42rpx; font-family: var(--font-brand); font-weight: 500; letter-spacing: .1em; color: var(--color-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ac-title { display: block; margin-top: 4rpx; font-size: var(--fs-20); letter-spacing: .12em; color: var(--brass-400); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .hero-live-scan,
  .hero-live-signal-bars .bar,
  .orb-active-ring,
  .orb-sphere::before,
  .orb-sphere::after,
  .orb-icon,
  .orb-texture,
  .orb-particle,
  .floating,
  .floating-shadow,
  .sk-card,
  .skeleton-banner,
  .sk-exhibit-card,
  .sk-artist-card,
  .sk-artist-card::before,
  .sk-artist-card::after {
    animation: none;
  }
}
