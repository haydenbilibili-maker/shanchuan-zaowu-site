  box-shadow: none;
  border-color: rgba(196, 167, 108, 0.4);
}

.ec-img { 
  width: 100%; 
  height: 100%; 
  filter: brightness(0.7) contrast(1.15) saturate(1.1) sepia(0.1); 
  transition: transform 0.25s ease;
  object-fit: cover;
  transform-origin: center;
}
.exhibit-card-pro:active .ec-img { 
