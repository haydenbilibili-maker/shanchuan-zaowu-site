/* 杂志风格的装饰性边框 */
.exhibit-card-pro::before {
  content: '';
  position: absolute;
  inset: 0;
  border: 1px solid rgba(196, 167, 108,0.15);
  border-radius: 24rpx;
  pointer-events: none;
  z-index: 3;
