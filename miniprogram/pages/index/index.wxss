}

.skeleton-artists {
  display: flex;
  gap: 24rpx;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.sk-artist-card {
  width: 280rpx;
  height: 380rpx;
  background: linear-gradient(90deg, var(--color-bg-card) 25%, var(--color-bg-elevated) 50%, var(--color-bg-card) 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 20rpx;
  flex-shrink: 0;
  border: 2px solid rgba(196, 167, 108,0.1);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.sk-artist-card::before {
  content: '';
  width: 100%;
  height: 320rpx;
  background: linear-gradient(90deg, var(--color-bg-card) 25%, var(--color-bg-elevated) 50%, var(--color-bg-card) 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 20rpx 20rpx 0 0;
}

.sk-artist-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(90deg, var(--color-bg-card) 25%, var(--color-bg-elevated) 50%, var(--color-bg-card) 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 0 0 20rpx 20rpx;
}

/* 走进这有店 — 探索页门店卡片（入口已迁至「我的」，区块默认关闭） */


















/* 标本工坊入口 — 探索页专题卡片 */
.atelier-section {
  padding-top: 8rpx;
}

.atelier-header-row {
  margin-bottom: 28rpx;
}

.atelier-card-pro {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--color-bg-card);
  border: 1px solid rgba(77, 64, 26, 0.45);
  box-shadow: inset 0 0 0 1rpx rgba(196, 167, 108, 0.08);
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.atelier-card-pro:active,
.atelier-card-press {
  transform: scale(0.985);
  border-color: rgba(196, 167, 108, 0.55);
}

.atelier-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: brightness(0.62) contrast(1.12) saturate(1.05);
}

.atelier-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    115deg,
    rgba(26, 24, 20, 0.92) 0%,
    rgba(26, 24, 20, 0.78) 42%,
    rgba(26, 24, 20, 0.35) 100%
  );
}

.atelier-brass-frame {
  position: absolute;
  inset: 16rpx;
  border: 1px solid rgba(196, 167, 108, 0.22);
  border-radius: 16rpx;
  pointer-events: none;
}

.atelier-content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32rpx 36rpx 36rpx;
  box-sizing: border-box;
}

.atelier-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  padding: 6rpx 16rpx;
  margin-bottom: 16rpx;
  font-size: 20rpx;
  color: var(--gold);
  letter-spacing: 0.06em;
  background: rgba(26, 24, 20, 0.55);
  border: 1px solid rgba(196, 167, 108, 0.28);
  border-radius: 8rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.atelier-tagline {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FAF6ED;
  letter-spacing: 0.1em;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.atelier-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  max-width: 520rpx;
  margin-bottom: 20rpx;
}

.atelier-paths {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.atelier-path-chip {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-bg);
  font-weight: 500;
  background: var(--gold);
  border-radius: 9999px;
}

.atelier-path-chip.soft {
  color: var(--gold);
  background: rgba(196, 167, 108, 0.12);
  border: 1px solid rgba(196, 167, 108, 0.35);
}

.atelier-cta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.atelier-cta {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.04em;
}

.atelier-cta-arrow {
  font-size: 28rpx;
  color: var(--gold);
  transition: transform 0.25s ease;
}

.atelier-card-pro:active .atelier-cta-arrow {
  transform: translateX(6rpx);
}
/* ===== 整页错误态（关键内容全部加载失败）===== */
/* 与 collection-detail 的 .cd-state 保持同一视觉语言 */
.page-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 220rpx 60rpx 120rpx;
}
.page-error-mark {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 1rpx solid var(--brass-400, #C4A76C);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: .55;
}
.page-error-glyph {
  font-family: var(--font-brand, inherit);
  font-size: 30rpx;
  letter-spacing: .12em;
  color: var(--brass-400, #C4A76C);
}
.page-error-title {
  margin-top: 44rpx;
  font-size: 32rpx;
  color: var(--color-text-primary);
}
.page-error-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-muted);
}
.page-error-btn {
  margin-top: 44rpx;
  padding: 18rpx 60rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brass-400, #C4A76C);
  font-size: 26rpx;
  color: var(--brass-400, #C4A76C);
}
.page-error-hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
