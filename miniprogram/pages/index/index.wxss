/* ==================== 页脚标语优化 ==================== */
.footer-slogan { 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  margin-top: 80rpx; 
  margin-bottom: 24rpx; 
  width: 100%; 
  padding: 0 40rpx;
  position: relative;
}

.scroll-bottom-pad {
  height: 32rpx;
}

.f-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(196, 167, 108, 0.3) 20%, 
    rgba(196, 167, 108, 0.6) 50%, 
    rgba(196, 167, 108, 0.3) 80%, 
    transparent 100%
  );
  position: relative;
  animation: lineExpand 0.3s ease-out both;
}

.f-line::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  background: var(--primary);
  border-radius: 50%;
  box-shadow: none;
  animation: dotPulse 2s ease-in-out infinite;
}

.f-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx;
  max-width: 90%;
}
.f-tagline {
  font-size: 22rpx;
  color: var(--color-text-body, #D5D1C8);
  letter-spacing: 0.2em;
  font-weight: 500;
  margin-bottom: 12rpx;
  text-align: center;
}
.f-text {
  font-family: 'DIN', 'Arial', sans-serif;
  font-size: 18rpx;
  color: var(--primary);
  letter-spacing: 0.35em;
  font-weight: 600;
  text-transform: uppercase;
  padding: 0 40rpx;
  position: relative;
  text-shadow: none;
  opacity: 0.9;
  transition: all 0.3s ease;
  white-space: nowrap;
  text-align: center;
}

.f-single-page-note {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(160, 154, 144, 0.7);
  letter-spacing: 0.06em;
  text-align: center;
  white-space: normal;
}

.f-text::before,
.f-text::after {
  content: '';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(196, 167, 108, 0.4);
}

.f-text::before {
  left: 0;
  animation-delay: 0s;
}

.f-text::after {
  right: 0;
  animation-delay: 1.5s;
}

/* 动画效果 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes lineExpand {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 100%;
    opacity: 1;
  }
}

@keyframes dotPulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.8;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.3);
    opacity: 1;
  }
}

@keyframes starTwinkle {
  0%, 100% {
    opacity: 0.3;
    transform: translateY(-50%) scale(1);
  }
  50% {
    opacity: 0.8;
    transform: translateY(-50%) scale(1.2);
  }
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.7; } 100% { opacity: 1; } }
@keyframes skeleton-loading {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

