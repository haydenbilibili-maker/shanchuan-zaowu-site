/* 「注记」长注释原文见 miniprogram/docs/源码注记_A流主包.md */
/* pages/index/index.wxss */
page {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  background-color: var(--color-bg);
  color: var(--color-text-primary);
}

.container {
  padding-bottom: var(--tabbar-offset);
  background: var(--color-bg);
  position: relative;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 朋友圈单页：无自定义 tabBar，底部留给微信「前往小程序」栏 */
.container.is-single-page {
  padding-bottom: 0;
}

.container.is-single-page .main-scroll {
  height: 100vh;
}

.container.is-single-page .scroll-bottom-pad {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* 🔧 重写：状态栏占位 */
.status-bar-placeholder {
  width: 100%;
  max-width: 100%;
  background: transparent;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 998;
  box-sizing: border-box;
}

/* 🔧 重写：内容顶部占位，避免被导航栏遮挡 */
.content-spacer {
  width: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 🔧 重写：主滚动区域 */
.main-scroll {
  width: 100%;
  height: calc(100vh - var(--tabbar-offset));
  box-sizing: border-box;
}

/* 主图轻微暖调；勿对全页 image 套 filter（GPU 开销大） */
.hero-img,
.atelier-hero-img,
.explore-store-img,
.ec-img,
.ac-bg,
.tm-bg {
    filter: brightness(0.94) saturate(1.04);
}

/* ==================== 1. 顶部导航 (经典胶囊复刻) - 重写：修复拉伸问题 ==================== */
.nav-fixed-wrapper {
  position: fixed; 
  top: 0; 
  left: 0; 
  width: 100%; 
  max-width: 100%;
  z-index: 999;
  height: 80px; 
  pointer-events: none;
  box-sizing: border-box;
  overflow: hidden; /* 🔧 重写：防止内容溢出 */
}

.nav-bar {
  display: flex; 
  align-items: center; 
  padding-left: 30rpx;
  padding-right: 30rpx;
  height: 44px; 
  width: 100%; 
  max-width: 100%; /* 🔧 重写：限制最大宽度 */
  pointer-events: auto;
  box-sizing: border-box;
  position: relative; /* 🔧 重写：使用相对定位 */
}

/* 核心：导航胶囊 — 柜木深底 + 细黄铜边 */
.header-capsule {
  display: inline-flex; align-items: center;
  background: rgba(31, 29, 26, 0.9);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(196, 167, 108, 0.22);
  border-radius: 32rpx;
  height: 64rpx; 
  padding: 0 16rpx 0 24rpx;
  transition: all 0.3s ease;
  max-width: 420rpx;
}
.header-capsule.hidden { opacity: 0; transform: translateY(-20px); pointer-events: none; }
.header-capsule:active,
.header-capsule-press { background: rgba(38, 35, 32, 0.92); transform: scale(0.98); }

/* 品牌部分 */
.brand-part { display: flex; flex-direction: column; justify-content: center; margin-right: 16rpx; }
.brand-en-wrap { display: flex; flex-direction: column; line-height: 1; margin-bottom: 4rpx; }
.brand-en { font-family: 'DIN', sans-serif; font-size: var(--fs-16); color: var(--primary); font-weight: bold; letter-spacing: 0.12em; line-height: 1.15; }
.brand-en-second { margin-top: 2rpx; }
.brand-cn { font-size: 24rpx; color: var(--color-text-primary); font-weight: 600; letter-spacing: 0.12em; line-height: 1; }

/* 分割线 */
.v-divider { width: 1px; height: 24rpx; background: rgba(196, 167, 108, 0.28); margin-right: 16rpx; }

/* 搜索部分 */
.search-part { display: flex; align-items: center; opacity: 0.8; }
.search-part icon { margin-right: 8rpx; }
.search-part text { font-size: 24rpx; color: var(--color-text-secondary); letter-spacing: 1rpx; }


/* ==================== 2. Banner ==================== */
/* 首屏 Hero：约 38vh，留出下方内容自然露出 */
.hero-section {
  height: 500rpx;
  position: relative;
  margin-bottom: 20rpx;
}

/* 祈福墙入口槽位（2026-09-20）：banner 正下方。（注记 PAG-1） */
.wish-wall-slot-home {
  display: block;
  /* 入口槽：横向与 section 对齐；底距略拉开，让铜系入口在黑底上有独立落点 */
  margin: 6rpx 32rpx 52rpx;
}

/* 直播 Banner：扫描线 / 信号条（克制、真机友好） */
@keyframes hero-live-scan {
  0% { top: 6%; opacity: 0; }
  12% { opacity: 0.5; }
  88% { opacity: 0.45; }
  100% { top: 90%; opacity: 0; }
}

@keyframes hero-live-bar {
  0%, 100% { transform: scaleY(0.45); opacity: 0.45; }
  50% { transform: scaleY(1); opacity: 1; }
}

/* 标本师招募条 — 柜内铜牌 / 书脊铭牌感（非整幅营销 banner） */
.recruit-rail {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: stretch;
  margin: 0 32rpx 64rpx;
  padding: 0;
  background: var(--color-bg-card);
  border: 1px solid #4D401A;
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.recruit-rail-texture {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background:
    linear-gradient(180deg, rgba(196, 167, 108, 0.045) 0%, transparent 42%),
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 5rpx,
      rgba(196, 167, 108, 0.018) 5rpx,
      rgba(196, 167, 108, 0.018) 6rpx
    );
}

.recruit-rail-corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  z-index: 3;
  pointer-events: none;
  border-color: rgba(196, 167, 108, 0.55);
  border-style: solid;
  border-width: 0;
  box-sizing: border-box;
}

.recruit-rail-corner--tl {
  top: 8rpx;
  left: 8rpx;
  border-top-width: 1px;
  border-left-width: 1px;
}

.recruit-rail-corner--tr {
  top: 8rpx;
  right: 8rpx;
  border-top-width: 1px;
  border-right-width: 1px;
}

.recruit-rail-corner--bl {
  bottom: 8rpx;
  left: 8rpx;
  border-bottom-width: 1px;
  border-left-width: 1px;
}

.recruit-rail-corner--br {
  bottom: 8rpx;
  right: 8rpx;
  border-bottom-width: 1px;
  border-right-width: 1px;
}

.recruit-rail-spine {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  background: rgba(196, 167, 108, 0.07);
  border-right: 1px solid rgba(77, 64, 26, 0.9);
  box-sizing: border-box;
}

.recruit-rail-spine-mark {
  writing-mode: vertical-rl;
  font-family: var(--font-brand);
  font-size: 22rpx;
  font-weight: 500;
  color: var(--gold);
  letter-spacing: 0.42em;
  line-height: 1;
}

.recruit-rail-body {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  padding: 26rpx 20rpx 26rpx 28rpx;
  box-sizing: border-box;
}

.recruit-rail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.recruit-rail-kicker {
  flex-shrink: 0;
  font-family: 'DIN', 'Oswald', sans-serif;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.18em;
  line-height: 1.2;
}

.recruit-rail-rule {
  flex: 1;
  height: 1px;
  min-width: 24rpx;
  background: linear-gradient(90deg, rgba(196, 167, 108, 0.35), transparent 92%);
}

.recruit-rail-title {
  display: block;
  font-family: var(--font-brand);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 0.12em;
  line-height: 1.25;
  margin-bottom: 16rpx;
}

.recruit-rail-pills {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.recruit-rail-pill {
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.04em;
  line-height: 1.3;
  background: rgba(26, 24, 20, 0.55);
  border: 1px solid rgba(77, 64, 26, 0.75);
  border-radius: 9999px;
  box-sizing: border-box;
}

.recruit-rail-cta {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  align-self: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(196, 167, 108, 0.38);
  border-radius: 50%;
  background: rgba(26, 24, 20, 0.35);
  box-sizing: border-box;
}

.recruit-rail-arrow {
  font-size: 36rpx;
  line-height: 1;
  color: var(--gold);
  margin-top: -2rpx;
  margin-left: 2rpx;
}

.recruit-rail-press {
  background: #221F1B;
  border-color: rgba(196, 167, 108, 0.42);
}

.recruit-rail-press .recruit-rail-spine {
  background: rgba(196, 167, 108, 0.11);
}

.recruit-rail-press .recruit-rail-cta {
  border-color: rgba(196, 167, 108, 0.55);
  background: rgba(196, 167, 108, 0.08);
}

.recruit-rail-press .recruit-rail-pill {
  color: var(--color-text-body);
  border-color: rgba(196, 167, 108, 0.28);
}

.orbs-section.orbs-first {
  margin-top: 0;
  margin-bottom: 48rpx;
}

/* 区块标题 — 黄铜发丝线 + 中英并排 */
.section-header-compact {
  align-items: baseline;
  margin-bottom: 28rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #4D401A;
}

.section-header-compact .title-group {
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
}

.section-header-compact .t-cn {
  font-size: 36rpx;
  letter-spacing: 0.08em;
  line-height: 1.2;
}

.section-header-compact .t-en {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  margin-top: 0;
  opacity: 0.7;
}

.section-box.section-compact {
  margin-bottom: 56rpx;
}

.hero-swiper, .hero-item, .hero-img { width: 100%; height: 100%; }
.hero-item {
  position: relative;
  overflow: hidden;
}
.hero-img { object-fit: cover; filter: brightness(0.88); }
.hero-mask-vignette {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(26, 24, 20, 0.05) 0%, rgba(26, 24, 20, 0.35) 55%, var(--color-bg) 100%);
  pointer-events: none;
  z-index: 1;
}

/* —— 直播信号帧：更深底/左蒙版 + ON AIR 层次（仅 .hero-live） —— */
.hero-live .hero-img {
  filter: brightness(0.82) contrast(1.04);
}
.hero-live .hero-mask-vignette {
  /* 基础 vignette 交给 live-mask，避免双层发灰 */
  background: transparent;
}
.hero-live-mask {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  /* 博物黑分层：左文字区 + 底 CTA 区；避免半透明灰糊成一团 */
  background:
    linear-gradient(
      90deg,
      rgba(26, 24, 20, 0.88) 0%,
      rgba(26, 24, 20, 0.55) 36%,
      rgba(26, 24, 20, 0.12) 62%,
      rgba(26, 24, 20, 0) 78%
    ),
    linear-gradient(
      180deg,
      rgba(26, 24, 20, 0.12) 0%,
      rgba(26, 24, 20, 0.22) 38%,
      rgba(26, 24, 20, 0.72) 72%,
      var(--color-bg) 100%
    );
}
.hero-live-frame {
  position: absolute;
  inset: 16rpx;
  pointer-events: none;
  z-index: 2;
  border: 1px solid rgba(196, 167, 108, 0.4);
  box-shadow: inset 0 0 0 1px rgba(26, 24, 20, 0.35);
}
.hero-live-scan {
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(196, 167, 108, 0.08) 20%,
    rgba(196, 167, 108, 0.42) 50%,
    rgba(196, 167, 108, 0.08) 80%,
    transparent 100%
  );
  animation: hero-live-scan 4.8s ease-in-out infinite;
}
.hero-live-signal-bars {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  display: flex;
  align-items: flex-end;
  gap: 5rpx;
  height: 22rpx;
}
.hero-live-signal-bars .bar {
  width: 4rpx;
  border-radius: 2rpx;
  background: var(--gold);
  transform-origin: bottom center;
  animation: hero-live-bar 1.15s ease-in-out infinite;
}
.hero-live-signal-bars .bar:nth-child(1) {
  height: 8rpx;
  animation-delay: 0s;
}
.hero-live-signal-bars .bar:nth-child(2) {
  height: 14rpx;
  animation-delay: 0.18s;
}
.hero-live-signal-bars .bar:nth-child(3) {
  height: 20rpx;
  animation-delay: 0.34s;
}

.hero-content {
  position: absolute;
  bottom: 64rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  z-index: 3;
}
.hero-badge { display: inline-flex; align-items: center; align-self: flex-start; width: auto; background: var(--primary); color: var(--color-bg); font-size: 18rpx; font-weight: 900; padding: 4rpx 12rpx; border-radius: 4rpx; margin-bottom: 12rpx; letter-spacing: 2rpx; white-space: nowrap; box-sizing: border-box; gap: 8rpx; }
.hero-badge.live {
  background: rgba(26, 24, 20, 0.78);
  border: 1px solid rgba(196, 167, 108, 0.55);
  color: var(--gold);
  letter-spacing: 0.12em;
  padding: 6rpx 14rpx;
  gap: 10rpx;
}
.hero-live-cta {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background: var(--gold);
  color: var(--color-bg);
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 8rpx;
  letter-spacing: 0.04em;
  box-shadow: 0 4rpx 16rpx rgba(26, 24, 20, 0.35);
}
.dot-line.live.active {
  background: rgba(196, 167, 108, 0.35);
}
.h-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.15;
  margin-bottom: 8rpx;
  font-family: 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
}
.hero-live .h-title {
  text-shadow: 0 2rpx 16rpx rgba(26, 24, 20, 0.75);
}
.h-sub { font-size: 20rpx; color: var(--color-text-body); letter-spacing: 2rpx; font-family: 'DIN'; }
.hero-live .h-sub {
  color: var(--color-text-body);
  text-shadow: 0 1rpx 10rpx rgba(26, 24, 20, 0.65);
}
.slide-up-anim { animation: slideUp 0.28s ease-out forwards; opacity: 0; transform: translateY(12px); }
@keyframes slideUp { to { opacity: 1; transform: translateY(0); } }
.dots-row { position: absolute; bottom: 28rpx; left: 32rpx; display: flex; gap: 8rpx; }
.dot-line { width: 40rpx; height: 4rpx; background: rgba(196, 167, 108, 0.22); border-radius: 2rpx; overflow: hidden; }
.dot-line.active { background: rgba(196, 167, 108, 0.4); }
.progress { width: 100%; height: 100%; background: var(--primary); animation: progress 6s linear forwards; }
@keyframes progress { from { width: 0; } to { width: 100%; } }

/* ==================== 3. 灵动球 (Specimen Orbs) ==================== */
.section-box { margin-bottom: 64rpx; padding: 0 32rpx; }

.orb-matrix {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
  position: relative;
  z-index: 10;
}


.orb-wrapper { display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 0; position: relative; transition: transform 0.4s ease, opacity 0.4s ease; }
.orb-wrapper.active { transform: scale(1.1); z-index: 20; }
.orb-wrapper.active .orb-sphere { border-color: rgba(196, 167, 108, 0.55); }
.orb-wrapper.dimmed { opacity: 0.4; transform: scale(0.95); }
.orb-active-ring { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 130rpx; height: 130rpx; border: 1px solid var(--primary); border-radius: 50%; animation: ripple 1.5s ease-out infinite; pointer-events: none; }
@keyframes ripple { 0% { transform: translateX(-50%) scale(1); opacity: 0.7; } 100% { transform: translateX(-50%) scale(1.28); opacity: 0; } }

.orb-sphere { width: 120rpx; height: 120rpx; border-radius: 50%; position: relative; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 35% 35%, rgba(242,237,228,0.1), rgba(26,24,20,0.98)); box-shadow: inset 0 0 20rpx rgba(26,24,20,0.72); border: 1px solid rgba(38,35,32,0.5); margin-bottom: 24rpx; }
.orb-sphere::before { content: ''; position: absolute; top: -10%; left: -10%; right: -10%; bottom: -10%; border: 1px solid rgba(196, 167, 108, 0.22); border-radius: 50%; border-top-color: transparent; border-bottom-color: transparent; transform: rotateX(60deg); animation: orbit 8s linear infinite; pointer-events: none; }
.orb-sphere::after { content: ''; position: absolute; top: 0; left: 50%; width: 6rpx; height: 6rpx; background: var(--brass-400, #C4A76C); border-radius: 50%; transform-origin: 0 60rpx; animation: electron 4s linear infinite; opacity: 0.7; }
.orb-icon { font-size: var(--fs-48); line-height: 1; position: relative; z-index: 10; animation: iconBreathe 4s ease-in-out infinite; }
.orb-texture { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 50% 50%, rgba(196, 167, 108, 0.16), transparent 70%); opacity: 0.55; animation: texturePulse 6s ease-in-out infinite; }
.orb-ring { position: absolute; width: 140%; height: 140%; border-radius: 50%; border: 1px solid rgba(196, 167, 108, 0.16); border-top-color: rgba(196, 167, 108, 0.5); border-bottom-color: transparent; transform: rotateX(75deg) rotateY(15deg); pointer-events: none; }
.orb-particle { position: absolute; top: 50%; left: 50%; width: 140%; height: 140%; border-radius: 50%; transform: translate(-50%, -50%) rotateX(75deg) rotateY(15deg); pointer-events: none; animation: spinOrbit 8s linear infinite; }
.orb-particle::after { content: ''; position: absolute; top: 0; left: 50%; width: 6rpx; height: 6rpx; background: var(--brass-300, #D4BC85); border-radius: 50%; transform: translate(-50%, -50%); }
.orb-highlight { position: absolute; top: 15%; left: 20%; width: 20rpx; height: 10rpx; background: rgba(242, 237, 228, 0.45); border-radius: 50%; transform: rotate(-45deg); opacity: 0.7; }

.floating { animation: float 6s ease-in-out infinite; }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12rpx); } }
.orb-shadow { width: 60rpx; height: 10rpx; background: rgba(26, 24, 20, 0.7); border-radius: 50%; position: absolute; top: 140rpx; z-index: -1; }
.floating-shadow { animation: shadowBreath 6s ease-in-out infinite; }
@keyframes shadowBreath { 0%, 100% { transform: scale(1); opacity: 0.55; } 50% { transform: scale(0.7); opacity: 0.25; } }
@keyframes texturePulse { 0%, 100% { transform: scale(0.85); opacity: 0.4; } 50% { transform: scale(1.08); opacity: 0.7; } }
@keyframes spinOrbit { 0% { transform: translate(-50%, -50%) rotateX(75deg) rotateY(15deg) rotateZ(0deg); } 100% { transform: translate(-50%, -50%) rotateX(75deg) rotateY(15deg) rotateZ(360deg); } }
@keyframes iconBreathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }
@keyframes orbit { from { transform: rotateX(60deg) rotateZ(0deg); } to { transform: rotateX(60deg) rotateZ(360deg); } }
@keyframes electron { from { transform: rotateZ(0deg) translateX(55rpx) rotateZ(0deg); } to { transform: rotateZ(360deg) translateX(55rpx) rotateZ(-360deg); } }

.orb-meta { text-align: center; }
.orb-meta .cn { font-size: 26rpx; color: var(--color-text-body); font-weight: 600; display: block; letter-spacing: 2rpx; }
.orb-meta .en { font-size: var(--fs-16); color: var(--color-text-secondary); font-family: 'DIN'; letter-spacing: 1rpx; margin-top: 6rpx; display: block; text-transform: uppercase; font-weight: bold; }

/* 灵动球展开面板 */
.orb-expansion-panel { width: 100%; height: 0; opacity: 0; overflow: hidden; transition: height 0.28s ease, opacity 0.28s ease, margin 0.28s ease; margin-top: 20rpx; background: rgba(31, 29, 26, 0.6); border-radius: 16rpx; }
.orb-expansion-panel.expanded { height: 400rpx; opacity: 1; margin-top: 40rpx; padding-bottom: 24rpx; }
.panel-line-top { width: 100%; height: 1px; background: linear-gradient(90deg, transparent, var(--primary), transparent); margin-bottom: 20rpx; opacity: 0.5; }
.orb-product-scroll { width: 100%; height: 100%; display: flex; padding: 0 20rpx; box-sizing: border-box; }
.orb-loader { display: flex; }
.sk-card { width: 220rpx; height: 300rpx; background: var(--color-bg-elevated); margin-right: 20rpx; border-radius: 12rpx; animation: pulse 1.5s infinite; }

.orb-item { flex-shrink: 0; }
.op-card { width: 220rpx; height: 340rpx; margin-right: 24rpx; flex-shrink: 0; background: var(--color-bg-card); border-radius: 16rpx; overflow: hidden; border: 1px solid var(--color-bg-elevated); position: relative; display: flex; flex-direction: column; transition: transform 0.22s ease, border-color 0.22s ease; }
.op-card:active,
