}

/* 金色光泽扫过效果 */
.artist-card-v2::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(196, 167, 108,0.15),
    rgba(255,255,255,0.1),
