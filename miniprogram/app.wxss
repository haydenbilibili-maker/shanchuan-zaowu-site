/* 「注记」长注释原文见 miniprogram/docs/源码注记_A流主包.md */
/** app.wxss **/
@import "./styles/badges.wxss";

/* ==================== 1. 设计系统 Museum Mode（山海造物 VI） ==================== */
page {
  /* 旧短名已全站改名（P2），只留无等价新名的两枚，勿新用（注记 APP-7） */
  --primary-light: rgba(196, 167, 108, 0.12);
  --border-gold: rgba(77, 64, 26, 0.55);
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  /* 设计系统完整令牌（Museum Mode） */
  --color-primary: #C4A76C;
  --color-bg: #1A1814;
  --color-bg-card: #1F1D1A;
  --color-bg-elevated: #262320;
  --color-border: rgba(38, 35, 32, 0.4);
  --color-border-highlight: #4D401A;
  --color-text-primary: #FFFFFF;
  --color-text-secondary: #A09A90;
  --color-text-body: #D5D1C8;
  --color-text-muted: #6B6560;
  --color-text-latin: #C4A76C;
  --color-wood: #8B6F47;
  --color-forest: #2D5A3F;
  --brass-50: #FAF6ED;
  --brass-100: #F0E6CC;
  --brass-200: #E0CFA3;
  --brass-300: #D4BC85;
  --brass-400: #C4A76C;
  --brass-500: #A8903C;
  --brass-600: #8A7530;
  --brass-700: #6B5A24;
  --brass-800: #4D401A;
  --brass-900: #302810;
  --color-insecta: #52B788;
  --color-minerals: #7B68AE;
  --color-plantae: #6DA34D;
  --color-marine: #5B8FB9;
  --color-success: #52B788;
  --color-warning: #E9A23B;
  /* 2026-09-21 分子级审计：error 作为**实心底**承载白字时只有 4.489（AA 需 4.5），（注记 APP-1） */
  --color-error: #D13C41;
  /* 同色淡底上的字：同色相提亮一档（注记 APP-8） */
  /* 错误红实心底承载白字（VIS3 第 04 页 ≥#C9373C；注记 APP-8） */
  --color-error-solid: #C9373C;
  --color-error-on-tint: #EE8A8D;
  --color-info-on-tint: #8DB4D4;
  --color-wood-on-tint: #C9AE84;
  --color-info: #5B8FB9;
  --font-brand: "Source Han Serif SC", "Noto Serif SC", "Songti SC", Georgia, serif;
  --font-heading: "Source Han Sans SC", "Noto Sans SC", "PingFang SC", sans-serif;
  --font-body: "Source Han Sans SC", "Noto Sans SC", "PingFang SC", sans-serif;
  --font-mono: "JetBrains Mono", "DIN", "DIN Alternate", monospace;
  /* VIS 3.0 第 05 页「字体与字阶」新增：拉丁衬线，只用于**拉丁学名 / 英文名**
     （规范：拉丁学名一律斜体）。EB Garamond 是规范首选，但小程序端不保证可达，
     Georgia 是 iOS / 微信 WebView 的常驻衬线体，故列在其后兜底。 */
  --font-latin: "EB Garamond", Georgia, "Times New Roman", serif;
  /* 手写体（毛笔 / 签字笔感）：只给「用户亲手写下」的内容用 —— 祈福墙弹幕与愿签。（注记 APP-2） */
  /* ⚠️ 必须**单行**：自定义属性值跨行在小程序 WXSS 编译器上是已知风险点（2026-09-19 iOS 实测踩坑） */
  --font-hand: "HanziPen SC", "Hannotate SC", "STKaiti", "Kaiti SC", KaiTi, 楷体, "Songti SC", serif;
  /* 字阶令牌（契约 C7 · docs/契约C7_设计令牌与交互规范_2026-09-18.md §1）：14 档，命名即尺寸。（注记 APP-3） */
  --fs-16: 16rpx;
  --fs-18: 18rpx;
  --fs-20: 20rpx;
  --fs-22: 22rpx;
  --fs-24: 24rpx;
  --fs-26: 26rpx;
  --fs-28: 28rpx;
  --fs-30: 30rpx;
  --fs-32: 32rpx;
  --fs-34: 34rpx;
  --fs-36: 36rpx;
  --fs-40: 40rpx;
  --fs-44: 44rpx;
  --fs-48: 48rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  /* 自定义 TabBar 内容高度（不含 Home Indicator）；与 custom-tab-bar 同步 */
  --tabbar-content-height: 120rpx;
  --tabbar-offset: calc(var(--tabbar-content-height) + env(safe-area-inset-bottom));
  --shadow-museum-warm: 0 8rpx 24rpx rgba(26, 24, 20, 0.45);
  /* 克制的金：金只作环/线，浮起用中性投影；光源例外登记 R2_LIGHT_SOURCE（注记 APP-6） */
  --ring-brass: 0 0 0 2rpx rgba(196, 167, 108, 0.55);
  --ring-brass-soft: 0 0 0 1rpx rgba(196, 167, 108, 0.36);
  --hairline-brass-inset: inset 0 0 0 1rpx rgba(196, 167, 108, 0.22);
  --shadow-lift: 0 8rpx 24rpx rgba(0, 0, 0, 0.36);
  --shadow-lift-press: 0 4rpx 12rpx rgba(0, 0, 0, 0.32);
  /* 弹层令牌（docs/弹层视觉规范_2026-10-13.md；时长 / 缓动值即契约 C7 §5） */
  --dur-instant: 80ms;
  --dur-fast: 160ms;
  --dur-base: 240ms;
  --dur-slow: 400ms;
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-out-soft: cubic-bezier(0.22, 0.61, 0.36, 1);
  --pop-mask: rgba(12, 11, 9, 0.72);
  --pop-mask-deep: rgba(12, 11, 9, 0.88);
  --pop-surface: linear-gradient(180deg, #221F1B 0%, #1C1A17 100%);
  --pop-hairline: rgba(196, 167, 108, 0.36);
  --pop-divider: rgba(255, 255, 255, 0.06);
  --pop-radius-dialog: 24rpx;
  --pop-radius-sheet: 32rpx;
  --pop-shadow-dialog: 0 24rpx 64rpx rgba(0, 0, 0, 0.55);
  --pop-shadow-sheet: 0 -16rpx 48rpx rgba(0, 0, 0, 0.42);
  --pop-pad-x: 40rpx;
  --pop-danger-from: #B4432F;
  --pop-danger-to: #93321F;

  background-color: #1A1814;
  color: var(--color-text-primary);
  font-family: var(--font-body);
  font-size: var(--fs-28);
  line-height: 1.6;
  letter-spacing: 0.02em;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

/* ==================== 2. 排版工具类 ==================== */
view, text, image, navigator, button, scroll-view { box-sizing: border-box; }

/* 原生 input 不继承 page 的 line-height:1.6，否则易裁切/压扁/看起来像翻转 */
input {
  line-height: normal;
}

/* 英文装饰字 (衬线体) */
.font-serif {
  font-family: var(--font-latin);
  font-style: italic;
  font-weight: bold;
}

/* 数字/价格 (DIN风格) */
.font-num {
  font-family: 'DIN', 'Oswald', sans-serif;
  font-weight: bold;
}

/* 标题组合通用样式 */
.section-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 60rpx 0 40rpx;
  text-align: center;
  position: relative;
}
.section-header .title-cn {
  font-size: var(--fs-34);
  font-weight: 600;
  font-family: var(--font-heading);
  color: var(--color-text-primary);
  letter-spacing: 0.08em;
  margin-bottom: 6rpx;
}
.section-header .title-en {
  font-size: var(--fs-18);
  color: var(--brass-400);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-family: var(--font-latin);
  opacity: 0.88;
}

/* 博物馆卡片 / 铜牌信息（页面可组合使用） */
.card-museum {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}
.card-museum-highlight {
  background: var(--color-bg-card);
  border: 1px solid rgba(77, 64, 26, 0.55);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

/* C 端商品流封面竖框（页面级兜底；ProductCard 已在组件内固定 3:4 + aspectFill） */
.is-landscape-cover {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--color-bg-elevated, #262320);
}
.is-landscape-cover .p-img,
.is-landscape-cover .card-cover-img,
.is-landscape-cover .product-cover-img,
.is-landscape-cover .rec-image {
  width: 100%;
  height: 100%;
  display: block;
}
.card-cover-ph {
  background: var(--color-bg-elevated, #262320);
}

.text-latin {
  font-family: var(--font-latin);
  font-style: italic;
  color: var(--color-text-latin);
}
.overline {
  font-size: var(--fs-20);
  font-weight: 500;
  letter-spacing: 0.1em;
  color: var(--color-text-secondary);
  text-transform: uppercase;
}

/* 文本截断 */
.text-cut { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.text-cut-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* 安全区适配 */

/* ==================== 3. 详情页富文本增强 (mp-html) ==================== */
/* 引用块 */
.rich-blockquote {
  background: rgba(250, 246, 237, 0.04);
  border-left: 6rpx solid var(--brass-500);
  padding: 20rpx 30rpx;
  margin: 30rpx 0;
  color: var(--color-text-body);
  font-style: italic;
  font-family: var(--font-latin);
}

/* 富文本内联图片：轻微压暗与暖调，贴近柜内打光 */
img {
  filter: brightness(0.93) contrast(1.04) saturate(0.96);
}

/* 首字下沉 */
.rich-dropcap {
  float: left;
  font-size: 80rpx;
  line-height: 60rpx;
  padding-top: 4rpx;
  padding-right: 12rpx;
  color: var(--color-primary);
  font-family: var(--font-latin);
  font-weight: bold;
}

/* ==================== 4. 全局 Button 样式系统 ==================== */
/* 重置微信小程序默认button样式 */
button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  font-family: inherit;
  font-size: var(--fs-28);
  line-height: 1.6;
  text-align: center;
  text-decoration: none;
  border: none;
  border-radius: var(--radius-md);
  background: transparent;
  color: inherit;
  transition: opacity var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}

button::after {
  border: none;
}

/* 双按钮行：同高拉伸，子项均分由页面 .flex1 或本行子选择器控制 */
.btn-row {
  display: flex;
  align-items: stretch;
  gap: var(--space-3);
}

.btn-row > .btn-primary,
.btn-row > .btn-secondary,
.btn-row > .btn-ghost,
.btn-row > button {
  flex: 1;
  min-width: 0;
}

/* 主要按钮 — Museum：黄铜实心，无深色发光/扫光 */
button.btn-primary,
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--brass-400);
  color: var(--color-bg);
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 1.2;
  padding: 24rpx 40rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--brass-400);
  box-shadow: none;
  position: relative;
  overflow: hidden;
  /* VIS 3.0 视觉纪律 08「不折行、不孤字」：按钮按内容定宽、文案不折行。
     在**零件层**加一句，覆盖全站页面（页面里的同名规则是叠加不是覆盖）——
     比逐页补 42 处安全得多。实测最长按钮文案「用我的微信手机号核验」11 字，
     且不落在 .btn-row 的等分格里，全宽场景余量充足。 */
  white-space: nowrap;
}

button.btn-primary:active,
.btn-primary:active {
  background: var(--brass-500);
  border-color: var(--brass-500);
  transform: scale(0.98);
}

/* 次要按钮 — 透明底 + 黄铜描边（与主按钮同 padding，避免双按钮行高度差）（注记 APP-4） */
button.btn-secondary,
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: transparent;
  color: var(--color-primary);
  border: 1px solid var(--brass-400, #C4A76C);
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 1.2;
  padding: 24rpx 40rpx;
  border-radius: var(--radius-md);
  box-shadow: none;
  overflow: visible;
  white-space: nowrap; /* VIS 3.0 纪律 08：按钮文案不折行 */
}

button.btn-secondary::after,
.btn-secondary::after {
  border: none;
}

button.btn-secondary:active,
.btn-secondary:active {
  background: rgba(196, 167, 108, 0.08);
  transform: scale(0.98);
}

/* 文本按钮 */
button.btn-text,
.btn-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: transparent;
  color: var(--color-primary);
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 1.2;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-md);
  transition: opacity var(--dur-fast) var(--ease-standard);
  white-space: nowrap; /* VIS 3.0 纪律 08：按钮文案不折行 */
}

button.btn-text:active,
.btn-text:active {
  opacity: 0.85;
}

/* 幽灵按钮 — 弱对比底 + 细边框（同 secondary：避免 overflow/1rpx 吃边） */
button.btn-ghost,
.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.04);
  color: var(--color-text-primary);
  border: 1px solid var(--color-border-highlight);
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 1.2;
  padding: 24rpx 40rpx;
  border-radius: var(--radius-md);
  box-shadow: none;
  overflow: visible;
  white-space: nowrap; /* VIS 3.0 纪律 08：按钮文案不折行 */
}

button.btn-ghost::after,
.btn-ghost::after {
  border: none;
}

button.btn-ghost:active,
.btn-ghost:active {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(77, 64, 26, 0.7);
  transform: scale(0.98);
}

/* 按钮尺寸变体 */
button.btn-small,
.btn-small {
  padding: 12rpx 24rpx;
  font-size: var(--fs-24);
  border-radius: 24rpx;
}


/* 按钮禁用 — Dark-700 底 + Dark-400 字 */
button[disabled],
button[disabled]:active,
.btn-disabled {
  opacity: 1;
  background: #262320 !important;
  color: #6B6560 !important;
  border: 1px solid rgba(38, 35, 32, 0.6) !important;
  box-shadow: none !important;
  transform: none !important;
  pointer-events: none;
}

/* ==================== 5. 页面切换动画优化 ==================== */
/* 页面进入动画 */
@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateX(30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 页面退出动画 */
@keyframes page-exit {
  from {
    opacity: 1;
    transform: translateX(0);
  }
  to {
    opacity: 0;
    transform: translateX(-30rpx);
  }
}

/* 淡入动画 */
@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 上滑动画 */
@keyframes slide-up {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 缩放进入动画 */
@keyframes scale-in {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 通用动画类 */



/* ==================== 信号灯系统（全平台统一） ====================（注记 APP-5） */
@keyframes signal-blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; box-shadow: 0 0 10rpx var(--color-success, #52B788); }
}

@keyframes signal-live-blink {
  0%, 100% {
    opacity: 0.35;
    box-shadow: 0 0 4rpx rgba(214, 64, 69, 0.28);
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 12rpx rgba(214, 64, 69, 0.65), 0 0 2rpx rgba(196, 167, 108, 0.45);
  }
}

@keyframes signal-warn-blink {
  0%, 100% {
    opacity: 0.35;
    box-shadow: 0 0 4rpx rgba(233, 162, 59, 0.28);
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 12rpx rgba(233, 162, 59, 0.65);
  }
}

.signal-light,
.lamp {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-text-muted, #6B6560);
  border: 2rpx solid transparent;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* —— Token 实心 —— */
.lamp-success,
.signal-light.lamp-success,
.signal-light.on,
.signal-light.blink {
  background: var(--color-success, #52B788);
  border-color: var(--color-success, #52B788);
  box-shadow: 0 0 8rpx rgba(82, 183, 136, 0.45);
}

.signal-light.blink {
  animation: signal-blink 0.5s infinite;
}

.lamp-warn,
.lamp-warning,
.signal-light.lamp-warn,
.signal-light.lamp-warning,
.signal-light.warn {
  background: var(--color-warning, #E9A23B);
  border-color: var(--color-warning, #E9A23B);
  box-shadow: 0 0 8rpx rgba(233, 162, 59, 0.5);
}

.signal-light.warn.blink,
.lamp-warn.blink,
.lamp-warning.blink {
  animation: signal-warn-blink 0.75s ease-in-out infinite;
}

.lamp-error,
.signal-light.lamp-error,
.signal-light.danger,
.signal-light.live {
  background: var(--color-error, #D64045);
  border-color: var(--color-error, #D64045);
  box-shadow: 0 0 8rpx rgba(214, 64, 69, 0.5);
}

.signal-light.danger.blink,
.lamp-error.blink {
  animation: signal-live-blink 0.6s ease-in-out infinite;
}

.signal-light.live.blink {
  background: var(--color-error, #D64045);
  border-color: var(--color-error, #D64045);
  box-shadow: 0 0 10rpx rgba(214, 64, 69, 0.6);
  animation: signal-live-blink 1s ease-in-out infinite;
}

.lamp-info,
.signal-light.lamp-info {
  background: var(--color-info, #5B8FB9);
  border-color: var(--color-info, #5B8FB9);
  box-shadow: 0 0 6rpx rgba(91, 143, 185, 0.35);
}

.lamp-brass,
.signal-light.lamp-brass {
  background: var(--brass-400, #C4A76C);
  border-color: var(--brass-400, #C4A76C);
  box-shadow: 0 0 6rpx rgba(196, 167, 108, 0.35);
}

.lamp-forest,
.signal-light.lamp-forest {
  background: var(--color-forest, #2D5A3F);
  border-color: var(--color-forest, #2D5A3F);
  box-shadow: 0 0 6rpx rgba(45, 90, 63, 0.35);
}

.lamp-muted,
.signal-light.lamp-muted {
  background: var(--color-text-muted, #6B6560);
  border-color: var(--color-text-muted, #6B6560);
  box-shadow: none;
}

/* —— 空心变体 —— */
.lamp.hollow,
.signal-light.hollow {
  background: transparent !important;
  box-shadow: none !important;
  animation: none !important;
}

.lamp-success.hollow,
.signal-light.lamp-success.hollow { border-color: var(--color-success, #52B788); }
.lamp-warn.hollow,
.lamp-warning.hollow,
.signal-light.warn.hollow,
.signal-light.lamp-warn.hollow { border-color: var(--color-warning, #E9A23B); }
.lamp-error.hollow,
.signal-light.lamp-error.hollow,
.signal-light.danger.hollow { border-color: var(--color-error, #D64045); }
.lamp-info.hollow,
.signal-light.lamp-info.hollow { border-color: var(--color-info, #5B8FB9); }
.lamp-brass.hollow,
.signal-light.lamp-brass.hollow { border-color: var(--brass-600, #8A7530); }
.lamp-forest.hollow,
.signal-light.lamp-forest.hollow { border-color: var(--color-forest, #2D5A3F); }
.lamp-muted.hollow,
.signal-light.lamp-muted.hollow { border-color: var(--color-text-muted, #6B6560); }

.lamp.dim,
.signal-light.dim {
