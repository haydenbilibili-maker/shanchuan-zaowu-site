.mu-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; margin-bottom: 24rpx; padding-bottom: 18rpx; background: linear-gradient(90deg, rgba(196,167,108,.55), rgba(196,167,108,.12) 60%, transparent) left bottom / 100% 1px no-repeat; }
.mu-head-t { display: flex; flex-direction: column; min-width: 0; }
.mu-en { font-size: var(--fs-18); line-height: 26rpx; color: var(--brass-400); font-family: var(--font-mono); letter-spacing: .32em; }
.mu-cn { margin-top: 6rpx; font-size: 38rpx; line-height: 50rpx; font-weight: 500; color: var(--color-text-primary); font-family: var(--font-brand); letter-spacing: .12em; white-space: nowrap; /* VIS 3.0 纪律 08：分区主标不折行 */ }
.mu-sub { margin-top: 6rpx; font-size: var(--fs-22); line-height: 1.45; color: var(--color-text-secondary); letter-spacing: .04em; }
.mu-act { flex-shrink: 0; display: flex; align-items: center; gap: 12rpx; padding-bottom: 6rpx; font-size: var(--fs-22); color: var(--brass-300); letter-spacing: .12em; white-space: nowrap; }
.mu-act-muted { color: var(--color-text-secondary); letter-spacing: .06em; }

/* 减弱动效（契约 C7 §5.3 / VI 规范 v1 §10.3）：系统开启「减少动态效果」时，无限循环动画停在静止态 */
@media (prefers-reduced-motion: reduce) {
  .signal-light.blink,
  .signal-light.warn.blink,
  .lamp-warn.blink,
  .lamp-warning.blink,
  .signal-light.danger.blink,
  .lamp-error.blink,
  .signal-light.live.blink,
  .skeleton,
  .ui-sk-line,
  .loading-spinner {
    animation: none;
  }
}
