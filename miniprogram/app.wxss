  align-items: center;
  gap: 10rpx;
}

.signal-legend-text,
.lamp-legend text {
  font-size: var(--fs-20);
  color: var(--color-text-muted, #6B6560);
  letter-spacing: 0.02em;
}

/* 门店积分流水 · 状态标签（field 流水 / 审批中心 · 积分流水） */
.flow-list .rec-status,
.list .record .rec-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: none;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(82, 183, 136, 0.35);
  font-size: var(--fs-20);
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 1.2;
  white-space: nowrap;
  color: var(--color-success);
  background: rgba(82, 183, 136, 0.12);
}

.flow-list .rec-status.granted,
.flow-list .rec-status.approved,
.list .record .rec-status.granted,
.list .record .rec-status.approved {
  color: var(--color-success);
  border-color: rgba(82, 183, 136, 0.4);
  background: rgba(82, 183, 136, 0.12);
}

.flow-list .rec-status.rejected,
.list .record .rec-status.rejected {
  color: var(--color-error-on-tint);
  border-color: rgba(214, 64, 69, 0.4);
  background: rgba(214, 64, 69, 0.12);
}

.flow-list .rec-status.ignored,
.flow-list .rec-status.pending_approval,
.flow-list .rec-status.pending_claim,
.flow-list .rec-status.pending,
.list .record .rec-status.ignored,
.list .record .rec-status.pending_approval,
.list .record .rec-status.pending_claim,
.list .record .rec-status.pending {
  color: var(--color-warning);
  border-color: rgba(233, 162, 59, 0.4);
  background: rgba(233, 162, 59, 0.12);
}

.flow-list .rec-status.revoked,
.flow-list .rec-status.partial_revoked,
.list .record .rec-status.revoked,
.list .record .rec-status.partial_revoked {
  color: var(--color-text-secondary);
  border-color: rgba(160, 154, 144, 0.35);
  background: rgba(38, 35, 32, 0.6);
}

/* ==================== 6. 加载状态优化 ==================== */
/* 骨架屏基础样式 */
.skeleton {
  background: linear-gradient(
    90deg,
    rgba(196, 167, 108, 0.04) 0%,
    rgba(196, 167, 108, 0.09) 50%,
    rgba(196, 167, 108, 0.04) 100%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* 工作台骨架：ui-sk-card 容器 + ui-sk-line 行（.wide 标题行 / .title 大标题 / .bar 整条），脉动不闪光 */
.ui-sk-card { margin-top: 24rpx; padding: 24rpx; background: var(--color-bg-card); border: 1rpx solid rgba(38, 35, 32, 0.66); border-radius: 16rpx; }
.ui-sk-line { height: 24rpx; width: 42%; margin-top: 16rpx; border-radius: 8rpx; background: var(--color-bg-elevated); animation: ui-sk-pulse 1.2s ease-in-out infinite; }
.ui-sk-line.wide { width: 72%; height: 30rpx; margin-top: 0; }
.ui-sk-line.title { width: 40%; height: 40rpx; margin-top: 0; }
.ui-sk-line.bar { width: 100%; height: 72rpx; border-radius: 16rpx; }
@keyframes ui-sk-pulse { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.85; } }

/* 零件：两栏行 / 金额 / 状态 pill —— 用法见 docs/小程序VI规范 §8.9；守卫 check:ui-parts */
.ui-amount { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
.ui-amount.is-off, .ui-row-v.is-off { color: var(--color-primary); }
.ui-row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
.ui-row-l { min-width: 0; font-family: var(--font-body); color: var(--color-text-secondary); }
.ui-row-n { display: block; margin-top: 4rpx; font-size: var(--fs-22); color: var(--color-text-secondary); }
.ui-row-v { flex-shrink: 0; font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--color-text-body); white-space: nowrap; }
.ui-pill { display: inline-flex; align-items: center; padding: 2rpx 16rpx; border-radius: 999rpx; border: 1rpx solid transparent; font-size: var(--fs-22); line-height: 1.6; white-space: nowrap; }
.ui-pill.is-success { color: var(--color-success); background: rgba(82, 183, 136, 0.12); border-color: rgba(82, 183, 136, 0.36); }
.ui-pill.is-warning { color: var(--color-warning); background: rgba(233, 162, 59, 0.12); border-color: rgba(233, 162, 59, 0.36); }
.ui-pill.is-error { color: var(--color-error-on-tint); background: rgba(214, 64, 69, 0.14); border-color: rgba(214, 64, 69, 0.4); }
.ui-pill.is-info { color: var(--color-info-on-tint); background: rgba(91, 143, 185, 0.14); border-color: rgba(91, 143, 185, 0.36); }
.ui-pill.is-brass { color: var(--brass-300); background: rgba(196, 167, 108, 0.1); border-color: rgba(196, 167, 108, 0.36); }
.ui-pill.is-muted { color: var(--color-text-secondary); background: rgba(255, 255, 255, 0.04); border-color: var(--color-border); }

/* 统一按压态：hover-class="tap-press|tap-press-soft（卡片/整行）" hover-stay-time="80"；view 上 :active 真机不稳。
   ⚠️ 自定义组件内拿不到本文件的类，需自带同值类；wb-press 为工作台旧名 */
.tap-press, .wb-press { opacity: 0.72 !important; }
.tap-press-soft { opacity: 0.86 !important; }

/* ==================== 弹层（docs/弹层视觉规范_2026-10-13.md） ====================
 * 三种形态，一套零件：
 *   居中确认框  <view class="ui-pop-mask is-center"><view class="ui-pop-dialog">…</view></view>（AppModal 即此形态）
 *   底部抽屉    <view class="ui-pop-mask"><view class="ui-pop-sheet"><view class="ui-pop-grip"/>…</view></view>
 *   仪式卡      ui-pop-mask is-center is-deep（升级 / 生日 / 海报 / 证件：遮罩更深、允许主视觉装饰）
 * 零件：ui-pop-head（ui-pop-kicker 英文眉标 + ui-pop-title 宋体主标）/ ui-pop-close / ui-pop-body / ui-pop-foot / ui-pop-btn
 * 页面 wxss 只写本弹层特有的内容（尺寸、列表行），**不再自写遮罩色 / 面板底 / 圆角 / 金边 / 动画**。
 * ⚠️ 自定义组件需 options.addGlobalClass 才拿得到这些类。 */
.ui-pop-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 800;
  background: var(--pop-mask);
  animation: ui-pop-fade var(--dur-base) var(--ease-standard) both;
}
.ui-pop-mask.is-deep { background: var(--pop-mask-deep); }
/* 常驻节点、靠类切换显隐的弹层（有退场动画）：is-toggle + is-open。
   ⚠️ 不能直接用默认的进场 animation —— fill-mode both 会把隐藏态的 opacity 顶成 1 */
.ui-pop-mask.is-toggle { animation: none; opacity: 0; pointer-events: none; transition: opacity var(--dur-base) var(--ease-standard); }
.ui-pop-mask.is-toggle.is-open { opacity: 1; pointer-events: auto; }
.ui-pop-mask.is-toggle .ui-pop-dialog { animation: none; transform: translateY(16rpx) scale(0.97); transition: transform var(--dur-base) var(--ease-out-soft); }
.ui-pop-mask.is-toggle .ui-pop-sheet { animation: none; transform: translateY(100%); transition: transform var(--dur-base) var(--ease-out-soft); }
.ui-pop-mask.is-toggle.is-open .ui-pop-dialog,
.ui-pop-mask.is-toggle.is-open .ui-pop-sheet { transform: none; }
.ui-pop-mask.is-center {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.ui-pop-dialog {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  padding: 48rpx var(--pop-pad-x) 32rpx;
  box-sizing: border-box;
  background: var(--pop-surface);
  border: 1rpx solid var(--pop-hairline);
  border-radius: var(--pop-radius-dialog);
  box-shadow: var(--pop-shadow-dialog);
  animation: ui-pop-in var(--dur-base) var(--ease-out-soft) both;
}
.ui-pop-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--pop-surface);
  border-top: 1rpx solid var(--pop-hairline);
  border-radius: var(--pop-radius-sheet) var(--pop-radius-sheet) 0 0;
  box-shadow: var(--pop-shadow-sheet);
  overflow: hidden;
  animation: ui-pop-rise var(--dur-base) var(--ease-out-soft) both;
}
.ui-pop-grip {
  flex-shrink: 0;
  width: 56rpx;
  height: 6rpx;
  margin: 16rpx auto 0;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.16);
}
/* 头部：左眉标 + 主标两行（不写「EN / 中」一行），右上关闭；居中确认框加 is-center */
.ui-pop-head {
  flex-shrink: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 28rpx 112rpx 24rpx var(--pop-pad-x);
}
.ui-pop-dialog .ui-pop-head { padding: 0 0 20rpx; }
.ui-pop-head.is-center { align-items: center; text-align: center; padding: 0 0 8rpx; }
.ui-pop-kicker {
  display: block;
  font-family: var(--font-mono);
  font-size: var(--fs-18);
  line-height: 26rpx;
  letter-spacing: 0.32em;
  color: var(--brass-400);
  margin-bottom: 10rpx;
}
.ui-pop-title {
  display: block;
  font-family: var(--font-brand);
  font-size: var(--fs-34);
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.06em;
  color: var(--color-text-primary);
}
.ui-pop-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--color-text-secondary);
}
/* 关闭：88rpx 触控区，字形 secondary（不用 muted） */
.ui-pop-close {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-30);
  color: var(--color-text-secondary);
}
.ui-pop-body {
  padding: 0 var(--pop-pad-x);
  font-size: var(--fs-26);
  line-height: 1.7;
  color: var(--color-text-secondary);
}
.ui-pop-foot {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx var(--pop-pad-x) 28rpx;
  border-top: 1rpx solid var(--pop-divider);
}
.ui-pop-dialog .ui-pop-foot { padding: 32rpx 0 0; border-top: none; }
.ui-pop-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: var(--fs-28);
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
  box-sizing: border-box;
}
/* 每屏一个实心金：主按钮平涂品牌金；次按钮发丝描边；危险为铁锈红（C7 §4.3） */
.ui-pop-btn.is-primary { color: #1A1814; background: var(--brass-400); }
.ui-pop-btn.is-ghost { color: var(--color-text-body); background: transparent; border: 1rpx solid rgba(255, 255, 255, 0.16); }
.ui-pop-btn.is-danger { color: #FFF3F0; background: linear-gradient(180deg, var(--pop-danger-from) 0%, var(--pop-danger-to) 100%); }
.ui-pop-btn.is-disabled { opacity: 0.4; }
/* 抽屉内选择行：发丝分隔，不做方框卡片 */
.ui-pop-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--pop-divider);
}
.ui-pop-row:last-child { border-bottom: none; }
.ui-pop-row.is-off { opacity: 0.4; }
/* 行内：面额 / 数值（等宽金）+ 标题 / 说明 / 提示（主次两行）+ 末尾单选 */
.ui-pop-row-lead { flex-shrink: 0; min-width: 96rpx; font-family: var(--font-mono); font-size: var(--fs-36); font-weight: 600; color: var(--brass-400); }
.ui-pop-row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.ui-pop-row-t { font-size: var(--fs-28); line-height: 1.4; color: var(--color-text-body); }
.ui-pop-row.is-on .ui-pop-row-t { color: var(--color-text-primary); }
.ui-pop-row-d { font-size: var(--fs-22); line-height: 1.5; color: var(--color-text-secondary); }
.ui-pop-row-note { font-size: var(--fs-22); line-height: 1.5; color: var(--brass-400); }
.ui-pop-row-note.is-off { color: var(--color-text-secondary); }
.ui-pop-empty { padding: 48rpx 0; text-align: center; font-size: var(--fs-24); color: var(--color-text-secondary); }
.ui-pop-radio {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ui-pop-radio.is-on { border-color: var(--brass-400); }
.ui-pop-radio.is-on::after { content: ''; width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--brass-400); }
@keyframes ui-pop-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ui-pop-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes ui-pop-in { from { opacity: 0; transform: translateY(16rpx) scale(0.97); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) {
  .ui-pop-mask, .ui-pop-dialog, .ui-pop-sheet { animation: none; }
}

/* 加载动画 */
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(196, 167, 108, 0.2);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spinner-rotate 0.8s linear infinite;
}

@keyframes spinner-rotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* 加载提示 */
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: var(--color-text-secondary);
  font-size: var(--fs-26);
}

/* ==================== 7. 空状态优化 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  min-height: 400rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 30rpx;
  filter: grayscale(0.5);
}

.empty-text {
  font-size: var(--fs-28);
  color: var(--color-text-muted);
  text-align: center;
  margin-bottom: 20rpx;
  letter-spacing: 0.04em;
}

.empty-action {
  margin-top: 30rpx;
}

/* ==================== 8. 错误状态优化 ==================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  min-height: 400rpx;
}

.error-icon {
  font-size: 100rpx;
  opacity: 0.45;
  margin-bottom: 30rpx;
  color: var(--color-error);
}

.error-text {
  font-size: var(--fs-28);
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 20rpx;
  letter-spacing: 0.04em;
}

.error-detail {
  font-size: var(--fs-24);
  color: var(--color-text-muted);
  text-align: center;
  margin-bottom: 40rpx;
}

/* ==================== 9. 图片优化 ==================== */
/* 图片懒加载占位 */
image[lazy-load] {
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.05),
    rgba(255, 255, 255, 0.02)
  );
  border-radius: 8rpx;
}

/* 图片加载失败占位 */
image[error] {
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==================== 10. 滚动优化 ==================== */
